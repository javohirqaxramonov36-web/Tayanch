---
// Bo'lim qobig'i (SAT, IELTS; Top Admission va EYUF uchun hozircha minimal yon panel): chapda yon panel (BolimYon), o'ngda kontent.
// Dizayn: Tayanch-SAT-dizayn.md (Main, Natijalar, Savol banki). Footer va sahifa oxiri bloki dizaynda yo'q.
// Props = T1'dagi majburiy maydonlar (Asosiy bilan bir xil).
import '../styles/global.css';
import BoshQism from '../components/BoshQism.astro';
import BolimYon from '../components/BolimYon.astro';
import QavatYoli from '../components/QavatYoli.astro';
import Lift from '../components/Lift.astro';
import { joriyQavat } from '../data/qavatlar';
import SatEslatma from '../components/SatEslatma.astro';
import type { BolimSlug } from '../data/bolimlar';
import { bolimTili, matn } from '../data/umumiyMatn';

export interface Props {
  title: string;
  description: string;
  til?: 'uz' | 'en';
  turi: 'bolim-kirishi' | 'mashq' | 'vosita' | 'qollanma';
  bolim?: BolimSlug;
  holat: 'qoralama' | 'chop-etilgan';
  tekshirilgan?: string;
  keyingiTekshiruv?: string;
  manbalar?: string[];
  tekshirilmagan?: string[];
  /** Qavat yo'lidagi oraliq bandlar: ["Mashq"] */
  yol?: string[];
}

const { title, description, holat, bolim = 'sat', yol: bandlar = [] } = Astro.props;
// Til bo'limdan: SAT inglizcha (CLAUDE.md), qolganlari o'zbekcha.
const til = Astro.props.til ?? bolimTili(bolim);
const sahifaNomi = title.split(' · ')[0];
---
<!doctype html>
<html lang={til} data-floor={joriyQavat(Astro.url.pathname)}>
  <head>
    <BoshQism title={title} description={description} holat={holat} />
  </head>
  <body class="bolim-qobiq">
    <a class="otish" href="#asosiy" data-panel-tashqari>{matn[til].otish}</a>
    <BolimYon bolim={bolim} />
    <div class="kontent-ustun" data-panel-tashqari>
      <main id="asosiy">
        <div class="ichki qavat-yoli-orami"><QavatYoli bandlar={bandlar} sahifaNomi={sahifaNomi} /></div>
        <slot />
      </main>
      {bolim === 'sat' && <SatEslatma />}
    </div>
    <Lift variant="pastki" />
  </body>
</html>

<style is:global>
  .bolim-qobiq .kontent-ustun { min-width: 0; }
  .bolim-qobiq .kontent-ustun .ichki { max-width: 960px; padding-inline: var(--b-4); padding-bottom: var(--b-16); }

  @media (min-width: 1024px) {
    .bolim-qobiq {
      display: grid;
      grid-template-columns: var(--yon-kenglik) minmax(0, 1fr);
      align-items: start;
    }
    [data-sidebar='yigilgan'] .bolim-qobiq { grid-template-columns: var(--yon-yigilgan) minmax(0, 1fr); }
    .bolim-qobiq > .yon { grid-column: 1; grid-row: 1; }
    .bolim-qobiq > .kontent-ustun { grid-column: 2; grid-row: 1; min-height: 100vh; display: flex; flex-direction: column; }
    .bolim-qobiq > .kontent-ustun > main { flex: 1; }
    .bolim-qobiq .kontent-ustun .ichki { padding-inline: var(--b-10); margin: 0; max-width: calc(960px + 2 * var(--b-10)); }
  }
</style>
