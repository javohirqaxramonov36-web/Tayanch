---
// Bo'lim qobig'i (SAT, IELTS; Top Admission va EYUF uchun hozircha minimal yon panel): chapda yon panel (BolimYon), o'ngda kontent.
// Dizayn: Tayanch-SAT-dizayn.md (Main, Natijalar, Savol banki). Footer va sahifa oxiri bloki dizaynda yo'q.
// Props = T1'dagi majburiy maydonlar (Asosiy bilan bir xil).
import '../styles/global.css';
import BoshQism from '../components/BoshQism.astro';
import BolimYon from '../components/BolimYon.astro';
import QavatYoli from '../components/QavatYoli.astro';
import { joriyQavat } from '../data/qavatlar';
import SatEslatma from '../components/SatEslatma.astro';
import SatSinxron from '../components/SatSinxron.astro';
import SatTabBar from '../components/sat/SatTabBar.astro';
import TelegramTugma from '../components/TelegramTugma.astro';
import { telegramKorinadi } from '../data/telegram';
import type { BolimSlug } from '../data/bolimlar';
import { bolimTili, matn } from '../data/umumiyMatn';

export interface Props {
  title: string;
  description: string;
  til?: 'uz' | 'en';
  turi: 'bolim-kirishi' | 'mashq' | 'vosita' | 'qollanma';
  bolim?: BolimSlug;
  holat: 'qoralama' | 'chop-etilgan';
  tekshirilgan?: string;
  keyingiTekshiruv?: string;
  manbalar?: string[];
  tekshirilmagan?: string[];
  /** Qavat yo'lidagi oraliq bandlar: ["Mashq"] */
  yol?: string[];
  /** Kontent ustuni foni (qavat mini-DS'i), masalan SAT vositalari: "sat t-fon" (sat.css). Yon panel tegilmaydi. */
  sahifaSinfi?: string;
}

const { title, description, holat, bolim = 'sat', yol: bandlar = [], sahifaSinfi } = Astro.props;
// Til bo'limdan: SAT inglizcha (CLAUDE.md), qolganlari o'zbekcha.
const til = Astro.props.til ?? bolimTili(bolim);
const sahifaNomi = title.split(' · ')[0];
// "Beta — in development" yozuvi Top Admission'da ko'rsatilmaydi (muallif qarori, 2026-11-21).
const beta = bolim !== 'top-admission';
---
<!doctype html>
<html lang={til} data-floor={joriyQavat(Astro.url.pathname)}>
  <head>
    <BoshQism title={title} description={description} holat={holat} />
  </head>
  <body class="bolim-qobiq">
    <a class="otish" href="#asosiy" data-panel-tashqari>{matn[til].otish}</a>
    <BolimYon bolim={bolim} />
    <div class:list={['kontent-ustun', sahifaSinfi]} data-panel-tashqari>
      <main id="asosiy">
        <div class="ichki qavat-yoli-orami"><QavatYoli bandlar={bandlar} sahifaNomi={sahifaNomi} /></div>
        <slot />
        {telegramKorinadi('kanal') && <div class="ichki telegram-qator"><TelegramTugma turi="kanal" matn={matn[til].yon.telegramKanal} yangiTab={matn[til].yon.yangiTab} /></div>}
        {beta && <p class="ichki beta-holat" lang="en">Beta — in development</p>}
      </main>
      {bolim === 'sat' && <SatEslatma />}
      {bolim === 'sat' && <SatSinxron />}
    </div>
    {bolim === 'sat' && <SatTabBar />}
  </body>
</html>

<style is:global>
  .bolim-qobiq .kontent-ustun { min-width: 0; }
  /* Qavat foni (sahifaSinfi) qisqa sahifada ham ekran pastigacha */
  .bolim-qobiq .kontent-ustun.t-fon { min-height: 100dvh; }
  .bolim-qobiq .kontent-ustun .ichki { max-width: 960px; padding-inline: var(--b-4); padding-bottom: var(--b-16); }
  .bolim-qobiq .kontent-ustun .telegram-qator { padding-bottom: 0; }
  .bolim-qobiq .kontent-ustun .beta-holat { margin: 0; padding-block: var(--b-4) var(--b-6); font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }

  @media (min-width: 1024px) {
    .bolim-qobiq .kontent-ustun .ichki { padding-inline: var(--b-10); max-width: calc(960px + 2 * var(--b-10)); }
  }
</style>
