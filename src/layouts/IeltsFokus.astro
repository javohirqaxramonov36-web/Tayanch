---
// IELTS "fokus" screen: no sidebar, a slim header with a close link, the title and an action
// slot (timer and finish button). The page fills the viewport and its panels scroll on their own.
import '../styles/global.css';
import BoshQism from '../components/BoshQism.astro';
import { matn } from '../data/umumiyMatn';

export interface Props {
  title: string;
  description: string;
  /** small label above the title: "IELTS · Reading" */
  ustki: string;
  nomi: string;
  /** where the close link goes (already passed through yol()) */
  chiqish: string;
  chiqishNomi: string;
}
const { title, description, ustki, nomi, chiqish, chiqishNomi } = Astro.props;
---
<!doctype html>
<html lang="uz">
  <head>
    <BoshQism title={title} description={description} holat="qoralama" />
  </head>
  <body class="ielts-fokus">
    <a class="otish" href="#asosiy">{matn.uz.otish}</a>
    <header class="if-bosh">
      <a class="if-yopish" href={chiqish} aria-label={chiqishNomi}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
      <div class="if-sarlavha">
        <span class="if-ustki">{ustki}</span>
        <span class="if-nomi">{nomi}</span>
      </div>
      <span class="if-oraliq" aria-hidden="true"></span>
      <slot name="amal" />
    </header>
    <main id="asosiy" class="if-asosiy">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.ielts-fokus { height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; background: var(--fon); }
  .if-bosh {
    flex: none; min-height: 64px; padding: var(--b-2) var(--b-6);
    background: var(--fon); border-bottom: 1px solid var(--chiziq);
    display: flex; align-items: center; gap: var(--b-3);
  }
  .if-yopish {
    flex: none; width: 44px; height: 44px; border-radius: var(--r-yon);
    display: flex; align-items: center; justify-content: center;
    color: var(--matn); background: var(--fon-ikkinchi);
  }
  .if-yopish:hover { background: var(--sirt-ikkinchi); }
  .if-sarlavha { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .if-ustki { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-sust); }
  .if-nomi { font-size: 17px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .if-oraliq { flex: 1; }
  .if-asosiy { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; overflow-y: auto; }

  @media (max-width: 640px) {
    .if-bosh { padding-inline: var(--b-4); gap: var(--b-2); }
    .if-sarlavha { display: none; }
  }
</style>
