---
// IELTS "fokus" screen: no sidebar, a slim header with a close link, the title and an action
// slot (timer and finish button). The page fills the viewport and its panels scroll on their own.
import '../styles/global.css';
import BoshQism from '../components/BoshQism.astro';
import BolimYon from '../components/BolimYon.astro';
import QavatYoli from '../components/QavatYoli.astro';
import { joriyQavat } from '../data/qavatlar';
import { matn } from '../data/umumiyMatn';
import { RM } from '../data/ielts/readingMatn';

export interface Props {
  title: string;
  description: string;
  /** small label above the title: "IELTS · Reading" */
  ustki: string;
  nomi: string;
  /** where the close link goes (already passed through yol()) */
  chiqish: string;
  chiqishNomi: string;
}
const { title, description, ustki, nomi, chiqish, chiqishNomi } = Astro.props;
---
<!doctype html>
<html lang="uz">
  <head>
    <BoshQism title={title} description={description} holat="qoralama" />
  </head>
  <body class="ielts-fokus">
    <a class="otish" href="#asosiy">{matn.uz.otish}</a>
    <BolimYon bolim="ielts" />
    <section class="if-bosh" aria-labelledby="if-nomi">
      <a class="if-yopish" href={chiqish} aria-label={chiqishNomi}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
      <div class="if-sarlavha">
        <span class="if-ustki">{ustki}</span>
        <span class="if-nomi" id="if-nomi">{nomi}</span>
      </div>
      <span class="if-oraliq" aria-hidden="true"></span>
      <slot name="amal" />
    </section>
    <main id="asosiy" class="if-asosiy">
      <div class="if-yol"><QavatYoli bandlar={['Mashq']} sahifaNomi={nomi} ota={chiqish} /></div>
      <noscript>
        <section class="if-bosh-holat ds-karta">
          <p>Test ishlashi uchun brauzerda JavaScript yoqilgan boʻlishi kerak.</p>
          <a class="t-tugma ielts-tugma--urgu" href={chiqish}>{RM.boshlashSahifasi}</a>
        </section>
      </noscript>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.ielts-fokus { height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; background: var(--color-ielts-bg); }
  .if-bosh {
    flex: none; min-height: 64px; padding: var(--space-2) var(--space-6);
    background: var(--color-ielts-bg); border-bottom: 1px solid var(--color-ielts-line);
    display: flex; align-items: center; gap: var(--space-3);
  }
  .if-yopish {
    flex: none; width: 44px; height: 44px; border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    color: var(--color-ielts-text); background: var(--color-ielts-tile);
  }
  @media (hover: hover) and (pointer: fine) { .if-yopish:hover { background: var(--color-ielts-tile); } }
  .if-sarlavha { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .if-ustki { font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ielts-text-muted); }
  .if-nomi { font-size: var(--text-body-size); font-weight: var(--font-weight-extrabold); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .if-oraliq { flex: 1; }
  .if-asosiy { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; overflow-y: auto; }
  .if-yol { flex: none; padding-inline: var(--space-4); }
  .if-bosh-holat, .ielts-fokus .rt-holat:has(a) {
    max-inline-size: min(calc(100% - 2 * var(--space-4)), var(--size-measure));
    margin: var(--space-6) auto;
    padding: var(--space-6);
    text-align: center;
  }
  .if-bosh-holat a { margin-block-start: var(--space-4); }
  .ielts-fokus:has(.if-bosh-holat) #rt { display: none; }
  .ielts-fokus .rt-holat:has(a) {
    border: var(--border-width-1) solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--color-surface);
  }

  @media (max-width: 640px) {
    .if-bosh { padding-inline: var(--space-4); gap: var(--space-2); }
    .if-ustki { display: none; }
  }
</style>
