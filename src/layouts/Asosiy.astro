---
// Hamma sahifaning umumiy qolipi. Props = T1'dagi majburiy maydonlar.
import '../styles/global.css';
import Menyu from '../components/Menyu.astro';
import Footer from '../components/Footer.astro';
import SahifaOxiri from '../components/SahifaOxiri.astro';

export interface Props {
  title: string;
  description: string;
  til?: 'uz' | 'en';
  turi: 'bosh-sahifa' | 'bolim-kirishi' | 'qollanma' | 'yonalish' | 'mashq' | 'vosita' | 'umumiy';
  bolim: 'umumiy' | 'top-admission' | 'ielts' | 'sat' | 'eyuf';
  holat: 'qoralama' | 'chop-etilgan';
  tekshirilgan?: string;
  keyingiTekshiruv?: string;
  manbalar?: string[];
  tekshirilmagan?: string[];
  sahifaOxiri?: boolean;
}

const {
  title, description, til = 'uz', tekshirilgan, keyingiTekshiruv,
  manbalar = [], tekshirilmagan = [], sahifaOxiri = true,
} = Astro.props;
const toliqSarlavha = title === 'Tayanch' ? 'Tayanch' : `${title} · Tayanch`;
---
<!doctype html>
<html lang={til}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{toliqSarlavha}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="otish" href="#asosiy">Asosiy matnga o'tish</a>
    <Menyu />
    <main id="asosiy">
      <slot />
      {sahifaOxiri && (
        <SahifaOxiri
          manbalar={manbalar}
          tekshirilgan={tekshirilgan}
          keyingiTekshiruv={keyingiTekshiruv}
          tekshirilmagan={tekshirilmagan}
        />
      )}
    </main>
    <Footer />
  </body>
</html>
