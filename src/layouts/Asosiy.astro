---
// Hamma sahifaning umumiy qolipi. Props = T1'dagi majburiy maydonlar.
import '../styles/global.css';
import Menyu from '../components/Menyu.astro';
import Footer from '../components/Footer.astro';
import SahifaOxiri from '../components/SahifaOxiri.astro';
import BoshQism from '../components/BoshQism.astro';
import QavatYoli from '../components/QavatYoli.astro';
import Lift from '../components/Lift.astro';

export interface Props {
  title: string;
  description: string;
  til?: 'uz' | 'en';
  turi: 'bosh-sahifa' | 'bolim-kirishi' | 'qollanma' | 'yonalish' | 'mashq' | 'vosita' | 'umumiy';
  bolim: 'umumiy' | 'top-admission' | 'ielts' | 'sat' | 'eyuf';
  holat: 'qoralama' | 'chop-etilgan';
  tekshirilgan?: string;
  keyingiTekshiruv?: string;
  manbalar?: string[];
  tekshirilmagan?: string[];
  sahifaOxiri?: boolean;
  /** Qavat yo'lidagi oraliq bandlar */
  yol?: string[];
}

const {
  title, description, til = 'uz', holat, tekshirilgan, keyingiTekshiruv,
  manbalar = [], tekshirilmagan = [], sahifaOxiri = true, yol: bandlar = [],
} = Astro.props;
---
<!doctype html>
<html lang={til}>
  <head>
    <BoshQism title={title} description={description} holat={holat} />
    <slot name="bosh" />
  </head>
  <body>
    <a class="otish" href="#asosiy">Asosiy matnga o'tish</a>
    <Menyu />
    <main id="asosiy">
      <div class="ichki qavat-yoli-orami"><QavatYoli bandlar={bandlar} sahifaNomi={title} /></div>
      <slot />
      {sahifaOxiri && (
        <SahifaOxiri
          manbalar={manbalar}
          tekshirilgan={tekshirilgan}
          keyingiTekshiruv={keyingiTekshiruv}
          tekshirilmagan={tekshirilmagan}
        />
      )}
    </main>
    <Footer />
    <Lift variant="pastki" />
  </body>
</html>
