---
// SAT "fokus" ekrani: yon panelsiz, ustida yopish tugmasi, sarlavha va progress.
// Dizayn: Tayanch-SAT-dizayn.md, "Mashq" va "Lug'at" ekranlari.
import '../styles/global.css';
import BoshQism from '../components/BoshQism.astro';
import { yol } from '../lib/yol';
import BolimYon from '../components/BolimYon.astro';
import QavatYoli from '../components/QavatYoli.astro';
import { joriyQavat } from '../data/qavatlar';
import SatEslatma from '../components/SatEslatma.astro';
import SatSinxron from '../components/SatSinxron.astro';
import { matn } from '../data/umumiyMatn';
import { kursHavola, kursOchiq, kursPreview, kursMavzulari, mavzuManzili } from '../lib/sat/kursKatalog';
// SAT bo'limi: matn inglizcha (CLAUDE.md).
const M = matn.en;

export interface Props {
  title: string;
  description: string;
  ustki: string;      // "Math · Namuna"
  nomi: string;       // "Chiziqli tenglamalar"
  /** Berilmasa progress chizig'i chiqmaydi (masalan hisob sahifalari) */
  progressNomi?: string;
  /** Qavat yo'lidagi oraliq bandlar */
  yol?: string[];
  /** Yopish (×) tugmasi manzili va yorlig'i; standart: SAT bo'limi */
  yopish?: { href: string; yorliq: string };
  /** false: telefondagi pastki lift paneli chiqmaydi (mashq sessiyasi, P08) */
  liftPastki?: boolean;
  indeks?: boolean;
}
const { title, description, ustki, nomi, progressNomi, yol: bandlar = [], yopish, indeks = false } = Astro.props;
const qisqaMashq = Astro.url.pathname === yol('/uz/sat/mashq/test/');
const kursSahifasi = (kursPreview || kursOchiq) && Astro.url.pathname.startsWith(kursHavola());
const joriyMavzu = kursSahifasi
  ? kursMavzulari.find((mavzu) => Astro.url.pathname.startsWith(kursHavola(mavzuManzili(mavzu))))
  : undefined;
const mavzuBandlari = joriyMavzu ? kursMavzulari.filter((mavzu) => mavzu.domainSlug === joriyMavzu.domainSlug)
  .map((mavzu) => {
    const href = kursHavola(mavzuManzili(mavzu));
    const current = mavzu.id === joriyMavzu.id ? (href === Astro.url.pathname ? 'page' : 'location') : undefined;
    return { href, current, nomi: mavzu.topic };
  }) : [];
---
<!doctype html>
<html lang="en" data-floor={joriyQavat(Astro.url.pathname)}>
  <head>
    <BoshQism title={title} description={description} holat={indeks ? "chop-etilgan" : "qoralama"} />
  </head>
  <body class="fokus">
    <a class="otish" href="#asosiy">{M.otish}</a>
    <BolimYon bolim="sat" />
    <section class:list={['fokus-bosh', { 'fokus-qisqa': qisqaMashq }]} aria-labelledby="fokus-nomi">
      <a class="yopish" href={yopish?.href ?? yol('/uz/sat/')} aria-label={yopish?.yorliq ?? M.fokus.qaytish}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
      <div class="sarlavha">
        <span class="ustki" id="fokus-ustki">{ustki}</span>
        <span class="nomi" id="fokus-nomi">{nomi}</span>
      </div>
      {progressNomi ? (
        <div class="jarayon">
          <div class="progress" role="progressbar" aria-label={progressNomi} aria-valuemin="0" aria-valuemax="1" aria-valuenow="0" id="fokus-progress">
            <div class="progress-toldirish" id="fokus-progress-toldirish"></div>
          </div>
          <span class="progress-matn" id="fokus-progress-matn"></span>
        </div>
      ) : <span class="fokus-oraliq" aria-hidden="true"></span>}
      <slot name="amal" />
    </section>
    <main id="asosiy" class="fokus-asosiy">
      <div class="fokus-yol"><QavatYoli bandlar={bandlar} sahifaNomi={title.split(' · ')[0]} ota={yopish?.href} /></div>
      {joriyMavzu ? (
        <div class="fokus-kurs">
          <div class="fokus-kurs-ichki">
            <details class="fokus-kurs-tel">
              <summary>Course topics</summary>
              <nav aria-label="Course topics" class="fokus-kurs-nav">
                {mavzuBandlari.map(({ href, current, nomi }) => <a href={href} aria-current={current}>{nomi}</a>)}
              </nav>
            </details>
            <nav aria-label="Course topics" class="fokus-kurs-nav fokus-kurs-keng">
              {mavzuBandlari.map(({ href, current, nomi }) => <a href={href} aria-current={current}>{nomi}</a>)}
            </nav>
          </div>
          <slot />
        </div>
      ) : <slot />}
    </main>
    <SatEslatma />
    <SatSinxron />
  </body>
</html>

<style is:global>
  body.fokus { min-height: 100vh; display: flex; flex-direction: column; }
  .fokus-bosh {
    min-height: 72px; flex: none;
    padding: var(--b-3) var(--b-8);
    background: var(--color-surface);
    border-bottom: var(--border-width-1) solid var(--color-border);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3) var(--b-6);
  }
  .fokus-bosh .yopish {
    width: 44px; height: 44px; border-radius: var(--r-yon);
    display: flex; align-items: center; justify-content: center;
    color: var(--matn); background: var(--fon-ikkinchi);
  }
  @media (hover: hover) and (pointer: fine) { .fokus-bosh .yopish:hover { background: var(--sirt-ikkinchi); } }
  .fokus-bosh .sarlavha { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .fokus-bosh .ustki { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-sust); }
  .fokus-bosh .nomi { font-size: 17px; font-weight: 800; }
  .fokus-bosh .jarayon { flex: 1 1 240px; display: flex; align-items: center; gap: 14px; max-width: 520px; margin-left: auto; }
  .fokus-bosh .progress { flex: 1; height: 8px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); overflow: hidden; }
  .fokus-bosh .progress-toldirish { height: 100%; width: 0; background: var(--rang-asosiy); border-radius: var(--r-toliq); }
  .fokus-bosh .progress-matn { font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); white-space: nowrap; }
  .fokus-bosh .fokus-oraliq { flex: 1; }
  .fokus-asosiy { flex: 1; padding: var(--b-6) var(--b-8) var(--b-10); }
  .fokus-yol { max-width: 760px; margin: 0 auto var(--b-5); }
  .fokus-kurs { margin-inline: auto; max-inline-size: var(--size-content-max); }
  .fokus-kurs-ichki { color: var(--matn); }
  .fokus-kurs-ichki summary, .fokus-kurs-nav a {
    min-block-size: var(--size-touch-min); min-inline-size: var(--size-touch-min);
    align-content: center; padding-inline: var(--space-3);
  }
  .fokus-kurs-ichki summary { cursor: pointer; font-weight: var(--font-weight-bold); }
  .fokus-kurs-nav { display: grid; }
  .fokus-kurs-keng { display: none; }
  .fokus-kurs-nav [aria-current] {
    background: var(--color-surface-sunken); border-radius: var(--radius-md); font-weight: var(--font-weight-bold);
  }
  @media (min-width: 1024px) {
    .fokus-kurs {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      align-items: start; gap: var(--space-8);
    }
    .fokus-kurs-ichki { position: sticky; inset-block-start: var(--space-16); }
    .fokus-kurs-tel { display: none; }
    .fokus-kurs-keng { display: grid; }
  }

  @media (max-width: 640px) {
    .fokus-bosh { padding: var(--b-3) var(--b-4); }
    .fokus-bosh .jarayon { order: 5; flex-basis: 100%; max-width: none; margin-left: 0; }
    .fokus-asosiy { padding: var(--b-6) var(--b-4); }

    /* Desmos va progress keyin yangilanganda ham ustunlar va satrlar joyida qoladi. */
    .fokus-qisqa {
      display: grid;
      grid-template-columns: var(--size-touch-min) minmax(0, 1fr) calc(var(--space-14) * 2);
      grid-template-rows: var(--control-height-md) var(--space-5);
      gap: var(--b-2);
    }
    .fokus-qisqa .ustki, .fokus-qisqa .nomi {
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .fokus-qisqa .desmos-havola { grid-area: 1 / 3; justify-self: end; }
    .fokus-qisqa .jarayon {
      grid-area: 2 / 1 / 3 / -1;
      display: grid; grid-template-columns: minmax(0, 1fr) 8ch; gap: var(--b-2);
    }
    .fokus-qisqa .progress-matn { text-align: end; }
  }
</style>
