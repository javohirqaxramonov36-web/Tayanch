---
// SAT "fokus" ekrani: yon panelsiz, ustida yopish tugmasi, sarlavha va progress.
// Dizayn: Tayanch-SAT-dizayn.md, "Mashq" va "Lug'at" ekranlari.
import '../styles/global.css';
import BoshQism from '../components/BoshQism.astro';
import { yol } from '../lib/yol';
import QavatYoli from '../components/QavatYoli.astro';
import Lift from '../components/Lift.astro';
import { joriyQavat } from '../data/qavatlar';
import SatEslatma from '../components/SatEslatma.astro';
import { matn } from '../data/umumiyMatn';
// SAT bo'limi: matn inglizcha (CLAUDE.md).
const M = matn.en;

export interface Props {
  title: string;
  description: string;
  ustki: string;      // "Math · Namuna"
  nomi: string;       // "Chiziqli tenglamalar"
  /** Berilmasa progress chizig'i chiqmaydi (masalan hisob sahifalari) */
  progressNomi?: string;
  /** Qavat yo'lidagi oraliq bandlar */
  yol?: string[];
  /** Yopish (×) tugmasi manzili va yorlig'i; standart: SAT bo'limi */
  yopish?: { href: string; yorliq: string };
  /** false: telefondagi pastki lift paneli chiqmaydi (mashq sessiyasi, P08) */
  liftPastki?: boolean;
}
const { title, description, ustki, nomi, progressNomi, yol: bandlar = [], yopish, liftPastki = true } = Astro.props;
---
<!doctype html>
<html lang="en" data-floor={joriyQavat(Astro.url.pathname)}>
  <head>
    <BoshQism title={title} description={description} holat="qoralama" />
  </head>
  <body class="fokus">
    <a class="otish" href="#asosiy">{M.otish}</a>
    <header class="fokus-bosh">
      <a class="yopish" href={yopish?.href ?? yol('/uz/sat/')} aria-label={yopish?.yorliq ?? M.fokus.qaytish}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
      <div class="sarlavha">
        <span class="ustki" id="fokus-ustki">{ustki}</span>
        <span class="nomi" id="fokus-nomi">{nomi}</span>
      </div>
      {progressNomi ? (
        <div class="jarayon">
          <div class="progress" role="progressbar" aria-label={progressNomi} aria-valuemin="0" aria-valuemax="1" aria-valuenow="0" id="fokus-progress">
            <div class="progress-toldirish" id="fokus-progress-toldirish"></div>
          </div>
          <span class="progress-matn" id="fokus-progress-matn"></span>
        </div>
      ) : <span class="fokus-oraliq" aria-hidden="true"></span>}
      <slot name="amal" />
      <Lift variant="fokus" />
    </header>
    <main id="asosiy" class="fokus-asosiy">
      <div class="fokus-yol"><QavatYoli bandlar={bandlar} sahifaNomi={title.split(' · ')[0]} /></div>
      <slot />
    </main>
    <SatEslatma />
    {liftPastki && <Lift variant="pastki" />}
  </body>
</html>

<style is:global>
  body.fokus { min-height: 100vh; display: flex; flex-direction: column; }
  .fokus-bosh {
    min-height: 72px; flex: none;
    padding: var(--b-3) var(--b-8);
    background: var(--color-surface);
    border-bottom: var(--border-width-1) solid var(--color-border);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3) var(--b-6);
  }
  .fokus-bosh .yopish {
    width: 44px; height: 44px; border-radius: var(--r-yon);
    display: flex; align-items: center; justify-content: center;
    color: var(--matn); background: var(--fon-ikkinchi);
  }
  @media (hover: hover) and (pointer: fine) { .fokus-bosh .yopish:hover { background: var(--sirt-ikkinchi); } }
  .fokus-bosh .sarlavha { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .fokus-bosh .ustki { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-sust); }
  .fokus-bosh .nomi { font-size: 17px; font-weight: 800; }
  .fokus-bosh .jarayon { flex: 1 1 240px; display: flex; align-items: center; gap: 14px; max-width: 520px; margin-left: auto; }
  .fokus-bosh .progress { flex: 1; height: 8px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); overflow: hidden; }
  .fokus-bosh .progress-toldirish { height: 100%; width: 0; background: var(--rang-asosiy); border-radius: var(--r-toliq); }
  .fokus-bosh .progress-matn { font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); white-space: nowrap; }
  .fokus-bosh .fokus-oraliq { flex: 1; }
  .fokus-asosiy { flex: 1; padding: var(--b-6) var(--b-8) var(--b-10); }
  .fokus-yol { max-width: 760px; margin: 0 auto var(--b-5); }

  @media (max-width: 640px) {
    .fokus-bosh { padding: var(--b-3) var(--b-4); }
    .fokus-bosh .jarayon { order: 5; flex-basis: 100%; max-width: none; margin-left: 0; }
    .fokus-asosiy { padding: var(--b-6) var(--b-4); }
  }
</style>
