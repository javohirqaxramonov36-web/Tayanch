---
import IeltsFokus from '../../layouts/IeltsFokus.astro';
import Belgi from '../../components/ielts/Belgi.astro';

const qismlar = [
  { id: 1, nom: 'Qisqa suhbat', matn: 'Short interview questions appear here.' },
  { id: 2, nom: 'Mavzu bo‘yicha nutq', matn: 'The cue card and its talking points appear here.' },
  { id: 3, nom: 'Mavzuni muhokama qilish', matn: 'Follow-up discussion questions appear here.' },
];
const mezonlar = [
  'Fikrimni misol yoki sabab bilan tushuntirdim.',
  'Gaplarimni izchil bog‘ladim.',
  'Turli so‘zlar va gap tuzilmalaridan foydalandim.',
  'Talaffuzimni tinglab, tushunarsiz joylarni belgiladim.',
];
---
<IeltsFokus nom="Speaking" tavsif="Speaking mashqining dizayn namunasi.">
  <div class="speaking-tor">
    <section class="ielts-oqim" aria-labelledby="qismlar">
      <h2 id="qismlar">Mashq qismlari</h2>
      <ol class="ielts-qatorlar speaking-qismlar">
        {qismlar.map((qism) => (
          <li class="ielts-yuza ielts-oqim">
            <div class="ielts-satr">
              <span class="yorliq" lang="en">Part {qism.id}</span>
              <h3 class="ielts-kichik-sarlavha">{qism.nom}</h3>
            </div>
            <p lang="en">{qism.matn}</p>
            {qism.id === 2 && (
              <div class="speaking-taymer ielts-satr ielts-satr-oraliq">
                <div class="ielts-satr">
                  <Belgi nom="vaqt" />
                  <div><strong>01:00</strong><p class="ielts-izoh">Tayyorlanish vaqti</p></div>
                </div>
                <button class="tugma tugma-ikkinchi" type="button" disabled>Taymerni boshlash</button>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <div class="ielts-oqim speaking-yon">
      <section class="ielts-yuza ielts-oqim" aria-labelledby="ovoz">
        <div class="ielts-satr">
          <span class="speaking-mikrofon"><Belgi nom="speaking" /></span>
          <h2 id="ovoz" class="ielts-kichik-sarlavha">Ovozni yozish</h2>
        </div>
        <p class="ielts-izoh">Yozuv faqat qurilmangizda qoladi.</p>
        <button class="tugma tugma-ikkinchi" type="button" disabled>Ovozni yozishni boshlash</button>
      </section>
      <section class="ielts-yuza ielts-oqim" aria-labelledby="tekshiruv">
        <h2 id="tekshiruv" class="ielts-kichik-sarlavha">O‘zini tekshirish</h2>
        <p class="ielts-izoh">Javobingizni tinglab, bajargan bandlaringizni belgilang.</p>
        <ul class="ielts-tekshiruv">
          {mezonlar.map((mezon) => <li><label><input type="checkbox" /> {mezon}</label></li>)}
        </ul>
      </section>
    </div>
  </div>
</IeltsFokus>

<style>
  .speaking-tor, .speaking-qismlar { display: grid; gap: var(--space-4); align-items: start; }
  .speaking-yon { align-content: start; }
  .speaking-taymer {
    background: var(--color-surface-sunken);
    padding: var(--space-3);
    border-radius: var(--radius-md);
  }
  .speaking-taymer strong { font-variant-numeric: tabular-nums; }
  .speaking-mikrofon {
    display: grid;
    place-items: center;
    inline-size: var(--size-touch-min);
    block-size: var(--size-touch-min);
    border-radius: var(--radius-full);
    color: var(--floor-ui-text);
    background: var(--floor-ui);
  }
  @media (min-width: 768px) {
    .speaking-tor { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-6); }
    .speaking-yon { padding-block-start: calc(var(--text-h2-lh) + var(--space-4)); }
  }
</style>
