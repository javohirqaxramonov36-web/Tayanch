---
import IeltsFokus from '../../layouts/IeltsFokus.astro';
import Belgi from '../../components/ielts/Belgi.astro';
import Topshirish from '../../components/ielts/Topshirish.astro';

const tasks = [
  { id: 1, sarlavha: 'Data description', matn: 'The chart and its instructions appear here. Use the answer area to write your response.' },
  { id: 2, sarlavha: 'Essay', matn: 'The essay prompt appears here. Read the instructions and write your response in the answer area.' },
];
const mezonlar = [
  'Topshiriqning barcha qismlariga javob berdim.',
  'Fikrlarimni xatboshilarga ajratdim va tartibladim.',
  'So‘zlarimni ma’nosiga mos ishlatdim.',
  'Grammatika va imloni qayta tekshirdim.',
];
---
<IeltsFokus nom="Writing" tavsif="Writing mashqining dizayn namunasi." vaqt="38:42">
  <div class="ielts-oqim writing-vazifa" id="savollar" tabindex="-1">
    <fieldset class="writing-tanlov">
      <legend class="ekranda-yoq">Topshiriqni tanlang</legend>
      {tasks.map(({ id }) => (
        <label class="ielts-tanlov">
          <input class="ekranda-yoq" type="radio" name="writing-vazifa" id={`writing-vazifa-${id}`} checked={id === 1} />
          <span lang="en">Task {id}</span>
        </label>
      ))}
    </fieldset>

    {tasks.map(({ id, sarlavha, matn }) => (
      <div class:list={['writing-tor', `writing-tor-${id}`]}>
        <section class="ielts-yuza ielts-oqim" aria-labelledby={`yozish-topshiriq-${id}`}>
          <h2 id={`yozish-topshiriq-${id}`} class="ielts-kichik-sarlavha">Topshiriq</h2>
          <div class="ielts-oqim writing-matn" lang="en">
            <h3>{sarlavha}</h3>
            <p>{matn}</p>
            {id === 1 && <div class="writing-grafik"><Belgi nom="chiziq" /><span>Chart area</span></div>}
          </div>
        </section>
        <section class="ielts-yuza ielts-oqim" aria-label={`Task ${id} javob maydoni`}>
          <div class="ielts-satr ielts-satr-oraliq">
            <label class="writing-javob-nom" for={`writing-javob-${id}`}>Javobingiz</label>
            <output class="yorliq" for={`writing-javob-${id}`}>0 so‘z</output>
          </div>
          <textarea class="ielts-maydon writing-javob" id={`writing-javob-${id}`} rows="10" placeholder="Javobingiz shu yerda ko‘rinadi" readonly></textarea>
        </section>
      </div>
    ))}
  </div>

  <Topshirish natija="#ozini-tekshir" tavsif="Mashq yakunlangach, javobingizni quyidagi mezonlar bilan solishtirasiz." amal="O‘zini tekshirish namunasini ko‘rish" />

  <section class="ielts-yuza ielts-oqim writing-tekshiruv" id="ozini-tekshir" aria-labelledby="tekshiruv-sarlavha" tabindex="-1">
    <div>
      <h2 id="tekshiruv-sarlavha" class="ielts-kichik-sarlavha">O‘zini tekshirish</h2>
      <p class="ielts-izoh">Javobingizni o‘qib chiqing va bajargan bandlaringizni belgilang.</p>
    </div>
    <ul class="ielts-tekshiruv">
      {mezonlar.map((mezon) => <li><label><input type="checkbox" /> {mezon}</label></li>)}
    </ul>
    <a class="ielts-havola" href="#savollar">Javobga qaytish <Belgi nom="orqa" /></a>
  </section>
</IeltsFokus>

<style>
  .writing-tanlov {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    margin: 0;
    min-inline-size: 0;
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
  }
  .ielts-tanlov { flex: 1; cursor: pointer; }
  .ielts-tanlov span {
    display: grid;
    place-items: center;
    min-block-size: var(--size-touch-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-full);
    font-weight: var(--text-button-weight);
    white-space: nowrap;
  }
  .ielts-tanlov input:checked + span { background: var(--btn-primary-bg); color: var(--btn-primary-text); }
  .ielts-tanlov:hover input:not(:checked) + span { background: var(--color-surface-sunken); }
  .writing-tor { display: grid; gap: var(--space-4); align-items: start; }
  .writing-tor-2, .writing-vazifa:has(#writing-vazifa-2:checked) .writing-tor-1 { display: none; }
  .writing-vazifa:has(#writing-vazifa-2:checked) .writing-tor-2 { display: grid; }
  .writing-matn h3 { font-size: var(--text-body-size); line-height: var(--text-body-lh); }
  .writing-grafik {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    min-block-size: calc(var(--space-16) * 2);
    border: var(--border-width-1) dashed var(--color-text-secondary);
    border-radius: var(--radius-md);
    background: var(--color-surface-sunken);
    color: var(--color-text-secondary);
    font-size: var(--text-small-size);
  }
  .writing-grafik :global(.ielts-belgi) { inline-size: var(--space-8); block-size: var(--space-8); }
  .writing-javob-nom { font-weight: var(--text-button-weight); }
  .writing-javob { display: block; resize: vertical; }
  .writing-tekshiruv:not(:target) { display: none; }
  @media (min-width: 768px) {
    .writing-tanlov { justify-self: start; inline-size: max-content; }
    .ielts-tanlov span { padding-inline: var(--space-6); }
    .writing-tor { grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); }
  }
</style>
