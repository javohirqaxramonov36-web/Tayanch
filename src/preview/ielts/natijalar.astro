---
import BolimQobiq from '../../layouts/BolimQobiq.astro';
import Belgi from '../../components/ielts/Belgi.astro';
import { yol } from '../../lib/yol';
import '../../styles/ielts.css';

const turlar = [
  { nom: 'True / False / Not Given', togri: 9, jami: 13 },
  { nom: 'Matching headings', togri: 7, jami: 12 },
  { nom: 'Sentence completion', togri: 8, jami: 15 },
];
const xatolar = [
  { raqam: 5, tur: 'True / False / Not Given', javob: 'True', togri: 'False', izoh: 'Namuna izohida matndagi dalil bilan savoldagi fikr qanday zid kelgani ko‘rsatiladi.' },
  { raqam: 18, tur: 'Matching headings', javob: 'Heading ii', togri: 'Heading iv', izoh: 'Namuna izohida paragrafning asosiy fikri to‘g‘ri sarlavha bilan qanday mos kelishi tushuntiriladi.' },
];
---
<BolimQobiq title="Mashq natijalari · IELTS" description="IELTS Reading natijalarining dizayn namunasi." turi="vosita" bolim="ielts" holat="qoralama" yol={['Mashq']}>
  <div class="ichki ielts-sahifa">
    <header class="ielts-oqim">
      <div class="ielts-namuna-qator"><span class="yorliq">Namuna</span><p><span lang="en">Reading</span> · Sinov testi 01</p></div>
      <h1>Mashq natijalari</h1>
    </header>

    <div class="natija-tor">
      <section class="ielts-yuza ielts-oqim natija-karta" aria-labelledby="natija-sarlavha">
        <h2 class="ielts-kichik-sarlavha" id="natija-sarlavha">Umumiy natija</h2>
        <dl class="natija-qiymat">
          <div><dt>To‘g‘ri javoblar</dt><dd>24 <span>/ 40</span></dd></div>
          <div><dt>Band (taxminiy)</dt><dd>6.0</dd></div>
        </dl>
      </section>
      <section class="ielts-yuza ielts-oqim" aria-labelledby="turlar">
        <h2 class="ielts-kichik-sarlavha" id="turlar">Savol turi bo‘yicha aniqlik</h2>
        <ul class="ielts-qatorlar natija-turlar">
          {turlar.map((tur, i) => (
            <li>
              <p class="ielts-satr ielts-satr-oraliq" id={`tur-${i}`}><span lang="en">{tur.nom}</span><strong>{tur.togri} / {tur.jami}</strong></p>
              <progress class="ielts-olga" value={tur.togri} max={tur.jami} aria-labelledby={`tur-${i}`}></progress>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="ielts-oqim" aria-labelledby="xatolar">
      <div>
        <h2 id="xatolar">Noto‘g‘ri javoblar</h2>
        <p class="ielts-izoh">Javobingizni to‘g‘ri javob bilan solishtiring va izohni o‘qing.</p>
      </div>
      {xatolar.map((xato, i) => (
        <details class="ielts-yuza ielts-ochiladigan" open={i === 0}>
          <summary><span>{xato.raqam}-savol <span class="ielts-izoh" lang="en">· {xato.tur}</span></span><Belgi nom="pastga" /></summary>
          <div class="ielts-ochiladigan-ichki ielts-oqim">
            <dl class="natija-javoblar">
              <div><dt>Javobingiz</dt><dd lang="en">{xato.javob}</dd></div>
              <div><dt>To‘g‘ri javob</dt><dd lang="en">{xato.togri}</dd></div>
            </dl>
            <p>{xato.izoh}</p>
          </div>
        </details>
      ))}
    </section>

    <div class="ielts-amallar">
      <button class="tugma tugma-ikkinchi" type="button" disabled><Belgi nom="daftar" /> Xato daftariga saqlash</button>
      <a class="tugma tugma-asosiy" href={yol('/uz/ielts/vosita/xato-daftari/')}>Xato daftarini ochish</a>
      <a class="ielts-havola" href={yol('/uz/ielts/mashq/')}>Mashqlarga qaytish</a>
    </div>
  </div>
</BolimQobiq>

<style>
  .natija-tor { display: grid; gap: var(--space-4); }
  .natija-karta { align-content: start; }
  .natija-qiymat, .natija-javoblar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; gap: var(--space-2); }
  .natija-qiymat dt, .natija-javoblar dt { color: var(--color-text-secondary); font-size: var(--text-small-size); }
  .natija-qiymat dd {
    margin: 0;
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-lh);
    font-weight: var(--text-h1-weight);
    font-variant-numeric: tabular-nums;
  }
  .natija-qiymat dd span { font-size: var(--text-h3-size); color: var(--color-text-secondary); }
  .natija-qiymat div + div, .natija-javoblar div + div { border-inline-start: var(--border-width-1) solid var(--color-border); padding-inline-start: var(--space-3); }
  .natija-turlar li { display: grid; gap: var(--space-2); padding-block: var(--space-2); font-size: var(--text-small-size); }
  .natija-javoblar dd { margin: 0; font-weight: var(--text-button-weight); }
  @media (min-width: 768px) {
    .natija-tor { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
  }
</style>
