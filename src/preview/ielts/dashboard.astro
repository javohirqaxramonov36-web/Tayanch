---
import BolimQobiq from '../../layouts/BolimQobiq.astro';
import Belgi from '../../components/ielts/Belgi.astro';
import { yol } from '../../lib/yol';
import '../../styles/ielts.css';

const mashq = (modul: string) => yol(`/uz/ielts/mashq/${modul}/`);
const natija = yol('/uz/ielts/vosita/natijalar/');
const xatolar = yol('/uz/ielts/vosita/xato-daftari/');
const modullar = [
  { id: 'listening', nom: 'Listening', izoh: 'Audio va savollar' },
  { id: 'reading', nom: 'Reading', izoh: 'Matn va savollar' },
  { id: 'writing', nom: 'Writing', izoh: 'Yozma topshiriqlar' },
  { id: 'speaking', nom: 'Speaking', izoh: 'Og‘zaki mashq' },
] as const;
---
<BolimQobiq
  title="IELTS mashqlari"
  description="IELTS Academic mashqlari va natijalarining dizayn namunasi."
  turi="mashq"
  bolim="ielts"
  holat="qoralama"
>
  <div class="ichki ielts-sahifa">
    <header class="ielts-oqim">
      <div class="ielts-namuna-qator">
        <span class="yorliq">Namuna</span>
        <p>Bu sahifadagi band, jarayon va test holatlari ko‘rgazma uchun.</p>
      </div>
      <div>
        <h1>IELTS mashqlari</h1>
        <p class="kirish-izoh">Keyingi mashqni tanlang va tayyorgarligingizni kuzating.</p>
      </div>
    </header>

    <div class="asosiy-kartalar">
      <section class="ielts-yuza ielts-oqim keyingi-mashq" aria-labelledby="keyingi">
        <div class="ielts-satr">
          <span class="ds-karta-belgi"><Belgi nom="reading" /></span>
          <h2 id="keyingi" class="ielts-kichik-sarlavha">Keyingi qadam</h2>
        </div>
        <div>
          <p class="mashq-nom"><span lang="en">Reading</span> mashqini oching</p>
          <p class="ielts-izoh">Matnni o‘qing, dalilni belgilang va savollarga o‘ting.</p>
        </div>
        <div class="ielts-amallar">
          <a class="tugma tugma-asosiy" href={mashq('reading')}>Reading namunasini ochish <Belgi nom="oldinga" /></a>
        </div>
      </section>

      <section class="ielts-yuza ielts-oqim band-karta" aria-labelledby="band-sarlavha">
        <h2 id="band-sarlavha" class="ielts-kichik-sarlavha">Band maqsadi</h2>
        <dl class="band-qiymat">
          <div><dt>Joriy band (taxminiy)</dt><dd>6.0</dd></div>
          <div><dt>Maqsad</dt><dd>7.0</dd></div>
        </dl>
        <div class="ielts-oqim jarayon">
          <p id="mashq-jarayon" class="ielts-satr ielts-satr-oraliq"><strong>Tayyorgarlik jarayoni</strong><span>4 bo‘limdan 1 tasi</span></p>
          <progress class="ielts-olga" value="1" max="4" aria-labelledby="mashq-jarayon"></progress>
        </div>
      </section>
    </div>

    <section class="ielts-oqim" aria-labelledby="modullar">
      <h2 id="modullar">Mashq bo‘limlari</h2>
      <ul class="modul-tori">
        {modullar.map((modul) => (
          <li>
            <a class="ds-karta modul-karta" href={mashq(modul.id)}>
              <span class="modul-bosh">
                <span class="ds-karta-belgi"><Belgi nom={modul.id} /></span>
                <Belgi nom="oldinga" />
              </span>
              <strong lang="en">{modul.nom}</strong>
              <span class="ielts-izoh">{modul.izoh}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="ielts-yuza ielts-oqim" aria-labelledby="sinovlar">
      <div>
        <h2 id="sinovlar">To‘liq sinov testlari</h2>
        <p class="ielts-izoh">E’lon qilingan testlarni istalgan tartibda ishlashingiz mumkin.</p>
      </div>
      <ul class="ielts-qatorlar testlar">
        <li class="ielts-satr">
          <span class="test-raqam" aria-hidden="true">01</span>
          <div class="test-nomi"><strong>Sinov testi 01</strong><span class="ielts-izoh"><Belgi nom="belgilandi" /> Yakunlangan</span></div>
          <a class="ielts-havola" href={natija}>Natijani ko‘rish <Belgi nom="oldinga" /></a>
        </li>
        <li class="ielts-satr">
          <span class="test-raqam" aria-hidden="true">02</span>
          <div class="test-nomi"><strong>Sinov testi 02</strong><span class="ielts-izoh">Ochiq</span></div>
          <a class="ielts-havola" href={mashq('reading')}>Ekran namunasi <Belgi nom="oldinga" /></a>
        </li>
        <li class="ielts-satr">
          <span class="test-raqam" aria-hidden="true">03</span>
          <div class="test-nomi"><strong>Sinov testi 03</strong><span class="ielts-izoh"><Belgi nom="yopiq" /> Yopiq · E’lon qilinadi</span></div>
        </li>
      </ul>
    </section>

    <a class="ds-karta daftar-karta" href={xatolar}>
      <span class="ds-karta-belgi"><Belgi nom="daftar" /></span>
      <span><strong>Xato daftari</strong><span class="ielts-izoh">Dars va test xatolarini qayta ishlang.</span></span>
      <Belgi nom="oldinga" />
    </a>
  </div>
</BolimQobiq>

<style>
  .kirish-izoh { margin-block-start: var(--space-2); color: var(--color-text-secondary); }
  .asosiy-kartalar { display: grid; gap: var(--space-3); }
  .keyingi-mashq { align-content: space-between; }
  .mashq-nom {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-lh);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-ls);
  }
  .mashq-nom + p { margin-block-start: var(--space-2); }
  .band-qiymat { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .band-qiymat div + div { border-inline-start: var(--border-width-1) solid var(--color-border); padding-inline-start: var(--space-4); }
  .band-qiymat dt, .jarayon p { font-size: var(--text-small-size); }
  .band-qiymat dt, .jarayon span { color: var(--color-text-secondary); }
  .band-qiymat dd {
    margin: 0;
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-lh);
    letter-spacing: var(--text-h1-ls);
    font-weight: var(--text-h1-weight);
    font-variant-numeric: tabular-nums;
  }
  .jarayon { gap: var(--space-2); }
  .modul-tori { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); list-style: none; padding: 0; margin: 0; }
  .modul-karta { display: grid; align-content: start; gap: var(--space-1); height: 100%; padding: var(--space-3); }
  .modul-bosh { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); margin-block-end: var(--space-2); }
  .ds-karta-belgi { display: grid; place-items: center; padding: 0; }
  .testlar li { padding-block: var(--space-2); }
  .test-raqam {
    display: grid;
    place-items: center;
    inline-size: var(--size-touch-min);
    block-size: var(--size-touch-min);
    border-radius: var(--radius-md);
    background: var(--color-surface-sunken);
    font-size: var(--text-small-size);
    font-weight: var(--text-button-weight);
    font-variant-numeric: tabular-nums;
  }
  .test-nomi { display: grid; flex: 1 1 var(--space-16); }
  .test-nomi span { display: flex; align-items: center; gap: var(--space-1); }
  .test-nomi :global(.ielts-belgi) { inline-size: var(--size-icon-sm); block-size: var(--size-icon-sm); }
  .testlar .ielts-havola { font-size: var(--text-small-size); }
  .daftar-karta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .daftar-karta strong, .daftar-karta .ielts-izoh { display: block; }
  @media (min-width: 768px) {
    .asosiy-kartalar { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .modul-tori { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .modul-karta { padding: var(--space-4); }
  }
</style>
