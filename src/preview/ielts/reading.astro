---
import IeltsFokus from '../../layouts/IeltsFokus.astro';
import Belgi from '../../components/ielts/Belgi.astro';
import SavolNamunalari from '../../components/ielts/SavolNamunalari.astro';
import SavolYoli from '../../components/ielts/SavolYoli.astro';
import Topshirish from '../../components/ielts/Topshirish.astro';
import { yol } from '../../lib/yol';

const savollar = ['javob', 'javob', 'joriy', 'bosh', 'bayroq', 'bosh', 'bosh', 'bosh'] as const;
---
<IeltsFokus nom="Reading" tavsif="Reading mashqining dizayn namunasi." vaqt="47:28">
  <div class="reading-tor">
    <section class="ielts-yuza ielts-oqim parcha" aria-labelledby="parcha-sarlavha">
      <div class="ielts-satr ielts-satr-oraliq">
        <h2 id="parcha-sarlavha" class="ielts-kichik-sarlavha">O‘qish matni</h2>
        <span class="yorliq">1-parcha</span>
      </div>
      <div class="ielts-satr parcha-vositalar">
        <button class="tugma tugma-ikkinchi" type="button" disabled><Belgi nom="marker" /> Ajratish</button>
        <a class="ielts-havola parcha-sakrash" href="#savollar">Savollarga o‘tish <Belgi nom="pastga" /></a>
      </div>
      <div class="parcha-matn ielts-oqim" lang="en">
        <h3>Sample passage</h3>
        <p><strong>A</strong><span>The passage title and numbered paragraphs appear here. Read the text on this side and refer to it while working through the questions.</span></p>
        <p><strong>B</strong><span>A <mark>highlighted phrase</mark> shows how an annotation appears within the text. Notes sit below the passage so the text remains easy to read.</span></p>
      </div>
      <details class="ielts-yuza ielts-ochiladigan">
        <summary><span class="ielts-satr"><Belgi nom="eslatma" /> Eslatma</span><Belgi nom="pastga" /></summary>
        <div class="ielts-ochiladigan-ichki ielts-oqim">
          <label for="reading-eslatma">Eslatma matni</label>
          <textarea class="ielts-maydon" id="reading-eslatma" rows="3" readonly>Namuna: B xatboshiga qaytib qarang.</textarea>
        </div>
      </details>
    </section>
    <SavolNamunalari modul="reading" />
  </div>
  <SavolYoli savollar={savollar} />
  <Topshirish
    natija={yol('/uz/ielts/vosita/natijalar/')}
    tavsif="6 ta savolga javob berilmagan. Mashqqa qaytishingiz yoki natija namunasini ochishingiz mumkin."
    amal="Natija namunasini ko‘rish"
  />
</IeltsFokus>

<style>
  .reading-tor { display: grid; gap: var(--space-4); align-items: start; }
  .parcha-vositalar .tugma { padding-inline: var(--control-pad-sm); }
  .parcha-matn {
    padding-block: var(--space-3);
    border-block-start: var(--border-width-1) solid var(--color-border);
  }
  .parcha-matn h3 { margin-block-end: var(--space-1); }
  .parcha-matn p { display: grid; grid-template-columns: var(--space-5) minmax(0, 1fr); gap: var(--space-2); }
  .parcha-matn mark {
    padding-inline: var(--space-1);
    background: var(--color-warning-subtle);
    color: var(--color-warning-text);
    border-radius: var(--radius-sm);
  }
  @media (min-width: 768px) {
    .reading-tor { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
    .parcha-sakrash { display: none; }
  }
</style>
