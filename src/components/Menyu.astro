---
import { yol } from '../lib/yol';
import Lift from './Lift.astro';
import { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } from 'astro:env/client';
// Bo'limlarga o'tishni lift bajaradi (Tayanch binosi, 5 qavat).
// Hisob (bitta, butun sayt uchun): "Kirish" / "Hisobim". Faqat Supabase sozlangan build'da chiqadi;
// holatni src/lib/hisobHolat.ts yangilaydi. Hisob sahifalarining o'zida ?keyin= qo'shilmaydi.
const hisobBor = Boolean(PUBLIC_SUPABASE_URL && PUBLIC_SUPABASE_ANON_KEY);
const joriy = Astro.url.pathname;
const hisobSahifasida = joriy.startsWith(yol('/uz/hisob/'));
const hisobKirish = yol('/uz/hisob/kirish/') + (hisobSahifasida ? '' : `?keyin=${encodeURIComponent(joriy)}`);
const hisobProfil = yol('/uz/hisob/profil/');
---
<header class="menyu-qator">
  <div class="ichki menyu-ichki">
    <a class="logo" href={yol('/uz/')}>
      <span class="logo-belgi" aria-hidden="true">T</span>
      <span class="logo-nom">Tayanch</span>
    </a>
    <nav aria-label="Asosiy menyu">
      <ul>
        <li><a href={yol('/uz/#qavatlar')}>Yo'nalishlar</a></li>
        <li><a href={yol('/uz/deadline/')}>Muddatlar</a></li>
        <li><a href={yol('/uz/manbalar/')}>Manbalar</a></li>
        {hisobBor && (
          <li>
            <a
              class="hisob-menyu" href={hisobKirish} data-hisob-havola
              data-kirish={hisobKirish} data-profil={hisobProfil}
              data-matn-kirish="Kirish" data-matn-kirgan="Hisobim"
            >
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
              <span data-hisob-nom>Kirish</span>
            </a>
          </li>
        )}
        <li><a class="boshlash" href={yol('/uz/?boshlash=1')} data-boshlash>Boshlash</a></li>
      </ul>
    </nav>
    <Lift variant="menyu" />
  </div>
</header>

<script>
  import { hisobHavolalari } from '../lib/hisobHolat';
  hisobHavolalari();
</script>

<style>
  /* Liquid Glass (topbar) */
  .menyu-qator { background: var(--glass-sheen), var(--glass-chrome-bg); -webkit-backdrop-filter: var(--glass-backdrop); backdrop-filter: var(--glass-backdrop); box-shadow: var(--glass-edge), var(--glass-shadow); border-bottom: var(--border-width-1) solid var(--color-border); }
  .menyu-ichki {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--b-3);
    padding-block: 14px;
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-belgi {
    width: 36px; height: 36px;
    border-radius: 12px;
    background: var(--matn);
    color: var(--fon);
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 20px;
  }
  .logo-nom { font-weight: 900; font-size: 22px; }
  ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--b-1) var(--b-5);
    font-weight: 600; font-size: 15px;
  }
  ul a { text-decoration: none; display: inline-block; padding-block: 10px; }
  ul a:hover { color: var(--rang-havola); }
  /* DS btn-primary, md */
  ul a.boshlash {
    display: inline-flex; align-items: center; min-height: var(--control-height-md);
    background: var(--btn-primary-bg); color: var(--btn-primary-text);
    border-radius: var(--btn-radius); padding-block: 0; padding-inline: var(--control-pad-md);
    font-weight: var(--text-button-weight);
  }
  ul a.hisob-menyu { display: inline-flex; align-items: center; gap: 6px; }
  ul a.boshlash:hover { background: var(--btn-primary-bg-hover); color: var(--btn-primary-text); }
</style>
