---
import { bolimlar } from '../data/bolimlar';
import { yol } from '../lib/yol';

const ochiq = bolimlar.filter((b) => b.holat === 'ochiq');
---
<header class="menyu-qator">
  <div class="ichki menyu-ichki">
    <a class="logo" href={yol('/uz/')}>
      <span class="logo-belgi" aria-hidden="true">T</span>
      <span class="logo-nom">Tayanch</span>
    </a>
    <nav aria-label="Asosiy menyu">
      <ul>
        <li><a href={yol('/uz/#yonalish')}>Yo'nalishlar</a></li>
        {ochiq.map((b) => <li><a href={yol(`/uz/${b.slug}/`)}>{b.nomi}</a></li>)}
        <li><a href={yol('/uz/deadline/')}>Muddatlar</a></li>
        <li><a href={yol('/uz/manbalar/')}>Manbalar</a></li>
        <li><a class="boshlash" href={yol('/uz/#yonalish')}>Boshlash</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .menyu-qator { background: var(--sirt); border-bottom: 1px solid var(--chiziq); }
  .menyu-ichki {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--b-3);
    padding-block: 14px;
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-belgi {
    width: 36px; height: 36px;
    border-radius: 12px;
    background: var(--qora);
    color: #ffffff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 20px;
  }
  .logo-nom { font-weight: 900; font-size: 22px; }
  ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--b-1) var(--b-5);
    font-weight: 600; font-size: 15px;
  }
  ul a { text-decoration: none; display: inline-block; padding-block: 10px; }
  ul a:hover { color: var(--rang-asosiy); }
  ul a.boshlash {
    background: var(--rang-asosiy); color: var(--rang-asosiy-matn);
    border-radius: var(--r-toliq); padding: 9px 16px;
  }
  ul a.boshlash:hover { background: var(--rang-asosiy-toq); color: var(--rang-asosiy-matn); }
</style>
