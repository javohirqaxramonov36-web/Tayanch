---
// Telegram kanal/guruh tugmasi. Havola: src/data/telegram.ts (bo'sh bo'lsa production'da chiqmaydi).
import { telegram, telegramHref, telegramKorinadi, type TelegramTuri } from '../data/telegram';

interface Props {
  turi: TelegramTuri;
  matn: string;
  /** Ekran o'quvchi uchun: "(yangi tabda ochiladi)" */
  yangiTab: string;
  variant?: 'asosiy' | 'ikkinchi';
}
const { turi, matn, yangiTab, variant = 'ikkinchi' } = Astro.props;
const korinadi = telegramKorinadi(turi);
const haqiqiy = Boolean(telegram[turi]);
---
{korinadi && (
  <a
    class:list={['katta', variant, 'telegram-tugma']}
    href={telegramHref(turi)}
    {...(haqiqiy ? { target: '_blank', rel: 'noopener' } : { 'data-placeholder': '' })}
  >
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13.1 1.4 11.6c-1-.3-1-1 .2-1.5L20.6 2.8c.9-.3 1.6.2 1.3 1.5Z"/></svg>
    <span>{matn}</span>
    {haqiqiy && <span class="ekranda-yoq">{yangiTab}</span>}
  </a>
)}

<style>
  .telegram-tugma { display: inline-flex; align-items: center; gap: var(--b-2); }
  .telegram-tugma svg { flex: none; }
</style>
