---
// Google bilan kirish tugmasi uchun joy. Ulanishi alohida vazifa (P03B): hozircha o'chirilgan.
// P03B da: `disabled` olib tashlanadi va skriptda supabase.auth.signInWithOAuth({ provider: 'google',
// options: { redirectTo: toliqManzil(keyingiManzil()) } }) chaqiriladi (src/lib/hisob.ts).
// Google logosi ishlatilmaydi (brend qoidalari P03B da tekshiriladi), umumiy ikonka.
---
<div class="hisob-maydon">
  <button type="button" class="tugma tugma-ikkinchi" id="google-tugma" disabled aria-describedby="google-izoh">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 12h8M3.6 9h16.8M3.6 15h16.8" /></svg>
    Google bilan kirish
  </button>
  <p class="hisob-izoh" id="google-izoh">Google bilan kirish tez orada qo'shiladi.</p>
</div>
