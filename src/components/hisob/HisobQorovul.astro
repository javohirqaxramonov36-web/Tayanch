---
// Himoyalangan sahifa qorovuli. Ichidagi kontent sessiya tekshirilguncha yashirin.
// Sessiya yo'q: kirish sahifasiga ?keyin=<shu sahifa> bilan yuboradi (src/lib/hisob.ts, hisobQorovul).
// Hisob o'chirilgan (env yo'q): HisobKarta'dagi ogohlik ko'rinadi, kontent yashirin qoladi.
// Sahifa skripti sessiyani `await hisobQorovul()` bilan oladi (bir xil va'da, ikki marta so'ralmaydi).
---
<div class="hisob-qorovul">
  <p class="hisob-holat" role="status" data-qorovul-kutish>Checking your account…</p>
  <div data-qorovul-ichi hidden>
    <slot />
  </div>
</div>

<script>
  import { hisobQorovul, hisobYoqBolsa } from '../../lib/hisob';

  const kutish = document.querySelector<HTMLElement>('[data-qorovul-kutish]');
  const ichi = document.querySelector<HTMLElement>('[data-qorovul-ichi]');
  if (hisobYoqBolsa()) {
    if (kutish) kutish.hidden = true;
  } else {
    hisobQorovul().then((sessiya) => {
      if (!sessiya) return; // kirish sahifasiga yo'naltirildi
      if (kutish) kutish.hidden = true;
      if (ichi) ichi.hidden = false;
    });
  }
</script>
