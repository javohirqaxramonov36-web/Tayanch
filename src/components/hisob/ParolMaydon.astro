---
// Parol maydoni: ko'rsatish/yashirish tugmasi (<button>, nomi holatga qarab), izoh va xato aria bilan bog'langan.
// Parol qiymati hech qayerga yozilmaydi (console, localStorage yo'q).
interface Props {
  id: string;
  nomi: string;
  autocomplete: 'current-password' | 'new-password';
  izoh?: string;
}
const { id, nomi, autocomplete, izoh } = Astro.props;
const tasvir = [izoh ? `${id}-izoh` : null, `${id}-xato`].filter(Boolean).join(' ');
---
<div class="hisob-maydon">
  <label for={id}>{nomi}</label>
  {izoh && <p class="hisob-izoh" id={`${id}-izoh`}>{izoh}</p>}
  <div class="parol-qobiq">
    <input
      class="hisob-kirit"
      id={id}
      name={id}
      type="password"
      autocomplete={autocomplete}
      required
      spellcheck="false"
      autocapitalize="none"
      aria-describedby={tasvir}
    />
    <button type="button" class="parol-korsat" aria-controls={id} data-korinadi="false" data-parol-korsat>
      <svg class="koz" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
      <svg class="koz-yopiq" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18" /><path d="M10.6 5.1A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.6 6.6C3.7 8.4 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
      <span>Ko'rsatish</span>
    </button>
  </div>
  <p class="hisob-xato" id={`${id}-xato`} hidden></p>
</div>

<style>
  .parol-qobiq { position: relative; }
  .parol-qobiq .hisob-kirit { padding-right: 136px; }
  .parol-korsat {
    position: absolute; top: 2px; right: 2px; bottom: 2px;
    min-width: 124px; padding: 0 var(--b-3);
    display: inline-flex; align-items: center; justify-content: center; gap: var(--b-2);
    border: none; border-radius: 0 14px 14px 0;
    background: transparent; color: var(--rang-havola);
    font: inherit; font-size: var(--matn-kichik); font-weight: 700; cursor: pointer;
  }
  .parol-korsat:hover { background: var(--fon-ikkinchi); }
  .parol-korsat .koz-yopiq { display: none; }
  .parol-korsat[data-korinadi='true'] .koz { display: none; }
  .parol-korsat[data-korinadi='true'] .koz-yopiq { display: block; }
</style>

<script>
  // Bir sahifada bir nechta parol maydoni bo'lishi mumkin: har biri o'z tugmasi bilan.
  document.querySelectorAll<HTMLButtonElement>('[data-parol-korsat]').forEach((tugma) => {
    const input = document.getElementById(tugma.getAttribute('aria-controls') ?? '') as HTMLInputElement | null;
    const yozuv = tugma.querySelector('span');
    if (!input || !yozuv) return;
    const nom = input.labels?.[0]?.textContent?.trim().toLowerCase() ?? 'parol';
    const yangila = (korinadi: boolean) => {
      input.type = korinadi ? 'text' : 'password';
      // Holat tugma nomida aytiladi ("Parolni ko'rsatish" / "Parolni yashirish"), aria-pressed bilan birga emas.
      tugma.dataset.korinadi = String(korinadi);
      const fel = korinadi ? 'yashirish' : "ko'rsatish";
      yozuv.textContent = korinadi ? 'Yashirish' : "Ko'rsatish";
      tugma.setAttribute('aria-label', `${nom.charAt(0).toUpperCase() + nom.slice(1)}ni ${fel}`);
    };
    yangila(false);
    tugma.addEventListener('click', () => yangila(input.type === 'password'));
    // Forma yuborilganda parol yana yashiriladi (brauzer parol menejeri to'g'ri ishlashi uchun).
    input.form?.addEventListener('submit', () => yangila(false));
  });
</script>
