---
// 1-qavat · Bosh sahifa tariflar bo'limi. Kartalar, taqqoslash va FAQ: TarifTanlov.
// Pro narxi src/data/tariflar.ts dan; to'lov SAT Subscription sahifasida (/uz/sat/hisob/obuna/).
import TarifTanlov from './TarifTanlov.astro';
---
<section class="home-pricing" aria-labelledby="tarif-h">
  <p class="nav-chip tarif-label">Tariflar</p>
  <h2 id="tarif-h" class="nav-nom">Oʻzingizga mos tarifni tanlang</h2>
  <p class="tarif-lead">Asosiy imkoniyatlar bepul. Pullik tarif hozircha faqat SAT boʻlimida.</p>
  <TarifTanlov id="bosh-tarif" />
</section>
<style>
  /* 1-qavat Navigator mini-DS: yorliq NavYorliq (.nav-chip), sarlavha .nav-nom, bitta urg'u (laym, faqat sahnada) */
  .home-pricing { display: grid; gap: var(--space-3); padding-block: 0 var(--space-12); }
  .home-pricing > :not(.tt) { justify-self: start; }
  .tarif-lead { margin: 0 0 var(--space-8); color: var(--color-nav-text-muted); max-width: 60ch; }
</style>
