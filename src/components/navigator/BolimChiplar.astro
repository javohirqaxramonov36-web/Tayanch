---
// Telefonda (< 768px) bo'limlar orasida o'tish (2026-11-27, muallif tanlovi: "B: ustki chiplar", branch bolim-otish).
// Sarlavha ichida ikkinchi qator: gorizontal suriladigan chiplar, sarlavha bilan birga tepada qoladi (sticky).
// Chip = oddiy havola, bosilsa bo'lim bosh sahifasi ochiladi. Joriy bo'lim chipi to'ldirilgan (aria-current="page"
// faqat aynan bo'lim bosh sahifasida) va yuklanganda ko'rinadigan joyga suriladi. Hech narsa saqlanmaydi.
// >= 768px da yashirin: u yerda QavatMenyu.
import { qavatlar } from '../../data/qavatlar';
import { yol } from '../../lib/yol';
import { yolTili } from '../../data/umumiyMatn';

const aktiv = Astro.url.pathname;
const EN = yolTili(aktiv) === 'en';
const nom = (slug: string, nomi: string) => slug === 'navigator' ? (EN ? 'Home' : 'Bosh sahifa') : slug === 'sat' ? 'SAT' : slug === 'ielts' ? 'IELTS' : slug === 'eyuf' ? 'El-Yurt Umidi' : nomi;
---
<nav class="bc" aria-label={EN ? 'Sections' : 'Boʻlimlar'} lang={EN ? 'en' : 'uz'} data-bc>
  <ul class="bc-royxat" role="list">
    {qavatlar.map((q) => {
      const bosh = yol(q.manzil);
      const shu = q.slug === 'navigator' ? aktiv === yol('/uz/') : aktiv.startsWith(bosh);
      return <li><a class:list={['bc-chip', { faol: shu }]} href={bosh} aria-current={aktiv === bosh ? 'page' : undefined} data-bc-faol={shu ? '' : undefined}>{nom(q.slug, q.nomi)}</a></li>;
    })}
  </ul>
</nav>

<script>
  // Joriy chip ko'rinmasa, qator uni o'rtaga suradi (sahifa o'zi aylanmaydi).
  document.querySelectorAll<HTMLElement>('[data-bc]').forEach((bc) => {
    const r = bc.querySelector<HTMLElement>('.bc-royxat');
    const f = bc.querySelector<HTMLElement>('[data-bc-faol]');
    if (r && f) r.scrollLeft = f.offsetLeft - (r.clientWidth - f.offsetWidth) / 2;
  });
</script>

<style>
  .bc { display: none; }
  @media (width < 768px) {
    .bc { display: block; flex-basis: 100%; order: 10; min-width: 0; margin-inline: calc(-1 * var(--space-4)); }
    .bc-royxat { display: flex; gap: var(--space-2); list-style: none; margin: 0; padding: var(--space-1) var(--space-4) var(--space-2); overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
    .bc-royxat::-webkit-scrollbar { display: none; }
    .bc-royxat li { flex: none; }
    .bc-chip { display: flex; align-items: center; min-height: var(--size-touch-min); padding-inline: var(--space-4); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-full); background: var(--color-surface); color: var(--color-text-primary); font-size: var(--text-small-size); font-weight: 600; white-space: nowrap; text-decoration: none; }
    .bc-chip.faol { border-color: var(--header-accent); background: var(--header-accent); color: var(--header-on-accent); }
  }
</style>
