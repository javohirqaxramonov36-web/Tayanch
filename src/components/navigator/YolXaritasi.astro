---
// Navigator tepasidagi shaxsiy blok: salom, "Keyingi qadam" kartasi, yo'l xaritasi va "qayta tuzish".
// Ko'rinish: Navigator mini-DS (nav.css) qora sahnasi; kartasi NavRamka, qadamlar NavYol (navYol.ts chizadi).
// Ko'rinishi <html data-yol="bor"> ga bog'liq (YolBelgisi.astro). Mazmunni skript chizadi.
// Qadam "tayyor"ligi shu yerda, build paytida hisoblanadi: sahifa fayli src/pages da bo'lishi kerak.
// Qoidalarda noma'lum ID bo'lsa build to'xtaydi (to'qima havola chiqmasligi uchun).
import { globSync } from 'node:fs';
import { sep } from 'node:path';
import Onboarding from './Onboarding.astro';
import NavYol from './NavYol.astro';
import NavRamka from './NavRamka.astro';
import { navigatorMatni } from '../../data/navigatorMatn';
import { navigatorSahifalar } from '../../data/navigatorSahifalar';
import { qoidalar, UMUMIY_REJA } from '../../data/yolXaritasiQoidalar';
import { faylManzili, nomalumIdlar, tayyorlikniBelgila } from '../../lib/navigator/yolXaritasi';

const nomalum = nomalumIdlar(qoidalar, UMUMIY_REJA, navigatorSahifalar);
if (nomalum.length) throw new Error(`yolXaritasiQoidalar: noma'lum sahifa ID: ${nomalum.join(', ')}`);

// Build loyiha ildizidan ishga tushadi (statik sayt): sahifa fayllari ro'yxati shu yerdan olinadi.
const fayllar = globSync('src/pages/**/index.astro', { cwd: process.cwd() }).map((f) => '/' + f.split(sep).join('/'));
const mavjud = new Set(fayllar.map(faylManzili).filter((x): x is string => !!x));
const sahifalar = tayyorlikniBelgila(navigatorSahifalar, mavjud);
const m = navigatorMatni('uz');
---
<section class="ichki yol-blok" data-yol-blok aria-labelledby="yol-salom">
  <div class="nav-sahna yol-sahna">
    <div class="yol-bosh">
      <h2 id="yol-salom" class="nav-nom yol-salom" tabindex="-1" data-yol-salom></h2>
      <p class="yol-meta">
        <span class="nav-chip nav-chip--sahna" data-yol-bugun hidden></span>
        <span class="nav-chip nav-chip--sahna" data-yol-muddat hidden></span>
      </p>
    </div>

    <NavRamka sarlavha={m.keyingiQadam} class="keyingi" data-yol-keyingi hidden>
      <div class="keyingi-ichi">
        <div class="keyingi-matn">
          <p class="keyingi-nom" id="keyingi-nom" data-yol-k-nom></p>
          <p class="keyingi-izoh" data-yol-k-izoh></p>
        </div>
        <a class="t-tugma keyingi-tugma" data-yol-k-havola aria-describedby="keyingi-nom">{m.boshlash}</a>
      </div>
    </NavRamka>

    <div class="yol-royxat">
      <h3 class="nav-nom yol-sarlavha">{m.yolXaritasi}</h3>
      <p class="yol-asosiy" data-yol-asosiy hidden></p>
      <NavYol aria-label={m.yolXaritasiRoyxat} data-yol-qadamlar />
      <p class="yol-ogoh" data-yol-ogoh hidden></p>
      <p class="yol-izoh" data-yol-izoh></p>
      <p class="yol-izoh" data-yol-saqlanmadi hidden>{m.saqlanmadi}</p>
      <div>
        <button type="button" class="t-tugma t-tugma--ikkinchi" data-yol-qayta>{m.qaytaTuzish}</button>
      </div>
    </div>
  </div>
</section>

<Onboarding />
<script type="application/json" id="navigator-sahifalar" set:html={JSON.stringify(sahifalar)} />

<script>
  import { navigatorniIshgaTushir } from '../../lib/navigator/boshqaruv';
  navigatorniIshgaTushir();
</script>

<style>
  /* Navigator mini-DS: qora sahna (nav.css). Sahnada matn nav-on-stage, ikkinchi matn on-stage-muted (7.5:1). */
  .yol-blok { display: none; }
  :global(html[data-yol='bor']) .yol-blok { display: block; padding-block: var(--space-6) var(--space-10); }
  .yol-sahna { display: flex; flex-direction: column; gap: var(--space-8); }
  .yol-bosh { display: flex; flex-direction: column; gap: var(--space-3); }
  .yol-salom { min-height: 1em; }
  .yol-salom:focus { outline: none; }
  .yol-salom:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); border-radius: var(--radius-sm); }
  .yol-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0; }

  .keyingi[hidden] { display: none; }
  .keyingi-ichi { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .keyingi-matn { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .keyingi-nom { margin: 0; font-size: var(--text-h3-size); line-height: var(--text-h3-lh); font-weight: var(--font-weight-bold); color: var(--color-nav-on-stage); }
  .keyingi-izoh { margin: 0; color: var(--color-nav-on-stage-muted); }
  .keyingi-izoh:empty { display: none; }
  .keyingi-tugma { flex: none; }

  .yol-royxat { display: flex; flex-direction: column; gap: var(--space-4); }
  .yol-royxat [hidden] { display: none; }
  .yol-sarlavha { margin-bottom: var(--space-2); }
  .yol-asosiy { margin: 0; color: var(--color-nav-on-stage-muted); }
  .yol-izoh { margin: 0; color: var(--color-nav-on-stage-muted); font-size: var(--text-small-size); line-height: var(--text-small-lh); }
  /* Ogohlik: holat juftligi (poydevor), sahnada ham tekis fonda */
  .yol-ogoh {
    margin: 0; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm);
    background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn); font-size: var(--text-small-size);
  }

  @media (max-width: 640px) {
    .keyingi-tugma { width: 100%; }
  }
</style>
