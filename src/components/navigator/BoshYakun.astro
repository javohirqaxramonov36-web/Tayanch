---
// Bosh sahifa oxiri (CTA brifi, 2026-11-24): konturli marquee (bezak, aria-hidden) va laym yakuniy banner.
// Marquee faqat transform bilan siljiydi, ekrandan chiqsa to'xtaydi, reduced motion'da qimirlamaydi.
// "bugun." qora fonli blok: inline-block + line-height 1 (aks holda fon 1-qatorga chiqib qoladi).
// Isbot chiplari: asoschining shaxsiy natijalari (muallif brifi), kafolat emas.
import { asoschiNatijalari } from '../../data/boshSahifa';

const qator = 'Top Admission ✦ SAT ✦ IELTS ✦ El-Yurt Umidi ✦';
---
<div class="by-marquee" aria-hidden="true" data-by-marquee>
  <div class="by-iz">
    {[0, 1, 2, 3].map(() => <span>{qator}</span>)}
  </div>
</div>
<section class="by-banner" aria-labelledby="by-h">
  <p class="by-yorliq">Keyingi qadam</p>
  <h2 id="by-h" class="by-sarlavha">Birinchi qadam — <span>bugun.</span></h2>
  <p class="by-matn">Qavatni tanlang va bepul darsni hoziroq boshlang. Reja, mashq va tahlil — bitta joyda.</p>
  <div class="by-harakatlar">
    <a class="by-tugma" href="#qavat-tanlash" data-qavat-tanlash>
      Qavatni tanlang
      <svg class="by-strelka" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
    <a class="by-havola" href="https://t.me/tayanch_go" rel="noopener">Telegram kanal</a>
  </div>
  <ul class="by-chiplar" role="list">{asoschiNatijalari.map((x) => <li>{x}</li>)}</ul>
  <p class="by-izoh">Asoschining shaxsiy natijalari, kurssiz. Bu natija kafolati emas.</p>
</section>
<script>
  const m = document.querySelector<HTMLElement>('[data-by-marquee]');
  if (m) new IntersectionObserver(([y]) => { m.dataset.harakat = y.isIntersecting ? '' : 'toxta'; }).observe(m);
</script>
<style>
  .by-marquee { overflow: hidden; border-block: var(--border-width-1) solid var(--color-nav-line); padding-block: var(--space-4); }
  .by-iz {
    display: flex; width: max-content; gap: var(--space-10);
    font-family: var(--font-display); font-weight: var(--font-weight-bold);
    font-size: var(--text-nav-raqam-size); line-height: var(--text-nav-sarlavha-lh); text-transform: uppercase; white-space: nowrap;
    color: transparent; -webkit-text-stroke: var(--border-width-1) var(--color-nav-line-strong);
    animation: by-siljish var(--nav-marquee-davomi) linear infinite;
  }
  .by-iz span { padding-inline-end: var(--space-8); }
  @keyframes by-siljish { to { transform: translateX(-50%); } }
  .by-marquee[data-harakat="toxta"] .by-iz { animation-play-state: paused; }

  .by-banner {
    display: grid; gap: var(--space-6); justify-items: start;
    padding: var(--space-12) var(--space-6); border-radius: var(--radius-xl);
    background: var(--color-nav-lime); color: var(--color-nav-on-lime);
    --color-focus-ring: var(--color-nav-on-lime); --color-focus-gap: var(--color-nav-lime);
  }
  .by-yorliq {
    margin: 0; padding: var(--space-1) var(--space-2); border: var(--border-width-1) solid var(--color-nav-on-lime); border-radius: var(--radius-sm);
    font: var(--font-weight-medium) var(--text-nav-yorliq-size) / var(--text-nav-yorliq-lh) var(--font-mono); letter-spacing: var(--text-nav-yorliq-ls); text-transform: uppercase;
  }
  .by-sarlavha {
    margin: 0; font-family: var(--font-display); font-weight: var(--font-weight-bold);
    font-size: var(--text-nav-hero-size); line-height: var(--text-nav-sarlavha-lh); letter-spacing: var(--text-nav-sarlavha-ls);
    text-transform: uppercase; text-wrap: balance;
  }
  .by-sarlavha span {
    display: inline-block; line-height: var(--text-nav-sarlavha-lh); margin-top: var(--space-2);
    padding-inline: var(--space-3); background: var(--color-nav-on-lime); color: var(--color-nav-lime);
  }
  .by-matn { margin: 0; max-width: var(--home-copy-width); font-size: var(--text-body-size); line-height: var(--text-body-lh); }
  .by-harakatlar { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); align-items: center; }
  .by-tugma {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: var(--btn-glass-height); padding: 0 var(--space-8); border-radius: var(--radius-full);
    background: var(--color-nav-stage); color: var(--color-nav-on-stage);
    font-size: var(--text-button-size); line-height: var(--text-button-lh); font-weight: var(--text-button-weight); text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-state);
  }
  .by-tugma:active { transform: var(--bosilish); }
  .by-tugma svg { width: var(--size-icon-md); height: var(--size-icon-md); transition: transform var(--duration-base) var(--ease-state); }
  @media (hover: hover) and (pointer: fine) { .by-tugma:hover svg { transform: translateX(var(--nav-strelka-siljish)); } }
  .by-tugma:focus-visible svg { transform: translateX(var(--nav-strelka-siljish)); }
  .by-havola { display: inline-flex; align-items: center; min-height: var(--size-touch-min); color: var(--color-nav-on-lime); font-weight: var(--font-weight-semibold); text-decoration: underline; text-underline-offset: 0.2em; }
  .by-chiplar { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .by-chiplar li {
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-nav-on-lime) 10%, transparent);
    font: var(--font-weight-medium) var(--text-nav-kod-size) / var(--text-nav-kod-lh) var(--font-mono);
  }
  .by-izoh { margin: 0; font-size: var(--text-caption-size); line-height: var(--text-small-lh); }
  @media (min-width: 640px) { .by-banner { padding: var(--space-16) var(--space-12); } }

  @media (prefers-reduced-motion: reduce) {
    .by-iz { animation: none; }
    .by-tugma, .by-tugma svg { transition: none; }
  }
  :global(:root[data-motion="reduced"]) .by-iz { animation: none; }
</style>
