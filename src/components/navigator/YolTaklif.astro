---
// Navigator: birinchi tashrif kartasi (2026-11-12). Onboarding oynasi o'zi ochilmaydi, shu karta bosh sarlavha
// ostida taklif qiladi. Skript (src/lib/navigator/boshqaruv.ts) profil yo'qligini aniqlagach `hidden` ni olib tashlaydi;
// kirgan foydalanuvchida hisobdagi profil kutiladi, shuning uchun qaytuvchida karta chaqnamaydi.
// "Boshlash" oynani ochadi, "Hozir emas" oynadagi "O'tkazib yuborish" bilan bir xil ishlaydi.
import { navigatorMatni } from '../../data/navigatorMatn';
const m = navigatorMatni('uz');
---
<section class="ichki taklif-qobiq" data-yol-taklif aria-labelledby="yol-taklif-h" hidden>
  <div class="yol-taklif">
    <div class="taklif-matn">
      <h2 id="yol-taklif-h" class="taklif-sarlavha">{m.taklifSarlavha}</h2>
      <p class="taklif-izoh">{m.taklifIzoh}</p>
    </div>
    <div class="taklif-tugmalar">
      <button type="button" class="tugma tugma-asosiy" data-yol-taklif-boshla>{m.taklifBoshlash}</button>
      <button type="button" class="tugma tugma-ikkinchi" data-yol-taklif-keyin>{m.taklifKeyin}</button>
    </div>
  </div>
</section>

<style>
  .taklif-qobiq { padding-block: var(--b-4) var(--b-8); }
  .taklif-qobiq[hidden], :global(html[data-yol='bor']) .taklif-qobiq { display: none; }
  .yol-taklif {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--b-4) var(--b-6);
    padding: var(--b-5) var(--b-6);
    background: var(--sirt); border: 1.5px solid var(--matn); border-radius: var(--r-katta);
  }
  .taklif-matn { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: var(--b-1); }
  .taklif-sarlavha { font-size: var(--matn-katta); font-weight: 800; line-height: 1.3; }
  .taklif-izoh { color: var(--matn-ikkinchi); max-width: 62ch; }
  .taklif-tugmalar { display: flex; flex-wrap: wrap; gap: var(--b-3); }
  @media (max-width: 640px) {
    .yol-taklif { padding: var(--b-5); }
    .taklif-tugmalar { width: 100%; }
    .taklif-tugmalar .tugma { flex: 1 1 140px; justify-content: center; }
  }
</style>
