---
// Umumiy headerdagi qavatlar menyusi (6-qavat AI Academy 2026-11-19 da qo'shilgan) (mega menyu). Faqat /uz/ da (muallif qarori, 2026-11-19).
// Yon panel (BolimYon) o'zgarmaydi. Havolalar yon panel ma'lumotidan olinadi, qo'lda takrorlanmaydi.
// Xatti-harakat: qavat tugmasi bosilsa (sichqonchada hover ham) uning paneli ochiladi, bir vaqtda bittasi.
// Esc yopadi va fokusni tugmaga qaytaradi; ←/→ qavatlar orasida, ↓ panelni ochib birinchi havolaga o'tadi.
// Tashqariga bosish, fokus chiqib ketishi yoki sichqoncha ketishi yopadi. Hech narsa saqlanmaydi.
// SAT paneli inglizcha (lang="en"), qolganlari o'zbekcha.
import { qavatlar } from '../../data/qavatlar';
import { bolimlar } from '../../data/bolimlar';
import { satYonGuruhlar } from '../../data/satSahifalar';
import { ieltsGuruhlar } from '../../data/ieltsSahifalar';
import { taGuruhlar } from '../../data/topAdmissionSahifalar';
import { eyufGuruhlar } from '../../data/eyufSahifalar';
import { aiKurslar, aiKursManzili } from '../../data/aiAcademy';
import { yol } from '../../lib/yol';

interface Band { nomi: string; href?: string }
interface Ustun { nomi: string; bandlar: Band[] }
interface Panel { tavsif: string; otish: string; tezOrada: string; ustunlar: Ustun[]; til: 'uz' | 'en' }

const { mobil = false } = Astro.props as { mobil?: boolean };
const prefiks = mobil ? 'mobil' : 'ustki';
const aktiv = Astro.url.pathname;
const nom = (slug: string, nomi: string) => slug === 'navigator' ? 'Bosh sahifa' : slug === 'sat' ? 'SAT' : slug === 'ielts' ? 'IELTS' : slug === 'eyuf' ? 'El-Yurt Umidi' : nomi;
const tavsifI = (slug: string) => bolimlar.find((b) => b.slug === slug)?.tavsif ?? '';
const ielts = (q?: string) => (q ? `/uz/ielts/${q}` : undefined);

const PANELLAR: Record<string, Panel> = {
  navigator: {
    til: 'uz', tavsif: "Qaysi bo'limdan boshlashni bilmasangiz, yo'lingizni shu yerda tanlang.", otish: 'Bosh sahifa', tezOrada: 'Tez orada',
    ustunlar: [
      { nomi: 'Boshlash', bandlar: [{ nomi: "Yo'limni tanlash", href: '/uz/yol-tanlash/?boshlash=1' }, { nomi: "Yo'nalishlar", href: '/uz/#qavatlar' }] },
      { nomi: "Ma'lumot", bandlar: [{ nomi: 'Muddatlar', href: '/uz/deadline/' }, { nomi: 'Manbalar', href: '/uz/manbalar/' }, { nomi: 'Aloqa', href: '/uz/aloqa/' }] },
      { nomi: 'Hisob', bandlar: [{ nomi: 'Kirish', href: '/uz/hisob/kirish/' }, { nomi: "Ro'yxatdan o'tish", href: '/uz/hisob/royxat/' }] },
    ],
  },
  'top-admission': {
    til: 'uz', tavsif: tavsifI('top-admission'), otish: "Top Admission'ga o'tish", tezOrada: 'Tez orada',
    ustunlar: taGuruhlar.map((g) => ({ nomi: g.nomi, bandlar: g.bandlar.map((b) => ({ nomi: b.nomi, href: b.href && `/uz/${b.href}` })) })),
  },
  sat: {
    til: 'en', tavsif: 'Digital SAT: Reading and Writing, and Math.', otish: 'Open SAT prep', tezOrada: 'Coming soon',
    // Account guruhi panelda yo'q: u yon panelda, kirgandan keyin kerak bo'ladi.
    ustunlar: satYonGuruhlar
      
      .flatMap((g) => g.qismlar.map((q) => ({ nomi: q.nomi ?? g.nomi, bandlar: q.sahifalar.map((s) => ({ nomi: s.nomi, href: `/uz/sat/${s.qism}` })) }))),
  },
  ielts: {
    til: 'uz', tavsif: tavsifI('ielts'), otish: "IELTS'ga o'tish", tezOrada: 'Tez orada',
    ustunlar: ieltsGuruhlar.map((g) => ({ nomi: g.nomi, bandlar: g.bandlar.map((b) => ({ nomi: b.nomi, href: ielts(b.qism) })) })),
  },
  eyuf: {
    til: 'uz', tavsif: tavsifI('eyuf'), otish: "El-Yurt Umidi'ga o'tish", tezOrada: 'Tez orada',
    ustunlar: eyufGuruhlar.map((g) => ({ nomi: g.nomi, bandlar: g.bandlar.map((b) => ({ nomi: b.nomi, href: b.href && `/uz/${b.href}` })) })),
  },
  // Kurslar aiAcademy.ts dan: ochiq kurs havola, tez-oradagisi "Tez orada" belgisi bilan. "Barcha kurslar" = qavat kirish sahifasi.
  'ai-academy': {
    til: 'uz', tavsif: tavsifI('ai-academy'), otish: 'Barcha kurslar', tezOrada: 'Tez orada',
    ustunlar: [{ nomi: 'Kurslar', bandlar: aiKurslar.map((k) => ({ nomi: k.nomi, href: k.holat === 'ochiq' ? aiKursManzili(k) : undefined })) }],
  },
};
---
<nav class:list={['qm', { mobil }]} aria-label="Bo'limlar" data-qm lang="uz">
  <ul class="qm-tablar" role="list">
    {qavatlar.map((q) => (
      <li>
        {q.slug === 'navigator' ? <a class="qm-tab" href={yol('/uz/')} aria-current={aktiv === yol('/uz/') ? 'page' : undefined}>Bosh sahifa</a> : <>
          <button type="button" class:list={['qm-tab', { faol: aktiv.startsWith(yol(q.manzil)) }]} aria-expanded="false" aria-controls={`${prefiks}-${q.slug}`} data-qm-tab>
            {nom(q.slug, q.nomi)}
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          <div class="qm-panel" id={`${prefiks}-${q.slug}`} data-qm-panel>
            <div class="qm-ichki">
              <a class="qm-otish" href={yol(q.manzil)}>{PANELLAR[q.slug].otish} →</a>
              <div class="qm-ustunlar" lang={PANELLAR[q.slug].til}>
                {PANELLAR[q.slug].ustunlar.map((u) => <div>
                  <p class="qm-ustun-nom">{u.nomi}</p>
                  <ul class="qm-royxat" role="list">
                    {u.bandlar.map((b) => <li>{b.href ? <a href={yol(b.href)}>{b.nomi}</a> : <span class="qm-tez">{b.nomi} · {PANELLAR[q.slug].tezOrada}</span>}</li>)}
                  </ul>
                </div>)}
              </div>
            </div>
          </div>
        </>}
      </li>
    ))}
  </ul>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-qm]').forEach((nav) => {
    const tablar = [...nav.querySelectorAll<HTMLButtonElement>('[data-qm-tab]')];
    const panelI = (t: HTMLButtonElement) => document.getElementById(t.getAttribute('aria-controls')!)!;
    const sichqoncha = matchMedia('(hover: hover) and (pointer: fine)');
    let ochiq: HTMLButtonElement | null = null;
    let kechikish = 0;

    const yop = (fokus = false) => {
      if (!ochiq) return;
      const t = ochiq;
      t.setAttribute('aria-expanded', 'false');
      panelI(t).classList.remove('ochiq');
      ochiq = null;
      if (fokus) t.focus({ preventScroll: true });
    };
    const och = (t: HTMLButtonElement) => {
      clearTimeout(kechikish);
      if (ochiq === t) return;
      yop();
      // Yon panel ochiq bo'lsa, yopiladi: bir vaqtda bitta ochiq menyu

      t.setAttribute('aria-expanded', 'true');
      panelI(t).classList.add('ochiq');
      ochiq = t;
    };

    tablar.forEach((t, i) => {
      // Hover bilan hozirgina ochilgan panelni keyingi bosish yopib qo'ymasin
      let hoverVaqt = 0;
      t.addEventListener('click', () => {
        if (ochiq === t && performance.now() - hoverVaqt > 500) yop();
        else och(t);
      });
      t.addEventListener('mouseenter', () => {
        if (nav.classList.contains('mobil') || !sichqoncha.matches || ochiq === t) return;
        hoverVaqt = performance.now();
        och(t);
      });
      t.addEventListener('keydown', (e) => {
        const qoshni = (n: number) => {
          e.preventDefault();
          const keyingi = tablar[(i + n + tablar.length) % tablar.length];
          keyingi.focus();
          if (ochiq) och(keyingi);
        };
        if (e.key === 'ArrowRight') qoshni(1);
        else if (e.key === 'ArrowLeft') qoshni(-1);
        else if (e.key === 'ArrowDown') {
          e.preventDefault();
          och(t);
          panelI(t).querySelector<HTMLElement>('a[href]')?.focus();
        }
      });
    });

    nav.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && ochiq) { e.preventDefault(); yop(true); }
    });
    nav.addEventListener('mouseleave', () => {
      if (nav.classList.contains('mobil') || !sichqoncha.matches) return;
      kechikish = window.setTimeout(() => yop(), 200);
    });
    nav.addEventListener('mouseenter', () => clearTimeout(kechikish));
    nav.addEventListener('focusout', (e) => {
      if (e.relatedTarget instanceof Node && !nav.contains(e.relatedTarget)) yop();
    });
    document.addEventListener('click', (e) => {
      if (ochiq && e.target instanceof Node && !nav.contains(e.target)) yop();
    });
    nav.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('.qm-panel a[href]')) yop();
    });
    // Yon panel ochilsa, mega menyu yopiladi
    document.querySelectorAll<HTMLDetailsElement>('header details').forEach((d) => {
      d.addEventListener('toggle', () => { if (d.open) yop(); });
    });
  });
</script>

<style>
  .qm { min-width: 0; }
  .qm-tablar { display: flex; list-style: none; margin: 0; padding: var(--header-pill-pad); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-full); background: var(--color-surface); }
  .qm-tab { display: flex; align-items: center; justify-content: center; gap: var(--space-1); min-height: var(--size-touch-min); padding: 0 var(--space-3); font: inherit; font-size: var(--text-small-size); font-weight: 600; white-space: nowrap; border: 0; border-radius: var(--radius-full); color: var(--color-text-secondary); background: transparent; text-decoration: none; cursor: pointer; }
  .qm-tab.faol, .qm-tab[aria-current='page'] { background: var(--header-accent); color: var(--header-on-accent); }
  .qm-tab[aria-expanded='true'] { outline: var(--border-width-2) solid var(--color-link); outline-offset: calc(-1 * var(--border-width-2)); }
  .qm-panel { display: none; position: absolute; inset: 100% var(--space-8) auto; max-height: calc(100dvh - var(--space-16) * 2); overflow: auto; background: var(--color-surface); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-2); }
  .qm-panel.ochiq { display: block; }
  .qm-ichki { padding: var(--space-6); }
  .qm-otish { display: inline-flex; min-height: var(--size-touch-min); align-items: center; font-weight: 700; color: var(--color-link); }
  .qm-ustunlar { display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--header-column-min), 1fr)); gap: var(--space-6); }
  .qm-ustun-nom { font-size: var(--text-small-size); font-weight: 700; color: var(--color-text-secondary); }
  .qm-royxat { list-style: none; padding: 0; margin: 0; }
  .qm-royxat a, .qm-tez { display: flex; align-items: center; min-height: var(--size-touch-min); font-size: var(--text-small-size); }
  .qm-royxat a { color: var(--color-text-primary); text-decoration: none; }
  .qm-royxat a:hover { text-decoration: underline; }
  .qm-tez { color: var(--color-text-secondary); }
  .mobil .qm-tablar { flex-direction: column; border: 0; border-radius: 0; padding: 0; }
  .mobil .qm-tab { justify-content: space-between; width: 100%; padding-inline: var(--space-4); }
  .mobil .qm-panel { position: static; border: 0; box-shadow: none; max-height: none; }
  .mobil .qm-ichki { padding: var(--space-2) var(--space-4); }
  .mobil .qm-ustunlar { grid-template-columns: 1fr; gap: var(--space-2); }
  @media (768px <= width < 1280px) { .qm-tab { padding-inline: var(--space-1); font-size: var(--text-caption-size); } }
</style>
