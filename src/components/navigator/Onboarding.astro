---
// Navigator onboarding: 3 qadamli native <dialog> (showModal). Mantiq: src/lib/navigator/boshqaruv.ts.
// Server HTML'da dialog yopiq: faqat skript saqlangan profil yo'qligini tekshirgandan keyin ochiladi
// (qaytuvchi foydalanuvchida miltillamaydi).
import { navigatorMatni, type MuddatJavob } from '../../data/navigatorMatn';
import { MAQSADLAR } from '../../data/navigatorSahifalar';
import type { KunlikDaqiqa } from '../../data/yolXaritasiQoidalar';
import { qavatlar } from '../../data/qavatlar';

const m = navigatorMatni('uz');
const ikonka = (slug: string) => qavatlar.find((q) => q.slug === slug)?.ikonka ?? '';
const muddatlar: MuddatJavob[] = ['15d', '1m', '3m', 'date', 'unknown'];
const kunliklar: KunlikDaqiqa[] = [15, 30, 60, 120];
const belgi = '<path d="M5 12.5l4.5 4.5L19 7.5"/>';
---
<dialog class="onb" data-onboarding aria-labelledby="onb-nom">
  <form class="onb-forma" novalidate data-onb-forma>
    <header class="onb-bosh">
      <div class="onb-bosh-qator">
        <p class="onb-nom" id="onb-nom">{m.dialogSarlavha}</p>
        <button type="button" class="onb-otkaz" data-onb-otkaz>{m.otkazish}</button>
      </div>
      <p class="onb-hisob" id="onb-hisob" data-onb-hisob>{m.qadamHisob(1, 3)}</p>
      <div class="onb-progress" aria-hidden="true"><div data-onb-progress></div></div>
    </header>

    <div class="onb-tana">
      <!-- 1-qadam: maqsadlar -->
      <fieldset class="onb-qadam" data-onb-qadam="0" aria-describedby="onb-hisob onb-izoh1">
        <legend><h2 class="onb-savol" tabindex="-1">{m.savol1}</h2></legend>
        <p class="onb-izoh" id="onb-izoh1">{m.savol1Izoh}</p>
        <ul class="onb-maqsadlar">
          {MAQSADLAR.map((g) => (
            <li class="m-karta" data-m-karta={g}>
              <label class="variant m-tanlov">
                <input type="checkbox" name="goal" value={g} />
                <svg class="m-ikonka" aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ikonka(g)} />
                <span class="m-matn">
                  <span class="m-nom">{m.maqsadlar[g].nomi}</span>
                  <span class="m-izoh">{m.maqsadlar[g].izoh}</span>
                </span>
                <svg class="v-belgi" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={belgi} />
              </label>
              <label class="m-asosiy" data-m-asosiy hidden>
                <input type="radio" name="asosiy" value={g} aria-label={m.asosiyYorliq(m.maqsadlar[g].nomi)} />
                <span aria-hidden="true">{m.asosiy}</span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>

      <!-- 2-qadam: muddat -->
      <fieldset class="onb-qadam" data-onb-qadam="1" aria-describedby="onb-hisob" hidden>
        <legend><h2 class="onb-savol" tabindex="-1">{m.savol2}</h2></legend>
        <div class="onb-variantlar">
          {muddatlar.map((v) => (
            <label class="variant">
              <input type="radio" name="muddat" value={v} />
              <span class="v-matn">{m.muddatlar[v]}</span>
              <svg class="v-belgi" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={belgi} />
            </label>
          ))}
        </div>
        <div class="onb-sana" data-onb-sana hidden>
          <label for="onb-sana-maydon">{m.sanaYorliq}</label>
          <input id="onb-sana-maydon" name="sana" type="date" aria-describedby="onb-sana-xato" />
          <p class="onb-xato" id="onb-sana-xato" data-onb-sana-xato hidden>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5v.5"/></svg>
            <span data-onb-sana-matn></span>
          </p>
        </div>
      </fieldset>

      <!-- 3-qadam: kunlik vaqt -->
      <fieldset class="onb-qadam" data-onb-qadam="2" aria-describedby="onb-hisob" hidden>
        <legend><h2 class="onb-savol" tabindex="-1">{m.savol3}</h2></legend>
        <div class="onb-variantlar">
          {kunliklar.map((k) => (
            <label class="variant">
              <input type="radio" name="kunlik" value={k} />
              <span class="v-matn"><strong>{m.kunliklar[k].nomi}</strong> <span class="v-izoh">{m.kunliklar[k].izoh}</span></span>
              <svg class="v-belgi" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={belgi} />
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Faqat "qayta tuzish" rejimida: saqlashdan oldin tasdiq -->
      <section class="onb-qadam" data-onb-qadam="3" aria-labelledby="onb-tasdiq" hidden>
        <h2 class="onb-savol" id="onb-tasdiq" tabindex="-1">{m.tasdiqSarlavha}</h2>
        <p class="onb-izoh">{m.tasdiqMatn}</p>
      </section>
    </div>

    <footer class="onb-past">
      <p class="onb-yordam" id="onb-yordam" data-onb-yordam hidden>{m.kamidaBitta}</p>
      <div class="onb-tugmalar">
        <button type="button" class="tugma tugma-ikkinchi" data-onb-orqaga hidden>{m.orqaga}</button>
        <button type="submit" class="tugma tugma-asosiy" data-onb-keyingi aria-describedby="onb-yordam">{m.keyingi}</button>
      </div>
    </footer>
  </form>
</dialog>

<style>
  .onb {
    width: min(640px, calc(100vw - 2 * var(--b-4)));
    max-height: calc(100dvh - 2 * var(--b-6));
    padding: 0;
    border: none;
    border-radius: var(--r-katta);
    background: var(--sirt);
    color: var(--matn);
    box-shadow: var(--soya);
    overflow: hidden;
  }
  .onb[open] { display: flex; }
  .onb::backdrop { background: var(--parda); }
  :global(html:has(dialog.onb[open])) { overflow: hidden; }

  .onb-forma { display: flex; flex-direction: column; width: 100%; min-height: 0; }
  .onb-bosh { padding: var(--b-5) var(--b-6) var(--b-3); display: flex; flex-direction: column; gap: var(--b-2); }
  .onb-bosh-qator { display: flex; align-items: center; justify-content: space-between; gap: var(--b-3); }
  .onb-nom { font-weight: 800; font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }
  .onb-otkaz {
    min-height: 48px; padding: 0 var(--b-3); margin-right: calc(-1 * var(--b-3));
    border: none; background: none; color: var(--rang-havola);
    font: inherit; font-weight: 700; cursor: pointer; border-radius: var(--r-toliq);
  }
  .onb-otkaz:hover { background: var(--fon-ikkinchi); }
  .onb-hisob { font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); }
  .onb-progress { height: 8px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); overflow: hidden; }
  .onb-progress div { height: 100%; width: 33.33%; background: var(--rang-asosiy); border-radius: var(--r-toliq); transition: width var(--harakat-orta) var(--harakat-egri); }

  .onb-tana { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: var(--b-3) var(--b-6) var(--b-5); }
  .onb-qadam { border: none; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: var(--b-4); }
  .onb-qadam[hidden] { display: none; }
  .onb-qadam legend { padding: 0; float: left; width: 100%; }
  .onb-qadam legend + * { clear: both; }
  .onb-savol { font-size: var(--matn-h3); font-weight: 800; line-height: 1.25; }
  .onb-savol:focus { outline: none; }
  .onb-savol:focus-visible { outline: 3px solid var(--rang-asosiy); outline-offset: 2px; border-radius: var(--r-kichik); }
  .onb-izoh { color: var(--matn-ikkinchi); }

  .onb-maqsadlar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--b-3); }
  .m-karta { display: flex; flex-direction: column; gap: var(--b-1); }

  /* Variant tugmasi (DESIGN.md): input + label, tanlangani ko'k chegara va belgi ikonkasi */
  .variant {
    position: relative; display: flex; align-items: center; gap: var(--b-3);
    min-height: 56px; box-sizing: border-box; padding: var(--b-3) var(--b-4);
    border: 2px solid var(--chiziq-maydon); border-radius: var(--r-orta);
    background: var(--sirt); cursor: pointer;
  }
  .variant:hover { background: var(--fon-ikkinchi); }
  .variant input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .variant:has(input:checked) { border-color: var(--rang-asosiy); }
  .variant:has(input:focus-visible) { outline: 3px solid var(--rang-asosiy); outline-offset: 2px; }
  .v-belgi { margin-left: auto; flex: none; color: var(--rang-asosiy); visibility: hidden; }
  .variant:has(input:checked) .v-belgi { visibility: visible; }
  .m-tanlov { align-items: flex-start; min-height: 88px; }
  .m-ikonka { flex: none; color: var(--rang-asosiy); margin-top: 2px; }
  .m-matn { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .m-nom { font-weight: 800; }
  .m-izoh, .v-izoh { font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }

  .m-asosiy {
    align-self: flex-start; display: inline-flex; align-items: center; gap: var(--b-2);
    min-height: 44px; padding: 0 var(--b-3); border-radius: var(--r-toliq);
    font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); cursor: pointer;
  }
  .m-asosiy[hidden] { display: none; }
  .m-asosiy input { width: 20px; height: 20px; margin: 0; accent-color: var(--rang-asosiy); }
  .m-asosiy:has(input:checked) { color: var(--rang-havola); background: var(--sirt-ikkinchi); }
  .m-asosiy input:focus-visible { outline: 3px solid var(--rang-asosiy); outline-offset: 2px; }

  .onb-variantlar { display: flex; flex-direction: column; gap: var(--b-2); }
  .onb-sana { display: flex; flex-direction: column; gap: var(--b-2); }
  .onb-sana[hidden] { display: none; }
  .onb-sana label { font-weight: 700; }
  .onb-sana input {
    min-height: 48px; box-sizing: border-box; padding: 0 var(--b-3);
    border: 2px solid var(--chiziq-maydon); border-radius: var(--r-orta);
    background: var(--sirt); color: var(--matn); font: inherit; font-size: var(--matn-asosiy);
    max-width: 260px;
  }
  .onb-sana input:focus-visible { outline: 3px solid var(--rang-asosiy); outline-offset: 2px; }
  .onb-xato {
    display: flex; align-items: flex-start; gap: var(--b-2);
    padding: var(--b-2) var(--b-3); border-radius: var(--r-kichik);
    background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn); font-size: var(--matn-kichik);
  }
  .onb-xato[hidden] { display: none; }
  .onb-xato svg { flex: none; }

  .onb-past { padding: var(--b-3) var(--b-6) var(--b-5); border-top: 1px solid var(--chiziq); display: flex; flex-direction: column; gap: var(--b-2); }
  .onb-yordam { font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }
  .onb-yordam[hidden] { display: none; }
  .onb-tugmalar { display: flex; justify-content: flex-end; gap: var(--b-2); }
  .onb-tugmalar [hidden] { display: none; }
  .onb-tugmalar button:disabled { opacity: 0.5; cursor: not-allowed; }

  @media (max-width: 640px) {
    .onb {
      width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh;
      margin: 0; border-radius: 0;
    }
    .onb-bosh, .onb-tana, .onb-past { padding-inline: var(--b-4); }
    .onb-past { padding-bottom: max(var(--b-4), env(safe-area-inset-bottom)); }
    .onb-tugmalar .tugma { flex: 1 1 0; }
    .onb-maqsadlar { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .onb-progress div { transition: none; }
  }
</style>
