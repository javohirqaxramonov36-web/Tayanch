---
// Qavatlar: JavaScriptsiz ochiladigan umumiy navigatsiya.
import Suhbatdosh from './Suhbatdosh.astro';
import { qavatlar, joriyQavat, qavatI } from '../data/qavatlar';
import { yol } from '../lib/yol';
import { matn, qavatHolatMatni, yolTili } from '../data/umumiyMatn';

const joriy = joriyQavat(Astro.url.pathname);
const qavat = qavatI(joriy);
const til = yolTili(Astro.url.pathname);
const M = matn[til];
---
<details class="lift" name="tayanch-navigatsiya">
  <summary aria-controls="lift-panel">
    <span class="lift-joriy">{M.qavat(joriy)} · {qavat.nomi}</span>
    <span class="lift-ochish">{M.lift.nomi}</span>
  </summary>
  <nav id="lift-panel" class="lift-panel nav-shisha" aria-label={M.lift.nomi}>
    <ol role="list">
      {qavatlar.map((q) => {
        const holat = qavatHolatMatni(q.holat, til) ?? M.lift.ochiq;
        const nom = M.qavat(q.raqam) + ' · ' + q.nomi;
        const yorliq = nom + ', ' + holat;
        return (
          <li>
            <a href={yol(q.manzil)} aria-current={q.raqam === joriy ? 'location' : undefined} aria-label={yorliq} title={yorliq}>
              <span>{nom}</span>
              <span class="lift-holat">{holat}</span>
            </a>
          </li>
        );
      })}
      <Suhbatdosh qavat={joriy} inglizcha={til === 'en'} variant="qavatlar" />
    </ol>
  </nav>
</details>

<style>
  .lift { min-inline-size: 0; justify-self: center; max-inline-size: 100%; }
  summary {
    min-block-size: var(--size-touch-min); min-inline-size: var(--size-touch-min);
    padding-inline: var(--space-2); list-style: none; cursor: pointer;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    color: var(--matn); line-height: var(--text-caption-lh);
    border-radius: var(--radius-md);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--color-surface-sunken); }
  .lift-joriy {
    max-inline-size: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    font-size: var(--text-body-size); font-weight: var(--font-weight-bold);
  }
  .lift-ochish, .lift-holat { font-size: var(--text-caption-size); }
  .lift-ochish { text-decoration: underline; }
  .lift-panel {
    position: absolute; inset-block-start: 100%; inset-inline: var(--space-2);
    max-inline-size: calc(var(--space-16) * 6); margin-inline: auto;
    max-block-size: calc(100dvh - var(--space-14) - var(--space-4)); overflow-y: auto;
    padding: var(--space-2); border: var(--border-width-1) solid var(--card-line);
    border-radius: var(--radius-lg);
  }
  ol { list-style: none; margin: 0; padding: 0; }
  a {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-1) var(--space-2);
    min-block-size: var(--size-touch-min); min-inline-size: var(--size-touch-min);
    padding-inline: var(--space-3); text-decoration: none; color: var(--matn);
    border-radius: var(--radius-md);
  }
  a:hover, a[aria-current] { background: var(--color-surface-sunken); }
  a[aria-current] { font-weight: var(--font-weight-bold); text-decoration: underline; }
</style>
