---
import { yol } from '../lib/yol';
import { yolTili } from '../data/umumiyMatn';
const kirish = `${yol('/uz/hisob/kirish/')}?keyin=${encodeURIComponent(Astro.url.pathname)}`;
// SAT sahifalari inglizcha (yolTili): faol til English, qolganlari "Not available". Boshqa qavatlarda avvalgidek.
const en = yolTili(Astro.url.pathname) === 'en';
const tillar = en
  ? [{ kod: 'en', nomi: 'English', faol: true }, { kod: 'uz', nomi: "Oʻzbekcha", faol: false }, { kod: 'ru', nomi: 'Русский', faol: false }]
  : [{ kod: 'uz', nomi: "Oʻzbekcha", faol: true }, { kod: 'en', nomi: 'English', faol: false }, { kod: 'ru', nomi: 'Русский', faol: false }];
const T = en
  ? { yoq: 'Not available', kirish: 'Sign in', kirgan: 'My account', kod: 'EN', tugma: 'Language: English' }
  : { yoq: 'Tez orada', kirish: 'Kirish', kirgan: 'Hisobim', kod: 'UZ', tugma: undefined };
---
<div class="header-amallar" data-header-amallar>
  <slot />
  <div class="til-orami">
    <button type="button" class="til-tugma" aria-expanded="false" aria-controls="til-panel" aria-label={T.tugma} data-til-tugma>{en ? <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" /></svg> : <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><defs><clipPath id="flag-circle"><circle cx="9" cy="9" r="9" /></clipPath></defs><g clip-path="url(#flag-circle)"><path fill="var(--flag-blue)" d="M0 0h18v6H0z"/><path fill="var(--color-neutral-0)" d="M0 6h18v6H0z"/><path fill="var(--flag-green)" d="M0 12h18v6H0z"/><path stroke="var(--flag-red)" d="M0 6h18M0 12h18"/><path fill="var(--color-neutral-0)" d="M5 1a2 2 0 1 0 0 4 2.4 2.4 0 0 1 0-4"/></g></svg>} {T.kod} <span aria-hidden="true">⌄</span></button>
    <div class="til-panel" id="til-panel" hidden>
      {tillar.map((t) => <button type="button" lang={t.kod} disabled={!t.faol} aria-current={t.faol ? 'true' : undefined}>{t.nomi}{!t.faol && <span lang={en ? 'en' : undefined}>{T.yoq}</span>}</button>)}
    </div>
  </div>
  <a class="kirish-tugma" href={kirish} data-hisob-havola data-kirish={kirish} data-profil={yol('/uz/hisob/profil/')} data-matn-kirish={T.kirish} data-matn-kirgan={T.kirgan}><span data-hisob-nom>{T.kirish}</span><span class="kirish-oq" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6h12v12" /></svg></span></a>
</div>
<script>
  const tugma = document.querySelector<HTMLButtonElement>('[data-til-tugma]')!;
  const panel = document.getElementById('til-panel')!;
  function yop() { panel.hidden = true; tugma.setAttribute('aria-expanded', 'false'); }
  tugma.addEventListener('click', () => { panel.hidden = !panel.hidden; tugma.setAttribute('aria-expanded', String(!panel.hidden)); });
  tugma.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); panel.hidden = false; tugma.setAttribute('aria-expanded', 'true'); panel.querySelector<HTMLButtonElement>('button:not(:disabled)')?.focus(); } });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { yop(); tugma.focus(); } });
  document.addEventListener('click', (e) => { if (e.target instanceof Node && !tugma.parentElement!.contains(e.target)) yop(); });
  panel.addEventListener('click', yop);
  tugma.parentElement!.addEventListener('focusout', (e) => { if (e.relatedTarget instanceof Node && !tugma.parentElement!.contains(e.relatedTarget)) yop(); });
</script>
<style>
  .header-amallar { display: flex; align-items: center; gap: var(--space-2); flex: none; }
  .til-orami { position: relative; }
  .til-tugma, .kirish-tugma { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: var(--size-touch-min); padding-inline: var(--space-3); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-full); background: var(--color-surface); color: var(--color-text-primary); font: inherit; font-size: var(--text-small-size); font-weight: 600; text-decoration: none; cursor: pointer; }
  .kirish-oq { width: var(--space-7); height: var(--space-7); border-radius: var(--radius-full); background: var(--header-accent); color: var(--header-on-accent); display: grid; place-items: center; }
  .til-panel { position: absolute; top: calc(100% + var(--space-2)); right: 0; min-width: var(--header-language-width); padding: var(--space-2); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-2); z-index: var(--z-dropdown); }
  .til-panel button { display: flex; align-items: center; gap: var(--space-3); width: 100%; min-height: var(--size-touch-min); padding: var(--space-2); border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-text-secondary); font: inherit; font-size: var(--text-small-size); }
  .til-panel button[aria-current] { background: var(--header-accent); color: var(--header-on-accent); }
  .til-panel button span { font-size: var(--text-caption-size); background: var(--color-surface-sunken); padding-inline: var(--space-2); border-radius: var(--radius-full); }
  @media (768px <= width < 1024px) { .til-tugma, .kirish-tugma { padding-inline: var(--space-2); } }
  @media (width < 1024px) { .til-tugma > svg { display: none; } .kirish-tugma { background: var(--header-accent); color: var(--header-on-accent); } .kirish-oq { display: none; } }
</style>
