---
// Kun savoli (P10): SAT kirish sahifasida. Hamma uchun bitta original savol (Toshkent kuni bo'yicha),
// R&W va Math navbatlashadi. Mehmon ham javob beradi (natija faqat shu brauzerda), kirgan foydalanuvchida streak serverda.
// Savol bo'lmasa, Supabase sozlanmagan bo'lsa yoki yuklashda xato bo'lsa butun blok yashirin qoladi (soxta savol yo'q).
// Kvota sarflamaydi. Mantiq: src/lib/sat/kunSavoli.ts, server: supabase/migrations/20261111220000_kun_savoli.sql.
// Dev: ?kun-mock=mehmon|kirgan|yoq|xato|eskirgan (&kun-sana=YYYY-MM-DD).
import SavolUslub from './SavolUslub.astro';
import { manbalar } from '../../data/manbalar';
import { yol } from '../../lib/yol';
import { KUN_MATN as M } from '../../lib/sat/kunSavoli';

const cb12 = manbalar.find((m) => m.id === 'CB12');
if (!cb12 || cb12.tekshiruvDarajasi !== 'rasmiy') throw new Error('KunSavoli: CB12 rasmiy manbasi topilmadi');
const kirish = yol('/uz/hisob/kirish/');
---
<SavolUslub />
<section class="kun" id="kun-savoli" aria-labelledby="kun-h" hidden data-kirish={kirish}>
  <div class="kun-bosh">
    <div class="kun-sarlavha">
      <h2 id="kun-h">{M.sarlavha}</h2>
      <p class="kun-izoh" id="kun-izoh"></p>
    </div>
    <p class="kun-kun">
      <time class="kun-sana" id="kun-sana"></time>
      <span class="kun-bolim" id="kun-bolim"></span>
    </p>
  </div>
  {import.meta.env.DEV && <p class="kun-namuna" id="kun-namuna" hidden>Sample · dev mock</p>}

  <p class="kun-streak" id="kun-streak" aria-live="polite" hidden>
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18M9 15l2 2 4-4"/></svg>
    <span id="kun-streak-matn"></span>
  </p>

  <div id="kun-savol-joy"></div>

  <div class="kun-amal" id="kun-amal" hidden>
    <button type="button" class="kun-tugma kun-asosiy" id="kun-tekshir" aria-disabled="true" aria-describedby="kun-xabar">{M.tekshir}</button>
    <p class="kun-xabar" id="kun-xabar" role="status"></p>
  </div>

  <div class="kun-eskirgan" id="kun-eskirgan" hidden>
    <p id="kun-eskirgan-matn" tabindex="-1">{M.eskirgan}</p>
    <button type="button" class="kun-tugma kun-ikkinchi" id="kun-yangila">{M.yangisiniOch}</button>
  </div>

  <div class="kun-ertaga" id="kun-ertaga" hidden>
    <h3 id="kun-ertaga-h" tabindex="-1">{M.ertaga}</h3>
    <p class="kun-vaqt" id="kun-vaqt"></p>
    <div class="kun-mehmon" id="kun-mehmon" hidden>
      <a class="kun-tugma kun-asosiy" id="kun-kirish" href={kirish}>{M.saqlashTaklif}</a>
      <p class="kun-mayda">{M.saqlashIzoh}</p>
    </div>
  </div>

  <p class="kun-rasmiy">
    <a href={cb12.havola} target="_blank" rel="noopener">
      {M.rasmiy}
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
      <span class="kun-sr"> (opens in a new tab)</span>
    </a>
    <span class="kun-mayda">{M.rasmiyIzoh}</span>
  </p>
</section>

<script>
  import { savolChiz, type SavolKorsatkich } from '../../lib/sat/savolKorsatkich';
  import { BOSH_HOLAT, type SavolHolati } from '../../lib/sat/savolTuri';
  import {
    KUN_KALIT, KUN_MATN as M, mehmonOqi, togriJavobMatni, bolimNomi, sanaMatni, keyingiVaqtMatni, streakMatni,
    kunXatoTuri, type KunApi, type KunJavob, type KunNatija,
  } from '../../lib/sat/kunSavoli';

  const $ = <T extends HTMLElement = HTMLElement>(i: string) => document.getElementById(i) as T;
  const ildiz = $('kun-savoli');

  const oqi = () => { try { return localStorage.getItem(KUN_KALIT); } catch { return null; } };
  const yoz = (v: string | null) => {
    try { if (v === null) localStorage.removeItem(KUN_KALIT); else localStorage.setItem(KUN_KALIT, v); } catch { /* saqlanmasa ham ishlaydi */ }
  };

  let api: KunApi;
  let j: KunJavob;
  let holat: SavolHolati = { ...BOSH_HOLAT, ochirilgan: [] };
  let korsatkich: SavolKorsatkich | null = null;
  let band = false;

  const natijaHolat = (n: KunNatija) => ({ togrimi: n.is_correct, togriJavob: togriJavobMatni(n.correct), izoh: n.explanation });

  function streakChiz() {
    const s = j.streak;
    $('kun-streak').hidden = !api.kirgan || !s;
    if (s) $('kun-streak-matn').textContent = streakMatni(s);
  }

  function tekshirTugma() {
    const t = $<HTMLButtonElement>('kun-tekshir');
    const tayyor = !!holat.tanlangan && !band;
    t.setAttribute('aria-disabled', String(!tayyor));
    t.setAttribute('aria-busy', String(band));
    t.textContent = band ? M.tekshirilmoqda : M.tekshir;
  }

  function ertagaKorsat(fokus: boolean) {
    $('kun-amal').hidden = true;
    $('kun-vaqt').textContent = keyingiVaqtMatni(j.next_at);
    $('kun-mehmon').hidden = api.kirgan;
    if (!api.kirgan) {
      const keyin = `${location.pathname}#kun-savoli`;
      $<HTMLAnchorElement>('kun-kirish').href = `${ildiz.dataset.kirish}?keyin=${encodeURIComponent(keyin)}`;
    }
    $('kun-ertaga').hidden = false;
    streakChiz();
    if (fokus) {
      const n = ildiz.querySelector<HTMLElement>('.sk-natija');
      if (n) { n.tabIndex = -1; n.focus(); } else $('kun-ertaga-h').focus();
    }
  }

  async function yubor(javob: string) {
    if (band || holat.javobBerilgan) return;
    band = true;
    tekshirTugma();
    $('kun-xabar').textContent = '';
    try {
      const n = await api.tekshir(j, javob);
      if (api.kirgan) {
        j = await api.ol().catch(() => j);
      } else {
        yoz(JSON.stringify({ sana: j.date, questionId: j.question!.id, javob, natija: n }));
      }
      holat = { ...holat, javobBerilgan: true, natija: natijaHolat(n) };
      korsatkich?.yangila(holat);
      band = false;
      ertagaKorsat(true);
    } catch (e) {
      band = false;
      tekshirTugma();
      if (kunXatoTuri(e) === 'eskirgan') {
        $('kun-amal').hidden = true;
        $('kun-eskirgan').hidden = false;
        // Ko'rinmay turgan role="alert" ochilganda ekran o'quvchi uni o'qimasligi mumkin: fokus matnga o'tadi, keyin Tab bilan tugma.
        $('kun-eskirgan-matn').focus();
      } else {
        $('kun-xabar').textContent = M.tarmoqXato;
      }
    }
  }

  function chiz() {
    const q = j.question!;
    $('kun-izoh').textContent = api.kirgan ? M.izohKirgan : M.izohMehmon;
    $('kun-sana').textContent = sanaMatni(j.date);
    $('kun-sana').setAttribute('datetime', j.date);
    $('kun-bolim').textContent = bolimNomi(q.section);
    $('kun-eskirgan').hidden = true;
    $('kun-ertaga').hidden = true;

    let natija: KunNatija | null = null;
    let javob: string | null = null;
    if (api.kirgan && j.result) {
      natija = j.result;
      javob = j.result.answer;
    } else if (!api.kirgan) {
      const y = mehmonOqi(oqi(), j.date, q.id);
      if (!y) yoz(null); // eskirgan yozuv
      if (y?.natija) { natija = y.natija; javob = y.javob; }
    }

    holat = {
      ...BOSH_HOLAT,
      ochirilgan: [],
      javobBerilgan: !!natija,
      tanlangan: q.format === 'mcq' ? javob : null,
      sprQiymat: q.format === 'spr' ? (javob ?? '') : undefined,
      natija: natija ? natijaHolat(natija) : null,
    };

    korsatkich?.yoq();
    korsatkich = savolChiz($('kun-savol-joy'), {
      savol: { id: q.id, section: q.section, format: q.format, passage: q.passage ?? null, stem: q.stem, options: q.options ?? null, figure: null },
      holat,
      rejim: 'taymersiz',
      onSelect: (k) => {
        holat = { ...holat, tanlangan: k };
        korsatkich?.yangila(holat);
        $('kun-xabar').textContent = '';
        tekshirTugma();
      },
      onSubmitSpr: (v) => {
        holat = { ...holat, sprQiymat: v };
        yubor(v);
      },
      onEliminate: (k, on) => {
        holat = { ...holat, ochirilgan: on ? [...new Set([...holat.ochirilgan, k])] : holat.ochirilgan.filter((x) => x !== k) };
        korsatkich?.yangila(holat);
      },
    });

    $('kun-amal').hidden = !!natija || q.format !== 'mcq';
    tekshirTugma();
    streakChiz();
    if (natija) ertagaKorsat(false);
  }

  $('kun-tekshir').addEventListener('click', () => {
    if (band) return;
    if (!holat.tanlangan) { $('kun-xabar').textContent = M.tanlang; return; }
    yubor(holat.tanlangan);
  });

  $('kun-yangila').addEventListener('click', () => { yuklash(true); });

  /** Mehmon bugun javob berib, keyin kirgan bo'lsa: o'sha javob bir marta server sessiyasiga yuboriladi (streak uchun). */
  async function mehmonJavobiniOtkaz() {
    if (!api.kirgan || !j.question || j.result) return;
    const y = mehmonOqi(oqi(), j.date, j.question.id);
    if (!y) return;
    try {
      await api.tekshir(j, y.javob);
      yoz(null);
      j = await api.ol();
    } catch { /* kerak bo'lsa foydalanuvchi o'zi javob beradi */ }
  }

  async function yuklash(fokus = false) {
    try {
      j = await api.ol();
    } catch {
      ildiz.hidden = true;
      return;
    }
    if (!j?.question) { ildiz.hidden = true; return; }
    await mehmonJavobiniOtkaz();
    chiz();
    ildiz.hidden = false;
    if (fokus) {
      $('kun-h').tabIndex = -1;
      $('kun-h').focus();
    }
  }

  async function boshla() {
    const p = new URLSearchParams(location.search);
    let a: KunApi | null = null;
    if (import.meta.env.DEV && p.get('kun-mock')) {
      const { kunMock } = await import('../../lib/sat/kunSavoliMock');
      a = kunMock(p.get('kun-mock') as Parameters<typeof kunMock>[0], p.get('kun-sana'));
      const pill = document.getElementById('kun-namuna');
      if (pill) pill.hidden = false;
    } else {
      try {
        const { kunApi } = await import('../../lib/sat/kunSavoliApi');
        a = await kunApi();
      } catch { a = null; }
    }
    if (!a) return;
    api = a;
    await yuklash();
  }

  boshla();
</script>

<style>
  .kun { display: flex; flex-direction: column; gap: var(--b-5); }
  .kun[hidden] { display: none; }
  .kun [hidden] { display: none !important; }
  .kun-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .kun-bosh { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--b-3) var(--b-6); }
  .kun-sarlavha { display: flex; flex-direction: column; gap: var(--b-2); min-width: 0; }
  .kun h2 { font-size: var(--matn-h2); font-weight: 800; line-height: 1.2; letter-spacing: var(--oraliq-sarlavha); text-wrap: balance; }
  .kun h2:focus { outline: none; }
  .kun-izoh { color: var(--matn-ikkinchi); max-width: 62ch; text-wrap: pretty; }

  /* Kun "chiptasi": sana va bo'lim. Bu komponentning yagona ta'kidi. */
  .kun-kun {
    display: inline-flex; align-items: stretch; margin: 0;
    border: 1.5px solid var(--matn); border-radius: var(--r-toliq); overflow: hidden;
    font-size: var(--matn-kichik); font-weight: 700;
  }
  .kun-sana { padding: var(--b-2) var(--b-4); background: var(--matn); color: var(--fon); white-space: nowrap; }
  .kun-bolim { padding: var(--b-2) var(--b-4); color: var(--matn); white-space: nowrap; }

  .kun-namuna {
    align-self: flex-start; margin: 0; padding: 4px 12px; border-radius: var(--r-toliq);
    border: 1.5px dashed var(--matn-sust); color: var(--matn-ikkinchi); font-size: var(--matn-mayda); font-weight: 700;
  }

  .kun-streak { display: flex; align-items: center; gap: var(--b-2); margin: 0; font-weight: 700; color: var(--matn); }
  .kun-streak svg { flex: none; color: var(--rang-havola); }

  .kun-amal { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3) var(--b-4); }
  /* Jonli hudud doim DOM'da va ko'rinadigan bo'lib qoladi (display: none bo'lsa yangi xabar e'lon qilinmasligi mumkin). */
  .kun-xabar { margin: 0; color: var(--matn-ikkinchi); font-size: var(--matn-kichik); }

  .kun-eskirgan, .kun-ertaga {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--b-3);
    background: var(--fon-ikkinchi); border-radius: var(--r-katta); padding: var(--b-6);
  }
  .kun-eskirgan p { margin: 0; font-weight: 700; }
  .kun-eskirgan p:focus { outline: none; }
  .kun-ertaga h3 { font-size: var(--matn-h3); font-weight: 800; line-height: 1.25; letter-spacing: var(--oraliq-kichik-sarlavha); }
  .kun-ertaga h3:focus { outline: none; }
  .kun-vaqt { margin: 0; color: var(--matn-ikkinchi); }
  .kun-mehmon { display: flex; flex-direction: column; align-items: flex-start; gap: var(--b-2); padding-top: var(--b-1); }
  .kun-mayda { font-size: var(--matn-kichik); color: var(--matn-sust); }

  .kun-rasmiy { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--b-3); margin: 0; }
  .kun-rasmiy a {
    display: inline-flex; align-items: center; gap: var(--b-1); min-height: 44px;
    color: var(--rang-havola); font-weight: 700; text-underline-offset: 0.15em;
  }

  @media (max-width: 640px) {
    .kun { order: 2; }
    .kun h2 { font-size: 22px; }
    .kun-izoh { font-size: var(--matn-kichik); }
    .kun-tugma { width: 100%; }
    .kun-amal { flex-direction: column; align-items: stretch; }
    .kun-eskirgan, .kun-ertaga { padding: var(--b-5); border-radius: var(--r-orta); }
    .kun-mehmon { align-self: stretch; }
  }
</style>
