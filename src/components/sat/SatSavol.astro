---
// SatSavol (DS qavat-3-sat.md "Tuzilma"): SAT savol ekrani komponenti. Savol, passage va natija zich shishada,
// A–D variantlari harf doirasida (Sora), holat so'z bilan. DOM'ni src/lib/sat/savolKorsatkich.ts quradi; komponent
// uni joylashtiradigan konteynerni (ixtiyoriy `id`) va uslubni beradi. Sahifaga bir marta qo'yiladi.
// 2026-11-24: oldingi nomi SavolUslub (faqat uslub edi). Qiymatlar faqat tokens.css dan.
// DS PR 5c (ADR 005, 2026-11-23): artifakt v15 `SatSavol` ko'rinishi. Savol, passage va natija
// faqat zich shishada (`sat-glass-strong`), variant harfi doirada (Sora), tanlangan harf `sat-blue-fill`.
// Ichma-ich blur yo'q: variantlar, maydonlar va tugmalar tekis. Shisha ustida (masalan /uz/sat/ foto foni
// zich shishasi ichida) iste'molchi panelni qattiq kartaga o'tkazadi (KunSavoli).
// To'g'ri / xato faqat rang bilan emas: ikonka, chiziq turi, to'lgan harf va yashirin matn bilan ham.
interface Props {
  /** Berilsa, savolKorsatkich uchun bo'sh konteyner (.sk) shu id bilan chiqadi */
  id?: string;
  /** Konteynerga qo'shimcha klass */
  class?: string;
}
const { id, class: klass } = Astro.props;
---
{id && <div id={id} class:list={['sk', klass]}><slot /></div>}
<style is:global>
  .sk { container-type: inline-size; color: var(--color-sat-text); }
  .sk-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .sk-tartib { display: grid; gap: var(--space-4); align-items: start; }

  /* Zich shisha panel (SatSavol): savol, passage, natija */
  .sk-passage, .sk-savol, .sk-natija {
    background: var(--color-sat-glass-strong);
    border: var(--border-width-1) solid var(--color-sat-glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glass);
    color: var(--color-sat-text);
    -webkit-backdrop-filter: var(--glass-backdrop);
    backdrop-filter: var(--glass-backdrop);
    padding: var(--space-6);
    min-width: 0;
  }
  .sk-savol { display: flex; flex-direction: column; gap: var(--space-4); }
  .sk-passage:focus-visible, .sk-jadval:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap);
  }

  /* Matn: passage, savol, variant, izoh (Onest, savol matni 18/28) */
  .sk-matn { font-size: var(--font-size-body-d); line-height: var(--line-height-body-d); max-width: var(--size-measure); overflow-wrap: break-word; }
  .sk-matn p { margin: 0 0 var(--space-4); }
  .sk-matn p:last-child { margin-bottom: 0; }
  .sk-matn u { text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .sk-stem { font-size: var(--font-size-body-d); font-weight: var(--font-weight-medium); }
  .sk-jadval { overflow-x: auto; margin: var(--space-4) 0; max-width: 100%; border-radius: var(--radius-sm); }
  .sk-jadval table { border-collapse: collapse; font-size: var(--text-body-size); min-width: 100%; font-variant-numeric: tabular-nums; }
  .sk-jadval th, .sk-jadval td { border: var(--border-width-1) solid var(--color-sat-line-strong); padding: var(--space-2) var(--space-3); text-align: left; vertical-align: top; }
  .sk-jadval th { background: var(--color-sat-line); font-weight: var(--font-weight-bold); }
  .sk-formula-alohida { margin: var(--space-3) 0; overflow-x: auto; overflow-y: hidden; }
  .sk .katex { font-size: 1.08em; }

  /* Ustki qator: savol raqami (sat-yorliq) va asboblar */
  .sk-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .sk-pill {
    font-size: var(--text-caption-size); line-height: var(--text-caption-lh);
    font-weight: var(--font-weight-semibold); letter-spacing: 0.04em;
    color: var(--color-sat-text-muted); font-variant-numeric: tabular-nums;
  }
  .sk-asboblar { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-left: auto; }
  .sk-asbob {
    min-height: var(--size-touch-min); padding: 0 var(--space-3);
    border: var(--border-width-1) solid transparent; border-radius: var(--radius-full);
    background: transparent; color: var(--color-sat-text-muted);
    font: inherit; font-weight: var(--font-weight-semibold); font-size: var(--text-small-size);
    display: inline-flex; align-items: center; gap: var(--space-2); cursor: pointer;
  }
  .sk-asbob[hidden] { display: none; }
  .sk-asbob svg { color: var(--color-sat-blue-text); flex: none; }
  @media (hover: hover) and (pointer: fine) { .sk-asbob:hover { border-color: var(--color-sat-blue); } }
  .sk-asbob[aria-pressed='true'] { border-color: var(--color-sat-line-strong); color: var(--color-sat-text); }
  .sk-bayroq[aria-pressed='true'] svg { fill: currentColor; }

  /* Rasm */
  .sk-rasm { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .sk-rasm img { display: block; max-width: 100%; height: auto; border-radius: var(--radius-md); border: var(--border-width-1) solid var(--color-sat-line); background: var(--color-sat-surface); }
  .sk-rasm figcaption { font-size: var(--text-small-size); color: var(--color-sat-text-muted); }

  /* Variantlar (SatSavol .sat-variant): tekis, 1px sat-line-strong, harf doirasi */
  .sk-variantlar { display: flex; flex-direction: column; gap: var(--space-2); }
  .sk-qator { display: flex; align-items: stretch; gap: var(--space-2); }
  .sk-qator:has(.sk-radio) { position: relative; }
  .sk-variant {
    flex: 1; min-width: 0;
    min-height: var(--size-touch-min); padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border-radius: var(--radius-lg);
    background: transparent; border: var(--border-width-1) solid var(--color-sat-line-strong);
    color: var(--color-sat-text); font: inherit; font-size: var(--text-body-size); font-weight: var(--font-weight-medium); text-align: left;
    font-variant-numeric: tabular-nums;
    display: flex; align-items: center; gap: var(--space-3);
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) { .sk-variant:hover { border-color: var(--color-sat-blue); } }
  .sk-variant:focus-visible, .sk-ochir:focus-visible, .sk-asbob:focus-visible, .sk-katta:focus-visible,
  .sk-radio:focus-visible + .sk-variant, .sk-belgi-tugma:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-gap);
  }
  .sk-harf {
    width: 36px; height: 36px; flex: none; border-radius: var(--radius-full);
    display: grid; place-items: center;
    border: var(--border-width-1) solid var(--color-sat-line-strong);
    font-family: var(--font-sat); font-size: var(--text-small-size); font-weight: var(--font-weight-semibold); line-height: 1;
    background: transparent; color: var(--color-sat-text);
  }
  .sk-v-matn { flex: 1; min-width: 0; overflow-wrap: break-word; }
  .sk-belgi { display: none; flex: none; }

  /* Tanlangan: chet va harf sat-blue-fill (holat yana aria-checked / checked bilan aytiladi) */
  .sk-tanlangan .sk-variant { border-color: var(--color-sat-blue-fill); box-shadow: inset 0 0 0 1px var(--color-sat-blue-fill); }
  .sk-tanlangan .sk-harf { background: var(--color-sat-blue-fill); border-color: var(--color-sat-blue-fill); color: var(--color-sat-on-blue-fill); }

  /* Cross out: ustidan chiziq va xira matn (yashirin "eliminated" matni bilan) */
  .sk-ochirilgan .sk-v-matn, .sk-ochirilgan .sk-harf { text-decoration: line-through; text-decoration-thickness: 2px; }
  .sk-ochirilgan .sk-variant { border-style: dashed; color: var(--color-sat-text-muted); }

  .sk-ochir {
    flex: none; width: var(--size-touch-min); min-height: var(--size-touch-min);
    border-radius: var(--radius-lg); border: var(--border-width-1) solid var(--color-sat-line-strong);
    background: transparent; color: var(--color-sat-text-muted);
    font: inherit; font-family: var(--font-sat); font-weight: var(--font-weight-semibold); font-size: var(--text-small-size);
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
  }
  .sk-ochir[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) { .sk-ochir:hover { border-color: var(--color-sat-blue); } }
  .sk-ochir-harf { text-decoration: line-through; text-decoration-thickness: 2px; }
  .sk-ochir[aria-pressed='true'] { color: var(--color-sat-text); border-color: var(--color-sat-text); border-style: dashed; }
  .sk-ochir[aria-pressed='true'] .sk-ochir-harf { text-decoration: none; }

  /* Qulflangan (javob berilgan) */
  .sk-qulf .sk-variant { cursor: default; }
  @media (hover: hover) and (pointer: fine) { .sk-qulf .sk-variant:hover { border-color: var(--color-sat-line-strong); } }
  @media (hover: hover) and (pointer: fine) { .sk-qulf .sk-tanlangan .sk-variant:hover { border-color: var(--color-sat-blue-fill); } }

  /* Natija (taymersiz): to'g'ri javob success, belgi bilan; xato javob uzuq chiziq va to'lgan harf */
  .sk-togri .sk-variant { background: var(--color-success-subtle); border-color: var(--color-success-ui); box-shadow: inset 0 0 0 1px var(--color-success-ui); }
  @media (hover: hover) and (pointer: fine) { .sk-qulf .sk-togri .sk-variant:hover { border-color: var(--color-success-ui); } }
  .sk-togri .sk-harf { background: transparent; border: var(--border-width-2) solid var(--color-success-ui); color: var(--color-success-text); }
  .sk-togri .sk-belgi-togri { display: block; color: var(--color-success-text); }
  .sk-xato .sk-variant { border: var(--border-width-1) dashed var(--color-sat-text); box-shadow: none; }
  @media (hover: hover) and (pointer: fine) { .sk-qulf .sk-xato .sk-variant:hover { border-color: var(--color-sat-text); } }
  .sk-xato .sk-v-matn { text-decoration: line-through; }
  .sk-xato .sk-harf { background: var(--color-sat-text); border-color: var(--color-sat-text); color: var(--color-sat-surface); }
  .sk-xato .sk-belgi-xato { display: block; color: var(--color-sat-text); }

  .sk-natija { margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
  .sk-natija[hidden] { display: none; }
  .sk-natija-sarlavha { margin: 0; font-family: var(--font-sat); font-size: var(--font-size-body-d); line-height: var(--line-height-body-d); font-weight: var(--font-weight-semibold); }
  .sk-natija.sk-natija-togri { border-color: var(--color-success-ui); }
  .sk-natija.sk-natija-togri .sk-natija-sarlavha { color: var(--color-success-text); }
  .sk-natija-izoh { font-size: var(--text-body-size); }
  .sk-natija-izoh:empty { display: none; }

  /* SPR: maydon tekis sirt (forma zich shisha ichida, blur yo'q) */
  .sk-spr { display: flex; flex-direction: column; gap: var(--space-2); }
  .sk-spr-yorliq { font-weight: var(--font-weight-semibold); }
  .sk-spr-qator { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; }
  .sk-spr-maydon {
    flex: 0 1 240px; min-width: 0;
    min-height: var(--size-touch-min); padding: 0 var(--space-4);
    background: var(--color-sat-surface); color: var(--color-sat-text);
    border: var(--border-width-2) solid var(--color-sat-line-strong); border-radius: var(--radius-lg);
    font: inherit; font-size: var(--font-size-body-d); font-weight: var(--font-weight-semibold); font-variant-numeric: tabular-nums;
  }
  .sk-spr-maydon:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); border-color: var(--color-sat-blue-fill); }
  .sk-spr-maydon[aria-invalid='true'] { border-style: dashed; }
  .sk-spr-maydon:read-only { background: transparent; }
  .sk-spr-belgilar { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .sk-spr-belgilar[hidden] { display: none; }
  .sk-belgi-tugma {
    min-width: var(--size-touch-min); min-height: var(--size-touch-min);
    border: var(--border-width-1) solid var(--color-sat-line-strong); border-radius: var(--radius-md);
    background: var(--color-sat-surface); color: var(--color-sat-text);
    font: inherit; font-weight: var(--font-weight-semibold); cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) { .sk-belgi-tugma:hover { border-color: var(--color-sat-blue); } }
  .sk-yordam { margin: 0; font-size: var(--text-small-size); color: var(--color-sat-text-muted); max-width: var(--size-measure); }
  .sk-spr-xato {
    margin: 0; align-self: flex-start;
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm);
    background: var(--color-warning-subtle); color: var(--color-warning-text);
    font-size: var(--text-small-size); font-weight: var(--font-weight-semibold);
    display: flex; align-items: flex-start; gap: var(--space-2);
  }
  .sk-spr-xato[hidden], .sk-korinish[hidden] { display: none; }
  .sk-spr-xato svg { flex: none; width: 18px; height: 18px; margin-top: var(--space-1); }
  .sk-korinish { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-small-size); color: var(--color-sat-text-muted); }
  .sk-korinish-qiymat { font-size: var(--font-size-body-d); color: var(--color-sat-text); }

  /* Tugma: SAT ko'k kapsulasi (sat-blue-fill), savol panelida bitta */
  .sk-katta {
    min-height: var(--btn-glass-height); padding: 0 var(--space-6);
    border: 0; border-radius: var(--radius-full);
    font: inherit; font-weight: var(--text-button-weight); font-size: var(--text-button-size); cursor: pointer;
  }
  .sk-katta[hidden] { display: none; }
  .sk-asosiy {
    background: linear-gradient(180deg, var(--color-glass-highlight), transparent 55%) top / 100% 50% no-repeat, var(--color-sat-blue-fill);
    color: var(--color-sat-on-blue-fill);
    box-shadow: var(--shadow-btn-glass);
  }
  @media (hover: hover) and (pointer: fine) { .sk-asosiy:hover { box-shadow: var(--shadow-btn-glass-hover); } }
  .sk-katta:active { transform: var(--bosilish); }

  /* Keng konteyner: passage chapda, savol o'ngda, ikkalasi alohida suriladi */
  @container (min-width: 960px) {
    .sk-passageli { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .sk-passageli .sk-passage { max-height: calc(100vh - 220px); overflow-y: auto; }
  }

  /* Tor konteyner (telefon): passage tepada, savol pastda */
  @container (max-width: 560px) {
    .sk-passage, .sk-savol, .sk-natija { padding: var(--space-5) var(--space-4); }
    .sk-matn, .sk-stem { font-size: var(--text-body-size); }
    .sk-spr-maydon { flex: 1 1 100%; }
    .sk-spr-qator .sk-katta { flex: 1 1 100%; }
    .sk-asbob { padding: 0 var(--space-2); }
  }

  /* Zaxira: blur yo'q brauzer, shaffoflik kamaytirilgan yoki yuqori kontrast */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sk-passage, .sk-savol, .sk-natija { background: var(--color-sat-surface); }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .sk-passage, .sk-savol, .sk-natija {
      background: var(--color-sat-surface); border-color: var(--color-sat-line-strong);
      -webkit-backdrop-filter: none; backdrop-filter: none;
    }
    .sk-asosiy { background: var(--color-sat-blue-fill); }
  }
  @media (prefers-reduced-motion: reduce) { .sk-katta:active { transform: none; } }
</style>
