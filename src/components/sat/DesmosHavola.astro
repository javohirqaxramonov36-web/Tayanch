---
// Rasmiy Desmos grafik kalkulyatoriga matnli havola, yangi tabda ochiladi (P29, docs/qarorlar/003-desmos.md).
// Desmos API ishlatilmaydi: bepul Trial tarif ochiq saytda production uchun yo'q va kalit maxfiy bo'lishi shart.
// Tashqi skript yuklanmaydi, holat saqlanmaydi. Faqat Math savollarida ko'rsatiladi (`hidden` sahifa skriptidan).
interface Props {
  id?: string;
  hidden?: boolean;
}
const { id, hidden = false } = Astro.props;
---
<a class="desmos-havola" id={id} hidden={hidden} href="https://www.desmos.com/calculator" target="_blank" rel="noopener">
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" /><path d="M8 6h8" /><path d="M8 11h2M14 11h2M8 15h2M14 15h2M8 19h2M14 19h2" /></svg>
  <span>Desmos</span>
  <svg class="tashqi" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7" /><path d="M9 7h8v8" /></svg>
  <span class="desmos-sr">{' (graphing calculator, opens in a new tab)'}</span>
</a>

<style>
  .desmos-havola {
    min-height: 48px; padding: 0 var(--b-4);
    border-radius: var(--r-toliq);
    background: var(--sirt-ikkinchi); color: var(--matn);
    font-weight: 700; font-size: var(--matn-kichik); text-decoration: none;
    display: inline-flex; align-items: center; gap: var(--b-2);
  }
  .desmos-havola[hidden] { display: none; }
  .desmos-havola:hover { background: var(--chiziq-kuchli); }
  .tashqi { margin-left: calc(-1 * var(--b-1)); }
  .desmos-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
