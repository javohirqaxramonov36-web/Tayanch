---
// SAT telefon pastki tab bari (DS PR 5d, 2026-11-23; ADR 005, artifakt "SatTabBar", bundle.css .sat-tabbar).
// Faqat <720px: pastda suzuvchi zich navy shisha kapsula, ikkala mavzuda bir xil. ≥720px da yon panel yetarli.
// Bandlar: Today, Practice, Learn, Progress, Plan (yon panel guruhlari satYonGuruhlar, satTab.ts). Account va Lift
// poydevordagi hamburger panelda qoladi: tab bar ularni takrorlamaydi va almashtirmaydi.
// Joriy band URL'dan: aynan tab sahifasi aria-current="page", guruhdagi boshqa sahifa aria-current="true".
// Holatlar: doimiy ko'rinadi (aylantirganda yashirinmaydi). Matn maydoni fokusda bo'lsa yashirinadi (telefon
//   klaviaturasi ustiga chiqmasin), fokus ketganda qaytadi. Hamburger panel ochiq bo'lsa yashirinadi (panel pastini yopmasin).
// Sahifa pastida body'ga --size-sat-tabbar-joy + safe area bo'shliq: oxirgi kontent (SatEslatma) yopilmaydi.
// SatFokus (test, sessiya, mock, lug'at, kurs) sahifalarida yo'q: faqat BolimQobiq ulaydi. localStorage yo'q.
import { satYonGuruhlar } from '../../data/satSahifalar';
import { satQism, satTablar, type SatTabKalit } from '../../lib/sat/satTab';
import { yol } from '../../lib/yol';

const tablar = satTablar(
  satYonGuruhlar.map((g) => ({ nomi: g.nomi, qismlar: g.qismlar.flatMap((q) => q.sahifalar.map((s) => s.qism)) })),
  satQism(Astro.url.pathname),
);
// Ikonkalar yon paneldagi mos bandlardan (BolimYon.astro): Today = bosh, Practice = Question bank,
// Learn = qo'llanma (artifakt), Progress = My results, Plan = Study planner.
const ikonkalar: Record<SatTabKalit, string> = {
  today: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/>',
  practice: '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/>',
  learn: '<path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z"/><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"/>',
  progress: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  plan: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 15l2 2 4-4"/>',
};
---
<nav class="sat-tabbar-orami" aria-label="SAT sections" lang="en" data-sat-tab>
  <ul class="sat-tabbar">
    {tablar.map((t) => (
      <li>
        <a class="sat-tab" href={yol(`/uz/sat/${t.qism}`)} aria-current={t.joriy}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ikonkalar[t.kalit]} />
          <span class="sat-tab-nom">{t.nomi}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Telefon klaviaturasi ochiq (matn maydoni fokusda) bo'lsa panel yashirinadi. Holat saqlanmaydi.
  const panel = document.querySelector<HTMLElement>('[data-sat-tab]');
  if (panel) {
    const YOZISH = 'input:not([type="checkbox"], [type="radio"], [type="range"], [type="button"], [type="submit"], [type="reset"], [type="color"], [type="file"]), textarea, select, [contenteditable=""], [contenteditable="true"]';
    const yozishmi = (el: EventTarget | null) => el instanceof Element && el.matches(YOZISH);
    document.addEventListener('focusin', (e) => { panel.classList.toggle('klaviatura', yozishmi(e.target)); });
    document.addEventListener('focusout', (e) => { if (!yozishmi(e.relatedTarget)) panel.classList.remove('klaviatura'); });
  }
</script>

<style>
  .sat-tabbar-orami { display: none; }

  @media (width < 720px) {
    /* Oxirgi kontent tab bar ostida qolmasin */
    :global(body:has([data-sat-tab])) {
      padding-bottom: calc(var(--size-sat-tabbar-joy) + env(safe-area-inset-bottom));
    }
    /* Klaviatura bilan fokuslangan element tab bar ostida qolmasin (WCAG 2.4.11) */
    :global(html:has([data-sat-tab])) {
      scroll-padding-bottom: calc(var(--size-sat-tabbar-joy) + env(safe-area-inset-bottom));
    }
    .sat-tabbar-orami {
      display: block;
      position: fixed;
      z-index: var(--z-sticky);
      left: var(--space-2);
      right: var(--space-2);
      bottom: calc(var(--space-2) + env(safe-area-inset-bottom));
      /* Navy ustida fokus halqasi (sat.css .sat-sahna bilan bir xil) */
      --color-focus-ring: var(--color-accent-400);
      --color-focus-gap: var(--color-sat-navy);
      color-scheme: dark;
    }
    .sat-tabbar-orami.klaviatura,
    :global(body:has(.yon-orami[open])) .sat-tabbar-orami { display: none; }
  }

  /* Zich navy shisha: qisqa yorliq ham har qanday kontent ustida o'qiladi (shaffof variant emas) */
  .sat-tabbar {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-1);
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-1);
    list-style: none;
    border: var(--border-width-1) solid var(--color-sat-glass-navy-border);
    border-radius: var(--radius-xl);
    background: var(--color-sat-glass-navy-strong);
    box-shadow: var(--shadow-sat-panel-navy);
    -webkit-backdrop-filter: var(--glass-backdrop);
    backdrop-filter: var(--glass-backdrop);
  }
  .sat-tab {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-1);
    min-width: 0;
    min-height: var(--size-sat-tabbar);
    border-radius: var(--radius-lg);
    color: var(--color-sat-on-navy-muted);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: transform var(--duration-fast) var(--ease-state);
  }
  .sat-tab svg { width: var(--size-icon-md); height: var(--size-icon-md); }
  .sat-tab-nom {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-lh);
    font-weight: var(--font-weight-medium);
  }
  @media (hover: hover) and (pointer: fine) {
    .sat-tab:hover { color: var(--color-sat-on-navy); }
  }
  .sat-tab[aria-current] {
    color: var(--color-sat-sky);
    background: var(--color-sat-navy-high);
    box-shadow: inset 0 1px 0 var(--color-sat-glass-navy-border);
  }
  .sat-tab[aria-current] .sat-tab-nom { font-weight: var(--font-weight-semibold); }
  .sat-tab:active { transform: var(--bosilish); }

  /* Zaxira: blur yo'q brauzer, shaffoflik kamaytirilgan yoki yuqori kontrast: tekis navy sirt */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sat-tabbar { background: var(--color-sat-navy-raised); }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .sat-tabbar {
      border-color: var(--color-sat-line-on-navy);
      background: var(--color-sat-navy-raised);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
