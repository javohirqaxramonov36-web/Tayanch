---
// SAT bo'limining yon paneli (sidebar).
// >= 1024px: chapda doimiy panel, yig'ish tugmasi bilan (holat localStorage "tayanch:sidebar").
// < 1024px: ustki qatordagi hamburger tugmasi panelni chapdan chiqaradi.
//   Esc yopadi, fokus panel ichida aylanadi, qolgan sahifa inert bo'ladi, aria-expanded yangilanadi.
import { satGuruhlar } from '../data/satSahifalar';
import { bolimlar } from '../data/bolimlar';
import { yol } from '../lib/yol';

const joriy = Astro.url.pathname;
const sat = (qism: string) => yol(`/uz/sat/${qism}`);
const boshqaBolimlar = bolimlar.filter((b) => b.slug !== 'sat');
const tayanchHavolalar = [
  { nomi: 'Bosh sahifa', href: yol('/uz/') },
  { nomi: 'Muddatlar', href: yol('/uz/deadline/') },
  { nomi: 'Manbalar', href: yol('/uz/manbalar/') },
];
const joriymi = (href: string) => joriy === href || joriy === href.replace(/\/$/, '');
---
<header class="ustki-qator">
  <a class="logo" href={yol('/uz/sat/')}>
    <span class="logo-belgi" aria-hidden="true">T</span>
    <span class="logo-nom">Tayanch <span class="logo-bolim">SAT</span></span>
  </a>
  <button
    type="button"
    class="belgi-tugma"
    id="panel-ochish"
    aria-controls="sat-yon"
    aria-expanded="false"
    aria-label="Menyuni ochish"
  >
    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
  </button>
</header>

<div class="parda" id="panel-parda" aria-hidden="true"></div>

<aside class="yon" id="sat-yon" aria-label="SAT bo'limi">
  <div class="yon-bosh">
    <a class="logo" href={yol('/uz/sat/')}>
      <span class="logo-belgi" aria-hidden="true">T</span>
      <span class="logo-nom yon-matn">Tayanch <span class="logo-bolim">SAT</span></span>
    </a>
    <button
      type="button"
      class="belgi-tugma faqat-katta"
      id="yon-yigish"
      aria-controls="sat-yon-nav"
      aria-expanded="true"
      aria-label="Yon panelni yig'ish"
      title="Yon panelni yig'ish"
    >
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /><path class="yigish-strelka" d="M15 10l-2 2 2 2" /></svg>
    </button>
    <button type="button" class="belgi-tugma faqat-kichik" id="panel-yopish" aria-label="Menyuni yopish">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <nav class="yon-nav yon-matn" id="sat-yon-nav" aria-label="SAT navigatsiyasi">
    <ul class="royxat">
      <li><a href={sat('')} aria-current={joriymi(sat('')) ? 'page' : undefined}>SAT bo'limi haqida</a></li>
    </ul>
    {satGuruhlar.map((g, i) => (
      <div class="guruh">
        <h2 class="guruh-nom" id={`yon-guruh-${i}`}>{g.nomi}</h2>
        <ul class="royxat" aria-labelledby={`yon-guruh-${i}`}>
          {g.sahifalar.map((s) => (
            <li><a href={sat(s.qism)} aria-current={joriymi(sat(s.qism)) ? 'page' : undefined}>{s.nomi}</a></li>
          ))}
        </ul>
      </div>
    ))}
    <div class="guruh">
      <h2 class="guruh-nom" id="yon-guruh-tayanch">Tayanch</h2>
      <ul class="royxat" aria-labelledby="yon-guruh-tayanch">
        <li><a href={tayanchHavolalar[0].href}>{tayanchHavolalar[0].nomi}</a></li>
        {boshqaBolimlar.map((b) => (
          <li>
            {b.holat === 'ochiq'
              ? <a href={yol(`/uz/${b.slug}/`)}>{b.nomi}</a>
              : <span class="nofaol">{b.nomi} <span class="yorliq">tez orada</span></span>}
          </li>
        ))}
        {tayanchHavolalar.slice(1).map((h) => (
          <li><a href={h.href} aria-current={joriymi(h.href) ? 'page' : undefined}>{h.nomi}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="yon-past">
    <button type="button" class="past-tugma" id="mavzu-tugma" aria-pressed="false" title="Qorong'i mavzu">
      <svg class="oy" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
      <svg class="quyosh" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <span class="yon-matn">Qorong'i mavzu</span>
    </button>
    <button type="button" class="past-tugma" id="tozalash-tugma" aria-haspopup="dialog" title="Brauzerdagi ma'lumotni o'chirish">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /></svg>
      <span class="yon-matn">Brauzerdagi ma'lumotni o'chirish</span>
    </button>
    <p class="holat-xabar kichik" id="tozalash-xabar" role="status" aria-live="polite"></p>
  </div>
</aside>

<dialog class="tasdiq" id="tozalash-oyna" aria-labelledby="tozalash-sarlavha" aria-describedby="tozalash-matn">
  <form method="dialog" class="tasdiq-ichki">
    <h2 id="tozalash-sarlavha">Ma'lumotni o'chirasizmi?</h2>
    <p id="tozalash-matn" class="ikkinchi">Shu brauzerda saqlangan Tayanch ma'lumoti o'chadi: mavzu tanlovi, yon panel holati va mashq javoblari. Boshqa saytlarning ma'lumotiga tegilmaydi. Buni qaytarib bo'lmaydi.</p>
    <div class="tasdiq-tugmalar">
      <button type="submit" value="bekor" class="tugma tugma-ikkinchi" autofocus>Bekor qilish</button>
      <button type="submit" value="ochir" class="tugma tugma-asosiy">Ha, o'chirish</button>
    </div>
  </form>
</dialog>

<script>
  const KALIT_PREFIKS = 'tayanch:';
  const d = document.documentElement;
  const kattaEkran = window.matchMedia('(min-width: 1024px)');

  const oqi = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const yoz = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* saqlab bo'lmadi */ } };

  // --- Mavzu ---
  const mavzuTugma = document.getElementById('mavzu-tugma') as HTMLButtonElement;
  const tizimQorongi = window.matchMedia('(prefers-color-scheme: dark)');
  const mavzuQoy = (m: 'yorug' | 'qorongi') => {
    d.setAttribute('data-mavzu', m);
    mavzuTugma.setAttribute('aria-pressed', String(m === 'qorongi'));
  };
  mavzuQoy(d.getAttribute('data-mavzu') === 'qorongi' ? 'qorongi' : 'yorug');
  mavzuTugma.addEventListener('click', () => {
    const yangi = d.getAttribute('data-mavzu') === 'qorongi' ? 'yorug' : 'qorongi';
    mavzuQoy(yangi);
    yoz(KALIT_PREFIKS + 'mavzu', yangi);
  });
  // Tanlov saqlanmagan bo'lsa, tizim mavzusi o'zgarishini kuzatamiz.
  tizimQorongi.addEventListener('change', (e) => {
    const t = oqi(KALIT_PREFIKS + 'mavzu');
    if (t !== 'yorug' && t !== 'qorongi') mavzuQoy(e.matches ? 'qorongi' : 'yorug');
  });

  // --- Yig'ish (katta ekran) ---
  const yigish = document.getElementById('yon-yigish') as HTMLButtonElement;
  const yigishQoy = (yigilgan: boolean) => {
    if (yigilgan) d.setAttribute('data-sidebar', 'yigilgan');
    else d.removeAttribute('data-sidebar');
    yigish.setAttribute('aria-expanded', String(!yigilgan));
    const yozuv = yigilgan ? 'Yon panelni yoyish' : "Yon panelni yig'ish";
    yigish.setAttribute('aria-label', yozuv);
    yigish.title = yozuv;
  };
  yigishQoy(d.getAttribute('data-sidebar') === 'yigilgan');
  yigish.addEventListener('click', () => {
    const yigilgan = d.getAttribute('data-sidebar') !== 'yigilgan';
    yigishQoy(yigilgan);
    yoz(KALIT_PREFIKS + 'sidebar', yigilgan ? 'yigilgan' : 'ochiq');
  });

  // --- Chiqib keladigan panel (kichik ekran) ---
  const panel = document.getElementById('sat-yon') as HTMLElement;
  const ochish = document.getElementById('panel-ochish') as HTMLButtonElement;
  const yopish = document.getElementById('panel-yopish') as HTMLButtonElement;
  const parda = document.getElementById('panel-parda') as HTMLElement;
  const tashqari = () => Array.from(document.querySelectorAll<HTMLElement>('[data-panel-tashqari]'));
  const fokuslanadigan = () =>
    Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
      .filter((el) => el.offsetParent !== null);

  let ochiq = false;
  const panelQoy = (holat: boolean, fokusQaytar = true) => {
    ochiq = holat;
    d.toggleAttribute('data-panel-ochiq', holat);
    ochish.setAttribute('aria-expanded', String(holat));
    tashqari().forEach((el) => { el.inert = holat; });
    if (holat) {
      yopish.focus();
    } else if (fokusQaytar) {
      ochish.focus();
    }
  };
  ochish.addEventListener('click', () => panelQoy(true));
  yopish.addEventListener('click', () => panelQoy(false));
  parda.addEventListener('click', () => panelQoy(false));

  document.addEventListener('keydown', (e) => {
    if (!ochiq || kattaEkran.matches) return;
    if ((document.getElementById('tozalash-oyna') as HTMLDialogElement).open) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      panelQoy(false);
    } else if (e.key === 'Tab') {
      const el = fokuslanadigan();
      if (el.length === 0) return;
      const birinchi = el[0];
      const oxirgi = el[el.length - 1];
      const faol = document.activeElement as HTMLElement | null;
      if (!faol || !panel.contains(faol)) {
        e.preventDefault();
        birinchi.focus();
      } else if (e.shiftKey && faol === birinchi) {
        e.preventDefault();
        oxirgi.focus();
      } else if (!e.shiftKey && faol === oxirgi) {
        e.preventDefault();
        birinchi.focus();
      }
    }
  });
  // Ekran kattalashsa, ochiq panel holatini tozalaymiz.
  kattaEkran.addEventListener('change', (e) => { if (e.matches && ochiq) panelQoy(false, false); });

  // --- Ma'lumotni o'chirish ---
  const oyna = document.getElementById('tozalash-oyna') as HTMLDialogElement;
  const xabar = document.getElementById('tozalash-xabar') as HTMLElement;
  const tozalashTugma = document.getElementById('tozalash-tugma') as HTMLButtonElement;
  tozalashTugma.addEventListener('click', () => {
    oyna.returnValue = '';
    oyna.showModal();
  });
  oyna.addEventListener('close', () => {
    if (oyna.returnValue !== 'ochir') { tozalashTugma.focus(); return; }
    let soni = 0;
    for (const ombor of ['localStorage', 'sessionStorage'] as const) {
      try {
        const s = window[ombor];
        const kalitlar: string[] = [];
        for (let i = 0; i < s.length; i++) {
          const k = s.key(i);
          if (k && k.startsWith(KALIT_PREFIKS)) kalitlar.push(k);
        }
        kalitlar.forEach((k) => s.removeItem(k));
        soni += kalitlar.length;
      } catch { /* ombor yopiq */ }
    }
    mavzuQoy(tizimQorongi.matches ? 'qorongi' : 'yorug');
    yigishQoy(false);
    xabar.textContent = soni > 0 ? "Tayanch ma'lumoti o'chirildi." : "O'chiradigan Tayanch ma'lumoti yo'q edi.";
    tozalashTugma.focus();
  });
</script>

<style>
  /* Ustki qator: faqat kichik ekranda */
  .ustki-qator {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--b-3);
    padding: var(--b-2) var(--b-4);
    background: var(--sirt);
    border-bottom: 1px solid var(--chiziq);
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; }
  .logo-belgi {
    flex: none;
    width: 36px; height: 36px; border-radius: 12px;
    background: var(--matn); color: var(--fon);
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 20px;
  }
  .logo-nom { font-weight: 900; font-size: 20px; white-space: nowrap; }
  .logo-bolim { color: var(--rang-havola); }

  .belgi-tugma {
    flex: none;
    width: 48px; height: 48px;
    display: inline-flex; align-items: center; justify-content: center;
    border: none; border-radius: var(--r-toliq);
    background: transparent; color: var(--matn);
    cursor: pointer;
  }
  .belgi-tugma:hover { background: var(--sirt-ikkinchi); }

  /* Panel */
  .yon {
    background: var(--sirt);
    display: flex; flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .yon-bosh {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--b-2);
    padding: var(--b-3) var(--b-3) var(--b-3) var(--b-4);
    min-height: 72px;
  }
  .yon-nav { flex: 1; padding: var(--b-2) var(--b-3) var(--b-4); display: flex; flex-direction: column; gap: var(--b-4); }
  .guruh { display: flex; flex-direction: column; gap: var(--b-1); }
  .guruh-nom {
    font-size: var(--matn-mayda); font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--matn-sust);
    padding: 0 var(--b-3);
    margin-bottom: var(--b-1);
  }
  .royxat { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .royxat a, .nofaol {
    display: flex; align-items: center; justify-content: space-between; gap: var(--b-2);
    min-height: 44px;
    padding: var(--b-2) var(--b-3);
    border-radius: var(--r-orta);
    text-decoration: none;
    font-weight: 600; font-size: 15px;
  }
  .royxat a:hover { background: var(--fon-ikkinchi); }
  .royxat a[aria-current='page'] { background: var(--fon-ikkinchi); color: var(--rang-havola); font-weight: 800; }
  .nofaol { color: var(--matn-sust); }

  .yon-past {
    border-top: 1px solid var(--chiziq);
    padding: var(--b-3);
    display: flex; flex-direction: column; gap: 2px;
  }
  .past-tugma {
    display: flex; align-items: center; gap: var(--b-3);
    width: 100%; min-height: 48px;
    padding: var(--b-2) var(--b-3);
    border: none; border-radius: var(--r-orta);
    background: transparent; color: var(--matn);
    font: inherit; font-size: 15px; font-weight: 600; text-align: left;
    cursor: pointer;
  }
  .past-tugma svg { flex: none; }
  .past-tugma:hover { background: var(--fon-ikkinchi); }
  .past-tugma .quyosh { display: none; }
  :global([data-mavzu='qorongi']) .past-tugma .oy { display: none; }
  :global([data-mavzu='qorongi']) .past-tugma .quyosh { display: block; }
  .holat-xabar { color: var(--matn-ikkinchi); padding: 0 var(--b-3); }
  .holat-xabar:empty { display: none; }

  .parda { display: none; }

  /* Kichik ekran: chiqib keladigan panel */
  @media (max-width: 1023.98px) {
    .faqat-katta { display: none; }
    .yon {
      position: fixed; z-index: 40; inset: 0 auto 0 0;
      width: min(320px, 86vw);
      height: 100dvh;
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform 0.22s ease, visibility 0s linear 0.22s;
      box-shadow: var(--soya);
    }
    :global([data-panel-ochiq]) .yon {
      transform: none; visibility: visible;
      transition: transform 0.22s ease;
    }
    .parda {
      display: block;
      position: fixed; inset: 0; z-index: 30;
      background: var(--parda);
      opacity: 0; pointer-events: none;
      transition: opacity 0.22s ease;
    }
    :global([data-panel-ochiq]) .parda { opacity: 1; pointer-events: auto; }
    :global(html[data-panel-ochiq]) { overflow: hidden; }
  }

  /* Katta ekran: doimiy panel */
  @media (min-width: 1024px) {
    .ustki-qator, .faqat-kichik { display: none; }
    .yon {
      position: sticky; top: 0;
      height: 100vh;
      border-right: 1px solid var(--chiziq);
    }
    :global([data-sidebar='yigilgan']) .yon-matn { display: none; }
    :global([data-sidebar='yigilgan']) .yon-bosh {
      flex-direction: column; padding-inline: var(--b-3); gap: var(--b-3);
    }
    :global([data-sidebar='yigilgan']) .past-tugma { justify-content: center; padding-inline: 0; }
    :global([data-sidebar='yigilgan']) .yigish-strelka { transform: rotate(180deg); transform-origin: 14px 12px; }
    :global([data-sidebar='yigilgan']) .holat-xabar { display: none; }
  }

  /* Tasdiqlash oynasi */
  .tasdiq {
    border: none; border-radius: var(--r-katta);
    padding: 0;
    width: min(440px, calc(100vw - 32px));
    background: var(--sirt); color: var(--matn);
    box-shadow: var(--soya);
  }
  .tasdiq::backdrop { background: var(--parda); }
  .tasdiq-ichki { padding: var(--b-6); display: flex; flex-direction: column; gap: var(--b-4); }
  .tasdiq h2 { font-size: var(--matn-h3); }
  .tasdiq-tugmalar { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--b-2); }
</style>
