---
interface Props { inglizcha: boolean; qavat: number; variant: string }
const { inglizcha, qavat, variant } = Astro.props;
const id = 'suhbatdosh-' + variant;
const matn = inglizcha ? {
  nom: 'Assistant', yon: 'Voice conversation', yop: 'Close', boshlash: 'Start microphone', tugatish: 'Send recording',
  savol: 'Or type a question in Uzbek', yubor: 'Send', tayyor: 'Ready', mikKut: 'Waiting for microphone permission…',
  tingla: 'Listening…', kut: 'Preparing a reply…', gapir: 'Speaking…', qayta: 'Play reply',
  sozlama: 'Voice service is not configured yet.', ovozXato: 'Audio could not play. You can read the reply or try playing it again.',
  mikXato: 'The microphone could not start. Check permissions or type your question.',
  eshitilmadi: 'I didn’t catch that. Try again or type your question.',
  xato: 'A reply is unavailable. Try again.', sahnaXato: '3D is unavailable on this device.',
  tushuntirish: 'Google processes your recording or typed question and reads the reply. Tayanch does not save this conversation.',
} : {
  nom: 'Suhbatdosh', yon: 'Ovozli suhbat', yop: 'Yopish', boshlash: 'Mikrofonni yoqish', tugatish: 'Yozuvni yuborish',
  savol: 'Yoki savolingizni o‘zbekcha yozing', yubor: 'Yuborish', tayyor: 'Suhbatga tayyor',
  mikKut: 'Mikrofon ruxsati kutilmoqda…', tingla: 'Tinglayapti…', kut: 'Javob tayyorlayapti…',
  gapir: 'Gapiryapti…', qayta: 'Javobni eshitish', sozlama: 'Ovoz xizmati hali sozlanmagan.',
  ovozXato: 'Ovoz ijro etilmadi. Javobni o‘qing yoki qayta eshiting.',
  mikXato: 'Mikrofon ochilmadi. Ruxsatni tekshiring yoki savolni yozing.',
  eshitilmadi: 'Gapni tushunmadim. Qayta ayting yoki savolni yozing.',
  xato: 'Javob kelmadi. Qayta urinib ko‘ring.', sahnaXato: 'Bu qurilmada 3D ko‘rinish ochilmadi.',
  tushuntirish: 'Google ovozli yoki yozma savolingizni qayta ishlaydi va javobni ovozlashtiradi. Tayanch suhbatni saqlamaydi.',
};
---
<li data-suhbatdosh hidden>
  <button class="qa-ochish" type="button" data-ochish aria-label={matn.nom} aria-haspopup="dialog" title={matn.nom}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8A8.5 8.5 0 0 1 12.5 20a8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 8-8.5h.5a8.5 8.5 0 0 1 8 8z"/>
      <path d="M9 12h.01m3 0h.01m3 0h.01" stroke-width="2.5"/>
    </svg>
  </button>
  <dialog id={id} aria-labelledby={id + '-nom'} aria-describedby={id + '-izoh'}
    data-qavat={qavat} data-matn={JSON.stringify(matn)}>
    <div class="qa-qobiq">
      <header>
        <div><p>{matn.yon}</p><h2 id={id + '-nom'}>{matn.nom}</h2></div>
        <button type="button" class="tugma tugma-ikkinchi" data-yop autofocus>{matn.yop}</button>
      </header>
      <div class="qa-sahna" data-sahna></div>
      <p data-holat role="status">{matn.tayyor}</p>
      <div class="qa-javob" lang="uz" aria-live="polite" data-javob hidden>
        <p data-savol-matn></p>
        <p data-javob-matn></p>
      </div>
      <div class="qa-tugmalar">
        <button type="button" class="tugma tugma-asosiy" data-mikrofon>{matn.boshlash}</button>
        <button type="button" class="tugma tugma-ikkinchi" data-ijro hidden>{matn.qayta}</button>
      </div>
      <form>
        <label for={id + '-savol'}>{matn.savol}</label>
        <div class="qa-forma">
          <input id={id + '-savol'} lang="uz" type="text" maxlength="500" required autocomplete="off" />
          <button type="submit" class="tugma tugma-ikkinchi">{matn.yubor}</button>
        </div>
      </form>
      <p class="qa-izoh" id={id + '-izoh'}>{matn.tushuntirish}</p>
    </div>
  </dialog>
</li>

<script>
  import { suhbatdoshniUla } from '../lib/suhbatdosh';
  suhbatdoshniUla();
</script>

<style>
  [hidden] { display: none; }
  .qa-ochish {
    display: grid;
    place-items: center;
    inline-size: var(--size-touch-min);
    block-size: var(--control-height-md);
    margin-inline: auto;
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
  }
  .qa-ochish:hover { background: var(--color-surface-sunken); }
  .qa-ochish svg { inline-size: var(--space-5); block-size: var(--space-5); }
  dialog {
    box-sizing: border-box;
    width: min(calc(100% - var(--space-4)), calc(var(--space-16) * 8));
    max-block-size: calc(100dvh - var(--space-4));
    margin: auto;
    padding: 0;
    border: var(--border-width-1) solid var(--color-border);
    border-radius: var(--modal-radius);
    background: var(--color-surface);
    color: var(--color-text-primary);
  }
  dialog::backdrop { background: var(--scrim); }
  .qa-qobiq { display: grid; gap: var(--space-3); padding: var(--space-4); }
  header, .qa-forma, .qa-tugmalar { display: flex; align-items: center; gap: var(--space-2); }
  header { justify-content: space-between; }
  h2, p { margin: 0; }
  header p, .qa-izoh, [data-holat] { color: var(--color-text-secondary); }
  .qa-izoh { font-size: var(--text-caption-size); }
  .qa-sahna {
    display: grid;
    place-items: center;
    min-inline-size: 0;
    /* Portret model: telefonda ekranning ko'pi bilan yarmi */
    block-size: clamp(calc(var(--space-16) * 3), 46dvh, calc(var(--space-16) * 6.5));
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-sunken);
    text-align: center;
  }
  .qa-sahna :global(canvas) { display: block; max-inline-size: 100%; border-radius: var(--radius-lg); }
  .qa-sahna :global(.qa-yuklanmoqda) { color: var(--color-text-secondary); }
  .qa-tugmalar { flex-wrap: wrap; }
  .qa-javob { padding: var(--space-3); overflow-wrap: anywhere; background: var(--color-surface-sunken); border-radius: var(--radius-md); }
  [data-savol-matn] { color: var(--color-text-secondary); margin-block-end: var(--space-1); }
  form { display: grid; gap: var(--space-1); }
  input {
    flex: 1; min-width: 0; min-block-size: var(--control-height-md); padding-inline: var(--space-3);
    color: inherit; font: inherit; background: var(--input-bg);
    border: var(--border-width-2) solid var(--input-border); border-radius: var(--radius-md);
  }
</style>
