---
// Top Admission: bitta faktni ko'rsatish (Admission D-seriya, Q1).
// Faqat "tasdiqlangan" fakt qiymati chiqadi, yonida "Manba" havolasi va tekshirilgan sana.
// "qoralama" va "topilmadi" o'rniga "Ma'lumot tekshirilmoqda". Eskirgan tasdiqlangan fakt yonida "qayta tekshirilmoqda".
// Eskirish build paytida hisoblanadi (statik sayt): sana sayt har qurilganda yangilanadi.
import { faktEskirganmi, faktKorinadimi, faktQiymatMatni, sanaMatni, type Fakt } from '../../lib/topAdmission/fakt';

interface Props {
  fakt: Fakt | null | undefined;
  /** Qiymatdan keyingi qo'shimcha, masalan "USD" yoki "yil". */
  birlik?: string;
  /** Qiymatni boshqacha chiqarish (masalan sana yoki ro'yxat). */
  format?: (qiymat: Fakt['qiymat']) => string;
  /** Jadval uchun: fakt yo'q bo'lsa uzun matn o'rniga "—" (ekran o'quvchiga "ma'lumot tekshirilmoqda"). */
  qisqa?: boolean;
  /** Manba va sana karta ostida bitta qatorda ko'rsatilganda (umumiyManba): fakt yonida takrorlanmaydi. */
  metasiz?: boolean;
}
const { fakt, birlik, format, qisqa, metasiz } = Astro.props;
const korinadi = faktKorinadimi(fakt);
const eskirgan = korinadi && faktEskirganmi(fakt);
const qiymat = korinadi && fakt ? (format ? format(fakt.qiymat) : faktQiymatMatni(fakt.qiymat)) : '';
---
{korinadi && fakt ? (
  <span class="fakt">
    <span class="fakt-qiymat">{qiymat}{birlik && <> {birlik}</>}</span>
    {(!metasiz || eskirgan) && (
      <span class="fakt-meta">
        {!metasiz && <a href={fakt.source_url} rel="noopener">Manba</a>}
        {!metasiz && <span>tekshirilgan <time datetime={fakt.tekshirilgan_sana}>{sanaMatni(fakt.tekshirilgan_sana)}</time></span>}
        {eskirgan && <span class="fakt-belgi">qayta tekshirilmoqda</span>}
      </span>
    )}
  </span>
) : qisqa ? (
  <span class="fakt fakt-yoq fakt-qisqa"><span aria-hidden="true">—</span><span class="fakt-sr">Maʼlumot tekshirilmoqda</span></span>
) : (
  <span class="fakt fakt-yoq">Maʼlumot tekshirilmoqda</span>
)}

<style>
  .fakt { display: inline-flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .fakt-qiymat { font-weight: var(--font-weight-bold); overflow-wrap: anywhere; }
  .fakt-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); font-size: var(--text-caption-size); color: var(--color-adm-text-muted); }
  .fakt-meta a { color: var(--color-link); }
  .fakt-belgi {
    display: inline-flex; align-items: center; min-height: var(--badge-height); padding: 0 var(--badge-pad);
    border-radius: var(--badge-radius); background: var(--color-warning-subtle); color: var(--color-warning-text); font-weight: var(--font-weight-semibold);
  }
  .fakt-yoq { color: var(--color-adm-text-muted); font-style: italic; }
  .fakt-qisqa { font-style: normal; }
  .fakt-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
