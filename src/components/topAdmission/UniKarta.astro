---
// Top Admission: "Menga mos universitet" sahifasidagi bitta universitet kartasi (Admission D-seriya, Q4).
// Har fakt Fakt.astro orqali (faqat "tasdiqlangan" qiymat, manba va sana). Taqqoslash qatorlari ("Talab: 6.5 · Sizda: 6.0",
// xarajat va byudjet) hamda "Ro'yxatga saqlash" tugmasi sahifa skripti bilan to'ldiriladi (JS'siz yashirin).
// data-* maydonlarida faqat tasdiqlangan qiymatlar (UniXulosa), skript moslikni shulardan hisoblaydi.
// E1: IELTS holati (minimum / tavsiya / talab qilinmaydi / topilmadi), "kamida" xarajat tarkibi (UK, Koreya),
// "Foundation yili kerak" belgisi, to'liq ehtiyoj izohi, "Bu yilgi muddat o'tgan..." belgisi (brauzerda qayta hisoblanadi).
import Fakt from './Fakt.astro';
import { faktKorinadimi, sanaMatni, type Fakt as FaktT } from '../../lib/topAdmission/fakt';
import { MUDDAT_OTGAN_MATNI } from '../../lib/topAdmission/grantKatalog';
import {
  EHTIYOJ_IZOHI, ehtiyojIzohiKerakmi, foundationKerakmi, ieltsHolati, ieltsMatni, kamidami, sonMatni,
  type DavlatYashash, type UniKirish, type UniXulosa,
} from '../../lib/topAdmission/universitetMoslik';

interface Props {
  u: UniKirish & {
    imtihonlar: FaktT; ariza_tolovi: FaktT; tolovdan_ozod_qilish: FaktT; deadline: FaktT;
  };
  xulosa: UniXulosa;
  nom: string;
  davlatNom: string;
  /** Davlat kartasidagi viza yashash summasi ("kamida" tarkibi uchun) */
  yashash?: DavlatYashash | null;
  /** Tasdiqlangan deadline sanasi (YYYY-MM-DD) va build paytida o'tganmi */
  deadlineSana: string | null;
  otgan: boolean;
}
const { u, xulosa, nom, davlatNom, yashash, deadlineSana, otgan } = Astro.props;
const deadlineFormat = (q: FaktT['qiymat']) => (typeof q === 'string' ? sanaMatni(q) : String(q ?? ''));
const ieltsFormat = (q: FaktT['qiymat']) => (typeof q === 'number' ? ieltsMatni(q) : String(q ?? ''));
const ihol = ieltsHolati(u);
const kamida = kamidami(u);
const foundation = foundationKerakmi(u);
const ehtiyoj = ehtiyojIzohiKerakmi(u);
// Tozalash (Admission K): oddiy qatorlar faqat tekshirilgan fakt bo'lsa chiqadi; yo'qlari kartaning pastida bitta qatorda.
const kor = faktKorinadimi;
const yoqlar = [
  !kor(u.imtihonlar) && 'imtihonlar',
  !kor(u.ariza_tolovi) && "ariza to'lovi",
  !kor(u.tolovdan_ozod_qilish) && "to'lovdan ozod qilish",
  !kor(u.xalqaro_yordam_turi) && 'yordam turi',
  !kor(u.deadline) && 'deadline',
].filter((x): x is string => !!x);
---
<li class="um-karta" id={`uni-${u.slug}`} data-uni-karta data-slug={u.slug} data-nom={nom} data-davlat={u.davlat}
  data-ielts={xulosa.ielts ?? ''} data-xarajat-usd={xulosa.xarajatUsd ?? ''}
  data-yordam={xulosa.yordam === null ? '' : xulosa.yordam ? '1' : '0'} data-valyuta={u.valyuta}
  data-ielts-yoq={xulosa.ieltsYoq ? '1' : ''} data-kamida={xulosa.kamida ? '1' : ''} data-deadline-sana={deadlineSana ?? ''}>
  <div class="um-karta-bosh">
    <h3 class="um-karta-nom">{nom}</h3>
    <span class="um-belgi um-belgi-yetmaydi" data-yetmaydi hidden>Talabga yetmaydi</span>
  </div>
  <p class="um-yorliqlar">
    <span class="yorliq">{davlatNom}</span>
    {foundation && <span class="um-belgi um-belgi-foundation">Foundation yili kerak</span>}
    <span class="um-belgi um-belgi-otgan" data-otgan hidden={!otgan}>{MUDDAT_OTGAN_MATNI}</span>
  </p>
  <dl class="um-maydonlar">
    <div>
      <dt>{ihol === 'minimum' ? 'Min IELTS' : 'IELTS'}</dt>
      <dd>
        {ihol === 'minimum' && <Fakt fakt={u.min_ielts} format={ieltsFormat} />}
        {ihol === 'tavsiya' && (faktKorinadimi(u.ielts_tavsiya)
          ? <><span class="um-izoh">Rasmiy minimum yo'q, tavsiya etilgan:</span><Fakt fakt={u.ielts_tavsiya} format={ieltsFormat} /><span class="um-izoh um-sust">Saralashga ta'sir qilmaydi.</span></>
          : <Fakt fakt={null} />)}
        {ihol === 'talab_qilinmaydi' && (faktKorinadimi(u.imtihonlar)
          ? <span class="um-izoh">IELTS talab qilinmaydi (manba "Imtihonlar" qatorida).</span>
          : <Fakt fakt={null} />)}
        {ihol === 'topilmadi' && <Fakt fakt={null} />}
        <span class="um-solish" data-solish-ielts hidden></span>
      </dd>
    </div>
    {kamida ? (
      <div>
        <dt>Yillik xarajat</dt>
        <dd>
          {xulosa.kamida && xulosa.xarajatUsd !== null
            ? <span class="um-kamida">kamida ≈ {sonMatni(xulosa.xarajatUsd)} USD</span>
            : <Fakt fakt={null} />}
          <span class="um-izoh um-sust">Hisob: universitetning rasmiy eng past xalqaro kontrakti + davlatning viza uchun talab qiladigan yashash summasi. Haqiqiy xarajat bundan yuqori bo'lishi mumkin.</span>
          {kor(u.kontrakt_eng_past) && <><span class="um-tarkib-nom">Eng past xalqaro kontrakt (yillik)</span>
          <Fakt fakt={u.kontrakt_eng_past} birlik={u.valyuta} /></>}
          {kor(yashash?.viza_yashash_summasi) && <><span class="um-tarkib-nom">Viza uchun yashash summasi (davlat kartasidan)</span>
          <Fakt fakt={yashash?.viza_yashash_summasi} birlik={yashash?.valyuta} /></>}
          <span class="um-solish" data-solish-byudjet hidden></span>
        </dd>
      </div>
    ) : (
      <div>
        <dt>Yillik xarajat</dt>
        <dd>
          <Fakt fakt={u.yillik_xarajat} birlik={u.valyuta} />
          <span class="um-solish" data-solish-byudjet hidden></span>
        </dd>
      </div>
    )}
    {kor(u.imtihonlar) && <div><dt>Imtihonlar</dt><dd><Fakt fakt={u.imtihonlar} /></dd></div>}
    {kor(u.ariza_tolovi) && <div><dt>Ariza to'lovi</dt><dd><Fakt fakt={u.ariza_tolovi} birlik={u.valyuta} /></dd></div>}
    {kor(u.tolovdan_ozod_qilish) && <div><dt>To'lovdan ozod qilish</dt><dd><Fakt fakt={u.tolovdan_ozod_qilish} /></dd></div>}
    {kor(u.xalqaro_yordam_turi) && (
      <div>
        <dt>Yordam turi</dt>
        <dd>
          <Fakt fakt={u.xalqaro_yordam_turi} />
          {ehtiyoj && <span class="um-izoh um-sust">{EHTIYOJ_IZOHI}</span>}
        </dd>
      </div>
    )}
    {u.foundation_kerak && kor(u.foundation_kerak) && <div><dt>Foundation yili</dt><dd><Fakt fakt={u.foundation_kerak} /></dd></div>}
    {kor(u.deadline) && <div><dt>Deadline</dt><dd><Fakt fakt={u.deadline} format={deadlineFormat} /></dd></div>}
  </dl>
  {yoqlar.length > 0 && <p class="um-yoqlar">Hali tekshirilmoqda: {yoqlar.join(', ')}.</p>}
  <div class="um-karta-amal" hidden data-saqlash-joy>
    <button type="button" class="um-saqlash" data-saqlash aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 3h12v18l-6-4-6 4z" />
      </svg>
      <span data-saqlash-matn>Ro'yxatga saqlash</span><span class="um-sr">: {nom}</span>
    </button>
  </div>
</li>

<style>
  [hidden] { display: none !important; }
  .um-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .um-karta {
    display: flex; flex-direction: column; gap: var(--space-3); min-width: 0;
    padding: var(--card-pad); background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: var(--card-radius); box-shadow: var(--card-shadow);
  }
  .um-karta-bosh { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .um-karta-nom { margin: 0; font-size: var(--text-h3-size); line-height: var(--text-h3-lh); overflow-wrap: anywhere; }
  .um-yorliqlar { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .um-belgi {
    display: inline-flex; align-items: center; min-height: var(--badge-height); padding: 0 var(--badge-pad);
    border-radius: var(--badge-radius); font-size: var(--text-caption-size); font-weight: 600;
  }
  .um-belgi-yetmaydi, .um-belgi-otgan { background: var(--color-warning-subtle); color: var(--color-warning-text); }
  .um-belgi-otgan { max-width: 100%; padding-block: var(--space-1); }
  .um-belgi-foundation { background: var(--floor-subtle); color: var(--color-text-primary); border: 1px solid var(--floor-ui); }
  .um-izoh { font-size: var(--text-small-size); line-height: var(--text-small-lh); }
  .um-sust { color: var(--color-text-secondary); }
  .um-yoqlar { margin: 0; font-size: var(--text-small-size); line-height: var(--text-small-lh); color: var(--color-text-secondary); }
  .um-kamida { font-weight: 700; }
  .um-tarkib-nom { margin-top: var(--space-1); font-size: var(--text-small-size); font-weight: 600; color: var(--color-text-secondary); }
  .um-maydonlar { margin: 0; display: grid; gap: var(--space-3); }
  .um-maydonlar > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
  .um-maydonlar dt { font-size: var(--text-small-size); font-weight: 700; color: var(--color-text-secondary); }
  .um-maydonlar dd { margin: 0; min-width: 0; display: grid; gap: var(--space-1); }
  .um-solish { font-size: var(--text-small-size); font-weight: 600; }
  .um-solish.um-solish-yoq { color: var(--color-warning-text); }
  .um-karta-amal { margin-top: auto; padding-top: var(--space-2); }
  .um-saqlash {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--size-touch-min); padding: 0 var(--space-4);
    border: 1.5px solid var(--floor-ui); border-radius: var(--radius-full); background: var(--color-surface);
    color: var(--color-text-primary); font: inherit; font-size: var(--text-small-size); font-weight: 700; cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-state);
  }
  .um-saqlash:active { transform: var(--bosilish); }
  .um-saqlash[aria-pressed="true"] { background: var(--floor-subtle); }
  .um-saqlash[aria-pressed="true"] svg { fill: currentColor; }
  @media (hover: hover) and (pointer: fine) {
    .um-saqlash:hover { background: var(--floor-subtle); }
  }
  @media (max-width: 760px) {
    .um-maydonlar > div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
