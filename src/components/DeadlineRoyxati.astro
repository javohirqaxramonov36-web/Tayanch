---
import { korinadiganDeadlinelar } from '../data/deadline';
import type { BolimSlug } from '../data/bolimlar';
import { muddatChegarasi } from '../lib/muddat';
import { rasmiyManbalar } from '../data/manbalar';

// limit: ro'yxat sana bo'yicha tartiblangan, shuning uchun eng yaqin N tasi qoladi.
interface Props { bolim?: BolimSlug; faqatKelajak?: boolean; limit?: number }
const { bolim, faqatKelajak = false, limit } = Astro.props;
const royxat = korinadiganDeadlinelar({ bolim });
---
{royxat.length > 0 ? (
  <>
    <div data-muddat-limit={limit ?? ''}>
      <ul class="royxat">
        {royxat.map((d) => (
          <li data-oxir={muddatChegarasi(d.sana, d.soat, d.utcSiljish).oxir}>
            <strong>{d.sana}{d.soat ? ` ${d.soat}` : ''}{d.vaqtMintaqasi ? ` (${d.vaqtMintaqasi})` : ''}</strong>
            {!d.vaqtMintaqasi && <span class="kichik sust">Vaqt mintaqasi rasmiy manbada ko'rsatilmagan.</span>}
            <span>{d.dastur}: {d.bosqich}</span>
            {rasmiyManbalar(d.manbaIdlar).map((m) => (
              <span class="kichik sust">
                <a href={m.havola}>{m.nomi}</a> ({new URL(m.havola).hostname}) · Tekshirilgan: {m.tekshirilganSana}
                {d.muddatManbasi?.havola === m.havola && <> · Qayta tekshirilgan: {d.muddatManbasi.tekshirilganSana}</>}
              </span>
            ))}
            <span class="kichik sust">Muddat tekshirilgan sana: {d.tekshirilganSana}</span>
          </li>
        ))}
      </ul>
      {faqatKelajak && <p class="bosh" data-yaqin-yoq hidden>Hozircha tasdiqlangan yaqin muddat yo'q.</p>}
      <details hidden><summary>O'tgan muddatlar</summary><ul class="royxat"></ul></details>
    </div>
    <script is:inline>
      (() => {
        const box = document.currentScript.previousElementSibling;
        const list = box.firstElementChild;
        const archive = box.lastElementChild;
        const now = Date.now();
        const limit = Number(box.dataset.muddatLimit) || Infinity;
        let active = 0;
        for (const row of Array.from(list.children)) {
          if (now >= Number(row.dataset.oxir)) archive.lastElementChild.append(row);
          else if (++active > limit) row.hidden = true;
        }
        list.hidden = active === 0;
        archive.hidden = !archive.lastElementChild.children.length;
        const empty = box.querySelector('[data-yaqin-yoq]');
        if (empty) empty.hidden = active > 0;
      })();
    </script>
  </>
) : (
  <p class="bosh">Hozircha rasmiy manba bilan tasdiqlangan muddat yo'q.</p>
)}

<style>
  .royxat { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--b-2); }
  .royxat li {
    background: var(--fon-ikkinchi);
    border-radius: var(--r-orta);
    padding: var(--b-4) var(--b-5);
    display: flex; flex-direction: column; gap: var(--b-1);
  }
  [hidden] { display: none !important; }
  details:not([hidden]) { margin-top: var(--b-3); }
  summary { cursor: pointer; }
  .bosh {
    background: var(--fon-ikkinchi);
    border: 1px dashed var(--chiziq-kuchli);
    border-radius: var(--r-orta);
    padding: var(--b-6);
    color: var(--matn-ikkinchi);
  }
</style>
