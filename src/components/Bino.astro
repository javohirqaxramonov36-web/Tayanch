---
// Tayanch binosi: DS shisha bino (docs/ds/tayanch-ds-bino.txt, heroSVG), server tomonda, JS'siz.
// Bezak: aria-hidden. Ikonkalar qavatlar.ts dan. Geometriya va CSS DS dan o'zgarishsiz.
// Yonish: `aktiv` qavat yonib turadi. Sahifada [data-bino-yoq="N"] elementga hover yoki fokus
// kelsa, o'sha qavat yonadi (CSS :has). Reduced-motion'da DS davomiylik tokenlari 0ms.
import { qavatlar } from '../data/qavatlar';

interface Props {
  aktiv?: 1 | 2 | 3 | 4 | 5;
  class?: string;
}
const { aktiv = 1, class: klass } = Astro.props;

// DS FLOORS kalitlari (gradient ranglari --color-floor-<key>-500)
const KALIT = ['navigator', 'admission', 'sat', 'ielts', 'eyuf'] as const;

const cxm = 130, a = 100, b = 50, h = 36, pitch = 44, base = 330;
const P = (pts: number[][]) => pts.map((p) => p.join(',')).join(' ');
const pad = (n: number) => String(n).padStart(2, '0');
const y1 = base - h;
const soya = P([[cxm - a + 8, y1 - b + h + 12], [cxm + 8, y1 + h + 12], [cxm + a + 8, y1 - b + h + 12], [cxm + 8, y1 - 2 * b + h + 12]]);

const qavatShakli = qavatlar.map((q) => {
  const n = q.raqam;
  const yF = base - (n - 1) * pitch - h;
  const L = [cxm - a, yF - b], F = [cxm, yF], R = [cxm + a, yF - b], Bk = [cxm, yF - 2 * b];
  const Lb = [cxm - a, yF - b + h], Fb = [cxm, yF + h], Rb = [cxm + a, yF - b + h];
  return {
    n,
    ikonka: q.ikonka,
    left: P([L, F, Fb, Lb]), right: P([F, R, Rb, Fb]), top: P([L, F, R, Bk]), sil: P([L, Bk, R, Rb, Fb, Lb]),
    edge: P([Lb, Fb, Rb]), hl: P([L, F, R]),
    lab: `translate(${cxm - a + 14},${yF - b + 30}) matrix(1 .5 0 1 0 0)`,
    win: `translate(${cxm},${yF + 10}) matrix(1 -.5 0 1 0 0)`,
  };
});
const y5 = base - 4 * pitch - h;

const W = 'var(--color-neutral-0)', K = 'var(--color-neutral-950)';
const st = (o: number, c: string, d: string, p: number) => `<stop offset="${o}" style="stop-color:color-mix(in srgb, ${c} ${p}%, ${d})"/>`;
const gradientlar = KALIT.map((k, i) => {
  const n = i + 1, c = `var(--color-floor-${k}-500)`;
  return `<linearGradient id="gL${n}" x1="0" y1="0" x2="0" y2="1">${st(0, c, W, 92)}${st(1, c, K, 80)}</linearGradient>`
    + `<linearGradient id="gR${n}" x1="0" y1="0" x2="0" y2="1">${st(0, c, W, 70)}${st(1, c, W, 92)}</linearGradient>`
    + `<linearGradient id="gT${n}" x1="0" y1="0" x2="1" y2="1">${st(0, c, W, 45)}${st(1, c, W, 70)}</linearGradient>`;
}).join('');

// Yonish holati selektorlari: hech narsa tanlanmaganda aktiv qavat; tanlansa faqat o'sha qavat.
const tanlov = (n: number) => `:root:has([data-bino-yoq="${n}"]:is(:hover, :focus-visible)) .fi-hero .b-floor[data-floor="${n}"]`;
const tinch = ':root:not(:has([data-bino-yoq]:is(:hover, :focus-visible))) .fi-hero [data-on="true"]';
const ON = (ichki: string) => [tinch, ...KALIT.map((_, i) => tanlov(i + 1))].map((s) => `${s}${ichki}`).join(',\n');
const yonishCss = `
${ON(' .edge')}{stroke:var(--floor-fill)}
${ON(' .on')}{opacity:var(--opacity-100);transition:opacity var(--floor-light-in-duration) var(--floor-light-in-ease) var(--floor-light-in-delay)}
${ON(' .glow')}{opacity:var(--floor-indicator-glow-opacity);transition:opacity var(--floor-light-in-duration) var(--floor-light-in-ease) var(--floor-light-in-delay)}
${ON(' .lab')}{color:var(--color-on-floor);transition:color var(--floor-light-in-duration) var(--floor-light-in-ease) var(--floor-light-in-delay)}
${ON(' .win')}{fill:var(--floor-indicator-window-on);stroke:var(--floor-indicator-window-on);transition:fill var(--floor-light-in-duration) var(--floor-light-in-ease) calc(var(--floor-light-in-delay) + var(--i) * var(--duration-stagger)),stroke var(--floor-light-in-duration) var(--floor-light-in-ease) calc(var(--floor-light-in-delay) + var(--i) * var(--duration-stagger))}
${KALIT.map((k, i) => `:root:has([data-bino-yoq="${i + 1}"]:is(:hover, :focus-visible)) .fi-hero .tip{fill:var(--color-floor-${k}-fill)}`).join('\n')}
`;
---
<svg class:list={['fi-hero', klass]} viewBox="0 0 260 360" aria-hidden="true" focusable="false">
  <defs>
    <Fragment set:html={gradientlar} />
    <filter id="fi-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="14" /></filter>
    <filter id="fi-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" /></filter>
  </defs>
  <polygon class="shadow" filter="url(#fi-soft)" points={soya} />
  {qavatShakli.map((f) => (
    <g class="b-floor" data-floor={f.n} data-on={String(f.n === aktiv)}>
      <polygon class="glow" points={f.sil} filter="url(#fi-blur)" />
      <polygon class="g-t" points={f.top} /><polygon class="g-l" points={f.left} /><polygon class="g-r" points={f.right} />
      <g class="on"><polygon points={f.top} fill={`url(#gT${f.n})`} /><polygon points={f.left} fill={`url(#gL${f.n})`} /><polygon points={f.right} fill={`url(#gR${f.n})`} /></g>
      <polygon class="g-s" points={f.top} /><polygon class="g-s" points={f.left} /><polygon class="g-s" points={f.right} />
      <polyline class="edge" points={f.edge} />
      <g class="on"><polyline class="hl" points={f.hl} /></g>
      <g transform={f.lab} class="lab">
        <text x="0" y="0">{pad(f.n)}</text>
        <svg class="icon" x="25" y="-14" width="18" height="18" viewBox="0 0 24 24" set:html={f.ikonka} />
      </g>
      <g transform={f.win}>
        {[0, 1, 2, 3].map((k) => <rect class="win" style={`--i:${k}`} x={16 + k * 21} y="0" width="12" height="16" rx="1.5" />)}
      </g>
    </g>
  ))}
  <line class="ant" x1={cxm} y1={y5 - b} x2={cxm} y2={y5 - b - 34} />
  <g class="tipg" data-floor={aktiv}><circle class="tip" cx={cxm} cy={y5 - b - 38} r="4" /></g>
</svg>

<style is:global>
  /* ---- DS Stage 1 Foundations · hero isometric glass building (o'zgarishsiz) ---- */
  .fi-hero{width:100%;max-width:var(--size-indicator-hero);height:auto;overflow:visible;display:block}
  .fi-hero--sm{max-width:calc(var(--size-indicator-hero) * 0.6)}
  .fi-hero .shadow{fill:var(--color-indicator-shadow)}
  .fi-hero .g-t{fill:var(--color-indicator-glass-top)}
  .fi-hero .g-l{fill:var(--color-indicator-glass-left)}
  .fi-hero .g-r{fill:var(--color-indicator-glass-right)}
  .fi-hero .g-s{fill:none;stroke:var(--color-indicator-glass-stroke);stroke-width:var(--border-width-1)}
  .fi-hero .edge{fill:none;stroke:var(--floor-ui);stroke-width:var(--floor-indicator-edge-width);stroke-linejoin:round}
  .fi-hero .on{opacity:var(--opacity-0);transition:opacity var(--floor-light-out-duration) var(--floor-light-out-ease)}
  .fi-hero .glow{opacity:var(--opacity-0);fill:var(--floor-fill);transition:opacity var(--floor-light-out-duration) var(--floor-light-out-ease)}
  .fi-hero .hl{fill:none;stroke:var(--floor-indicator-window-on);stroke-width:var(--border-width-1)}
  .fi-hero .lab{color:var(--color-text-secondary);fill:currentColor;font-family:var(--font-family-sans);font-size:var(--text-small-size);font-weight:var(--font-weight-bold);font-variant-numeric:tabular-nums;transition:color var(--floor-light-out-duration) var(--floor-light-out-ease)}
  .fi-hero .lab .icon{stroke:currentColor;fill:none;stroke-width:var(--icon-stroke-width);stroke-linecap:round;stroke-linejoin:round}
  .fi-hero .win{fill:transparent;stroke:var(--color-indicator-window-off);stroke-width:var(--border-width-1);transition:fill var(--floor-light-out-duration) var(--floor-light-out-ease),stroke var(--floor-light-out-duration) var(--floor-light-out-ease)}
  .fi-hero .ant{stroke:var(--color-indicator-window-off);stroke-width:var(--border-width-2)}
  .fi-hero .tip{fill:var(--floor-fill);transition:fill var(--duration-base) var(--ease-state)}
</style>
<style is:inline set:html={yonishCss}></style>
