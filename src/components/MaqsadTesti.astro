---
// Bosh sahifadagi 3 savollik maqsad testi. Hech narsa saqlanmaydi va yuborilmaydi.
// Tavsiya oddiy qoidalarga asoslangan, "taxminiy yo'nalish" deb belgilangan.
// Har tavsiya o'sha qavatga olib boradi (tez-oradagi qavatga ham, Lift kabi: "qavat qurilmoqda" sahifasi).
import { yol } from '../lib/yol';
const havola = (id: string) => yol(`/uz/${id}/`);
const savollar = [
  {
    kalit: 'joy',
    matn: "Qayerda o'qimoqchisiz?",
    variantlar: [
      ['aqsh', 'AQSH'],
      ['uk', 'Buyuk Britaniya yoki Yevropa'],
      ['osiyo', 'Koreya, Xitoy yoki boshqa Osiyo davlati'],
      ['bilmayman', 'Hali bilmayman'],
    ],
  },
  {
    kalit: 'til',
    matn: 'IELTS yoki boshqa til sertifikatingiz bormi?',
    variantlar: [
      ['ha', 'Ha, bor'],
      ['tayyor', 'Tayyorlanyapman'],
      ['yoq', "Hali yo'q"],
    ],
  },
  {
    kalit: 'pul',
    matn: "O'qish uchun moliyaviy yordam kerakmi?",
    variantlar: [
      ['toliq', "Ha, to'liq kerak"],
      ['qisman', 'Qisman kerak'],
      ['yoq', 'Kerak emas'],
    ],
  },
];

const tavsiyalar = [
  { id: 'ielts', nomi: 'IELTS', sabab: "Ko'p universitetlar til sertifikatini so'raydi. Avval shu." },
  { id: 'sat', nomi: 'SAT', sabab: "AQShdagi ba'zi universitetlar SAT natijasini so'raydi yoki inobatga oladi." },
  { id: 'top-admission', nomi: 'Top Admission', sabab: "Universitetlar ro'yxati, hujjatlar va esse." },
  { id: 'eyuf', nomi: 'El-Yurt Umidi', sabab: "Davlat stipendiyasi shartlarini rasmiy manbada ko'rib chiqing." },
];
---
<div class="test" data-maqsad-testi>
  <div aria-live="polite">
    {savollar.map((s, i) => (
      <div class="qadam" data-qadam={i} hidden={i !== 0}>
        <div class="tepa">
          <span class="kichik sust">{i + 1} / {savollar.length} savol</span>
          <div class="progress" aria-hidden="true"><div style={`width:${Math.round(((i + 1) / savollar.length) * 100)}%`}></div></div>
        </div>
        <h2 class="savol" tabindex="-1">{s.matn}</h2>
        <div class="variantlar">
          {s.variantlar.map(([qiymat, matn]) => (
            <button type="button" class="variant" data-kalit={s.kalit} data-qiymat={qiymat}>{matn}</button>
          ))}
        </div>
        {i > 0 && <button type="button" class="orqaga" data-orqaga>Orqaga</button>}
      </div>
    ))}

    <div class="qadam" data-natija hidden>
      <span class="kichik sust">Tavsiya</span>
      <h2 class="savol" tabindex="-1">Shu tartibda boshlashni maslahat beramiz</h2>
      <ol class="tavsiyalar">
        {tavsiyalar.map((t) => (
          <li data-tavsiya={t.id} hidden>
            <a href={havola(t.id)}>
              <span class="raqam" data-raqam></span>
              <span class="tavsiya-matn">
                <strong>{t.nomi}</strong>
                <span>{t.sabab}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="kichik sust">Bu faqat taxminiy yo'nalish. Har bir talabni rasmiy manbada tekshiring.</p>
      <button type="button" class="tugma tugma-ikkinchi" data-qayta>Qaytadan boshlash</button>
    </div>
  </div>
  <noscript><p class="ikkinchi">Test uchun JavaScript kerak. Quyidagi bo'limlardan birini to'g'ridan-to'g'ri tanlashingiz mumkin.</p></noscript>
</div>

<script>
  const ildiz = document.querySelector<HTMLElement>('[data-maqsad-testi]');
  if (ildiz) {
    const qadamlar = [...ildiz.querySelectorAll<HTMLElement>('[data-qadam]')];
    const natija = ildiz.querySelector<HTMLElement>('[data-natija]')!;
    let javoblar: string[] = [];

    const korsat = (n: number) => {
      qadamlar.forEach((q, i) => (q.hidden = i !== n));
      natija.hidden = n < qadamlar.length;
      const faol = n < qadamlar.length ? qadamlar[n] : natija;
      faol.querySelector<HTMLElement>('.savol')?.focus();
    };

    const tavsiyaQur = () => {
      const [joy, til, pul] = javoblar;
      const tartib: string[] = [];
      if (til !== 'ha') tartib.push('ielts');
      if (joy === 'aqsh') tartib.push('sat');
      tartib.push('top-admission');
      if (pul !== 'yoq') tartib.push('eyuf');
      const royxat = natija.querySelector('.tavsiyalar')!;
      natija.querySelectorAll<HTMLElement>('[data-tavsiya]').forEach((li) => (li.hidden = true));
      tartib.forEach((id, i) => {
        const li = natija.querySelector<HTMLElement>(`[data-tavsiya="${id}"]`)!;
        li.hidden = false;
        li.querySelector('[data-raqam]')!.textContent = String(i + 1);
        royxat.appendChild(li);
      });
    };

    ildiz.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const variant = t.closest<HTMLElement>('[data-qiymat]');
      if (variant) {
        const qadam = qadamlar.indexOf(variant.closest<HTMLElement>('[data-qadam]')!);
        javoblar = javoblar.slice(0, qadam).concat(variant.dataset.qiymat!);
        if (qadam + 1 >= qadamlar.length) tavsiyaQur();
        korsat(qadam + 1);
      } else if (t.closest('[data-orqaga]')) {
        const qadam = qadamlar.indexOf(t.closest<HTMLElement>('[data-qadam]')!);
        javoblar = javoblar.slice(0, qadam - 1);
        korsat(qadam - 1);
      } else if (t.closest('[data-qayta]')) {
        javoblar = [];
        korsat(0);
      }
    });
  }
</script>

<style>
  .test {
    background: var(--sirt);
    border: 1.5px solid var(--qora);
    border-radius: var(--r-katta);
    padding: 28px;
  }
  .qadam { display: flex; flex-direction: column; gap: 18px; }
  .qadam[hidden] { display: none; }
  .tepa { display: flex; align-items: center; justify-content: space-between; gap: var(--b-3); }
  .tepa .kichik { white-space: nowrap; }
  .progress { flex: 0 1 220px; height: 8px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); overflow: hidden; }
  .progress div { height: 8px; border-radius: var(--r-toliq); background: var(--rang-asosiy); }
  .savol { font-size: 26px; outline: none; }
  .variantlar { display: flex; flex-direction: column; gap: 10px; }
  .variant {
    font: inherit; font-size: 17px; font-weight: 600; color: var(--matn);
    text-align: left;
    background: var(--sirt);
    border: 2px solid var(--chiziq-kuchli);
    border-radius: var(--r-orta);
    padding: 16px 18px;
    min-height: 56px;
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) { .variant:hover { border-color: var(--rang-asosiy); } }
  .orqaga {
    align-self: flex-start;
    font: inherit; font-size: 15px; font-weight: 600; color: var(--matn-ikkinchi);
    background: transparent; border: none; padding: 10px 0; min-height: 44px; cursor: pointer;
  }
  .tavsiyalar { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tavsiyalar li[hidden] { display: none; }
  .tavsiyalar a {
    display: flex; gap: 14px; align-items: center;
    text-decoration: none; color: var(--matn);
    background: var(--fon-ikkinchi);
    border-radius: var(--r-orta); padding: 16px 18px;
  }
  .raqam {
    width: 36px; height: 36px; flex: none;
    border-radius: var(--r-toliq); background: var(--rang-asosiy); color: var(--rang-asosiy-matn);
    font-weight: 800; display: flex; align-items: center; justify-content: center;
  }
  .tavsiya-matn { display: flex; flex-direction: column; gap: 2px; }
  .tavsiya-matn strong { font-size: 18px; }
  .tavsiya-matn span { font-size: 15px; color: var(--matn-ikkinchi); }
  .tugma { align-self: flex-start; }
</style>
