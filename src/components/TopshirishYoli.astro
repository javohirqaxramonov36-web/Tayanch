---
// 2-qavat mini-DS (ADR 005, PR 7): adm.css tokenlari (.adm doira), muhr o'rnida .adm-tekshirildi.
import '../styles/adm.css';
// "Topshirish yo'li" vositasi. Prototip asosida (branch prototip-topshirish-yoli), freymvorksiz.
// Ma'lumot brauzerga <script type="application/json"> orqali beriladi.
// 3D savol zinapoyasi kodda "savol-zinasi" (saytdagi Zina komponenti boshqa narsa: qavatlar orasidagi o'tish).
// Javoblar faqat localStorage'da (kalit: tayanch-topshirish-yoli). Qabul yoki grant ehtimoli hisoblanmaydi.
import { SAVOLLAR, YOLLAR, NAMUNA, KALIT, IKONKA, ishlatilganManbalar } from '../data/topshirishYoli';

const malumot = { SAVOLLAR, YOLLAR, NAMUNA, KALIT, IKONKA, MANBALAR: ishlatilganManbalar };
const kalitlar = Object.keys(SAVOLLAR) as (keyof typeof SAVOLLAR)[];
---
<div class="ty" data-topshirish-yoli>
  <script type="application/json" id="ty-malumot" set:html={JSON.stringify(malumot)} />

  <header class="ty-bosh">
    <div class="ty-bosh-matn">
      <span class="adm-eyebrow">Top Admission · Vosita</span>
      <h1 class="adm-h1">Topshirish yoʻli</h1>
      <p class="kirish">Uchta savolga javob bering: qaysi davlat, qaysi daraja va grant kerakmi. Sizga mos ariza yoʻllari chiqadi. Kartani aylantirib, rasmiy manbalar va muhim izohlarni koʻring.</p>
      <div class="yorliqlar">
        <span class="pill pill-namuna" id="namuna-yorliq" hidden>Namuna</span>
        <span class="pill">Javoblar faqat shu brauzerda</span>
        <span class="pill">Qabul ehtimoli hisoblanmaydi</span>
      </div>
    </div>
    <div class="sahna" aria-hidden="true">
      <div class="savol-zinasi" id="savol-zinasi">
        <div class="pog p1" data-q="davlat"><div class="old"></div><div class="yon"></div><div class="ust"></div></div>
        <div class="pog p2" data-q="daraja"><div class="old"></div><div class="yon"></div><div class="ust"></div></div>
        <div class="pog p3" data-q="grant"><div class="old"></div><div class="yon"></div><div class="ust"></div></div>
        <div class="bayroq"></div>
      </div>
      <p class="sahna-izoh sanoq" id="sahna-izoh"></p>
    </div>
  </header>

  <section class="savollar" aria-label="Savollar">
    {kalitlar.map((k, i) => (
      <div class="savol" data-savol={k}>
        <div class="savol-bosh"><span class="raqam">{i + 1}</span><h2 class="savol-h">{SAVOLLAR[k].sarlavha}</h2></div>
        <div class="variantlar" role="group" aria-label={SAVOLLAR[k].yorliq}></div>
      </div>
    ))}
  </section>

  <section class="natija">
    <div class="natija-bosh">
      <div class="natija-matn">
        <span class="ustki">Natija</span>
        <h2 id="natija-sarlavha">Sizga mos yoʻllar</h2>
        <p id="natija-izoh" aria-live="polite">Birinchi karta asosiy yoʻl. Kartani bosib aylantiring.</p>
      </div>
      <button class="t-tugma t-tugma--ikkinchi" id="ty-qayta" type="button">Qaytadan boshlash</button>
    </div>
    <div class="yollar" id="yollar"></div>
  </section>
</div>

<script>
  import { yollarniTanla, type Javoblar } from '../lib/yollarniTanla';
  import { muddatHolati } from '../lib/muddat';

  type Fakt = { matn: string; manbaId: string; muddat?: { kun: number; oxir: number }; vaqtli?: boolean };
  type Yol = { id: string; nomi: string; kod: string; ikonka: string; tavsif: string; qadamlar: string[]; faktlar: Fakt[]; tekshirilmagan: string[] };
  type Malumot = {
    SAVOLLAR: Record<string, { variantlar: { id: string; nomi: string; izoh?: string }[] }>;
    YOLLAR: Record<string, Yol>;
    NAMUNA: Required<Javoblar>;
    KALIT: string;
    IKONKA: Record<string, string>;
    MANBALAR: Record<string, { tashkilot: string; havola: string; sana: string }>;
  };

  const ildiz = document.querySelector<HTMLElement>('[data-topshirish-yoli]');
  if (ildiz) {
    const M: Malumot = JSON.parse(document.getElementById('ty-malumot')!.textContent!);
    const KALITLAR = ['davlat', 'daraja', 'grant'] as const;
    let javob: Javoblar = {};
    let namunami = false;
    try {
      const s = JSON.parse(localStorage.getItem(M.KALIT) || 'null');
      if (s && typeof s === 'object') javob = s;
    } catch { /* o'qib bo'lmadi */ }
    // Saqlangan qiymat faqat ma'lum variantlardan bo'lishi mumkin; boshqasi tashlab yuboriladi.
    KALITLAR.forEach((k) => { if (javob[k] && !M.SAVOLLAR[k].variantlar.some((v) => v.id === javob[k])) delete javob[k]; });
    if (!javob.davlat && !javob.daraja && !javob.grant) { javob = { ...M.NAMUNA }; namunami = true; }

    const saqla = () => { try { localStorage.setItem(M.KALIT, JSON.stringify(javob)); } catch { /* saqlanmadi */ } };
    const el = <K extends keyof HTMLElementTagNameMap>(teg: K, sinf?: string | null, matn?: string | null) => {
      const e = document.createElement(teg);
      if (sinf) e.className = sinf;
      if (matn != null) e.textContent = matn;
      return e;
    };
    const svg = (ichi: string) => {
      const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      s.setAttribute('viewBox', '0 0 24 24'); s.setAttribute('fill', 'none'); s.setAttribute('stroke', 'currentColor');
      s.setAttribute('stroke-width', '2'); s.setAttribute('stroke-linecap', 'round'); s.setAttribute('stroke-linejoin', 'round');
      s.setAttribute('aria-hidden', 'true');
      s.innerHTML = ichi;
      return s;
    };

    const savollarniChiz = () => {
      KALITLAR.forEach((k) => {
        const quti = ildiz.querySelector(`[data-savol="${k}"] .variantlar`)!;
        quti.textContent = '';
        M.SAVOLLAR[k].variantlar.forEach((v) => {
          const b = el('button', 'variant');
          b.type = 'button';
          b.id = `v-${k}-${v.id}`;
          b.setAttribute('aria-pressed', javob[k] === v.id ? 'true' : 'false');
          b.append(el('span', null, v.nomi));
          if (v.izoh) b.append(el('small', null, v.izoh));
          b.addEventListener('click', () => { javob[k] = v.id; namunami = false; saqla(); yangila(); document.getElementById(b.id)?.focus(); });
          quti.append(b);
        });
        ildiz.querySelector(`[data-savol="${k}"]`)!.classList.toggle('javobli', !!javob[k]);
      });
    };

    const zinani = () => {
      let soni = 0;
      ildiz.querySelectorAll<HTMLElement>('.pog').forEach((p) => {
        const ok = !!javob[p.dataset.q as keyof Javoblar];
        if (ok) soni++;
        p.classList.toggle('bajarildi', ok);
      });
      document.getElementById('savol-zinasi')!.classList.toggle('tayyor', soni === 3);
      document.getElementById('sahna-izoh')!.textContent = soni === 3 ? "3 / 3 · yo'l tayyor" : `${soni} / 3 savol: davlat, daraja, grant`;
    };

    const kartaChiz = (id: string, birinchi: boolean) => {
      const y = M.YOLLAR[id];
      const muddat = y.faktlar.find((f) => f.muddat)?.muddat;
      const hozir = Date.now();
      const yopiq = !!muddat && hozir >= muddat.oxir;
      const faktlar = yopiq ? y.faktlar.filter((f) => !f.vaqtli) : y.faktlar;

      const k = el('article', 'karta' + (birinchi ? ' asosiy-yol' : ''));
      const ichi = el('div', 'karta-ichi');

      // Old yuz
      const old = el('div', 'yuz old' + (birinchi ? ' qora-kontekst' : ''));
      const tepa = el('div', 'karta-tepa');
      const ik = el('div', 'ikonka');
      ik.append(svg(M.IKONKA[y.ikonka]));
      tepa.append(ik, el('span', 'pill' + (birinchi ? ' kok' : ''), birinchi ? "Asosiy yo'l" : "Qo'shimcha yo'l"));
      old.append(tepa, el('h3', null, y.nomi), el('p', 'tavsif', y.tavsif));
      if (yopiq) old.append(el('p', 'yopiq-xabar', "Bu tanlov yopildi, keyingi e'lonni rasmiy kanalda kuting"));
      old.append(el('span', 'pill pill-umumiy', "Umumiy yo'naltiruvchi qadamlar"));
      const ol = el('ol', 'qadamlar');
      y.qadamlar.forEach((q, n) => {
        const li = el('li');
        li.append(el('span', 'raqamcha', String(n + 1)), el('span', null, q));
        ol.append(li);
      });
      old.append(ol);
      const past = el('div', 'karta-past');
      past.append(el('span', 'meta sanoq',
        muddat && !yopiq ? 'Hujjat qabuli: ' + muddatHolati(hozir, muddat.kun, muddat.oxir) : `${faktlar.length} ta rasmiy fakt · ${y.tekshirilmagan.length} ta tekshirilmagan`));
      const aylan = el('button', 'tugma', "Manbalarni ko'rish");
      aylan.type = 'button';
      aylan.setAttribute('aria-label', `${y.nomi}: manbalarni ko'rish`);
      past.append(aylan);
      old.append(past);

      // Orqa yuz (pasport)
      const orqa = el('div', 'yuz orqa');
      const pasport = el('div', 'pasport-bosh');
      pasport.append(el('h3', null, y.nomi), el('span', 'kod', y.kod));
      orqa.append(pasport);
      if (faktlar.length) {
        orqa.append(el('span', 'orqa-sarlavha', 'Rasmiy manbada'));
        const fl = el('ul', 'faktlar');
        faktlar.forEach((f) => {
          const m = M.MANBALAR[f.manbaId];
          const li = el('li');
          const matn = el('span', 'fakt-matn');
          matn.append(el('span', null, f.matn));
          const a = el('a', null, `${f.manbaId} · ${m.tashkilot}`);
          a.setAttribute('href', m.havola); a.setAttribute('target', '_blank'); a.setAttribute('rel', 'noopener');
          matn.append(a);
          // 2-qavat mini-DS: eski muhr o'rnida AdmTekshirildi belgisi (adm.css .adm-tekshirildi)
          const belgi = el('span', 'adm-tekshirildi');
          belgi.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>';
          const yozuv = el('span');
          yozuv.append(el('span', 'adm-yashirin', 'Rasmiy manbada '), 'Tekshirilgan: ', el('span', 'adm-tekshirildi-sana', m.sana));
          belgi.append(yozuv);
          li.append(matn, belgi);
          fl.append(li);
        });
        orqa.append(fl);
      }
      orqa.append(el('span', 'orqa-sarlavha', 'Muhim izohlar'));
      const yl = el('ul', 'yoq');
      y.tekshirilmagan.forEach((t) => yl.append(el('li', null, t)));
      orqa.append(yl);
      const qayt = el('button', 'tugma qayt-tugma', 'Orqaga');
      qayt.setAttribute('aria-label', `${y.nomi}: orqaga`);
      qayt.type = 'button';
      orqa.append(qayt);

      const ayl = (ochiq: boolean) => {
        // Orqa yuz absolute: balandlik max(old, orqa); orqa chegarasi ham qo'shiladi, matn kesilmasin.
        ichi.style.minHeight = ochiq ? Math.max(old.offsetHeight, orqa.scrollHeight + (orqa.offsetHeight - orqa.clientHeight) + 2) + 'px' : '';
        k.classList.toggle('ochiq', ochiq);
        old.setAttribute('aria-hidden', ochiq ? 'true' : 'false');
        orqa.setAttribute('aria-hidden', ochiq ? 'false' : 'true');
        old.inert = ochiq;
        orqa.inert = !ochiq;
        (ochiq ? qayt : aylan).focus({ preventScroll: true });
      };
      orqa.setAttribute('aria-hidden', 'true');
      orqa.inert = true;
      aylan.addEventListener('click', () => ayl(true));
      qayt.addEventListener('click', () => ayl(false));

      ichi.append(old, orqa);
      k.append(ichi);
      return k;
    };

    const natijaniChiz = () => {
      const quti = document.getElementById('yollar')!;
      quti.textContent = '';
      const toliq = javob.davlat && javob.daraja && javob.grant;
      const izoh = document.getElementById('natija-izoh')!;
      if (!toliq) {
        const qolgan = KALITLAR.filter((k) => !javob[k]).length;
        quti.append(el('div', 'bosh-xabar', `Yana ${qolgan} ta savolga javob bering, yo'llar shu yerda chiqadi.`));
        izoh.textContent = 'Uchala savolga javob berilgach natija chiqadi.';
        return;
      }
      izoh.textContent = namunami
        ? "Namuna: AQSH, bakalavriat, to'liq grant. O'z javoblaringizni tanlang. Kartani bosib aylantiring."
        : "Birinchi karta asosiy yo'l. Kartani bosib aylantiring.";
      yollarniTanla(javob).forEach((id, i) => quti.append(kartaChiz(id, i === 0)));
    };

    const yangila = () => {
      savollarniChiz(); zinani(); natijaniChiz();
      (document.getElementById('namuna-yorliq') as HTMLElement).hidden = !namunami;
    };

    document.getElementById('ty-qayta')!.addEventListener('click', () => {
      javob = {}; namunami = false;
      try { localStorage.removeItem(M.KALIT); } catch { /* ruxsat yo'q */ }
      yangila();
      const tezmi = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      ildiz.querySelector('.savollar')!.scrollIntoView({ behavior: tezmi ? 'auto' : 'smooth', block: 'start' });
    });

    yangila();
  }
</script>

<style>
  /* Prototip uslublari, ranglar tokens.css dan (yorug' va qorong'i mavzu) */
  .ty { display: grid; gap: var(--space-14); }
  .ty h1, .ty h2, .ty h3 { text-wrap: balance; margin: 0; font-weight: var(--font-weight-extrabold); }
  .ty h1 { font-size: var(--text-adm-h1-size); line-height: var(--text-adm-h1-lh); letter-spacing: var(--text-adm-hero-ls); }
  .ty h2 { font-size: clamp(1.625rem, 4vw, 2rem); line-height: 1.2; }
  .ty .savol-h, .ty :global(h3) { font-size: var(--text-h3-size); line-height: 1.25; }
  .ustki { font-size: var(--text-adm-eyebrow-size); line-height: var(--text-adm-eyebrow-lh); font-weight: var(--font-weight-semibold); letter-spacing: var(--text-adm-eyebrow-ls); text-transform: uppercase; color: var(--color-adm-text-muted); }
  .ty :global(.pill) { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); background: var(--color-adm-chip); color: var(--color-adm-text); }
  .ty :global(.pill.kok) { background: var(--color-adm-accent-subtle); color: var(--color-link); }
  .ty :global(.pill-namuna) { background: var(--color-adm-bg); border: 1.5px dashed var(--color-adm-text-muted); color: var(--color-adm-text-muted); padding: var(--space-1) var(--space-3); }
  .ty :global(.pill[hidden]) { display: none; }

  /* Bosh qism */
  .ty-bosh { display: grid; grid-template-columns: 1.1fr .9fr; gap: var(--space-10); align-items: center; }
  .ty-bosh-matn { display: grid; gap: var(--space-4); min-width: 0; }
  .kirish { font-size: var(--text-h3-size); color: var(--color-adm-text-muted); max-width: 52ch; }
  .yorliqlar { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  /* 3D savol zinapoyasi */
  .sahna { perspective: 900px; display: grid; place-items: center; gap: var(--space-1); min-height: 280px; }
  .savol-zinasi { position: relative; width: 300px; height: 220px; transform-style: preserve-3d; transform: rotateX(58deg) rotateZ(-38deg); transition: transform var(--duration-base) var(--harakat-egri); }
  @media (hover: hover) and (pointer: fine) { .sahna:hover .savol-zinasi { transform: rotateX(54deg) rotateZ(-30deg); } }
  .pog { position: absolute; width: 92px; height: 92px; transform-style: preserve-3d; }
  .pog .ust, .pog .old, .pog .yon { position: absolute; }
  .pog .ust { inset: 0; background: var(--color-adm-bg); border: 1.5px solid var(--color-adm-text); border-radius: var(--radius-sm); transform: translateZ(var(--h)); transition: transform var(--duration-base) var(--harakat-egri); }
  .pog .old { left: 0; bottom: 0; width: 92px; height: var(--h); background: var(--color-adm-chip); border: 1.5px solid var(--color-adm-text); transform-origin: bottom; transform: rotateX(-90deg); }
  .pog .yon { right: 0; top: 0; width: var(--h); height: 92px; background: var(--color-adm-line-strong); border: 1.5px solid var(--color-adm-text); transform-origin: right; transform: rotateY(90deg); }
  .pog.bajarildi .ust { background: var(--color-adm-accent-text); border-color: var(--floor-ui-toq); }
  .pog.bajarildi .old { background: var(--floor-ui-toq); }
  .pog.bajarildi .yon { background: var(--floor-ui-chuqur); }
  .p1 { left: 0; top: 128px; --h: 28px; }
  .p2 { left: 104px; top: 64px; --h: 56px; }
  .p3 { left: 208px; top: 0; --h: 84px; }
  .bayroq { position: absolute; left: 254px; top: 46px; width: 2px; height: 0; background: var(--color-adm-text); transform-origin: bottom; transform: translateZ(84px) rotateX(-90deg); }
  .bayroq::after { content: ""; position: absolute; top: 0; left: 2px; width: 22px; height: 14px; background: var(--color-adm-accent-text); clip-path: polygon(0 0, 100% 50%, 0 100%); opacity: 0; transition: opacity var(--duration-base) var(--harakat-egri) var(--duration-base); }
  .savol-zinasi.tayyor .bayroq { height: 48px; }
  .savol-zinasi.tayyor .bayroq::after { opacity: 1; }
  .sahna-izoh { font-size: var(--text-small-size); font-weight: var(--font-weight-medium); color: var(--color-adm-text-muted); text-align: center; }

  /* Savollar */
  .savollar { display: grid; gap: var(--space-4); }
  .savol { border: 1.5px solid var(--color-adm-text); border-radius: var(--radius-lg); padding: var(--space-6); display: grid; gap: var(--space-4); background: var(--color-adm-bg); }
  .savol-bosh { display: flex; align-items: baseline; gap: var(--space-3); flex-wrap: wrap; }
  .raqam { width: 32px; height: 32px; flex: none; border-radius: var(--radius-full); display: grid; place-items: center; font-weight: var(--font-weight-extrabold); font-size: var(--text-small-size); background: var(--color-adm-chip); }
  .savol.javobli .raqam { background: var(--color-adm-accent-text); color: var(--color-adm-on-accent-text); }
  .variantlar { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-2); }
  .variantlar :global(.variant) {
    min-height: 56px; padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); border: 2px solid var(--color-adm-line-strong);
    background: var(--color-adm-bg); font: inherit; font-weight: var(--font-weight-bold); color: var(--color-adm-text); text-align: left; cursor: pointer;
    display: grid; gap: var(--space-1); transition: transform var(--harakat-tez) var(--harakat-egri);
  }
  .variantlar :global(.variant small) { font-weight: var(--font-weight-medium); font-size: var(--text-caption-size); color: var(--color-adm-text-muted); line-height: 1.35; }
  @media (hover: hover) and (pointer: fine) { .variantlar :global(.variant:hover) { border-color: var(--color-adm-accent-text); transform: var(--kotarilish); } }
  .variantlar :global(.variant[aria-pressed="true"]) { border-color: var(--color-adm-accent-text); background: var(--color-adm-accent-subtle); }
  .variantlar :global(.variant[aria-pressed="true"] small) { color: var(--color-link); }

  /* Natija */
  .natija { display: grid; gap: var(--space-6); }
  .natija-bosh { display: flex; justify-content: space-between; align-items: end; gap: var(--space-4); flex-wrap: wrap; }
  .natija-matn { display: grid; gap: var(--space-2); }
  .natija-bosh p { color: var(--color-adm-text-muted); max-width: 60ch; }
  .yollar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); perspective: 1400px; }
  .yollar :global(.bosh-xabar) { grid-column: 1 / -1; border: 1.5px dashed var(--color-adm-line-strong); border-radius: var(--radius-lg); padding: var(--space-8); text-align: center; color: var(--color-adm-text-muted); }

  /* 3D aylanadigan karta */
  .yollar :global(.karta) { min-width: 0; transform-style: preserve-3d; }
  .yollar :global(.karta-ichi) { display: grid; position: relative; transform-style: preserve-3d; transition: transform var(--duration-base) var(--harakat-egri); }
  .yollar :global(.karta.ochiq .karta-ichi) { transform: rotateY(180deg); }
  .yollar :global(.yuz) {
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border: 1.5px solid var(--color-adm-text); border-radius: var(--radius-lg); background: var(--color-adm-bg);
    padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;
  }
  .yollar :global(.yuz.old) { transition: transform var(--harakat-tez) var(--harakat-egri); }
  @media (hover: hover) and (pointer: fine) { .yollar :global(.karta:not(.ochiq):hover .yuz.old) { box-shadow: 6px 6px 0 var(--color-adm-text); } }
  /* Orqa yuz: pasport sahifasi (tekis sirt) */
  .yollar :global(.yuz.orqa) {
    transform: rotateY(180deg); position: absolute; inset: 0; overflow: auto;
    background-color: var(--color-adm-sunken);
    /* DS taqiqi: dekorativ gradient yo'q (katak foni olib tashlandi), pasport sahifasi tekis sirtda */
  }
  .yollar :global(.pasport-bosh) { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); border-bottom: 1.5px solid var(--color-adm-text); padding-bottom: var(--space-2); }
  .yollar :global(.kod) { font-size: var(--text-caption-size); font-weight: var(--font-weight-extrabold); letter-spacing: .06em; color: var(--color-link); white-space: nowrap; }
  .yollar :global(.karta.asosiy-yol .yuz.old) { background: var(--color-adm-ink); color: var(--color-adm-cream); border-color: var(--color-neutral-800); }
