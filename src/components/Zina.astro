---
// Zina: qavat kirish sahifasi pastida qo'shni qavatlarga havola.
// 1-qavatda faqat yuqoriga, 5-qavatda faqat pastga.
import { qavatlar, joriyQavat } from '../data/qavatlar';
import { yol } from '../lib/yol';
import { matn, yolTili } from '../data/umumiyMatn';

const n = joriyQavat(Astro.url.pathname);
const M = matn[yolTili(Astro.url.pathname)];
const past = qavatlar[n - 2];
const yuqori = qavatlar[n];
const kartalar = [
  past && { q: past, yon: 'past' as const },
  yuqori && { q: yuqori, yon: 'yuqori' as const },
].filter(Boolean) as { q: (typeof qavatlar)[number]; yon: 'past' | 'yuqori' }[];
---
<nav class="zina" aria-label={M.zina.nomi}>
  {kartalar.map(({ q, yon }) => (
    <a class={`ds-karta zina-karta zina-${yon}`} data-floor={q.raqam} href={yol(q.manzil)}>
      <span class="z-yorliq">
        {yon === 'past'
          ? <svg class="ds-karta-belgi" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          : <svg class="ds-karta-belgi" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6" /></svg>}
        {yon === 'past' ? M.zina.past : M.zina.yuqori} · {M.qavat(q.raqam)}
      </span>
      <span class="z-nom">{M.qavat(q.raqam)}: {q.nomi}</span>
      {q.holat === 'tez-orada' && <span class="z-pill">{M.zina.qurilmoqda}</span>}
      {(q.slug === 'sat' || q.slug === 'ielts') && <span class="z-pill" lang="en">Beta</span>}
    </a>
  ))}
</nav>

<style>
  .zina { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--b-4); }
  /* DS link karta (global .ds-karta), urg'u borilayotgan qavatdan */
  .zina-karta {
    padding: var(--b-5) var(--b-6); min-height: 96px;
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--b-1);
  }
  .zina-yuqori { grid-column: 2; align-items: flex-end; text-align: right; }
  .zina-past { grid-column: 1; }
  .z-yorliq { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rang-havola); }
  .z-nom { font-size: 20px; font-weight: 800; }
  .z-pill { padding: 3px 10px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); color: var(--matn-ikkinchi); font-size: 12px; font-weight: 700; }
  @media (max-width: 640px) {
    .zina { grid-template-columns: 1fr; }
    .zina-yuqori, .zina-past { grid-column: 1; }
    .zina-yuqori { order: -1; }
    .z-nom { font-size: 18px; }
  }
</style>
