---
import Belgi from './Belgi.astro';

const holatlar = [
  { nom: 'Javob berilgan', css: 'javob', belgi: 'belgilandi' },
  { nom: 'Javobsiz', css: 'bosh' },
  { nom: 'Bayroq qo‘yilgan', css: 'bayroq', belgi: 'bayroq' },
  { nom: 'Joriy savol', css: 'joriy' },
] as const;

interface Props {
  savollar: readonly ('javob' | 'bosh' | 'bayroq' | 'joriy')[];
}
const { savollar } = Astro.props;
const joriy = savollar.indexOf('joriy') + 1;
---
<nav class="ielts-yuza ielts-oqim" aria-labelledby="savol-yoli">
  <div class="ielts-satr ielts-satr-oraliq">
    <h2 class="ielts-kichik-sarlavha" id="savol-yoli">Savollar xaritasi</h2>
    <p class="ielts-izoh">{savollar.filter((holat) => holat === 'javob').length} / {savollar.length} javob berilgan</p>
  </div>
  <div class="savol-kataklar">
    {savollar.map((qiymat, i) => {
      const holat = holatlar.find((item) => item.css === qiymat)!;
      return (
        <a
          class:list={['savol-katak', holat.css]}
          href={`#savol-${i + 1}`}
          aria-current={qiymat === 'joriy' ? 'true' : undefined}
          aria-label={`${i + 1}-savol, ${holat.nom.toLowerCase()}`}
        >
          {i + 1}
          {'belgi' in holat && <Belgi nom={holat.belgi} />}
        </a>
      );
    })}
  </div>
  <ul class="savol-izohlar">
    {holatlar.map((holat) => (
      <li>
        <span class:list={['savol-izoh-belgi', holat.css]} aria-hidden="true">
          {'belgi' in holat && <Belgi nom={holat.belgi} />}
        </span>
        {holat.nom}
      </li>
    ))}
  </ul>
  <div class="ielts-amallar">
    <a class="tugma tugma-ikkinchi" href={`#savol-${joriy - 1}`}><Belgi nom="orqa" /> Oldingi</a>
    <a class="tugma tugma-ikkinchi" href={`#savol-${joriy + 1}`}>Keyingi <Belgi nom="oldinga" /></a>
  </div>
</nav>

<style>
  .savol-kataklar, .savol-izohlar { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .savol-katak {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: var(--size-qcell);
    min-block-size: var(--size-qcell);
    border-radius: var(--radius-md);
    font-size: var(--text-small-size);
    font-weight: var(--text-button-weight);
    text-decoration: none;
  }
  .savol-katak:hover { text-decoration: underline; }
  .savol-katak, .savol-izoh-belgi { border: var(--border-width-1) solid var(--qcell-border); }
  .javob { background: var(--qcell-answered-bg); border-color: var(--qcell-answered-border); }
  .bayroq { background: var(--review-on-bg); border-color: var(--qcell-flag); }
  .joriy { background: var(--qcell-current-bg); color: var(--qcell-current-text); border-color: var(--qcell-current-bg); }
  .savol-katak :global(.ielts-belgi) {
    position: absolute;
    inset-block-start: var(--border-width-2);
    inset-inline-end: var(--border-width-2);
    inline-size: var(--space-3);
    block-size: var(--space-3);
  }
  .savol-izohlar { gap: var(--space-2) var(--space-4); list-style: none; margin: 0; padding: 0; }
  .savol-izohlar li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-caption-size);
    color: var(--color-text-secondary);
  }
  .savol-izoh-belgi {
    display: grid;
    place-items: center;
    inline-size: var(--space-4);
    block-size: var(--space-4);
    border-radius: var(--radius-sm);
  }
  .savol-izoh-belgi :global(.ielts-belgi) { inline-size: var(--space-3); block-size: var(--space-3); }
</style>
