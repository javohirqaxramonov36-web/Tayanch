---
import Belgi from './Belgi.astro';

interface Props {
  modul: 'reading' | 'listening';
}
const { modul } = Astro.props;
const reading = modul === 'reading';
const joriy = 3;
const javoblar = reading ? ['True', 'False'] : ['Sample answer A', 'Sample answer B'];
---
<section class="ielts-yuza ielts-oqim" id="savollar" aria-labelledby="savollar-sarlavha" tabindex="-1">
  <div class="ielts-satr ielts-satr-oraliq">
    <h2 class="ielts-kichik-sarlavha" id="savollar-sarlavha">Savollar</h2>
    <span class="yorliq" lang="en">{reading ? 'True / False / Not Given' : 'Note completion'}</span>
  </div>
  <ol class="ielts-qatorlar savollar-royxat">
    {Array.from({ length: 8 }, (_, i) => i + 1).map((raqam) => (
      <li id={`savol-${raqam}`} tabindex="-1" class:list={{ 'joriy-savol': raqam === joriy }}>
        <div class="ielts-satr ielts-satr-oraliq">
          <h3 class="savol-nomi">{raqam}-savol</h3>
          {raqam <= javoblar.length && (
            <span class="savol-holati ielts-izoh"><Belgi nom="belgilandi" /> <span lang="en">{javoblar[raqam - 1]}</span></span>
          )}
          {raqam === joriy && <span class="yorliq">Joriy</span>}
          {raqam === 5 && <span class="savol-holati ielts-izoh"><Belgi nom="bayroq" /> Bayroq qo‘yilgan</span>}
        </div>
        {raqam === joriy && (reading ? (
          <fieldset class="variantlar" disabled lang="en">
            <legend>Sample statement appears here.</legend>
            {['True', 'False', 'Not Given'].map((nom) => (
              <label class="variant">
                <input type="radio" name="reading-namuna" />
                {nom}
              </label>
            ))}
          </fieldset>
        ) : (
          <div class="ielts-oqim" lang="en">
            <label for="listening-javob">Write the missing word in the sample note.</label>
            <input class="ielts-maydon" id="listening-javob" type="text" placeholder="Your answer" readonly />
          </div>
        ))}
      </li>
    ))}
  </ol>
</section>

<style>
  .savollar-royxat li { display: grid; gap: var(--space-3); padding-block: var(--space-2); }
  .savollar-royxat .joriy-savol { padding-block: var(--space-3); }
  .savollar-royxat li:target { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
  .savol-nomi { font-size: var(--text-small-size); line-height: var(--text-small-lh); }
  .savol-holati { display: flex; align-items: center; gap: var(--space-1); }
  .savol-holati :global(.ielts-belgi) { inline-size: var(--size-icon-sm); block-size: var(--size-icon-sm); }
  .variantlar { display: grid; gap: var(--space-2); min-inline-size: 0; padding: 0; margin: 0; border: 0; }
  .variantlar legend { padding: 0 0 var(--space-2); }
  .variant {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    min-block-size: var(--control-height-md);
    border: var(--border-width-2) solid var(--color-text-secondary);
    border-radius: var(--control-radius);
    background: var(--answer-bg);
  }
  .variant input { margin: 0; inline-size: var(--size-icon-sm); block-size: var(--size-icon-sm); }
</style>
