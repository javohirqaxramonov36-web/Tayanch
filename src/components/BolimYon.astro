---
// Bo'lim yon paneli (sidebar): SAT yoki IELTS.
// >= 1024px: chapda doimiy panel, yig'ish tugmasi bilan (holat localStorage "tayanch:sidebar").
// < 1024px: ustki qatordagi hamburger tugmasi panelni chapdan chiqaradi.
//   Esc yopadi, fokus panel ichida aylanadi, qolgan sahifa inert bo'ladi, aria-expanded yangilanadi.
// Dizayn: Tayanch-SAT-dizayn.md va Tayanch-IELTS-dizayn.md.
import { satGuruhlar } from '../data/satSahifalar';
import { qollanmalar, asos, vositalar } from '../data/ieltsSahifalar';
import Lift from './Lift.astro';
import { yol } from '../lib/yol';

import type { BolimSlug } from '../data/bolimlar';

// Top Admission va EYUF: yon paneli hali qurilmagan, shuning uchun faqat logo, "bo'limi haqida" va Lift.
interface Props { bolim?: BolimSlug }
const { bolim = 'sat' } = Astro.props;
const NOMLAR: Record<BolimSlug, string> = { sat: 'SAT', ielts: 'IELTS', 'top-admission': 'Top Admission', eyuf: 'EYUF' };
const NOM = NOMLAR[bolim];
const joriy = Astro.url.pathname;
const b = (qism: string) => yol(`/uz/${bolim}/${qism}`);
// SAT ikonkalari (Tayanch-SAT-dizayn.md, Main ekrani). Qo'llanmalar ikonkasiz, chapdan surilgan.
const ikonkalar: Record<string, string> = {
  'mashq/test/': '<path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  'mashq/bank/': '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/>',
  'vosita/natijalar/': '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  'vosita/reja/': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 15l2 2 4-4"/>',
  'qollanma/math/hajm/': '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/>',
  'qollanma/math/grafik/': '<path d="M3 3v18h18"/><path d="M6 17C9 5 13 5 18 9"/>',
  'qollanma/math/birlik-aylana/': '<circle cx="12" cy="12" r="9"/><path d="M12 12l6.4-6.4M12 12h9"/>',
  'qollanma/math/statistika/': '<path d="M3 20h18"/><circle cx="6" cy="16" r="1.5"/><circle cx="10" cy="16" r="1.5"/><circle cx="10" cy="12" r="1.5"/><circle cx="14" cy="16" r="1.5"/><circle cx="18" cy="16" r="1.5"/><path d="M11 4v16"/>',
  'qollanma/reading-writing/xatoni-toping/': '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/>',
  'qollanma/reading-writing/dalil/': '<path d="M4 6h16M4 18h12"/><rect x="3" y="10" width="14" height="4" rx="1"/>',
  'qollanma/reading-writing/otish-sozlari/': '<path d="M3 12h14"/><path d="M13 6l6 6-6 6"/><path d="M3 6h5M3 18h5"/>',
  'qollanma/reading-writing/lugat-kontekstda/': '<path d="M4 4h12a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z"/><path d="M8 9h7M8 13h5"/>',
  'mashq/kitoblar/': '<path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z"/>',
  'mashq/lugat/': '<rect x="3" y="6" width="14" height="14" rx="2"/><path d="M7 3h12a2 2 0 0 1 2 2v12"/>',
};
const joriymi = (href: string) => joriy === href || joriy === href.replace(/\/$/, '');
const ieltsGuruhlar = [
  { nomi: "Qo'llanmalar", bandlar: [...qollanmalar, asos] },
  { nomi: 'Vositalar', bandlar: vositalar },
];
---
<header class="ustki-qator" data-bolim={bolim}>
  <a class="logo" href={b('')}>
    <span class="logo-belgi" aria-hidden="true">T</span>
    <span class="logo-nom">Tayanch <span class="logo-bolim">{NOM}</span></span>
  </a>
  <button
    type="button"
    class="belgi-tugma"
    id="panel-ochish"
    aria-controls="bolim-yon"
    aria-expanded="false"
    aria-label="Menyuni ochish"
  >
    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
  </button>
</header>

<div class="parda" id="panel-parda" aria-hidden="true"></div>

<aside class="yon" id="bolim-yon" aria-label={`${NOM} bo'limi`} data-bolim={bolim}>
  <div class="yon-bosh">
    <a class="logo" href={b('')}>
      <span class="logo-belgi" aria-hidden="true">T</span>
      <span class="logo-nom yon-matn">Tayanch <span class="logo-bolim">{NOM}</span></span>
    </a>
    <button
      type="button"
      class="belgi-tugma faqat-katta"
      id="yon-yigish"
      aria-controls="bolim-yon-nav"
      aria-expanded="true"
      aria-label="Yon panelni yig'ish"
      title="Yon panelni yig'ish"
    >
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /><path class="yigish-strelka" d="M15 10l-2 2 2 2" /></svg>
    </button>
    <button type="button" class="belgi-tugma faqat-kichik" id="panel-yopish" aria-label="Menyuni yopish">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <Lift variant="yon" />

  <nav class="yon-nav yon-matn" id="bolim-yon-nav" aria-label={`${NOM} navigatsiyasi`}>
    <ul class="royxat">
      <li>
        <a href={b('')} aria-current={joriymi(b('')) ? 'page' : undefined}>
          <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /></svg>
          {NOM} bo'limi haqida
        </a>
      </li>
    </ul>
    {bolim === 'sat' && satGuruhlar.map((g, i) => (
      <div class="guruh">
        <h2 class="guruh-nom" id={`yon-guruh-${i}`}>{g.nomi}</h2>
        <ul class="royxat" aria-labelledby={`yon-guruh-${i}`}>
          {g.sahifalar.map((s) => (
            <li>
              <a href={b(s.qism)} class={ikonkalar[s.qism] ? '' : 'ikonkasiz'} aria-current={joriymi(b(s.qism)) ? 'page' : undefined}>
                {ikonkalar[s.qism] && (
                  <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ikonkalar[s.qism]} />
                )}
                {s.nomi}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {bolim === 'ielts' && ieltsGuruhlar.map((g, i) => (
      <div class="guruh">
        <h2 class="guruh-nom" id={`yon-guruh-${i}`}>{g.nomi}</h2>
        <ul class="royxat" aria-labelledby={`yon-guruh-${i}`}>
          {g.bandlar.map((s) => (
            <li>
              {s.qism ? (
                <a href={b(s.qism)} aria-current={joriymi(b(s.qism)) ? 'page' : undefined}>
                  <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.ikonka} />
                  {s.nomi}
                </a>
              ) : (
                <p class="nofaol">
                  <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.ikonka} />
                  <span class="nofaol-nom">{s.nomi}</span>
                  <span class="yorliq-tez">tez orada</span>
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <div class="yon-past">
    {bolim === 'ielts' && (
      <p class="past-tugma past-nofaol" title="Telegram kanal: tez orada">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z" /></svg>
        <span class="yon-matn nofaol-nom">Telegram kanal</span>
        <span class="yon-matn yorliq-tez">tez orada</span>
      </p>
    )}
    <button type="button" class="past-tugma" id="mavzu-tugma" aria-pressed="false" title="Qorong'i mavzu">
      <svg class="oy" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="quyosh" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <span class="yon-matn">Qorong'i mavzu</span>
    </button>
  </div>
</aside>

<script>
  const KALIT_PREFIKS = 'tayanch:';
  const d = document.documentElement;
  const kattaEkran = window.matchMedia('(min-width: 1024px)');

  const oqi = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const yoz = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* saqlab bo'lmadi */ } };

  // --- Mavzu ---
  const mavzuTugma = document.getElementById('mavzu-tugma') as HTMLButtonElement;
  const tizimQorongi = window.matchMedia('(prefers-color-scheme: dark)');
  const mavzuQoy = (m: 'yorug' | 'qorongi') => {
    d.setAttribute('data-mavzu', m);
    mavzuTugma.setAttribute('aria-pressed', String(m === 'qorongi'));
  };
  mavzuQoy(d.getAttribute('data-mavzu') === 'qorongi' ? 'qorongi' : 'yorug');
  mavzuTugma.addEventListener('click', () => {
    const yangi = d.getAttribute('data-mavzu') === 'qorongi' ? 'yorug' : 'qorongi';
    mavzuQoy(yangi);
    yoz(KALIT_PREFIKS + 'mavzu', yangi);
  });
  // Tanlov saqlanmagan bo'lsa, tizim mavzusi o'zgarishini kuzatamiz.
  tizimQorongi.addEventListener('change', (e) => {
    const t = oqi(KALIT_PREFIKS + 'mavzu');
    if (t !== 'yorug' && t !== 'qorongi') mavzuQoy(e.matches ? 'qorongi' : 'yorug');
  });

  // --- Yig'ish (katta ekran) ---
  const yigish = document.getElementById('yon-yigish') as HTMLButtonElement;
  const yigishQoy = (yigilgan: boolean) => {
    if (yigilgan) d.setAttribute('data-sidebar', 'yigilgan');
    else d.removeAttribute('data-sidebar');
    yigish.setAttribute('aria-expanded', String(!yigilgan));
    const yozuv = yigilgan ? 'Yon panelni yoyish' : "Yon panelni yig'ish";
    yigish.setAttribute('aria-label', yozuv);
    yigish.title = yozuv;
  };
  yigishQoy(d.getAttribute('data-sidebar') === 'yigilgan');
  yigish.addEventListener('click', () => {
    const yigilgan = d.getAttribute('data-sidebar') !== 'yigilgan';
    yigishQoy(yigilgan);
    yoz(KALIT_PREFIKS + 'sidebar', yigilgan ? 'yigilgan' : 'ochiq');
  });

  // --- Chiqib keladigan panel (kichik ekran) ---
  const panel = document.getElementById('bolim-yon') as HTMLElement;
  const ochish = document.getElementById('panel-ochish') as HTMLButtonElement;
  const yopish = document.getElementById('panel-yopish') as HTMLButtonElement;
  const parda = document.getElementById('panel-parda') as HTMLElement;
  const tashqari = () => Array.from(document.querySelectorAll<HTMLElement>('[data-panel-tashqari]'));
  const fokuslanadigan = () =>
    Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
      .filter((el) => el.offsetParent !== null);

  let ochiq = false;
  const panelQoy = (holat: boolean, fokusQaytar = true) => {
    ochiq = holat;
    d.toggleAttribute('data-panel-ochiq', holat);
    ochish.setAttribute('aria-expanded', String(holat));
    tashqari().forEach((el) => { el.inert = holat; });
    if (holat) {
      yopish.focus();
    } else if (fokusQaytar) {
      ochish.focus();
    }
  };
  ochish.addEventListener('click', () => panelQoy(true));
  yopish.addEventListener('click', () => panelQoy(false));
  parda.addEventListener('click', () => panelQoy(false));

  document.addEventListener('keydown', (e) => {
    if (!ochiq || kattaEkran.matches) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      panelQoy(false);
    } else if (e.key === 'Tab') {
      const el = fokuslanadigan();
      if (el.length === 0) return;
      const birinchi = el[0];
      const oxirgi = el[el.length - 1];
      const faol = document.activeElement as HTMLElement | null;
      if (!faol || !panel.contains(faol)) {
        e.preventDefault();
        birinchi.focus();
      } else if (e.shiftKey && faol === birinchi) {
        e.preventDefault();
        oxirgi.focus();
      } else if (!e.shiftKey && faol === oxirgi) {
        e.preventDefault();
        birinchi.focus();
      }
    }
  });
  // Ekran kattalashsa, ochiq panel holatini tozalaymiz.
  kattaEkran.addEventListener('change', (e) => { if (e.matches && ochiq) panelQoy(false, false); });

</script>

<style>
  /* Dizayn: Tayanch-SAT-dizayn.md (Main va Telefon ekranlari) */

  /* Ustki qator: faqat kichik ekranda */
  .ustki-qator {
    position: sticky; top: 0; z-index: 20;
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--b-3);
    padding: 0 var(--b-3) 0 var(--b-4);
    background: var(--fon);
    border-bottom: 1px solid var(--chiziq);
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; min-height: 44px; color: var(--matn); }
  .logo-belgi {
    flex: none;
    width: 36px; height: 36px; border-radius: var(--r-logo);
    background: var(--matn); color: var(--fon);
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 18px;
  }
  .ustki-qator .logo-belgi { width: 34px; height: 34px; font-size: 17px; }
  .logo-nom { font-weight: 800; font-size: 18px; white-space: nowrap; }
  .ustki-qator .logo-nom { font-size: 17px; }
  .logo-bolim { color: var(--rang-havola); }

  .belgi-tugma {
    flex: none;
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    border: none; border-radius: var(--r-yon);
    background: transparent; color: var(--matn-sust);
    cursor: pointer;
  }
  .belgi-tugma:hover { background: var(--fon-ikkinchi); color: var(--matn); }
  #panel-ochish { background: var(--fon-ikkinchi); color: var(--matn); }
  #panel-ochish:hover { background: var(--sirt-ikkinchi); }

  /* Panel */
  .yon {
    background: var(--fon);
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .yon-bosh {
    flex: none;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--b-2);
    padding: var(--b-5) var(--b-4) var(--b-2);
  }
  .yon-nav {
    flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
    padding: var(--b-4) var(--b-4) var(--b-4);
    display: flex; flex-direction: column; gap: var(--b-5);
  }
  .guruh { display: flex; flex-direction: column; }
  .guruh-nom {
    margin: 0 0 var(--b-2) var(--b-3);
    font-size: 12px; font-weight: 700; line-height: 1.4;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--matn-sust);
  }
  .royxat { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--b-1); }
  .royxat a {
    display: flex; align-items: center; gap: var(--b-3);
    min-height: 44px;
    padding: 0 var(--b-3);
    border-radius: var(--r-yon);
    color: var(--matn);
    text-decoration: none;
    font-weight: 600; font-size: 15px;
  }
  .royxat a.ikonkasiz { padding-left: 44px; min-height: 40px; }
  .royxat a .ikonka { flex: none; color: var(--rang-havola); }
  .royxat a:hover { background: var(--fon-ikkinchi); }
  .royxat a[aria-current='page'] { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); font-weight: 700; }
  .royxat a[aria-current='page'] .ikonka { color: var(--rang-asosiy-matn); }

  .yon-past {
    flex: none;
    margin: 0 var(--b-4);
    border-top: 1px solid var(--chiziq);
    padding: var(--b-4) 0 var(--b-5);
    display: flex; flex-direction: column; gap: var(--b-1);
  }
  .past-tugma {
    display: flex; align-items: center; gap: var(--b-3);
    width: 100%; min-height: 44px;
    padding: 0 var(--b-3);
    border: none; border-radius: var(--r-yon);
    background: transparent; color: var(--matn-ikkinchi);
    font: inherit; font-size: 14px; font-weight: 600; text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  #mavzu-tugma { background: var(--fon-ikkinchi); color: var(--matn); }
  .past-tugma svg { flex: none; width: 18px; height: 18px; }
  .past-tugma:hover { background: var(--fon-ikkinchi); color: var(--matn); }
  #mavzu-tugma:hover { background: var(--sirt-ikkinchi); }
  .past-tugma .quyosh { display: none; }
  :global([data-mavzu='qorongi']) .past-tugma .oy { display: none; }
  :global([data-mavzu='qorongi']) .past-tugma .quyosh { display: block; }

  /* IELTS: Tayanch-IELTS-dizayn.md (qator 48px, radius 16, 16px, logo radiusi 6) */
  .yon[data-bolim='ielts'] .royxat a, .nofaol {
    min-height: 48px; border-radius: var(--r-orta); font-size: 16px; font-weight: 700;
  }
  .yon[data-bolim='ielts'] .guruh-nom { font-size: var(--matn-mayda); color: var(--matn-ikkinchi); }
  [data-bolim='ielts'] .logo-belgi { border-radius: var(--r-kichik); font-weight: 800; }
  .yon[data-bolim='ielts'] .past-tugma { min-height: 48px; border-radius: var(--r-orta); font-weight: 500; }
  .nofaol {
    min-height: 44px;
    margin: 0; display: flex; align-items: center; gap: var(--b-3);
    padding: 0 var(--b-3); color: var(--matn-ikkinchi); font-weight: 500;
  }
  .nofaol .ikonka, .past-nofaol svg { color: var(--matn-sust); }
  .nofaol-nom { flex: 1; }
  .yorliq-tez {
    padding: 4px 12px; border-radius: var(--r-toliq);
    background: var(--sirt-ikkinchi); color: var(--matn-ikkinchi);
    font-size: var(--matn-mayda); font-weight: 700; white-space: nowrap;
  }
  .past-nofaol { margin: 0; cursor: default; }
  .past-nofaol:hover { background: transparent; color: var(--matn-ikkinchi); }

  .parda { display: none; }

  /* Kichik ekran: chiqib keladigan panel */
  @media (max-width: 1023.98px) {
    .faqat-katta { display: none; }
    .yon {
      position: fixed; z-index: 40; inset: 0 auto 0 0;
      width: min(320px, 86vw);
      height: 100dvh;
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform 0.22s ease, visibility 0s linear 0.22s;
      box-shadow: var(--soya);
    }
    .yon-bosh { padding-top: var(--b-3); }
    :global([data-panel-ochiq]) .yon {
      transform: none; visibility: visible;
      transition: transform 0.22s ease;
    }
    .parda {
      display: block;
      position: fixed; inset: 0; z-index: 30;
      background: var(--parda);
      opacity: 0; pointer-events: none;
      transition: opacity 0.22s ease;
    }
    :global([data-panel-ochiq]) .parda { opacity: 1; pointer-events: auto; }
    :global(html[data-panel-ochiq]) { overflow: hidden; }
  }

  /* Katta ekran: doimiy panel */
  @media (min-width: 1024px) {
    .ustki-qator, .faqat-kichik { display: none; }
    .yon {
      position: sticky; top: 0;
      height: 100vh;
      border-right: 1px solid var(--chiziq);
    }
    :global([data-sidebar='yigilgan']) .yon-matn { display: none; }
    :global([data-sidebar='yigilgan']) .yon-bosh {
      flex-direction: column; padding-inline: var(--b-3); gap: var(--b-3);
    }
    :global([data-sidebar='yigilgan']) .yon-past { margin-inline: var(--b-3); }
    :global([data-sidebar='yigilgan']) .past-tugma { justify-content: center; padding-inline: 0; }
    :global([data-sidebar='yigilgan']) .yigish-strelka { transform: rotate(180deg); transform-origin: 14px 12px; }
  }

</style>
