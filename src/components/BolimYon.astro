---
import { kursHavola, kursOchiq } from '../lib/sat/kursKatalog';
// Bo'lim yon paneli (sidebar): SAT, IELTS yoki Top Admission (maket "LiftSidebar").
// >= 768px: bo‘limlar ustki qatorda, joriy bo‘lim menyusi o‘ngda ochiladi.
// < 768px: bo‘limlar sarlavha ostidagi chiplarda (BolimChiplar), hamburgerda faqat joriy bo‘lim sahifalari (2026-11-27).
//   Esc yopadi, fokus panel ichida aylanadi, qolgan sahifa inert bo'ladi, aria-expanded yangilanadi.
// Dizayn: Tayanch-SAT-dizayn.md va Tayanch-IELTS-dizayn.md.
import { satYonGuruhlar } from '../data/satSahifalar';
import { ieltsGuruhlar } from '../data/ieltsSahifalar';
import { taGuruhlar } from '../data/topAdmissionSahifalar';
import { eyufGuruhlar } from '../data/eyufSahifalar';
import QavatMenyu from './navigator/QavatMenyu.astro';
import BolimChiplar from './navigator/BolimChiplar.astro';
import KirishDialog from './hisob/KirishDialog.astro';
import HeaderAmallar from './HeaderAmallar.astro';
import Suhbatdosh from './Suhbatdosh.astro';
import TayanchLogo from './TayanchLogo.astro';
import { yol } from '../lib/yol';
import { joriyQavat, qavatI } from '../data/qavatlar';
import { manbalar } from '../data/manbalar';
import { bolimTili, matn } from '../data/umumiyMatn';
import { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } from 'astro:env/client';

import type { BolimSlug } from '../data/bolimlar';

// EYUF va AI Academy: yon paneli hali qurilmagan, shuning uchun faqat logo, "bo'limi haqida" va qavatlar ro'yxati.
// 2026-11-21 (muallif qarori): yon panelda faqat joriy bo'lim sahifalari. Boshqa bo'limlar ustki qatordagi
// "bolim-menyu" da (bosh sahifada uning o'rnida QavatMenyu). Umumiy havolalar (Muddatlar, Manbalar...) faqat 1-qavat panelida.
interface Props { bolim?: BolimSlug; qm?: boolean }
const joriy = Astro.url.pathname;
const { slug } = qavatI(joriyQavat(joriy));
const bolim = Astro.props.bolim ?? (slug === 'navigator' ? undefined : slug);
const NOMLAR: Record<BolimSlug, string> = { sat: 'SAT', ielts: 'IELTS', 'top-admission': 'Top Admission', eyuf: 'EYUF', 'ai-academy': 'AI Academy' };
const NOM = bolim ? NOMLAR[bolim] : 'Tayanch';
const TIL = bolimTili(bolim ?? 'umumiy');
const M = matn[TIL].yon;
const joriyRaqam = joriyQavat(joriy);
// Ko'rinadigan logo nomi: SAT yonida ® (CB08, belgi har sahifada bir marta). aria-label'larda belgisiz.
const LOGO_NOM = bolim === 'sat' ? 'SAT®' : bolim && bolim !== 'eyuf' && bolim !== 'ai-academy' ? NOM : '';
const b = (qism: string) => yol(bolim ? `/uz/${bolim}/${qism}` : '/uz/');
const umumiy = [
  { path: '/uz/', uz: 'Bosh sahifa', en: 'Home' },
  { path: '/uz/#qavatlar', uz: "Yoʻnalishlar", en: 'Directions' },
  { path: '/uz/deadline/', uz: 'Muddatlar', en: 'Deadlines' },
  { path: '/uz/manbalar/', uz: 'Manbalar', en: 'Sources' },
  { path: '/uz/yol-tanlash/?boshlash=1', uz: 'Boshlash', en: 'Get started' },
];
// SAT ikonkalari (Tayanch-SAT-dizayn.md, Main ekrani). Yon paneldagi har sahifada ikonka bor (tayyor bo'lmaganlari yon panelda yo'q).
const ikonkalar: Record<string, string> = {
  'mashq/test/': '<path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  'mashq/bank/': '<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/>',
  'vosita/natijalar/': '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  'vosita/rasmiy-testlar/': '<path d="M9 4h6v3H9z"/><path d="M15 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/><path d="M8 17l3-3 2 2 3-4"/>',
  'vosita/reja/': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 15l2 2 4-4"/>',
  'qollanma/math/hajm/': '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/>',
  'qollanma/math/grafik/': '<path d="M3 3v18h18"/><path d="M6 17C9 5 13 5 18 9"/>',
  'qollanma/math/birlik-aylana/': '<circle cx="12" cy="12" r="9"/><path d="M12 12l6.4-6.4M12 12h9"/>',
  'qollanma/math/statistika/': '<path d="M3 20h18"/><circle cx="6" cy="16" r="1.5"/><circle cx="10" cy="16" r="1.5"/><circle cx="10" cy="12" r="1.5"/><circle cx="14" cy="16" r="1.5"/><circle cx="18" cy="16" r="1.5"/><path d="M11 4v16"/>',
  'qollanma/reading-writing/xatoni-toping/': '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/>',
  'qollanma/reading-writing/dalil/': '<path d="M4 6h16M4 18h12"/><rect x="3" y="10" width="14" height="4" rx="1"/>',
  'qollanma/reading-writing/otish-sozlari/': '<path d="M3 12h14"/><path d="M13 6l6 6-6 6"/><path d="M3 6h5M3 18h5"/>',
  'qollanma/reading-writing/lugat-kontekstda/': '<path d="M4 4h12a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z"/><path d="M8 9h7M8 13h5"/>',
  'mashq/kitoblar/': '<path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z"/>',
  'vosita/takrorlash/': '<path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/>',
  'hisob/obuna/': '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>',
  'qollanma/qayerdan-boshlash/': '<circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h7a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h7"/>',
  'mashq/lugat/': '<rect x="3" y="6" width="14" height="14" rx="2"/><path d="M7 3h12a2 2 0 0 1 2 2v12"/>',
  // 2026-11-13 (yon panel 5 band): ilgari ikonkasiz qolgan tayyor sahifalar.
  'mashq/mock/': '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M9 2h6"/>',
  'qollanma/reading-writing/': '<path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z"/><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"/>',
  'vosita/ai-tutor/': '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
  'hisob/maqsad/': '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  'guruh/': '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5a3 3 0 0 1 0 6"/><path d="M21 20a6 6 0 0 0-4-5.6"/>',
  'hisob/fikr/': '<path d="M4 4h16v12H8l-4 4z"/>',
  'hisob/profil/': '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
};
// SAT: College Board rasmiy saytiga tashqi havola (CB07). Manba yo'q bo'lsa build to'xtaydi.
const cbSayt = bolim === 'sat' ? manbalar.find((m) => m.id === 'CB07') : undefined;
if (bolim === 'sat' && !cbSayt) throw new Error("BolimYon: manbalar.ts da CB07 (College Board SAT sahifasi) topilmadi");
const cbNom = `College Board ${M.rasmiySayt} ${M.yangiTab}`;
// Hisob bandi: hamma qavat yon panelida, bitta 1-qavat hisobiga (/uz/hisob/) olib boradi.
// ?keyin= bilan: kirgandan keyin shu sahifaga qaytadi. Faqat Supabase sozlangan build'da chiqadi;
// kirgan/kirmagan holatni src/lib/hisobHolat.ts yangilaydi.
const hisobBand = Boolean(PUBLIC_SUPABASE_URL && PUBLIC_SUPABASE_ANON_KEY);
const hisobKirish = `${yol('/uz/hisob/kirish/')}?keyin=${encodeURIComponent(joriy)}`;
const hisobProfil = yol('/uz/hisob/profil/');
const joriymi = (href: string) => joriy === href || joriy === href.replace(/\/$/, '');

---
<header class="ustki-qator nav-shisha" data-bolim={bolim} lang={TIL}>
  <a class="logo" href={yol('/')}>
    <TayanchLogo />

  </a>
  <div class="desktop-nav"><QavatMenyu /></div>
  <HeaderAmallar>
  <button type="button" class="mavzu-tugma" id="mavzu-tugma" aria-label={M.mavzu} aria-pressed="false" title={M.mavzu}>
    <span class="mavzu-belgi mavzu-quyosh" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </span>
    <span class="mavzu-belgi mavzu-oy" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
    </span>
  </button>
  </HeaderAmallar>
  <details class="yon-orami" name="tayanch-navigatsiya">
    <summary class="belgi-tugma" id="panel-ochish" role="button" aria-expanded="false" aria-controls="bolim-yon" aria-label={M.navigatsiya(NOM)}>
    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </summary>
    <div class="yon nav-shisha" id="bolim-yon" data-bolim={bolim}>
      <div class="yon-bosh">
  <a class="logo" href={yol('/uz/')}>
    <TayanchLogo />
    {LOGO_NOM && <span class="logo-bolim">{LOGO_NOM}</span>}
  </a>
    <button type="button" class="belgi-tugma" id="panel-yopish" hidden aria-label={M.menyuYopish}>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
      </div>
  <nav class="yon-nav yon-matn" id="bolim-yon-nav" aria-label={M.navigatsiya(NOM)}>
    {bolim && <ul class="royxat">
      <li>
        <a href={b('')} aria-current={joriymi(b('')) ? 'page' : undefined}>
          <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /></svg>
          {bolim === 'top-admission' ? "Boʻlim haqida" : bolim === 'sat' ? 'Today' : M.haqida(NOM)}
        </a>
      </li>
      {bolim === 'sat' && kursOchiq && <li><a href={kursHavola()} aria-current={joriymi(kursHavola()) ? 'page' : undefined}>
        <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4zM8 9h8M8 13h6"/></svg>
        Math course
      </a></li>}
    </ul>}
    {bolim === 'sat' && satYonGuruhlar.map((g, i) => (
      <div class="guruh">
        <h2 class="guruh-nom" id={`yon-guruh-${i}`}>{g.nomi}</h2>
        {g.qismlar.map((q, j) => (
          <>
            {q.nomi && <h3 class="qism-nom" id={`yon-guruh-${i}-${j}`}>{q.nomi}</h3>}
            <ul class="royxat" aria-labelledby={q.nomi ? `yon-guruh-${i} yon-guruh-${i}-${j}` : `yon-guruh-${i}`}>
              {q.sahifalar.map((t) => (
                <li>
                  {g.tezOrada ? (
                    <p class="nofaol">
                      <span class="nofaol-nom">{t.nomi}</span>
                      <span class="yorliq-tez">{M.tezOrada}</span>
                    </p>
                  ) : (
                    <a href={b(t.qism)} aria-current={joriymi(b(t.qism)) ? 'page' : undefined}>
                      <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ikonkalar[t.qism]} />
                      {t.nomi}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </>
        ))}
      </div>
    ))}
    {bolim === 'ielts' && ieltsGuruhlar.map((g, i) => (
      <div class="guruh">
        <h2 class="guruh-nom" id={`yon-guruh-${i}`}>{g.nomi}</h2>
        <ul class="royxat" aria-labelledby={`yon-guruh-${i}`}>
          {g.bandlar.map((s) => (
            <li>
              {s.qism ? (
                <a href={b(s.qism)} aria-current={joriymi(b(s.qism)) ? 'page' : undefined}>
                  <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.ikonka} />
                  {s.nomi}
                </a>
              ) : (
                <p class="nofaol">
                  <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.ikonka} />
                  <span class="nofaol-nom">{s.nomi}</span>
                  <span class="yorliq-tez">tez orada</span>
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
    {(bolim === 'top-admission' ? taGuruhlar : bolim === 'eyuf' ? eyufGuruhlar : []).map((g, i) => (
      <div class="guruh">
        <h2 class="guruh-nom" id={`yon-guruh-${i}`}>{g.nomi}</h2>
        <ul class="royxat" aria-labelledby={`yon-guruh-${i}`}>
          {g.bandlar.map((s) => (
            <li>
              {s.href ? (
                <a href={yol(`/uz/${s.href}`)} aria-current={joriymi(yol(`/uz/${s.href}`)) ? 'page' : undefined}>{s.nomi}</a>
              ) : (
                <p class="nofaol">
                  <span class="nofaol-nom">{s.nomi}</span>
                  <span class="yorliq-tez">tez orada</span>
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
    {!bolim && <ul class="royxat">
      {umumiy.map(({ path, uz }) => <li>
        <a href={yol(path)} aria-current={joriymi(yol(path)) ? 'page' : undefined}>{uz}</a>
      </li>)}
    </ul>}
    <ul class="royxat">
      <Suhbatdosh qavat={joriyRaqam} inglizcha={TIL === 'en'} variant="qavatlar" />
    </ul>
  </nav>

  <div class="yon-past">
    {bolim === 'sat' && !joriymi(b('hisob/obuna/')) && (
      // Doimiy "Upgrade to Pro" bandi: faqat kirgan va Free tarifdagi foydalanuvchiga (src/lib/sat/upgradeBandUlash.ts).
      <ul class="royxat tashqi upgrade-band" aria-label="Plan" data-upgrade-band hidden>
        <li>
          <a href={b('hisob/obuna/')} data-upgrade-havola>
            <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5" /><path d="M6 11l6-6 6 6" /></svg>
            <span class="yon-matn tashqi-matn">
              <span data-upgrade-nom>Upgrade</span>
              <span class="tashqi-izoh" data-upgrade-izoh>Compare plans</span>
            </span>
          </a>
        </li>
      </ul>
    )}
    {hisobBand && (
      <ul class="royxat tashqi hisob-band" aria-label={M.hisob}>
        <li>
          <a
            href={hisobKirish} id="hisob-band" data-hisob-havola
            data-kirish={hisobKirish} data-profil={hisobProfil}
            data-matn-kirish={M.hisobKirish} data-matn-kirgan={M.hisobim} data-izoh-kirish={M.hisobIzoh}
            aria-label={M.hisobKirish} title={M.hisobKirish}
          >
            <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
            <span class="yon-matn tashqi-matn">
              <span data-hisob-nom>{M.hisobKirish}</span>
              <span class="tashqi-izoh" data-hisob-izoh>{M.hisobIzoh}</span>
            </span>
          </a>
        </li>
      </ul>
    )}
    {cbSayt && (
      <ul class="royxat tashqi" aria-label={M.tashqi}>
        <li>
          <a href={cbSayt.havola} target="_blank" rel="noopener noreferrer" aria-label={cbNom} title={cbNom}>
            <svg class="ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6" /><path d="M20 4l-9 9" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
            <span class="yon-matn tashqi-matn">
              <span>College Board</span>
              <span class="tashqi-izoh">{M.rasmiySayt}</span>
            </span>
            <span class="ekranda-yoq">{M.yangiTab}</span>
          </a>
        </li>
      </ul>
    )}
    {bolim === 'ielts' && (
      <p class="past-tugma past-nofaol" title="Telegram kanal: tez orada">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z" /></svg>
        <span class="yon-matn nofaol-nom">Telegram kanal</span>
        <span class="yon-matn yorliq-tez">tez orada</span>
      </p>
    )}
  </div>
    </div>
  </details>
  <BolimChiplar />

</header>
<KirishDialog />

<script>
  const KALIT_PREFIKS = 'tayanch:';
  const d = document.documentElement;

  const oqi = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const yoz = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* saqlab bo'lmadi */ } };

  // --- Mavzu ---
  const mavzuTugma = document.getElementById('mavzu-tugma') as HTMLButtonElement;
  const desktop = matchMedia('(min-width: 768px)');
  const kengHeader = matchMedia('(min-width: 1024px)');
  const mavzuJoyla = () => {
    const joy = kengHeader.matches ? document.querySelector('[data-header-amallar]') : document.querySelector('.yon-past');
    joy?.prepend(mavzuTugma);
  };
  mavzuJoyla();
  kengHeader.addEventListener('change', mavzuJoyla);
  const tizimQorongi = window.matchMedia('(prefers-color-scheme: dark)');
  const mavzuQoy = (m: 'yorug' | 'qorongi') => {
    d.setAttribute('data-mavzu', m);
    mavzuTugma.setAttribute('aria-pressed', String(m === 'qorongi'));
  };
  mavzuQoy(d.getAttribute('data-mavzu') === 'qorongi' ? 'qorongi' : 'yorug');
  mavzuTugma.addEventListener('click', () => {
    const yangi = d.getAttribute('data-mavzu') === 'qorongi' ? 'yorug' : 'qorongi';
    mavzuQoy(yangi);
    yoz(KALIT_PREFIKS + 'mavzu', yangi);
  });
  // Tanlov saqlanmagan bo'lsa, tizim mavzusi o'zgarishini kuzatamiz.
  tizimQorongi.addEventListener('change', (e) => {
    const t = oqi(KALIT_PREFIKS + 'mavzu');
    if (t !== 'yorug' && t !== 'qorongi') mavzuQoy(e.matches ? 'qorongi' : 'yorug');
  });

  const ochiqPanel = () => d.querySelector<HTMLDetailsElement>('.ustki-qator details[open]');
  const yopish = document.getElementById('panel-yopish') as HTMLButtonElement;
  const panelniYop = (panel: HTMLDetailsElement) => {
    panel.open = false;
    if (!desktop.matches) panel.querySelector('summary')?.focus({ preventScroll: true });
  };

  yopish.hidden = false;
  yopish.addEventListener('click', () => {
    const panel = yopish.closest('details');
    if (panel) panelniYop(panel);
  });
  const menyuDetails = document.querySelector<HTMLDetailsElement>('.yon-orami')!;
  menyuDetails.addEventListener('toggle', () => { document.getElementById('panel-ochish')?.setAttribute('aria-expanded', String(menyuDetails.open)); });
  const ustki = document.querySelector<HTMLElement>('header.ustki-qator')!;
  ustki.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || event.defaultPrevented) return;
    if (event.target instanceof Element && event.target.closest('dialog[open]')) return;
    const panel = ochiqPanel();
    if (!panel) return;
    event.preventDefault();
    panelniYop(panel);
  });
  d.addEventListener('click', (event) => {
    const panel = ochiqPanel();
    if (!panel || !(event.target instanceof Element)) return;
    if (!panel.contains(event.target)) panel.open = false;
    else if (event.target.closest('a[href]')) panelniYop(panel);
  });
  ustki.addEventListener('focusout', (event) => {
    const panel = ochiqPanel();
    if (panel && event.relatedTarget instanceof Node && !panel.contains(event.relatedTarget)) panel.open = false;
  });
</script>

