---
// Interaktiv dars qolipi (barcha bo'limlar). Standart: docs/interaktiv-dars-standarti.md.
// Tuzilish: Maqsad → laboratoriya (sahna + 1 Animatsiya / 2 Formula / 3 Sinab ko'r) → Mashqlar → Xulosa va Xato daftari → Manbalar.
// Saqlash: tayanch:<bolim>-dars-progress, tayanch:<bolim>-xato-daftari (faqat shu brauzer).
// Sahna komponenti "dars:qadam" hodisasini tinglaydi (detail.qadam: 'animatsiya' | 'formula' | 'sinab').
import BolimQobiq from '../../layouts/BolimQobiq.astro';
import ManbaBlok from '../ManbaBlok.astro';
import QavatlarAro from '../QavatlarAro.astro';
import { darsQavatlarAro } from '../../data/qavatlarAro';
import type { DarsBolim, DarsSavol } from '../../data/darsTurlar';
import { tinishmi } from '../../lib/belgilashGuruh';
import { bolimTili, matn } from '../../data/umumiyMatn';

interface Props {
  bolim: DarsBolim;
  modul: string;
  savollar: DarsSavol[];
  /** Qavat yo'lidagi oraliq bandlar, masalan ['Math darslari'] */
  yolBandlari: string[];
  /** Sarlavha ustidagi yorliq, masalan 'Math darsi' */
  darsTuri: string;
  /** "rasmiy <imtihon> savoli emas" yozuvi uchun, masalan 'SAT'. Bo'lmasa "rasmiy savol emas". */
  imtihon?: string;
  /** manbalar.ts dagi ID lar */
  manbalar: string[];
  tekshirilgan: string;
  keyingiTekshiruv: string;
  title: string;
  description: string;
  /** Rasmiy manbadagi yo'nalish nomi (SAT: CB05) */
  yonalish: string;
  sarlavha: string;
  lead: string;
  maqsadlar: string[];
  xulosa: string[];
  /** href to'liq manzil, sahifada yol() bilan yasaladi. turi 'qadam': dars emas (vosita, mashq), "Keyingi qadam" deb yoziladi */
  keyingi?: { nomi: string; href: string; turi?: 'dars' | 'qadam' };
  tekshirilmagan: string[];
  /** Laboratoriya qadamlari nomi. Bo'lmasa: Animatsiya, Formula, Sinab ko'r (R&W: Misol, Qoida, Sinab ko'r) */
  qadamNomlari?: [string, string, string];
  /** Ixtiyoriy: savol matni va variantlar tili (R&W: 'en'). Bo'lmasa sahifa tili. */
  savolTili?: string;
  /** Ixtiyoriy: oddiy A–D savolda matn ustidagi ko'rsatma (o'zbekcha), masalan "Bo'sh joyga mos so'zni tanlang." */
  savolKorsatma?: string;
  /** Ixtiyoriy: bo'limning takrorlash sahifasi (yol() bilan), Xato daftari blokida havola bo'lib chiqadi */
  takrorlashHref?: string;
}

const {
  bolim, modul, savollar, yolBandlari, darsTuri, imtihon, manbalar, tekshirilgan, keyingiTekshiruv,
  title, description, yonalish, sarlavha, lead, maqsadlar, xulosa, keyingi, tekshirilmagan,
  savolTili, savolKorsatma, takrorlashHref,
} = Astro.props;
// Qolip matni bo'lim tilida (SAT: inglizcha). Lug'at: src/data/umumiyMatn.ts
const til = bolimTili(bolim);
const M = matn[til].dars;
const qadamNomlari = Astro.props.qadamNomlari ?? M.qadamNomlari;
const HARF = 'ABCD';
const qadamlar = [
  { id: 'animatsiya', nomi: qadamNomlari[0] },
  { id: 'formula', nomi: qadamNomlari[1] },
  { id: 'sinab', nomi: qadamNomlari[2] },
];
---
<BolimQobiq
  title={title}
  description={description}
  turi="qollanma"
  yol={yolBandlari}
  bolim={bolim}
  holat="qoralama"
>
  <div class="ichki dars" data-modul={modul} data-savol-tili={savolTili}>
    <header class="bosh">
      <p class="pill-qator">
        <span class="ustki-kok">{darsTuri}</span>
        <span class="pill">{yonalish}</span>
        <span class="pill pill-chiziq">{M.qoralama}</span>
      </p>
      <h1>{sarlavha}</h1>
      <p class="lead">{lead}</p>
    </header>

    <section class="maqsad" aria-labelledby="maqsad-h">
      <div class="maqsad-matn">
        <h2 id="maqsad-h" class="kichik-h">{M.maqsad}</h2>
        <ul>{maqsadlar.map((m) => <li>{m}</li>)}</ul>
      </div>
      <div class="maqsad-progress">
        <p class="kichik"><span id="progress-son">0</span> / {savollar.length} {M.progress}</p>
        <div class="progress" aria-hidden="true"><span id="progress-chiziq"></span></div>
      </div>
    </section>

    <section class="lab" aria-labelledby="lab-h">
      <h2 id="lab-h" class="sr">{M.laboratoriya}</h2>
      <div class="lab-ichki">
        <div class="lab-sahna"><slot name="sahna" /></div>
        <div class="lab-panel">
          <div class="qadamlar" role="tablist" aria-label={M.qadamlar}>
            {qadamlar.map((q, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${q.id}`}
                aria-controls={`panel-${q.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-qadam={q.id}
              ><span class="q-raqam" aria-hidden="true">{i + 1}</span>{q.nomi}</button>
            ))}
          </div>
          <div class="panel" role="tabpanel" id="panel-animatsiya" aria-labelledby="tab-animatsiya" tabindex="0"><slot name="animatsiya" /></div>
          <div class="panel" role="tabpanel" id="panel-formula" aria-labelledby="tab-formula" tabindex="0" hidden><slot name="formula" /></div>
          <div class="panel" role="tabpanel" id="panel-sinab" aria-labelledby="tab-sinab" tabindex="0" hidden><slot name="sinab" /></div>
        </div>
      </div>
    </section>

    <section class="mashqlar" aria-labelledby="mashq-h" id="mashqlar">
      <div class="m-bosh">
        <h2 id="mashq-h">{M.mashqlar}</h2>
        <p class="kichik ikkinchi">{M.mashqIzoh(imtihon)}</p>
      </div>

      <nav class="savol-nuqtalar" aria-label={M.mashqRoyxati}>
        {savollar.map((s, i) => (
          <button type="button" class="nuqta" data-i={i} aria-label={M.mashq(i + 1)}>{i + 1}</button>
        ))}
      </nav>

      <div class="savol-karta">
        {savollar.map((s, i) => (
          <fieldset class="savol" data-i={i} data-id={s.id} hidden={i !== 0}>
            <legend class="sr">{M.mashq(i + 1)}</legend>
            <p class="s-meta">
              <span class="pill">{M.namuna}</span>
              <span class="pill">{M.qiyinlik[s.qiyinlik]}</span>
              <span class="kichik ikkinchi">{s.mavzu}</span>
              {!s.verified && <span class="pill pill-ogoh">{M.tekshirilmagan}</span>}
            </p>
            {s.belgilash?.tur === 'soz' ? (
              <>
                <p class="s-matn s-korsatma">{M.sozKorsatma}</p>
                <div class="bolaklar soz-bolaklar" role="group" aria-label={M.sozGuruh} lang="en">
                  {s.belgilash.bolaklar.map((b, k) => (
                    <button type="button" class:list={['bolak', { 'bolak-tinish': tinishmi(b) }]} data-bolak={k} aria-pressed="false">{b}</button>
                  ))}
                </div>
                <p class="joy-holat" aria-live="polite"></p>
              </>
            ) : (
              <>
                {savolKorsatma && !s.belgilash && <p class="s-korsatma">{savolKorsatma}</p>}
                {s.parcha && (
                  <div class="parcha s-parcha" lang={savolTili}>
                    {s.parcha.split('\n\n').map((x) => <p>{x}</p>)}
                  </div>
                )}
                <p class="s-matn" lang={s.belgilash ? undefined : savolTili}>{s.matn}</p>
              </>
            )}
            {s.belgilash?.tur === 'gap' ? (
              <div class="parcha">
                <p class="kichik ikkinchi parcha-sarlavha">{s.belgilash.sarlavha ?? M.gapSarlavha}</p>
                <div class="bolaklar gap-bolaklar" role="group" aria-label={M.gapGuruh} lang="en">
                  {s.variantlar.map((v, k) => (
                    <button type="button" class="bolak gap" data-bolak={k} aria-pressed="false">
                      <span class="gap-matn">{v.matn}</span>
                      <span class="gap-yorliq" lang={til === 'uz' ? 'uz' : undefined} hidden></span>
                    </button>
                  ))}
                </div>
              </div>
            ) : (
              <div class="variantlar" hidden={s.belgilash?.tur === 'soz'}>
                {s.belgilash?.tur === 'soz' && <p class="s-korsatma">{M.tuzatishKorsatma}</p>}
                {s.variantlar.map((v, j) => (
                  <label class="variant">
                    <input type="radio" name={`v-${s.id}`} value={j} />
                    <span class="harf" aria-hidden="true">{HARF[j]}</span>
                    <span class="v-matn" lang={s.belgilash ? 'en' : savolTili}>{v.matn}</span>
                  </label>
                ))}
              </div>
            )}
            <div class="izoh" aria-live="polite" hidden>
              <p class="izoh-sarlavha"></p>
              <p class="izoh-xato"></p>
              <p class="izoh-yechim"><b>{M.yechim}</b> {s.yechim}</p>
            </div>
            <div class="s-tugmalar">
              {s.belgilash?.tur === 'soz' && <button type="button" class="katta asosiy joy-tekshir" disabled>{M.joyTekshirish}</button>}
              <button type="button" class="katta asosiy tekshir" disabled hidden={s.belgilash?.tur === 'soz'}>{M.tekshirish}</button>
              <button type="button" class="katta ikkinchi qayta" hidden>{M.qaytaYechish}</button>
              <button type="button" class="katta qora keyingi" hidden>{i < savollar.length - 1 ? M.keyingiMashq : M.xulosagaOtish}</button>
            </div>
          </fieldset>
        ))}
      </div>
    </section>

    <section class="xulosa" aria-labelledby="xulosa-h" id="xulosa">
      <h2 id="xulosa-h">{M.xulosa}</h2>
      <ul class="xulosa-royxat">{xulosa.map((x) => <li>{x}</li>)}</ul>
      {Astro.slots.has('xulosa-oxiri') && <slot name="xulosa-oxiri" />}

      <section class="daftar" aria-labelledby="daftar-h">
        <div class="daftar-bosh">
          <h3 id="daftar-h">{M.daftar}</h3>
          <p class="kichik ikkinchi">{M.daftarIzoh}</p>
        </div>
        <p class="daftar-bosh-holat" id="daftar-bosh">{M.daftarBosh}</p>
        <ul class="daftar-royxat" id="daftar-royxat"></ul>
        {takrorlashHref && (
          <p class="daftar-takror"><a class="kok-tugma" href={takrorlashHref}>{M.takrorlash}</a></p>
        )}
        <div class="daftar-tozala">
          <button type="button" class="matn-tugma" id="tozala">{M.tozala}</button>
          <span class="tasdiq" id="tasdiq" hidden>
            {M.tasdiq}
            <button type="button" class="matn-tugma" id="tasdiq-ha">{M.tasdiqHa}</button>
            <button type="button" class="matn-tugma" id="tasdiq-yoq">{M.tasdiqYoq}</button>
          </span>
        </div>
        <p class="kichik ikkinchi" id="saqlash-holat">{M.saqlash}</p>
      </section>

      {keyingi && (
        <a class="katta asosiy keyingi-dars" href={keyingi.href}>{keyingi.turi === 'qadam' ? M.keyingiQadam(keyingi.nomi) : M.keyingiDars(keyingi.nomi)}</a>
      )}
      <QavatlarAro kartalar={darsQavatlarAro[modul] ?? []} daraja="h3" />
    </section>

    <ManbaBlok
      manbalar={manbalar}
      tekshirilgan={tekshirilgan}
      keyingiTekshiruv={keyingiTekshiruv}
      tekshirilmagan={tekshirilmagan}
    />
  </div>

  <script type="application/json" id="dars-data" set:html={JSON.stringify({ bolim, modul, savollar })} />
</BolimQobiq>

<script>
  import type { DarsSavol, DarsBolim } from '../../data/darsTurlar';
  import { javobniYoz, progressniOqi, xatolarniOqi, modulniTozala } from '../../lib/darsSaqlash';
  import { belgilashGuruhi, type Guruh } from '../../lib/belgilashGuruh';
  import { matn } from '../../data/umumiyMatn';
  const M = matn[document.documentElement.lang === 'en' ? 'en' : 'uz'].dars;

  const data = JSON.parse(document.getElementById('dars-data')!.textContent || '{}') as { bolim: DarsBolim; modul: string; savollar: DarsSavol[] };
  const { bolim, modul, savollar } = data;
  const ildiz = document.querySelector<HTMLElement>('.dars')!;

  // ---------- Qadamlar (tablist) ----------
  const tablar = [...document.querySelectorAll<HTMLButtonElement>('.qadamlar [role="tab"]')];
  const tanlaTab = (t: HTMLButtonElement, fokus = false) => {
    tablar.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
    if (fokus) t.focus();
    document.dispatchEvent(new CustomEvent('dars:qadam', { detail: { qadam: t.dataset.qadam } }));
  };
  tablar.forEach((t, i) => {
    t.addEventListener('click', () => tanlaTab(t));
    t.addEventListener('keydown', (e) => {
      let j = -1;
      if (e.key === 'ArrowRight') j = (i + 1) % tablar.length;
      else if (e.key === 'ArrowLeft') j = (i - 1 + tablar.length) % tablar.length;
      else if (e.key === 'Home') j = 0;
      else if (e.key === 'End') j = tablar.length - 1;
      if (j >= 0) { e.preventDefault(); tanlaTab(tablar[j], true); }
    });
  });
  // Panel ichidan boshqa qadamga o'tish tugmasi: <button data-qadamga="sinab">
  document.querySelectorAll<HTMLButtonElement>('[data-qadamga]').forEach((b) =>
    b.addEventListener('click', () => { const t = tablar.find((x) => x.dataset.qadam === b.dataset.qadamga); if (t) tanlaTab(t, true); }),
  );

  // ---------- Mashqlar ----------
  const fieldsetlar = [...document.querySelectorAll<HTMLFieldSetElement>('.savol')];
  const nuqtalar = [...document.querySelectorAll<HTMLButtonElement>('.savol-nuqtalar .nuqta')];
  let joriy = 0;

  const holatniChiz = () => {
    const p = progressniOqi(bolim)[modul] ?? {};
    let togri = 0;
    nuqtalar.forEach((n, i) => {
      const h = p[savollar[i].id];
      if (h === 'togri') togri++;
      n.dataset.holat = h ?? '';
      n.setAttribute('aria-label', `${M.mashq(i + 1)}${h === 'togri' ? M.nuqtaTogri : h === 'xato' ? M.nuqtaXato : ''}`);
      n.toggleAttribute('aria-current', i === joriy);
    });
    document.getElementById('progress-son')!.textContent = String(togri);
    document.getElementById('progress-chiziq')!.style.width = `${(togri / savollar.length) * 100}%`;
    daftarniChiz();
  };

  const korsat = (i: number, fokus = false) => {
    joriy = i;
    fieldsetlar.forEach((f, j) => { f.hidden = j !== i; });
    holatniChiz();
    if (fokus) fieldsetlar[i].querySelector<HTMLElement>('.s-matn')?.focus();
  };

  // Belgilash guruhlari (R&W): har mashq uchun bittadan yoki null
  const guruhlar: (Guruh | null)[] = [];
  const joyHolati: { ok: boolean; tanlangan: string }[] = [];
  const qisqa = (m: string) => { const s = m.split(' '); return s.length > 7 ? `${s.slice(0, 7).join(' ')}…` : m; };

  const tiklash = (f: HTMLFieldSetElement) => {
    const i = fieldsetlar.indexOf(f);
    const g = guruhlar[i];
    const soz = savollar[i].belgilash?.tur === 'soz';
    f.querySelectorAll<HTMLInputElement>('input').forEach((x) => { x.checked = false; x.disabled = false; });
    f.querySelectorAll('.variant').forEach((v) => v.classList.remove('togri', 'xato'));
    if (g) {
      g.tanla(-1); g.faol(true);
      g.tugmalar.forEach((t) => t.classList.remove('joy-togri', 'joy-xato', 'gap-togri', 'gap-xato'));
      f.querySelectorAll<HTMLElement>('.gap-yorliq').forEach((y) => { y.hidden = true; y.textContent = ''; });
      joyHolati[i] = { ok: true, tanlangan: '' };
    }
    if (soz) {
      f.querySelector<HTMLElement>('.variantlar')!.hidden = true;
      f.querySelector<HTMLElement>('.joy-holat')!.textContent = '';
      const jt = f.querySelector<HTMLButtonElement>('.joy-tekshir')!;
      jt.hidden = false; jt.disabled = true;
    }
    f.querySelector<HTMLElement>('.izoh')!.hidden = true;
    f.querySelector<HTMLButtonElement>('.tekshir')!.hidden = soz;
    f.querySelector<HTMLButtonElement>('.tekshir')!.disabled = true;
    f.querySelector<HTMLButtonElement>('.qayta')!.hidden = true;
    f.querySelector<HTMLButtonElement>('.keyingi')!.hidden = true;
  };

  fieldsetlar.forEach((f, i) => {
    const s = savollar[i];
    const matn = f.querySelector<HTMLElement>('.s-matn')!;
    matn.tabIndex = -1;
    const inputlar = [...f.querySelectorAll<HTMLInputElement>('input')];
    const tekshir = f.querySelector<HTMLButtonElement>('.tekshir')!;
    const b = s.belgilash;
    joyHolati[i] = { ok: true, tanlangan: '' };
    const joyTekshir = f.querySelector<HTMLButtonElement>('.joy-tekshir');
    const g = b
      ? belgilashGuruhi(f.querySelector<HTMLElement>('.bolaklar')!, (k) => {
          if (b.tur === 'gap') tekshir.disabled = k < 0;
          else if (joyTekshir) joyTekshir.disabled = k < 0;
        })
      : null;
    guruhlar[i] = g;
    inputlar.forEach((x) => x.addEventListener('change', () => { tekshir.disabled = false; }));

    // "Xatoni toping": 1-bosqich, xato joyini tekshirish
    if (b?.tur === 'soz' && g && joyTekshir) {
      joyTekshir.addEventListener('click', () => {
        const k = g.tanlangan();
        if (k < 0) return;
        const ok = k === b.togriBolak;
        joyHolati[i] = { ok, tanlangan: b.bolaklar[k] };
        g.faol(false);
        g.tugmalar[b.togriBolak].classList.add('joy-togri');
        if (!ok) g.tugmalar[k].classList.add('joy-xato');
        f.querySelector<HTMLElement>('.joy-holat')!.textContent = ok
          ? M.joyTogri
          : M.joyXato(b.bolaklar[b.togriBolak]);
        f.querySelector<HTMLElement>('.variantlar')!.hidden = false;
        joyTekshir.hidden = true;
        tekshir.hidden = false;
        inputlar[0]?.focus();
      });
    }

    tekshir.addEventListener('click', () => {
      let j: number;
      if (b?.tur === 'gap' && g) {
        j = g.tanlangan();
        if (j < 0) return;
      } else {
        const tanlangan = inputlar.find((x) => x.checked);
        if (!tanlangan) return;
        j = Number(tanlangan.value);
      }
      const joy = joyHolati[i];
      const togrimi = j === s.togri && joy.ok;
      const izoh = f.querySelector<HTMLElement>('.izoh')!;
      let sarlavha: string;
      let saqlanadigan = s.variantlar[j].matn;
      if (b?.tur === 'gap' && g) {
        g.faol(false);
        const belgila = (k: number, cls: string, yozuv: string) => {
          g.tugmalar[k].classList.add(cls);
          const y = g.tugmalar[k].querySelector<HTMLElement>('.gap-yorliq')!;
          y.textContent = yozuv; y.hidden = false;
        };
        belgila(s.togri, 'gap-togri', M.togriDalil);
        if (j !== s.togri) belgila(j, 'gap-xato', M.sizTanlagan);
        sarlavha = togrimi ? M.togri : M.xatoDalil(s.variantlar[s.togri].matn);
        saqlanadigan = qisqa(s.variantlar[j].matn);
      } else {
        inputlar.forEach((x) => { x.disabled = true; });
        const labellar = f.querySelectorAll('.variant');
        labellar[s.togri].classList.add('togri');
        if (j !== s.togri) labellar[j].classList.add('xato');
        const togriJavob = `${'ABCD'[s.togri]}) ${s.variantlar[s.togri].matn}`;
        if (!joy.ok) {
          sarlavha = j === s.togri ? M.joyTopilmadiTogri(togriJavob) : M.joyTopilmadiXato(togriJavob);
          saqlanadigan = M.joySaqlash(joy.tanlangan, s.variantlar[j].matn);
        } else {
          sarlavha = togrimi ? M.togri : M.xatoJavob(togriJavob);
        }
      }
      const tipik = [!joy.ok ? M.joyNotogri : '', j !== s.togri ? s.variantlar[j].xato ?? '' : ''].filter(Boolean);
      izoh.classList.toggle('izoh-togri', togrimi);
      izoh.querySelector('.izoh-sarlavha')!.textContent = sarlavha;
      izoh.querySelector('.izoh-xato')!.textContent = tipik.length ? M.tipik(tipik.join('; ')) : '';
      izoh.hidden = false;
      tekshir.hidden = true;
      f.querySelector<HTMLButtonElement>('.qayta')!.hidden = togrimi;
      f.querySelector<HTMLButtonElement>('.keyingi')!.hidden = false;
      // Tekshirish tugmasi yashirindi: fokus yo'qolmasin (WCAG 2.4.3), natija aria-live orqali o'qiladi
      f.querySelector<HTMLButtonElement>('.keyingi')!.focus({ preventScroll: true });
      const saqlandi = javobniYoz(bolim, modul, s.id, togrimi, saqlanadigan);
      document.getElementById('saqlash-holat')!.textContent = saqlandi
        ? M.saqlash
        : M.saqlanmadi;
      holatniChiz();
    });
    f.querySelector<HTMLButtonElement>('.qayta')!.addEventListener('click', () => { tiklash(f); (g ? g.tugmalar[0] : inputlar[0])?.focus(); });
    f.querySelector<HTMLButtonElement>('.keyingi')!.addEventListener('click', () => {
      if (i < fieldsetlar.length - 1) korsat(i + 1, true);
      else document.getElementById('xulosa-h')!.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
  nuqtalar.forEach((n, i) => n.addEventListener('click', () => korsat(i, true)));

  // ---------- Xato daftari ----------
  function daftarniChiz() {
    const royxat = document.getElementById('daftar-royxat')!;
    const bosh = document.getElementById('daftar-bosh')!;
    const xatolar = xatolarniOqi(bolim).filter((x) => x.modul === modul);
    royxat.replaceChildren();
    bosh.hidden = xatolar.length > 0;
    xatolar.forEach((x) => {
      const i = savollar.findIndex((s) => s.id === x.id);
      if (i < 0) return;
      const s = savollar[i];
      const li = document.createElement('li');
      const matn = document.createElement('div');
      const b = document.createElement('p'); b.className = 'd-savol';
      const til = ildiz.dataset.savolTili;
      if (til && !s.belgilash) { const sp = document.createElement('span'); sp.lang = til; sp.textContent = s.matn; b.append(`${M.mashq(i + 1)}. `, sp); }
      else b.textContent = `${M.mashq(i + 1)}. ${s.matn}`;
      const t = document.createElement('p'); t.className = 'kichik ikkinchi'; t.textContent = M.javobingiz(x.tanlangan, x.sana);
      matn.append(b, t);
      const tugma = document.createElement('button');
      tugma.type = 'button'; tugma.className = 'matn-tugma kok-tugma'; tugma.textContent = M.qaytaYechish;
      tugma.addEventListener('click', () => {
        tiklash(fieldsetlar[i]);
        korsat(i, true);
        document.getElementById('mashqlar')!.scrollIntoView({ block: 'start' });
      });
      li.append(matn, tugma);
      royxat.append(li);
    });
  }

  // O'chirish: sahifa ichidagi tasdiq (confirm() ishlatilmaydi)
  const tasdiq = document.getElementById('tasdiq')!;
  const tozala = document.getElementById('tozala') as HTMLButtonElement;
  tozala.addEventListener('click', () => { tasdiq.hidden = false; tozala.hidden = true; document.getElementById('tasdiq-yoq')!.focus(); });
  document.getElementById('tasdiq-yoq')!.addEventListener('click', () => { tasdiq.hidden = true; tozala.hidden = false; tozala.focus(); });
  document.getElementById('tasdiq-ha')!.addEventListener('click', () => {
    modulniTozala(bolim, modul);
    fieldsetlar.forEach(tiklash);
    tasdiq.hidden = true; tozala.hidden = false;
    korsat(0);
    document.getElementById('saqlash-holat')!.textContent = M.ochirildi;
  });

  holatniChiz();
  // Hali yechilmagan birinchi mashqdan boshlash
  const p0 = progressniOqi(bolim)[modul] ?? {};
  const birinchi = savollar.findIndex((s) => p0[s.id] !== 'togri');
  korsat(birinchi >= 0 ? birinchi : 0);
</script>

