---
import Asosiy from '../layouts/Asosiy.astro';
import { yol } from '../lib/yol';
---
<Asosiy
  title="Sahifa topilmadi"
  description="Bu manzilda sahifa yo'q."
  turi="umumiy"
  bolim="umumiy"
  holat="qoralama"
  canonical={false}
  sahifaOxiri={false}
>
  <section class="ichki sahifa">
    <script is:inline>
      // 2026-11-16: sayt github.io/Tayanch/ dan tayanchedu.uz ildiziga ko'chdi.
      // Eski /Tayanch/... havolasi (xat, xatcho'p, qidiruv) shu domendagi yangi yo'lga o'tadi; query va hash saqlanadi.
      (function () {
        var p = location.pathname;
        if (p === '/Tayanch' || p.indexOf('/Tayanch/') === 0) {
          location.replace((p.slice('/Tayanch'.length) || '/') + location.search + location.hash);
        }
      })();
    </script>
    <h1>Sahifa topilmadi</h1>
    <p class="ikkinchi">Bu manzilda sahifa yoʻq. Ehtimol u koʻchirilgan yoki hali qurilmagan.</p>
    <p><a class="tugma tugma-asosiy" href={yol('/uz/')}>Bosh sahifaga</a></p>
  </section>
</Asosiy>

<style>
  .sahifa { padding-block: var(--b-16); display: flex; flex-direction: column; gap: var(--b-4); align-items: flex-start; }
</style>
