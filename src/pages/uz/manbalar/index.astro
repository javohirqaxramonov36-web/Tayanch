---
import Asosiy from '../../../layouts/Asosiy.astro';
import { manbalar } from '../../../data/manbalar';
---
<Asosiy
  title="Manba jurnali"
  description="Tayanch saytida ishlatilgan manbalar, ularning tekshiruv darajasi va tekshirilgan sanasi."
  turi="umumiy"
  bolim="umumiy"
  holat="chop-etilgan"
  tekshirilgan="2026-11-04"
  keyingiTekshiruv="2026-12-04"
  sahifaOxiri={false}
>
  <section class="ichki sahifa">
    <h1>Manba jurnali</h1>
    <p class="ikkinchi">Saytda qoida, talab yoki muddat sifatida faqat <strong>rasmiy</strong> manba ishlatiladi: chiqaruvchi tashkilotning oʻz sayti yoki rasmiy hujjat. Boshqa saytlar faqat "qoʻshimcha oʻqish" boʻlishi mumkin.</p>
    {manbalar.length > 0 ? (
      <div class="jadval-orami">
        <table>
          <thead><tr><th>ID</th><th>Manba</th><th>Tashkilot</th><th>Daraja</th><th>Tekshirilgan</th></tr></thead>
          <tbody>
            {manbalar.map((m) => (
              <tr>
                <td>{m.id}</td>
                <td><a href={m.havola} rel="noopener">{m.nomi}</a>{m.izoh && <><br /><span class="kichik sust">{m.izoh}</span></>}</td>
                <td>{m.tashkilot}</td>
                <td>{m.tekshiruvDarajasi === 'rasmiy' ? 'rasmiy' : 'rasmiy emas'}</td>
                <td>{m.tekshirilganSana}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="ikkinchi">Jurnal hozircha boʻsh.</p>
    )}
  </section>
</Asosiy>

<style>
  .sahifa { padding-block: var(--b-14); display: flex; flex-direction: column; gap: var(--b-6); }
  .sahifa > p { max-width: var(--size-measure); }
  /* Navigator sirti: nav-surface, satr chizig'i nav-line, sarlavha qatori ma'noli chiziq nav-line-strong */
  .jadval-orami { overflow-x: auto; background: var(--color-nav-surface); color: var(--color-nav-text); border-radius: var(--radius-lg); padding: var(--space-2) var(--space-4); }
  table { border-collapse: collapse; width: 100%; font-size: var(--text-small-size); }
  th, td { text-align: left; padding: var(--space-3) var(--space-2); border-bottom: var(--border-width-1) solid var(--color-nav-line); vertical-align: top; }
  th { color: var(--color-nav-text-muted); border-bottom-color: var(--color-nav-line-strong); }
  tr:last-child td { border-bottom: none; }
</style>
