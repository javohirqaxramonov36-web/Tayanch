---
// IELTS Listening qo'llanmasi. Naqsh: reading/index.astro (Tayanch-IELTS-dizayn.md, "Qollanma" ekrani).
// Faktlar: IE07 (ielts.org, format), ID02 (IDP, imlo), ID03 (IDP, sana). Strategiya Tayanch maslahati.
// Mini-mashq va misollar Tayanch uchun yozilgan namuna.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { IKONKA, mashqlar } from '../../../../../data/ieltsSahifalar';
import { manbalar } from '../../../../../data/manbalar';
import { yol } from '../../../../../lib/yol';

const ie07 = manbalar.find((x) => x.id === 'IE07')!;
// Listening mashqlari ma'lumotdan: yangi mashq ieltsSahifalar.ts ga qo'shilsa, bu yerda o'zi chiqadi.
const listeningMashqlar = mashqlar.filter((m) => m.qism?.startsWith('mashq/listening'));

const mundarija = [
  { id: 'qismlar', nomi: 'Four parts' },
  { id: 'turlar', nomi: 'Question types' },
  { id: 'cheklov', nomi: 'Word limit' },
  { id: 'imlo', nomi: 'Spelling and dates' },
  { id: 'strategiya', nomi: 'Strategy' },
  { id: 'mashq', nomi: 'Practice' },
];
// IE07: qism tavsifi
const qismlar = [
  ['A conversation between two people', 'An everyday social situation.'],
  ['One main speaker', 'An everyday social situation.'],
  ['A conversation between two main speakers', 'A situation linked to education and training.'],
  ['One speaker, an academic subject', 'A situation linked to education and training.'],
];
// [nomi, rasmiy tavsif (IE07), Tayanch maslahati]
const turlar = [
  ['Multiple choice', 'You choose one correct answer, or sometimes several from a longer list.', 'Mark the differences between the options in advance. Several options may be mentioned in the recording: listen for what the speaker confirms in the end.'],
  ['Matching', 'You match items in the recording to a list of options.', 'Read the list of options first. In the recording they are often said in other words.'],
  ['Plan, map, diagram labelling', 'You complete labels on a plan, map or diagram; answers are chosen from a list.', 'Find the starting point first. Listen for place words like "opposite", "next to" and "on your left".'],
  ['Form, note, table, flow chart completion', 'You fill the gaps in an outline of part or all of the recording.', 'Look around each gap and predict what kind of word is needed: a number, a name, a date or the name of a thing.'],
  ['Sentence completion', 'You fill the gap in each sentence with information from the recording.', 'Check that your completed sentence reads correctly: singular or plural, articles.'],
  ['Short-answer questions', 'You read a question and write a short answer using information from the recording.', 'Look at the question word (who, when, how much): it tells you the type of answer. Keep to the word limit.'],
];
// Tayanch maslahati (rasmiy qoida emas)
const strategiyalar = [
  ['Read ahead.', 'Read the questions before the recording starts: if you know which word to expect, it is easier to hear. You hear the recording once (IE07), so being ready matters.'],
  ['Mark the key word.', 'In each question, underline a name, number, date or important noun. Then wait for where that word comes in the recording.'],
  ['Expect synonyms.', 'A word in the question may be said differently in the recording. For example, the question says "cheap" and the recording says "it doesn\'t cost much" (sample).'],
  ['Don\'t fall for the distractor.', 'A speaker may change their mind: "Tuesday… actually, Wednesday is better" (sample). Write what is confirmed in the end, not the first word you hear.'],
  ['Don\'t get stuck on one question.', 'If you miss an answer, move on to the next question. The recording does not stop.'],
];
---
<BolimQobiq
  title="Listening guide · IELTS"
  description="IELTS Listening: four parts, six question types, the word limit, spelling and dates, reading ahead and distractors."
  turi="qollanma"
  yol={["Listening"]}
  ota={yol('/uz/ielts/listening/')}
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki qol">
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Guide</span><span class="pill-ochiq">open</span></p>
      <h1>Listening: know <span class="kok">what to expect</span> before you hear it</h1>
      <p class="lead">You hear the recording only once. This guide teaches you to be ready: the four parts, question types, the word limit, spelling and dates, reading ahead and distractors.</p>
    </header>

    <section class="format" aria-label="Format card">
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.listening} />Section</span><span class="f-qiymat">Listening</span><span class="f-izoh">IELTS Academic</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20zM12 6v6l4 2" /></svg>Time</span><span class="f-qiymat">about 30 minutes</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>Questions</span><span class="f-qiymat">40</span><span class="f-izoh">1 mark for each correct answer</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7" /></svg>Parts</span><span class="f-qiymat">4</span><span class="f-izoh">you hear the recording once</span></div>
    </section>

    <details class="mundarija-tel">
      <summary>
        Contents
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <ul>{mundarija.map((m) => <li><a href={`#${m.id}`}>{m.nomi}</a></li>)}</ul>
    </details>

    <div class="ikki">
      <article class="maqola">
        <section id="qismlar" aria-labelledby="qismlar-h">
          <h2 id="qismlar-h">Four parts</h2>
          <p class="izoh-m">The first two parts are about everyday life, the last two about education and training (<a href={ie07.havola} rel="noopener">ielts.org</a>).</p>
          <ol class="raqamli">
            {qismlar.map(([b, t], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><p><b>Part {i + 1}. {b}.</b> <span class="ikkinchi-m">{t}</span></p></li>)}
          </ol>
        </section>

        <section id="turlar" aria-labelledby="turlar-h">
          <h2 id="turlar-h">Question types</h2>
          <p class="izoh-m">The official page lists six types. "What you do" is from ielts.org; "Tip" is Tayanch's advice.</p>
          <ul class="turlar">
            {turlar.map(([n, r, m]) => (
              <li>
                <span class="t-nom" lang="en">{n}</span>
                <div class="t-ong">
                  <p><span class="t-yorliq">What you do.</span> {r}</p>
                  <p class="ikkinchi-m"><span class="t-yorliq">Tip.</span> {m}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section id="cheklov" aria-labelledby="cheklov-h">
          <h2 id="cheklov-h">Word limit</h2>
          <div class="qoida" role="group" aria-label="Rule and example">
            <div class="q-chap">
              <p class="ustki-kok">Rule</p>
              <p class="q-asosiy">The task gives a word limit, for example "NO MORE THAN TWO WORDS AND/OR A NUMBER". If you write extra words, you lose the mark even if the answer is right.</p>
              <p class="ikkinchi-m">Source: <a href={ie07.havola} rel="noopener">ielts.org</a>.</p>
            </div>
            <figure class="q-ong">
              <figcaption class="ustki-yorliq">How words are counted</figcaption>
              <ul class="sanash">
                <li><span lang="en">check-in</span><span>1 word: a hyphenated word counts as one</span></li>
                <li><span lang="en">train station</span><span>2 words</span></li>
                <li><span lang="en">platform 2</span><span>1 word and 1 number</span></li>
              </ul>
              <p class="ikkinchi-m">Contracted words like "they're" are not tested.</p>
            </figure>
          </div>

          <section class="mashq" aria-labelledby="mashq-h">
            <div class="m-bosh">
              <p id="mashq-h" class="ustki-kok">Mini drill · sample</p>
              <span class="izoh">Not scored</span>
            </div>
            <p class="dawo">Limit: NO MORE THAN TWO WORDS AND/OR A NUMBER. Which answer loses the mark?</p>
            <div class="variantlar" role="radiogroup" aria-labelledby="mashq-h">
              <button type="button" role="radio" aria-checked="false" data-v="a" lang="en">train station</button>
              <button type="button" role="radio" aria-checked="false" data-v="b" lang="en">the train station</button>
              <button type="button" role="radio" aria-checked="false" data-v="c" lang="en">platform 2</button>
            </div>
            <div class="javob" id="javob" aria-live="polite" hidden>
              <p class="j-sarlavha" id="j-sarlavha"></p>
              <p class="ikkinchi-m">"the train station" is three words: "the" counts as a word too. "train station" is two words and "platform 2" is one word and one number: both fit the limit.</p>
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="qayta">Try again</button>
            </div>
          </section>
        </section>

        <section id="imlo" aria-labelledby="imlo-h">
          <h2 id="imlo-h">Spelling and dates</h2>
          <div class="juft">
            <div class="kul">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.writing} />
              <h3>Spelling</h3>
              <p>A misspelled word is a wrong answer, even if you heard it correctly.</p>
              <p class="ikkinchi-m">Both British and American spelling are accepted (colour / color), but use one consistently. Source: IDP (ID02).</p>
            </div>
            <div class="kul">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.reja} />
              <h3>Dates</h3>
              <p>Both the British (day, month) and American (month, day) order are accepted.</p>
              <p class="ikkinchi-m">Correct: 24 April, April 24, 24th April; in numbers, 19/02 or 02/19. Still keep to the word limit. Source: IDP (ID03).</p>
            </div>
          </div>
        </section>

        <section id="strategiya" aria-labelledby="strategiya-h">
          <h2 id="strategiya-h">Strategy</h2>
          <p class="izoh-m">This is Tayanch's advice, not an official rule. The examples are samples.</p>
          <ol class="raqamli">
            {strategiyalar.map(([b, t], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><p><b>{b}</b> <span class="ikkinchi-m">{t}</span></p></li>)}
          </ol>
        </section>

        <section id="mashq" class="keyingi" aria-labelledby="keyingi-h">
          <p class="ustki-yorliq kok-q">Practice</p>
          <h2 id="keyingi-h">Train your ear and your hand together</h2>
          <p class="k-matn">One mistake in spelling or a number makes even a correctly heard answer wrong. Practise these two separately.</p>
          <ul class="k-royxat">
            {listeningMashqlar.map((m) => (
              <li>
                <a class="k-havola" href={yol(`/uz/ielts/${m.qism}`)}>
                  <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={m.ikonka} />
                  <span class="k-nom"><strong>{m.nomi}</strong><span>{m.tavsif}</span></span>
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>

      <nav class="mundarija" aria-label="Page contents">
        <p class="ustki-yorliq">Contents</p>
        {mundarija.map((m, i) => <a href={`#${m.id}`} aria-current={i === 0 ? 'true' : undefined}>{m.nomi}</a>)}
      </nav>
    </div>

    <ManbaBlok
      manbalar={['IE07', 'ID02', 'ID03']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "Time to transfer answers in the paper test: not stated on the IE07 page; being checked.",
        "How answers are entered in the computer test: being checked.",
        "The General Training Listening format (this page covers Academic).",
        "The strategy and tips are Tayanch's advice; the mini drill and examples are samples written for Tayanch, not official IELTS material.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  // Mini-mashq: so'z cheklovi
  const TOGRI = 'b';
  const tugmalar = [...document.querySelectorAll<HTMLButtonElement>('.variantlar button')];
  const javob = document.getElementById('javob')!;
  const tanla = (b: HTMLButtonElement) => {
    if (!javob.hidden) return;
    const togrimi = b.dataset.v === TOGRI;
    tugmalar.forEach((x) => {
      x.setAttribute('aria-checked', String(x === b));
      x.setAttribute('aria-disabled', 'true');
      x.classList.toggle('togri', x.dataset.v === TOGRI);
      x.classList.toggle('xato', x === b && !togrimi);
      x.classList.toggle('sust', x.dataset.v !== TOGRI && x !== b);
    });
    javob.classList.toggle('j-togri', togrimi);
    document.getElementById('j-sarlavha')!.textContent = togrimi ? 'Correct: "the train station"' : 'Not this time. "the train station" loses the mark';
    javob.hidden = false;
  };
  tugmalar.forEach((b) => b.addEventListener('click', () => tanla(b)));
  document.getElementById('qayta')!.addEventListener('click', () => {
    javob.hidden = true;
    tugmalar.forEach((x) => {
      x.setAttribute('aria-checked', 'false');
      x.removeAttribute('aria-disabled');
      x.classList.remove('togri', 'xato', 'sust');
    });
    tugmalar[0].focus();
  });

  // Mundarija: joriy bo'limni belgilash
  const havolalar = [...document.querySelectorAll<HTMLAnchorElement>('.mundarija a')];
  const bolimlar = havolalar.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)!);
  const yangila = () => {
    let joriy = 0;
    bolimlar.forEach((s, i) => { if (s.getBoundingClientRect().top < 160) joriy = i; });
    havolalar.forEach((a, i) => { if (i === joriy) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
  };
  addEventListener('scroll', yangila, { passive: true });
  yangila();
  // Telefon mundarijasi: band bosilsa yopiladi
  const tel = document.querySelector<HTMLDetailsElement>('.mundarija-tel')!;
  tel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { tel.open = false; }));
</script>

<style>
  .qol { padding-top: var(--space-10); display: flex; flex-direction: column; gap: var(--space-10); max-width: calc(912px + 2 * var(--space-10)) !important; }
  .kok { color: var(--color-link); }
  .ustki-kok { margin: 0; font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-link); }
  .ustki-yorliq { margin: 0; font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ielts-text-muted); }
  .izoh { font-size: var(--text-small-size); font-weight: var(--font-weight-medium); color: var(--color-ielts-text-muted); }
  .izoh-m, .ikkinchi-m { line-height: 1.6; color: var(--color-ielts-text-muted); }
  .izoh-m a, .q-chap a { color: var(--color-link); }
  h2 { font-size: var(--text-h1-size); font-weight: var(--font-weight-extrabold); line-height: 1.2; }
  .pill-ochiq { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); background: var(--color-ielts-tile); color: var(--color-link); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); }

  .bosh { display: flex; flex-direction: column; gap: var(--space-4); }
  .pill-qator { display: flex; align-items: center; gap: var(--space-3); }
  h1 { font-size: var(--text-display-size); line-height: 1.1; font-weight: var(--font-weight-extrabold); letter-spacing: var(--oraliq-sarlavha); }
  .lead { line-height: 1.6; color: var(--color-ielts-text-muted); max-width: 60ch; }

  .format { border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: hidden; }
  .format > div { padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .format > div + div { border-left: 1px solid var(--color-ielts-line); }
  .f-yorliq { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ielts-text-muted); }
  .f-yorliq svg { color: var(--color-link); }
  .f-qiymat { font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); }
  .f-izoh { font-size: var(--text-small-size); font-weight: var(--font-weight-medium); color: var(--color-ielts-text-muted); }

  .mundarija-tel { display: none; }

  .ikki { display: flex; gap: var(--space-10); align-items: flex-start; }
  .maqola { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--space-14); }
  .maqola > section { display: flex; flex-direction: column; gap: var(--space-4); scroll-margin-top: var(--space-6); }
  #cheklov { gap: var(--space-5); }

  .raqamli { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  .raqamli li { display: flex; gap: var(--space-4); align-items: flex-start; }
  .t-raqam { width: 32px; height: 32px; flex: none; border-radius: var(--radius-full); border: 1.5px solid var(--color-ielts-text); display: flex; align-items: center; justify-content: center; font-weight: var(--font-weight-extrabold); font-size: var(--text-small-size); }
  .raqamli p { margin-top: var(--space-1); line-height: 1.6; }

  .turlar { list-style: none; margin: 0; padding: 0; border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); overflow: hidden; }
  .turlar li { padding: var(--space-4) var(--space-5); display: grid; grid-template-columns: 200px minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-2); }
  .turlar li + li { border-top: 1px solid var(--color-ielts-line); }
  .t-nom { font-weight: var(--font-weight-extrabold); }
  .t-ong { display: flex; flex-direction: column; gap: var(--space-2); }
  .t-ong p { line-height: 1.6; }
  .t-yorliq { font-weight: var(--font-weight-bold); color: var(--color-ielts-text); }

  .qoida { border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); overflow: hidden; }
  .q-chap { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .q-asosiy { font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); line-height: 1.4; }
  .q-ong { margin: 0; padding: var(--space-6); background: var(--color-ielts-tile); display: flex; flex-direction: column; gap: var(--space-3); }
  .sanash { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .sanash li { display: flex; flex-direction: column; gap: var(--space-1); line-height: 1.5; }
  .sanash li > span:first-child { font-weight: var(--font-weight-extrabold); }
  .sanash li > span:last-child { color: var(--color-ielts-text-muted); font-size: var(--text-small-size); }

  /* Mini-mashq: sahifadagi yagona soya */
  .mashq { background: var(--color-ielts-bg); border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); box-shadow: var(--shadow-glass); padding: var(--space-7); display: flex; flex-direction: column; gap: var(--space-5); }
  .m-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .dawo { font-size: var(--text-h3-size); line-height: 1.5; font-weight: var(--font-weight-extrabold); }
  .variantlar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .variantlar button {
    min-height: 56px; padding: 0 var(--space-3); border-radius: var(--radius-md);
    font: inherit; font-weight: var(--font-weight-extrabold); font-size: var(--text-body-size); cursor: pointer;
    background: var(--color-ielts-bg); color: var(--color-ielts-text); border: 2px solid var(--color-ielts-text);
  }
  .variantlar button:hover { background: var(--color-ielts-tile); }
  .variantlar button[aria-disabled='true'] { cursor: default; }
  /* To'g'ri javob neytral (PR #134 qarori): IELTS qavat rangi qizil, "to'g'ri" xato kabi o'qilmasin. Ma'no matn bilan. */
  .variantlar button.togri { background: var(--color-ielts-text); border-color: var(--color-ielts-text); color: var(--color-ielts-bg); }
  .variantlar button.xato { background: var(--color-ielts-tile); border-style: dashed; text-decoration: line-through; }
  .variantlar button.sust { color: var(--color-ielts-text-muted); border-color: var(--color-ielts-line); }
  .javob { border-radius: var(--radius-md); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); background: var(--color-ielts-tile); border: 1.5px dashed var(--color-ielts-text); }
  .javob[hidden] { display: none; }
  .javob.j-togri { background: var(--color-ielts-tile); border: 1.5px solid var(--color-ielts-text); }
  .j-sarlavha { font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); }
  .javob p { line-height: 1.6; }

  .juft { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .kul { background: var(--color-ielts-tile); border-radius: var(--radius-lg); padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
