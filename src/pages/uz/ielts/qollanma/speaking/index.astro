  .tablar button:hover { color: var(--matn); }
  .tablar button[aria-selected='true'] { background: var(--matn); color: var(--fon); }
  .panel { display: flex; flex-direction: column; gap: var(--b-4); }
  .panel:focus-visible, .tablar button:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }
