  .maxfiy { display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--color-ielts-tile); line-height: 1.5; font-size: var(--text-small-size); font-weight: var(--font-weight-semibold); }
