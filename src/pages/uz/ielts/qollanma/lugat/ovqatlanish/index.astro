---
import DarsQolip from '../../../../../../components/dars/DarsQolip.astro';
import { darsSavollari } from '../../../../../../data/ieltsDarslar';
import { yol } from '../../../../../../lib/yol';

const iboralar = [
  { ibora: 'balanced diet', mano: 'Turli oziq-ovqat guruhlarini o‘z ichiga olgan ovqatlanish.' },
  { ibora: 'cut down on', mano: 'Miqdor yoki iste’molni kamaytirish.' },
  { ibora: 'home-cooked meal', mano: 'Uyda tayyorlangan taom.' },
  { ibora: 'skip breakfast', mano: 'Nonushta qilmaslik.' },
  { ibora: 'food waste', mano: 'Iste’mol qilinmay tashlab yuboriladigan ovqat.' },
];
---
<DarsQolip
  bolim="ielts"
  modul="iv-ovqatlanish"
  savollar={darsSavollari['iv-ovqatlanish']}
  yolBandlari={["Qo‘llanmalar", 'Lug‘at']}
  darsTuri="Lug‘at darsi"
  imtihon="IELTS"
  manbalar={[]}
  tekshirilgan="2026-11-22"
  keyingiTekshiruv="Muallif ko‘rigidan keyin"
  title="Ovqatlanish kollokatsiyalari · IELTS"
  description="Ovqatlanishga oid beshta inglizcha iboraning ma’nosini kontekstda farqlash. Qoida, misol va beshta original namuna mashq."
  yonalish="Lug‘at"
  sarlavha="Ovqatlanish haqida tabiiy iboralar"
  lead="Bitta so‘zni tanish bilan cheklanmay, yonidagi so‘zlar bilan birga tushuning. Beshta iborani misolda ko‘rib, kontekstga mos ma’nosini tanlaysiz."
  qadamNomlari={['Misol', 'Qoida', 'Sinab ko‘r']}
  savolTili="en"
  savolKorsatma="Gapni o‘qing va iboraning kontekstga mos ma’nosini tanlang."
  katalogYoli="/uz/ielts/"
  takrorlashHref={yol('/uz/ielts/vosita/takrorlash/')}
  keyingi={{ nomi: 'Xatolarni takrorlash', href: yol('/uz/ielts/vosita/takrorlash/'), turi: 'qadam' }}
  maqsadlar={[
    'Beshta iboraning kontekstdagi ma’nosini farqlaysiz.',
    'Matnda aytilmagan ma’lumotni iboraga qo‘shib yubormaysiz.',
    'Javob izohi orqali xatoni tushunib, qayta mashq qilasiz.',
  ]}
  xulosa={[
    'Iborani uni o‘rab turgan gap bilan birga o‘qing.',
    'Miqdor kamayishi butunlay to‘xtashni bildirmaydi.',
    'Tayyorlash joyi mahsulot qayerdan kelganini aytmaydi.',
    'Variantdagi qo‘shimcha ma’lumotni matn tasdiqlashini tekshiring.',
    'Xato qilgan iborangizni qayta ishlang va o‘zingiz yangi gap tuzing.',
  ]}
  tekshirilmagan={[
    'Misollar va mashqlar Tayanch uchun mustaqil yozilgan AI qoralamasi. Inglizcha matn, tarjima va javoblar muallif ko‘rigini kutmoqda.',
    'Dars mavzusi muallif foydalanish ruxsatini tasdiqlagan materiallar katalogidan tanlangan.',
  ]}
>
  <section slot="sahna" class="lugat-sahna" aria-labelledby="iboralar-h">
    <p class="pill">Namuna</p>
    <h2 id="iboralar-h">Birga ishlatiladigan so‘zlar</h2>
    <dl class="iboralar">
      {iboralar.map(({ ibora, mano }) => (
        <div><dt lang="en">{ibora}</dt><dd>{mano}</dd></div>
      ))}
    </dl>
  </section>

  <div slot="animatsiya" class="qadam-matn">
    <p class="pill">Namuna</p>
    <p lang="en">Amina now cooks dinner at home three evenings a week. She is <strong>cutting down on</strong> takeaway meals.</p>
    <p>Amina tayyor ovqat buyurtma qilishni kamaytiryapti. Gap uni butunlay to‘xtatganini aytmaydi.</p>
    <button type="button" class="katta asosiy" data-qadamga="formula">Qoidani ko‘rish</button>
  </div>

  <div slot="formula" class="qadam-matn">
    <p>Avval iborani toping, keyin butun gapdagi ma’nosini tekshiring.</p>
    <p><span lang="en">Cut down on</span> miqdorni kamaytiradi. Joyni yoki vaqtni o‘zgartirishning o‘zi kamayishni bildirmaydi.</p>
    <p><span lang="en">Home-cooked</span> taom qayerda tayyorlanganini bildiradi. Tarkib yoki retsept haqida qo‘shimcha xulosa chiqarish uchun boshqa ma’lumot kerak.</p>
    <button type="button" class="katta asosiy" data-qadamga="sinab">Sinab ko‘rish</button>
  </div>

  <div slot="sinab" class="qadam-matn">
    <p>Pastdagi beshta mashqda iboraning kontekstga mos ma’nosini tanlang. Javobdan keyin izohni o‘qing.</p>
    <p>Oxirida iboralardan biri bilan o‘zingiz gap tuzing va uni ovoz chiqarib ayting.</p>
    <a class="katta asosiy" href="#mashqlar">Mashqlarga o‘tish</a>
  </div>
</DarsQolip>

<style>
  .lugat-sahna, .qadam-matn {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .lugat-sahna { padding: var(--space-5); }
  .lugat-sahna h2 { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); }
  .lugat-sahna .pill, .qadam-matn .pill { align-self: flex-start; }
  .iboralar { display: grid; gap: var(--space-4); margin: 0; }
  .iboralar > div { border-bottom: var(--border-width-1) solid var(--color-border); padding-bottom: var(--space-4); }
  .iboralar dt { font-weight: var(--font-weight-semibold); }
  .iboralar dd { margin: var(--space-1) 0 0; color: var(--color-text-secondary); }
</style>
