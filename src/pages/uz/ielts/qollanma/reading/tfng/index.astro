---
// IELTS Reading: "True / False / Not Given" (IE02, Identifying information).
// Sahna: bitta namuna parcha (4 gap) va da'vo. Misol qadamida har da'vo uchun dalil gap va munosabat (mos / zid / yo'q) ko'rsatiladi.
// Sinab ko'r qadamida foydalanuvchi avval dalil gapni belgilaydi yoki "Bunday gap yo'q" ni tanlaydi, keyin javobni (saqlanmaydi).
// Gaplar <button aria-pressed> (belgilashGuruh: strelka, Home/End, Enter). Mashqlar DarsQolip da, kalitlar tayanch:ielts-dars-progress / -xato-daftari.
import { darsSavollari } from '../../../../../../data/ieltsDarslar';
import { yol } from '../../../../../../lib/yol';
import DarsQolip from '../../../../../../components/dars/DarsQolip.astro';

type Javob = 'True' | 'False' | 'Not Given';
interface Davo { matn: string; javob: Javob; dalil: number; izoh: string }

// Laboratoriya parchasi (o'ylab topilgan vaziyat, mashq emas)
const gaplar = [
  'The community garden on Park Road was started by a few neighbours in an empty car park.',
  'Today it has forty plots, and each one is looked after by a different family.',
  'Families pay nothing for a plot, but they must help with shared jobs once a month.',
  'The vegetables are not sold: they are eaten by the families or given to a local kitchen.',
];
const misollar: Davo[] = [
  { matn: 'Every family has to help with work that is shared.', javob: 'True', dalil: 2, izoh: "Sentence 3: \"they must help with shared jobs\". Different words, same meaning." },
  { matn: 'Families pay a yearly fee for their plot.', javob: 'False', dalil: 2, izoh: "Sentence 3: \"Families pay nothing\". The text says the opposite of the statement." },
  { matn: 'The garden has won a prize for its vegetables.', javob: 'Not Given', dalil: -1, izoh: "Vegetables are mentioned, but no sentence is about a prize: nothing confirms or denies it." },
];
const sinovlar: Davo[] = [
  { matn: 'The garden used to be a car park.', javob: 'True', dalil: 0, izoh: "Sentence 1: the garden was started in an empty car park." },
  { matn: 'Some of the vegetables are sold at a market.', javob: 'False', dalil: 3, izoh: "Sentence 4: \"The vegetables are not sold\". This contradicts the statement." },
  { matn: 'Most of the families live on Park Road.', javob: 'Not Given', dalil: -1, izoh: "Park Road is only the garden's address. The text does not say where the families live." },
];
const JAVOBLAR: Javob[] = ['True', 'False', 'Not Given'];
---
<DarsQolip
  bolim="ielts"
  modul="ir-tfng"
  savollar={darsSavollari['ir-tfng']}
  yolBandlari={['Guides', 'Reading']}
  darsTuri="Reading lesson"
  imtihon="IELTS"
  manbalar={['IE02']}
  tekshirilgan="2026-11-06"
  keyingiTekshiruv="2026-12-06"
  title="True / False / Not Given · IELTS"
  description="IELTS Reading: decide whether a statement agrees with the text, contradicts it, or is not in it. Find the evidence sentence first, then answer. 5 exercises."
  yonalish="Identifying information"
  sarlavha="True, False or Not Given: start from the evidence sentence"
  lead="Many people mix up False and Not Given in this question. There is one difference: False needs a sentence in the text that contradicts the statement. So you find the evidence sentence first and choose the answer after."
  qadamNomlari={['Example', 'Rule', 'Try it']}
  savolTili="en"
  savolKorsatma="Read the passage. If the statement agrees with the information in the text, choose True; if it contradicts it, False; if the text gives no information about it, Not Given."
  keyingi={{ nomi: 'Matching headings', href: yol('/uz/ielts/qollanma/reading/sarlavhalar/') }}
  maqsadlar={[
    "Compare each part of a statement with a specific sentence in the text.",
    "Tell False (the text contradicts) from Not Given (not in the text) by the evidence.",
    "Recognise paraphrase: the same meaning in different words.",
  ]}
  xulosa={[
    "Read the statement first and pick out its key part: who, what, when, how much.",
    "Find the sentence in the text that deals with that part. It may use different words.",
    "If the sentence confirms the statement, it is True; if it says the opposite, False.",
    "If no sentence contradicts it, the answer is Not Given. General knowledge and guesses do not count.",
    "Watch words like \"at first\", \"today\" and \"more than\": they change the meaning.",
  ]}
  tekshirilmagan={[
    "The passages and questions were written for Tayanch and the situations are made up; those the author has not checked are marked \"unchecked\".",
    "The trap types (paraphrase, past situation, similar word, guess) are Tayanch's own grouping, not an official classification.",
    "In the real test one text comes with several statements; here each exercise is a short passage.",
  ]}
>
  <div slot="sahna">
    <div class="sahna-quti ir-quti">
      <p class="ir-namuna"><span class="pill">Sample</span> <span class="kichik ikkinchi">Made-up situation</span></p>
      <div class="ir-davo">
        <span class="kichik ikkinchi" id="ir-davo-nom">Statement 1</span>
        <span lang="en" id="ir-davo-matn">{misollar[0].matn}</span>
      </div>
      <div class="bolaklar gap-bolaklar" id="ir-matn" role="group" aria-label="Passage sentences" lang="en">
        {gaplar.map((g, k) => (
          <button type="button" class="bolak gap" data-bolak={k} aria-pressed="false">
            <span class="gap-matn">{g}</span>
            <span class="gap-yorliq" hidden></span>
          </button>
        ))}
      </div>
      <p class="ir-yoq" id="ir-yoq" hidden>No sentence in the text deals with this statement.</p>
    </div>
    <p class="sahna-izoh" id="ir-holat" aria-live="polite"></p>
    <script type="application/json" id="ir-data" set:html={JSON.stringify({ misollar, sinovlar })} />
  </div>

  <div slot="animatsiya">
    <p>One passage, three statements. Choose a statement: the evidence sentence is outlined in blue on the stage, with its relation written next to it.</p>
    <div class="segment" role="group" aria-label="Example statement">
      {misollar.map((m, k) => (
        <button type="button" data-misol={k} aria-pressed={k === 0 ? 'true' : 'false'}>{m.javob}</button>
      ))}
    </div>
    <div class="formula"><span class="kichik ikkinchi">Why</span><span class="f-qiymat ir-qoida" id="ir-misol-izoh">{misollar[0].izoh}</span></div>
    <div class="segment"><button type="button" class="t-tugma ielts-tugma--urgu" data-qadamga="sinab">Let me find it</button></div>
  </div>

  <div slot="formula">
    <dl class="ir-qoidalar">
      <div><dt>True</dt><dd>A sentence in the text says the same thing as the statement, even if the words are different.</dd></div>
      <div><dt>False</dt><dd>A sentence in the text contradicts the statement. You must be able to point to it.</dd></div>
      <div><dt>Not Given</dt><dd>No sentence in the text confirms or denies the statement.</dd></div>
      <div><dt>Check question</dt><dd>"Which sentence?" If you can't answer, it is Not Given, not False.</dd></div>
    </dl>
  </div>

  <div slot="sinab">
    <div class="vazifa">
      <p><b id="ir-sinab-nom">1 / 3.</b> First tap the evidence sentence on the stage, or choose "No such sentence". Then choose your answer and check it.</p>
      <div class="segment"><button type="button" class="t-tugma t-tugma--ikkinchi" id="ir-yoq-tugma" aria-pressed="false">No such sentence</button></div>
      <div class="segment" role="group" aria-label="Answer">
        {JAVOBLAR.map((j) => <button type="button" data-javob={j} aria-pressed="false" lang="en">{j}</button>)}
      </div>
      <p class="vazifa-holat" id="ir-sinab-holat" aria-live="polite">Nothing chosen yet.</p>
    </div>
    <div class="segment">
      <button type="button" class="t-tugma ielts-tugma--urgu" id="ir-tekshir">Check</button>
      <button type="button" class="t-tugma t-tugma--ikkinchi" id="ir-keyingi">Next statement</button>
    </div>
  </div>
</DarsQolip>

<script>
  import { belgilashGuruhi } from '../../../../../../lib/belgilashGuruh';

  type Davo = { matn: string; javob: string; dalil: number; izoh: string };
  const { misollar, sinovlar } = JSON.parse(document.getElementById('ir-data')!.textContent || '{}') as { misollar: Davo[]; sinovlar: Davo[] };
  const $ = (id: string) => document.getElementById(id)!;
  const holat = $('ir-sinab-holat');
  const yoqTugma = $('ir-yoq-tugma') as HTMLButtonElement;
  const javobTugmalar = [...document.querySelectorAll<HTMLButtonElement>('[data-javob]')];
  const misolTugmalar = [...document.querySelectorAll<HTMLButtonElement>('[data-misol]')];
  let qadam = 'animatsiya';
  let misol = 0;
  let sinov = 0;
  let yoq = false;
  let javob = '';

  const g = belgilashGuruhi($('ir-matn'), (k) => {
    if (qadam !== 'sinab') return;
    if (k >= 0) { yoq = false; yoqTugma.setAttribute('aria-pressed', 'false'); }
    tozala(false);
    holatYoz();
  });

  function yorliq(k: number, matn: string, cls: string) {
    const t = g.tugmalar[k];
    t.classList.add(cls);
    const y = t.querySelector<HTMLElement>('.gap-yorliq')!;
    y.textContent = matn; y.hidden = false;
  }
  function tozala(tanlovniHam: boolean) {
    g.tugmalar.forEach((t) => {
      t.classList.remove('gap-togri', 'gap-xato');
      const y = t.querySelector<HTMLElement>('.gap-yorliq')!;
      y.hidden = true; y.textContent = '';
    });
    $('ir-yoq').hidden = true;
    if (tanlovniHam) g.tanla(-1);
  }
  const munosabat = (d: Davo) => (d.javob === 'True' ? 'Agrees' : 'Contradicts');
  function davoKorsat(nom: string, d: Davo) {
    $('ir-davo-nom').textContent = nom;
    $('ir-davo-matn').textContent = d.matn;
  }
  function holatYoz() {
    const k = g.tanlangan();
    const dalil = yoq ? 'No such sentence' : k >= 0 ? `sentence ${k + 1}` : 'no evidence chosen';
    holat.textContent = `Chosen: ${dalil}; answer: ${javob || 'not chosen'}.`;
    holat.dataset.ok = '';
  }

  function chizMisol() {
    tozala(true);
    g.faol(false);
    const d = misollar[misol];
    davoKorsat(`Statement ${misol + 1}`, d);
    misolTugmalar.forEach((t, k) => t.setAttribute('aria-pressed', String(k === misol)));
    $('ir-misol-izoh').textContent = d.izoh;
    if (d.dalil >= 0) yorliq(d.dalil, munosabat(d), 'gap-togri');
    else $('ir-yoq').hidden = false;
    $('ir-holat').textContent = `Statement ${misol + 1}: ${d.javob}. ${d.dalil >= 0 ? `Evidence: sentence ${d.dalil + 1}, ${munosabat(d).toLowerCase()}.` : 'No evidence sentence.'}`;
  }
  function chizSinov() {
    tozala(true);
    g.faol(true);
    yoq = false; javob = '';
    yoqTugma.setAttribute('aria-pressed', 'false');
    javobTugmalar.forEach((t) => { t.setAttribute('aria-pressed', 'false'); t.disabled = false; });
    yoqTugma.disabled = false;
    davoKorsat(`Practice: statement ${sinov + 1}`, sinovlar[sinov]);
    $('ir-sinab-nom').textContent = `${sinov + 1} / ${sinovlar.length}.`;
    holat.textContent = 'Nothing chosen yet.'; holat.dataset.ok = '';
    $('ir-holat').textContent = 'Find the sentence that deals with the statement.';
  }
  function chiz() { if (qadam === 'sinab') chizSinov(); else chizMisol(); }

  function tekshir() {
    const d = sinovlar[sinov];
    const k = g.tanlangan();
    if (!javob || (!yoq && k < 0)) { holat.textContent = 'First choose the evidence (or "No such sentence") and an answer.'; holat.dataset.ok = ''; return; }
    const dalilOk = d.dalil < 0 ? yoq : k === d.dalil;
    const javobOk = javob === d.javob;
    tozala(false);
    if (d.dalil >= 0) yorliq(d.dalil, munosabat(d), 'gap-togri');
    else $('ir-yoq').hidden = false;
    if (!yoq && k >= 0 && k !== d.dalil) yorliq(k, 'Your choice', 'gap-xato');
    if (javobOk && dalilOk) {
      holat.textContent = `Correct: ${d.javob}. ${d.izoh}`; holat.dataset.ok = '1';
      g.faol(false); yoqTugma.disabled = true; javobTugmalar.forEach((t) => { t.disabled = true; });
    } else if (javobOk) {
      holat.textContent = `The answer is right (${d.javob}), but the evidence is elsewhere. ${d.izoh}`; holat.dataset.ok = '';
    } else {
      holat.textContent = `The answer is ${d.javob}. ${d.izoh} Try again or go to the next statement.`; holat.dataset.ok = '';
    }
  }

  misolTugmalar.forEach((t, k) => t.addEventListener('click', () => { misol = k; chizMisol(); }));
  yoqTugma.addEventListener('click', () => {
    yoq = !yoq;
    yoqTugma.setAttribute('aria-pressed', String(yoq));
    if (yoq) g.tanla(-1);
    tozala(false);
    holatYoz();
  });
  javobTugmalar.forEach((t) => t.addEventListener('click', () => {
    javob = t.dataset.javob!;
    javobTugmalar.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    holatYoz();
  }));
  $('ir-tekshir').addEventListener('click', tekshir);
  $('ir-keyingi').addEventListener('click', () => { sinov = (sinov + 1) % sinovlar.length; chizSinov(); g.tugmalar[0].focus(); });
  document.addEventListener('dars:qadam', (e) => { qadam = (e as CustomEvent).detail.qadam; chiz(); });
  chiz();
</script>

<style is:global>
  .ir-quti { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-4); }
  .ir-namuna { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .ir-davo { font-size: var(--text-h3-size); font-weight: var(--font-weight-bold); line-height: 1.5; display: flex; flex-direction: column; gap: var(--space-1); border-left: 4px solid var(--color-ielts-text); padding-left: var(--space-3); }
  .ir-yoq { border: 2px dashed var(--color-ielts-text); border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); font-weight: var(--font-weight-bold); }
  .ir-yoq[hidden] { display: none; }
  .dars .ir-qoida { font-size: var(--text-body-size); font-weight: var(--font-weight-semibold); line-height: 1.5; }
  .ir-qoidalar { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .ir-qoidalar div { background: var(--color-ielts-tile); border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); }
  .ir-qoidalar dt { font-weight: var(--font-weight-extrabold); }
  .ir-qoidalar dd { margin: 0; line-height: 1.5; color: var(--color-ielts-text-muted); }
  .dars .segment button:disabled { opacity: 0.6; cursor: default; }
</style>
