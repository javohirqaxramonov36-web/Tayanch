---
// IELTS Reading: "True / False / Not Given" (IE02, Identifying information).
// Sahna: bitta namuna parcha (4 gap) va da'vo. Misol qadamida har da'vo uchun dalil gap va munosabat (mos / zid / yo'q) ko'rsatiladi.
// Sinab ko'r qadamida foydalanuvchi avval dalil gapni belgilaydi yoki "Bunday gap yo'q" ni tanlaydi, keyin javobni (saqlanmaydi).
// Gaplar <button aria-pressed> (belgilashGuruh: strelka, Home/End, Enter). Mashqlar DarsQolip da, kalitlar tayanch:ielts-dars-progress / -xato-daftari.
import { darsSavollari } from '../../../../../../data/ieltsDarslar';
import { yol } from '../../../../../../lib/yol';
import DarsQolip from '../../../../../../components/dars/DarsQolip.astro';

type Javob = 'True' | 'False' | 'Not Given';
interface Davo { matn: string; javob: Javob; dalil: number; izoh: string }

// Laboratoriya parchasi (o'ylab topilgan vaziyat, mashq emas)
const gaplar = [
  'The community garden on Park Road was started by a few neighbours in an empty car park.',
  'Today it has forty plots, and each one is looked after by a different family.',
  'Families pay nothing for a plot, but they must help with shared jobs once a month.',
  'The vegetables are not sold: they are eaten by the families or given to a local kitchen.',
];
const misollar: Davo[] = [
  { matn: 'Every family has to help with work that is shared.', javob: 'True', dalil: 2, izoh: "3-gap: \"they must help with shared jobs\". So'zlar boshqa, ma'no bir xil." },
  { matn: 'Families pay a yearly fee for their plot.', javob: 'False', dalil: 2, izoh: "3-gap: \"Families pay nothing\". Matn da'voning teskarisini aytadi." },
  { matn: 'The garden has won a prize for its vegetables.', javob: 'Not Given', dalil: -1, izoh: "Sabzavotlar tilga olingan, lekin mukofot haqida hech bir gap yo'q: na tasdiq, na inkor." },
];
const sinovlar: Davo[] = [
  { matn: 'The garden used to be a car park.', javob: 'True', dalil: 0, izoh: "1-gap: bog' bo'sh avtoturargohda boshlangan." },
  { matn: 'Some of the vegetables are sold at a market.', javob: 'False', dalil: 3, izoh: "4-gap: \"The vegetables are not sold\". Bu da'voga zid." },
  { matn: 'Most of the families live on Park Road.', javob: 'Not Given', dalil: -1, izoh: "Park Road faqat bog' manzili. Oilalar qayerda yashashi aytilmagan." },
];
const JAVOBLAR: Javob[] = ['True', 'False', 'Not Given'];
---
<DarsQolip
  bolim="ielts"
  modul="ir-tfng"
  savollar={darsSavollari['ir-tfng']}
  yolBandlari={["Qo'llanmalar", 'Reading']}
  darsTuri="Reading darsi"
  imtihon="IELTS"
  manbalar={['IE02']}
  tekshirilgan="2026-11-06"
  keyingiTekshiruv="2026-12-06"
  title="True / False / Not Given · IELTS"
  description="IELTS Reading: da'vo matnga mos, zid yoki matnda yo'qligini ajrating. Avval dalil gapni toping, keyin javob bering. 5 ta mashq."
  yonalish="Identifying information"
  sarlavha="True, False yoki Not Given: dalil gapdan boshlang"
  lead="Bu savolda ko'pchilik False va Not Given ni chalkashtiradi. Farqi bitta: False uchun matnda zid gap bo'lishi shart. Shuning uchun avval dalil gapni topasiz, javobni keyin tanlaysiz."
  qadamNomlari={['Misol', 'Qoida', "Sinab ko'r"]}
  savolTili="en"
  savolKorsatma="Parchani o'qing. Da'vo matndagi ma'lumotga mos kelsa True, zid bo'lsa False, matnda bu haqda ma'lumot bo'lmasa Not Given."
  keyingi={{ nomi: 'Matching headings', href: yol('/uz/ielts/qollanma/reading/sarlavhalar/') }}
  maqsadlar={[
    "Da'voning har qismini matndagi aniq gap bilan solishtirasiz.",
    "False (matn zid) va Not Given (matnda yo'q) ni dalil bo'yicha ajratasiz.",
    "Parafrazni taniysiz: boshqa so'zlar bilan aytilgan bir xil ma'no.",
  ]}
  xulosa={[
    "Avval da'voni o'qing va uning kalit qismini ajrating: kim, nima, qachon, qancha.",
    "Matnda shu qismga tegadigan gapni toping. U boshqa so'zlar bilan yozilgan bo'lishi mumkin.",
    "Gap da'voni tasdiqlasa True, teskarisini aytsa False.",
    "Zid gap topilmasa, javob Not Given. Umumiy bilim va taxmin hisob emas.",
    "\"At first\", \"today\", \"more than\" kabi so'zlarga e'tibor bering: ular ma'noni o'zgartiradi.",
  ]}
  tekshirilmagan={[
    "Parchalar va savollar Tayanch uchun yozilgan, vaziyatlar o'ylab topilgan; muallif tekshirmaganlari \"tekshirilmagan\" deb belgilangan.",
    "Tuzoq turlari (parafraz, eski holat, yaqin so'z, taxmin) Tayanch tavsiyasi, rasmiy tasnif emas.",
    "Haqiqiy imtihonda bitta matnga bir nechta da'vo beriladi; bu yerda har mashq qisqa parcha.",
  ]}
>
  <div slot="sahna">
    <div class="sahna-quti ir-quti">
      <p class="ir-namuna"><span class="pill">Namuna</span> <span class="kichik ikkinchi">O'ylab topilgan vaziyat</span></p>
      <div class="ir-davo">
        <span class="kichik ikkinchi" id="ir-davo-nom">1-da'vo</span>
        <span lang="en" id="ir-davo-matn">{misollar[0].matn}</span>
      </div>
      <div class="bolaklar gap-bolaklar" id="ir-matn" role="group" aria-label="Parcha gaplari" lang="en">
        {gaplar.map((g, k) => (
          <button type="button" class="bolak gap" data-bolak={k} aria-pressed="false">
            <span class="gap-matn">{g}</span>
            <span class="gap-yorliq" lang="uz" hidden></span>
          </button>
        ))}
      </div>
      <p class="ir-yoq" id="ir-yoq" hidden>Matnda bu da'voga tegadigan gap yo'q.</p>
    </div>
    <p class="sahna-izoh" id="ir-holat" aria-live="polite"></p>
    <script type="application/json" id="ir-data" set:html={JSON.stringify({ misollar, sinovlar })} />
  </div>

  <div slot="animatsiya">
    <p>Bitta parcha, uch da'vo. Da'voni tanlang: sahnada dalil gap ko'k chegara bilan belgilanadi, yonida munosabati yoziladi.</p>
    <div class="segment" role="group" aria-label="Misol da'vo">
      {misollar.map((m, k) => (
        <button type="button" data-misol={k} aria-pressed={k === 0 ? 'true' : 'false'}>{m.javob}</button>
      ))}
    </div>
    <div class="formula"><span class="kichik ikkinchi">Nega</span><span class="f-qiymat ir-qoida" id="ir-misol-izoh">{misollar[0].izoh}</span></div>
    <div class="segment"><button type="button" class="katta asosiy" data-qadamga="sinab">O'zim topaman</button></div>
  </div>

  <div slot="formula">
    <dl class="ir-qoidalar">
      <div><dt>True</dt><dd>Matndagi gap da'vo bilan bir xil ma'noni aytadi, so'zlari boshqa bo'lsa ham.</dd></div>
      <div><dt>False</dt><dd>Matndagi gap da'voga zid. Bunday gapni ko'rsata olishingiz kerak.</dd></div>
      <div><dt>Not Given</dt><dd>Matnda da'voni tasdiqlaydigan ham, inkor qiladigan ham gap yo'q.</dd></div>
      <div><dt>Tekshirish savoli</dt><dd>"Qaysi gap?" Javob bera olmasangiz, False emas, Not Given.</dd></div>
    </dl>
  </div>

  <div slot="sinab">
    <div class="vazifa">
      <p><b id="ir-sinab-nom">1 / 3.</b> Avval sahnadagi dalil gapni bosing yoki "Bunday gap yo'q" ni tanlang. Keyin javobni tanlab, tekshiring.</p>
      <div class="segment"><button type="button" class="kichik-tugma" id="ir-yoq-tugma" aria-pressed="false">Bunday gap yo'q</button></div>
      <div class="segment" role="group" aria-label="Javob">
        {JAVOBLAR.map((j) => <button type="button" data-javob={j} aria-pressed="false" lang="en">{j}</button>)}
      </div>
      <p class="vazifa-holat" id="ir-sinab-holat" aria-live="polite">Hali tanlanmagan.</p>
    </div>
    <div class="segment">
      <button type="button" class="katta asosiy" id="ir-tekshir">Tekshirish</button>
      <button type="button" class="kichik-tugma" id="ir-keyingi">Keyingi da'vo</button>
    </div>
  </div>
</DarsQolip>

<script>
  import { belgilashGuruhi } from '../../../../../../lib/belgilashGuruh';

  type Davo = { matn: string; javob: string; dalil: number; izoh: string };
  const { misollar, sinovlar } = JSON.parse(document.getElementById('ir-data')!.textContent || '{}') as { misollar: Davo[]; sinovlar: Davo[] };
  const $ = (id: string) => document.getElementById(id)!;
  const holat = $('ir-sinab-holat');
  const yoqTugma = $('ir-yoq-tugma') as HTMLButtonElement;
  const javobTugmalar = [...document.querySelectorAll<HTMLButtonElement>('[data-javob]')];
  const misolTugmalar = [...document.querySelectorAll<HTMLButtonElement>('[data-misol]')];
  let qadam = 'animatsiya';
  let misol = 0;
  let sinov = 0;
  let yoq = false;
  let javob = '';

  const g = belgilashGuruhi($('ir-matn'), (k) => {
    if (qadam !== 'sinab') return;
    if (k >= 0) { yoq = false; yoqTugma.setAttribute('aria-pressed', 'false'); }
    tozala(false);
    holatYoz();
  });

  function yorliq(k: number, matn: string, cls: string) {
    const t = g.tugmalar[k];
    t.classList.add(cls);
    const y = t.querySelector<HTMLElement>('.gap-yorliq')!;
    y.textContent = matn; y.hidden = false;
  }
  function tozala(tanlovniHam: boolean) {
    g.tugmalar.forEach((t) => {
      t.classList.remove('gap-togri', 'gap-xato');
      const y = t.querySelector<HTMLElement>('.gap-yorliq')!;
      y.hidden = true; y.textContent = '';
    });
    $('ir-yoq').hidden = true;
    if (tanlovniHam) g.tanla(-1);
  }
  const munosabat = (d: Davo) => (d.javob === 'True' ? 'Mos' : 'Zid');
  function davoKorsat(nom: string, d: Davo) {
    $('ir-davo-nom').textContent = nom;
    $('ir-davo-matn').textContent = d.matn;
  }
  function holatYoz() {
    const k = g.tanlangan();
    const dalil = yoq ? "Bunday gap yo'q" : k >= 0 ? `${k + 1}-gap` : 'dalil tanlanmagan';
    holat.textContent = `Tanlov: ${dalil}; javob: ${javob || 'tanlanmagan'}.`;
    holat.dataset.ok = '';
  }

  function chizMisol() {
    tozala(true);
    g.faol(false);
    const d = misollar[misol];
    davoKorsat(`${misol + 1}-da'vo`, d);
    misolTugmalar.forEach((t, k) => t.setAttribute('aria-pressed', String(k === misol)));
    $('ir-misol-izoh').textContent = d.izoh;
    if (d.dalil >= 0) yorliq(d.dalil, munosabat(d), 'gap-togri');
    else $('ir-yoq').hidden = false;
    $('ir-holat').textContent = `${misol + 1}-da'vo: ${d.javob}. ${d.dalil >= 0 ? `Dalil: ${d.dalil + 1}-gap, ${munosabat(d).toLowerCase()}.` : "Dalil gap yo'q."}`;
  }
  function chizSinov() {
    tozala(true);
    g.faol(true);
    yoq = false; javob = '';
    yoqTugma.setAttribute('aria-pressed', 'false');
    javobTugmalar.forEach((t) => { t.setAttribute('aria-pressed', 'false'); t.disabled = false; });
    yoqTugma.disabled = false;
    davoKorsat(`Sinov: ${sinov + 1}-da'vo`, sinovlar[sinov]);
    $('ir-sinab-nom').textContent = `${sinov + 1} / ${sinovlar.length}.`;
    holat.textContent = 'Hali tanlanmagan.'; holat.dataset.ok = '';
    $('ir-holat').textContent = "Da'voga tegadigan gapni toping.";
  }
  function chiz() { if (qadam === 'sinab') chizSinov(); else chizMisol(); }

  function tekshir() {
    const d = sinovlar[sinov];
    const k = g.tanlangan();
    if (!javob || (!yoq && k < 0)) { holat.textContent = "Avval dalilni (yoki \"Bunday gap yo'q\") va javobni tanlang."; holat.dataset.ok = ''; return; }
    const dalilOk = d.dalil < 0 ? yoq : k === d.dalil;
    const javobOk = javob === d.javob;
    tozala(false);
    if (d.dalil >= 0) yorliq(d.dalil, munosabat(d), 'gap-togri');
    else $('ir-yoq').hidden = false;
    if (!yoq && k >= 0 && k !== d.dalil) yorliq(k, 'Siz tanlagan', 'gap-xato');
    if (javobOk && dalilOk) {
      holat.textContent = `To'g'ri: ${d.javob}. ${d.izoh}`; holat.dataset.ok = '1';
      g.faol(false); yoqTugma.disabled = true; javobTugmalar.forEach((t) => { t.disabled = true; });
    } else if (javobOk) {
      holat.textContent = `Javob to'g'ri (${d.javob}), lekin dalil boshqa. ${d.izoh}`; holat.dataset.ok = '';
    } else {
      holat.textContent = `Javob ${d.javob}. ${d.izoh} Yana urinib ko'ring yoki keyingi da'voga o'ting.`; holat.dataset.ok = '';
    }
  }

  misolTugmalar.forEach((t, k) => t.addEventListener('click', () => { misol = k; chizMisol(); }));
  yoqTugma.addEventListener('click', () => {
    yoq = !yoq;
    yoqTugma.setAttribute('aria-pressed', String(yoq));
    if (yoq) g.tanla(-1);
    tozala(false);
    holatYoz();
  });
  javobTugmalar.forEach((t) => t.addEventListener('click', () => {
    javob = t.dataset.javob!;
    javobTugmalar.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    holatYoz();
  }));
  $('ir-tekshir').addEventListener('click', tekshir);
  $('ir-keyingi').addEventListener('click', () => { sinov = (sinov + 1) % sinovlar.length; chizSinov(); g.tugmalar[0].focus(); });
  document.addEventListener('dars:qadam', (e) => { qadam = (e as CustomEvent).detail.qadam; chiz(); });
  chiz();
</script>

<style is:global>
  .ir-quti { padding: var(--b-5); display: flex; flex-direction: column; gap: var(--b-4); }
  .ir-namuna { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-2); }
  .ir-davo { font-size: 18px; font-weight: 700; line-height: 1.5; display: flex; flex-direction: column; gap: var(--b-1); border-left: 4px solid var(--matn); padding-left: var(--b-3); }
  .ir-yoq { border: 2px dashed var(--matn); border-radius: var(--r-orta); padding: var(--b-3) var(--b-4); font-weight: 700; }
  .ir-yoq[hidden] { display: none; }
  .dars .ir-qoida { font-size: 16px; font-weight: 600; line-height: 1.5; }
  .ir-qoidalar { margin: 0; display: flex; flex-direction: column; gap: var(--b-2); }
  .ir-qoidalar div { background: var(--fon-ikkinchi); border-radius: var(--r-orta); padding: var(--b-3) var(--b-4); }
  .ir-qoidalar dt { font-weight: 800; }
  .ir-qoidalar dd { margin: 0; line-height: 1.5; color: var(--matn-ikkinchi); }
  .dars .segment button:disabled { opacity: 0.6; cursor: default; }
</style>
