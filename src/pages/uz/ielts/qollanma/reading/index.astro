---
// IELTS Reading qo'llanmasi. Dizayn: Tayanch-IELTS-dizayn.md, "Qollanma" va "QollanmaTelefon" ekranlari.
// Format raqamlari: IE02 (ielts.org). Mini-mashq parchasi Tayanch uchun yozilgan namuna.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { IKONKA } from '../../../../../data/ieltsSahifalar';
import { manbalar } from '../../../../../data/manbalar';
import { yol } from '../../../../../lib/yol';

const ie02 = manbalar.find((x) => x.id === 'IE02')!;
const mundarija = [
  { id: 'turlar', nomi: 'Savol turlari' },
  { id: 'skim', nomi: 'Skimming va scanning' },
  { id: 'tfng', nomi: 'True / False / Not Given' },
  { id: 'tuzoq', nomi: 'Tuzoqlar' },
  { id: 'vaqt', nomi: 'Vaqt strategiyasi' },
];
const turlar = [
  ['True / False / Not Given', "Fakt matnga mosmi, zidmi yoki umuman yoʻqmi"],
  ['Yes / No / Not Given', "Xuddi shunday, lekin muallifning fikri haqida"],
  ['Matching headings', "Har abzasning asosiy gʻoyasi"],
  ['Multiple choice', 'Bir variantni dalil bilan tasdiqlash, qolganini rad etish'],
  ['Completion', "Gap, jadval yoki xulosadagi boʻsh joy: soʻz cheklovini oʻqi"],
];
const tuzoqlar = [
  ["Bir xil soʻz, boshqa maʼno.", "Savoldagi soʻz matnda bor, lekin u boshqa fikrni aytayotgan boʻlishi mumkin."],
  ["Not Givenʼni False deb belgilash.", "Zid gapni topmaguncha False qoʻyma."],
  ['"Some", "always", "only".', "Bitta cheklovchi soʻz javobni butunlay oʻzgartiradi."],
  ['Bitta savolda qotib qolish.', "Belgilab qoʻy, keyingisiga oʻt, oxirida qayt."],
];
---
<BolimQobiq
  title="Reading qo'llanmasi · IELTS"
  description="IELTS Reading: savol turlari, skimming va scanning, True/False/Not Given, tuzoqlar va vaqt strategiyasi."
  turi="qollanma"
  yol={["Reading"]}
  ota={yol('/uz/ielts/reading/')}
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki qol">
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Qoʻllanma</span><span class="pill-ochiq">ochiq</span></p>
      <h1>Reading: javobni emas, <span class="kok">dalilni qidir</span></h1>
      <p class="lead">Har bir toʻgʻri javobning orqasida matndagi bitta gap turadi. Bu qoʻllanma oʻsha gapni tez topishni oʻrgatadi: savol turlari, skimming va scanning, True/False/Not Given va vaqt.</p>
    </header>

    <section class="format" aria-label="Format kartasi">
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.reading} />Boʻlim</span><span class="f-qiymat">Reading</span><span class="f-izoh">IELTS Academic</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20zM12 6v6l4 2" /></svg>Vaqt</span><span class="f-qiymat">60 daqiqa</span><span class="f-izoh">koʻchirish vaqti ichida</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>Savollar</span><span class="f-qiymat">40 ta</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" /></svg>Matnlar</span><span class="f-qiymat">3 boʻlim</span><span class="f-izoh">jami 2150–2750 soʻz</span></div>
    </section>

    <details class="mundarija-tel">
      <summary>
        Mundarija
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <ul>{mundarija.map((m, i) => <li><a href={`#${m.id}`} aria-current={i === 0 ? 'location' : undefined}>{m.nomi}</a></li>)}</ul>
    </details>

    <div class="ikki">
      <article class="maqola">
        <section id="turlar" aria-labelledby="turlar-h">
          <h2 id="turlar-h">Savol turlari</h2>
          <p class="izoh-m">Savol turini birinchi boʻlib aniqla: u matnda nimani qidirishingni aytadi.</p>
          <ul class="turlar">
            {turlar.map(([n, t]) => <li><span class="t-nom">{n}</span><span class="t-matn">{t}</span></li>)}
          </ul>
        </section>

        <section id="skim" aria-labelledby="skim-h">
          <h2 id="skim-h">Skimming va scanning</h2>
          <div class="juft">
            <div class="kul">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z" /></svg>
              <h3>Skimming</h3>
              <p><b>Nima uchun:</b> abzasning asosiy gʻoyasi.</p>
              <p class="ikkinchi-m">Sarlavha, birinchi va oxirgi gaplarni oʻqi. Tafsilotga toʻxtama.</p>
            </div>
            <div class="kul">
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3a8 8 0 1 0 0 16a8 8 0 1 0 0-16zM21 21l-4.3-4.3" /></svg>
              <h3>Scanning</h3>
              <p><b>Nima uchun:</b> aniq ism, son yoki sana.</p>
              <p class="ikkinchi-m">Savoldan kalit soʻzni ol, matnda oʻzini va sinonimini izla.</p>
            </div>
          </div>
        </section>

        <section id="tfng" aria-labelledby="tfng-h">
          <h2 id="tfng-h">True / False / Not Given</h2>
          <dl class="tfng">
            <div><dt>True</dt><dd>Matn xuddi shu narsani aytadi, boshqa soʻzlar bilan boʻlsa ham.</dd></div>
            <div><dt>False</dt><dd>Matn buning teskarisini aytadi.</dd></div>
            <div><dt>Not Given</dt><dd>Matnda bu haqda tasdiq ham, inkor ham yoʻq.</dd></div>
          </dl>

          <div class="qoida" role="group" aria-label="Qoida va misol">
            <div class="q-chap">
              <p class="ustki-kok">Qoida</p>
              <p class="q-asosiy">False uchun matnda zid gap boʻlishi shart. Uni topa olmasang, javob Not Given.</p>
              <p class="ikkinchi-m">Umumiy bilimingga suyanma: faqat matn hisob.</p>
            </div>
            <figure class="q-ong">
              <figcaption class="ustki-yorliq">Misol · passage parchasi (namuna)</figcaption>
              <p lang="en">The town library opened in 1998 in a former railway station. <mark>At first it held only a few thousand books, but its collection grew quickly after local schools began sending classes there every week.</mark> Today the building also hosts language clubs in the evenings.</p>
              <p class="belgi-izoh"><span aria-hidden="true" class="chiziqcha"></span>Koʻk tagchiziq: savolga eng yaqin gap</p>
            </figure>
          </div>

          <section class="mashq" aria-labelledby="mashq-h">
            <div class="m-bosh">
              <p id="mashq-h" class="ustki-kok">Mini-mashq</p>
              <span class="izoh">Ball hisoblanmaydi</span>
            </div>
            <p class="dawo" lang="en">"Most of the library's visitors today are school students."</p>
            <p class="izoh-m">Yuqoridagi parchaga koʻra bu gap qanday?</p>
            <div class="variantlar" role="radiogroup" aria-labelledby="mashq-h">
              <button type="button" role="radio" aria-checked="false" data-v="t">True</button>
              <button type="button" role="radio" aria-checked="false" data-v="f">False</button>
              <button type="button" role="radio" aria-checked="false" data-v="ng">Not Given</button>
            </div>
            <div class="javob" id="javob" aria-live="polite" hidden>
              <p class="j-sarlavha" id="j-sarlavha"></p>
              <p>Eng yaqin gap: <mark lang="en">its collection grew quickly after local schools began sending classes there every week.</mark></p>
              <p class="ikkinchi-m">Matnda maktablar sinflarni yuborgani aytilgan, lekin bugungi tashrifchilarning koʻpchiligi kim ekani haqida hech narsa yoʻq: na tasdiq, na inkor. Shuning uchun javob Not Given. False boʻlishi uchun matnda "koʻpchilik oʻquvchilar emas" degan zid gap boʻlishi kerak edi.</p>
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="qayta">Qayta urinish</button>
            </div>
          </section>
          <p class="dars-havolalar">Koʻproq mashq: <a href={yol('/uz/ielts/qollanma/reading/tfng/')}>True / False / Not Given darsi</a> va <a href={yol('/uz/ielts/qollanma/reading/sarlavhalar/')}>Matching headings darsi</a> (interaktiv, 5 tadan mashq).</p>
        </section>

        <section id="tuzoq" aria-labelledby="tuzoq-h">
          <h2 id="tuzoq-h">Tuzoqlar</h2>
          <ol class="tuzoqlar">
            {tuzoqlar.map(([b, t], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><p><b>{b}</b> <span class="ikkinchi-m">{t}</span></p></li>)}
          </ol>
        </section>

        <section id="vaqt" aria-labelledby="vaqt-h">
          <h2 id="vaqt-h">Vaqt strategiyasi</h2>
          <p class="izoh-m">Umumiy vaqt: 60 daqiqa, 3 boʻlim, javoblarni koʻchirish ham shu vaqt ichida (<a href={ie02.havola} rel="noopener">ielts.org</a>). Uni matnlar orasida oldindan boʻlib qoʻy va soatga qarab tur.</p>
          <div class="vaqt-karta">
            <div class="chiziqlar" aria-hidden="true"><span></span><span></span><span class="qora"></span></div>
            <div class="ulushlar">
              <span><b>1-matn</b><br /><span class="ikkinchi-m">taxminan 17 daqiqa</span></span>
              <span><b>2-matn</b><br /><span class="ikkinchi-m">taxminan 20 daqiqa</span></span>
              <span><b>3-matn</b><br /><span class="ikkinchi-m">taxminan 20 daqiqa + 3 daqiqa tekshiruv</span></span>
            </div>
            <p class="izoh">Bu Tayanch tavsiyasi, rasmiy qoida emas. Matnlar odatda qiyinlashib boradi, shuning uchun birinchisiga kamroq vaqt.</p>
          </div>
        </section>

        <section class="keyingi qora-kontekst" aria-labelledby="keyingi-h">
          <p class="ustki-yorliq kok-q">Keyingi qadam</p>
          <h2 id="keyingi-h">Bitta Reading testini soat bilan ishla</h2>
          <p class="k-matn">60 daqiqa, 40 savol. Tugagach har xatoning dalil gapini koʻrasan, xatolar takrorlashga tushadi.</p>
          <div class="k-tugmalar">
            <a class="t-tugma ielts-tugma--urgu" href={yol('/uz/ielts/mashq/reading/')}>Reading testini boshlash</a>
            <a class="t-tugma" href={yol('/uz/ielts/vosita/reja/')}>30 kunlik reja tuzish</a>
          </div>
        </section>
      </article>

      <nav class="mundarija" aria-label="Sahifa mundarijasi">
        <p class="ustki-yorliq">Mundarija</p>
        {mundarija.map((m, i) => <a href={`#${m.id}`} aria-current={i === 0 ? 'location' : undefined}>{m.nomi}</a>)}
      </nav>
    </div>

    <ManbaBlok
      manbalar={['IE02']}
      tekshirilgan="2026-11-05"
      keyingiTekshiruv="2026-12-05"
      tekshirilmagan={[
        "Savol turlari ro'yxati rasmiy manba bilan to'liq solishtirilmagan.",
        "General Training Reading formati (bu sahifa Academic bo'yicha).",
        "Mini-mashq parchasi Tayanch uchun yozilgan namuna, rasmiy IELTS matni emas.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  // Mini-mashq (T/F/NG)
  const TOGRI = 'ng';
  const tugmalar = [...document.querySelectorAll<HTMLButtonElement>('.variantlar button')];
  const javob = document.getElementById('javob')!;
  const tanla = (b: HTMLButtonElement) => {
    if (!javob.hidden) return;
    const togrimi = b.dataset.v === TOGRI;
    tugmalar.forEach((x) => {
      x.setAttribute('aria-checked', String(x === b));
      x.setAttribute('aria-disabled', 'true');
      x.classList.toggle('togri', x.dataset.v === TOGRI);
      x.classList.toggle('xato', x === b && !togrimi);
      x.classList.toggle('sust', x.dataset.v !== TOGRI && x !== b);
    });
    javob.classList.toggle('j-togri', togrimi);
    document.getElementById('j-sarlavha')!.textContent = togrimi ? "To'g'ri: Not Given" : "Bu safar emas. To'g'ri javob: Not Given";
    javob.hidden = false;
  };
  tugmalar.forEach((b) => b.addEventListener('click', () => tanla(b)));
  document.getElementById('qayta')!.addEventListener('click', () => {
    javob.hidden = true;
    tugmalar.forEach((x) => {
      x.setAttribute('aria-checked', 'false');
      x.removeAttribute('aria-disabled');
      x.classList.remove('togri', 'xato', 'sust');
    });
    tugmalar[0].focus();
  });

  // Mundarija: joriy bo'limni belgilash
  const havolalar = [...document.querySelectorAll<HTMLAnchorElement>('.mundarija a, .mundarija-tel a')];
  const bolimlar = [...new Set(havolalar.map((a) => a.hash))].map((hash) => document.getElementById(hash.slice(1))!);
  const yangila = () => {
    let joriy = 0;
    bolimlar.forEach((s, i) => { if (s.getBoundingClientRect().top < 160) joriy = i; });
    havolalar.forEach((a) => { if (a.hash === '#' + bolimlar[joriy].id) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
  };
  addEventListener('scroll', yangila, { passive: true });
  yangila();
  // Telefon mundarijasi: band bosilsa yopiladi
  const tel = document.querySelector<HTMLDetailsElement>('.mundarija-tel')!;
  tel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { tel.open = false; }));
</script>

<style>
  .qol { padding-top: var(--space-10); display: flex; flex-direction: column; gap: var(--space-10); max-width: calc(912px + 2 * var(--space-10)) !important; }
  .kok { color: var(--color-link); }
  .ustki-kok { margin: 0; font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-link); }
  .ustki-yorliq { margin: 0; font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ielts-text-muted); }
  .izoh { font-size: var(--text-small-size); font-weight: var(--font-weight-medium); color: var(--color-ielts-text-muted); }
  .izoh-m, .ikkinchi-m { line-height: 1.6; color: var(--color-ielts-text-muted); }
  .izoh-m a { color: var(--color-link); }
  h2 { font-size: var(--text-h1-size); font-weight: var(--font-weight-extrabold); line-height: 1.2; }
  .pill-ochiq { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); background: var(--color-ielts-tile); color: var(--color-link); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); }

  .bosh { display: flex; flex-direction: column; gap: var(--space-4); }
  .pill-qator { display: flex; align-items: center; gap: var(--space-3); }
  h1 { font-size: var(--text-display-size); line-height: 1.1; font-weight: var(--font-weight-extrabold); letter-spacing: var(--oraliq-sarlavha); }
  .lead { line-height: 1.6; color: var(--color-ielts-text-muted); max-width: 60ch; }

  .format { border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: hidden; }
  .format > div { padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .format > div + div { border-left: 1px solid var(--color-ielts-line); }
  .f-yorliq { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ielts-text-muted); }
  .f-yorliq svg { color: var(--color-link); }
  .f-qiymat { font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); }
  .f-izoh { font-size: var(--text-small-size); font-weight: var(--font-weight-medium); color: var(--color-ielts-text-muted); }

  .mundarija-tel { display: none; }

  .ikki { display: flex; gap: var(--space-10); align-items: flex-start; }
  .maqola { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--space-14); }
  .maqola > section { display: flex; flex-direction: column; gap: var(--space-4); scroll-margin-top: var(--space-6); }
  #tfng { gap: var(--space-5); }

  .turlar { list-style: none; margin: 0; padding: 0; border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); overflow: hidden; }
  .turlar li { padding: var(--space-4) var(--space-5); display: grid; grid-template-columns: 220px minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-1); }
  .turlar li + li { border-top: 1px solid var(--color-ielts-line); }
  .t-nom { font-weight: var(--font-weight-extrabold); }
  .t-matn { color: var(--color-ielts-text-muted); }

  .juft { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .kul { background: var(--color-ielts-tile); border-radius: var(--radius-lg); padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .kul > svg { color: var(--color-link); }
  .kul h3 { font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); }
  .kul p { line-height: 1.6; }

  .tfng { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .tfng div { display: flex; gap: var(--space-3); }
  .tfng dt { flex: 0 0 104px; font-weight: var(--font-weight-extrabold); }
  .tfng dd { margin: 0; color: var(--color-ielts-text-muted); line-height: 1.6; }

  .qoida { border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); overflow: hidden; }
  .q-chap { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .q-asosiy { font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); line-height: 1.4; }
  .q-ong { margin: 0; padding: var(--space-6); background: var(--color-ielts-tile); display: flex; flex-direction: column; gap: var(--space-3); }
  .q-ong p[lang] { line-height: 1.7; }
  mark {
    background: var(--color-ielts-tile); color: var(--color-ielts-text);
    text-decoration: underline; text-decoration-color: var(--color-ielts-accent-text); text-decoration-thickness: 2px; text-underline-offset: 4px;
    padding: 0 var(--space-1); border-radius: var(--radius-sm);
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .belgi-izoh { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-small-size); font-weight: var(--font-weight-medium); color: var(--color-ielts-text-muted); }
  .chiziqcha { width: 16px; height: 4px; border-radius: var(--radius-full); background: var(--color-ielts-accent-text); }

  /* Mini-mashq: sahifadagi yagona soya */
  .mashq { background: var(--color-ielts-bg); border: 1.5px solid var(--color-ielts-text); border-radius: var(--radius-lg); box-shadow: var(--shadow-glass); padding: var(--space-7); display: flex; flex-direction: column; gap: var(--space-5); }
  .m-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .dawo { font-size: var(--text-h3-size); line-height: 1.4; font-weight: var(--font-weight-extrabold); }
  .variantlar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .variantlar button {
    min-height: 56px; padding: 0 var(--space-3); border-radius: var(--radius-md);
    font: inherit; font-weight: var(--font-weight-extrabold); font-size: var(--text-body-size); cursor: pointer;
    background: var(--color-ielts-bg); color: var(--color-ielts-text); border: 2px solid var(--color-ielts-text);
  }
  @media (hover: hover) and (pointer: fine) { .variantlar button:hover { background: var(--color-ielts-tile); } }
  .variantlar button[aria-disabled='true'] { cursor: default; }
  .variantlar button.togri { background: var(--color-ielts-accent-text); border-color: var(--color-ielts-accent-text); color: var(--color-ielts-on-accent); }
  .variantlar button.xato { background: var(--color-ielts-tile); border-style: dashed; text-decoration: line-through; }
  .variantlar button.sust { color: var(--color-ielts-text-muted); border-color: var(--color-ielts-line); }
  .javob { border-radius: var(--radius-md); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); background: var(--color-ielts-tile); border: 1.5px dashed var(--color-ielts-text); }
