---
// IELTS Writing Task 2 qo'llanmasi. Qolip: Reading qo'llanmasi (Tayanch-IELTS-dizayn.md, "Qollanma" ekrani).
// Format, mezonlar, jazolar va ko'nikmalar: IE05 (ielts.org, 2026-11-12). Tuzilma, vaqt bo'linishi va tekshiruv
// savollari Tayanch tavsiyasi. Mavzular Tayanch uchun yozilgan namuna.
// Insho mashqi: matn faqat shu brauzerda (tayanch:ielts-writing-t2), hech qayerga yuborilmaydi, ball qo'yilmaydi.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { IKONKA, KALIT_IELTS_WRITING_T2 } from '../../../../../data/ieltsSahifalar';
import { manbalar } from '../../../../../data/manbalar';
import { yol } from '../../../../../lib/yol';

const ie05 = manbalar.find((x) => x.id === 'IE05')!;
const mundarija = [
  { id: 'mezonlar', nomi: 'Baholash mezonlari' },
  { id: 'turlar', nomi: 'Topshiriq nimani so\'raydi' },
  { id: 'tuzilma', nomi: 'Insho tuzilmasi' },
  { id: 'tuzoq', nomi: 'Tuzoqlar' },
  { id: 'mashq', nomi: 'Insho mashqi' },
];
const mezonlar = [
  ['Task response', "Topshiriq talabiga qanchalik aniq, o'rinli va to'liq javob berganing. Fikrni qanday rivojlantirganing, dalil va misollar (o'z tajribangdan ham bo'lishi mumkin)."],
  ['Coherence and cohesion', "Matn qanchalik aniq va ravon, fikrlar qanday tartiblangan. Fikrlar mantiqiy ketma-ketlikda, bog'lovchi vositalar (bog'lovchi so'zlar, olmoshlar) o'rinli ishlatilgan."],
  ['Lexical resource', "Qanchalik keng so'z boyligidan foydalanganing va so'zlarni qanchalik to'g'ri va o'rinli ishlatganing."],
  ['Grammatical range and accuracy', "Qanchalik xilma-xil grammatik tuzilmalar ishlatganing va ularni qanchalik to'g'ri va o'rinli qo'llaganing."],
];
const turlar = [
  ['Muammoga yechim', "Muammo beriladi: sabablarini va yechimini taklif qilasan."],
  ["Fikr bildirish va asoslash", "Bir qarash beriladi: qanchalik qo'shilishingni aytib, sabab va misol bilan asoslaysan."],
  ['Solishtirish', "Ikki qarash, dalil yoki oqibat solishtiriladi: ikkalasini muhokama qilib, o'z fikringni aytasan."],
  ["Baholash va e'tiroz", "G'oya yoki dalil beriladi: uning kuchli va zaif tomonini baholaysan."],
];
const tuzilma = [
  ['Kirish', "Savolni o'z so'zlaring bilan qayta ayt va pozitsiyangni bitta gapda aniq bildir.", '2–3 gap'],
  ['1-asosiy paragraf', "Bitta asosiy fikr: birinchi gapda ayt, keyin izohla va misol keltir.", '4–6 gap'],
  ['2-asosiy paragraf', "Ikkinchi fikr yoki qarama-qarshi qarash, xuddi shu tartibda.", '4–6 gap'],
  ['Xulosa', "Pozitsiyangni boshqa so'zlar bilan takrorla. Yangi fikr qo'shma.", '2–3 gap'],
];
const tuzoqlar = [
  ["Mavzudan chetga chiqish.", "Savol katta mavzuning bitta jihati haqida bo'lsa, faqat shu jihatni yoz. Mavzuga aloqasiz yozish jazolanadi.", true],
  ["Eslatma yoki ro'yxat ko'rinishida yozish.", "Javob to'liq gaplardan iborat yaxlit matn bo'lishi kerak: bullet va eslatmalar jazolanadi.", true],
  ["Boshqa manbadan ko'chirish.", "Ko'chirilgan matn qattiq jazolanadi.", true],
  ["250 so'zdan kam yozish.", "Matn juda qisqa bo'lsa, yuqori band uchun til dalili yetmasligi mumkin.", true],
  ["Juda uzun yozish.", "250 dan ko'p yozish jazolanmaydi, lekin oxirida tekshirishga vaqt qolmasligi va ba'zi fikrlar savoldan uzoqlashishi mumkin.", true],
  ["Savolning bir qismini unutish.", "\"Discuss both views and give your opinion\" kabi savolda ikkala qarash ham, o'z fikring ham bo'lishi kerak. Rejani shunga qarab tuz.", false],
] as const;
// Namuna mavzular: Tayanch uchun yozilgan, rasmiy IELTS savoli emas.
const mavzular = [
  { id: 'univ', tur: 'Solishtirish', matn: 'Some people believe that university education should be free for every student, while others think that students should pay for their own studies. Discuss both views and give your own opinion.' },
  { id: 'tirbandlik', tur: 'Muammoga yechim', matn: 'In many large cities, traffic congestion is becoming a serious problem. What are the main causes of this problem, and what measures could be taken to reduce it?' },
  { id: 'tanaffus', tur: "Fikr bildirish va asoslash", matn: 'Some people think that young people should spend a year working or travelling before they start university. To what extent do you agree or disagree?' },
];
// O'zini tekshirish savollari: IE05 dagi mezon ta'riflari asosida Tayanch tuzgan.
const tekshiruv = [
  { mezon: 'Task response', savollar: [
    ['tr1', "Kirishda savolga aniq javob (pozitsiyam) bor."],
    ['tr2', "Savolning hamma qismiga javob berdim (masalan, ikkala qarash va o'z fikrim)."],
    ['tr3', 'Har asosiy fikr izoh va misol bilan rivojlangan.'],
    ['tr4', "Hamma paragraf aynan shu savol haqida, umumiy mavzuga chiqib ketmadim."],
  ] },
  { mezon: 'Coherence and cohesion', savollar: [
    ['cc1', "Har paragrafda bitta asosiy fikr bor va u birinchi gapda aytilgan."],
    ['cc2', "Paragraflar ajratilgan va mantiqiy tartibda."],
    ['cc3', "Bog'lovchi so'zlar (however, as a result) o'rinli va me'yorida, har gap boshida emas."],
    ['cc4', "Takrorlanuvchi otlar o'rniga olmoshlar (this, they, it) to'g'ri ishlatilgan."],
  ] },
  { mezon: 'Lexical resource', savollar: [
    ['lr1', "Savoldagi iboralarni ko'chirmay, o'z so'zlarim bilan aytdim."],
    ['lr2', "Bitta so'zni qayta-qayta takrorlamadim."],
    ['lr3', "Ma'nosini aniq bilmagan \"chiroyli\" so'zni ishlatmadim."],
    ['lr4', 'Imlo xatolarini tekshirdim.'],
  ] },
  { mezon: 'Grammatical range and accuracy', savollar: [
    ['gr1', "Oddiy va qo'shma gaplar aralash (because, which, although)."],
    ['gr2', "Fe'l zamonlari va ega-kesim moslashuvi to'g'ri (he goes, they go)."],
    ['gr3', "Artikllar (a, an, the) va ko'plik shakllarini tekshirdim."],
    ['gr4', 'Har gap katta harf bilan boshlanib, tinish belgisi bilan tugaydi.'],
  ] },
];
const sozlama = { kalit: KALIT_IELTS_WRITING_T2, mavzular, tekshiruv: tekshiruv.map((g) => ({ mezon: g.mezon, idlar: g.savollar.map(([id, m]) => ({ id, matn: m })) })) };
---
<BolimQobiq
  title="Writing Task 2 qo'llanmasi · IELTS"
  description="IELTS Academic Writing Task 2: format, to'rt baholash mezoni, topshiriq turlari, insho tuzilmasi, tuzoqlar va so'z hisoblagichli insho mashqi."
  turi="qollanma"
  yol={["Qo'llanmalar"]}
  bolim="ielts"
  holat="qoralama"
>
  <div class="ichki qol">
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Qo'llanma</span><span class="pill-ochiq">ochiq</span></p>
      <h1>Writing Task 2: <span class="kok">aniq fikr, aniq tuzilma</span></h1>
      <p class="lead">Task 2 da bitta qarash, bahs yoki muammo haqida insho yozasan. Bu qo'llanma imtihonchi nimaga qarashini, inshoni qanday qurishni va o'zingni qanday tekshirishni ko'rsatadi.</p>
    </header>

    <section class="format" aria-label="Format kartasi">
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.writing} />Topshiriq</span><span class="f-qiymat">Task 2</span><span class="f-izoh">IELTS Academic</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20zM12 6v6l4 2" /></svg>Vaqt</span><span class="f-qiymat">40 daqiqa</span><span class="f-izoh">ko'pi bilan; Writing jami 60 daqiqa</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>Hajm</span><span class="f-qiymat">250 so'z</span><span class="f-izoh">kamida</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M5 8l-3 6h6zM19 8l-3 6h6zM5 8h14" /></svg>Og'irlik</span><span class="f-qiymat">2 baravar</span><span class="f-izoh">Task 1 ga nisbatan</span></div>
    </section>

    <details class="mundarija-tel">
      <summary>
        Mundarija
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <ul>{mundarija.map((m) => <li><a href={`#${m.id}`}>{m.nomi}</a></li>)}</ul>
    </details>

    <div class="ikki">
      <article class="maqola">
        <section id="mezonlar" aria-labelledby="mezonlar-h">
          <h2 id="mezonlar-h">Baholash mezonlari</h2>
          <p class="izoh-m">Inshoni sertifikatlangan imtihonchi to'rt mezon bo'yicha baholaydi (<a href={ie05.havola} rel="noopener">ielts.org</a>). Quyida har birining ta'rifi qisqa, o'z so'zlarimiz bilan.</p>
          <ul class="turlar">
            {mezonlar.map(([n, t]) => <li><span class="t-nom" lang="en">{n}</span><span class="t-matn">{t}</span></li>)}
          </ul>
        </section>

        <section id="turlar" aria-labelledby="turlar-h">
          <h2 id="turlar-h">Topshiriq nimani so'raydi</h2>
          <p class="izoh-m">Rasmiy sahifaga ko'ra Task 2 shu ko'nikmalarni tekshiradi. Darsliklarda ular ko'pincha "opinion", "discussion", "problem–solution" deb ataladi: bu nomlar rasmiy emas.</p>
          <div class="juft">
            {turlar.map(([n, t]) => <div class="kul"><h3>{n}</h3><p class="ikkinchi-m">{t}</p></div>)}
          </div>
        </section>

        <section id="tuzilma" aria-labelledby="tuzilma-h">
          <h2 id="tuzilma-h">Insho tuzilmasi</h2>
          <p class="izoh-m">Eng ko'p ishlatiladigan sxema: to'rt paragraf. Bu Tayanch tavsiyasi, rasmiy talab emas: imtihonchi tuzilmaning aniqligiga qaraydi, paragraflar soniga emas.</p>
          <ol class="tuzilma">
            {tuzilma.map(([n, t, h], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><div><p class="tz-bosh"><b>{n}</b><span class="izoh">{h}</span></p><p class="ikkinchi-m">{t}</p></div></li>)}
          </ol>
          <div class="vaqt-karta">
            <div class="chiziqlar" aria-hidden="true"><span></span><span class="qora"></span><span></span></div>
            <div class="ulushlar">
              <span><b>Reja</b><br /><span class="ikkinchi-m">taxminan 5 daqiqa</span></span>
              <span><b>Yozish</b><br /><span class="ikkinchi-m">taxminan 30 daqiqa</span></span>
              <span><b>Tekshirish</b><br /><span class="ikkinchi-m">taxminan 5 daqiqa</span></span>
            </div>
            <p class="izoh">40 daqiqani bo'lish Tayanch tavsiyasi, rasmiy qoida emas.</p>
          </div>
        </section>

        <section id="tuzoq" aria-labelledby="tuzoq-h">
          <h2 id="tuzoq-h">Tuzoqlar</h2>
          <ol class="tuzoqlar">
            {tuzoqlar.map(([b, t, rasmiy], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><p><b>{b}</b> <span class="ikkinchi-m">{t}</span>{rasmiy ? <span class="izoh"> (ielts.org)</span> : <span class="izoh"> (Tayanch tavsiyasi)</span>}</p></li>)}
          </ol>
        </section>

        <section id="mashq" class="mashq" aria-labelledby="mashq-h" data-sozlama={JSON.stringify(sozlama)}>
          <div class="m-bosh">
            <h2 id="mashq-h">Insho mashqi</h2>
            <span class="izoh">Ball qo'yilmaydi</span>
          </div>
          <p class="izoh-m">Mavzu tanla, yoz va o'zingni to'rt mezon bo'yicha tekshir. Matn faqat shu brauzerda saqlanadi, hech qayerga yuborilmaydi.</p>

          <div class="bosqich" id="b-mavzu">
            <p class="ustki-yorliq" id="mavzu-h">1. Mavzu tanla <span class="pill-namuna">Namuna</span></p>
            <div class="mavzular" role="group" aria-labelledby="mavzu-h">
              {mavzular.map((m) => (
                <button type="button" class="mavzu" aria-pressed="false" data-mavzu={m.id}>
                  <span class="m-tur">{m.tur}</span>
                  <span class="m-matn" lang="en">{m.matn}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="bosqich" id="b-yozish" hidden>
            <p class="ustki-yorliq">2. Yoz</p>
            <blockquote class="savol-matn" id="tanlangan-mavzu" lang="en"></blockquote>
            <div class="yozish-ust">
              <p class="hisob" id="hisob" aria-live="off"><b id="soz-soni">0</b> / 250 so'z</p>
              <div class="taymer">
                <span class="vaqt" id="vaqt" role="timer" aria-label="Qolgan vaqt">40:00</span>
                <button type="button" class="chiziq-tugma kichik-t" id="taymer-tugma">Taymerni boshlash</button>
              </div>
            </div>
            <p class="sr" id="elon" aria-live="polite"></p>
            <label class="sr" for="matn">Insho matni</label>
            <textarea id="matn" lang="en" rows="16" spellcheck="false" autocapitalize="sentences" placeholder="Inshoni shu yerga yoz…"></textarea>
            <p class="izoh" id="saqlash-holat">Qoralama shu brauzerda avtomatik saqlanadi.</p>
            <div class="tugmalar">
              <button type="button" class="katta-q asosiy-q" id="tekshirishga">O'zimni tekshirish</button>
              <button type="button" class="chiziq-tugma" id="mavzu-almashtir">Boshqa mavzu</button>
            </div>
            <p class="ogoh" id="qisqa-ogoh" hidden></p>
          </div>

          <div class="bosqich" id="b-tekshiruv" hidden>
            <p class="ustki-yorliq">3. O'zingni tekshir</p>
            <p class="izoh-m">Inshoni qayta o'qi va bajarilgan bandlarni belgila. Halol belgila: bu faqat o'zing uchun.</p>
            {tekshiruv.map((g) => (
              <fieldset class="t-guruh">
                <legend lang="en">{g.mezon}</legend>
                {g.savollar.map(([id, m]) => (
                  <button type="button" class="t-band" aria-pressed="false" data-band={id}>
                    <span class="katakcha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg></span>
                    <span>{m}</span>
                  </button>
                ))}
              </fieldset>
            ))}
            <div class="tugmalar">
              <button type="button" class="katta-q asosiy-q" id="xulosaga">Xulosani ko'rish</button>
              <button type="button" class="chiziq-tugma" id="matnga-1">Matnga qaytish</button>
            </div>
          </div>

          <div class="bosqich" id="b-xulosa" hidden>
            <p class="ustki-yorliq">4. Xulosa</p>
            <h3 id="xulosa-h" tabindex="-1">O'z-o'zini tekshirish natijasi</h3>
            <ul class="xulosa-mezon" id="xulosa-mezon"></ul>
            <div id="ishlash-blok">
              <p><b>Keyingi inshoda e'tibor ber:</b></p>
              <ul class="ishlash" id="ishlash"></ul>
            </div>
            <p class="izoh">Bu band emas: rasmiy band'ni faqat sertifikatlangan imtihonchi qo'yadi. Ro'yxat inshoni qayta ko'rib chiqish uchun.</p>
            <div class="tugmalar">
              <button type="button" class="chiziq-tugma" id="matnga-2">Matnga qaytish</button>
              <button type="button" class="chiziq-tugma" id="tekshiruvga">Belgilarni o'zgartirish</button>
            </div>
          </div>

          <div class="tozalash">
            <button type="button" class="matn-tugma" id="tozala">Qoralamani o'chirish</button>
            <span class="tasdiq" id="tasdiq" hidden>Insho matni va belgilar o'chirilsinmi?
              <button type="button" class="matn-tugma" id="tasdiq-ha">Ha, o'chirish</button>
              <button type="button" class="matn-tugma" id="tasdiq-yoq">Bekor qilish</button>
            </span>
          </div>
        </section>

        <section class="keyingi" aria-labelledby="keyingi-h">
          <p class="ustki-yorliq kok-q">Keyingi qadam</p>
          <h2 id="keyingi-h">Rasmiy namunadagi Task 2 ni 40 daqiqada yoz</h2>
          <p class="k-matn">Keyin yuqoridagi tekshiruv ro'yxatidan o'tkaz. Reja vositasi Writing kunlarini haftaga bo'lib beradi.</p>
          <div class="k-tugmalar">
            <a class="katta asosiy" href={yol('/uz/ielts/vosita/reja/')}>30 kunlik reja tuzish</a>
            <a class="katta qora-tugma" href={yol('/uz/ielts/#rasmiy')}>Rasmiy namunalar</a>
          </div>
        </section>
      </article>
      <nav class="mundarija" aria-label="Sahifa mundarijasi">
        <p class="ustki-yorliq">Mundarija</p>
        {mundarija.map((m, i) => <a href={`#${m.id}`} aria-current={i === 0 ? 'true' : undefined}>{m.nomi}</a>)}
      </nav>
    </div>

    <ManbaBlok
      manbalar={['IE05']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "Band descriptors (har mezon bo'yicha band qanday qo'yilishi) bu sahifada berilmagan.",
        "General Training Writing formati (bu sahifa Academic bo'yicha).",
        "Insho tuzilmasi, vaqt bo'linishi va tekshiruv savollari Tayanch tavsiyasi, rasmiy talab emas.",
        "Mashq mavzulari Tayanch uchun yozilgan namuna, rasmiy IELTS savoli emas.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  interface Mavzu { id: string; tur: string; matn: string }
  interface Sozlama { kalit: string; mavzular: Mavzu[]; tekshiruv: { mezon: string; idlar: { id: string; matn: string }[] }[] }
  type Bosqich = 'mavzu' | 'yozish' | 'tekshiruv' | 'xulosa';
  interface Holat {
    v: 1; mavzu: string | null; matn: string; bosqich: Bosqich; belgilar: string[];
    /** taymer: ishlayotganda tugash vaqti (epoch ms), to'xtaganda qolgan ms */
    tugash: number | null; qoldi: number;
  }
  const TOLIQ_MS = 40 * 60 * 1000;
  const MIN_SOZ = 250;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const mashq = $('mashq');
  const S = JSON.parse(mashq.dataset.sozlama || '{}') as Sozlama;
  const bosh = (): Holat => ({ v: 1, mavzu: null, matn: '', bosqich: 'mavzu', belgilar: [], tugash: null, qoldi: TOLIQ_MS });

  function oqi(): Holat {
    try {
      const x = JSON.parse(localStorage.getItem(S.kalit) ?? 'null') as Holat | null;
      if (!x || x.v !== 1 || typeof x.matn !== 'string' || !Array.isArray(x.belgilar)) return bosh();
      const mavzu = S.mavzular.some((m) => m.id === x.mavzu) ? x.mavzu : null;
      const bosqich: Bosqich = mavzu ? (['yozish', 'tekshiruv', 'xulosa'].includes(x.bosqich) ? x.bosqich : 'yozish') : 'mavzu';
      return {
        v: 1, mavzu, matn: x.matn.slice(0, 20000), bosqich,
        belgilar: x.belgilar.filter((b) => typeof b === 'string'),
        tugash: typeof x.tugash === 'number' ? x.tugash : null,
        qoldi: typeof x.qoldi === 'number' ? Math.max(0, Math.min(TOLIQ_MS, x.qoldi)) : TOLIQ_MS,
      };
    } catch { return bosh(); }
  }
  let h = oqi();
  let saqlashMumkin = true;
  function saqla() {
    try { localStorage.setItem(S.kalit, JSON.stringify(h)); saqlashMumkin = true; }
    catch { saqlashMumkin = false; }
    $('saqlash-holat').textContent = saqlashMumkin
      ? 'Qoralama shu brauzerda avtomatik saqlanadi.'
      : "Brauzer saqlashga ruxsat bermadi: sahifa yopilsa, matn yo'qoladi.";
  }

  // ---------- So'z soni ----------
  const sozSoni = (t: string) => (t.match(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu) ?? []).length;
  const matn = $<HTMLTextAreaElement>('matn');
  function hisobYangila() {
    const n = sozSoni(matn.value);
    $('soz-soni').textContent = String(n);
    $('hisob').classList.toggle('yetarli', n >= MIN_SOZ);
  }

  // ---------- Taymer ----------
  const vaqtEl = $('vaqt');
  const taymerTugma = $<HTMLButtonElement>('taymer-tugma');
  let tik: number | undefined;
  let oldingiDaqiqa: number | null = null;
  const qolgan = () => (h.tugash !== null ? Math.max(0, h.tugash - Date.now()) : h.qoldi);
  const mmss = (ms: number) => { const s = Math.ceil(ms / 1000); return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`; };
  function taymerChiz() {
    const q = qolgan();
    vaqtEl.textContent = mmss(q);
    vaqtEl.classList.toggle('kam', q <= 5 * 60 * 1000);
    const daqiqa = Math.ceil(q / 60000);
    if (h.tugash !== null && oldingiDaqiqa !== null && daqiqa !== oldingiDaqiqa && (daqiqa === 10 || daqiqa === 5)) {
      $('elon').textContent = `${daqiqa} daqiqa qoldi.`;
    }
    oldingiDaqiqa = daqiqa;
    if (h.tugash !== null && q === 0) {
      h.tugash = null; h.qoldi = 0; saqla();
      $('elon').textContent = "Vaqt tugadi. Yozishni davom ettirishing mumkin, lekin imtihonda bu yerda to'xtarding.";
    }
    taymerTugma.textContent = h.tugash !== null ? "To'xtatish" : h.qoldi === 0 ? 'Qaytadan boshlash' : h.qoldi < TOLIQ_MS ? 'Davom ettirish' : 'Taymerni boshlash';
    if (h.tugash === null && tik !== undefined) { clearInterval(tik); tik = undefined; }
    if (h.tugash !== null && tik === undefined) tik = window.setInterval(taymerChiz, 500);
  }
  taymerTugma.addEventListener('click', () => {
    if (h.tugash !== null) { h.qoldi = qolgan(); h.tugash = null; }
    else { if (h.qoldi === 0) h.qoldi = TOLIQ_MS; h.tugash = Date.now() + h.qoldi; }
    oldingiDaqiqa = null;
    saqla();
    taymerChiz();
  });

  // ---------- Bosqichlar ----------
  const bosqichlar: Record<Bosqich, HTMLElement> = { mavzu: $('b-mavzu'), yozish: $('b-yozish'), tekshiruv: $('b-tekshiruv'), xulosa: $('b-xulosa') };
  function korsat(b: Bosqich, fokus?: HTMLElement) {
    h.bosqich = b;
    (Object.keys(bosqichlar) as Bosqich[]).forEach((k) => { bosqichlar[k].hidden = k !== b; });
    // Mavzu tanlash yozish bilan birga emas: matn ustida tanlangan mavzu ko'rinadi.
    const m = S.mavzular.find((x) => x.id === h.mavzu);
    $('tanlangan-mavzu').textContent = m?.matn ?? '';
    document.querySelectorAll<HTMLButtonElement>('.mavzu').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.mavzu === h.mavzu)));
    document.querySelectorAll<HTMLButtonElement>('.t-band').forEach((x) => x.setAttribute('aria-pressed', String(h.belgilar.includes(x.dataset.band!))));
    if (b === 'xulosa') xulosaChiz();
    saqla();
    fokus?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('.mavzu').forEach((x) => x.addEventListener('click', () => {
    if (h.mavzu !== x.dataset.mavzu) { h.mavzu = x.dataset.mavzu!; h.belgilar = []; }
    korsat('yozish', matn);
  }));
  $('mavzu-almashtir').addEventListener('click', () => korsat('mavzu', document.querySelector<HTMLButtonElement>('.mavzu[aria-pressed="true"]') ?? undefined));

  let yozTaymer: number | undefined;
  matn.addEventListener('input', () => {
    hisobYangila();
    $('qisqa-ogoh').hidden = true;
    clearTimeout(yozTaymer);
    yozTaymer = window.setTimeout(() => { h.matn = matn.value; saqla(); }, 400);
  });
  addEventListener('pagehide', () => { if (h.matn !== matn.value) { h.matn = matn.value; saqla(); } });

  $('tekshirishga').addEventListener('click', () => {
    h.matn = matn.value;
    const n = sozSoni(matn.value);
    const ogoh = $('qisqa-ogoh');
    if (n < MIN_SOZ && ogoh.hidden) {
      ogoh.textContent = `Hozir ${n} so'z: imtihonda kamida ${MIN_SOZ} so'z kerak. Baribir tekshirmoqchi bo'lsang, tugmani yana bos.`;
      ogoh.hidden = false;
      saqla();
      return;
    }
    korsat('tekshiruv', document.querySelector<HTMLButtonElement>('.t-band') ?? undefined);
  });

  document.querySelectorAll<HTMLButtonElement>('.t-band').forEach((x) => x.addEventListener('click', () => {
    const id = x.dataset.band!;
    h.belgilar = h.belgilar.includes(id) ? h.belgilar.filter((b) => b !== id) : [...h.belgilar, id];
    x.setAttribute('aria-pressed', String(h.belgilar.includes(id)));
    saqla();
  }));

  function xulosaChiz() {
    const mez = $('xulosa-mezon');
    const ishlash = $('ishlash');
    mez.replaceChildren(...S.tekshiruv.map((g) => {
      const li = document.createElement('li');
      const n = g.idlar.filter((x) => h.belgilar.includes(x.id)).length;
      const nom = document.createElement('span'); nom.lang = 'en'; nom.textContent = g.mezon;
      const son = document.createElement('b'); son.textContent = `${n} / ${g.idlar.length}`;
      li.append(nom, son);
      return li;
    }));
    const qolgan = S.tekshiruv.flatMap((g) => g.idlar.filter((x) => !h.belgilar.includes(x.id)).map((x) => x.matn));
    ishlash.replaceChildren(...qolgan.map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
    $('ishlash-blok').hidden = qolgan.length === 0;
  }
  $('xulosaga').addEventListener('click', () => korsat('xulosa', $('xulosa-h')));
  $('matnga-1').addEventListener('click', () => korsat('yozish', matn));
  $('matnga-2').addEventListener('click', () => korsat('yozish', matn));
  $('tekshiruvga').addEventListener('click', () => korsat('tekshiruv', document.querySelector<HTMLButtonElement>('.t-band') ?? undefined));

  // ---------- O'chirish: sahifa ichidagi tasdiq ----------
  const tozala = $<HTMLButtonElement>('tozala');
  tozala.addEventListener('click', () => { $('tasdiq').hidden = false; tozala.hidden = true; $('tasdiq-yoq').focus(); });
  $('tasdiq-yoq').addEventListener('click', () => { $('tasdiq').hidden = true; tozala.hidden = false; tozala.focus(); });
  $('tasdiq-ha').addEventListener('click', () => {
    h = bosh();
    matn.value = '';
    hisobYangila();
    $('qisqa-ogoh').hidden = true;
    $('tasdiq').hidden = true; tozala.hidden = false;
    try { localStorage.removeItem(S.kalit); } catch { /* ruxsat yo'q */ }
    taymerChiz();
    korsat('mavzu', document.querySelector<HTMLButtonElement>('.mavzu') ?? undefined);
  });

  matn.value = h.matn;
  hisobYangila();
  taymerChiz();
  korsat(h.bosqich);

  // ---------- Mundarija: joriy bo'limni belgilash ----------
  const havolalar = [...document.querySelectorAll<HTMLAnchorElement>('.mundarija a')];
  const bolimlar = havolalar.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)!);
  const yangila = () => {
    let joriy = 0;
    bolimlar.forEach((s, i) => { if (s.getBoundingClientRect().top < 160) joriy = i; });
    havolalar.forEach((a, i) => { if (i === joriy) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
  };
  addEventListener('scroll', yangila, { passive: true });
  yangila();
  const tel = document.querySelector<HTMLDetailsElement>('.mundarija-tel')!;
  tel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { tel.open = false; }));
</script>

