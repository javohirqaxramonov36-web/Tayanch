---
// IELTS Writing Task 2 qo'llanmasi. Qolip: Reading qo'llanmasi (Tayanch-IELTS-dizayn.md, "Qollanma" ekrani).
// Format, mezonlar, jazolar va ko'nikmalar: IE05 (ielts.org, 2026-11-12). Tuzilma, vaqt bo'linishi va tekshiruv
// savollari Tayanch tavsiyasi. Mavzular Tayanch uchun yozilgan namuna.
// Insho mashqi: matn faqat shu brauzerda (tayanch:ielts-writing-t2), hech qayerga yuborilmaydi, ball qo'yilmaydi.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { IKONKA, KALIT_IELTS_WRITING_T2 } from '../../../../../data/ieltsSahifalar';
import { manbalar } from '../../../../../data/manbalar';
import { writingMavzular } from '../../../../../data/ielts/writingSavollar';
import { yol } from '../../../../../lib/yol';

const ie05 = manbalar.find((x) => x.id === 'IE05')!;
const mundarija = [
  { id: 'mezonlar', nomi: 'Assessment criteria' },
  { id: 'turlar', nomi: 'What the task asks' },
  { id: 'tuzilma', nomi: 'Essay structure' },
  { id: 'tuzoq', nomi: 'Traps' },
  { id: 'mashq', nomi: 'Essay practice' },
];
const mezonlar = [
  ['Task response', 'How clearly, relevantly and fully you answer what the task asks. How you develop your ideas, with support and examples (these can come from your own experience).'],
  ['Coherence and cohesion', 'How clear and fluent the text is and how the ideas are organised. Ideas follow a logical order, and linking devices (linking words, pronouns) are used appropriately.'],
  ['Lexical resource', 'How wide a range of vocabulary you use, and how accurately and appropriately you use words.'],
  ['Grammatical range and accuracy', 'How varied your grammatical structures are, and how accurately and appropriately you use them.'],
];
const turlar = [
  ['Solution to a problem', 'You are given a problem: you suggest its causes and a solution.'],
  ['Giving and justifying an opinion', 'You are given a view: you say how far you agree and support it with reasons and examples.'],
  ['Comparing', 'Two views, pieces of evidence or consequences are compared: you discuss both and give your own opinion.'],
  ['Evaluating and challenging', 'You are given an idea or argument: you assess its strengths and weaknesses.'],
];
const tuzilma = [
  ['Introduction', 'Restate the question in your own words and state your position clearly in one sentence.', '2–3 sentences'],
  ['Body paragraph 1', 'One main idea: state it in the first sentence, then explain it and give an example.', '4–6 sentences'],
  ['Body paragraph 2', 'A second idea or the opposing view, in the same order.', '4–6 sentences'],
  ['Conclusion', 'Restate your position in different words. Do not add a new idea.', '2–3 sentences'],
];
const tuzoqlar = [
  ['Going off topic.', 'If the question is about one aspect of a big topic, write only about that aspect. Writing off topic is penalised.', true],
  ['Writing in notes or lists.', 'Your answer must be a connected text of full sentences: bullet points and notes are penalised.', true],
  ['Copying from another source.', 'Copied text is heavily penalised.', true],
  ['Writing fewer than 250 words.', 'If the text is very short, there may not be enough evidence of your language for a high band.', true],
  ['Writing far too much.', 'Writing more than 250 words is not penalised, but you may run out of time to check at the end, and some ideas may drift away from the question.', true],
  ['Forgetting part of the question.', 'In a question like "Discuss both views and give your opinion", you need both views and your own opinion. Plan with this in mind.', false],
] as const;
// Namuna mavzular (Tayanch uchun yozilgan): src/data/ielts/writingSavollar.ts. Qo'llanmada birinchi uchtasi.
const mavzular = writingMavzular.slice(0, 3);
// O'zini tekshirish savollari: IE05 dagi mezon ta'riflari asosida Tayanch tuzgan.
const tekshiruv = [
  { mezon: 'Task response', savollar: [
    ['tr1', 'My introduction answers the question clearly (my position).'],
    ['tr2', 'I answered every part of the question (for example, both views and my own opinion).'],
    ['tr3', 'Each main idea is developed with an explanation and an example.'],
    ['tr4', 'Every paragraph is about this exact question; I did not drift into the general topic.'],
  ] },
  { mezon: 'Coherence and cohesion', savollar: [
    ['cc1', 'Each paragraph has one main idea, stated in the first sentence.'],
    ['cc2', 'The paragraphs are separated and in a logical order.'],
    ['cc3', 'Linking words (however, as a result) are used appropriately and not too often, not at the start of every sentence.'],
    ['cc4', 'Pronouns (this, they, it) are used correctly instead of repeating nouns.'],
  ] },
  { mezon: 'Lexical resource', savollar: [
    ['lr1', 'I did not copy phrases from the question; I used my own words.'],
    ['lr2', 'I did not repeat the same word again and again.'],
    ['lr3', 'I did not use a "fancy" word whose meaning I am not sure of.'],
    ['lr4', 'I checked my spelling.'],
  ] },
  { mezon: 'Grammatical range and accuracy', savollar: [
    ['gr1', 'I mixed simple and complex sentences (because, which, although).'],
    ['gr2', 'Verb tenses and subject–verb agreement are correct (he goes, they go).'],
    ['gr3', 'I checked articles (a, an, the) and plural forms.'],
    ['gr4', 'Every sentence starts with a capital letter and ends with punctuation.'],
  ] },
];
const sozlama = { kalit: KALIT_IELTS_WRITING_T2, mavzular, tekshiruv: tekshiruv.map((g) => ({ mezon: g.mezon, idlar: g.savollar.map(([id, m]) => ({ id, matn: m })) })) };
---
<BolimQobiq
  title="Writing Task 2 guide · IELTS"
  description="IELTS Academic Writing Task 2: the format, the four assessment criteria, task types, essay structure, traps and essay practice with a word counter."
  turi="qollanma"
  yol={["Writing"]}
  ota={yol('/uz/ielts/writing/')}
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki qol">
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Guide</span><span class="pill-ochiq">open</span></p>
      <h1>Writing Task 2: <span class="kok">a clear idea, a clear structure</span></h1>
      <p class="lead">In Task 2 you write an essay about a point of view, an argument or a problem. This guide shows what the examiner looks for, how to build the essay and how to check your own work.</p>
    </header>

    <section class="format" aria-label="Format card">
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.writing} />Task</span><span class="f-qiymat">Task 2</span><span class="f-izoh">IELTS Academic</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20zM12 6v6l4 2" /></svg>Time</span><span class="f-qiymat">40 minutes</span><span class="f-izoh">at most; Writing is 60 minutes in total</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>Length</span><span class="f-qiymat">250 words</span><span class="f-izoh">at least</span></div>
      <div><span class="f-yorliq"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M5 8l-3 6h6zM19 8l-3 6h6zM5 8h14" /></svg>Weight</span><span class="f-qiymat">twice</span><span class="f-izoh">as much as Task 1</span></div>
    </section>

    <details class="mundarija-tel">
      <summary>
        Contents
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <ul>{mundarija.map((m) => <li><a href={`#${m.id}`}>{m.nomi}</a></li>)}</ul>
    </details>

    <div class="ikki">
      <article class="maqola">
        <section id="mezonlar" aria-labelledby="mezonlar-h">
          <h2 id="mezonlar-h">Assessment criteria</h2>
          <p class="izoh-m">A certified examiner marks the essay on four criteria (<a href={ie05.havola} rel="noopener">ielts.org</a>). Below is a short description of each, in our own words.</p>
          <ul class="turlar">
            {mezonlar.map(([n, t]) => <li><span class="t-nom" lang="en">{n}</span><span class="t-matn">{t}</span></li>)}
          </ul>
        </section>

        <section id="turlar" aria-labelledby="turlar-h">
          <h2 id="turlar-h">What the task asks</h2>
          <p class="izoh-m">According to the official page, Task 2 tests these skills. Textbooks often call them "opinion", "discussion" and "problem–solution": these names are not official.</p>
          <div class="juft">
            {turlar.map(([n, t]) => <div class="kul"><h3>{n}</h3><p class="ikkinchi-m">{t}</p></div>)}
          </div>
        </section>

        <section id="tuzilma" aria-labelledby="tuzilma-h">
          <h2 id="tuzilma-h">Essay structure</h2>
          <p class="izoh-m">The most common plan: four paragraphs. This is Tayanch's suggestion, not an official requirement: the examiner looks at how clear the structure is, not at the number of paragraphs.</p>
          <ol class="tuzilma">
            {tuzilma.map(([n, t, h], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><div><p class="tz-bosh"><b>{n}</b><span class="izoh">{h}</span></p><p class="ikkinchi-m">{t}</p></div></li>)}
          </ol>
          <div class="vaqt-karta">
            <div class="chiziqlar" aria-hidden="true"><span></span><span class="qora"></span><span></span></div>
            <div class="ulushlar">
              <span><b>Plan</b><br /><span class="ikkinchi-m">about 5 minutes</span></span>
              <span><b>Write</b><br /><span class="ikkinchi-m">about 30 minutes</span></span>
              <span><b>Check</b><br /><span class="ikkinchi-m">about 5 minutes</span></span>
            </div>
            <p class="izoh">This split of the 40 minutes is Tayanch's suggestion, not an official rule.</p>
          </div>
        </section>

        <section id="tuzoq" aria-labelledby="tuzoq-h">
          <h2 id="tuzoq-h">Traps</h2>
          <ol class="tuzoqlar">
            {tuzoqlar.map(([b, t, rasmiy], i) => <li><span class="t-raqam" aria-hidden="true">{i + 1}</span><p><b>{b}</b> <span class="ikkinchi-m">{t}</span>{rasmiy ? <span class="izoh"> (ielts.org)</span> : <span class="izoh"> (Tayanch's advice)</span>}</p></li>)}
          </ol>
        </section>

        <section id="mashq" class="mashq" aria-labelledby="mashq-h" data-sozlama={JSON.stringify(sozlama)}>
          <div class="m-bosh">
            <h2 id="mashq-h">Essay practice</h2>
            <span class="izoh">Not scored</span>
          </div>
          <p class="izoh-m">Choose a topic, write, and check yourself against the four criteria. Your text is saved only in this browser and is not sent anywhere.</p>

          <div class="bosqich" id="b-mavzu">
            <p class="ustki-yorliq" id="mavzu-h">1. Choose a topic <span class="pill-namuna">Sample</span></p>
            <div class="mavzular" role="group" aria-labelledby="mavzu-h">
              {mavzular.map((m) => (
                <button type="button" class="mavzu" aria-pressed="false" data-mavzu={m.id}>
                  <span class="m-tur">{m.tur}</span>
                  <span class="m-matn" lang="en">{m.matn}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="bosqich" id="b-yozish" hidden>
            <p class="ustki-yorliq">2. Write</p>
            <blockquote class="savol-matn" id="tanlangan-mavzu" lang="en"></blockquote>
            <div class="yozish-ust">
              <p class="hisob" id="hisob" aria-live="off"><b id="soz-soni">0</b> / 250 words</p>
              <div class="taymer">
                <span class="vaqt" id="vaqt" role="timer" aria-label="Time left">40:00</span>
                <button type="button" class="t-tugma t-tugma--ikkinchi kichik-t" id="taymer-tugma">Start timer</button>
              </div>
            </div>
            <p class="sr" id="elon" aria-live="polite"></p>
            <label class="sr" for="matn">Essay text</label>
            <textarea id="matn" lang="en" rows="16" spellcheck="false" autocapitalize="sentences" placeholder="Write your essay here…"></textarea>
            <p class="izoh" id="saqlash-holat">Your draft is saved automatically in this browser.</p>
            <div class="tugmalar">
              <button type="button" class="t-tugma ielts-tugma--urgu" id="tekshirishga">Check myself</button>
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="mavzu-almashtir">Another topic</button>
            </div>
            <p class="ogoh" id="qisqa-ogoh" hidden></p>
          </div>

          <div class="bosqich" id="b-tekshiruv" hidden>
            <p class="ustki-yorliq">3. Check yourself</p>
            <p class="izoh-m">Read your essay again and tick the points you have done. Be honest: this is only for you.</p>
            {tekshiruv.map((g) => (
              <fieldset class="t-guruh">
                <legend lang="en">{g.mezon}</legend>
                {g.savollar.map(([id, m]) => (
                  <button type="button" class="t-band" aria-pressed="false" data-band={id}>
                    <span class="katakcha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg></span>
                    <span>{m}</span>
                  </button>
                ))}
              </fieldset>
            ))}
            <div class="tugmalar">
              <button type="button" class="t-tugma ielts-tugma--urgu" id="xulosaga">See summary</button>
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="matnga-1">Back to the text</button>
            </div>
          </div>

          <div class="bosqich" id="b-xulosa" hidden>
            <p class="ustki-yorliq">4. Summary</p>
            <h3 id="xulosa-h" tabindex="-1">Self-check result</h3>
            <ul class="xulosa-mezon" id="xulosa-mezon"></ul>
            <div id="ishlash-blok">
              <p><b>In your next essay, pay attention to:</b></p>
              <ul class="ishlash" id="ishlash"></ul>
            </div>
            <p class="izoh">This is not a band: only a certified examiner gives an official band. The list is for reviewing your essay.</p>
            <div class="tugmalar">
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="matnga-2">Back to the text</button>
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="tekshiruvga">Change ticks</button>
            </div>
          </div>

          <div class="tozalash">
            <button type="button" class="t-tugma t-tugma--ikkinchi" id="tozala">Delete draft</button>
            <span class="tasdiq" id="tasdiq" hidden>Delete the essay text and ticks?
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="tasdiq-ha">Yes, delete</button>
              <button type="button" class="t-tugma t-tugma--ikkinchi" id="tasdiq-yoq">Cancel</button>
            </span>
          </div>
        </section>

        <section class="keyingi" aria-labelledby="keyingi-h">
          <p class="ustki-yorliq kok-q">Next step</p>
          <h2 id="keyingi-h">Write an official sample Task 2 in 40 minutes</h2>
          <p class="k-matn">Then go through the checklist above. The plan tool spreads Writing days across the week.</p>
          <div class="k-tugmalar">
            <a class="t-tugma ielts-tugma--urgu" href={yol('/uz/ielts/vosita/reja/')}>Build a 30-day plan</a>
            <a class="t-tugma" href={yol('/uz/ielts/#rasmiy')}>Official samples</a>
          </div>
        </section>
      </article>
      <nav class="mundarija" aria-label="Page contents">
        <p class="ustki-yorliq">Contents</p>
        {mundarija.map((m, i) => <a href={`#${m.id}`} aria-current={i === 0 ? 'true' : undefined}>{m.nomi}</a>)}
      </nav>
    </div>

    <ManbaBlok
      manbalar={['IE05']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "The band descriptors (how a band is given for each criterion) are not on this page.",
        "The General Training Writing format (this page covers Academic).",
        "The essay structure, time split and checklist are Tayanch's suggestions, not official requirements.",
        "The practice topics are samples written for Tayanch, not official IELTS questions.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  interface Mavzu { id: string; tur: string; matn: string }
  interface Sozlama { kalit: string; mavzular: Mavzu[]; tekshiruv: { mezon: string; idlar: { id: string; matn: string }[] }[] }
  type Bosqich = 'mavzu' | 'yozish' | 'tekshiruv' | 'xulosa';
  interface Holat {
    v: 1; mavzu: string | null; matn: string; bosqich: Bosqich; belgilar: string[];
    /** taymer: ishlayotganda tugash vaqti (epoch ms), to'xtaganda qolgan ms */
    tugash: number | null; qoldi: number;
  }
  const TOLIQ_MS = 40 * 60 * 1000;
  const MIN_SOZ = 250;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const mashq = $('mashq');
  const S = JSON.parse(mashq.dataset.sozlama || '{}') as Sozlama;
  const bosh = (): Holat => ({ v: 1, mavzu: null, matn: '', bosqich: 'mavzu', belgilar: [], tugash: null, qoldi: TOLIQ_MS });

  function oqi(): Holat {
    try {
      const x = JSON.parse(localStorage.getItem(S.kalit) ?? 'null') as Holat | null;
      if (!x || x.v !== 1 || typeof x.matn !== 'string' || !Array.isArray(x.belgilar)) return bosh();
      const mavzu = S.mavzular.some((m) => m.id === x.mavzu) ? x.mavzu : null;
      const bosqich: Bosqich = mavzu ? (['yozish', 'tekshiruv', 'xulosa'].includes(x.bosqich) ? x.bosqich : 'yozish') : 'mavzu';
      return {
        v: 1, mavzu, matn: x.matn.slice(0, 20000), bosqich,
        belgilar: x.belgilar.filter((b) => typeof b === 'string'),
        tugash: typeof x.tugash === 'number' ? x.tugash : null,
        qoldi: typeof x.qoldi === 'number' ? Math.max(0, Math.min(TOLIQ_MS, x.qoldi)) : TOLIQ_MS,
      };
    } catch { return bosh(); }
  }
  let h = oqi();
  let saqlashMumkin = true;
  function saqla() {
    try { localStorage.setItem(S.kalit, JSON.stringify(h)); saqlashMumkin = true; }
    catch { saqlashMumkin = false; }
    $('saqlash-holat').textContent = saqlashMumkin
      ? 'Your draft is saved automatically in this browser.'
      : 'The browser did not allow saving: if you close the page, the text will be lost.';
  }

  // ---------- So'z soni ----------
  const sozSoni = (t: string) => (t.match(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu) ?? []).length;
  const matn = $<HTMLTextAreaElement>('matn');
  function hisobYangila() {
    const n = sozSoni(matn.value);
    $('soz-soni').textContent = String(n);
    $('hisob').classList.toggle('yetarli', n >= MIN_SOZ);
  }

  // ---------- Taymer ----------
  const vaqtEl = $('vaqt');
  const taymerTugma = $<HTMLButtonElement>('taymer-tugma');
  let tik: number | undefined;
  let oldingiDaqiqa: number | null = null;
  const qolgan = () => (h.tugash !== null ? Math.max(0, h.tugash - Date.now()) : h.qoldi);
  const mmss = (ms: number) => { const s = Math.ceil(ms / 1000); return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`; };
  function taymerChiz() {
    const q = qolgan();
    vaqtEl.textContent = mmss(q);
    vaqtEl.classList.toggle('kam', q <= 5 * 60 * 1000);
    const daqiqa = Math.ceil(q / 60000);
    if (h.tugash !== null && oldingiDaqiqa !== null && daqiqa !== oldingiDaqiqa && (daqiqa === 10 || daqiqa === 5)) {
      $('elon').textContent = `${daqiqa} minutes left.`;
    }
    oldingiDaqiqa = daqiqa;
    if (h.tugash !== null && q === 0) {
      h.tugash = null; h.qoldi = 0; saqla();
      $('elon').textContent = 'Time is up. You can keep writing, but in the test you would stop here.';
    }
    taymerTugma.textContent = h.tugash !== null ? 'Pause' : h.qoldi === 0 ? 'Start again' : h.qoldi < TOLIQ_MS ? 'Resume' : 'Start timer';
    if (h.tugash === null && tik !== undefined) { clearInterval(tik); tik = undefined; }
    if (h.tugash !== null && tik === undefined) tik = window.setInterval(taymerChiz, 500);
  }
  taymerTugma.addEventListener('click', () => {
    if (h.tugash !== null) { h.qoldi = qolgan(); h.tugash = null; }
    else { if (h.qoldi === 0) h.qoldi = TOLIQ_MS; h.tugash = Date.now() + h.qoldi; }
    oldingiDaqiqa = null;
    saqla();
    taymerChiz();
  });

  // ---------- Bosqichlar ----------
  const bosqichlar: Record<Bosqich, HTMLElement> = { mavzu: $('b-mavzu'), yozish: $('b-yozish'), tekshiruv: $('b-tekshiruv'), xulosa: $('b-xulosa') };
  function korsat(b: Bosqich, fokus?: HTMLElement) {
    h.bosqich = b;
    (Object.keys(bosqichlar) as Bosqich[]).forEach((k) => { bosqichlar[k].hidden = k !== b; });
    // Mavzu tanlash yozish bilan birga emas: matn ustida tanlangan mavzu ko'rinadi.
    const m = S.mavzular.find((x) => x.id === h.mavzu);
    $('tanlangan-mavzu').textContent = m?.matn ?? '';
    document.querySelectorAll<HTMLButtonElement>('.mavzu').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.mavzu === h.mavzu)));
    document.querySelectorAll<HTMLButtonElement>('.t-band').forEach((x) => x.setAttribute('aria-pressed', String(h.belgilar.includes(x.dataset.band!))));
    if (b === 'xulosa') xulosaChiz();
    saqla();
    fokus?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('.mavzu').forEach((x) => x.addEventListener('click', () => {
    if (h.mavzu !== x.dataset.mavzu) { h.mavzu = x.dataset.mavzu!; h.belgilar = []; }
    korsat('yozish', matn);
  }));
  $('mavzu-almashtir').addEventListener('click', () => korsat('mavzu', document.querySelector<HTMLButtonElement>('.mavzu[aria-pressed="true"]') ?? undefined));

  let yozTaymer: number | undefined;
  matn.addEventListener('input', () => {
    hisobYangila();
    $('qisqa-ogoh').hidden = true;
    clearTimeout(yozTaymer);
    yozTaymer = window.setTimeout(() => { h.matn = matn.value; saqla(); }, 400);
  });
  addEventListener('pagehide', () => { if (h.matn !== matn.value) { h.matn = matn.value; saqla(); } });

  $('tekshirishga').addEventListener('click', () => {
    h.matn = matn.value;
    const n = sozSoni(matn.value);
    const ogoh = $('qisqa-ogoh');
    if (n < MIN_SOZ && ogoh.hidden) {
      ogoh.textContent = `You have ${n} ${n === 1 ? 'word' : 'words'}: the test needs at least ${MIN_SOZ}. If you still want to check, press the button again.`;
      ogoh.hidden = false;
      saqla();
      return;
    }
    korsat('tekshiruv', document.querySelector<HTMLButtonElement>('.t-band') ?? undefined);
  });

  document.querySelectorAll<HTMLButtonElement>('.t-band').forEach((x) => x.addEventListener('click', () => {
    const id = x.dataset.band!;
    h.belgilar = h.belgilar.includes(id) ? h.belgilar.filter((b) => b !== id) : [...h.belgilar, id];
    x.setAttribute('aria-pressed', String(h.belgilar.includes(id)));
    saqla();
  }));

  function xulosaChiz() {
    const mez = $('xulosa-mezon');
    const ishlash = $('ishlash');
    mez.replaceChildren(...S.tekshiruv.map((g) => {
      const li = document.createElement('li');
      const n = g.idlar.filter((x) => h.belgilar.includes(x.id)).length;
      const nom = document.createElement('span'); nom.lang = 'en'; nom.textContent = g.mezon;
      const son = document.createElement('b'); son.textContent = `${n} / ${g.idlar.length}`;
      li.append(nom, son);
      return li;
    }));
    const qolgan = S.tekshiruv.flatMap((g) => g.idlar.filter((x) => !h.belgilar.includes(x.id)).map((x) => x.matn));
    ishlash.replaceChildren(...qolgan.map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
    $('ishlash-blok').hidden = qolgan.length === 0;
  }
  $('xulosaga').addEventListener('click', () => korsat('xulosa', $('xulosa-h')));
  $('matnga-1').addEventListener('click', () => korsat('yozish', matn));
  $('matnga-2').addEventListener('click', () => korsat('yozish', matn));
  $('tekshiruvga').addEventListener('click', () => korsat('tekshiruv', document.querySelector<HTMLButtonElement>('.t-band') ?? undefined));

  // ---------- O'chirish: sahifa ichidagi tasdiq ----------
  const tozala = $<HTMLButtonElement>('tozala');
  tozala.addEventListener('click', () => { $('tasdiq').hidden = false; tozala.hidden = true; $('tasdiq-yoq').focus(); });
  $('tasdiq-yoq').addEventListener('click', () => { $('tasdiq').hidden = true; tozala.hidden = false; tozala.focus(); });
  $('tasdiq-ha').addEventListener('click', () => {
    h = bosh();
    matn.value = '';
    hisobYangila();
    $('qisqa-ogoh').hidden = true;
    $('tasdiq').hidden = true; tozala.hidden = false;
    try { localStorage.removeItem(S.kalit); } catch { /* ruxsat yo'q */ }
    taymerChiz();
    korsat('mavzu', document.querySelector<HTMLButtonElement>('.mavzu') ?? undefined);
  });

  matn.value = h.matn;
  hisobYangila();
  taymerChiz();
  korsat(h.bosqich);

  // ---------- Mundarija: joriy bo'limni belgilash ----------
  const havolalar = [...document.querySelectorAll<HTMLAnchorElement>('.mundarija a')];
  const bolimlar = havolalar.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)!);
  const yangila = () => {
    let joriy = 0;
    bolimlar.forEach((s, i) => { if (s.getBoundingClientRect().top < 160) joriy = i; });
    havolalar.forEach((a, i) => { if (i === joriy) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
  };
  addEventListener('scroll', yangila, { passive: true });
  yangila();
  const tel = document.querySelector<HTMLDetailsElement>('.mundarija-tel')!;
  tel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { tel.open = false; }));
</script>

