---
// IELTS Listening "Harf va raqam diktanti": brauzer ovozi (src/lib/ielts/ovoz.ts) ism harflari, telefon raqami,
// sana/vaqt va narx/o'lchamni o'qiydi, o'quvchi yozadi. Savollar: src/data/ielts/raqamToplamlar.ts ("Namuna").
// Tekshirish: src/lib/ielts/raqamTekshir.ts (sana qoidasi ID03). Holatlar: tanlash -> savol -> tekshirildi -> natija.
// Eng yaxshi natija: tayanch:ielts-raqamlar.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { raqamToplamlar } from '../../../../../data/ielts/raqamToplamlar';
import { yol } from '../../../../../lib/yol';

const IK = {
  tinglash: '<path d="M11 5L6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/>',
  oq: '<path d="M9 6l6 6-6 6"/>',
  info: '<path d="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 8v5M12 16.5v.5"/>',
};
---
<BolimQobiq
  title="Letters and numbers dictation · IELTS"
  description="Practice for IELTS Listening Part 1: listen and write spelled-out names, phone numbers, dates, times and prices."
  turi="mashq"
  bolim="ielts"
  yol={['Listening']}
  ota={yol('/uz/ielts/listening/')}
  holat="chop-etilgan"
>
  <div class="ichki raqam">
    <header class="bosh">
      <p class="ustki-kok">Practice · Listening</p>
      <h1>Letters and numbers dictation</h1>
      <p class="lead">
        In Part 1 of IELTS Listening, a name is often spelled out, or a phone number, date or price is asked for.
        Listen and write what you hear. You can write a date as 12 March or March 12.
      </p>
      <p class="eslatma">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IK.info} />
        <span><strong>Sample.</strong> The names, numbers and sentences were written by Tayanch. Your browser reads them aloud; this is not real IELTS audio.</span>
      </p>
    </header>

    <p id="ovoz-yoq" class="ogoh" role="status" hidden>
      No English voice was found in your browser, so the spoken sentence is shown as text: write it as numbers or letters.
    </p>

    <section id="toplamlar" aria-labelledby="toplam-h">
      <h2 id="toplam-h" class="bolim-sarlavha">Choose a set</h2>
      <ul class="toplam-royxat">
        {raqamToplamlar.map((t) => (
          <li>
            <button type="button" class="toplam" data-toplam={t.id}>
              <span class="t-matn">
                <strong class="t-nom">{t.nomi}</strong>
                <span class="t-tavsif">{t.tavsif}</span>
              </span>
              <span class="t-meta">
                <span>{t.savollar.length} {t.savollar.length === 1 ? 'question' : 'questions'}</span>
                <span class="t-eng" data-eng={t.id}></span>
              </span>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IK.oq} />
            </button>
          </li>
        ))}
      </ul>
    </section>

    <section id="mashq" class="panel" aria-labelledby="mashq-sarlavha" hidden>
      <div class="panel-ust">
        <h2 id="mashq-sarlavha" class="bolim-sarlavha"></h2>
        <p class="hisob" id="hisob"></p>
      </div>
      <div class="progress" aria-hidden="true"><span id="progress-ichi"></span></div>

      <form id="raqam-forma" novalidate autocomplete="off">
        <div class="tinglash-qator">
          <button type="button" class="t-tugma t-tugma--ikkinchi" id="tinglash">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IK.tinglash} />
            <span id="tinglash-matn">Listen</span>
          </button>
          <p class="ovozsiz-sorov" id="ovozsiz-sorov" lang="en" hidden></p>
        </div>

        <label for="javob" class="javob-yorliq" id="javob-yorliq">Answer</label>
        <div class="maydon">
          <span class="birlik" id="birlik-oldin" aria-hidden="true" hidden></span>
          <input
            id="javob"
            name="javob"
            type="text"
            lang="en"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="done"
            aria-describedby="xabar"
          />
          <span class="birlik" id="birlik-keyin" aria-hidden="true" hidden></span>
        </div>
        <div id="xabar" class="xabar" role="status" aria-live="polite"></div>

        <div class="amallar">
          <button type="submit" class="t-tugma ielts-tugma--urgu" id="asosiy-tugma">Check</button>
          <button type="button" class="t-tugma t-tugma--ikkinchi" id="toplamga-qaytish">Back to the sets</button>
        </div>
      </form>
    </section>

    <section id="natija" class="panel" aria-labelledby="natija-h" hidden>
      <h2 id="natija-h" class="bolim-sarlavha" tabindex="-1">Result</h2>
      <p class="natija-son" id="natija-son"></p>
      <div id="xatolar-blok" hidden>
        <h3 class="kichik-sarlavha">Wrong answers</h3>
        <ul id="xatolar" class="xatolar"></ul>
      </div>
      <div class="amallar">
        <button type="button" class="t-tugma ielts-tugma--urgu" id="xatolarni-qayta">Practise the mistakes again</button>
        <button type="button" class="t-tugma t-tugma--ikkinchi" id="qaytadan">Start the set again</button>
        <button type="button" class="t-tugma t-tugma--ikkinchi" id="boshqa">Another set</button>
      </div>
    </section>

    <ManbaBlok
      manbalar={['ID03', 'ID02']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "The names, numbers and sentences were written by Tayanch: there is no guarantee these exact items appear in IELTS.",
        "The pronunciation comes from the browser voice; it varies by device and is not real IELTS audio.",
        "Whether writing a time as 7.30 or 7:30 is accepted has not been checked separately against an official source.",
        "The explanations and rules are under review by the author.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  import { raqamToplamlar, KALIT_IELTS_RAQAMLAR, type RaqamSavol, type RaqamToplam } from '../../../../../data/ielts/raqamToplamlar';
  import { ingOvozYarat } from '../../../../../lib/ielts/ovoz';
  import { tekshir as javobTekshir, javobMatni } from '../../../../../lib/ielts/raqamTekshir';

  interface Javob { savol: RaqamSavol; yozgan: string; togri: boolean }
  interface Saqlangan { v: 1; toplamlar: Record<string, { eng: number; jami: number; sana: string }> }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const toplamBolim = $('toplamlar');
  const mashqBolim = $('mashq');
  const natijaBolim = $('natija');
  const sarlavha = $('mashq-sarlavha');
  const hisob = $('hisob');
  const progressIchi = $('progress-ichi');
  const forma = $<HTMLFormElement>('raqam-forma');
  const tinglashTugma = $<HTMLButtonElement>('tinglash');
  const tinglashMatn = $('tinglash-matn');
  const ovozsizSorov = $('ovozsiz-sorov');
  const javobYorliq = $('javob-yorliq');
  const javobInput = $<HTMLInputElement>('javob');
  const birlikOldin = $('birlik-oldin');
  const birlikKeyin = $('birlik-keyin');
  const xabar = $('xabar');
  const asosiyTugma = $<HTMLButtonElement>('asosiy-tugma');
  const natijaSon = $('natija-son');
  const xatolarBlok = $('xatolar-blok');
  const xatolarRoyxat = $('xatolar');
  const xatolarniQayta = $<HTMLButtonElement>('xatolarni-qayta');

  // ---------- Saqlash (faqat eng yaxshi natija) ----------
  function oqi(): Saqlangan {
    try {
      const x = JSON.parse(localStorage.getItem(KALIT_IELTS_RAQAMLAR) ?? 'null');
      if (x && x.v === 1 && typeof x.toplamlar === 'object') return x;
    } catch { /* bo'sh holat */ }
    return { v: 1, toplamlar: {} };
  }
  function yoz(s: Saqlangan) {
    try { localStorage.setItem(KALIT_IELTS_RAQAMLAR, JSON.stringify(s)); } catch { /* xotira yopiq */ }
  }
  function engYaxshilarniKorsat() {
    const s = oqi();
    document.querySelectorAll<HTMLElement>('[data-eng]').forEach((el) => {
      const r = s.toplamlar[el.dataset.eng ?? ''];
      el.textContent = r ? `Best: ${r.eng}/${r.jami}` : '';
    });
  }

  // ---------- Mashq holati ----------
  let toplam: RaqamToplam | null = null;
  let navbat: RaqamSavol[] = [];
  let i = 0;
  let tekshirildi = false;
  let javoblar: Javob[] = [];
  let toliq = true; // to'liq to'plam (eng yaxshi natija faqat shunda yoziladi)

  // ---------- Ovoz ----------
  let ovozsiz = !('speechSynthesis' in window);
  function ovozHolatiniKorsat() {
    $('ovoz-yoq').hidden = !ovozsiz;
    tinglashTugma.hidden = ovozsiz;
    ovozsizSorov.hidden = !ovozsiz;
    if (navbat.length && ovozsiz) ovozsizSorov.textContent = navbat[i].aytiladi.join(' ');
  }
  const ovoz = ingOvozYarat((yoq) => { ovozsiz = yoq; ovozHolatiniKorsat(); });
  let tinglashSoni = 0;
  function gapir() {
    if (ovozsiz || !navbat.length) return;
    ovoz.gapir(navbat[i].aytiladi, tinglashSoni > 0);
    tinglashSoni++;
    tinglashMatn.textContent = 'Listen again (slower)';
  }

  /** To'g'ri javob birligi bilan: £12.50, 2.75 m */
  function korinish(s: RaqamSavol) {
    let m = javobMatni(s.javob);
    if (s.javob.tur === 'son' && s.oldin === '£' && !Number.isInteger(s.javob.qiymat)) m = s.javob.qiymat.toFixed(2);
    return `${s.oldin ?? ''}${m}${s.keyin ? ` ${s.keyin}` : ''}`;
  }

  function boshla(t: RaqamToplam, savollar: RaqamSavol[], toliqMi: boolean) {
    toplam = t; navbat = savollar; i = 0; javoblar = []; toliq = toliqMi;
    sarlavha.textContent = toliqMi ? t.nomi : `${t.nomi}: mistakes`;
    // Telefonda mos klaviatura; ismlarda avtotuzatish va bosh harf o'chiq (atributlar HTML'da).
    javobInput.inputMode = t.klaviatura;
    toplamBolim.hidden = true; natijaBolim.hidden = true; mashqBolim.hidden = false;
    savolniKorsat();
    gapir();
  }

  function savolniKorsat() {
    const s = navbat[i];
    tekshirildi = false;
    tinglashSoni = 0;
    tinglashMatn.textContent = 'Listen';
    javobYorliq.textContent = s.kontekst;
    birlikOldin.textContent = s.oldin ?? '';
    birlikOldin.hidden = !s.oldin;
    birlikKeyin.textContent = s.keyin ?? '';
    birlikKeyin.hidden = !s.keyin;
    javobInput.setAttribute('aria-label', `${s.kontekst}${s.oldin ? `, in ${s.oldin}` : ''}${s.keyin ? `, in ${s.keyin}` : ''}`);
    javobInput.value = '';
    javobInput.readOnly = false;
    javobInput.removeAttribute('aria-invalid');
    xabar.replaceChildren();
    xabar.className = 'xabar';
    asosiyTugma.textContent = 'Check';
    hisob.textContent = `${i + 1} / ${navbat.length}`;
    progressIchi.style.transform = `scaleX(${i / navbat.length})`;
    ovozHolatiniKorsat();
    javobInput.focus();
  }

  // DS: holat belgisi chiziqli inline SVG (currentColor), so'z yonida; emoji/belgi matni emas
  function holatIkonka(togri: boolean) {
    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24'); svg.setAttribute('fill', 'none'); svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '2.5'); svg.setAttribute('stroke-linecap', 'round'); svg.setAttribute('stroke-linejoin', 'round');
    const p = document.createElementNS(ns, 'path');
    p.setAttribute('d', togri ? 'M5 12.5l4.5 4.5L19 7.5' : 'M6 6l12 12M18 6L6 18');
    svg.append(p);
    const s = document.createElement('span');
    s.className = 'x-belgi'; s.setAttribute('aria-hidden', 'true'); s.append(svg);
    return s;
  }
  function qism(teg: string, matn: string, sinf?: string, til?: string) {
    const el = document.createElement(teg);
    el.textContent = matn;
    if (sinf) el.className = sinf;
    if (til) el.lang = til;
    return el;
  }

  function tekshir() {
    const yozgan = javobInput.value;
    if (!yozgan.trim()) {
      xabar.replaceChildren(qism('p', 'Type your answer first.'));
      xabar.className = 'xabar xabar-ogoh';
      javobInput.focus();
      return;
    }
    const s = navbat[i];
    const togri = javobTekshir(yozgan, s.javob);
    javoblar.push({ savol: s, yozgan: yozgan.trim(), togri });
    tekshirildi = true;
    javobInput.readOnly = true;
    javobInput.setAttribute('aria-invalid', String(!togri));

    const qatorlar: HTMLElement[] = [];
    const bosh = document.createElement('p');
    bosh.className = 'x-bosh';
    const belgi = holatIkonka(togri);
    belgi.setAttribute('aria-hidden', 'true');
    bosh.append(belgi, qism('strong', togri ? 'Correct.' : 'Not quite.'));
    qatorlar.push(bosh);

    const javobQator = document.createElement('p');
    javobQator.append(qism('span', 'Correct answer: '), qism('strong', korinish(s), 'x-soz', 'en'));
    qatorlar.push(javobQator);
    if (!togri) {
      const siz = document.createElement('p');
      siz.append(qism('span', 'You wrote: '), qism('s', yozgan.trim(), 'x-xato', 'en'));
      qatorlar.push(siz);
      if (s.qoida) qatorlar.push(qism('p', s.qoida, 'x-maslahat'));
    }
    if (!ovozsiz) {
      const eshitildi = document.createElement('p');
      eshitildi.className = 'x-mano';
      eshitildi.append(qism('span', 'What was said: '), qism('span', s.aytiladi.join(' '), undefined, 'en'));
      qatorlar.push(eshitildi);
    }

    xabar.replaceChildren(...qatorlar);
    xabar.className = togri ? 'xabar xabar-togri' : 'xabar xabar-xato';
    asosiyTugma.textContent = i === navbat.length - 1 ? 'See the result' : 'Next question';
  }

  function natijaniKorsat() {
    ovoz.toxtat();
    const togriSoni = javoblar.filter((j) => j.togri).length;
    const xatolar = javoblar.filter((j) => !j.togri);
    natijaSon.textContent = `${togriSoni} of ${javoblar.length} correct.`;
    xatolarRoyxat.replaceChildren(...xatolar.map((j) => {
      const li = document.createElement('li');
      const oq = qism('span', ' → ');
      oq.setAttribute('aria-hidden', 'true');
      li.append(
        qism('span', `${j.savol.kontekst}: `, 'x-mano'),
        qism('s', j.yozgan, 'x-xato', 'en'), oq, qism('span', ', correct: ', 'ekranda-yoq'),
        qism('strong', korinish(j.savol), undefined, 'en'),
      );
      return li;
    }));
    xatolarBlok.hidden = xatolar.length === 0;
    xatolarniQayta.hidden = xatolar.length === 0;

    if (toliq && toplam) {
      const s = oqi();
      const oldin = s.toplamlar[toplam.id];
      if (!oldin || togriSoni > oldin.eng) {
        s.toplamlar[toplam.id] = { eng: togriSoni, jami: javoblar.length, sana: new Date().toISOString().slice(0, 10) };
        yoz(s);
      }
      engYaxshilarniKorsat();
    }
    progressIchi.style.transform = 'scaleX(1)';
    mashqBolim.hidden = true;
    natijaBolim.hidden = false;
    $('natija-h').focus();
  }

  function royxatgaQayt() {
    ovoz.toxtat();
    mashqBolim.hidden = true;
    natijaBolim.hidden = true;
    toplamBolim.hidden = false;
    const btn = toplam ? document.querySelector<HTMLButtonElement>(`[data-toplam="${toplam.id}"]`) : null;
    (btn ?? $('toplam-h')).focus();
  }

  // ---------- Hodisalar ----------
  document.querySelectorAll<HTMLButtonElement>('[data-toplam]').forEach((b) => {
    b.addEventListener('click', () => {
      const t = raqamToplamlar.find((x) => x.id === b.dataset.toplam);
      if (t) boshla(t, t.savollar, true);
    });
  });
  tinglashTugma.addEventListener('click', () => { gapir(); javobInput.focus(); });
  forma.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!tekshirildi) { tekshir(); return; }
    i++;
    if (i >= navbat.length) { natijaniKorsat(); return; }
    savolniKorsat();
    gapir();
  });
  $('toplamga-qaytish').addEventListener('click', royxatgaQayt);
  $('boshqa').addEventListener('click', royxatgaQayt);
  $('qaytadan').addEventListener('click', () => { if (toplam) boshla(toplam, toplam.savollar, true); });
  xatolarniQayta.addEventListener('click', () => {
    if (!toplam) return;
    boshla(toplam, javoblar.filter((j) => !j.togri).map((j) => j.savol), false);
  });

  engYaxshilarniKorsat();
  ovozHolatiniKorsat();
</script>

<style>
  .raqam { padding-top: var(--space-10); display: flex; flex-direction: column; gap: var(--space-8); max-width: var(--size-measure); }
  .bosh { display: flex; flex-direction: column; gap: var(--space-4); }
  .bosh p { margin: 0; }
  .ustki-kok { font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-link); }
  h1 { font-size: var(--text-h1-size); line-height: 1.1; font-weight: var(--font-weight-extrabold); }
  .lead { line-height: 1.6; color: var(--color-ielts-text-muted); max-width: 60ch; }
  .eslatma, .ogoh {
    align-self: flex-start; margin: 0; padding: var(--space-2) var(--space-4); border-radius: var(--radius-md);
    background: var(--color-warning-subtle); color: var(--color-warning-text);
    display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-small-size); font-weight: var(--font-weight-medium); line-height: 1.5;
  }
  .eslatma svg { flex: none; }
  .ogoh[hidden], .panel[hidden], section[hidden] { display: none; }

  .bolim-sarlavha { margin: 0 0 var(--space-4); font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); }
  .kichik-sarlavha { margin: 0 0 var(--space-2); font-size: var(--text-body-size); font-weight: var(--font-weight-extrabold); }

  /* To'plamlar: ro'yxat qatorlari (bir xil kartalar qatori emas) */
  .toplam-royxat { list-style: none; margin: 0; padding: var(--space-2); display: flex; flex-direction: column; gap: var(--space-1); background: var(--color-ielts-tile); border-radius: var(--radius-lg); }
  .toplam {
    width: 100%; min-height: var(--control-height-lg); padding: var(--space-3) var(--space-4); border: 0; border-radius: var(--radius-md);
    background: transparent; color: var(--color-ielts-text); font: inherit; text-align: left; cursor: pointer;
    display: flex; align-items: center; gap: var(--space-4);
  }
  .toplam:hover { background: var(--color-ielts-surface); }
  .t-matn { flex: 1; display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .t-nom { font-weight: var(--font-weight-extrabold); }
  .t-tavsif { font-size: var(--text-small-size); color: var(--color-ielts-text-muted); }
  .t-meta { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-1); font-size: var(--text-small-size); color: var(--color-ielts-text-muted); white-space: nowrap; }
  .t-eng { font-weight: var(--font-weight-bold); color: var(--color-ielts-text); }
  .toplam svg { flex: none; color: var(--color-ielts-text-muted); }

  /* Mashq paneli */
  .panel { padding: var(--space-6); border-radius: var(--radius-lg); background: var(--color-ielts-surface); box-shadow: var(--shadow-glass); display: flex; flex-direction: column; gap: var(--space-4); }
  .panel-ust { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .panel-ust .bolim-sarlavha { margin: 0; }
  .hisob { margin: 0; font-weight: var(--font-weight-bold); color: var(--color-ielts-text-muted); font-variant-numeric: tabular-nums; }
  .progress { height: var(--space-2); border-radius: var(--radius-full); background: var(--color-ielts-tile); overflow: hidden; }
  /* DS harakat: faqat transform (width emas). To'liq kenglik, scaleX bilan to'ladi */
  .progress span { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: left center; background: var(--color-ielts-accent-text); transition: transform var(--duration-base) var(--ease-state); }

  form { display: flex; flex-direction: column; gap: var(--space-3); }
  .tinglash-qator { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .ovozsiz-sorov { margin: 0; font-size: var(--font-size-body-d); font-weight: var(--font-weight-bold); }
  .javob-yorliq { font-weight: var(--font-weight-bold); margin-top: var(--space-2); }
  #javob {
    min-height: var(--control-height-lg); padding: 0 var(--space-4); border: var(--border-width-2) solid var(--color-ielts-text-muted); border-radius: var(--radius-md);
    background: var(--color-ielts-bg); color: var(--color-ielts-text); font: inherit; font-size: var(--font-size-body-d); font-weight: var(--font-weight-semibold);
  }
  #javob:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); border-color: var(--color-ielts-text); }
  #javob[readonly] { background: var(--color-ielts-tile); }
