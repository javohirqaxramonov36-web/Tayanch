---
// IELTS Writing Task 2: insho yozish va AI bilan TAXMINIY baholash. Spetsifikatsiya: docs/ielts-writing-baho.md.
// Holatlar: yozish -> yuborilmoqda -> natija | xato. Qoralama: tayanch:ielts-writing-qoralama (faqat shu brauzerda).
// Baholash faqat hisob bilan (Edge Function ielts-writing-baho, kunlik bepul limit). Natijalar hisobda (RLS).
// Mavzular: src/data/ielts/writingSavollar.ts ("Namuna"). Format faktlari: IE05.
// Dev mock: `npm run dev`, ?mock=ok | kesh | limit | yopiq | xato | kirmagan.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { writingMavzular } from '../../../../../data/ielts/writingSavollar';
import { yol } from '../../../../../lib/yol';

const IK = {
  info: '<path d="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 8v5M12 16.5v.5"/>',
};
---
<BolimQobiq
  title="Writing Task 2 baholash · IELTS"
  description="IELTS Writing Task 2 inshosini yozing: AI to'rt mezon bo'yicha taxminiy band va har mezonga bitta maslahat beradi."
  turi="mashq"
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki writing">
    <header class="bosh">
      <p class="ustki-kok">Mashq · Writing</p>
      <h1>Writing Task 2 baholash</h1>
      <p class="lead">
        Mavzuni tanlang va inshoni yozing. AI uni IELTS'ning to'rt mezoni bo'yicha baholaydi, har mezonga izoh va bitta maslahat beradi.
        Haqiqiy imtihonda Task 2 uchun kamida 250 so'z kerak va unga 40 daqiqadan ko'p sarflamaslik tavsiya etiladi.
      </p>
      <p class="eslatma">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IK.info} />
        <span><strong>Taxminiy baho.</strong> Uni AI qo'yadi, bu rasmiy IELTS natijasi emas. Izohlar inglizcha.</span>
      </p>
      <p class="hisob-holat" id="hisob-holat" role="status"></p>
    </header>

    <form id="forma" class="panel" novalidate aria-labelledby="yozish-h">
      <h2 id="yozish-h" class="bolim-sarlavha">Inshoni yozing</h2>

      <fieldset class="mavzular">
        <legend class="kichik-sarlavha">1. Mavzu <span class="pill-namuna">Namuna</span></legend>
        {writingMavzular.map((m) => (
          <label class="mavzu">
            <input type="radio" name="mavzu" value={m.id} />
            <span class="m-matn">
              <span class="m-tur">{m.tur}</span>
              <span class="m-savol" lang="en" data-savol={m.id}>{m.matn}</span>
            </span>
          </label>
        ))}
        <label class="mavzu">
          <input type="radio" name="mavzu" value="oz" />
          <span class="m-matn"><span class="m-tur">O'z savolim</span><span class="m-izoh">Kitob yoki darsdagi savolni ko'chirib yozing.</span></span>
        </label>
        <div class="oz-savol" id="oz-savol-blok" hidden>
          <label for="oz-savol" class="yorliq">Savol matni (inglizcha)</label>
          <textarea id="oz-savol" rows="3" maxlength="600" lang="en" spellcheck="false"></textarea>
        </div>
      </fieldset>

      <div class="insho-blok">
        <label for="insho" class="kichik-sarlavha">2. Insho</label>
        <textarea id="insho" rows="16" lang="en" spellcheck="false" autocomplete="off" autocapitalize="sentences" aria-describedby="sanoq-izoh"></textarea>
        <p class="sanoq" aria-live="off">
          <strong id="sanoq">0 so'z</strong>
          <span id="sanoq-izoh"></span>
        </p>
        <p class="mayda">Imlo tekshiruvi o'chirilgan: imtihonda ham u yo'q. Qoralama shu brauzerda avtomatik saqlanadi.</p>
      </div>

      <p class="xabar xabar-ogoh" id="forma-xato" role="alert"></p>

      <div class="amallar">
        <button type="submit" class="tugma" id="yubor">Baholash</button>
        <p class="qoldi" id="qoldi"></p>
      </div>
    </form>

    <section id="natija" class="panel" aria-labelledby="natija-h" hidden>
      <div class="natija-bosh">
        <div>
          <h2 id="natija-h" class="bolim-sarlavha" tabindex="-1">Taxminiy band</h2>
          <p class="mayda">Task 2 bo'yicha, to'rt mezon o'rtachasi. Rasmiy IELTS natijasi emas.</p>
        </div>
        <p class="band-katta" id="band-katta"></p>
      </div>
      <p class="xabar" id="natija-izoh"></p>
      <p class="xulosa" id="xulosa" lang="en"></p>
      <ul class="mezonlar" id="mezonlar"></ul>
      <div class="amallar">
        <button type="button" class="tugma tugma-ikkinchi" id="qayta">Qayta yozish</button>
      </div>
    </section>

    <section id="tarix" aria-labelledby="tarix-h" hidden>
      <h2 id="tarix-h" class="bolim-sarlavha">Oldingi natijalar</h2>
      <p class="mayda">Oxirgi 5 ta. Insholar hisobingizda saqlanadi, istalganini o'chirishingiz mumkin.</p>
      <ul class="tarix-royxat" id="tarix-royxat"></ul>
    </section>

    <p class="mayda">
      Insho mezonlari va tuzilmasi: <a href={yol('/uz/ielts/qollanma/writing-task-2/')}>Writing Task 2 qo'llanmasi</a>.
      Insho baholash uchun Anthropic (AQSh) xizmatiga yuboriladi: <a href={yol('/uz/maxfiylik/#ielts-writing')}>Maxfiylik</a>.
    </p>

    <ManbaBlok
      manbalar={['IE05']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "Baho AI tomonidan qo'yiladi va taxminiy: rasmiy IELTS imtihonchisi bahosi emas, aniqligi o'lchanmagan.",
        "Mezon ta'riflari Tayanch o'z so'zlari bilan yozgan, rasmiy band descriptors matni emas.",
        "Task bali 4 mezon o'rtachasidan pastga 0.5 ga yaxlitlanadi: bu Tayanch qoidasi, rasmiy hisoblash usuli emas.",
        "Mashq mavzulari Tayanch uchun yozilgan namuna, rasmiy IELTS savoli emas.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  import { haqiqiyApi, mockApi, type Holat, type OldingiNatija, type WritingApi } from '../../../../../lib/ielts/writing/api';
  import {
    bandMatni, type BahoJavob, KALIT_QORALAMA, MEZONLAR, natijaTogrimi, qoralamaniOqi, sanoqIzohi, sozSoni,
    tekshir, TEKSHIRUV_MATNI, xatoMatni,
  } from '../../../../../lib/ielts/writing/baho';
  import { hisobYoli } from '../../../../../lib/hisob';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const forma = $<HTMLFormElement>('forma');
  const insho = $<HTMLTextAreaElement>('insho');
  const ozSavol = $<HTMLTextAreaElement>('oz-savol');
  const ozBlok = $('oz-savol-blok');
  const yubor = $<HTMLButtonElement>('yubor');
  const formaXato = $('forma-xato');
  const hisobHolat = $('hisob-holat');
  const qoldiEl = $('qoldi');
  const natija = $('natija');
  const tarix = $('tarix');
  const tarixRoyxat = $('tarix-royxat');
  const radiolar = () => [...forma.querySelectorAll<HTMLInputElement>('input[name="mavzu"]')];

  const p = new URLSearchParams(location.search);
  const mock = import.meta.env.DEV ? p.get('mock') : null;
  const api: WritingApi | null = mock ? mockApi(mock) : haqiqiyApi();
  let holat: Holat = { kirgan: false, available: false, daily_limit: 0, remaining: 0 };
  let band = false;

  // ---- Qoralama ----
  const tanlangan = () => radiolar().find((r) => r.checked)?.value ?? null;
  function savolMatni(): { matn: string; id: string | null } {
    const t = tanlangan();
    if (t === 'oz') return { matn: ozSavol.value, id: null };
    const el = t ? forma.querySelector<HTMLElement>(`[data-savol="${t}"]`) : null;
    return { matn: el?.textContent?.trim() ?? '', id: t };
  }
  let saqlashTaymer = 0;
  function saqla() {
    try {
      localStorage.setItem(KALIT_QORALAMA, JSON.stringify({ mavzu: tanlangan(), ozSavol: ozSavol.value, insho: insho.value }));
    } catch {
      // saqlash bo'lmasa ham yozish davom etadi
    }
  }
  const saqlaKeyin = () => {
    clearTimeout(saqlashTaymer);
    saqlashTaymer = window.setTimeout(saqla, 2000);
  };
  function tikla() {
    let xom: string | null = null;
    try {
      xom = localStorage.getItem(KALIT_QORALAMA);
    } catch {
      xom = null;
    }
    const q = qoralamaniOqi(xom);
    if (!q) return;
    const r = radiolar().find((x) => x.value === q.mavzu);
    if (r) r.checked = true;
    ozSavol.value = q.ozSavol;
    insho.value = q.insho;
  }

  // ---- Sanoq va mavzu ----
  function sanoqniYangila() {
    const n = sozSoni(insho.value);
    $('sanoq').textContent = `${n} so'z`;
    $('sanoq-izoh').textContent = sanoqIzohi(n);
      }
  function mavzuniYangila() {
    ozBlok.hidden = tanlangan() !== 'oz';
  }

  // ---- Hisob holati ----
  const kirishYoli = () => `${hisobYoli('kirish')}?keyin=${encodeURIComponent(location.pathname + location.search)}`;
  function holatniKorsat() {
    qoldiEl.textContent = '';
    hisobHolat.replaceChildren();
    if (!holat.kirgan) {
      const a = document.createElement('a');
      a.href = kirishYoli();
      a.textContent = 'Hisobga kiring';
      hisobHolat.append(a, ': baholash faqat hisob bilan ishlaydi (kuniga bepul tekshiruvlar). Yozishni hozir boshlashingiz mumkin, qoralama saqlanadi.');
      yubor.textContent = 'Kirish va baholash';
      return;
    }
    yubor.textContent = 'Baholash';
    if (!holat.available) {
      hisobHolat.textContent = "AI baholash hozir vaqtincha o'chiq. Yozishingiz mumkin: qoralama saqlanadi.";
      return;
    }
    qoldiEl.textContent = holat.remaining > 0
      ? `Bugun ${holat.remaining} ta tekshiruv qoldi (kuniga ${holat.daily_limit} ta).`
      : `Bugungi ${holat.daily_limit} ta tekshiruv tugadi. Ertaga yana baholash mumkin.`;
  }

  // ---- Natija ----
  function el<K extends keyof HTMLElementTagNameMap>(teg: K, cls?: string, matn?: string, lang?: string) {
    const e = document.createElement(teg);
    if (cls) e.className = cls;
    if (matn !== undefined) e.textContent = matn;
    if (lang) e.lang = lang;
    return e;
  }
  function natijaniKorsat(j: Pick<BahoJavob, 'task_band' | 'result' | 'word_count' | 'cached'>, eslatma?: string) {
    $('band-katta').textContent = bandMatni(j.task_band);
    const izohlar: string[] = [];
    if (eslatma) izohlar.push(eslatma);
    if (j.cached) izohlar.push("Bu insho so'nggi 24 soatda baholangan: oldingi natija ko'rsatildi, limit sarflanmadi.");
    if (j.result.under_length) izohlar.push(`Inshoda ${j.word_count} so'z: 250 dan kam. Haqiqiy imtihonda bu Task Response balini pasaytiradi.`);
    $('natija-izoh').textContent = izohlar.join(' ');
    $('xulosa').textContent = j.result.overall_summary;
    const ul = $('mezonlar');
    ul.replaceChildren();
    for (const m of MEZONLAR) {
      const c = j.result.criteria[m.kalit];
      const li = el('li', 'mezon');
      const bosh = el('div', 'mezon-bosh');
      const nom = el('h3', 'mezon-nom');
      nom.append(el('span', '', m.nomi, 'en'), el('span', 'mezon-izoh', m.izoh));
      bosh.append(nom, el('span', 'mezon-band', bandMatni(c.band)));
      li.append(bosh, el('p', 'mezon-matn', c.feedback, 'en'));
      if (c.example_from_text) {
        const q = el('blockquote', 'iqtibos');
        q.append(el('span', 'q-yorliq', 'Inshodan'), el('span', '', `“${c.example_from_text}”`, 'en'));
        li.append(q);
      }
      const t = el('p', 'maslahat');
      t.append(el('strong', '', 'Keyingi qadam: '), el('span', '', c.improvement_tip, 'en'));
      li.append(t);
      ul.append(li);
    }
    forma.hidden = true;
    natija.hidden = false;
    $('natija-h').focus();
    natija.scrollIntoView({ block: 'start' });
  }

  async function tarixniYukla() {
    if (!api || !holat.kirgan) {
      tarix.hidden = true;
      return;
    }
    let royxat: OldingiNatija[] = [];
    try {
      royxat = (await api.oldingilar()).filter((x) => natijaTogrimi(x.result));
    } catch {
      royxat = [];
    }
    tarix.hidden = royxat.length === 0;
    tarixRoyxat.replaceChildren();
    const sana = new Intl.DateTimeFormat('uz-Latn-UZ', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    for (const x of royxat) {
      const li = el('li', 'tarix-qator');
      const ochish = el('button', 't-ochish');
      ochish.type = 'button';
      const matn = el('span', 't-matn');
      matn.append(el('span', 't-savol', x.prompt, 'en'), el('span', 't-meta', `${sana.format(new Date(x.created_at))} · ${x.word_count} so'z`));
      ochish.append(matn, el('span', 't-band', bandMatni(x.task_band)));
      ochish.addEventListener('click', () => natijaniKorsat({ task_band: x.task_band, result: x.result, word_count: x.word_count, cached: false }, 'Oldingi natija.'));
      const ochir = el('button', 'tugma tugma-ikkinchi t-ochir', "O'chirish");
      ochir.type = 'button';
      ochir.setAttribute('aria-label', `O'chirish: ${sana.format(new Date(x.created_at))} natijasi`);
      ochir.addEventListener('click', async () => {
        if (!confirm("Bu natija va insho hisobingizdan o'chiriladi. Davom etasizmi?")) return;
        try {
          await api.ochir(x.id);
          await tarixniYukla();
        } catch {
          alert("O'chirib bo'lmadi. Keyinroq urinib ko'ring.");
        }
      });
      li.append(ochish, ochir);
      tarixRoyxat.append(li);
    }
  }

  // ---- Yuborish ----
  function kutish(ha: boolean) {
    band = ha;
    yubor.disabled = ha;
    yubor.textContent = ha ? 'Baholanmoqda…' : holat.kirgan ? 'Baholash' : 'Kirish va baholash';
    insho.readOnly = ha;
    ozSavol.readOnly = ha;
    radiolar().forEach((r) => (r.disabled = ha));
    forma.setAttribute('aria-busy', String(ha));
    if (ha) qoldiEl.textContent = 'Baholanmoqda, odatda 10–30 soniya.';
  }

  forma.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (band) return;
    formaXato.textContent = '';
    const s = savolMatni();
    const xato = tekshir(s.matn, insho.value);
    if (xato) {
      formaXato.textContent = TEKSHIRUV_MATNI[xato];
      (xato === 'savol_yoq' ? radiolar()[0] : xato === 'savol_qisqa' ? ozSavol : insho).focus();
      return;
    }
    saqla();
    if (!holat.kirgan) {
      location.href = kirishYoli();
      return;
    }
    if (!api) {
      formaXato.textContent = xatoMatni('server_not_configured');
      return;
    }
    kutish(true);
    const r = await api.yubor({ prompt: s.matn.trim(), prompt_id: s.id, essay: insho.value });
    kutish(false);
    if (!r.ok) {
      formaXato.textContent = xatoMatni(r.kod, { daily_limit: holat.daily_limit });
      if (r.kod === 'quota_exceeded') holat.remaining = 0;
      if (r.kod === 'ai_paused') holat.available = false;
      if (r.kod === 'not_signed_in') holat.kirgan = false;
      holatniKorsat();
      // Limit xabari formada ko'rsatildi: tugma ostida takrorlanmaydi.
      if (r.kod === 'quota_exceeded') qoldiEl.textContent = '';
      formaXato.focus();
      return;
    }
    if (typeof r.data.remaining === 'number') holat.remaining = r.data.remaining;
    holatniKorsat();
    natijaniKorsat(r.data);
    void tarixniYukla();
  });

  $('qayta').addEventListener('click', () => {
    natija.hidden = true;
    forma.hidden = false;
    insho.focus();
  });

  forma.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'mavzu') {
      mavzuniYangila();
      saqla();
    }
  });
  insho.addEventListener('input', () => {
    sanoqniYangila();
    saqlaKeyin();
  });
  ozSavol.addEventListener('input', saqlaKeyin);
  window.addEventListener('pagehide', saqla);

  tikla();
  mavzuniYangila();
  sanoqniYangila();
  formaXato.tabIndex = -1;

  (async () => {
    if (!api) {
      hisobHolat.textContent = "Baholash hozir mavjud emas. Yozishingiz mumkin: qoralama saqlanadi.";
      return;
    }
    try {
      holat = await api.holat();
    } catch {
      holat = { kirgan: true, available: false, daily_limit: 0, remaining: 0 };
    }
    holatniKorsat();
    await tarixniYukla();
  })();
</script>

<style>
  .writing { padding-top: var(--b-10); display: flex; flex-direction: column; gap: var(--b-8); max-width: var(--size-measure); }
  .bosh { display: flex; flex-direction: column; gap: var(--b-4); }
  .bosh p { margin: 0; }
  .ustki-kok { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rang-havola); }
  h1 { font-size: var(--matn-h1); line-height: 1.1; font-weight: 800; }
  .lead { line-height: 1.6; color: var(--matn-ikkinchi); max-width: 60ch; }
  .eslatma {
    align-self: flex-start; margin: 0; padding: var(--b-2) var(--b-4); border-radius: var(--r-yon);
    background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn);
    display: flex; align-items: center; gap: var(--b-2); font-size: var(--matn-kichik); font-weight: 500; line-height: 1.5;
  }
  .eslatma svg { flex: none; }
  .hisob-holat { line-height: 1.5; }
  .hisob-holat:empty { display: none; }
  .hisob-holat a { font-weight: 700; color: var(--rang-havola); }
  .mayda { margin: 0; font-size: var(--matn-kichik); color: var(--matn-ikkinchi); line-height: 1.5; }
  .mayda a { color: var(--rang-havola); }

  .bolim-sarlavha { margin: 0; font-size: var(--matn-h3); font-weight: 800; }
  .kichik-sarlavha { margin: 0 0 var(--b-2); padding: 0; font-size: var(--matn-asosiy); font-weight: 800; display: flex; align-items: center; gap: var(--b-2); }
  .pill-namuna { padding: 0 var(--b-2); border-radius: var(--r-toliq); background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn); font-size: var(--matn-mayda); font-weight: 700; }

  .panel { padding: var(--b-6); border-radius: var(--r-katta); background: var(--sirt); box-shadow: var(--soya); display: flex; flex-direction: column; gap: var(--b-6); }
  .panel[hidden], section[hidden], form[hidden], .oz-savol[hidden] { display: none; }

  .mavzular { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: var(--b-2); min-width: 0; }
  .mavzu {
    display: flex; align-items: flex-start; gap: var(--b-3); padding: var(--b-3) var(--b-4); border-radius: var(--r-orta);
    background: var(--fon-ikkinchi); cursor: pointer; border: var(--border-width-2) solid transparent;
  }
  .mavzu:has(input:checked) { border-color: var(--rang-asosiy); background: var(--fon); }
  .mavzu input { margin-top: var(--b-1); flex: none; width: var(--b-5); height: var(--b-5); accent-color: var(--rang-asosiy); }
  .mavzu input:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
  .m-matn { display: flex; flex-direction: column; gap: var(--b-1); min-width: 0; }
  .m-tur { font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); }
  .m-savol { line-height: 1.5; }
  .m-izoh { font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }
  .oz-savol { display: flex; flex-direction: column; gap: var(--b-2); padding-left: var(--b-4); }
  .yorliq { font-weight: 700; }

  textarea {
    width: 100%; padding: var(--b-3) var(--b-4); border: var(--border-width-2) solid var(--matn-sust); border-radius: var(--r-orta);
    background: var(--fon); color: var(--matn); font: inherit; line-height: 1.6; resize: vertical;
  }
  textarea:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); border-color: var(--matn); }
  textarea[readonly] { background: var(--fon-ikkinchi); }
  .insho-blok { display: flex; flex-direction: column; gap: var(--b-2); }
  #insho { min-height: 18rem; }
  .sanoq {
    position: sticky; bottom: 0; margin: 0; padding: var(--b-2) 0; background: var(--sirt);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--b-1) var(--b-3); font-size: var(--matn-kichik); color: var(--matn-ikkinchi);
  }
  #sanoq { font-size: var(--matn-asosiy); color: var(--matn); font-variant-numeric: tabular-nums; }

  .xabar:empty { display: none; }
  .xabar { margin: 0; padding: var(--b-4); border-radius: var(--r-orta); background: var(--fon-ikkinchi); line-height: 1.5; }
  .xabar-ogoh { background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn); }
