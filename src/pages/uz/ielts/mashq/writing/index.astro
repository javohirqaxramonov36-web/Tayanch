---
// IELTS Writing Task 2: insho yozish va AI bilan TAXMINIY baholash. Spetsifikatsiya: docs/ielts-writing-baho.md.
// Holatlar: yozish -> yuborilmoqda -> natija | xato. Qoralama: tayanch:ielts-writing-qoralama (faqat shu brauzerda).
// Baholash faqat hisob bilan (Edge Function ielts-writing-baho, kunlik bepul limit). Natijalar hisobda (RLS).
// Mavzular: src/data/ielts/writingSavollar.ts ("Namuna"). Format faktlari: IE05.
// Dev mock: `npm run dev`, ?mock=ok | kesh | limit | yopiq | xato | kirmagan.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { writingMavzular } from '../../../../../data/ielts/writingSavollar';
import { yol } from '../../../../../lib/yol';

const IK = {
  info: '<path d="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 8v5M12 16.5v.5"/>',
};
---
<BolimQobiq
  title="Writing Task 2 assessment · IELTS"
  description="Write an IELTS Writing Task 2 essay: AI gives an estimated band on the four criteria and one tip for each criterion."
  turi="mashq"
  bolim="ielts"
  yol={['Writing']}
  ota={yol('/uz/ielts/writing/')}
  holat="chop-etilgan"
>
  <div class="ichki writing">
    <header class="bosh">
      <p class="ustki-kok">Practice · Writing</p>
      <h1>Writing Task 2 assessment</h1>
      <p class="lead">
        Choose a topic and write your essay. AI assesses it on the four IELTS criteria and gives a comment and one tip for each.
        In the real test, Task 2 needs at least 250 words, and you are advised to spend no more than 40 minutes on it.
      </p>
      <p class="eslatma">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IK.info} />
        <span><strong>Estimated score.</strong> It is given by AI and is not an official IELTS result.</span>
      </p>
      <p class="hisob-holat" id="hisob-holat" role="status"></p>
    </header>

    <form id="forma" class="panel" novalidate aria-labelledby="yozish-h">
      <h2 id="yozish-h" class="bolim-sarlavha">Write your essay</h2>

      <fieldset class="mavzular">
        <legend class="kichik-sarlavha">1. Topic <span class="pill-namuna">Sample</span></legend>
        {writingMavzular.map((m) => (
          <label class="mavzu">
            <input type="radio" name="mavzu" value={m.id} />
            <span class="m-matn">
              <span class="m-tur">{m.tur}</span>
              <span class="m-savol" lang="en" data-savol={m.id}>{m.matn}</span>
            </span>
          </label>
        ))}
        <label class="mavzu">
          <input type="radio" name="mavzu" value="oz" />
          <span class="m-matn"><span class="m-tur">My own question</span><span class="m-izoh">Type in a question from a book or a class.</span></span>
        </label>
        <div class="oz-savol" id="oz-savol-blok" hidden>
          <label for="oz-savol" class="yorliq">Question text (in English)</label>
          <textarea id="oz-savol" rows="3" maxlength="600" lang="en" spellcheck="false"></textarea>
        </div>
      </fieldset>

      <div class="insho-blok">
        <label for="insho" class="kichik-sarlavha">2. Essay</label>
        <textarea id="insho" rows="16" lang="en" spellcheck="false" autocomplete="off" autocapitalize="sentences" aria-describedby="sanoq-izoh"></textarea>
        <p class="sanoq" aria-live="off">
          <strong id="sanoq">0 words</strong>
          <span id="sanoq-izoh"></span>
        </p>
        <p class="mayda">Spell check is off: there is none in the test either. Your draft is saved automatically in this browser.</p>
      </div>

      <p class="xabar xabar-ogoh" id="forma-xato" role="alert"></p>

      <div class="amallar">
        <button type="submit" class="t-tugma t-tugma--ikkinchi" id="yubor">Assess</button>
        <p class="qoldi" id="qoldi"></p>
      </div>
    </form>

    <section id="natija" class="panel" aria-labelledby="natija-h" hidden>
      <div class="natija-bosh">
        <div>
          <h2 id="natija-h" class="bolim-sarlavha" tabindex="-1">Estimated band</h2>
          <p class="mayda">For Task 2: the average of the four criteria. Not an official IELTS result.</p>
        </div>
        <p class="band-katta" id="band-katta"></p>
      </div>
      <p class="xabar" id="natija-izoh"></p>
      <p class="xulosa" id="xulosa" lang="en"></p>
      <ul class="mezonlar" id="mezonlar"></ul>
      <div class="amallar">
        <button type="button" class="t-tugma t-tugma--ikkinchi" id="qayta">Write again</button>
      </div>
    </section>

    <section id="tarix" aria-labelledby="tarix-h" hidden>
      <h2 id="tarix-h" class="bolim-sarlavha">Previous results</h2>
      <p class="mayda">The last 5. Essays are saved in your account, and you can delete any of them.</p>
      <ul class="tarix-royxat" id="tarix-royxat"></ul>
    </section>

    <p class="mayda">
      Essay criteria and structure: <a href={yol('/uz/ielts/qollanma/writing-task-2/')}>Writing Task 2 guide</a>.
      Your essay is sent to Anthropic (USA) for assessment: <a href={yol('/uz/maxfiylik/#ielts-writing')} hreflang="uz">Privacy policy</a> (in Uzbek).
    </p>

    <ManbaBlok
      manbalar={['IE05']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "The score is given by AI and is an estimate: it is not an official IELTS examiner's score, and its accuracy has not been measured.",
        "The criteria descriptions are in Tayanch's own words, not the text of the official band descriptors.",
        "The task score is the average of the 4 criteria rounded down to the nearest 0.5: this is Tayanch's rule, not the official calculation.",
        "The practice topics are samples written for Tayanch, not official IELTS questions.",
      ]}
    />
  </div>
</BolimQobiq>

<script>
  import { haqiqiyApi, mockApi, type Holat, type OldingiNatija, type WritingApi } from '../../../../../lib/ielts/writing/api';
  import {
    bandMatni, type BahoJavob, KALIT_QORALAMA, MEZONLAR, natijaTogrimi, qoralamaniOqi, sanoqIzohi, sozSoni,
    tekshir, TEKSHIRUV_MATNI, xatoMatni,
  } from '../../../../../lib/ielts/writing/baho';
  import { hisobYoli } from '../../../../../lib/hisob';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const forma = $<HTMLFormElement>('forma');
  const insho = $<HTMLTextAreaElement>('insho');
  const ozSavol = $<HTMLTextAreaElement>('oz-savol');
  const ozBlok = $('oz-savol-blok');
  const yubor = $<HTMLButtonElement>('yubor');
  const formaXato = $('forma-xato');
  const hisobHolat = $('hisob-holat');
  const qoldiEl = $('qoldi');
  const natija = $('natija');
  const tarix = $('tarix');
  const tarixRoyxat = $('tarix-royxat');
  const radiolar = () => [...forma.querySelectorAll<HTMLInputElement>('input[name="mavzu"]')];

  const p = new URLSearchParams(location.search);
  const mock = import.meta.env.DEV ? p.get('mock') : null;
  const api: WritingApi | null = mock ? mockApi(mock) : haqiqiyApi();
  let holat: Holat = { kirgan: false, available: false, daily_limit: 0, remaining: 0 };
  let band = false;

  // ---- Qoralama ----
  const tanlangan = () => radiolar().find((r) => r.checked)?.value ?? null;
  function savolMatni(): { matn: string; id: string | null } {
    const t = tanlangan();
    if (t === 'oz') return { matn: ozSavol.value, id: null };
    const el = t ? forma.querySelector<HTMLElement>(`[data-savol="${t}"]`) : null;
    return { matn: el?.textContent?.trim() ?? '', id: t };
  }
  let saqlashTaymer = 0;
  function saqla() {
    try {
      localStorage.setItem(KALIT_QORALAMA, JSON.stringify({ mavzu: tanlangan(), ozSavol: ozSavol.value, insho: insho.value }));
    } catch {
      // saqlash bo'lmasa ham yozish davom etadi
    }
  }
  const saqlaKeyin = () => {
    clearTimeout(saqlashTaymer);
    saqlashTaymer = window.setTimeout(saqla, 2000);
  };
  function tikla() {
    let xom: string | null = null;
    try {
      xom = localStorage.getItem(KALIT_QORALAMA);
    } catch {
      xom = null;
    }
    const q = qoralamaniOqi(xom);
    if (!q) return;
    const r = radiolar().find((x) => x.value === q.mavzu);
    if (r) r.checked = true;
    ozSavol.value = q.ozSavol;
    insho.value = q.insho;
  }

  // ---- Sanoq va mavzu ----
  function sanoqniYangila() {
    const n = sozSoni(insho.value);
    $('sanoq').textContent = `${n} ${n === 1 ? 'word' : 'words'}`;
    $('sanoq-izoh').textContent = sanoqIzohi(n);
      }
  function mavzuniYangila() {
    ozBlok.hidden = tanlangan() !== 'oz';
  }

  // ---- Hisob holati ----
  const kirishYoli = () => `${hisobYoli('kirish')}?keyin=${encodeURIComponent(location.pathname + location.search)}`;
  function holatniKorsat() {
    qoldiEl.textContent = '';
    hisobHolat.replaceChildren();
    if (!holat.kirgan) {
      const a = document.createElement('a');
      a.href = kirishYoli();
      a.textContent = 'Sign in';
      hisobHolat.append(a, ': assessment works only with an account (free assessments every day). You can start writing now; your draft is saved.');
      yubor.textContent = 'Sign in and assess';
      return;
    }
    yubor.textContent = 'Assess';
    if (!holat.available) {
      hisobHolat.textContent = 'AI assessment is temporarily off. You can keep writing: your draft is saved.';
      return;
    }
    qoldiEl.textContent = holat.remaining > 0
      ? `${holat.remaining} ${holat.remaining === 1 ? 'assessment' : 'assessments'} left today (${holat.daily_limit} a day).`
      : `You have used today's ${holat.daily_limit} assessments. You can get more tomorrow.`;
  }

  // ---- Natija ----
  function el<K extends keyof HTMLElementTagNameMap>(teg: K, cls?: string, matn?: string, lang?: string) {
    const e = document.createElement(teg);
    if (cls) e.className = cls;
    if (matn !== undefined) e.textContent = matn;
    if (lang) e.lang = lang;
    return e;
  }
  function natijaniKorsat(j: Pick<BahoJavob, 'task_band' | 'result' | 'word_count' | 'cached'>, eslatma?: string) {
    $('band-katta').textContent = bandMatni(j.task_band);
    const izohlar: string[] = [];
    if (eslatma) izohlar.push(eslatma);
    if (j.cached) izohlar.push('This essay was assessed in the last 24 hours: the earlier result is shown, and your limit was not used.');
    if (j.result.under_length) izohlar.push(`The essay has ${j.word_count} words: fewer than 250. In the real test this lowers the Task Response score.`);
    $('natija-izoh').textContent = izohlar.join(' ');
    $('xulosa').textContent = j.result.overall_summary;
    const ul = $('mezonlar');
    ul.replaceChildren();
    for (const m of MEZONLAR) {
      const c = j.result.criteria[m.kalit];
      const li = el('li', 'mezon');
      const bosh = el('div', 'mezon-bosh');
      const nom = el('h3', 'mezon-nom');
      nom.append(el('span', '', m.nomi, 'en'), el('span', 'mezon-izoh', m.izoh));
      bosh.append(nom, el('span', 'mezon-band', bandMatni(c.band)));
      li.append(bosh, el('p', 'mezon-matn', c.feedback, 'en'));
      if (c.example_from_text) {
        const q = el('blockquote', 'iqtibos');
        q.append(el('span', 'q-yorliq', 'From your essay'), el('span', '', `“${c.example_from_text}”`, 'en'));
        li.append(q);
      }
      const t = el('p', 'maslahat');
      t.append(el('strong', '', 'Next step: '), el('span', '', c.improvement_tip, 'en'));
      li.append(t);
      ul.append(li);
    }
    forma.hidden = true;
    natija.hidden = false;
    $('natija-h').focus();
    natija.scrollIntoView({ block: 'start' });
  }

  async function tarixniYukla() {
    if (!api || !holat.kirgan) {
      tarix.hidden = true;
      return;
    }
    let royxat: OldingiNatija[] = [];
    try {
      royxat = (await api.oldingilar()).filter((x) => natijaTogrimi(x.result));
    } catch {
      royxat = [];
    }
    tarix.hidden = royxat.length === 0;
    tarixRoyxat.replaceChildren();
    const sana = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    for (const x of royxat) {
      const li = el('li', 'tarix-qator');
      const ochish = el('button', 't-ochish');
      ochish.type = 'button';
      const matn = el('span', 't-matn');
      matn.append(el('span', 't-savol', x.prompt, 'en'), el('span', 't-meta', `${sana.format(new Date(x.created_at))} · ${x.word_count} words`));
      ochish.append(matn, el('span', 't-band', bandMatni(x.task_band)));
      ochish.addEventListener('click', () => natijaniKorsat({ task_band: x.task_band, result: x.result, word_count: x.word_count, cached: false }, 'Previous result.'));
      const ochir = el('button', 'tugma tugma-ikkinchi t-ochir', 'Delete');
      ochir.type = 'button';
      ochir.setAttribute('aria-label', `Delete the result from ${sana.format(new Date(x.created_at))}`);
      ochir.addEventListener('click', async () => {
        if (!confirm('This result and essay will be deleted from your account. Continue?')) return;
        try {
          await api.ochir(x.id);
          await tarixniYukla();
        } catch {
          alert("Couldn't delete it. Try again later.");
        }
      });
      li.append(ochish, ochir);
      tarixRoyxat.append(li);
    }
  }

  // ---- Yuborish ----
  function kutish(ha: boolean) {
    band = ha;
    yubor.disabled = ha;
    yubor.textContent = ha ? 'Assessing…' : holat.kirgan ? 'Assess' : 'Sign in and assess';
    insho.readOnly = ha;
    ozSavol.readOnly = ha;
    radiolar().forEach((r) => (r.disabled = ha));
    forma.setAttribute('aria-busy', String(ha));
    if (ha) qoldiEl.textContent = 'Assessing; this usually takes 10–30 seconds.';
  }

  forma.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (band) return;
    formaXato.textContent = '';
    const s = savolMatni();
    const xato = tekshir(s.matn, insho.value);
    if (xato) {
      formaXato.textContent = TEKSHIRUV_MATNI[xato];
      (xato === 'savol_yoq' ? radiolar()[0] : xato === 'savol_qisqa' ? ozSavol : insho).focus();
      return;
    }
    saqla();
    if (!holat.kirgan) {
      location.href = kirishYoli();
      return;
    }
    if (!api) {
      formaXato.textContent = xatoMatni('server_not_configured');
      return;
    }
    kutish(true);
    const r = await api.yubor({ prompt: s.matn.trim(), prompt_id: s.id, essay: insho.value });
    kutish(false);
    if (!r.ok) {
      formaXato.textContent = xatoMatni(r.kod, { daily_limit: holat.daily_limit });
      if (r.kod === 'quota_exceeded') holat.remaining = 0;
      if (r.kod === 'ai_paused') holat.available = false;
      if (r.kod === 'not_signed_in') holat.kirgan = false;
      holatniKorsat();
      // Limit xabari formada ko'rsatildi: tugma ostida takrorlanmaydi.
      if (r.kod === 'quota_exceeded') qoldiEl.textContent = '';
      formaXato.focus();
      return;
    }
    if (typeof r.data.remaining === 'number') holat.remaining = r.data.remaining;
    holatniKorsat();
    natijaniKorsat(r.data);
    void tarixniYukla();
  });

  $('qayta').addEventListener('click', () => {
    natija.hidden = true;
    forma.hidden = false;
    insho.focus();
  });

  forma.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'mavzu') {
      mavzuniYangila();
      saqla();
    }
  });
  insho.addEventListener('input', () => {
    sanoqniYangila();
    saqlaKeyin();
  });
  ozSavol.addEventListener('input', saqlaKeyin);
  window.addEventListener('pagehide', saqla);

  tikla();
  mavzuniYangila();
  sanoqniYangila();
  formaXato.tabIndex = -1;

  (async () => {
    if (!api) {
      hisobHolat.textContent = 'Assessment is not available right now. You can keep writing: your draft is saved.';
      return;
    }
    try {
      holat = await api.holat();
    } catch {
      holat = { kirgan: true, available: false, daily_limit: 0, remaining: 0 };
    }
    holatniKorsat();
    await tarixniYukla();
  })();
</script>

<style>
  .writing { padding-top: var(--space-10); display: flex; flex-direction: column; gap: var(--space-8); max-width: var(--size-measure); }
  .bosh { display: flex; flex-direction: column; gap: var(--space-4); }
  .bosh p { margin: 0; }
  .ustki-kok { font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-link); }
  h1 { font-size: var(--text-h1-size); line-height: 1.1; font-weight: var(--font-weight-extrabold); }
  .lead { line-height: 1.6; color: var(--color-ielts-text-muted); max-width: 60ch; }
  .eslatma {
    align-self: flex-start; margin: 0; padding: var(--space-2) var(--space-4); border-radius: var(--radius-md);
    background: var(--color-warning-subtle); color: var(--color-warning-text);
    display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-small-size); font-weight: var(--font-weight-medium); line-height: 1.5;
  }
  .eslatma svg { flex: none; }
  .hisob-holat { line-height: 1.5; }
  .hisob-holat:empty { display: none; }
  .hisob-holat a { font-weight: var(--font-weight-bold); color: var(--color-link); }
  .mayda { margin: 0; font-size: var(--text-small-size); color: var(--color-ielts-text-muted); line-height: 1.5; }
  .mayda a { color: var(--color-link); }

  .bolim-sarlavha { margin: 0; font-size: var(--text-h3-size); font-weight: var(--font-weight-extrabold); }
  .kichik-sarlavha { margin: 0 0 var(--space-2); padding: 0; font-size: var(--text-body-size); font-weight: var(--font-weight-extrabold); display: flex; align-items: center; gap: var(--space-2); }
  .pill-namuna { padding: 0 var(--space-2); border-radius: var(--radius-full); background: var(--color-warning-subtle); color: var(--color-warning-text); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); }

  .panel { padding: var(--space-6); border-radius: var(--radius-lg); background: var(--color-ielts-surface); box-shadow: var(--shadow-glass); display: flex; flex-direction: column; gap: var(--space-6); }
  .panel[hidden], section[hidden], form[hidden], .oz-savol[hidden] { display: none; }

  .mavzular { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .mavzu {
    display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md);
    background: var(--color-ielts-tile); cursor: pointer; border: var(--border-width-2) solid transparent;
  }
  .mavzu:has(input:checked) { border-color: var(--color-ielts-accent-text); background: var(--color-ielts-bg); }
  .mavzu input { margin-top: var(--space-1); flex: none; width: var(--space-5); height: var(--space-5); accent-color: var(--color-ielts-accent-text); }
  .mavzu input:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
  .m-matn { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .m-tur { font-size: var(--text-small-size); font-weight: var(--font-weight-bold); color: var(--color-ielts-text-muted); }
  .m-savol { line-height: 1.5; }
  .m-izoh { font-size: var(--text-small-size); color: var(--color-ielts-text-muted); }
  .oz-savol { display: flex; flex-direction: column; gap: var(--space-2); padding-left: var(--space-4); }
  .yorliq { font-weight: var(--font-weight-bold); }

  textarea {
    width: 100%; padding: var(--space-3) var(--space-4); border: var(--border-width-2) solid var(--color-ielts-text-muted); border-radius: var(--radius-md);
    background: var(--color-ielts-bg); color: var(--color-ielts-text); font: inherit; line-height: 1.6; resize: vertical;
  }
  textarea:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); border-color: var(--color-ielts-text); }
  textarea[readonly] { background: var(--color-ielts-tile); }
  .insho-blok { display: flex; flex-direction: column; gap: var(--space-2); }
  #insho { min-height: 18rem; }
  .sanoq {
    position: sticky; bottom: 0; margin: 0; padding: var(--space-2) 0; background: var(--color-ielts-surface);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3); font-size: var(--text-small-size); color: var(--color-ielts-text-muted);
  }
  #sanoq { font-size: var(--text-body-size); color: var(--color-ielts-text); font-variant-numeric: tabular-nums; }

  .xabar:empty { display: none; }
  .xabar { margin: 0; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-ielts-tile); line-height: 1.5; }
  .xabar-ogoh { background: var(--color-warning-subtle); color: var(--color-warning-text); }
  .xabar:focus { outline: none; }

  .amallar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); }
  .qoldi { margin: 0; font-size: var(--text-small-size); color: var(--color-ielts-text-muted); }
  .qoldi:empty { display: none; }

  .natija-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .natija-bosh > div { display: flex; flex-direction: column; gap: var(--space-1); }
  #natija-h:focus { outline: none; }
