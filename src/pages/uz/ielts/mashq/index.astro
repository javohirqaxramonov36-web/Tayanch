---
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import Belgi from '../../../../components/ielts/Belgi.astro';
import { yol } from '../../../../lib/yol';
import '../../../../styles/ielts.css';

import { katalog } from '../../../../data/ielts/katalog';
import { modullar as tartib, modulNomi } from '../../../../lib/ielts/test';
import { modulYoli } from '../../../../lib/ielts/yollar';

const testlar = katalog();
const sinovlar = [...new Set(testlar.map((test) => test.id).filter((id) => id !== 'namuna'))].sort();
const reading = testlar.find((test) => test.module === 'reading');
const mashq = (modul: string) => yol(`/uz/ielts/mashq/${modul}/`);
const natija = yol('/uz/ielts/vosita/natijalar/');
const xatolar = yol('/uz/ielts/vosita/xato-daftari/');
const modullar = [
  { id: 'listening', nom: 'Listening', izoh: 'Audio va savollar' },
  { id: 'reading', nom: 'Reading', izoh: 'Matn va savollar' },
  { id: 'writing', nom: 'Writing', izoh: 'Yozma topshiriqlar' },
  { id: 'speaking', nom: 'Speaking', izoh: 'Og‘zaki mashq' },
] as const;
---
<BolimQobiq
  title="IELTS mashqlari"
  description="IELTS Academic mashqlari, sinov testlari va xatolarni takrorlash."
  turi="mashq"
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki ielts-sahifa">
    <header class="ielts-oqim">
      <div>
        <h1>IELTS mashqlari</h1>
        <p class="kirish-izoh">Keyingi mashqni tanlang va tayyorgarligingizni kuzating.</p>
      </div>
    </header>

    <div class="asosiy-kartalar">
      <section class="ielts-yuza ielts-oqim keyingi-mashq" aria-labelledby="keyingi">
        <div class="ielts-satr">
          <span class="ds-karta-belgi"><Belgi nom="reading" /></span>
          <h2 id="keyingi" class="ielts-kichik-sarlavha">Keyingi qadam</h2>
        </div>
        <div>
          <p class="mashq-nom"><span lang="en">Reading</span> mashqini oching</p>
          <p class="ielts-izoh">Matnni o‘qing, dalilni belgilang va savollarga o‘ting.</p>
        </div>
        <div class="ielts-amallar">
          <a class="tugma tugma-asosiy" href={modulYoli('reading', reading?.id)} data-keyingi>Reading mashqini ochish <Belgi nom="oldinga" /></a>
        </div>
      </section>

      <section class="ielts-yuza ielts-oqim band-karta" aria-labelledby="band-sarlavha">
        <h2 id="band-sarlavha" class="ielts-kichik-sarlavha">Band maqsadi</h2>
        <dl class="band-qiymat">
          <div><dt>So‘nggi band (taxminiy)</dt><dd data-band>–</dd><p class="ielts-izoh" data-band-modul></p></div>
          <div>
            <dt><label for="ielts-maqsad">Maqsad bandi</label></dt>
            <dd>
              <select class="ielts-maydon" id="ielts-maqsad">
                <option value="">Tanlang</option>
                {Array.from({ length: 17 }, (_, i) => 1 + i / 2).map((band) => <option value={band}>{band.toFixed(1)}</option>)}
              </select>
            </dd>
          </div>
        </dl>
        <div class="ielts-oqim jarayon">
          <p id="mashq-jarayon" class="ielts-satr ielts-satr-oraliq"><strong>Tayyorgarlik jarayoni</strong><span data-jarayon>0 / 4 bo‘lim</span></p>
          <progress class="ielts-olga" value="0" max="4" data-jarayon-chiziq aria-labelledby="mashq-jarayon"></progress>
        </div>
      </section>
    </div>
    <p class="ielts-izoh" role="status" data-dashboard-holat></p>

    <section class="ielts-oqim" aria-labelledby="modullar">
      <h2 id="modullar">Mashq bo‘limlari</h2>
      <ul class="modul-tori">
        {modullar.map((modul) => (
          <li>
            <a class="ds-karta modul-karta" href={mashq(modul.id)}>
              <span class="modul-bosh">
                <span class="ds-karta-belgi"><Belgi nom={modul.id} /></span>
                <Belgi nom="oldinga" />
              </span>
              <strong lang="en">{modul.nom}</strong>
              <span class="ielts-izoh">{modul.izoh}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="ielts-yuza ielts-oqim" aria-labelledby="sinovlar">
      <div>
        <h2 id="sinovlar">To‘liq sinov testlari</h2>
        <p class="ielts-izoh">E’lon qilingan testlarni istalgan tartibda ishlashingiz mumkin.</p>
      </div>
      {sinovlar.length ? (
        <ul class="ielts-qatorlar testlar">
          {sinovlar.map((id) => (
            <li class="ielts-oqim" data-sinov={id}>
              <div class="ielts-satr ielts-satr-oraliq">
                <strong>Sinov testi {id.slice(-2)}</strong>
                <span class="yorliq" data-sinov-holat>{tartib.every((modul) => testlar.some((test) => test.module === modul && test.id === id)) ? 'Ochiq' : 'Qisman ochiq'}</span>
              </div>
              <div class="ielts-satr">
                {tartib.map((modul) => testlar.some((test) => test.module === modul && test.id === id) ? (
                  <a class="tugma tugma-ikkinchi" href={modulYoli(modul, id)} data-sinov-modul={modul} lang="en">{modulNomi[modul]}</a>
                ) : <span class="yorliq"><span lang="en">{modulNomi[modul]}</span> · Yopiq</span>)}
              </div>
            </li>
          ))}
        </ul>
      ) : <p>To‘liq sinov testlari tayyorlanmoqda.</p>}
      <a class="ielts-havola" href={natija}>Mashq natijalarini ko‘rish <Belgi nom="oldinga" /></a>
    </section>

    <a class="ds-karta daftar-karta" href={xatolar}>
      <span class="ds-karta-belgi"><Belgi nom="daftar" /></span>
      <span><strong>Xato daftari</strong><span class="ielts-izoh">Dars va test xatolarini qayta ishlang.</span></span>
      <Belgi nom="oldinga" />
    </a>
  </div>
</BolimQobiq>

<script>
  import { maqsadniOqi, maqsadniYoz, urinishlar } from '../../../../lib/ielts/storage';
  import { ballModulmi, modulNomi, natijala, type BallTest } from '../../../../lib/ielts/test';
  import { testniYukla } from '../../../../lib/ielts/testEkrani';
  import { modulYoli, natijaYoli } from '../../../../lib/ielts/yollar';

  const attempts = urinishlar().filter((u) => !u.qayta);
  const completed = attempts.filter((u) => u.topshirilgan);
  const target = document.querySelector<HTMLSelectElement>('#ielts-maqsad')!;
  const status = document.querySelector<HTMLElement>('[data-dashboard-holat]')!;
  target.value = String(maqsadniOqi() ?? '');
  target.addEventListener('change', () => {
    if (!target.value) return;
    status.textContent = maqsadniYoz(Number(target.value)) ? 'Maqsad bandi saqlandi.' : 'Brauzerda saqlab bo‘lmadi.';
  });

  const finished = new Set(completed.map((u) => u.modul)).size;
  document.querySelector<HTMLElement>('[data-jarayon]')!.textContent = `${finished} / 4 bo‘lim`;
  document.querySelector<HTMLProgressElement>('[data-jarayon-chiziq]')!.value = finished;
  const open = attempts.find((u) => !u.topshirilgan && u.tugash > Date.now());
  if (open) {
    const next = document.querySelector<HTMLAnchorElement>('[data-keyingi]')!;
    next.href = modulYoli(open.modul, open.test);
    next.textContent = `${modulNomi[open.modul]} mashqini davom ettirish`;
  }
  const recent = completed.filter((u) => ballModulmi(u.modul) && u.test !== 'namuna')
    .sort((a, b) => b.topshirilgan! - a.topshirilgan!)[0];
  if (recent) {
    void testniYukla(recent.modul, recent.test).then((test) => {
      const band = natijala(test as BallTest, recent.javoblar).band;
      document.querySelector<HTMLElement>('[data-band]')!.textContent = typeof band === 'number' ? band.toFixed(1) : band ?? '–';
      document.querySelector<HTMLElement>('[data-band-modul]')!.textContent = modulNomi[recent.modul];
    }).catch(() => {});
  }
  document.querySelectorAll<HTMLElement>('[data-sinov]').forEach((item) => {
    const list = completed.filter((u) => u.test === item.dataset.sinov);
    const links = item.querySelectorAll<HTMLAnchorElement>('[data-sinov-modul]');
    links.forEach((link) => {
      const latest = list.find((u) => u.modul === link.dataset.sinovModul);
      if (latest) {
        link.textContent += ' ✓';
        link.title = 'Bo‘lim yakunlangan';
        link.href = natijaYoli(latest.id);
      }
    });
    if (new Set(list.map((u) => u.modul)).size === 4) {
      item.querySelector<HTMLElement>('[data-sinov-holat]')!.textContent = 'Yakunlangan';
    }
  });
</script>

<style>
  .kirish-izoh { margin-block-start: var(--space-2); color: var(--color-text-secondary); }
  .asosiy-kartalar { display: grid; gap: var(--space-3); }
  .keyingi-mashq { align-content: space-between; }
  .mashq-nom {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-lh);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-ls);
  }
  .mashq-nom + p { margin-block-start: var(--space-2); }
  .band-qiymat { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .band-qiymat div + div { border-inline-start: var(--border-width-1) solid var(--color-border); padding-inline-start: var(--space-4); }
  .band-qiymat dt, .jarayon p { font-size: var(--text-small-size); }
  .band-qiymat dt, .jarayon span { color: var(--color-text-secondary); }
  .band-qiymat dd {
    margin: 0;
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-lh);
    letter-spacing: var(--text-h1-ls);
    font-weight: var(--text-h1-weight);
    font-variant-numeric: tabular-nums;
  }
  .jarayon { gap: var(--space-2); }
  .modul-tori { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); list-style: none; padding: 0; margin: 0; }
  .modul-karta { display: grid; align-content: start; gap: var(--space-1); height: 100%; padding: var(--space-3); }
  .modul-bosh { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); margin-block-end: var(--space-2); }
  .ds-karta-belgi { display: grid; place-items: center; padding: 0; }
  .testlar li { padding-block: var(--space-4); }
  .daftar-karta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .daftar-karta strong, .daftar-karta .ielts-izoh { display: block; }
  @media (min-width: 768px) {
    .asosiy-kartalar { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .modul-tori { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .modul-karta { padding: var(--space-4); }
  }
</style>
