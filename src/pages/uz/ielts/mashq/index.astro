---
// IELTS practice landing: five cards, only Reading works. The other cards are visible but
// disabled ("Tez orada"). Timings: IE01, IE02.
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../components/ManbaBlok.astro';
import { mashqKartalar } from '../../../../data/ielts/mashqKartalar';
import { MM, RM } from '../../../../data/ielts/readingMatn';
import { yol } from '../../../../lib/yol';
---
<BolimQobiq
  title="Mashq testlari · IELTS"
  description="IELTS formatidagi mashq testlari: Reading test ochiq, Listening, Writing, Speaking va Full Mock Test tez orada."
  turi="mashq"
  bolim="ielts"
  holat="qoralama"
>
  <div class="ichki mashq">
    <header class="bosh">
      <p class="ustki-kok">{MM.ustki}</p>
      <h1>{MM.mashqSarlavha}</h1>
      <p class="lead">{MM.mashqLead}</p>
      <p class="eslatma">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 8v5M12 16.5v.5" /></svg>
        {RM.eslatma}
      </p>
    </header>

    <section aria-labelledby="mashq-h">
      <h2 id="mashq-h" class="ekranda-yoq">{MM.bolimlar}</h2>
      <ul class="kartalar">
        {mashqKartalar.map((k) => (
          <li>
            {k.qism ? (
              <a class="karta" href={yol(`/uz/ielts/${k.qism}`)}>
                <span class="k-ust">
                  <svg class="k-ikonka" aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={k.ikonka} />
                  <span class="pill pill-ochiq">{MM.ochiq}</span>
                </span>
                <strong class="k-nom">{k.nomi}</strong>
                <span class="k-raqam">{k.vaqt} · {k.tarkib}</span>
                <span class="k-tavsif">{k.tavsif}</span>
                <span class="k-amal">
                  {MM.boshlashga}
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
                </span>
              </a>
            ) : (
              <div class="karta nofaol">
                <span class="k-ust">
                  <svg class="k-ikonka" aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={k.ikonka} />
                  <span class="pill pill-tez">{MM.tezOrada}</span>
                </span>
                <strong class="k-nom">{k.nomi}</strong>
                <span class="k-raqam">{k.vaqt} · {k.tarkib}</span>
                <span class="k-tavsif">{k.tavsif}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>

    <ManbaBlok
      manbalar={['IE01', 'IE02']}
      tekshirilgan="2026-11-10"
      keyingiTekshiruv="2026-12-10"
      tekshirilmagan={[
        "Listening savollari soni (40), Writing topshiriqlari soni (2) va Speaking qismlari soni (3) bu sahifa uchun rasmiy manbada alohida tekshirilmagan.",
        "Listening, Writing, Speaking va Full Mock Test hali qurilmagan: muddat belgilanmagan.",
      ]}
    />
  </div>
</BolimQobiq>

<style>
  .mashq { padding-top: var(--b-10); display: flex; flex-direction: column; gap: var(--b-10); }
  .bosh { display: flex; flex-direction: column; gap: var(--b-4); }
  .bosh p { margin: 0; }
  .ustki-kok { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rang-havola); }
  h1 { font-size: 46px; line-height: 1.1; font-weight: 800; letter-spacing: -0.5px; }
  .lead { line-height: 1.6; color: var(--matn-ikkinchi); max-width: 60ch; }
  .eslatma {
    align-self: flex-start; padding: var(--b-2) var(--b-4); border-radius: var(--r-yon);
    background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn);
    display: flex; align-items: center; gap: var(--b-2); font-size: var(--matn-kichik); font-weight: 700; line-height: 1.4;
  }
  .eslatma svg { flex: none; }

  .kartalar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--b-4); }
  .kartalar li { display: flex; }
  .karta {
    flex: 1; min-height: 216px; padding: var(--b-6); border-radius: var(--r-katta);
    display: flex; flex-direction: column; gap: var(--b-2);
    color: var(--matn); text-decoration: none;
  }
  a.karta { border: 1.5px solid var(--matn); background: var(--fon); }
  a.karta:hover { border-color: var(--rang-asosiy); transform: var(--kotarilish); }
  .karta.nofaol { background: var(--fon-ikkinchi); }
  .k-ust { display: flex; align-items: center; justify-content: space-between; gap: var(--b-2); margin-bottom: var(--b-3); }
  .k-ikonka { color: var(--rang-havola); }
  .nofaol .k-ikonka { color: var(--matn-sust); }
  .pill { padding: 4px 12px; border-radius: var(--r-toliq); font-size: var(--matn-mayda); font-weight: 700; white-space: nowrap; }
  .pill-ochiq { background: var(--rang-asosiy-och); color: var(--rang-havola); }
  .pill-tez { background: var(--sirt-ikkinchi); color: var(--matn-ikkinchi); }
  .k-nom { font-size: var(--matn-h3); font-weight: 800; line-height: 1.2; }
  .nofaol .k-nom { color: var(--matn-ikkinchi); }
  .k-raqam { font-weight: 700; }
  .nofaol .k-raqam { color: var(--matn-ikkinchi); }
  .k-tavsif { font-size: var(--matn-kichik); font-weight: 500; line-height: 1.5; color: var(--matn-ikkinchi); }
  .k-amal { margin-top: auto; padding-top: var(--b-3); min-height: 44px; display: inline-flex; align-items: center; gap: var(--b-1); font-weight: 800; color: var(--rang-havola); }

  @media (max-width: 1180px) {
    .kartalar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .mashq { padding-top: var(--b-6); gap: var(--b-8); }
    h1 { font-size: 32px; }
    .kartalar { grid-template-columns: minmax(0, 1fr); }
    .karta { min-height: 0; padding: var(--b-5); }
  }
</style>
