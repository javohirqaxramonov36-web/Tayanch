---
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../components/ManbaBlok.astro';
import { mashqKartalar } from '../../../../data/ielts/mashqKartalar';
import { MM, RM } from '../../../../data/ielts/readingMatn';
import IeltsMashqKarta from '../../../../components/ielts/IeltsMashqKarta.astro';
import { yol } from '../../../../lib/yol';

const konikmalar = ['Listening', 'Reading', 'Writing', 'Speaking', 'Full Mock Test'];
const holatKalitlari: Record<string, string> = {
  'mashq/reading/': 'reading',
  'mashq/writing/': 'writing',
  'mashq/listening-imlo/': 'imlo',
  'mashq/listening-raqamlar/': 'raqamlar',
  'qollanma/speaking/#mashq': 'speaking',
};
const mashqTurlari: Record<string, string> = {
  'mashq/reading/': 'Mock',
  'mashq/writing/': 'Essay practice',
  'qollanma/speaking/#mashq': 'Speaking practice',
};
---
<BolimQobiq
  title="Practice tests · IELTS"
  description="IELTS practice: a Reading test, Listening spelling and dictation, Writing Task 2. A full Listening test, Speaking and a Full Mock Test are coming soon."
  turi="mashq"
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki mashq">
    <header class="bosh">
      <p class="ustki-kok">{MM.ustki}</p>
      <h1>{MM.mashqSarlavha}</h1>
      <p class="lead">{MM.mashqLead}</p>
      <p class="eslatma">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 8v5M12 16.5v.5" /></svg>
        {RM.eslatma}
      </p>
    </header>

    {konikmalar.map((nom, i) => (
      <section class="guruh" aria-labelledby={`konikma-${i}`}>
        <h2 id={`konikma-${i}`}>{nom}</h2>
        <div class="kartalar">
          {mashqKartalar.filter((k) => k.konikma === nom).map((k) => (
            <IeltsMashqKarta
              nomi={k.nomi}
              tur={[mashqTurlari[k.qism ?? ''], k.tarkib].filter(Boolean).join(' · ')}
              vaqt={k.vaqt}
              tavsif={k.tavsif}
              href={k.qism ? yol(`/uz/ielts/${k.qism}`) : undefined}
              holatKaliti={k.qism ? holatKalitlari[k.qism] : undefined}
            />
          ))}
        </div>
      </section>
    ))}

    <ManbaBlok
      manbalar={['IE01', 'IE02']}
      tekshirilgan="2026-11-10"
      keyingiTekshiruv="2026-12-10"
      tekshirilmagan={[
        "The number of Listening questions (40), Writing tasks (2) and Speaking parts (3) has not been checked separately against an official source for this page.",
      ]}
    />
  </div>
</BolimQobiq>

<style>
  .mashq { display: grid; gap: var(--space-8); padding-block: var(--space-8); }
  .bosh, .guruh { display: grid; gap: var(--space-4); }
  .ustki-kok, .lead, .eslatma { color: var(--color-text-secondary); }
  .eslatma { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-small-size); }
  .eslatma svg { flex: none; }
  .kartalar { display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .kartalar { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
