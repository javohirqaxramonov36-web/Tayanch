---
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import '../../../../../styles/ielts-reading.css';
import { saytTestlari } from '../../../../../lib/ielts/reading/saytTestlari';
import { yol } from '../../../../../lib/yol';

const barchaTestlar = await saytTestlari();
const yuklanganTestlar = barchaTestlar.filter((test) => test.source?.kind === 'uploaded');
const testlar = yuklanganTestlar.length > 0 ? yuklanganTestlar : barchaTestlar;
---
<BolimQobiq
  title="Reading mock · IELTS"
  description="IELTS Reading mashqi. Mockni tanlang va testni boshlang."
  turi="mashq"
  yol={['Mashq']}
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki rb" id="rb">
    <header class="bosh">
      <h1>IELTS Reading</h1>
      <p class="format">60 daqiqa · 40 savol · 3 matn</p>
    </header>

    <section class="boshla" aria-label="Mock tanlash">
      {testlar.length > 0 ? (
        <>
          <label for="rb-test">Mock tanlang</label>
          <select id="rb-test">
            {testlar.map((test) => (
              <option value={test.testId}>{test.title}</option>
            ))}
          </select>
          <a class="tugma tugma-asosiy katta" id="rb-boshla" href={`${yol('/uz/ielts/mashq/reading/test/')}?boshla=1&test=${encodeURIComponent(testlar[0].testId)}`}>Boshlash</a>
          <p class="boshla-davom" id="rb-davom" role="status" hidden></p>
        </>
      ) : <p>Mocklar tayyorlanmoqda.</p>}
    </section>

    <section class="tarix" id="rb-tarix-oram" aria-labelledby="rb-tarix-h">
      <h2 id="rb-tarix-h">Oxirgi natijalar</h2>
      <div id="rb-tarix"></div>
    </section>

    <details class="manba-izoh">
      <summary>Manbalar va izohlar</summary>
      <p>IELTS formatidagi mashq testlari.</p>
      <ManbaBlok
        manbalar={['IE02', 'IE04']}
        tekshirilgan="2026-11-10"
        keyingiTekshiruv="2026-12-10"
        tekshirilmagan={[
          'Band taxminiy. Rasmiy manbada to‘rtta tayanch nuqta bor, oraliq qiymatlar Tayanch taxmini.',
          'Yuklangan mocklarda manba javob kaliti ishlatiladi.',
        ]}
      />
    </details>
  </div>
</BolimQobiq>

<script>
  import { ishgaTushirBoshlash } from '../../../../../lib/ielts/reading/ekran/boshlash';
  ishgaTushirBoshlash();
</script>

<style>
  .rb { display: flex; flex-direction: column; gap: var(--space-8); padding-block: var(--space-8); }
  .bosh { display: grid; gap: var(--space-3); }
  .format { color: var(--color-text-secondary); margin: 0; }
  .boshla { display: grid; gap: var(--space-4); }
  .boshla label { font-weight: var(--font-weight-semibold); }
  .boshla select { width: 100%; min-width: 0; min-height: var(--size-touch-min); padding: var(--space-3); border: var(--border-width-1) solid var(--input-border); border-radius: var(--radius-md); background: var(--input-bg); color: var(--input-text); font: inherit; }
  .boshla select:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
  .boshla-davom { margin: 0; color: var(--color-text-secondary); }
  .tarix { display: grid; gap: var(--space-4); }
  .tarix h2 { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); }
  .manba-izoh { border-top: var(--border-width-1) solid var(--color-border); padding-top: var(--space-4); }
  .manba-izoh summary { display: list-item; min-height: var(--size-touch-min); padding-block: var(--space-3); cursor: pointer; color: var(--color-text-secondary); }
  .manba-izoh[open] > p { margin-block: var(--space-4); }
</style>
