---
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import { tashqiReadingMocklar } from '../../../../../data/ielts/tashqiReadingMocklar';
import IeltsMashqKarta from '../../../../../components/ielts/IeltsMashqKarta.astro';
import { savolRaqamlari } from '../../../../../lib/ielts/reading/sxema';
import { READING_YOL } from '../../../../../lib/ielts/reading/ekran/yollar';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import '../../../../../styles/ielts-reading.css';
import { saytTestlari } from '../../../../../lib/ielts/reading/saytTestlari';
import { yol } from '../../../../../lib/yol';

const barchaTestlar = await saytTestlari();
const yuklanganTestlar = barchaTestlar.filter((test) => test.source?.kind === 'uploaded');
const testlar = yuklanganTestlar.length > 0 ? yuklanganTestlar : barchaTestlar;
const vaqtinchaYopiq = tashqiReadingMocklar.filter(({ id }) => !yuklanganTestlar.some((test) => test.testId === id));
---
<BolimQobiq
  title="Reading test · IELTS"
  description="IELTS Reading practice. Choose a mock and start the test."
  turi="mashq"
  yol={['Reading']}
  ota={yol('/uz/ielts/reading/')}
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki rb" id="rb">
    <header class="bosh">
      <h1>IELTS Reading</h1>
      <p class="format">Choose a mock. Your progress is saved in this browser, and the timer keeps running if you leave the test.</p>
    </header>

    <section class="mocklar" aria-labelledby="mocklar-h">
      <h2 id="mocklar-h">Mocks</h2>
      <p data-reading-fallback hidden>You have a saved attempt. <a href={yol(READING_YOL.test)}>Open it before starting another mock</a>.</p>
      {testlar.length > 0 ? <div class="kartalar">
        {testlar.map((test) => {
          const jami = test.passages.flatMap((p) => p.groups.flatMap((g) => g.questions.flatMap(savolRaqamlari))).length;
          return <IeltsMashqKarta
            nomi={test.title}
            tur={`Mock · ${jami} questions`}
            vaqt={`${test.durationMinutes} minutes`}
            href={`${yol(READING_YOL.test)}?boshla=1&test=${encodeURIComponent(test.testId)}`}
            holatKaliti="reading"
            testId={test.testId}
            jami={jami}
          />;
        })}
      </div> : <p>Mocks are being prepared. <a href={yol('/uz/ielts/qollanma/reading/')}>Open the Reading guide</a>.</p>}
    </section>

    {vaqtinchaYopiq.length > 0 && <section class="mocklar" aria-labelledby="tashqi-mocklar-h">
      <h2 id="tashqi-mocklar-h">External mocks</h2>
      <div class="kartalar">
        {vaqtinchaYopiq.map(({ nomi }) => <IeltsMashqKarta nomi={nomi} tur="Mock" vaqtinchaYopiq />)}
      </div>
    </section>}

    <section class="tarix" id="rb-tarix-oram" aria-labelledby="rb-tarix-h">
      <h2 id="rb-tarix-h">Recent results</h2>
      <div id="rb-tarix"></div>
    </section>

    <details class="manba-izoh">
      <summary>Sources and notes</summary>
      <p>Practice tests in the IELTS format.</p>
      <ManbaBlok
        manbalar={['IE02', 'IE04']}
        tekshirilgan="2026-11-10"
        keyingiTekshiruv="2026-12-10"
        tekshirilmagan={[
          'The band is an estimate. The official source gives four reference points; the values in between are a Tayanch estimate.',
          'Uploaded mocks use the answer key from their source.',
        ]}
      />
    </details>
  </div>
</BolimQobiq>

<script>
  import { ishgaTushirBoshlash } from '../../../../../lib/ielts/reading/ekran/boshlash';
  ishgaTushirBoshlash();
</script>

<style>
  .rb { display: flex; flex-direction: column; gap: var(--space-8); padding-block: var(--space-8); }
  .bosh { display: grid; gap: var(--space-3); }
  .format { color: var(--color-text-secondary); margin: 0; }
  .mocklar, .kartalar { display: grid; gap: var(--space-4); }
  [data-reading-fallback][hidden] { display: none; }
  [data-reading-fallback] a { display: inline-flex; align-items: center; min-height: var(--size-touch-min); }
  @media (min-width: 768px) { .kartalar { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .tarix { display: grid; gap: var(--space-4); }
  .tarix h2 { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); }
  .manba-izoh { border-top: var(--border-width-1) solid var(--color-border); padding-top: var(--space-4); }
  .manba-izoh summary { display: list-item; min-height: var(--size-touch-min); padding-block: var(--space-3); cursor: pointer; color: var(--color-text-secondary); }
  .manba-izoh[open] > p { margin-block: var(--space-4); }
</style>
