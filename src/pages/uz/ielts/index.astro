---
// IELTS bosh sahifasi. Xatti-harakat spetsifikatsiyasi 2026-11-22 da tasdiqlangan.
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../components/ManbaBlok.astro';
import QavatFoto from '../../../components/QavatFoto.astro';
import { konikmalar, konikmaQism } from '../../../data/ieltsSahifalar';
import { hammaSavollar } from '../../../data/ieltsDarslar';
import { manbalar } from '../../../data/manbalar';
import { saytListeningTestlari } from '../../../lib/ielts/listening/saytTestlari';
import { saytTestlari } from '../../../lib/ielts/reading/saytTestlari';
import { savolRaqamlari } from '../../../lib/ielts/reading/sxema';
import { yol } from '../../../lib/yol';

const manba = (id: string) => manbalar.find((m) => m.id === id)!;
const testlar = (await saytTestlari()).map((test) => ({
  id: test.testId,
  nomi: test.title,
  jami: test.passages.flatMap((p) => p.groups.flatMap((g) => g.questions.flatMap(savolRaqamlari))).length,
}));
const reading = yol('/uz/ielts/mashq/reading/');
const listening = await saytListeningTestlari();
const reja = yol('/uz/ielts/vosita/reja/');
const mashq = yol('/uz/ielts/mashq/');
const takrorlash = yol('/uz/ielts/vosita/takrorlash/');
// Har karta o'z ko'nikma sahifasiga olib boradi (2026-11-24, ko'nikma tuzilmasi).
const bolimlar = konikmalar.map((k) => {
  const darsSoni = k.darslar.filter((b) => b.qism).length;
  const mashqSoni = k.mashqlar.filter((b) => b.qism).length;
  return {
    nomi: k.nomi, vaqt: k.vaqt, ikonka: k.ikonka,
    href: yol(`/uz/ielts/${konikmaQism(k.id)}`),
    holat: ['Guide', darsSoni && `${darsSoni} ${darsSoni === 1 ? 'lesson' : 'lessons'}`, mashqSoni && `${mashqSoni} ${mashqSoni === 1 ? 'drill' : 'drills'}`].filter(Boolean).join(', '),
  };
});
const namunalar = [
  { nomi: 'IELTS.org', tavsif: 'Academic sample tasks', manba: manba('IE03') },
  { nomi: 'IDP', tavsif: 'Free familiarisation tests', manba: manba('ID01') },
  { nomi: 'British Council', tavsif: 'Practice tests, computer format', manba: manba('BC01') },
];
const malumot = { testlar, darsIdlar: hammaSavollar.map((s) => s.id) };
---
<BolimQobiq
  title="IELTS"
  description="Independent IELTS prep: guides, Reading and Writing practice, short Listening drills and a 30-day plan."
  turi="bolim-kirishi" bolim="ielts" holat="chop-etilgan"
>
  <div class="ichki ielts" data-ielts-bosh={JSON.stringify(malumot)}>
    <QavatFoto bolim="ielts" />
    <section class="hero" aria-labelledby="ielts-h">
      <div class="hero-matn">
        <p class="ustki">IELTS section · independent prep</p>
        <h1 id="ielts-h">Prepare for IELTS on your own, with a plan.</h1>
        <p class="lead" data-tanishuv>A guide for each section, self-study practice and a day-by-day plan. Free, no sign-up, works on your phone too.</p>
        <article class="davom" aria-labelledby="davom-h" data-davom hidden>
          <p class="ustki">Continue</p>
          <h2 id="davom-h"></h2>
          <p class="davom-vaqt" data-davom-vaqt></p>
          <p class="kichik" data-davom-javob hidden></p>
          <p class="kichik">The timer keeps running even if you close the page.</p>
          <a class="t-tugma ielts-tugma--urgu" href={yol('/uz/ielts/mashq/reading/test/')} data-davom-havola>Continue</a>
        </article>
        <div class="amallar">
          {testlar.length > 0 && <a class="t-tugma ielts-tugma--urgu" href={reading} data-yangi-test>Free Reading test</a>}
          {listening.length > 0 && <a class="t-tugma t-tugma--ikkinchi" href={yol('/uz/ielts/mashq/listening/')}>Listening mocks · {listening.length}</a>}
          <a class="t-tugma t-tugma--ikkinchi" href={mashq}>Practice catalogue</a>
        </div>
      </div>
      <aside class="format" aria-labelledby="format-h">
        <h2 id="format-h" class="ustki">The test has four sections. Choose one</h2>
        <div class="konikmalar">
          {bolimlar.map((b) => {
            const Teg = b.href ? 'a' : 'div';
            return <Teg class="konikma-havola" href={b.href}>
              <article class="konikma">
                <svg class="ikonka" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={b.ikonka} />
                <div><h3>{b.nomi}</h3><p class="kichik">{b.vaqt}</p><p class:list={['yorliq', { ochiq: !!b.href }]}>{b.holat}</p></div>
                {b.href && <svg class="strelka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>}
              </article>
            </Teg>;
          })}
        </div>
        <p class="kichik">IELTS Academic. Source: <a href={manba('IE01').havola}>ielts.org</a>, checked {manba('IE01').tekshirilganSana}.</p>
      </aside>
    </section>

    <section class="holat-va-reja" aria-label="Status and next task">
      <article class="karta" data-holat hidden aria-labelledby="holat-h">
        <h2 id="holat-h">My progress</h2>
        <p class="kichik">Data from this browser only.</p>
        <dl class="statistika" data-statistika></dl>
        <a class="t-tugma t-tugma--ikkinchi" href={takrorlash}>Review mistakes</a>
        <p class="kichik">The band is an estimate and is shown only for a full 40-question mock.</p>
      </article>
      <article class="karta" aria-labelledby="keyingi-h">
        <h2 id="keyingi-h">Next task</h2>
        <p class="ikkinchi" data-reja-izoh>Choose how long you have until the test, how many hours a day you are free and which section is hardest. Your 30-day plan is built from these.</p>
        <a class="t-tugma t-tugma--ikkinchi" href={reja} data-reja-havola>Build my plan</a>
      </article>
    </section>

    <section class="bolim" aria-labelledby="rasmiy-h" id="rasmiy">
      <h2 id="rasmiy-h">Official practice samples</h2>
      <p class="ikkinchi">Links go to external sites and open in a new window.</p>
      <div class="manbalar">
        {namunalar.map((n) => <a class="karta-havola" href={n.manba.havola} target="_blank" rel="noopener">
          <article class="karta"><h3>{n.nomi}</h3><p class="kichik">{n.tavsif}</p><span class="kichik">{new URL(n.manba.havola).hostname}</span></article>
        </a>)}
      </div>
    </section>
    <footer class="eslatma">
      <p>IELTS is jointly owned by the British Council, IDP IELTS and Cambridge University Press & Assessment and is a registered trademark (<a href={manba('IE08').havola}>ielts.org</a>). Tayanch is not affiliated with them; these practice materials are not official IELTS material.</p>
      <p>Results are not guaranteed. The band is an estimate and is shown only for a full 40-question mock.</p>
    </footer>
    <ManbaBlok manbalar={['IE01', 'IE03', 'ID01', 'BC01', 'IE08']} tekshirilgan="2026-11-12" keyingiTekshiruv="2026-12-12" tekshirilmagan={["The IELTS.org page does not say whether its samples are free."]} />
  </div>
</BolimQobiq>

<script>
  import { KALIT_IELTS_REJA } from '../../../data/ieltsSahifalar';
  import { darsKalitlari } from '../../../data/darsTurlar';
  import { urinishOmbori, FAOL_KALIT, URINISHLAR_KALIT } from '../../../lib/ielts/reading/ombor';
  import { qolganMs, vaqtMatn } from '../../../lib/ielts/reading/taymer';
  import { bandMatn } from '../../../lib/ielts/reading/band';
  import { READING_YOL } from '../../../lib/ielts/reading/ekran/yollar';
  import { yol } from '../../../lib/yol';

  const ildiz = document.querySelector<HTMLElement>('[data-ielts-bosh]')!;
  const M = JSON.parse(ildiz.dataset.ieltsBosh!) as { testlar: { id: string; nomi: string; jami: number }[]; darsIdlar: string[] };
  const top = <T extends HTMLElement = HTMLElement>(belgi: string) => ildiz.querySelector<T>(`[data-${belgi}]`)!;
  const oqi = (kalit: string): string | null => {
    try { return localStorage.getItem(kalit); } catch { return null; }
  };
  const json = (kalit: string): unknown => {
    try { return JSON.parse(oqi(kalit) ?? 'null'); } catch { return null; }
  };
  const obyekt = (x: unknown): x is Record<string, unknown> => !!x && typeof x === 'object' && !Array.isArray(x);
  // Eski va buzilgan yozuvlarni tekshiruvchi mavjud ombor ishlatiladi. Bu ekran faqat o'qiydi.
  const ombor = urinishOmbori({ oqi, yoz: () => false, ochir: () => {}, doimiy: false });
  let faol = ombor.faol();
  let taymer: number | undefined;
  let yangilanish = 0;

  function vaqtniYangila() {
    window.clearTimeout(taymer);
    if (!faol) return;
    const ms = qolganMs(faol.deadline, Date.now());
    top('davom-vaqt').textContent = ms > 0 ? `${vaqtMatn(ms)} left` : 'Time is up';
    top('davom-havola').textContent = ms > 0 ? 'Continue' : 'Open attempt';
    if (ms > 0 && !document.hidden) taymer = window.setTimeout(vaqtniYangila, Math.min(ms, 1000));
  }

  async function yangila() {
    const versiya = ++yangilanish;
    faol = ombor.faol();
    const tarix = ombor.urinishlar();
    top('davom').hidden = !faol;
    top('tanishuv').hidden = !!faol;
    const yangi = ildiz.querySelector<HTMLElement>('[data-yangi-test]');
    if (yangi) yangi.hidden = !!faol;
    top('davom-javob').hidden = true;
    vaqtniYangila();
    if (faol) {
      const test = M.testlar.find((t) => t.id === faol!.testId);
      top('davom').querySelector('h2')!.textContent = test?.nomi ?? 'Saqlangan Reading urinishi';
    }

    const reja = json(KALIT_IELTS_REJA);
    const rejaBor = obyekt(reja) && obyekt(reja.javob) && typeof reja.javob.qiyin === 'string' && reja.javob.qiyin.length > 0;
    top('reja-havola').textContent = rejaBor ? "Open today's tasks" : 'Build my plan';
    top('reja-izoh').textContent = rejaBor
      ? "Open your saved 30-day plan and continue today's practice."
      : 'Choose how long you have until the test, how many hours a day you are free and which section is hardest. Your 30-day plan is built from these.';

    const statistika = top('statistika');
    statistika.replaceChildren();
    const qator = (nomi: string, qiymat: string, href?: string) => {
      const div = document.createElement('div');
      const dt = document.createElement('dt'); dt.textContent = nomi;
      const dd = document.createElement('dd');
      const matn = href ? document.createElement('a') : document.createElement('span');
      matn.textContent = qiymat;
      if (matn instanceof HTMLAnchorElement) matn.href = href!;
      dd.append(matn); div.append(dt, dd); statistika.append(div);
    };
    if (tarix.length) {
      qator('Reading tests taken', String(tarix.length));
      const oxirgi = tarix[tarix.length - 1];
      const saqlanganJami = Object.values(oxirgi.perTypeStats).reduce((soni, stat) => {
        return soni + (stat && Number.isSafeInteger(stat.jami) && stat.jami > 0 ? stat.jami : 0);
      }, 0);
      const jami = saqlanganJami || M.testlar.find((t) => t.id === oxirgi.testId)?.jami;
      const natija = jami ? `${oxirgi.raw}/${jami}` : `${oxirgi.raw} correct`;
      const band = jami === 40 ? ` · estimated band ${bandMatn(oxirgi.band, 'below 2.0')}` : '';
      qator('Latest Reading result', natija + band, `${yol(READING_YOL.natija)}?urinish=${encodeURIComponent(oxirgi.id)}`);
    }
    const progress = json(darsKalitlari('ielts').progress);
    const togri = new Set<string>();
    if (obyekt(progress)) {
      for (const modul of Object.values(progress)) {
        if (!obyekt(modul)) continue;
        for (const [id, javob] of Object.entries(modul)) if (javob === 'togri' && M.darsIdlar.includes(id)) togri.add(id);
      }
    }
    if (togri.size) qator('Lessons', `${togri.size}/${M.darsIdlar.length} drills correct`);
    const takror = json('tayanch:ielts-takrorlash');
    if (obyekt(takror) && takror.versiya === 1 && obyekt(takror.savollar)) {
      const kutmoqda = Object.values(takror.savollar).filter((x) => obyekt(x) && typeof x.quti === 'number' && Number.isInteger(x.quti) && x.quti >= 1 && x.quti < 5).length;
      if (kutmoqda) qator('Saved for review', String(kutmoqda));
    }
    top('holat').hidden = statistika.children.length === 0;

    // Savol matnlari bosh sahifaga joylanmaydi. Faqat faol test kerak bo'lsa yuklanadi.
    if (!faol || !M.testlar.some((t) => t.id === faol!.testId)) return;
    const urinish = faol;
    try {
      const [{ yuklaTest }, { baholash }] = await Promise.all([
        import('../../../lib/ielts/reading/ekran/yollar'),
        import('../../../lib/ielts/reading/ball'),
      ]);
      const test = await yuklaTest(urinish.testId);
      if (versiya !== yangilanish) return;
      let matn = 'Your saved answers are shown inside the test.';
      if (typeof test !== 'string') {
        const baho = baholash(test, urinish.answers);
        matn = `${baho.jami - baho.javobsiz}/${baho.jami} questions answered`;
      }
      top('davom-javob').textContent = matn;
      top('davom-javob').hidden = false;
    } catch {
      if (versiya !== yangilanish) return;
      top('davom-javob').textContent = 'Your saved answers are shown inside the test.';
      top('davom-javob').hidden = false;
    }
  }

  void yangila();
  document.addEventListener('visibilitychange', () => { if (!document.hidden) void yangila(); else window.clearTimeout(taymer); });
  addEventListener('pageshow', (event) => { if (event.persisted) void yangila(); });
  addEventListener('storage', (event) => {
    if (event.key === null || [FAOL_KALIT, URINISHLAR_KALIT, KALIT_IELTS_REJA, darsKalitlari('ielts').progress, 'tayanch:ielts-takrorlash'].includes(event.key)) void yangila();
  });
</script>

<style>
  .ielts { display: grid; gap: var(--space-10); padding-top: var(--space-4); }
  .ielts [hidden] { display: none !important; }
  .hero { display: grid; gap: var(--space-8); padding: var(--space-6); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-xl); background: var(--qavat-fon-shisha); box-shadow: var(--shadow-2); }
  .hero-matn, .format, .bolim, .karta, .davom { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-width: 0; }
  .hero h1 { font-size: var(--text-h1-size); line-height: var(--text-h1-lh); letter-spacing: var(--text-h1-ls); }
  .ustki { font-size: var(--text-caption-size); line-height: var(--text-caption-lh); font-weight: var(--text-caption-weight); color: var(--color-text-secondary); }
  .lead, .ikkinchi { color: var(--color-text-secondary); max-width: var(--size-measure); }
  .kichik { font-size: var(--text-small-size); line-height: var(--text-small-lh); color: var(--color-text-secondary); }
  .amallar { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .format { gap: var(--space-3); }
  .konikmalar { width: 100%; }
  .konikma-havola { display: block; text-decoration: none; border-radius: var(--radius-md); }
  .konikma { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; padding: var(--space-4) var(--space-2); }
  .konikma-havola + .konikma-havola { border-top: var(--border-width-1) solid var(--color-border); }
  .konikma h3 { font-size: var(--text-body-size); line-height: var(--text-body-lh); }
  .ikonka { color: var(--color-link); }
  .yorliq { display: inline-block; padding: var(--space-1) var(--space-2); margin-top: var(--space-2); border-radius: var(--radius-full); font-size: var(--text-caption-size); line-height: var(--text-caption-lh); color: var(--color-text-secondary); background: var(--color-surface-sunken); }
  .ochiq { color: var(--color-success-text); background: var(--color-success-subtle); }
  .davom { width: 100%; padding: var(--space-5); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .davom h2 { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); }
  .davom-vaqt { font-size: var(--text-h3-size); font-weight: var(--text-h3-weight); font-variant-numeric: tabular-nums; }
  .holat-va-reja { display: grid; gap: var(--space-5); }
  .karta { padding: var(--space-6); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-1); }
  .karta .t-tugma { margin-top: auto; }
  .karta-havola { display: flex; min-width: 0; text-decoration: none; border-radius: var(--radius-lg); }
  .karta-havola .karta { width: 100%; }
  .karta h3 { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); }
  .karta-havola .yorliq { margin-top: auto; }
  .qollanmalar, .manbalar { display: grid; gap: var(--space-4); width: 100%; }
  .statistika { display: grid; gap: var(--space-3); width: 100%; margin: 0; }
  .statistika > div { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding-block: var(--space-3); border-bottom: var(--border-width-1) solid var(--color-border); }
  .statistika dt { color: var(--color-text-secondary); }
  .statistika dd { margin: 0; font-weight: var(--text-button-weight); }
  .eslatma { display: grid; gap: var(--space-3); font-size: var(--text-small-size); line-height: var(--text-small-lh); color: var(--color-text-secondary); }
  @media (hover: hover) { a.karta-havola:hover .karta, a.konikma-havola:hover { background: var(--color-surface-sunken); } }
  @media (min-width: 768px) {
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); padding: var(--space-10); align-items: center; }
    .qollanmalar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .manbalar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .holat-va-reja:has([data-holat]:not([hidden])) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) { .qollanmalar { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .hero:has([data-davom]:not([hidden])) { padding: var(--space-4); }
    .hero:has([data-davom]:not([hidden])) .hero-matn { gap: var(--space-3); }
    .amallar, .amallar .t-tugma, .davom .t-tugma { width: 100%; }
    .strelka { display: none; }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .hero { background: var(--color-surface); } }
  @media (prefers-reduced-transparency: reduce) { .hero { background: var(--color-surface); } }
</style>
