---
// IELTS bo'limi kirishi. Dizayn: Tayanch-IELTS-dizayn.md, "Main" va "KirishTelefon" ekranlari.
// Vaqtlar: IE01 (ielts.org). Rasmiy namunalar: IE03 (ielts.org), ID01 (IDP), BC01 (British Council).
// Savdo belgisi eslatmasi: IE07 (ielts.org sahifa osti).
// Qayta tuzish (2026-11-12, muallif qarorni Claude'ga topshirdi): Reading test bor bo'lsa (build vaqtida)
// asosiy tugma testga olib boradi, aks holda 30 kunlik rejaga.
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../components/ManbaBlok.astro';
import Zina from '../../../components/Zina.astro';
import QavatFoto from '../../../components/QavatFoto.astro';
import { qollanmalar, asos, mashqlar, IKONKA, KALIT_IELTS_REJA } from '../../../data/ieltsSahifalar';
import { manbalar } from '../../../data/manbalar';
import { saytTestlari } from '../../../lib/ielts/reading/saytTestlari';
import { yol } from '../../../lib/yol';

const m = (id: string) => manbalar.find((x) => x.id === id)!;
const reja = yol('/uz/ielts/vosita/reja/');
const reading = yol('/uz/ielts/qollanma/reading/');
const readingTest = yol('/uz/ielts/mashq/reading/');
const testBor = (await saytTestlari()).length > 0;
const tezNomlar = [...qollanmalar.filter((q) => !q.qism).map((q) => q.nomi), asos.nomi];
// daqiqa: [eng kam, eng ko'p], matndagi raqamlardan (IE01). Davomiylik chizig'i shulardan, yangi raqam yo'q.
const bolimlar: { nomi: string; vaqt: string; ikonka: string; daqiqa: [number, number]; href?: string }[] = [
  { nomi: 'Listening', vaqt: 'Taxminan 30 daqiqa', ikonka: IKONKA.listening, daqiqa: [30, 30] },
  { nomi: 'Reading', vaqt: "60 daqiqa (ko'chirish vaqti ichida)", ikonka: IKONKA.reading, daqiqa: [60, 60], href: reading },
  { nomi: 'Writing', vaqt: '60 daqiqa', ikonka: IKONKA.writing, daqiqa: [60, 60] },
  { nomi: 'Speaking', vaqt: '11–14 daqiqa', ikonka: IKONKA.speaking, daqiqa: [11, 14] },
];
const engUzun = Math.max(...bolimlar.map((b) => b.daqiqa[1]));
const ulush = (n: number) => Math.round((n / engUzun) * 1000) / 1000;
const tezQollanmalar = qollanmalar.filter((q) => !q.qism).length;
const qadamlar = [
  { nomi: 'Format bilan tanish', tavsif: "To'rt bo'limning har birida nima so'raladi va qancha vaqt beriladi.", havola: 'Format kartalari', href: reading },
  testBor
    ? { nomi: 'Reading testini ishla', tavsif: "60 daqiqa, 40 savol. Natija va taxminiy band darhol chiqadi, qaysi savol turi qiyinligi ham ko'rinadi.", havola: 'Testni boshlash', href: readingTest }
    : { nomi: 'Rasmiy namunani ishla', tavsif: "Bepul rasmiy namunani soat bilan ishla. Qaysi bo'lim qiyinroq ekani shunda ko'rinadi.", havola: 'Rasmiy namunalar', href: '#rasmiy' },
  { nomi: '30 kunlik reja tuz', tavsif: "Uchta savolga javob ber: reja qiyin bo'limingga ko'proq kun ajratadi.", havola: 'Reja tuzish', href: reja },
];
const namunalar = [
  { nomi: 'IELTS.org', tavsif: "Academic namuna topshiriqlari: to'rt ko'nikma, Listening va Reading uchun javob kalitlari.", manba: m('IE03') },
  { nomi: 'IDP', tavsif: 'Bepul tanishuv testlari: Listening, Reading, Writing va Speaking 1-qism.', manba: m('ID01') },
  { nomi: 'British Council', tavsif: "Academic, General Training va UKVI uchun to'rt ko'nikma bo'yicha bepul mashq testlari, kompyuter formati bilan tanishish testi ham bor.", manba: m('BC01') },
];
---
<BolimQobiq
  title="IELTS"
  description="IELTS'ga mustaqil tayyorgarlik: har bo'lim uchun strategiya, IELTS formatidagi mashq testi va 30 kunlik reja. Bepul, ro'yxatdan o'tmasdan."
  turi="bolim-kirishi"
  bolim="ielts"
  holat="qoralama"
>
  <div class="ichki ielts">
    <QavatFoto bolim="ielts" />
    <section class="hero" aria-labelledby="ielts-h">
      <div class="hero-matn">
        <p class="ustki-kok">IELTS bo'limi · mustaqil tayyorgarlik</p>
        <h1 id="ielts-h">IELTS'ga o'zing tayyorlan,<br /><span class="kok">reja bilan.</span></h1>
        <p class="lead">{testBor
          ? "Bu yerda har bo'lim uchun strategiya, IELTS formatidagi Reading testi va kunma-kun reja bor. Bepul, ro'yxatdan o'tmasdan, telefonda ham. Natijani esa hech kim kafolatlay olmaydi, biz ham: u sening mashqingga bog'liq."
          : "Bu yerda har bo'lim uchun strategiya va kunma-kun mashq rejasi bor. Natijani esa hech kim kafolatlay olmaydi, biz ham: u sening mashqingga bog'liq."}</p>
        <div class="cta">
          <a class="katta asosiy" href={testBor ? readingTest : reja}>
            {testBor ? 'Bepul Reading testi' : '30 kunlik reja tuzish'}
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="katta ikkinchi" href={testBor ? reja : '#boshla'}>{testBor ? '30 kunlik reja' : 'Qayerdan boshlayman?'}</a>
        </div>
      </div>

      <div class="format" aria-labelledby="format-h">
        <h2 id="format-h" class="ustki-yorliq">Imtihon to'rt bo'limdan iborat</h2>
        <ul>
          {bolimlar.map((x, i) => {
            const Teg = x.href ? 'a' : 'div';
            return (
              <li>
                <Teg class="f-qator" href={x.href}>
                  <span class="f-belgi" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={x.ikonka} /></span>
                  <span class="f-matn">
                    <strong>{x.nomi}</strong>{' '}<span class="f-vaqt">{x.vaqt}</span>
                    <span class="vaqt-chiziq" aria-hidden="true" style={`--tartib: ${i}; --asos: ${ulush(x.daqiqa[0])}; --oraliq: ${ulush(x.daqiqa[1] - x.daqiqa[0])}`}>
                      <span class="vc-asos"></span>{x.daqiqa[1] > x.daqiqa[0] && <span class="vc-oraliq"></span>}
                    </span>
                  </span>
                  {x.href && <svg class="f-strelka" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>}
                </Teg>
              </li>
            );
          })}
        </ul>
        <p class="f-manba">IELTS Academic. Manba: <a href={m('IE01').havola} rel="noopener">ielts.org</a>, tekshirilgan {m('IE01').tekshirilganSana}.</p>
      </div>
      <script is:inline>
        // Davomiylik chizig'i karta ekranga kirganda bir marta to'ladi. JS yo'q yoki reduced motion: darhol to'liq.
        (() => {
          const karta = document.currentScript && document.currentScript.previousElementSibling;
          if (!karta || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          karta.setAttribute('data-kutish', '');
          const k = new IntersectionObserver((yozuvlar) => {
            if (!yozuvlar.some((y) => y.isIntersecting)) return;
            karta.removeAttribute('data-kutish');
            k.disconnect();
          }, { threshold: 0.4 });
          k.observe(karta);
        })();
      </script>
    </section>

    <section id="boshla" class="boshla" aria-labelledby="boshla-h">
      <div class="bosh-qator">
        <h2 id="boshla-h">Qayerdan boshlayman?</h2>
        <p class="izoh">Shu tartibda, bir haftadan kam vaqtda</p>
      </div>
      <ol class="qadamlar">
        {qadamlar.map((q, i) => (
          <li>
            <span class={i === 2 ? 'raqam kok-raqam' : 'raqam'} aria-hidden="true">{i + 1}</span>
            <div class="q-matn"><h3>{q.nomi}</h3><p>{q.tavsif}</p></div>
            <a href={q.href}>{q.havola}</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="reja-karta" aria-labelledby="reja-cta-h" data-reja-kalit={KALIT_IELTS_REJA}>
      <div class="rk-matn">
        <p class="ustki-kok">Asosiy qadam</p>
        <div id="reja-yoq">
          <h2 id="reja-cta-h">Uch savolga javob ber, 30 kunlik rejang tayyor</h2>
          <p class="izoh-m">Imtihongacha qancha vaqt qolgani, kuniga necha soat bo'shligi va qaysi bo'lim qiyinligi. Reja shulardan tuziladi.</p>
          <div class="rk-tugmalar">
            <a class="katta asosiy katta-56" href={reja}>
              Rejani tuzish
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <p class="izoh">Ro'yxatdan o'tish ham, email ham kerak emas.</p>
          </div>
        </div>
        <div id="reja-bor" hidden>
          <h2 id="reja-bor-h">Rejang davom etmoqda: <span id="reja-soni">0</span> / 30 kun belgilangan</h2>
          <div class="iz" aria-hidden="true"><div class="toldirish" id="reja-toldirish"></div></div>
          <div class="rk-tugmalar">
            <a class="katta asosiy" href={reja}>Bugungi kunni ochish</a>
          </div>
        </div>
      </div>
      <div class="rk-namuna" aria-hidden="true">
        <p class="ustki-yorliq">1-hafta, namuna</p>
        <div class="kun"><span class="katak toldirilgan"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg></span><span class="kun-raqam">1-kun</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.writing} />Writing</div>
        <div class="kun"><span class="katak"></span><span class="kun-raqam">2-kun</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.listening} />Listening</div>
        <div class="kun"><span class="katak"></span><span class="kun-raqam">3-kun</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={IKONKA.writing} />Writing</div>
      </div>
    </section>

    <section class="qollanmalar" aria-labelledby="mashq-h">
      <h2 id="mashq-h">Mashq testlari</h2>
      <div class="kul-blok">
        <ul>
          {mashqlar.slice().reverse().map((m) => (
            <li>
              <a class="q-qator" href={yol(`/uz/ielts/${m.qism}`)}>
                <svg class="q-ikonka" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={m.ikonka} />
                <span class="q-nom"><strong>{m.nomi}</strong><span>{m.tavsif}</span></span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="qollanmalar" aria-labelledby="qol-h">
      <h2 id="qol-h">Qo'llanmalar</h2>
      <div class="q-tor">
        <div class="kul-blok bolim-qollanma">
          <h3 class="ustki-yorliq">IELTS bo'limlari</h3>
          <ul id="ielts-qollanma-royxat">
            {qollanmalar.map((q) => (
              <li class={q.qism ? undefined : 'tez-band'}>
                {q.qism ? (
                  <a class="q-qator" href={yol(`/uz/ielts/${q.qism}`)}>
                    <svg class="q-ikonka" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={q.ikonka} />
                    <span class="q-nom"><strong>{q.nomi}</strong><span>{q.tavsif}</span></span>
                    <span class="pill-ochiq">ochiq</span>
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
                  </a>
                ) : (
                  <div class="q-qator nofaol">
                    <svg class="q-ikonka" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={q.ikonka} />
                    <span class="q-nom"><strong>{q.nomi}</strong><span>{q.tavsif}</span></span>
                    <span class="pill-tez">tez orada</span>
                  </div>
                )}
              </li>
            ))}
          </ul>
          <button type="button" class="tez-tugma" aria-expanded="true" aria-controls="ielts-qollanma-royxat">
            <span>Yana {tezQollanmalar} ta qo'llanma tez orada</span>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          <script is:inline>
            // Telefonda (<= 640px) tez-oradagi qo'llanmalar yig'iladi, tugma ochadi/yopadi. Kengroq ekranda yoki JS'siz hammasi ko'rinadi. Holat saqlanmaydi.
            (() => {
              const tugma = document.currentScript && document.currentScript.previousElementSibling;
              const blok = tugma && tugma.closest('.bolim-qollanma');
              if (!blok) return;
              tugma.setAttribute('aria-expanded', 'false');
              tugma.addEventListener('click', () => {
                const ochiq = tugma.getAttribute('aria-expanded') !== 'true';
                tugma.setAttribute('aria-expanded', String(ochiq));
                blok.toggleAttribute('data-ochiq', ochiq);
              });
              blok.setAttribute('data-yigma', '');
            })();
          </script>
        </div>
        <div class="kul-blok">
          <h3 class="ustki-yorliq">Asos</h3>
          <div class="asos nofaol">
            <div class="asos-bosh">
              <svg class="q-ikonka" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={asos.ikonka} />
              <span class="pill-tez">tez orada</span>
            </div>
            <strong>{asos.nomi}</strong>
            <span>{asos.tavsif}</span>
          </div>
        </div>
      </div>
    </section>

    <section id="rasmiy" class="rasmiy" aria-labelledby="rasmiy-h">
      <div class="r-bosh">
        <h2 id="rasmiy-h">Rasmiy bepul namunalar</h2>
        <p class="izoh-m">Mashqni rasmiy namunadan boshla: format va qiyinlik haqiqiy imtihonga eng yaqin shu yerda. Havolalar tashqi saytga, yangi oynada ochiladi.</p>
      </div>
      <ul class="r-royxat">
        {namunalar.map((n) => (
          <li>
            {n.manba ? (
              <a class="r-qator" href={n.manba.havola} target="_blank" rel="noopener">
                <span class="r-nom">{n.nomi}</span>
                <span class="r-matn"><span>{n.tavsif}</span><span class="r-url">{new URL(n.manba.havola).hostname}</span></span>
                <svg role="img" aria-label="Tashqi havola, yangi oynada" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7M10 14L21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" /></svg>
              </a>
            ) : (
              <div class="r-qator nofaol">
                <span class="r-nom">{n.nomi}</span>
                <span class="r-matn"><span>{n.tavsif}</span></span>
                <span class="pill-tez">tekshirilmoqda</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="pastki" aria-label="Telegram va eslatma">
      <div class="telegram">
        <span class="t-belgi" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z" /></svg></span>
        <span class="t-matn"><strong>Telegram kanal</strong><span class="pill-tez">tez orada</span></span>
      </div>
      <div class="eslatma">
        <p>IELTS British Council, IDP IELTS va Cambridge University Press & Assessment'ning birgalikdagi mulki va ro'yxatdan o'tgan savdo belgisi (<a href={m('IE07').havola} rel="noopener">ielts.org</a>). Tayanch ular bilan bog'liq emas, mashqlar rasmiy IELTS materiali emas.</p>
      </div>
    </section>

    <Zina />

    <ManbaBlok
      manbalar={['IE01', 'IE03', 'ID01', 'BC01', 'IE07']}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "IELTS.org namunalari bepulligi sahifada yozilmagan.",
        `${tezNomlar.join(', ')} qo'llanmalari hali yozilmagan.`,
      ]}
    />
  </div>
</BolimQobiq>

<script>
  // Reja kartasi: brauzerda reja bo'lsa, "davom etmoqda" holati.
  const karta = document.querySelector<HTMLElement>('.reja-karta')!;
  try {
    const r = JSON.parse(localStorage.getItem(karta.dataset.rejaKalit!) || 'null');
    if (r && r.javob && r.javob.qiyin) {
      const soni = Object.values(r.bajarilgan || {}).filter(Boolean).length;
      document.getElementById('reja-yoq')!.hidden = true;
      document.getElementById('reja-bor')!.hidden = false;
      document.getElementById('reja-soni')!.textContent = String(soni);
      document.getElementById('reja-toldirish')!.style.width = Math.round((soni / 30) * 100) + '%';
      karta.setAttribute('aria-labelledby', 'reja-bor-h');
    }
  } catch { /* brauzer ruxsat bermadi: bo'sh holat qoladi */ }
</script>

<style>
  .ielts { padding-top: var(--b-14); display: flex; flex-direction: column; gap: var(--b-16); max-width: calc(912px + 2 * var(--b-10)) !important; }
  .kok { color: var(--rang-havola); }
  .ustki-kok { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rang-havola); }
  .ustki-yorliq { margin: 0; font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-ikkinchi); line-height: 1.4; }
  .izoh { font-size: var(--matn-kichik); font-weight: 500; color: var(--matn-ikkinchi); }
  .izoh-m { line-height: 1.6; color: var(--matn-ikkinchi); max-width: 62ch; }
  h2 { font-size: 32px; font-weight: 800; line-height: 1.2; }
  .pill-tez, .pill-ochiq { padding: 4px 12px; border-radius: var(--r-toliq); font-size: var(--matn-mayda); font-weight: 700; white-space: nowrap; }
  .pill-tez { background: var(--sirt-ikkinchi); color: var(--matn-ikkinchi); }
  .pill-ochiq { background: var(--rang-asosiy-och); color: var(--rang-havola); }

  .katta {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--b-3);
    min-height: var(--control-height-md); padding: 0 28px; border-radius: var(--r-toliq);
    text-decoration: none; font-weight: 800; font-size: 16px;
  }
  .katta-56 { min-height: 56px; padding: 0 32px; font-size: 18px; }
  .katta.asosiy { background: var(--btn-primary-bg); color: var(--btn-primary-text); }
  .katta.asosiy:hover { background: var(--btn-primary-bg-hover); }
  .katta.ikkinchi { background: var(--fon-ikkinchi); color: var(--matn); font-weight: 700; }
  .katta.ikkinchi:hover { background: var(--sirt-ikkinchi); }

  /* Hero */
  .hero { display: flex; gap: var(--b-8); align-items: stretch; }
  .hero-matn { flex: 3 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--b-5); }
  .hero h1 { font-size: 46px; line-height: 1.1; font-weight: 800; letter-spacing: var(--oraliq-sarlavha); }
  .lead { line-height: 1.6; color: var(--matn-ikkinchi); max-width: 56ch; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--b-3); padding-top: var(--b-1); }
  .format {
    flex: 2 1 0; min-width: 0;
    background: var(--qora); color: var(--qora-matn);
    border: 1px solid var(--qora-chiziq); border-radius: var(--r-katta);
    padding: var(--b-6); display: flex; flex-direction: column; gap: var(--b-4);
  }
  .format .ustki-yorliq { color: var(--rang-asosiy-qorada); }
  .format ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--b-2); }
  .f-qator { background: var(--qora-sirt); border: 1px solid var(--qora-chiziq); border-radius: var(--r-orta); padding: 12px 16px; display: flex; align-items: center; gap: var(--b-3); color: var(--qora-matn); text-decoration: none; }
  a.f-qator:hover { background: var(--qora-chiziq); }
  .f-matn { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .f-strelka { flex: none; width: var(--size-icon-md); color: var(--qora-matn-ikkinchi); }
  /* Havolasiz qatorda ham strelka joyi: hamma chiziq bir shkalada */
