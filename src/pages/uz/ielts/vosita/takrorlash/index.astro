---
// IELTS takrorlash: darslardagi xatolar (tayanch:ielts-xato-daftari) va Reading test urinishlaridagi
// xato yoki javobsiz savollar (tayanch:ielts-reading-urinishlar:v1) Leitner qutilariga tushadi: tayanch:ielts-takrorlash.
// Ikkala manba faqat o'qiladi. Dars javobi darsSaqlash.javobniYoz orqali dars progressiga ham yoziladi.
// Test savolining id si "<testId>#<birinchi raqam>", test JSON brauzerda yuklanadi (src/lib/ielts/reading/takrorlash.ts).
// Oraliqlar (1, 3, 7, 14 kun) Tayanch tanlovi. Telefon: bitta ustun, tugmalar to'liq kenglikda.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { yol } from '../../../../../lib/yol';
import { hammaSavollar, modulNomi, type DarsModul } from '../../../../../data/ieltsDarslar';
import '../../../../../styles/ielts-reading.css';

const darsQism: Record<DarsModul, string> = {
  'ir-tfng': 'qollanma/reading/tfng/',
  'ir-sarlavha': 'qollanma/reading/sarlavhalar/',
};
// Dars sahifalaridagi savolKorsatma bilan bir xil.
const korsatma: Record<DarsModul, string> = {
  'ir-tfng': 'Read the passage. If the statement agrees with the information in the text, choose True; if it contradicts it, False; if the text gives no information about it, Not Given.',
  'ir-sarlavha': 'Read the paragraph and choose the heading that best sums up its main idea.',
};
const darslar = (Object.keys(darsQism) as DarsModul[]).map((m) => ({ modul: m, nomi: modulNomi[m], href: yol(`/uz/ielts/${darsQism[m]}`) }));
const readingTest = yol('/uz/ielts/mashq/reading/');

const malumot = {
  savollar: hammaSavollar.map((s) => ({
    id: s.id, modul: s.modul, mavzu: s.mavzu, qiyinlik: s.qiyinlik, verified: s.verified,
    parcha: s.parcha ?? '', matn: s.matn, yechim: s.yechim, togri: s.togri,
    variantlar: s.variantlar.map((v) => v.matn), xatolar: s.variantlar.map((v) => v.xato ?? ''),
    korsatma: korsatma[s.modul],
  })),
  darslar: Object.fromEntries(darslar.map((d) => [d.modul, { nomi: d.nomi, href: d.href }])),
  readingTest,
};
---
<BolimQobiq
  title="Review · IELTS"
  description="Review the questions you got wrong in lessons and Reading tests, spaced out: after 1, 3, 7 and 14 days. Data is saved only in this browser."
  turi="vosita"
  yol={['Tools']}
  bolim="ielts"
  holat="chop-etilgan"
>
  <div class="ichki takror">
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Tool</span><span class="pill pill-chiziq">Draft</span></p>
      <h1>Review your mistakes</h1>
      <p class="lead">Questions you got wrong in lessons and Reading tests land here and come back at spaced intervals: tomorrow, then after 3, 7 and 14 days. If you get one right, it moves to the next box; if you get it wrong, it goes back to the start.</p>
    </header>

    <p class="kichik ikkinchi">The questions are samples written for Tayanch, not official IELTS material. The intervals are Tayanch's choice.</p>

    <section class="royxat" id="royxat" aria-labelledby="royxat-h">
      <h2 id="royxat-h" tabindex="-1">Today's review</h2>
      <dl class="qiymatlar">
        <div><dt>Today</dt><dd id="son-bugun">0</dd></div>
        <div><dt>Later</dt><dd id="son-keyin">0</dd></div>
        <div><dt>Mastered</dt><dd id="son-ozl">0</dd></div>
      </dl>
      <p class="holat-matn" id="holat-matn"></p>
      <p class="kichik ikkinchi" id="yuklash-holat" aria-live="polite" hidden></p>
      <div class="tugmalar">
        <button type="button" class="t-tugma ielts-tugma--urgu" id="boshla" hidden>Start review</button>
        <button type="button" class="t-tugma t-tugma--ikkinchi" id="oldin" hidden>Review the later ones now</button>
      </div>

      <div class="darslar" id="darslar" hidden>
        <h3>Where mistakes come from</h3>
        <ul>
          {darslar.map((d) => <li><a href={d.href}>{d.nomi}</a></li>)}
          <li><a href={readingTest}>Reading test</a></li>
        </ul>
      </div>

      <details class="guruh" id="g-keyin" hidden>
        <summary>Due later (<span id="g-keyin-son">0</span>)</summary>
        <ul class="g-royxat" id="g-keyin-royxat"></ul>
      </details>
      <details class="guruh" id="g-ozl" hidden>
        <summary>Mastered (<span id="g-ozl-son">0</span>)</summary>
        <ul class="g-royxat" id="g-ozl-royxat"></ul>
      </details>
    </section>

    <section class="sessiya" id="sessiya" aria-labelledby="sessiya-h" hidden>
      <div class="s-bosh">
        <h2 id="sessiya-h">Review</h2>
        <p class="kichik ikkinchi" id="s-hisob" aria-live="polite"></p>
      </div>
      <form class="savol-karta" id="karta" novalidate>
        <fieldset class="s-savol" id="savol">
          <legend class="sr" id="s-legend"></legend>
          <p class="s-meta" id="s-meta"></p>
          <p class="s-korsatma" id="s-korsatma"></p>
          <div class="s-parcha" id="s-parcha" lang="en" hidden></div>
          <p class="s-matn" id="s-matn" tabindex="-1" lang="en"></p>
          <div class="s-nazorat" id="nazorat"></div>
          <div class="izoh" id="izoh" aria-live="polite" hidden>
            <p class="izoh-sarlavha" id="izoh-sarlavha"></p>
            <p class="izoh-xato" id="izoh-xato"></p>
            <p class="izoh-keyingi" id="izoh-keyingi"></p>
            <p><b>Solution.</b> <span id="izoh-yechim"></span></p>
            <p class="izoh-dalil" id="izoh-dalil-qator" hidden><b>Evidence in the text.</b> <q id="izoh-dalil" lang="en"></q></p>
          </div>
          <div class="s-tugmalar">
            <a class="t-tugma t-tugma--ikkinchi kok-tugma" id="s-manba" href="#">Go to the lesson</a>
            <button type="submit" class="t-tugma ielts-tugma--urgu" id="tekshir" disabled>Check</button>
            <button type="button" class="t-tugma" id="keyingi" hidden>Next</button>
          </div>
        </fieldset>
      </form>
      <div class="yakun" id="yakun" hidden>
        <p class="yakun-matn" id="yakun-matn" tabindex="-1"></p>
        <button type="button" class="t-tugma ielts-tugma--urgu" id="qaytish">Back to the list</button>
      </div>
      <button type="button" class="t-tugma t-tugma--ikkinchi" id="toxtat">Stop reviewing</button>
    </section>

    <div class="tozalash">
      <button type="button" class="t-tugma t-tugma--ikkinchi" id="tozala">Delete review history</button>
      <span class="tasdiq" id="tasdiq" hidden>Delete the boxes and dates? Your lesson mistake log and test results will stay.
        <button type="button" class="t-tugma t-tugma--ikkinchi" id="tasdiq-ha">Yes, delete</button>
        <button type="button" class="t-tugma t-tugma--ikkinchi" id="tasdiq-yoq">Cancel</button>
      </span>
      <p class="kichik ikkinchi" id="saqlash-holat" aria-live="polite">Your review progress is saved only in this browser.</p>
    </div>

    <ManbaBlok
      manbalar={[]}
      tekshirilgan="2026-11-12"
      keyingiTekshiruv="2026-12-12"
      tekshirilmagan={[
        "The review intervals (1, 3, 7, 14 days) are Tayanch's choice, not an official recommendation.",
        "The questions are samples written for Tayanch; those the author has not checked yet are marked \"unchecked\".",
        "For a test question, only the paragraph with the evidence is shown, not the whole text.",
      ]}
    />
  </div>
  <script type="application/json" id="takror-malumot" set:html={JSON.stringify(malumot)} />
</BolimQobiq>

<script>
  import { javobniYoz, bugun } from '../../../../../lib/darsSaqlash';
  import { sinxronla, guruhla, javobdanKeyin, holatniYoz, takrorKalit, type TakrorHolat } from '../../../../../lib/takrorlash';
  import { urinishOmbori } from '../../../../../lib/ielts/reading/ombor';
  import { yuklaTest } from '../../../../../lib/ielts/reading/ekran/yollar';
  import { testJavobTekshir, testSavollari, testXatolari, type TestSavolJoyi, type TestXato } from '../../../../../lib/ielts/reading/takrorlash';
  import { savolTuri } from '../../../../../lib/ielts/reading/turlar/registr';
  import { savolRaqamlari, type ReadingTest } from '../../../../../lib/ielts/reading/sxema';

  interface D {
    id: string; modul: string; mavzu: string; qiyinlik: string; verified: boolean;
    parcha: string; matn: string; yechim: string; togri: number; variantlar: string[]; xatolar: string[];
    korsatma: string;
  }
  const BOLIM = 'ielts';
  const HARF = 'ABCDEFGH';
  const OYLAR = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const M = JSON.parse($('takror-malumot').textContent || '{}') as {
    savollar: D[]; darslar: Record<string, { nomi: string; href: string }>; readingTest: string;
  };
  const dars = new Map(M.savollar.map((s) => [s.id, s]));
  let testJoy = new Map<string, TestSavolJoyi>();
  let testXato: TestXato[] = [];
  const QIYINLIK: Record<string, string> = { oson: 'easy', "o'rta": 'medium', qiyin: 'hard' };
  const sanaMatn = (s: string) => { const [, m, d] = s.split('-').map(Number); return `${d} ${OYLAR[m - 1]}`; };
  const qisqa = (t: string) => (t.length > 80 ? `${t.slice(0, 77)}…` : t);
  const mavjud = () => new Set([...dars.keys(), ...testJoy.keys()]);

  let holat: TakrorHolat = sinxronla(BOLIM, mavjud());
  let navbat: string[] = [];
  let joriy = 0;
  let togriSoni = 0;
  let sinxKutilmoqda = false;

  /** Faqat ko'rsatib bo'ladigan savollar (testi yuklanmagan yozuvlar holatda qoladi, lekin ro'yxatga chiqmaydi). */
  const korinadigan = (): TakrorHolat => ({
    versiya: 1,
    savollar: Object.fromEntries(Object.entries(holat.savollar).filter(([id]) => dars.has(id) || testJoy.has(id))),
  });

  const saqlashHolati = (ok: boolean) => {
    $('saqlash-holat').textContent = ok
      ? 'Your review progress is saved only in this browser.'
      : 'The browser did not allow saving: if you close the page, your review progress will be lost.';
  };

  const nomi = (id: string) => {
    const d = dars.get(id);
    if (d) return `${M.darslar[d.modul]?.nomi ?? d.modul} · ${d.mavzu}`;
    const t = testJoy.get(id)!;
    const r = savolRaqamlari(t.savol);
    return `${t.test.title} · Passage ${t.passageTartib + 1} · Question ${r.join('–')}`;
  };

  // ---------- Ro'yxat ----------
  function qator(id: string, sana?: string): HTMLLIElement {
    const li = document.createElement('li');
    const nom = document.createElement('span');
    nom.className = 'g-nom';
    nom.textContent = nomi(id);
    li.append(nom);
    if (sana) { const t = document.createElement('span'); t.className = 'kichik ikkinchi'; t.textContent = sanaMatn(sana); li.append(t); }
    return li;
  }

  function royxatniChiz() {
    const k = korinadigan();
    const g = guruhla(k, bugun());
    $('son-bugun').textContent = String(g.bugun.length);
    $('son-keyin').textContent = String(g.keyinroq.length);
    $('son-ozl').textContent = String(g.ozlashtirildi.length);
    const bosh = g.bugun.length + g.keyinroq.length + g.ozlashtirildi.length === 0;
    $('holat-matn').textContent = bosh
      ? 'No mistakes. Questions you get wrong in lessons and the Reading test land here and come back the next day.'
      : g.bugun.length > 0
        ? `You have ${g.bugun.length} ${g.bugun.length === 1 ? 'question' : 'questions'} to review today.`
        : g.keyinroq.length > 0
          ? `Nothing to review today. Next: ${sanaMatn(k.savollar[g.keyinroq[0]].keyingi)}.`
          : 'All mistakes mastered. New ones will come from lessons and tests.';
    $<HTMLButtonElement>('boshla').hidden = g.bugun.length === 0;
    $<HTMLButtonElement>('boshla').textContent = `Start review (${g.bugun.length})`;
    $<HTMLButtonElement>('oldin').hidden = !(g.bugun.length === 0 && g.keyinroq.length > 0);
    $('darslar').hidden = !(bosh || (g.bugun.length === 0 && g.keyinroq.length === 0));

    $('g-keyin').hidden = g.keyinroq.length === 0;
    $('g-keyin-son').textContent = String(g.keyinroq.length);
    $('g-keyin-royxat').replaceChildren(...g.keyinroq.map((id) => qator(id, k.savollar[id].keyingi)));
    $('g-ozl').hidden = g.ozlashtirildi.length === 0;
    $('g-ozl-son').textContent = String(g.ozlashtirildi.length);
    $('g-ozl-royxat').replaceChildren(...g.ozlashtirildi.map((id) => qator(id)));
  }

  // ---------- Test xatolarini yuklash ----------
  async function testlarniYukla() {
    const urinishlar = urinishOmbori().urinishlar();
    const idlar = [...new Set(urinishlar.map((u) => u.testId))];
    if (idlar.length === 0) return;
    const holatEl = $('yuklash-holat');
    holatEl.hidden = false;
    holatEl.textContent = 'Loading Reading test mistakes…';
    const testlar = new Map<string, ReadingTest>();
    let xatoBor = false;
    await Promise.all(idlar.map(async (id) => {
      const t = await yuklaTest(id);
      if (t === 'xato') xatoBor = true;
      else if (t !== 'yoq') testlar.set(id, t);
    }));
    testJoy = testSavollari(testlar);
    testXato = testXatolari(urinishlar, testlar);
    if (xatoBor) holatEl.textContent = "Some Reading test questions didn't load (check your internet connection). They will appear next time.";
    else holatEl.hidden = true;
    if (!$('sessiya').hidden) { sinxKutilmoqda = true; return; }
    holat = sinxronla(BOLIM, mavjud(), testXato);
    royxatniChiz();
  }

  // ---------- Sessiya ----------
  function boshla(ids: string[]) {
    navbat = ids; joriy = 0; togriSoni = 0;
    $('royxat').hidden = true;
    $('sessiya').hidden = false;
    $('karta').hidden = false;
    $('yakun').hidden = true;
    $('toxtat').hidden = false;
    korsat();
  }

  const pill = (t: string, cls = 'pill') => { const p = document.createElement('span'); p.className = cls; p.textContent = t; return p; };

  function parchaQoy(paragraflar: { label?: string; text: string }[]) {
    const el = $('s-parcha');
    el.replaceChildren(...paragraflar.map((p) => {
      const q = document.createElement('p');
      q.className = 'rt-par';
      const h = document.createElement('span'); h.className = 'rt-par-harf'; h.textContent = p.label ?? '';
      const m = document.createElement('span'); m.textContent = p.text;
      q.append(h, m);
      return q;
    }));
    el.hidden = paragraflar.length === 0;
  }

  function nazoratYangila() {
    const n = $('nazorat');
    const bor =
      !!n.querySelector('input[type=radio]:checked, input[type=checkbox]:checked') ||
      [...n.querySelectorAll<HTMLSelectElement | HTMLInputElement>('select, input[type=text]')].some((x) => x.value.trim() !== '');
    $<HTMLButtonElement>('tekshir').disabled = !bor;
  }

  function korsat() {
    const id = navbat[joriy];
    const d = dars.get(id);
    const t = testJoy.get(id);
    $('s-hisob').textContent = `${joriy + 1} / ${navbat.length}`;
    $('s-legend').textContent = `Question ${joriy + 1} of ${navbat.length}`;
    const mavzu = document.createElement('span'); mavzu.className = 'kichik ikkinchi'; mavzu.textContent = nomi(id);
    const n = $('nazorat');
    const manba = $<HTMLAnchorElement>('s-manba');

    if (d) {
      $('s-meta').replaceChildren(pill('Sample'), pill(QIYINLIK[d.qiyinlik] ?? d.qiyinlik), mavzu, ...(d.verified ? [] : [pill('unchecked', 'pill pill-ogoh')]));
      $('s-korsatma').textContent = d.korsatma;
      $('s-korsatma').removeAttribute('lang');
      parchaQoy(d.parcha ? d.parcha.split(/\n\n+/).map((text) => ({ text })) : []);
      $('s-matn').textContent = d.matn;
      const g = document.createElement('div');
      g.className = 'variantlar';
      g.setAttribute('role', 'radiogroup');
      g.setAttribute('aria-labelledby', 's-matn');
      g.append(...d.variantlar.map((matn, j) => {
        const l = document.createElement('label'); l.className = 'variant';
        const inp = document.createElement('input'); inp.type = 'radio'; inp.name = 'takror-v'; inp.value = String(j);
        const h = document.createElement('span'); h.className = 'harf'; h.setAttribute('aria-hidden', 'true'); h.textContent = HARF[j];
        const m = document.createElement('span'); m.lang = 'en'; m.textContent = matn;
        l.append(inp, h, m);
        return l;
      }));
      n.replaceChildren(g);
      manba.textContent = 'Go to the lesson';
      manba.href = M.darslar[d.modul]?.href ?? '#';
    } else if (t) {
      $('s-meta').replaceChildren(pill('Namuna'), pill(t.passage.difficulty), mavzu);
      $('s-korsatma').textContent = t.guruh.instructions;
      $('s-korsatma').lang = 'en';
      parchaQoy(t.paragraf ? [t.paragraf] : []);
      $('s-matn').textContent = t.savol.prompt;
      n.innerHTML = savolTuri(t.guruh.type).render({ savol: t.savol, guruh: t.guruh, javob: undefined, matnId: 's-matn' });
      manba.textContent = 'Go to the Reading test';
      manba.href = M.readingTest;
    }
    $('izoh').hidden = true;
    $<HTMLButtonElement>('tekshir').hidden = false;
    $<HTMLButtonElement>('tekshir').disabled = true;
    $<HTMLButtonElement>('keyingi').hidden = true;
    $<HTMLButtonElement>('keyingi').textContent = joriy < navbat.length - 1 ? 'Next' : 'Finish';
    $('s-matn').focus({ preventScroll: true });
    $('sessiya').scrollIntoView({ block: 'start', behavior: 'auto' });
  }

  // "Choose TWO": ikkitadan ko'p belgilab bo'lmaydi.
  $('nazorat').addEventListener('change', (e) => {
    const x = e.target as HTMLInputElement;
    const guruh = x.closest<HTMLElement>('[data-chegara]');
    if (x.type === 'checkbox' && x.checked && guruh) {
      const chegara = Number(guruh.dataset.chegara);
      if (guruh.querySelectorAll('input:checked').length > chegara) x.checked = false;
    }
    nazoratYangila();
  });
  $('nazorat').addEventListener('input', nazoratYangila);

  function xomJavob(): unknown {
    const n = $('nazorat');
    const qutilar = [...n.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    if (qutilar.length) return qutilar.filter((x) => x.checked).map((x) => x.value);
    const radio = n.querySelector<HTMLInputElement>('input[type=radio]:checked');
    if (radio) return radio.value;
    return n.querySelector<HTMLSelectElement | HTMLInputElement>('select, input[type=text]')?.value ?? '';
  }

  $('karta').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!$('izoh').hidden || $<HTMLButtonElement>('tekshir').disabled) return;
    const id = navbat[joriy];
    const d = dars.get(id);
    const t = testJoy.get(id);
    const xom = xomJavob();
    const n = $('nazorat');
    n.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((x) => { x.disabled = true; });

    let togrimi = false;
    let sarlavha = '';
    let xatoIzoh = '';
    let yechim = '';
    let dalil = '';
    let ok1 = true;
    if (d) {
      const j = Number(xom);
      togrimi = j === d.togri;
      const labellar = n.querySelectorAll('.variant');
      labellar[d.togri]?.classList.add('togri');
      if (!togrimi) labellar[j]?.classList.add('xato');
      sarlavha = togrimi ? 'Correct.' : `Wrong. Correct answer: ${HARF[d.togri]}) ${d.variantlar[d.togri]}`;
      xatoIzoh = !togrimi && d.xatolar[j] ? `Common mistake: ${d.xatolar[j]}.` : '';
      yechim = d.yechim;
      ok1 = javobniYoz(BOLIM, d.modul, d.id, togrimi, qisqa(d.variantlar[j] ?? ''));
    } else if (t) {
      const r = testJavobTekshir(t, xom);
      togrimi = r.togri;
      const tur = savolTuri(t.guruh.type);
      const togriJavob = tur.korsat(t.savol, t.guruh, undefined).togri.join(', ');
      const togriIdlar = Array.isArray(t.savol.answer) ? t.savol.answer : [String(t.savol.answer)];
      n.querySelectorAll<HTMLInputElement>('input[type=radio], input[type=checkbox]').forEach((x) => {
        const l = x.closest('.variant');
        if (togriIdlar.includes(x.value)) l?.classList.add('togri');
        else if (x.checked) l?.classList.add('xato');
      });
      sarlavha = togrimi ? 'Correct.' : `Wrong. Correct answer: ${togriJavob}`;
      yechim = t.savol.explanation;
      dalil = t.savol.evidence?.quote ?? '';
      $('izoh-yechim').lang = t.test.explanationLang ?? 'en';
    }
    if (d) $('izoh-yechim').removeAttribute('lang');
    if (togrimi) togriSoni++;

    const kun = bugun();
    const yangi = javobdanKeyin(holat.savollar[id], togrimi, kun);
    holat.savollar[id] = yangi;
    const ok2 = holatniYoz(BOLIM, holat);
    saqlashHolati(ok1 && ok2);

    const izoh = $('izoh');
    izoh.classList.toggle('izoh-togri', togrimi);
    $('izoh-sarlavha').textContent = sarlavha;
    $('izoh-xato').textContent = xatoIzoh;
    $('izoh-keyingi').textContent = yangi.quti === 5
      ? 'Mastered: this question will not come back.'
      : togrimi
        ? `Box ${yangi.quti}. Next review: ${sanaMatn(yangi.keyingi)}.`
        : `Back to box 1. Next review: ${sanaMatn(yangi.keyingi)}.`;
    $('izoh-yechim').textContent = yechim;
    $('izoh-dalil').textContent = dalil;
    $('izoh-dalil-qator').hidden = !dalil;
    izoh.hidden = false;
    $<HTMLButtonElement>('tekshir').hidden = true;
    $<HTMLButtonElement>('keyingi').hidden = false;
    // Tekshirish tugmasi yashirindi: fokus yo'qolmasin (WCAG 2.4.3), natija aria-live orqali o'qiladi
    $('keyingi').focus({ preventScroll: true });
  });

  $('keyingi').addEventListener('click', () => {
    if (joriy < navbat.length - 1) { joriy++; korsat(); return; }
    $('karta').hidden = true;
    $('toxtat').hidden = true;
    $('yakun').hidden = false;
    $('s-hisob').textContent = '';
    const g = guruhla(korinadigan(), bugun());
    $('yakun-matn').textContent = `${togriSoni} of ${navbat.length} correct. ${g.bugun.length > 0 ? `${g.bugun.length} more left today.` : "Today's review is done."}`;
    $('yakun-matn').focus();
  });

  const royxatgaQayt = () => {
    $('sessiya').hidden = true;
    $('royxat').hidden = false;
    if (sinxKutilmoqda) { sinxKutilmoqda = false; holat = sinxronla(BOLIM, mavjud(), testXato); }
    royxatniChiz();
    $('royxat-h').focus();
  };
  $('qaytish').addEventListener('click', royxatgaQayt);
  $('toxtat').addEventListener('click', royxatgaQayt);
  $('boshla').addEventListener('click', () => boshla(guruhla(korinadigan(), bugun()).bugun));
  $('oldin').addEventListener('click', () => boshla(guruhla(korinadigan(), bugun()).keyinroq));

  // ---------- O'chirish: sahifa ichidagi tasdiq ----------
  const tozala = $<HTMLButtonElement>('tozala');
  tozala.addEventListener('click', () => { $('tasdiq').hidden = false; tozala.hidden = true; $('tasdiq-yoq').focus(); });
  $('tasdiq-yoq').addEventListener('click', () => { $('tasdiq').hidden = true; tozala.hidden = false; tozala.focus(); });
  $('tasdiq-ha').addEventListener('click', () => {
    try { localStorage.removeItem(takrorKalit(BOLIM)); } catch { /* ruxsat yo'q */ }
    holat = sinxronla(BOLIM, mavjud(), testXato);
    $('tasdiq').hidden = true; tozala.hidden = false;
    if (!$('sessiya').hidden) royxatgaQayt(); else royxatniChiz();
    $('saqlash-holat').textContent = 'Review history deleted. Mistakes start again from box 1.';
    tozala.focus();
  });

  royxatniChiz();
  void testlarniYukla();
</script>

