  .cheklov ul { margin: 0; padding-left: var(--b-5); display: flex; flex-direction: column; gap: var(--b-1); }
  .uzaytir { align-self: flex-start; }
  .uzaytir:disabled, .tolov-tugma:disabled { cursor: progress; opacity: 0.75; }

  /* 1. Joriy tarif */
  .joriy { gap: var(--b-4); }
  .joriy-bosh { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--b-4); flex-wrap: wrap; }
  .joriy-nom-qator { display: flex; align-items: center; gap: var(--b-3); margin-top: var(--b-1); }
  .joriy-nom { font-size: var(--matn-h3); font-weight: 800; }
  .faol-belgi { padding: var(--b-1) var(--b-3); border-radius: var(--r-toliq); border: 1px solid var(--chiziq-kuchli); font-size: var(--matn-mayda); font-weight: 700; color: var(--matn-ikkinchi); }
  .sarf { display: flex; flex-direction: column; gap: var(--b-3); }

  /* 2. Tariflar */
  .tariflar-bosh { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--b-4); flex-wrap: wrap; }
  .tariflar-bosh h2 { margin-top: var(--b-1); }
  .davr { border: 0; margin: 0; padding: 0; }
  .davr-tanlov { display: inline-flex; padding: var(--b-1); gap: var(--b-1); border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); }
  .davr-variant { position: relative; }
  .davr-variant input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .davr-variant input:disabled { cursor: not-allowed; }
  .davr-variant span { display: inline-flex; align-items: center; gap: var(--b-2); min-height: var(--size-touch-min); padding: 0 var(--b-4); border-radius: var(--r-toliq); font-weight: 700; color: var(--matn-ikkinchi); }
  .davr-variant input:checked + span { background: var(--sirt); color: var(--matn); box-shadow: var(--soya); }
  .davr-variant input:focus-visible + span { outline: 3px solid var(--rang-asosiy); outline-offset: 2px; }
  .davr-tez { padding: 2px var(--b-2); border-radius: var(--r-toliq); background: var(--sirt); font-size: var(--matn-mayda); font-weight: 700; color: var(--matn-ikkinchi); }

  .ishonch { list-style: none; margin: 0; padding: var(--b-3) var(--b-4); display: flex; flex-wrap: wrap; gap: var(--b-2) var(--b-5); border-radius: var(--r-orta); background: var(--fon-ikkinchi); font-size: var(--matn-kichik); }
  .ishonch li { display: flex; align-items: flex-start; gap: var(--b-2); }

  .xato { padding: var(--b-3) var(--b-4); border-radius: var(--r-orta); background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn); font-weight: 700; }

  .pullik { display: grid; gap: var(--b-5); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .pullik { grid-template-columns: 1fr 1fr; } }
  .tarif { display: flex; flex-direction: column; gap: var(--b-4); padding: var(--b-6); border: 1.5px solid var(--matn); border-radius: var(--r-katta); background: var(--sirt); }
  /* Qorong'i mavzuda --qora fon bilan bir xil: chegara --matn (oq) bo'lib qoladi va karta ajralib turadi. */
  .tarif.tavsiya { background: var(--qora); color: var(--qora-matn); }
  /* Qora kartadagi asosiy tugma oq (PR #149 dagi .qora-kontekst bilan bir xil qiymatlar). */
  .tarif.tavsiya { --btn-primary-bg: var(--qora-matn); --btn-primary-bg-hover: var(--color-neutral-200); --btn-primary-bg-pressed: var(--color-neutral-200); --btn-primary-text: var(--qora); }
  .tarif:not(.tavsiya) { border-color: var(--chiziq-kuchli); }
  .tarif-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--b-3); flex-wrap: wrap; }
  .tarif h3, .qator-nom { font-size: var(--matn-h3); }
  .belgi { padding: var(--b-1) var(--b-3); border-radius: var(--r-toliq); background: var(--rang-asosiy); color: var(--rang-asosiy-matn); font-size: var(--matn-mayda); font-weight: 700; }
  .narx { font-size: var(--matn-h2); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
