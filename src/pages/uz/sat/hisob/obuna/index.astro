  .kichik-sarlavha { font-size: var(--matn-kichik); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-ikkinchi); }

  /* Bo'lim bloklari: bitta oq sirt, yupqa chegara. */
  .blok { display: flex; flex-direction: column; gap: var(--b-5); padding: var(--b-6); border: 1px solid var(--chiziq); border-radius: var(--r-katta); background: var(--sirt); }
  .blok h2 { font-size: var(--matn-h3); }
  .blok:focus { outline: none; }
  @media (max-width: 640px) { .blok { padding: var(--b-5) var(--b-4); } }

  /* Eslatma: neytral (ogohlantiruvchi rang emas), chap rangli chiziqsiz (DESIGN.md "Taqiqlar"). */
  .eslatma { display: flex; flex-direction: column; gap: var(--b-3); padding: var(--b-5); border: 1.5px solid var(--chiziq-kuchli); border-radius: var(--r-orta); background: var(--sirt); }
  .eslatma-sarlavha { font-size: var(--matn-h3); }
