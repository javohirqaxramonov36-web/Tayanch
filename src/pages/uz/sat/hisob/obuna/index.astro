  .imkoniyat :global(li) { display: flex; align-items: flex-start; gap: var(--b-2); }
  .imkoniyat :global(b) { font-weight: 700; }
  .tavsiya .imkoniyat :global(.tarif-belgi) { color: var(--rang-asosiy-qorada); }
  .joriy-belgi { font-size: var(--matn-kichik); font-weight: 700; color: var(--rang-havola); }
  .tavsiya .joriy-belgi { color: var(--rang-asosiy-qorada); }
  .tolov-tugma { margin-top: auto; width: 100%; justify-content: center; }
  .tavsiya .tolov-tugma:focus-visible { outline-color: var(--rang-asosiy-qorada); }

  .tarif-qator { display: flex; align-items: center; justify-content: space-between; gap: var(--b-4); flex-wrap: wrap; padding: var(--b-4) var(--b-6); border: 1.5px solid var(--chiziq-kuchli); border-radius: var(--r-orta); }

  /* 3. Taqqoslash jadvali: kompyuterda jadval, telefonda har xususiyat alohida blok (gorizontal scroll yo'q). */
  .taqqos { width: 100%; border-collapse: collapse; font-size: var(--matn-kichik); }
