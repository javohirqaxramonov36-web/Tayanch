  .tarix :global(.holat) { display: block; font-weight: 700; }
  .tarix :global(.holat-paid) { color: var(--color-success-text); }
  .tarix :global(.holat-failed) { color: var(--color-error-text); }
  .tarix :global(.tekshir) { margin-top: var(--b-2); min-height: var(--size-touch-min); }
  .tarix :global(.tekshir:disabled) { cursor: progress; opacity: 0.75; }
  @media (max-width: 640px) {
    .tarix thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .tarix, .tarix tbody, .tarix :global(tr), .tarix :global(td) { display: block; }
    .tarix :global(tr) { padding: var(--b-3) 0; border-bottom: 1px solid var(--chiziq); }
    .tarix :global(td) { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: var(--b-3); padding: var(--b-1) 0; border: 0; }
    .tarix :global(td::before) { content: attr(data-nom); color: var(--matn-ikkinchi); font-weight: 700; }
    .tarix :global(td.son) { text-align: left; }
    .tarix :global(td > *) { grid-column: 2; }
  }
</style>
