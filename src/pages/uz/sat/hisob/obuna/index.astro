  .imkoniyat-blok { display: flex; flex-direction: column; gap: var(--b-3); padding-top: var(--b-4); border-top: 1px solid var(--chiziq); }
  .tavsiya .imkoniyat-blok { border-top-color: var(--qora-matn-ikkinchi); }
