---
// SAT · Hisob · Profil (P03). Himoyalangan sahifa: HisobQorovul.
// display_name va nickname (reyting uchun, ixtiyoriy) hozircha Supabase user_metadata'da.
// profiles jadvali (RLS bilan), maqsad ball va imtihon sanasi: P12.
import HisobKarta from '../../../../../components/hisob/HisobKarta.astro';
import HisobQorovul from '../../../../../components/hisob/HisobQorovul.astro';
import Maydon from '../../../../../components/hisob/Maydon.astro';
import { hisobSahifa } from '../../../../../data/satSahifalar';

const sahifa = hisobSahifa('hisob/profil/');
---
<HisobKarta sahifa={sahifa}>
  <HisobQorovul>
    <div class="profil">
      <section class="hisob-karta" aria-labelledby="hisob-malumot">
        <h2 id="hisob-malumot">Account</h2>
        <p>Signed in as <strong id="profil-email"></strong></p>
        <p class="hisob-sust">Your lesson and practice progress is still saved only in this browser. Syncing it to your account will come later.</p>
      </section>

      <section class="hisob-karta" aria-labelledby="profil-sarlavha">
        <h2 id="profil-sarlavha">Your details</h2>
        <form class="hisob-forma" id="profil-forma" novalidate aria-labelledby="profil-sarlavha">
          <p class="hisob-alert" id="profil-xato" role="alert" hidden></p>
          <p class="hisob-holat" id="profil-holat" role="status" hidden></p>
          <Maydon id="profil-ism" nomi="Display name" autocomplete="name" maxlength={60} izoh="How we address you on the site." />
          <Maydon id="profil-taxallus" nomi="Nickname" autocomplete="nickname" maxlength={20} ixtiyoriy izoh="Shown on leaderboards. 3 to 20 letters, numbers or underscores (_)." />
          <button type="submit" class="tugma tugma-asosiy" id="profil-tugma">Save</button>
        </form>
      </section>

      <section class="hisob-karta" aria-labelledby="chiqish-sarlavha">
        <h2 id="chiqish-sarlavha">Sign out</h2>
        <p class="hisob-sust">You will be signed out on this device. Progress saved in this browser stays here.</p>
        <button type="button" class="tugma tugma-ikkinchi" id="chiqish-tugma">Sign out</button>
      </section>
    </div>
  </HisobQorovul>
</HisobKarta>

<style>
  .profil { display: flex; flex-direction: column; gap: var(--b-5); }
  .profil strong { overflow-wrap: anywhere; }
</style>

<script>
  import { hisobMijoz, hisobQorovul, hisobYoli, xatoMatni, maydonXatosi, yuklanish, xabar } from '../../../../../lib/hisob';
  import { hisobSozlama } from '../../../../../data/hisobSozlama';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const ism = $<HTMLInputElement>('profil-ism');
  const taxallus = $<HTMLInputElement>('profil-taxallus');
  const tugma = $<HTMLButtonElement>('profil-tugma');
  const naqsh = new RegExp(`^${hisobSozlama.taxallusNaqsh}$`);

  hisobQorovul().then((sessiya) => {
    if (!sessiya) return;
    const u = sessiya.user;
    $('profil-email').textContent = u.email ?? '';
    ism.value = String(u.user_metadata?.display_name ?? '');
    taxallus.value = String(u.user_metadata?.nickname ?? '');
  });

  $<HTMLFormElement>('profil-forma').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    xabar($('profil-xato'), null);
    xabar($('profil-holat'), null);
    const i = ism.value.trim();
    const t = taxallus.value.trim();
    const iXato = i ? null : 'Enter a display name.';
    const tXato = !t || naqsh.test(t) ? null : 'Use 3 to 20 letters, numbers or underscores (_).';
    maydonXatosi(ism, iXato);
    maydonXatosi(taxallus, tXato);
    if (iXato) return ism.focus();
    if (tXato) return taxallus.focus();
    const c = hisobMijoz();
    if (!c) return;
    yuklanish(tugma, true, 'Saving…');
    const { error } = await c.auth.updateUser({ data: { display_name: i, nickname: t || null } });
    yuklanish(tugma, false);
    if (error) return xabar($('profil-xato'), xatoMatni(error, 'profil'));
    xabar($('profil-holat'), 'Saved.');
  });
  [ism, taxallus].forEach((el) => el.addEventListener('input', () => maydonXatosi(el, null)));

  const chiqish = $<HTMLButtonElement>('chiqish-tugma');
  chiqish.addEventListener('click', async () => {
    const c = hisobMijoz();
    if (!c) return;
    yuklanish(chiqish, true, 'Signing out…');
    // scope 'local': faqat shu qurilmadagi sessiya tugaydi. Server javob bermasa ham (tarmoq yo'q)
    // supabase-js mahalliy sessiyani o'chiradi (sinaldi), shuning uchun natijadan qat'i nazar chiqiladi.
    await c.auth.signOut({ scope: 'local' }).catch(() => undefined);
    try { localStorage.removeItem(hisobSozlama.sessiyaKaliti); } catch { /* xotira yopiq bo'lsa ham davom */ }
    location.assign(`${hisobYoli('kirish')}?chiqdi=1`);
  });
</script>
