---
// SAT bo'limining "tez orada" sahifalari. Ro'yxat: src/data/satSahifalar.ts. Matn inglizcha (CLAUDE.md).
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import { satSahifalar, satGuruhlar, turiNomi, type SatSahifa } from '../../../data/satSahifalar';
import { yol } from '../../../lib/yol';

export function getStaticPaths() {
  return satSahifalar.filter((s) => !s.tayyor).map((s) => ({
    params: { qism: s.qism.replace(/\/$/, '') },
    props: { sahifa: s },
  }));
}

interface Props { sahifa: SatSahifa }
const { sahifa } = Astro.props;
const guruh = satGuruhlar.find((g) => g.sahifalar.includes(sahifa))?.nomi ?? '';
const TEKSHIRILGAN = '2026-11-04';
const KEYINGI = '2026-12-04';
---
<BolimQobiq
  sahifaSinfi="sat t-fon"
  title={`${sahifa.nomi} · SAT`}
  description={sahifa.tavsif}
  turi={sahifa.turi}
  yol={[guruh]}
  bolim="sat"
  holat="qoralama"
  tekshirilgan={TEKSHIRILGAN}
  keyingiTekshiruv={KEYINGI}
  manbalar={sahifa.manbalar}
  tekshirilmagan={sahifa.tekshirilmagan}
>
  <section class="ichki sahifa" aria-labelledby="sarlavha">
    <div class="bosh">
      <p class="pill-qator">
        <span class="pill">{turiNomi[sahifa.turi]}</span>
      </p>
      <h1 id="sarlavha">{sahifa.nomi}</h1>
      <p class="tavsif">{sahifa.tavsif}</p>
    </div>

    <div class="tez-orada" role="note">
      <span class="tez-belgi" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
      <div>
        <p class="tez-sarlavha">Coming soon</p>
        <p class="tez-matn">This page is not ready yet. For now there is only a plan.</p>
      </div>
    </div>

    <dl class="maydonlar">
      <div><dt>Language</dt><dd>English</dd></div>
      <div><dt>Page type</dt><dd>{turiNomi[sahifa.turi]}</dd></div>
      <div><dt>Section</dt><dd>SAT</dd></div>
      <div><dt>Status</dt><dd>Coming soon</dd></div>
    </dl>

    <p><a class="qaytish" href={yol('/uz/sat/')}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
      Back to the SAT section</a></p>
  </section>
</BolimQobiq>

<style>
  /* Dizayn: Tayanch-SAT-dizayn.md (Natijalar va Savol banki sarlavhasi) */
  .sahifa { padding-block: var(--space-14) 0; display: flex; flex-direction: column; gap: var(--space-8); }
  .bosh { display: flex; flex-direction: column; gap: var(--space-4); }
  .pill-qator { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .pill { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); background: var(--color-sat-line); color: var(--color-sat-text); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); }
  .pill-chiziq { background: transparent; border: 1.5px dashed var(--color-sat-text-muted); color: var(--color-sat-text-muted); padding: var(--space-1) var(--space-3); }
  .sahifa h1 { font-size: var(--text-display-size); line-height: 1.1; font-weight: var(--font-weight-extrabold); letter-spacing: var(--oraliq-sarlavha); }
  .tavsif { font-size: var(--text-h3-size); line-height: 1.6; color: var(--color-sat-text-muted); max-width: 60ch; }
  .tez-orada {
    border: 1.5px solid var(--color-sat-text);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex; align-items: flex-start; gap: var(--space-4);
  }
  .tez-belgi {
    flex: none; width: 40px; height: 40px; border-radius: var(--radius-md);
    background: var(--color-sat-blue-fill); color: var(--color-sat-on-blue-fill);
    display: flex; align-items: center; justify-content: center;
  }
  .tez-sarlavha { font-weight: var(--font-weight-extrabold); font-size: var(--text-h3-size); }
  .tez-matn { color: var(--color-sat-text-muted); }
  .maydonlar {
    margin: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
  }
  .maydonlar div { background: var(--color-sat-sunken); border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); }
  .maydonlar dt { font-size: var(--text-small-size); color: var(--color-sat-text-muted); }
  .maydonlar dd { margin: 0; font-weight: var(--font-weight-bold); }
  .qaytish {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 52px; padding: 0 var(--space-6) 0 var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-sat-line); color: var(--color-sat-text);
    text-decoration: none; font-weight: var(--font-weight-bold);
  }
  @media (hover: hover) and (pointer: fine) { .qaytish:hover { background: var(--color-sat-line); } }
  @media (max-width: 640px) {
    .sahifa { padding-top: var(--space-7); gap: var(--space-6); }
    .sahifa h1 { font-size: var(--text-h1-size); }
    .tavsif { font-size: var(--text-body-size); }
  }
</style>
