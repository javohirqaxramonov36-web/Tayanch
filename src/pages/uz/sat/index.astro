---
// SAT bo'limi kirishi (T1, 2-tur).
// Dizayn: Tayanch-SAT-dizayn.md, "Main" (kompyuter) va "Telefon" ekranlari.
// Matnlar dizayndan, inglizcha (SAT bo'limi qoidasi, CLAUDE.md). Imtihon tuzilmasi raqamlari: CB03 (College Board, rasmiy).
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import { satGuruhlar } from '../../../data/satSahifalar';
import { manbalar } from '../../../data/manbalar';
const cb03 = manbalar.find((m) => m.id === 'CB03')!;
import { yol } from '../../../lib/yol';
import Zina from '../../../components/Zina.astro';
import KunSavoli from '../../../components/sat/KunSavoli.astro';
import SatMaqsadSarlavha from '../../../components/sat/SatMaqsadSarlavha.astro';

const sat = (qism: string) => yol(`/uz/sat/${qism}`);

// "Where the SAT counts": har qator faqat rasmiy manbadan (manbalar.ts, 2026-11-09). Holat matn bilan, rang yagona belgi emas.
type SatHolat = 'Required' | 'Optional' | 'Accepted';
const qayerda: { manba: string; nomi: string; davlat: string; holat: SatHolat; matn: string }[] = [
  { manba: 'HV01', nomi: 'Harvard College', davlat: 'USA', holat: 'Required', matn: 'The SAT or ACT is required, for international applicants too. Only if neither test is accessible does Harvard accept other results, such as A-Levels, IB or a national exam.' },
  { manba: 'NY01', nomi: 'NYU Abu Dhabi', davlat: 'UAE', holat: 'Optional', matn: 'Test-optional through the 2027–2028 application cycle. Scores you choose to send are still reviewed.' },
  { manba: 'MT01', nomi: 'METU', davlat: 'Türkiye', holat: 'Accepted', matn: 'The SAT is one of the exams you can apply with, alongside TR-YÖS and others. Scores are valid for two years.' },
  { manba: 'KY01', nomi: 'Kyoto University iUP', davlat: 'Japan', holat: 'Accepted', matn: 'At least one standardized test is mandatory, and the SAT is on the list. For October 2027 entry, only tests taken by November 7, 2026 count. Engineering also needs physics and chemistry results, which the SAT does not cover.' },
];
const qayerdaQatorlar = qayerda.map((q) => ({ ...q, m: manbalar.find((m) => m.id === q.manba && m.tekshiruvDarajasi === 'rasmiy')! }));
if (qayerdaQatorlar.some((q) => !q.m)) throw new Error('SAT kirish: "Where the SAT counts" manbasi topilmadi yoki rasmiy emas');
const qadamlar = [
  { yorliq: 'UNDERSTAND', nomi: 'Strategy', tavsif: 'Where to start your prep and how to plan it.', havola: 'Open the guide', qism: 'qollanma/strategiya/' },
  { yorliq: 'PRACTICE', nomi: 'Tests and question bank', tavsif: 'Short tests by topic, with an explanation right after each answer.', havola: 'Start practicing', qism: 'mashq/test/' },
  { yorliq: 'ANALYZE', nomi: 'My results', tavsif: 'A list of your mistakes, saved only in this browser. No score is calculated.', havola: 'See your results', qism: 'vosita/natijalar/' },
];
---
<BolimQobiq
  title="SAT"
  description="Digital SAT prep: English (Reading & Writing) and Math. An independent plan, without expensive courses."
  turi="bolim-kirishi"
  bolim="sat"
  holat="qoralama"
  tekshirilgan="2026-11-04"
  keyingiTekshiruv="2026-12-04"
  manbalar={['CB03', 'HV01', 'NY01', 'MT01', 'KY01']}
>
  <div class="ichki sat-kirish">
    <SatMaqsadSarlavha />
    <section class="hero" aria-labelledby="sat-h">
      <div class="hero-matn">
        <p class="pill-qator"><span class="pill">Draft</span><span class="pill-izoh">Section home</span></p>
        <h1 id="sat-h">Digital SAT®,<br /><span class="kok">without expensive courses.</span></h1>
        <p class="lead">English (Reading &amp; Writing) and Math, with equal attention. The plan is based on the independent prep that led the author to an SAT score of 1420: Desmos and formulas, time management, mistake analysis.</p>
        <p class="lead lead-telefon">English and Math, with equal attention. A plan based on the author's independent prep.</p>
        <div class="cta">
          <a class="katta-tugma asosiy" href={sat('mashq/test/')}>
            Start a practice test
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </a>
          <a class="katta-tugma ikkinchi" href={sat('qollanma/strategiya/')}>Read the strategy</a>
        </div>
      </div>

      <div class="tuzilma" aria-labelledby="tuzilma-h">
        <h2 id="tuzilma-h" class="ustki-yorliq">Test structure</h2>
        <ul>
          <li>
            <span class="tuzilma-belgi" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z" /></svg></span>
            <span><strong>Reading &amp; Writing</strong><span class="tuzilma-izoh">2 modules, 32 minutes each · 54 questions</span></span>
          </li>
          <li>
            <span class="tuzilma-belgi" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg></span>
            <span><strong>Math</strong><span class="tuzilma-izoh">2 modules, 35 minutes each · 44 questions</span></span>
          </li>
        </ul>
        <p class="tuzilma-izoh">Source: <a href={cb03.havola} rel="noopener">{cb03.tashkilot}</a>, checked {cb03.tekshirilganSana}.</p>
      </div>
    </section>

    <KunSavoli />

    <section class="yol" aria-labelledby="yol-h">
      <div class="bosh-qator">
        <h2 id="yol-h">Where will you start?</h2>
        <p class="sust kichik">Three steps, in any order</p>
      </div>
      <ol class="qadamlar">
        {qadamlar.map((q, i) => (
          <li>
            <a href={sat(q.qism)} class="qadam">
              <span class="qadam-yorliq"><span class="qadam-raqam">{i + 1}</span><span class="qadam-soz"> · {q.yorliq}</span></span>
              <span class="qadam-matn">
                <span class="qadam-nom">{q.nomi}</span>
                <span class="qadam-tavsif">{q.tavsif}</span>
              </span>
              <span class="qadam-havola">{q.havola}</span>
              <svg class="qadam-strelka" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="qayerda" aria-labelledby="qayerda-h">
      <div class="bosh-qator">
        <h2 id="qayerda-h">Where the SAT counts</h2>
        <p class="sust kichik">Four examples. Each university sets its own rules.</p>
      </div>
      <ul class="qayerda-royxat">
        {qayerdaQatorlar.map((q) => (
          <li class="qayerda-karta">
            <div class="qayerda-bosh">
              <span class="qayerda-nom"><strong>{q.nomi}</strong><span class="qayerda-davlat">{q.davlat}</span></span>
              <span class:list={['holat', `holat-${q.holat.toLowerCase()}`]}>
                {q.holat === 'Required' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v8" /><path d="M12 18v.5" /></svg>}
                {q.holat === 'Accepted' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>}
                {q.holat === 'Optional' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h12" /></svg>}
                {q.holat}
              </span>
            </div>
            <p class="qayerda-matn">{q.matn}</p>
            <p class="qayerda-manba"><a href={q.m.havola} rel="noopener" aria-label={`Official page: ${q.nomi}`}>Official page</a> · checked {q.m.tekshirilganSana}</p>
          </li>
        ))}
      </ul>
      <p class="qayerda-izoh">Rules change every cycle. Check the official page before you apply.</p>
    </section>

    <section class="sahifalar" aria-labelledby="sahifa-h">
      <h2 id="sahifa-h">All pages in this section</h2>
      <div class="guruhlar">
        {satGuruhlar.filter((g) => g.nomi !== 'Practice').map((g, i) => (
          <div class="guruh">
            <h3 id={`kirish-guruh-${i}`} class="ustki-yorliq">{g.nomi}</h3>
            <ul aria-labelledby={`kirish-guruh-${i}`}>
              {g.sahifalar.map((s) => (
                <li>
                  <a href={sat(s.qism)}>
                    <span class="s-nom">{s.nomi}</span>
                    {!s.tayyor && <span class="pill pill-kichik">coming soon</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <Zina />

    <section class="pastki" aria-label="Contact and note">
      <p class="telegram">Telegram channel <span class="pill pill-kichik">coming soon</span></p>
      <p class="eslatma">Results are not guaranteed.</p>
    </section>
  </div>
</BolimQobiq>

<style>
  .sat-kirish { padding-block: var(--b-14) 0; display: flex; flex-direction: column; gap: var(--b-14); }
  .kok { color: var(--rang-havola); }

  .pill-qator { display: flex; align-items: center; gap: var(--b-3); }
  .pill { padding: 4px 12px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); color: var(--matn); font-size: var(--matn-mayda); font-weight: 700; }
  .pill-kichik { padding: 3px 10px; font-size: 12px; color: var(--matn-ikkinchi); white-space: nowrap; }
  .pill-izoh { font-size: var(--matn-kichik); font-weight: 500; color: var(--matn-sust); }
  .ustki-yorliq { margin: 0; font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-sust); line-height: 1.4; }

  /* Hero */
  .hero { display: flex; flex-wrap: wrap; gap: var(--b-8); align-items: stretch; }
  .hero-matn { flex: 3 1 420px; min-width: 0; display: flex; flex-direction: column; gap: var(--b-5); }
  .hero h1 { font-size: 56px; line-height: 1.05; font-weight: 900; letter-spacing: var(--oraliq-hero); }
  .lead { font-size: 19px; line-height: 1.6; color: var(--matn-ikkinchi); max-width: 58ch; }
  .lead-telefon { display: none; }
  .tuzilma a { color: var(--qora-matn-ikkinchi); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--b-3); padding-top: var(--b-1); }
  .katta-tugma {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 52px; padding: 0 26px;
    border-radius: var(--r-toliq);
    text-decoration: none; font-weight: 800; font-size: 16px;
  }
  .katta-tugma.asosiy { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  .katta-tugma.asosiy:hover { background: var(--rang-asosiy-toq); }
  .katta-tugma.ikkinchi { background: var(--sirt-ikkinchi); color: var(--matn); font-weight: 700; }
  .katta-tugma.ikkinchi:hover { background: var(--chiziq); }

  /* Qora karta: imtihon tuzilmasi (har ikki mavzuda qora) */
  .tuzilma {
    flex: 2 1 280px; min-width: 0;
    background: var(--qora); color: var(--rang-asosiy-matn);
    border: 1px solid var(--qora-chiziq);
    border-radius: var(--r-katta);
    padding: 28px;
    display: flex; flex-direction: column; gap: var(--b-5);
  }
  .tuzilma .ustki-yorliq { color: var(--rang-asosiy-qorada); }
  .tuzilma ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--b-3); }
  .tuzilma li {
    background: var(--qora-sirt); border: 1px solid var(--qora-chiziq);
    border-radius: var(--r-orta); padding: 16px 18px;
    display: flex; align-items: center; gap: 14px;
  }
  .tuzilma li > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .tuzilma strong { font-weight: 800; font-size: 17px; }
  .tuzilma-belgi {
    flex: none; width: 40px; height: 40px; border-radius: var(--r-yon);
    background: var(--rang-asosiy); color: var(--rang-asosiy-matn);
    display: flex; align-items: center; justify-content: center;
  }
  .tuzilma-izoh { font-size: var(--matn-kichik); line-height: 1.5; color: var(--qora-matn-ikkinchi); }
  p.tuzilma-izoh { font-size: var(--matn-mayda); margin-top: auto; }

  /* Qadamlar */
  .yol, .sahifalar { display: flex; flex-direction: column; gap: var(--b-5); }
  .bosh-qator { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--b-3); }
  .yol h2, .sahifalar h2, .qayerda h2 { font-size: 32px; font-weight: 800; line-height: 1.2; }
  .qadamlar { list-style: none; margin: 0; padding: 0; border: 1.5px solid var(--matn); border-radius: var(--r-katta); overflow: hidden; }
  .qadamlar li + li { border-top: 1px solid var(--chiziq); }
  .qadam {
    display: grid; grid-template-columns: 140px minmax(0, 1fr) auto;
    align-items: center; column-gap: var(--b-6); row-gap: var(--b-1);
    padding: 22px 28px;
    text-decoration: none; color: var(--matn);
  }
  .qadam:hover { background: var(--fon-ikkinchi); }
  .qadam-yorliq { font-size: var(--matn-mayda); font-weight: 700; color: var(--rang-havola); }
  .qadam-matn { display: flex; flex-direction: column; gap: var(--b-1); }
  .qadam-nom { font-size: 20px; font-weight: 800; }
  .qadam-tavsif { font-size: 15px; line-height: 1.55; color: var(--matn-ikkinchi); }
  .qadam-havola { font-weight: 700; font-size: 15px; white-space: nowrap; color: var(--rang-havola); text-decoration: underline; text-underline-offset: 0.15em; }
  .qadam:hover .qadam-havola { color: var(--rang-asosiy-toq); }
  .qadam-strelka { display: none; color: var(--matn-sust); }


  /* SAT qayerda kerak */
  .qayerda { display: flex; flex-direction: column; gap: var(--b-5); }
  .qayerda-royxat { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: var(--b-4); }
  .qayerda-karta {
    background: var(--sirt); border: 1px solid var(--chiziq); border-radius: var(--r-katta);
    padding: var(--b-5); display: flex; flex-direction: column; gap: var(--b-3); min-width: 0;
  }
  .qayerda-bosh { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: var(--b-2); }
  .qayerda-nom { display: flex; flex-direction: column; gap: var(--b-1); min-width: 0; }
  .qayerda-nom strong { font-size: var(--matn-katta); font-weight: 800; }
  .qayerda-davlat { font-size: var(--matn-kichik); color: var(--matn-sust); }
  .holat {
    display: inline-flex; align-items: center; gap: var(--b-1);
    padding: var(--b-1) var(--b-3); border-radius: var(--r-toliq);
    font-size: var(--matn-mayda); font-weight: 800; white-space: nowrap;
  }
  .holat-required { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  .holat-accepted { background: var(--sirt); color: var(--matn); border: 1.5px solid var(--matn); }
  .holat-optional { background: var(--sirt-ikkinchi); color: var(--matn); }
  .qayerda-matn { font-size: var(--matn-asosiy); line-height: 1.55; color: var(--matn-ikkinchi); }
  .qayerda-manba { margin-top: auto; font-size: var(--matn-mayda); color: var(--matn-sust); }
  .qayerda-manba a { color: var(--rang-havola); font-weight: 700; display: inline-flex; align-items: center; min-height: 44px; }
  .qayerda-izoh { font-size: var(--matn-kichik); color: var(--matn-sust); }

  /* Barcha sahifalar */
  .guruhlar { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--b-4); align-items: start; }
  .guruh { background: var(--fon-ikkinchi); border-radius: var(--r-katta); padding: var(--b-2); }
  .guruh h3 { margin: var(--b-3) var(--b-4) var(--b-2); }
  .guruh ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--b-1); }
  .guruh a {
    background: var(--fon); border-radius: var(--r-orta);
    padding: 14px 16px; min-height: 52px;
    display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
    text-decoration: none; color: var(--matn);
  }
  .guruh a:hover .s-nom { color: var(--rang-havola); text-decoration: underline; }
  .s-nom { font-weight: 700; }

  /* Pastki qator */
  .pastki {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--b-4);
    border-top: 1px solid var(--chiziq); padding-top: var(--b-8);
  }
  .telegram { display: flex; align-items: center; gap: 10px; font-weight: 700; }
  .eslatma { font-size: var(--matn-kichik); color: var(--matn-sust); max-width: 60ch; }

  /* Telefon ekrani */
  @media (max-width: 640px) {
    .sat-kirish { padding-top: 28px; gap: var(--b-10); }
    .hero h1 { font-size: 38px; line-height: 1.08; letter-spacing: var(--oraliq-hero); }
    .lead { display: none; }
    .lead-telefon { display: block; font-size: 17px; }
    .sahifalar, .pastki { display: none; }
    .hero { display: contents; }
    .hero-matn { order: 1; flex: none; }
    .yol { order: 2; }
    .tuzilma { order: 3; flex: none; }
    .qayerda { order: 4; }
    .qayerda .bosh-qator p { display: block; }
    .qayerda-karta { border-radius: var(--r-orta); padding: var(--b-4); }
    .katta-tugma { width: 100%; }
    .yol h2, .sahifalar h2, .qayerda h2 { font-size: 22px; }
    .bosh-qator p { display: none; }
    .qadamlar { border-color: var(--chiziq); border-radius: 20px; }
    .qadam {
      grid-template-columns: 16px minmax(0, 1fr) auto;
      column-gap: 14px; min-height: 64px; padding: 12px 16px;
    }
    .qadam-yorliq { font-weight: 800; }
    .qadam-soz, .qadam-tavsif, .qadam-havola { display: none; }
    .qadam-nom { font-size: 16px; font-weight: 700; }
    .qadam-strelka { display: block; }
    .tuzilma { border-radius: 20px; padding: 18px; }
  }
</style>
