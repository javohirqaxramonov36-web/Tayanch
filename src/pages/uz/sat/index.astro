---
import { kursHavola, kursOchiq } from '../../../lib/sat/kursKatalog';
// SAT bo'limi kirishi (T1, 2-tur).
// Dizayn: Tayanch-SAT-dizayn.md, "Main" (kompyuter) va "Telefon" ekranlari.
// Matnlar dizayndan, inglizcha (SAT bo'limi qoidasi, CLAUDE.md). Imtihon tuzilmasi raqamlari: CB03 (College Board, rasmiy).
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import { satGuruhlar } from '../../../data/satSahifalar';
import { manbalar } from '../../../data/manbalar';
const cb03 = manbalar.find((m) => m.id === 'CB03')!;
import { yol } from '../../../lib/yol';
import QavatFoto from '../../../components/QavatFoto.astro';
import KunSavoli from '../../../components/sat/KunSavoli.astro';
import SatMaqsadSarlavha from '../../../components/sat/SatMaqsadSarlavha.astro';
import SatBugun from '../../../components/sat/SatBugun.astro';
import SatKirganBelgi from '../../../components/sat/SatKirganBelgi.astro';
import SatPlitka, { type SatPlitkaIkonka } from '../../../components/sat/SatPlitka.astro';
import '../../../styles/sat.css';

const sat = (qism: string) => yol(`/uz/sat/${qism}`);
// Navy sahnadagi plitkalar (DS 3-qavat, SatPlitka): nom va manzil satSahifalar.ts dan, faqat tayyor sahifalar.
const plitkaQismlar: [string, SatPlitkaIkonka][] = [
  ['mashq/test/', 'test'], ['mashq/mock/', 'mock'], ['mashq/bank/', 'bank'],
  ['mashq/lugat/', 'lugat'], ['vosita/reja/', 'reja'], ['vosita/natijalar/', 'natija'],
];
const plitkalar = plitkaQismlar.map(([qism, ikonka]) => {
  const s = satGuruhlar.flatMap((g) => g.sahifalar).find((x) => x.qism === qism && x.tayyor);
  if (!s) throw new Error(`SAT kirish: plitka sahifasi topilmadi yoki tayyor emas: ${qism}`);
  return { href: sat(qism), nomi: s.nomi, ikonka };
});
const kutilmoqda = satGuruhlar.flatMap((g) => g.sahifalar.filter((s) => !s.tayyor));

// Imtihon tuzilmasi (CB03). Vaqt chizig'i shu raqamlardan: bo'lak uzunligi daqiqaga mutanosib, ikkala bo'lim bir shkalada.
const tuzilma = [
  { nomi: 'Reading & Writing', belgi: 'kitob', modul: 2, daqiqa: 32, savol: 54 },
  { nomi: 'Math', belgi: 'plyus', modul: 2, daqiqa: 35, savol: 44 },
] as const;
const engUzunVaqt = Math.max(...tuzilma.map((t) => t.modul * t.daqiqa));

// "Where the SAT counts": har qator faqat rasmiy manbadan (manbalar.ts, 2026-11-09). Holat matn bilan, rang yagona belgi emas.
type SatHolat = 'Required' | 'Optional' | 'Accepted';
const qayerda: { manba: string; nomi: string; davlat: string; holat: SatHolat; matn: string }[] = [
  { manba: 'HV01', nomi: 'Harvard College', davlat: 'USA', holat: 'Required', matn: 'The SAT or ACT is required, for international applicants too. Only if neither test is accessible does Harvard accept other results, such as A-Levels, IB or a national exam.' },
  { manba: 'NY01', nomi: 'NYU Abu Dhabi', davlat: 'UAE', holat: 'Optional', matn: 'Test-optional through the 2027–2028 application cycle. Scores you choose to send are still reviewed.' },
  { manba: 'MT01', nomi: 'METU', davlat: 'Türkiye', holat: 'Accepted', matn: 'The SAT is one of the exams you can apply with, alongside TR-YÖS and others. Scores are valid for two years.' },
  { manba: 'KY01', nomi: 'Kyoto University iUP', davlat: 'Japan', holat: 'Accepted', matn: 'At least one standardized test is mandatory, and the SAT is on the list. For October 2027 entry, only tests taken by November 7, 2026 count. Engineering also needs physics and chemistry results, which the SAT does not cover.' },
];
const qayerdaQatorlar = qayerda.map((q) => ({ ...q, m: manbalar.find((m) => m.id === q.manba && m.tekshiruvDarajasi === 'rasmiy')! }));
if (qayerdaQatorlar.some((q) => !q.m)) throw new Error('SAT kirish: "Where the SAT counts" manbasi topilmadi yoki rasmiy emas');
type QadamBelgi = 'kompas' | 'qalam' | 'grafik';
const qadamlar: { yorliq: string; nomi: string; tavsif: string; havola: string; qism: string; belgi: QadamBelgi }[] = [
  { yorliq: 'UNDERSTAND', nomi: 'Where to start', tavsif: 'How the test works and how to plan your prep.', havola: 'Open the guide', qism: 'qollanma/qayerdan-boshlash/', belgi: 'kompas' },
  { yorliq: 'PRACTICE', nomi: 'Sample practice', tavsif: 'Try sample questions with explanations. No account needed.', havola: 'Start practicing', qism: 'mashq/test/', belgi: 'qalam' },
  { yorliq: 'ANALYZE', nomi: 'My results', tavsif: 'Accuracy by skill and the topics to work on next. Needs a free account.', havola: 'See your results', qism: 'vosita/natijalar/', belgi: 'grafik' },
];
---
<BolimQobiq
  title="SAT"
  description="Digital SAT prep: English (Reading & Writing) and Math. An independent plan, without expensive courses."
  turi="bolim-kirishi"
  bolim="sat"
  holat="chop-etilgan"
  tekshirilgan="2026-11-04"
  keyingiTekshiruv="2026-12-04"
  manbalar={['CB03', 'HV01', 'NY01', 'MT01', 'KY01']}
>
  <div class="ichki sat-kirish">
    <SatKirganBelgi />
    <SatMaqsadSarlavha />
    <QavatFoto bolim="sat" />
    <section class="hero sat-sahna t-fon" aria-labelledby="sat-h">
      <div class="hero-ustki">
        <div class="hero-matn">
          <h1 id="sat-h" class="sat-sarlavha">Digital SAT®,<br /><span class="kok">without expensive courses.</span></h1>
          <p class="lead">English (Reading &amp; Writing) and Math, with equal attention. The plan is based on the independent prep that led the author to an SAT score of 1420: Desmos and formulas, time management, mistake analysis.</p>
          <p class="lead lead-telefon">English and Math, with equal attention. A plan based on the author's independent prep.</p>
          <div class="cta">
            <a class="t-tugma sat-tugma--kok" href={sat('mashq/test/')}>
              Try sample questions
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
            </a>
            <a class="t-tugma t-tugma--ikkinchi" href={sat('qollanma/qayerdan-boshlash/')}>Where to start</a>
          </div>
        </div>

        <div class="tuzilma t-shisha t-shisha--zich" aria-labelledby="tuzilma-h">
          <h2 id="tuzilma-h" class="sat-yorliq">Test structure</h2>
          <ul>
            {tuzilma.map((t) => (
              <li>
                <span class="tuzilma-belgi" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    {t.belgi === 'kitob' ? <path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z" /> : <><path d="M5 12h14" /><path d="M12 5v14" /></>}
                  </svg>
                </span>
                <span class="tuzilma-matn">
                  <strong>{t.nomi}</strong>
                  <span class="tuzilma-izoh">{t.modul} modules, {t.daqiqa} minutes each · {t.savol} questions</span>
                  <span class="modul-chiziq" aria-hidden="true" style={`--ulush: ${(t.modul * t.daqiqa) / engUzunVaqt}`}>
                    {Array.from({ length: t.modul }, (_, i) => (
                      <span class="modul" style={`--tartib: ${i}`}><span class="modul-nom">Module {i + 1}</span></span>
                    ))}
                  </span>
                </span>
              </li>
            ))}
          </ul>
          <p class="tuzilma-izoh">Source: <a href={cb03.havola} rel="noopener">{cb03.tashkilot}</a>, checked {cb03.tekshirilganSana}.</p>
        </div>
        <script is:inline>
          // Vaqt chizig'i karta ekranga kirganda bir marta to'ladi. JS yo'q yoki reduced motion: darhol to'liq.
          (() => {
            const karta = document.currentScript && document.currentScript.previousElementSibling;
            if (!karta || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            karta.setAttribute('data-kutish', '');
            const k = new IntersectionObserver((yozuvlar) => {
              if (!yozuvlar.some((y) => y.isIntersecting)) return;
              karta.removeAttribute('data-kutish');
              k.disconnect();
            }, { threshold: 0.4 });
            k.observe(karta);
          })();
        </script>
      </div>
      <div class="hero-plitka">
        <h2 id="plitka-h" class="sat-yorliq">Practice and tools</h2>
        <SatPlitka bandlar={plitkalar} sarlavhaId="plitka-h" />
      </div>
    </section>

    <SatBugun />

    <KunSavoli />

    <section class="yol" aria-labelledby="yol-h">
      <div class="bosh-qator">
        <h2 id="yol-h">Where will you start?</h2>
        <p class="sust kichik">Three steps, in any order</p>
      </div>
      <ol class="qadamlar">
        {qadamlar.map((q, i) => (
          <li>
            <a href={sat(q.qism)} class="qadam">
              <span class="qadam-belgi" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {q.belgi === 'kompas' && <><circle cx="12" cy="12" r="9" /><path d="M15.5 8.5l-2 5-5 2 2-5z" /></>}
                  {q.belgi === 'qalam' && <><path d="M12 20h8" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></>}
                  {q.belgi === 'grafik' && <><path d="M3 20h18" /><path d="M7 16v-4" /><path d="M12 16V7" /><path d="M17 16v-6" /></>}
                </svg>
              </span>
              <span class="qadam-matn">
                <span class="qadam-yorliq"><span class="qadam-raqam">{i + 1}</span><span class="qadam-soz"> · {q.yorliq}</span></span>
                <span class="qadam-nom">{q.nomi}</span>
                <span class="qadam-tavsif">{q.tavsif}</span>
              </span>
              <span class="qadam-havola">{q.havola}</span>
              <svg class="qadam-strelka" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {kutilmoqda.length > 0 && (
      <details>
        <summary>Coming soon ({kutilmoqda.length} {kutilmoqda.length === 1 ? "page" : "pages"})</summary>
        <ul>{kutilmoqda.map((s) => <li>{s.nomi}</li>)}</ul>
      </details>
    )}

    <section class="qayerda" aria-labelledby="qayerda-h">
      <div class="bosh-qator">
        <h2 id="qayerda-h">Where the SAT counts</h2>
        <p class="sust kichik">Four examples. Each university sets its own rules.</p>
      </div>
      <ul class="qayerda-royxat">
        {qayerdaQatorlar.map((q, i) => (
          <li class="qayerda-karta">
            <div class="qayerda-bosh">
              <span class="qayerda-nom"><strong>{q.nomi}</strong><span class="qayerda-davlat">{q.davlat}</span></span>
              <span class:list={['holat', `holat-${q.holat.toLowerCase()}`]}>
                {q.holat === 'Required' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v8" /><path d="M12 18v.5" /></svg>}
                {q.holat === 'Accepted' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>}
                {q.holat === 'Optional' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h12" /></svg>}
                {q.holat}
              </span>
              <button type="button" class="qayerda-ochish" aria-expanded="true" aria-controls={`qayerda-tana-${i}`} aria-label={`Details: ${q.nomi}`}>
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
              </button>
            </div>
            <div class="qayerda-tana" id={`qayerda-tana-${i}`}>
              <p class="qayerda-matn">{q.matn}</p>
              <p class="qayerda-manba"><a href={q.m.havola} rel="noopener" aria-label={`Official page: ${q.nomi}`}>Official page</a> · checked {q.m.tekshirilganSana}</p>
            </div>
          </li>
        ))}
      </ul>
      <script is:inline>
        // Telefonda (<= 640px) kartalar yopiq boshlanadi, tugma ochadi/yopadi. Kengroq ekranda tugma yo'q, hammasi ochiq (CSS).
        // JS yo'q: hamma karta ochiq, tugma ko'rinmaydi. Holat saqlanmaydi.
        (() => {
          const royxat = document.currentScript && document.currentScript.previousElementSibling;
          if (!royxat) return;
          royxat.querySelectorAll('.qayerda-ochish').forEach((t) => {
            t.setAttribute('aria-expanded', 'false');
            t.addEventListener('click', () => {
              const ochiq = t.getAttribute('aria-expanded') !== 'true';
              t.setAttribute('aria-expanded', String(ochiq));
              t.closest('.qayerda-karta').toggleAttribute('data-ochiq', ochiq);
            });
          });
          royxat.setAttribute('data-yigma', '');
        })();
      </script>
      <p class="qayerda-izoh">Rules change every cycle. Check the official page before you apply.</p>
    </section>

    {kursOchiq && <p><a href={kursHavola()}>Explore the Math course</a></p>}
    <section class="sahifalar" aria-labelledby="sahifa-h">
      <h2 id="sahifa-h">All pages in this section</h2>
      <div class="guruhlar">
        {satGuruhlar.filter((g) => g.nomi !== 'Practice').map((g, i) => (
          <div class="guruh">
            <h3 id={`kirish-guruh-${i}`} class="sat-yorliq">{g.nomi}</h3>
            <ul aria-labelledby={`kirish-guruh-${i}`}>
              {g.sahifalar.filter((s) => s.tayyor).map((s) => (
                <li>
                  <a href={sat(s.qism)}>
                    <span class="s-nom">{s.nomi}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>


    <section class="pastki" aria-label="Contact and note">
      <p class="telegram">Telegram channel <span class="pill pill-kichik">coming soon</span></p>
      <p class="eslatma">Results are not guaranteed.</p>
    </section>
  </div>
</BolimQobiq>

<style>
  .sat-kirish { padding-block: var(--b-14) 0; display: flex; flex-direction: column; gap: var(--b-14); color: var(--color-sat-text); }

  .pill { padding: 4px 12px; border-radius: var(--r-toliq); background: var(--color-sat-bg); color: var(--color-sat-text); font-size: var(--matn-mayda); font-weight: 700; }
  .pill-kichik { padding: 3px 10px; font-size: 12px; color: var(--color-sat-text-muted); white-space: nowrap; }
  .sat-yorliq { color: var(--color-sat-text-muted); }

  /* Hero: navy sahna (sat.css .sat-sahna + poydevor .t-fon). Sahnada matn faqat sat-on-navy;
     muted faqat zich shishada (tuzilma). Ko'k kapsula sahifada bitta: "Try sample questions". */
  .hero { display: flex; flex-direction: column; gap: var(--space-8); }
  .hero-ustki { display: flex; flex-wrap: wrap; gap: var(--space-8); align-items: stretch; }
  .hero-matn { flex: 3 1 420px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-5); }
  .hero h1 { font-size: var(--text-sat-hero-size); line-height: var(--text-sat-hero-lh); letter-spacing: var(--text-sat-hero-ls); }
  .kok { color: var(--color-sat-sky); }
  .lead { font-size: 19px; line-height: 1.6; color: var(--color-sat-on-navy); max-width: 58ch; }
  .lead-telefon { display: none; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); padding-top: var(--space-1); }
  .hero-plitka { display: flex; flex-direction: column; gap: var(--space-4); }
  .hero-plitka .sat-yorliq { color: var(--color-sat-on-navy); }

  /* Imtihon tuzilmasi: zich navy shisha (sahnada .t-shisha--zich), ichidagi qatorlar tekis (ichma-ich blur yo'q) */
  .tuzilma {
    flex: 2 1 280px; min-width: 0;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex; flex-direction: column; gap: var(--space-5);
    color: var(--color-sat-on-navy);
  }
  .tuzilma .sat-yorliq { color: var(--color-sat-on-navy-muted); }
  .tuzilma a { color: var(--color-sat-on-navy-muted); }
  .tuzilma ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .tuzilma li {
    background: var(--color-sat-navy-raised); border: var(--border-width-1) solid var(--color-sat-glass-navy-border);
    border-radius: var(--radius-md); padding: var(--space-4);
    display: flex; align-items: center; gap: var(--space-4);
  }
  .tuzilma-matn { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  /* Modul vaqt chizig'i (bezak, aria-hidden: ma'lumot yuqoridagi matnda). Rang sat-blue: grafik, matn emas */
  .modul-chiziq { display: flex; gap: var(--space-1); width: calc(var(--ulush) * 100%); margin-top: var(--space-2); }
  .modul { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .modul::before {
    content: ''; height: var(--progress-height); border-radius: var(--radius-full);
    background: var(--color-sat-blue); transform-origin: left center;
    transition: transform var(--duration-slow) var(--ease-enter);
    transition-delay: calc(var(--tartib) * var(--duration-slow));
  }
  .tuzilma[data-kutish] .modul::before { transform: scaleX(0); }
  .modul-nom { font-size: var(--text-caption-size); line-height: var(--text-caption-lh); color: var(--color-sat-on-navy-muted); }
  .tuzilma strong { font-family: var(--font-sat); font-weight: var(--font-weight-semibold); font-size: 17px; }
  .tuzilma-belgi {
    flex: none; width: 40px; height: 40px; border-radius: var(--radius-full);
    background: var(--color-sat-blue-fill); color: var(--color-sat-on-blue-fill);
    display: flex; align-items: center; justify-content: center;
  }
  .tuzilma-izoh { font-size: var(--matn-kichik); line-height: 1.5; color: var(--color-sat-on-navy-muted); }
  p.tuzilma-izoh { font-size: var(--matn-mayda); margin-top: auto; }

  /* Qadamlar */
  .yol, .sahifalar { display: flex; flex-direction: column; gap: var(--b-5); }
  .bosh-qator { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--b-3); }
  .yol h2, .sahifalar h2, .qayerda h2 {
    font-family: var(--font-sat); font-weight: var(--font-weight-semibold);
    font-size: var(--text-sat-h2-size); line-height: var(--text-sat-h2-lh); letter-spacing: var(--text-sat-h2-ls);
  }
  .bosh-qator p { color: var(--color-sat-text-muted); }
  .qadamlar {
    --qadam-py: var(--space-5); --qadam-px: var(--space-7); --qadam-belgi: var(--space-10);
    list-style: none; margin: 0; padding: 0; overflow: hidden;
    background: var(--color-sat-surface); border: var(--border-width-1) solid var(--color-sat-line); border-radius: var(--radius-lg);
  }
  .qadamlar li { position: relative; }
  .qadamlar li + li { border-top: var(--border-width-1) solid var(--color-sat-line); }
  /* Qadamlarni ulovchi chiziq: doira ostidan keyingi doiragacha (doiralar qator tepasiga tekislangan) */
  .qadamlar li:not(:last-child)::after {
    content: ''; position: absolute; pointer-events: none;
    left: calc(var(--qadam-px) + var(--qadam-belgi) / 2 - var(--border-width-1));
    top: calc(var(--qadam-py) + var(--qadam-belgi) + var(--space-1));
    bottom: calc(var(--space-1) - var(--qadam-py) - var(--border-width-1));
    width: var(--border-width-2); border-radius: var(--radius-full);
    background: var(--color-sat-line);
  }
  .qadam {
    display: grid; grid-template-columns: var(--qadam-belgi) minmax(0, 1fr) auto;
    align-items: start; column-gap: var(--space-5);
    padding: var(--qadam-py) var(--qadam-px);
    text-decoration: none; color: var(--color-sat-text);
  }
  @media (hover: hover) and (pointer: fine) { .qadam:hover { background: var(--color-sat-bg); } }
  .qadam-belgi {
    width: var(--qadam-belgi); height: var(--qadam-belgi); border-radius: var(--radius-full);
    background: var(--color-sat-blue-fill); color: var(--color-sat-on-blue-fill);
    display: grid; place-items: center;
  }
  .qadam-yorliq { font-size: var(--matn-mayda); font-weight: 700; color: var(--color-sat-blue-text); }
  .qadam-matn { display: flex; flex-direction: column; gap: var(--b-1); }
  .qadam-nom { font-family: var(--font-sat); font-size: 20px; font-weight: var(--font-weight-semibold); }
  .qadam-tavsif { font-size: 15px; line-height: 1.55; color: var(--color-sat-text-muted); }
  .qadam-havola { align-self: center; font-weight: 700; font-size: 15px; white-space: nowrap; color: var(--color-sat-blue-text); text-decoration: underline; text-underline-offset: 0.15em; }
  @media (hover: hover) and (pointer: fine) { .qadam:hover .qadam-havola { text-decoration-thickness: var(--border-width-2); } }
  .qadam-strelka { display: none; align-self: center; color: var(--color-sat-text-muted); }

  /* SAT qayerda kerak */
