---
// SAT bo'limi kirishi (T1, 2-tur).
// Dizayn: Tayanch-SAT-dizayn.md, "Main" (kompyuter) va "Telefon" ekranlari.
// Matnlar dizayndan, inglizcha (SAT bo'limi qoidasi, CLAUDE.md). Imtihon tuzilmasi raqamlari: CB03 (College Board, rasmiy).
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import { satGuruhlar } from '../../../data/satSahifalar';
import { manbalar } from '../../../data/manbalar';
const cb03 = manbalar.find((m) => m.id === 'CB03')!;
import { yol } from '../../../lib/yol';
import Zina from '../../../components/Zina.astro';
import QavatFoto from '../../../components/QavatFoto.astro';
import KunSavoli from '../../../components/sat/KunSavoli.astro';
import SatMaqsadSarlavha from '../../../components/sat/SatMaqsadSarlavha.astro';
import { satIkonkalar } from '../../../data/satIkonkalar';
import { darsSavollari, type DarsModul } from '../../../data/satDarslar';

const sat = (qism: string) => yol(`/uz/sat/${qism}`);

// Shaxsiy holat (vizual-sat-2): dars sahifasi -> DarsQolip moduli. Savollar soni va id lari build vaqtida satDarslar dan.
const darsModuli: Record<string, DarsModul> = {
  'qollanma/math/hajm/': 'hajm',
  'qollanma/math/grafik/': 'grafik',
  'qollanma/math/birlik-aylana/': 'aylana',
  'qollanma/math/statistika/': 'statistika',
  'qollanma/reading-writing/xatoni-toping/': 'rw-xato',
  'qollanma/reading-writing/dalil/': 'rw-dalil',
  'qollanma/reading-writing/otish-sozlari/': 'rw-otish',
  'qollanma/reading-writing/lugat-kontekstda/': 'rw-lugat',
};
// satGuruhlar tartibida (Math, keyin Reading & Writing): "Continue" kartasi shu tartibdagi birinchi tugamagan darsni oladi.
const darslar = satGuruhlar.flatMap((g) => g.sahifalar).filter((s) => s.tayyor && darsModuli[s.qism]).map((s) => ({
  modul: darsModuli[s.qism],
  nomi: s.nomi,
  href: sat(s.qism),
  ikonka: satIkonkalar[s.qism] ?? '',
  idlar: darsSavollari[darsModuli[s.qism]].map((q) => q.id),
}));
if (darslar.length !== Object.keys(darsModuli).length) throw new Error("SAT kirish: darsModuli va satGuruhlar dagi darslar mos emas");
const holatSozlama = {
  darslar,
  mavjudId: Object.values(darsSavollari).flat().map((q) => q.id),
  takrorHref: sat('vosita/takrorlash/'),
};

// Imtihon tuzilmasi (CB03). Vaqt chizig'i shu raqamlardan: bo'lak uzunligi daqiqaga mutanosib, ikkala bo'lim bir shkalada.
const tuzilma = [
  { nomi: 'Reading & Writing', belgi: 'kitob', modul: 2, daqiqa: 32, savol: 54 },
  { nomi: 'Math', belgi: 'plyus', modul: 2, daqiqa: 35, savol: 44 },
] as const;
const engUzunVaqt = Math.max(...tuzilma.map((t) => t.modul * t.daqiqa));

// "Where the SAT counts": har qator faqat rasmiy manbadan (manbalar.ts, 2026-11-09). Holat matn bilan, rang yagona belgi emas.
type SatHolat = 'Required' | 'Optional' | 'Accepted';
const qayerda: { manba: string; nomi: string; davlat: string; holat: SatHolat; matn: string }[] = [
  { manba: 'HV01', nomi: 'Harvard College', davlat: 'USA', holat: 'Required', matn: 'The SAT or ACT is required, for international applicants too. Only if neither test is accessible does Harvard accept other results, such as A-Levels, IB or a national exam.' },
  { manba: 'NY01', nomi: 'NYU Abu Dhabi', davlat: 'UAE', holat: 'Optional', matn: 'Test-optional through the 2027–2028 application cycle. Scores you choose to send are still reviewed.' },
  { manba: 'MT01', nomi: 'METU', davlat: 'Türkiye', holat: 'Accepted', matn: 'The SAT is one of the exams you can apply with, alongside TR-YÖS and others. Scores are valid for two years.' },
  { manba: 'KY01', nomi: 'Kyoto University iUP', davlat: 'Japan', holat: 'Accepted', matn: 'At least one standardized test is mandatory, and the SAT is on the list. For October 2027 entry, only tests taken by November 7, 2026 count. Engineering also needs physics and chemistry results, which the SAT does not cover.' },
];
const qayerdaQatorlar = qayerda.map((q) => ({ ...q, m: manbalar.find((m) => m.id === q.manba && m.tekshiruvDarajasi === 'rasmiy')! }));
if (qayerdaQatorlar.some((q) => !q.m)) throw new Error('SAT kirish: "Where the SAT counts" manbasi topilmadi yoki rasmiy emas');
type QadamBelgi = 'kompas' | 'qalam' | 'grafik';
// holat: qaysi brauzer ma'lumoti qadam ostida ko'rsatiladi (I2; faqat o'qiladi).
const qadamlar: { yorliq: string; nomi: string; tavsif: string; havola: string; qism: string; belgi: QadamBelgi; holat: 'yol' | 'javob' | 'xato' }[] = [
  { yorliq: 'UNDERSTAND', nomi: 'Strategy', tavsif: 'Where to start your prep and how to plan it.', havola: 'Open the guide', qism: 'qollanma/strategiya/', belgi: 'kompas', holat: 'yol' },
  { yorliq: 'PRACTICE', nomi: 'Tests and question bank', tavsif: 'Short tests by topic, with an explanation right after each answer.', havola: 'Start practicing', qism: 'mashq/test/', belgi: 'qalam', holat: 'javob' },
  { yorliq: 'ANALYZE', nomi: 'My results', tavsif: 'A list of your mistakes, saved only in this browser. No score is calculated.', havola: 'See your results', qism: 'vosita/natijalar/', belgi: 'grafik', holat: 'xato' },
];
---
<BolimQobiq
  title="SAT"
  description="Digital SAT prep: English (Reading & Writing) and Math. An independent plan, without expensive courses."
  turi="bolim-kirishi"
  bolim="sat"
  holat="qoralama"
  tekshirilgan="2026-11-04"
  keyingiTekshiruv="2026-12-04"
  manbalar={['CB03', 'HV01', 'NY01', 'MT01', 'KY01']}
>
  <div class="ichki sat-kirish">
    <SatMaqsadSarlavha />
    <QavatFoto bolim="sat" ixcham />
    <section class="hero" aria-labelledby="sat-h">
      <div class="hero-matn">
        <p class="pill-qator"><span class="pill">Draft</span><span class="pill-izoh">Section home</span></p>
        <h1 id="sat-h">Digital SAT®,<br /><span class="kok">without expensive courses.</span></h1>
        <p class="lead">English (Reading &amp; Writing) and Math, with equal attention. The plan is based on the independent prep that led the author to an SAT score of 1420: Desmos and formulas, time management, mistake analysis.</p>
        <p class="lead lead-telefon">English and Math, with equal attention. A plan based on the author's independent prep.</p>
        <div class="cta">
          <a class="katta-tugma asosiy" href={sat('mashq/test/')}>
            Start a practice test
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </a>
          <a class="katta-tugma ikkinchi" href={sat('qollanma/strategiya/')}>Read the strategy</a>
        </div>
      </div>

      <div class="tuzilma" aria-labelledby="tuzilma-h">
        <h2 id="tuzilma-h" class="ustki-yorliq">Test structure</h2>
        <ul>
          {tuzilma.map((t) => (
            <li>
              <span class="tuzilma-belgi" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {t.belgi === 'kitob' ? <path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z" /> : <><path d="M5 12h14" /><path d="M12 5v14" /></>}
                </svg>
              </span>
              <span class="tuzilma-matn">
                <strong>{t.nomi}</strong>
                <span class="tuzilma-izoh">{t.modul} modules, {t.daqiqa} minutes each · {t.savol} questions</span>
                <span class="modul-chiziq" aria-hidden="true" style={`--ulush: ${(t.modul * t.daqiqa) / engUzunVaqt}`}>
                  {Array.from({ length: t.modul }, (_, i) => (
                    <span class="modul" style={`--tartib: ${i}`}><span class="modul-nom">Module {i + 1}</span></span>
                  ))}
                </span>
              </span>
            </li>
          ))}
        </ul>
        <p class="tuzilma-izoh">Source: <a href={cb03.havola} rel="noopener">{cb03.tashkilot}</a>, checked {cb03.tekshirilganSana}.</p>
      </div>
      <script is:inline>
        // Vaqt chizig'i karta ekranga kirganda bir marta to'ladi. JS yo'q yoki reduced motion: darhol to'liq.
        (() => {
          const karta = document.currentScript && document.currentScript.previousElementSibling;
          if (!karta || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          karta.setAttribute('data-kutish', '');
          const k = new IntersectionObserver((yozuvlar) => {
            if (!yozuvlar.some((y) => y.isIntersecting)) return;
            karta.removeAttribute('data-kutish');
            k.disconnect();
          }, { threshold: 0.4 });
          k.observe(karta);
        })();
      </script>
    </section>

    <!-- I1. Davom etish: faqat shu brauzerdagi dars progressi va takrorlash navbatidan. Ma'lumot yo'q yoki JS'siz: yashirin. -->
    <section class="davom" aria-labelledby="davom-h" data-davom hidden>
      <h2 id="davom-h" class="ustki-yorliq">Continue where you left off</h2>
      <ul class="davom-royxat">
        <li data-davom-dars hidden>
          <a class="davom-qator" href="">
            <span class="davom-belgi" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-davom-ikonka></svg>
            </span>
            <span class="davom-matn">
              <span class="davom-nom" data-davom-nom></span>
              <span class="davom-izoh" data-davom-izoh></span>
              <span class="davom-chiziq" aria-hidden="true"><span data-davom-toldirish></span></span>
            </span>
            <svg class="davom-strelka" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </a>
        </li>
        <li data-davom-takror hidden>
          <a class="davom-qator" href={holatSozlama.takrorHref}>
            <span class="davom-belgi" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={satIkonkalar['vosita/takrorlash/']} />
            </span>
            <span class="davom-matn">
              <span class="davom-nom" data-davom-takror-matn></span>
              <span class="davom-izoh">Mistake log: review</span>
            </span>
            <svg class="davom-strelka" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </a>
        </li>
      </ul>
    </section>
    <script type="application/json" id="sat-kirish-holat" set:html={JSON.stringify(holatSozlama)} />

    <KunSavoli />

    <section class="yol" aria-labelledby="yol-h">
      <div class="bosh-qator">
        <h2 id="yol-h">Where will you start?</h2>
        <p class="sust kichik">Three steps, in any order</p>
      </div>
      <ol class="qadamlar">
        {qadamlar.map((q, i) => (
          <li>
            <a href={sat(q.qism)} class="qadam">
              <span class="qadam-belgi" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {q.belgi === 'kompas' && <><circle cx="12" cy="12" r="9" /><path d="M15.5 8.5l-2 5-5 2 2-5z" /></>}
                  {q.belgi === 'qalam' && <><path d="M12 20h8" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></>}
                  {q.belgi === 'grafik' && <><path d="M3 20h18" /><path d="M7 16v-4" /><path d="M12 16V7" /><path d="M17 16v-6" /></>}
                </svg>
              </span>
              <span class="qadam-matn">
                <span class="qadam-yorliq"><span class="qadam-raqam">{i + 1}</span><span class="qadam-soz"> · {q.yorliq}</span></span>
                <span class="qadam-nom">{q.nomi}</span>
                <span class="qadam-tavsif">{q.tavsif}</span>
                <span class="qadam-holat" data-qadam-holat={q.holat} hidden>
                  {q.holat === 'yol' && <span class="qadam-tayyor" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg></span>}
                  <span data-qadam-holat-matn></span>
                </span>
              </span>
              <span class="qadam-havola">{q.havola}</span>
              <svg class="qadam-strelka" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="qayerda" aria-labelledby="qayerda-h">
      <div class="qayerda-ust">
        <div class="bosh-qator">
          <h2 id="qayerda-h">Where the SAT counts</h2>
          <p class="sust kichik">Four examples. Each university sets its own rules.</p>
        </div>
        <!-- Rasm: Canva (AI), manba va litsenziya docs/rasmlar.md. 720 + 400 WebP, jami sahifada <= 150 KB. -->
        <img
          class="qayerda-foto"
          src={yol('/rasmlar/sat/qayerda-720.webp')}
          srcset={`${yol('/rasmlar/sat/qayerda-400.webp')} 400w, ${yol('/rasmlar/sat/qayerda-720.webp')} 720w`}
          sizes="(max-width: 640px) 100vw, 420px"
          width="720"
          height="360"
          alt="A desk by a sunny window with a blank folder, a blank envelope, a pencil and a cup of green tea."
          loading="lazy"
          decoding="async"
        />
      </div>
      <ul class="qayerda-royxat">
        {qayerdaQatorlar.map((q, i) => (
          <li class="qayerda-karta">
            <div class="qayerda-bosh">
              <span class="qayerda-nom"><strong>{q.nomi}</strong><span class="qayerda-davlat">{q.davlat}</span></span>
              <span class:list={['holat', `holat-${q.holat.toLowerCase()}`]}>
                {q.holat === 'Required' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v8" /><path d="M12 18v.5" /></svg>}
                {q.holat === 'Accepted' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>}
                {q.holat === 'Optional' && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h12" /></svg>}
                {q.holat}
              </span>
              <button type="button" class="qayerda-ochish" aria-expanded="true" aria-controls={`qayerda-tana-${i}`} aria-label={`Details: ${q.nomi}`}>
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
              </button>
            </div>
            <div class="qayerda-tana" id={`qayerda-tana-${i}`}>
              <p class="qayerda-matn">{q.matn}</p>
              <p class="qayerda-manba"><a href={q.m.havola} rel="noopener" aria-label={`Official page: ${q.nomi}`}>Official page</a> · checked {q.m.tekshirilganSana}</p>
            </div>
          </li>
        ))}
      </ul>
      <script is:inline>
        // Telefonda (<= 640px) kartalar yopiq boshlanadi, tugma ochadi/yopadi. Kengroq ekranda tugma yo'q, hammasi ochiq (CSS).
        // JS yo'q: hamma karta ochiq, tugma ko'rinmaydi. Holat saqlanmaydi.
        (() => {
          const royxat = document.currentScript && document.currentScript.previousElementSibling;
          if (!royxat) return;
          royxat.querySelectorAll('.qayerda-ochish').forEach((t) => {
            t.setAttribute('aria-expanded', 'false');
            t.addEventListener('click', () => {
              const ochiq = t.getAttribute('aria-expanded') !== 'true';
              t.setAttribute('aria-expanded', String(ochiq));
              t.closest('.qayerda-karta').toggleAttribute('data-ochiq', ochiq);
            });
          });
          royxat.setAttribute('data-yigma', '');
        })();
      </script>
      <p class="qayerda-izoh">Rules change every cycle. Check the official page before you apply.</p>
    </section>

    <section class="sahifalar" aria-labelledby="sahifa-h">
      <h2 id="sahifa-h">All pages in this section</h2>
      <div class="guruhlar">
        {satGuruhlar.filter((g) => g.nomi !== 'Practice').map((g, i) => (
          <div class="guruh">
            <h3 id={`kirish-guruh-${i}`} class="ustki-yorliq">{g.nomi}</h3>
            <ul aria-labelledby={`kirish-guruh-${i}`}>
              {g.sahifalar.map((s) => (
                <li>
                  <a href={sat(s.qism)}>
                    {satIkonkalar[s.qism]
                      ? <svg class="s-ikonka" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={satIkonkalar[s.qism]} />
                      : <span class="s-ikonka" aria-hidden="true"></span>}
                    <span class="s-nom">{s.nomi}</span>
                    {!s.tayyor && <span class="pill pill-kichik">coming soon</span>}
                    {s.tayyor && darsModuli[s.qism] && (
                      <span class="s-progress" data-dars-progress={darsModuli[s.qism]} hidden>
                        <span class="s-tayyor" aria-hidden="true" hidden><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg></span>
                        <span aria-hidden="true" data-progress-son></span>
                        <span class="ekranda-yoq" data-progress-sr></span>
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <Zina />

    <section class="pastki" aria-label="Contact and note">
      <p class="telegram">Telegram channel <span class="pill pill-kichik">coming soon</span></p>
      <p class="eslatma">Results are not guaranteed.</p>
    </section>
  </div>
</BolimQobiq>

<script>
  // Shaxsiy holat (vizual-sat-2, I1–I3): faqat shu brauzerdagi mavjud kalitlarni O'QIYDI, hech narsa yozmaydi.
  // tayanch:sat-dars-progress, tayanch:sat-xato-daftari, tayanch:sat-takrorlash, tayanch:sat-javoblar, tayanch:sat-qayerdan-boshlash.
  // Ma'lumot yo'q, kalit buzuq yoki saqlash bloklangan: sahifa oddiy ko'rinishda qoladi. "Orqaga" bilan qaytilganda (pageshow) yangilanadi.
  import { oqi, progressniOqi, xatolarniOqi } from '../../../lib/darsSaqlash';
  import { holatniOqi, xatolarniQosh, guruhla } from '../../../lib/takrorlash';
  import { holatniTekshir } from '../../../lib/sat/yolXaritasi';
  import { kirishHolati, sanoq } from '../../../lib/sat/kirishHolat';
  import { KALIT_JAVOBLAR } from '../../../data/satNamuna';
  import { KALIT_YOL_XARITASI } from '../../../data/satYolXaritasi';

  interface Dars { modul: string; nomi: string; href: string; ikonka: string; idlar: string[] }
  interface Sozlama { darslar: Dars[]; mavjudId: string[]; takrorHref: string }

  const sozlamaEl = document.getElementById('sat-kirish-holat');
  const sozlama: Sozlama | null = sozlamaEl ? JSON.parse(sozlamaEl.textContent || 'null') : null;
  const $ = <T extends HTMLElement = HTMLElement>(s: string, ota: ParentNode = document) => ota.querySelector<T>(s);
  const matn = (el: Element | null, t: string) => { if (el) el.textContent = t; };

  function yangila() {
    if (!sozlama) return;
    try {
      const javoblar = oqi<unknown>(KALIT_JAVOBLAR, []);
      const xatolar = xatolarniOqi('sat');
      const takror = xatolarniQosh(holatniOqi('sat'), xatolar, new Set(sozlama.mavjudId)).h;
      const yol = holatniTekshir(oqi<unknown>(KALIT_YOL_XARITASI, null)).javoblar;
      const h = kirishHolati({
        progress: progressniOqi('sat'),
        modullar: sozlama.darslar,
        testJavoblari: Array.isArray(javoblar) ? javoblar.length : 0,
        xatolar: xatolar.length,
        bugunTakror: guruhla(takror).bugun.length,
        yolSaqlangan: Object.values(yol).some((v) => v !== undefined),
      });

      // I1: "Continue where you left off"
      const karta = $('[data-davom]');
      const darsQator = $('[data-davom-dars]');
      const takrorQator = $('[data-davom-takror]');
      const dars = h.davom && sozlama.darslar.find((d) => d.modul === h.davom!.modul);
      if (darsQator) {
        darsQator.hidden = !dars;
        if (dars && h.davom) {
          $('a', darsQator)?.setAttribute('href', dars.href);
          const ikonka = $('[data-davom-ikonka]', darsQator);
          if (ikonka) ikonka.innerHTML = dars.ikonka;
          matn($('[data-davom-nom]', darsQator), dars.nomi);
          matn($('[data-davom-izoh]', darsQator), `${h.davom.javob} of ${h.davom.jami} answered`);
          $('[data-davom-toldirish]', darsQator)?.style.setProperty('--ulush', String(h.davom.javob / h.davom.jami));
        }
      }
      if (takrorQator) {
        takrorQator.hidden = h.bugunTakror === 0;
        matn($('[data-davom-takror-matn]', takrorQator), `${h.bugunTakror} to review today`);
      }
      if (karta) karta.hidden = !dars && h.bugunTakror === 0;

      // I2: qadamlar ostidagi holat
      const qadamMatn: Record<string, string> = {
        yol: h.yolSaqlangan ? 'Your path is saved' : '',
        javob: h.javoblar > 0 ? `${sanoq(h.javoblar, 'answer')} saved` : '',
        xato: h.xatolar > 0 ? `${sanoq(h.xatolar, 'mistake')} logged` : '',
      };
      document.querySelectorAll<HTMLElement>('[data-qadam-holat]').forEach((el) => {
        const t = qadamMatn[el.dataset.qadamHolat || ''] || '';
        el.hidden = !t;
        matn($('[data-qadam-holat-matn]', el), t);
      });

      // I3: "All pages" dars bandlarida progress
      document.querySelectorAll<HTMLElement>('[data-dars-progress]').forEach((el) => {
        const d = h.darslar[el.dataset.darsProgress || ''];
        el.hidden = !d || d.javob === 0;
        if (!d || d.javob === 0) return;
        const tugadi = d.javob >= d.jami;
        const belgi = $('.s-tayyor', el);
        if (belgi) belgi.hidden = !tugadi;
        matn($('[data-progress-son]', el), tugadi ? '' : `${d.javob}/${d.jami}`);
        matn($('[data-progress-sr]', el), tugadi ? 'completed' : `${d.javob} of ${d.jami} answered`);
      });
    } catch {
      /* brauzer ruxsat bermadi yoki ma'lumot buzuq: oddiy ko'rinish qoladi */
    }
  }

  yangila();
  window.addEventListener('pageshow', (e) => { if (e.persisted) yangila(); });
</script>

