---
import type { GetStaticPaths } from 'astro';
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import SatSavol from '../../../../../components/sat/SatSavol.astro';
import type { Savol } from '../../../../../data/savolSxema';
import { sprTekshir } from '../../../../../lib/sat/sprFormat';
import { yol } from '../../../../../lib/yol';

interface SavolMatni extends Pick<Savol, 'external_id' | 'stem' | 'explanation'> {
  answer: string[];
}

interface Mavzu {
  id: string;
  name: string;
  items: SavolMatni[];
}

interface Props {
  mavzu: Mavzu;
  boshqalar: { id: string; name: string }[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  // The drafts are supplied by the local preview. The standard site build has no worksheet routes.
  const folder = process.env.TAYANCH_SAT_MATH_DIR;
  if (!folder) return [];

  const titles = {
    parabola: 'Parabolas',
    'parabola-models': 'Quadratic models',
    'projectile-motion': 'Projectile motion',
  };
  const files = await readdir(folder);
  const sets: Mavzu[] = [];
  for (const [id, name] of Object.entries(titles)) {
    if (!files.includes(id + '.json')) continue;
    const data = JSON.parse(await readFile(join(folder, id + '.json'), 'utf8')) as Savol[];
    if (!Array.isArray(data) || !data.length || new Set(data.map((q) => q.external_id)).size !== data.length) {
      throw new Error(`${id}: expected a non-empty set with distinct question IDs`);
    }
    const items = data.map(({ external_id, section, format, stem, answer, explanation }) => {
      if (section !== 'math' || format !== 'spr' || !external_id || !stem || !explanation ||
          !Array.isArray(answer) || !answer.length || answer.some((value) => typeof value !== 'string' || !sprTekshir(value).ok)) {
        throw new Error(`${external_id}: expected a written-answer Math question with valid answers`);
      }
      return { external_id, stem, answer, explanation };
    });
    sets.push({ id, name, items });
  }
  return sets.map((mavzu) => ({
    params: { mavzu: mavzu.id },
    props: { mavzu, boshqalar: sets.filter((set) => set.id !== mavzu.id).map(({ id, name }) => ({ id, name })) },
  }));
};

const { mavzu, boshqalar } = Astro.props;
---
<BolimQobiq title={`${mavzu.name} · SAT Math`} description={`Practise ${mavzu.name.toLowerCase()} with written-answer questions.`} turi="mashq" holat="qoralama" yol={['Practice']}>
  <SatSavol />
  <div class="ichki worksheet sk" data-worksheet={mavzu.id}>
    <header>
      <h1>{mavzu.name}</h1>
      <p>{mavzu.items.length} SAT Math practice questions</p>
    </header>
    <ol aria-label="Practice questions">
      {mavzu.items.map((item, index) => (
        <li class="question">
          <div class="sk-matn" data-stem>{item.stem}</div>
          <label for={`answer-${index}`}><span class="sk-sr">Question {index + 1}. </span>Your answer</label>
          <input id={`answer-${index}`} data-answer type="text" maxlength="64" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby={`feedback-${index}`} />
          <p id={`feedback-${index}`} data-feedback hidden></p>
          <div class="solution sk-matn" data-solution hidden>
            <p><strong>Answer:</strong> {item.answer[0]}</p>
            <div data-explanation></div>
          </div>
        </li>
      ))}
    </ol>
    <div class="actions">
      <button class="t-tugma sat-tugma--kok" type="button" data-check disabled>Check answers</button>
      <p data-result role="status"></p>
      <p data-storage role="status"></p>
    </div>
    {boshqalar.length > 0 && (
      <nav aria-label="More SAT Math practice">
        {boshqalar.map(({ id, name }) => <a href={yol(`/uz/sat/mashq/materiallar/${id}/`)}>{name}</a>)}
      </nav>
    )}
    <script type="application/json" data-questions set:html={JSON.stringify(mavzu.items).replace(/</g, '\\u003c')} />
  </div>
</BolimQobiq>

<script>
  import type { Savol } from '../../../../../data/savolSxema';
  import { brauzerOmbori } from '../../../../../lib/navigator/ombor';
  import { sprNormalla, sprTekshir } from '../../../../../lib/sat/sprFormat';
  import { xavfsizMatn } from '../../../../../lib/sat/xavfsizMatn';

  type Item = Pick<Savol, 'external_id' | 'stem' | 'explanation'> & { answer: string[] };

  function fraction(value: string): [bigint, bigint] {
    const [numerator, denominator] = value.split('/');
    if (denominator) return [BigInt(numerator), BigInt(denominator)];
    const [whole, decimal = ''] = numerator.split('.');
    return [BigInt(whole + decimal), 10n ** BigInt(decimal.length)];
  }

  const root = document.querySelector<HTMLElement>('[data-worksheet]');
  if (root) {
    const items: Item[] = JSON.parse(root.querySelector('[data-questions]')!.textContent!);
    const fields = Array.from(root.querySelectorAll<HTMLInputElement>('[data-answer]'));
    const stems = root.querySelectorAll<HTMLElement>('[data-stem]');
    const feedback = root.querySelectorAll<HTMLElement>('[data-feedback]');
    const solutions = root.querySelectorAll<HTMLElement>('[data-solution]');
    const explanations = root.querySelectorAll<HTMLElement>('[data-explanation]');
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const storageMessage = root.querySelector<HTMLElement>('[data-storage]')!;
    const checkButton = root.querySelector<HTMLButtonElement>('[data-check]')!;
    const storage = brauzerOmbori();
    const key = `tayanch:sat-${root.dataset.worksheet}:v1`;

    let answers: Record<string, string> = {};
    const saved = storage.oqi(key);
    if (saved) {
      try {
        const data = JSON.parse(saved);
        if (data && typeof data === 'object' && !Array.isArray(data)) answers = data;
      } catch { /* Older or damaged data can be entered again. */ }
    }
    const keys = items.map((item) => item.answer.map((value) => fraction(sprNormalla(value))));
    let explanationsLoaded = false;
    items.forEach((item, index) => {
      void xavfsizMatn(item.stem, stems[index]);
      const input = fields[index];
      const prior = answers[item.external_id];
      if (typeof prior === 'string') input.value = prior.slice(0, input.maxLength);
      input.addEventListener('input', () => {
        answers[item.external_id] = input.value;
        if (!storage.yoz(key, JSON.stringify(answers)) || !storage.doimiy) {
          storageMessage.textContent = 'Answers can only be kept while this page is open.';
        }
        input.removeAttribute('aria-invalid');
        feedback[index].hidden = true;
        result.textContent = '';
      });
    });

    checkButton.disabled = false;
    checkButton.addEventListener('click', () => {
      let correct = 0;
      let unanswered = 0;
      items.forEach((item, index) => {
        const input = fields[index];
        const value = input.value.trim();
        const checked = sprTekshir(value);
        let state = 'Unanswered';
        if (!value) unanswered += 1;
        else if (!checked.ok) state = checked.xabar;
        else {
          const [a, b] = fraction(checked.qiymat);
          const matches = keys[index].some(([c, d]) => a * d === b * c);
          if (matches) correct += 1;
          state = matches ? 'Correct' : 'Incorrect';
        }
        if (value && !checked.ok) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
        feedback[index].textContent = state;
        feedback[index].hidden = false;
        solutions[index].hidden = false;
        if (!explanationsLoaded) void xavfsizMatn(item.explanation, explanations[index]);
      });
      explanationsLoaded = true;
      result.textContent = `${correct}/${items.length} correct · ${unanswered} unanswered`;
    });
  }
</script>

<style>
  .worksheet { display: grid; gap: var(--space-5); padding-block: var(--space-6); }
  .worksheet.sk { max-width: 49rem; }
  .worksheet h1 { font-size: var(--text-h1-size); line-height: var(--text-h1-lh); }
  header p { margin: var(--space-2) 0 0; color: var(--color-sat-text-muted); }
  ol { margin: 0; padding-inline-start: var(--space-6); }
  .question { padding-block: var(--space-5); border-block-end: var(--border-width-1) solid var(--color-sat-line-strong); overflow-wrap: anywhere; }
  .question::marker { font-weight: var(--font-weight-bold); }
  .question label { display: block; margin-block: var(--space-3) var(--space-1); font-weight: var(--font-weight-semibold); }
  input { width: min(100%, 12rem); min-height: var(--size-touch-min); padding: var(--space-2) var(--space-3); border: var(--border-width-1) solid var(--color-sat-line-strong); border-radius: var(--radius-md); background: var(--color-sat-surface); color: var(--color-sat-text); font: inherit; }
  input:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
  input[aria-invalid='true'] { border-style: dashed; }
  [data-feedback] { margin-block: var(--space-2); font-weight: var(--font-weight-semibold); }
  .solution { padding-block-start: var(--space-2); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .actions p { margin: 0; }
  [data-result] { font-weight: var(--font-weight-bold); }
  .actions p:empty { display: none; }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-4); }
</style>
