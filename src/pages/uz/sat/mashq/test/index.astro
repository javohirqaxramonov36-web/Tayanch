---
// Mashq testi: savol ekrani. Dizayn: Tayanch-SAT-dizayn.md, "Mashq" ekrani.
// Javoblar faqat shu brauzerda saqlanadi (tayanch:sat-javoblar). Ball hisoblanmaydi.
import SatFokus from '../../../../../layouts/SatFokus.astro';
import DesmosHavola from '../../../../../components/sat/DesmosHavola.astro';
import { savollar } from '../../../../../data/satNamuna';
import { yol } from '../../../../../lib/yol';
---
<SatFokus
  indeks
  title="Practice test · SAT"
  description="A short sample practice set in Reading & Writing and Math: an explanation right after each answer."
  ustki={`${savollar[0].bolim} · Sample`}
  nomi={savollar[0].mavzu}
  progressNomi="Practice progress"
  yol={['Practice']}
>
  <DesmosHavola slot="amal" id="desmos" hidden={savollar[0].bolim !== 'Math'} />

  <script type="application/json" id="savollar-data" set:html={JSON.stringify(savollar)} />

  <div class="ustun" id="mashq">
    <section class="savol-karta" aria-labelledby="savol">
      <div class="karta-bosh">
        <span class="pill" id="savol-raqam">Question 1</span>
        <button type="button" class="bayroq" id="bayroq" aria-pressed="false">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4" /><path d="M4 4h13l-2 4 2 4H4" /></svg>
          Come back later
        </button>
      </div>
      <p class="parcha" id="parcha" hidden={!savollar[0].parcha}>{savollar[0].parcha}</p>
      <h1 id="savol">{savollar[0].matn}</h1>
      <fieldset class="variantlar" id="variantlar" aria-labelledby="savol">
        {savollar[0].variantlar.map((v, i) => (
          <label class="variant">
            <input type="radio" name="javob" value={i} />
            <span class="harf">{'ABCD'[i]}</span>
            <span class="v-matn">{v}</span>
            <svg class="belgi belgi-togri" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
            <svg class="belgi belgi-xato" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </label>
        ))}
      </fieldset>
    </section>

    <p class="sr" id="izoh-xabar" role="status" aria-atomic="true"></p>
    <section class="izoh" id="izoh" aria-labelledby="izoh-sarlavha" hidden>
      <p class="izoh-sarlavha" id="izoh-sarlavha"></p>
      <p id="izoh-matn"></p>
    </section>

    <div class="pastki">
      <button type="button" class="t-tugma t-tugma--ikkinchi" id="otkazish">Skip</button>
      <button type="button" class="t-tugma sat-tugma--kok" id="tekshir" disabled>Check</button>
      <button type="button" class="t-tugma" id="keyingi" hidden>Next question</button>
    </div>
  </div>

  <section class="tugadi" id="tugadi" aria-labelledby="tugadi-h" hidden>
    <p class="pill">Set complete</p>
    <h1 id="tugadi-h" tabindex="-1">Sample set complete</h1>
    <p class="tugadi-matn" id="tugadi-matn"></p>
    <div class="tugadi-tugmalar">
      <a class="t-tugma sat-tugma--kok" href={yol('/uz/sat/vosita/natijalar/')}>See results</a>
      <button type="button" class="t-tugma t-tugma--ikkinchi" id="qayta">Start over</button>
    </div>
  </section>
</SatFokus>

<script>
  import { KALIT_JAVOBLAR, mavzuNomi, type Savol, type Javob } from '../../../../../data/satNamuna';
  import { holatYoz } from '../../../../../lib/holat';

  const hamma: Savol[] = JSON.parse(document.getElementById('savollar-data')!.textContent || '[]');
  const tanlanganMavzular = new URLSearchParams(location.search).get('mavzular')?.split('|').filter(Boolean).map(mavzuNomi) ?? [];
  const filtrlangan = hamma.filter((s) => tanlanganMavzular.includes(s.mavzu));
  const toplam = filtrlangan.length > 0 ? filtrlangan : hamma;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const OYLAR = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const HARF = 'ABCD';

  let i = 0;
  let tekshirildi = false;
  let togrilar = 0;

  const saqla = (j: Javob) => {
    try {
      const eski: Javob[] = JSON.parse(localStorage.getItem(KALIT_JAVOBLAR) || '[]');
      eski.unshift(j);
      holatYoz(KALIT_JAVOBLAR, eski.slice(0, 500));
    } catch { /* brauzer saqlashga ruxsat bermadi */ }
  };

  const progress = (bajarildi: number) => {
    const foiz = Math.round((bajarildi / toplam.length) * 100);
    $('fokus-progress-toldirish').style.width = foiz + '%';
    const p = $('fokus-progress');
    p.setAttribute('aria-valuemax', String(toplam.length));
    p.setAttribute('aria-valuenow', String(bajarildi));
    $('fokus-progress-matn').textContent = `${Math.min(i + 1, toplam.length)} / ${toplam.length}`;
  };

  const tanlangan = () => {
    const r = document.querySelector<HTMLInputElement>('input[name="javob"]:checked');
    return r ? Number(r.value) : null;
  };

  const chiz = () => {
    const s = toplam[i];
    tekshirildi = false;
    $('fokus-ustki').textContent = `${s.bolim} · Sample`;
    $('desmos').hidden = s.bolim !== 'Math';
    $('fokus-nomi').textContent = s.mavzu;
    $('savol-raqam').textContent = `Question ${i + 1}`;
    $('parcha').textContent = s.parcha ?? '';
    $('parcha').hidden = !s.parcha;
    $('savol').textContent = s.matn;
    const bayroq = $('bayroq');
    bayroq.setAttribute('aria-pressed', 'false');
    document.querySelectorAll<HTMLLabelElement>('.variant').forEach((l, k) => {
      const inp = l.querySelector('input')!;
      inp.checked = false;
      inp.disabled = false;
      l.querySelector('.v-matn')!.textContent = s.variantlar[k];
      l.classList.remove('togri', 'xato');
    });
    $<HTMLButtonElement>('tekshir').disabled = true;
    $('tekshir').hidden = false;
    $('keyingi').hidden = true;
    $('otkazish').hidden = false;
    $('izoh').hidden = true;
    $('izoh-xabar').textContent = '';
    progress(i);
  };

  document.getElementById('variantlar')!.addEventListener('change', () => {
    if (!tekshirildi) $<HTMLButtonElement>('tekshir').disabled = tanlangan() === null;
  });

  $('bayroq').addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLElement;
    b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
  });

  $('tekshir').addEventListener('click', () => {
    const t = tanlangan();
    if (t === null) return;
    const s = toplam[i];
    tekshirildi = true;
    const togrimi = t === s.togri;
    if (togrimi) togrilar++;
    document.querySelectorAll<HTMLLabelElement>('.variant').forEach((l, k) => {
      l.querySelector('input')!.disabled = true;
      if (k === s.togri) l.classList.add('togri');
      else if (k === t) l.classList.add('xato');
    });
    const izoh = $('izoh');
    izoh.classList.toggle('izoh-togri', togrimi);
    $('izoh-sarlavha').textContent = togrimi ? `Correct! Answer: ${HARF[s.togri]}` : `Not this time. Correct answer: ${HARF[s.togri]}`;
    $('izoh-matn').textContent = s.izoh;
    izoh.hidden = false;
    $('tekshir').hidden = true;
    $('otkazish').hidden = true;
    $('keyingi').hidden = false;
    $('keyingi').focus();
    $('izoh-xabar').textContent = $('izoh-sarlavha').textContent;
    progress(i + 1);
    const d = new Date();
    saqla({
      id: `${s.id}-${d.getTime()}`, mavzu: s.mavzu, bolim: s.bolim,
      sana: `${OYLAR[d.getMonth()]} ${d.getDate()}`,
      javob: HARF[t], togriJavob: HARF[s.togri], togri: togrimi,
    });
  });

  const keyingi = () => {
    i++;
    if (i >= toplam.length) {
      $('mashq').hidden = true;
      $('tugadi').hidden = false;
      $('tugadi-matn').textContent = `You answered ${togrilar} of ${toplam.length} questions correctly. Your answers are on the "My results" page and were saved only in this browser.`;
      $('fokus-progress-matn').textContent = `${toplam.length} / ${toplam.length}`;
      $('tugadi-h').focus();
      return;
    }
    chiz();
    $('savol').focus();
  };
  $('keyingi').addEventListener('click', keyingi);
  $('otkazish').addEventListener('click', keyingi);
  $('qayta').addEventListener('click', () => {
    i = 0; togrilar = 0;
    $('tugadi').hidden = true;
    $('mashq').hidden = false;
    chiz();
    $('savol').focus();
  });

  $('savol').setAttribute('tabindex', '-1');
  chiz();
</script>

<style>
  /* DS PR 5c (2026-11-23): artifakt v15 `SatSavol`. Savol kartasi, izoh va yakun zich shishada,
     variant harfi doirada (Sora), tanlangan harf sat-blue-fill. Ichma-ich blur yo'q. */
  .ustun, .tugadi { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-4); }
  .savol-karta, .izoh, .tugadi {
    background: var(--color-sat-glass-strong);
    border: var(--border-width-1) solid var(--color-sat-glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glass);
    color: var(--color-sat-text);
    -webkit-backdrop-filter: var(--glass-backdrop);
    backdrop-filter: var(--glass-backdrop);
  }
  .savol-karta { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); }
  .karta-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .pill {
    align-self: flex-start; margin: 0;
    font-size: var(--text-caption-size); line-height: var(--text-caption-lh);
    font-weight: var(--font-weight-semibold); letter-spacing: 0.04em;
    color: var(--color-sat-text-muted); font-variant-numeric: tabular-nums;
  }
  .bayroq {
    min-height: var(--size-touch-min); padding: 0 var(--space-3);
    border: var(--border-width-1) solid transparent; border-radius: var(--radius-full);
    background: transparent; color: var(--color-sat-text-muted);
    font: inherit; font-weight: var(--font-weight-semibold); font-size: var(--text-small-size);
    display: flex; align-items: center; gap: var(--space-2); cursor: pointer;
  }
  .bayroq svg { color: var(--color-sat-blue-text); }
  .bayroq[aria-pressed='true'] { border-color: var(--color-sat-line-strong); color: var(--color-sat-text); }
  .bayroq[aria-pressed='true'] svg { fill: currentColor; }
  @media (hover: hover) and (pointer: fine) { .bayroq:hover { border-color: var(--color-sat-blue); } }
  #savol {
    margin: 0; max-width: var(--size-measure);
    font-size: var(--font-size-body-d); line-height: var(--line-height-body-d); font-weight: var(--font-weight-medium);
  }
  #savol:focus { outline: none; }
  /* R&W matni (passage): savoldan oldin, alohida sirtda; bo'sh joy chizig'i (______) o'qilishi uchun keng qator oralig'i */
  .parcha {
    margin: 0; max-width: var(--size-measure); padding: var(--space-4) var(--space-5);
    /* DS taqiqi: chap rangli chiziq yo'q. Passage alohida tekis sirtda, to'liq ingichka chegara bilan */
    border: var(--border-width-1) solid var(--color-sat-line); border-radius: var(--radius-md); background: var(--color-sat-sunken); color: var(--color-sat-text);
    font-size: var(--font-size-body-d); line-height: var(--line-height-body-d);
  }
  .parcha[hidden] { display: none; }

  .variantlar { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .variant {
    position: relative;
    min-height: var(--size-touch-min); padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border-radius: var(--radius-lg);
    background: transparent; border: var(--border-width-1) solid var(--color-sat-line-strong);
    font-size: var(--text-body-size); font-weight: var(--font-weight-medium); font-variant-numeric: tabular-nums;
    display: flex; align-items: center; gap: var(--space-3);
    cursor: pointer;
  }
  .variant input { position: absolute; opacity: 0; pointer-events: none; }
  .variant:has(input:focus-visible) { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
  @media (hover: hover) and (pointer: fine) { .variant:hover { border-color: var(--color-sat-blue); } }
  .harf {
    width: 36px; height: 36px; flex: none; border-radius: var(--radius-full);
    display: grid; place-items: center;
    border: var(--border-width-1) solid var(--color-sat-line-strong);
    font-family: var(--font-sat); font-size: var(--text-small-size); font-weight: var(--font-weight-semibold); line-height: 1;
    background: transparent; color: var(--color-sat-text);
  }
  .v-matn { flex: 1; }
  .variant:has(input:checked) { border-color: var(--color-sat-blue-fill); box-shadow: inset 0 0 0 1px var(--color-sat-blue-fill); }
  .variant:has(input:checked) .harf { background: var(--color-sat-blue-fill); border-color: var(--color-sat-blue-fill); color: var(--color-sat-on-blue-fill); }
  .variant:has(input:disabled) { cursor: default; }
  @media (hover: hover) and (pointer: fine) { .variant:has(input:disabled):hover { border-color: var(--color-sat-line-strong); } }
  .variant.togri, .variant.togri:has(input:checked) { background: var(--color-success-subtle); border-color: var(--color-success-ui); box-shadow: inset 0 0 0 1px var(--color-success-ui); }
  @media (hover: hover) and (pointer: fine) { .variant.togri:hover { border-color: var(--color-success-ui); } }
  .variant.togri .harf, .variant.togri:has(input:checked) .harf { background: transparent; border: var(--border-width-2) solid var(--color-success-ui); color: var(--color-success-text); }
  .variant.xato, .variant.xato:has(input:checked) { border: var(--border-width-1) dashed var(--color-sat-text); box-shadow: none; text-decoration: line-through; }
  @media (hover: hover) and (pointer: fine) { .variant.xato:hover { border-color: var(--color-sat-text); } }
  .variant.xato .harf, .variant.xato:has(input:checked) .harf { background: var(--color-sat-text); border-color: var(--color-sat-text); color: var(--color-sat-surface); }
  .belgi { display: none; flex: none; }
  .variant.togri .belgi-togri { display: block; color: var(--color-success-text); }
  .variant.xato .belgi-xato { display: block; color: var(--color-sat-text); }

  .izoh { padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .izoh[hidden] { display: none; }
  .izoh p { margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .izoh.izoh-togri { border-color: var(--color-success-ui); }
  .izoh-sarlavha { font-family: var(--font-sat); font-size: var(--font-size-body-d); line-height: var(--line-height-body-d); font-weight: var(--font-weight-semibold); }
  .izoh.izoh-togri .izoh-sarlavha { color: var(--color-success-text); }

  .pastki { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .pastki .t-tugma { margin-left: auto; }

  .tugadi { padding: var(--space-6); }
  .tugadi[hidden] { display: none; }
  .tugadi h1 { margin: 0; font-family: var(--font-sat); font-size: var(--text-sat-h2-size); line-height: var(--text-sat-h2-lh); letter-spacing: var(--text-sat-h2-ls); font-weight: var(--font-weight-semibold); }
  .tugadi h1:focus { outline: none; }
  .tugadi-matn { margin: 0; color: var(--color-sat-text-muted); max-width: var(--size-measure); }
  .tugadi-tugmalar { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .savol-karta, .izoh, .tugadi { background: var(--color-sat-surface); }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .savol-karta, .izoh, .tugadi {
      background: var(--color-sat-surface); border-color: var(--color-sat-line-strong);
      -webkit-backdrop-filter: none; backdrop-filter: none;
    }
    .izoh.izoh-togri { border-color: var(--color-success-ui); }
  }

  @media (max-width: 640px) {
    .savol-karta, .tugadi { padding: var(--space-5) var(--space-4); }
    .izoh { padding: var(--space-4); }
    #savol { font-size: var(--text-body-size); }
    .parcha { padding: var(--space-3) var(--space-4); font-size: var(--text-body-size); }
  }
</style>
