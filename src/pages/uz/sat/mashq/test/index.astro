---
// Mashq testi: savol ekrani. Dizayn: Tayanch-SAT-dizayn.md, "Mashq" ekrani.
// Javoblar faqat shu brauzerda saqlanadi (tayanch:sat-javoblar). Ball hisoblanmaydi.
import SatFokus from '../../../../../layouts/SatFokus.astro';
import DesmosHavola from '../../../../../components/sat/DesmosHavola.astro';
import { savollar } from '../../../../../data/satNamuna';
import { yol } from '../../../../../lib/yol';
---
<SatFokus
  title="Practice test · SAT"
  description="A short sample practice set in Reading & Writing and Math: an explanation right after each answer."
  ustki={`${savollar[0].bolim} · Sample`}
  nomi={savollar[0].mavzu}
  progressNomi="Practice progress"
  yol={['Practice']}
>
  <DesmosHavola slot="amal" id="desmos" hidden={savollar[0].bolim !== 'Math'} />

  <script type="application/json" id="savollar-data" set:html={JSON.stringify(savollar)} />

  <div class="ustun" id="mashq">
    <section class="savol-karta" aria-labelledby="savol">
      <div class="karta-bosh">
        <span class="pill" id="savol-raqam">Question 1</span>
        <button type="button" class="bayroq" id="bayroq" aria-pressed="false">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4" /><path d="M4 4h13l-2 4 2 4H4" /></svg>
          Come back later
        </button>
      </div>
      <h1 id="savol">{savollar[0].matn}</h1>
      <fieldset class="variantlar" id="variantlar" aria-labelledby="savol">
        {savollar[0].variantlar.map((v, i) => (
          <label class="variant">
            <input type="radio" name="javob" value={i} />
            <span class="harf">{'ABCD'[i]}</span>
            <span class="v-matn">{v}</span>
            <svg class="belgi belgi-togri" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
            <svg class="belgi belgi-xato" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </label>
        ))}
      </fieldset>
    </section>

    <section class="izoh" id="izoh" aria-live="polite" hidden>
      <p class="izoh-sarlavha" id="izoh-sarlavha"></p>
      <p id="izoh-matn"></p>
    </section>

    <div class="pastki">
      <button type="button" class="matn-tugma" id="otkazish">Skip</button>
      <button type="button" class="katta asosiy" id="tekshir" disabled>Check</button>
      <button type="button" class="katta qora" id="keyingi" hidden>Next question</button>
    </div>
  </div>

  <section class="tugadi" id="tugadi" aria-labelledby="tugadi-h" hidden>
    <p class="pill">Set complete</p>
    <h1 id="tugadi-h" tabindex="-1">Sample set complete</h1>
    <p class="tugadi-matn" id="tugadi-matn"></p>
    <div class="tugadi-tugmalar">
      <a class="katta asosiy" href={yol('/uz/sat/vosita/natijalar/')}>See results</a>
      <button type="button" class="katta ikkinchi" id="qayta">Start over</button>
    </div>
  </section>
</SatFokus>

<script>
  import { KALIT_JAVOBLAR, type Savol, type Javob } from '../../../../../data/satNamuna';

  const hamma: Savol[] = JSON.parse(document.getElementById('savollar-data')!.textContent || '[]');
  const tanlanganMavzular = new URLSearchParams(location.search).get('mavzular')?.split('|').filter(Boolean) ?? [];
  const filtrlangan = hamma.filter((s) => tanlanganMavzular.includes(s.mavzu));
  const toplam = filtrlangan.length > 0 ? filtrlangan : hamma;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const OYLAR = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const HARF = 'ABCD';

  let i = 0;
  let tekshirildi = false;
  let togrilar = 0;

  const saqla = (j: Javob) => {
    try {
      const eski: Javob[] = JSON.parse(localStorage.getItem(KALIT_JAVOBLAR) || '[]');
      eski.unshift(j);
      localStorage.setItem(KALIT_JAVOBLAR, JSON.stringify(eski.slice(0, 500)));
    } catch { /* brauzer saqlashga ruxsat bermadi */ }
  };

  const progress = (bajarildi: number) => {
    const foiz = Math.round((bajarildi / toplam.length) * 100);
    $('fokus-progress-toldirish').style.width = foiz + '%';
    const p = $('fokus-progress');
    p.setAttribute('aria-valuemax', String(toplam.length));
    p.setAttribute('aria-valuenow', String(bajarildi));
    $('fokus-progress-matn').textContent = `${Math.min(i + 1, toplam.length)} / ${toplam.length}`;
  };

  const tanlangan = () => {
    const r = document.querySelector<HTMLInputElement>('input[name="javob"]:checked');
    return r ? Number(r.value) : null;
  };

  const chiz = () => {
    const s = toplam[i];
    tekshirildi = false;
    $('fokus-ustki').textContent = `${s.bolim} · Sample`;
    $('desmos').hidden = s.bolim !== 'Math';
    $('fokus-nomi').textContent = s.mavzu;
    $('savol-raqam').textContent = `Question ${i + 1}`;
    $('savol').textContent = s.matn;
    const bayroq = $('bayroq');
    bayroq.setAttribute('aria-pressed', 'false');
    document.querySelectorAll<HTMLLabelElement>('.variant').forEach((l, k) => {
      const inp = l.querySelector('input')!;
      inp.checked = false;
      inp.disabled = false;
      l.querySelector('.v-matn')!.textContent = s.variantlar[k];
      l.classList.remove('togri', 'xato');
    });
    $<HTMLButtonElement>('tekshir').disabled = true;
    $('tekshir').hidden = false;
    $('keyingi').hidden = true;
    $('otkazish').hidden = false;
    $('izoh').hidden = true;
    progress(i);
  };

  document.getElementById('variantlar')!.addEventListener('change', () => {
    if (!tekshirildi) $<HTMLButtonElement>('tekshir').disabled = tanlangan() === null;
  });

  $('bayroq').addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLElement;
    b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
  });

  $('tekshir').addEventListener('click', () => {
    const t = tanlangan();
    if (t === null) return;
    const s = toplam[i];
    tekshirildi = true;
    const togrimi = t === s.togri;
    if (togrimi) togrilar++;
    document.querySelectorAll<HTMLLabelElement>('.variant').forEach((l, k) => {
      l.querySelector('input')!.disabled = true;
      if (k === s.togri) l.classList.add('togri');
      else if (k === t) l.classList.add('xato');
    });
    const izoh = $('izoh');
    izoh.classList.toggle('izoh-togri', togrimi);
    $('izoh-sarlavha').textContent = togrimi ? `Correct! Answer: ${HARF[s.togri]}` : `Not this time. Correct answer: ${HARF[s.togri]}`;
    $('izoh-matn').textContent = s.izoh;
    izoh.hidden = false;
    $('tekshir').hidden = true;
    $('otkazish').hidden = true;
    $('keyingi').hidden = false;
    $('keyingi').focus();
    progress(i + 1);
    const d = new Date();
    saqla({
      id: `${s.id}-${d.getTime()}`, mavzu: s.mavzu, bolim: s.bolim,
      sana: `${OYLAR[d.getMonth()]} ${d.getDate()}`,
      javob: HARF[t], togriJavob: HARF[s.togri], togri: togrimi,
    });
  });

  const keyingi = () => {
    i++;
    if (i >= toplam.length) {
      $('mashq').hidden = true;
      $('tugadi').hidden = false;
      $('tugadi-matn').textContent = `You answered ${togrilar} of ${toplam.length} questions correctly. Your answers are on the "My results" page and were saved only in this browser.`;
      $('fokus-progress-matn').textContent = `${toplam.length} / ${toplam.length}`;
      $('tugadi-h').focus();
      return;
    }
    chiz();
    $('savol').focus();
  };
  $('keyingi').addEventListener('click', keyingi);
  $('otkazish').addEventListener('click', keyingi);
  $('qayta').addEventListener('click', () => {
    i = 0; togrilar = 0;
    $('tugadi').hidden = true;
    $('mashq').hidden = false;
    chiz();
    $('savol').focus();
  });

  $('savol').setAttribute('tabindex', '-1');
  chiz();
</script>

<style>

  .ustun, .tugadi { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--b-5); }
  .savol-karta {
    background: var(--fon); border-radius: var(--r-katta);
    box-shadow: var(--soya);
    padding: 36px;
    display: flex; flex-direction: column; gap: var(--b-6);
  }
  :global([data-mavzu='qorongi']) .savol-karta { background: var(--fon-ikkinchi); }
  .karta-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--b-3); }
  .pill { align-self: flex-start; padding: 4px 12px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); font-size: var(--matn-mayda); font-weight: 700; }
  .bayroq {
    min-height: 44px; padding: 0 14px;
    border: 0; border-radius: var(--r-toliq);
    background: transparent; color: var(--matn-ikkinchi);
    font: inherit; font-weight: 700; font-size: var(--matn-kichik);
    display: flex; align-items: center; gap: var(--b-2); cursor: pointer;
  }
  .bayroq svg { color: var(--rang-havola); }
  .bayroq[aria-pressed='true'] svg { fill: currentColor; }
  .bayroq:hover { background: var(--fon-ikkinchi); }
  #savol { font-size: 24px; line-height: 1.4; font-weight: 700; }
  #savol:focus { outline: none; }

  .variantlar { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--b-3); }
  .variant {
    position: relative;
    min-height: 60px; padding: 10px 18px;
    border-radius: var(--r-orta);
    background: var(--fon); border: 2px solid var(--chiziq-kuchli);
    font-size: 17px; font-weight: 600;
    display: flex; align-items: center; gap: var(--b-4);
    cursor: pointer;
  }
  .variant input { position: absolute; opacity: 0; pointer-events: none; }
  .variant:has(input:focus-visible) { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }
  .variant:hover { border-color: var(--rang-asosiy); }
  .harf {
    width: 32px; height: 32px; flex: none; border-radius: var(--r-logo);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--matn-kichik); font-weight: 800;
    background: var(--fon-ikkinchi); color: var(--matn-ikkinchi);
  }
  .v-matn { flex: 1; }
  .variant:has(input:checked) { border-color: var(--rang-asosiy); }
  .variant:has(input:checked) .harf, .variant.togri .harf { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  .variant:has(input:disabled) { cursor: default; }
  .variant:has(input:disabled):hover { border-color: var(--chiziq-kuchli); }
  .variant.togri, .variant.togri:hover { background: var(--rang-asosiy-och); border-color: var(--rang-asosiy); }
  .variant.xato, .variant.xato:hover { background: var(--fon-ikkinchi); border: 2px dashed var(--matn); text-decoration: line-through; }
  .variant.xato .harf { background: var(--matn); color: var(--fon); }
  .belgi { display: none; flex: none; }
  .variant.togri .belgi-togri { display: block; color: var(--rang-havola); }
  .variant.xato .belgi-xato { display: block; color: var(--matn); }

  .izoh {
    border-radius: var(--r-katta); padding: 24px 28px;
    background: var(--qora); color: var(--qora-matn);
    border: 1px solid var(--qora-chiziq);
    display: flex; flex-direction: column; gap: var(--b-2);
  }
  .izoh[hidden] { display: none; }
  .izoh.izoh-togri { background: var(--rang-asosiy); border-color: var(--rang-asosiy); }
  .izoh-sarlavha { font-size: 18px; font-weight: 800; }

  .pastki { display: flex; align-items: center; justify-content: space-between; gap: var(--b-3); }
  .matn-tugma {
    min-height: 52px; padding: 0 22px;
    border: 0; border-radius: var(--r-toliq);
    background: transparent; color: var(--matn-ikkinchi);
    font: inherit; font-weight: 700; font-size: 15px; cursor: pointer;
  }
  .matn-tugma:hover { background: var(--sirt-ikkinchi); }
  .katta {
    min-height: var(--control-height-md); padding: 0 32px; margin-left: auto;
    border: 0; border-radius: var(--r-toliq);
    font: inherit; font-weight: 800; font-size: 16px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; text-decoration: none;
  }
  .katta[hidden] { display: none; }
  .katta.asosiy { background: var(--btn-primary-bg); color: var(--btn-primary-text); }
  .katta.asosiy:hover { background: var(--btn-primary-bg-hover); }
  .katta.asosiy:disabled { background: var(--sirt-ikkinchi); color: var(--matn-sust); cursor: not-allowed; }
  .katta.qora { background: var(--matn); color: var(--fon); }
  .katta.ikkinchi { background: var(--sirt-ikkinchi); color: var(--matn); margin-left: 0; }

  .tugadi { background: var(--fon); border-radius: var(--r-katta); box-shadow: var(--soya); padding: 36px; }
  .tugadi[hidden] { display: none; }
  .tugadi h1 { font-size: 32px; font-weight: 900; }
  .tugadi h1:focus { outline: none; }
  .tugadi-matn { font-size: 17px; color: var(--matn-ikkinchi); }
  .tugadi-tugmalar { display: flex; flex-wrap: wrap; gap: var(--b-3); }
  .tugadi-tugmalar .katta { margin-left: 0; }

  @media (max-width: 640px) {
    .savol-karta, .tugadi { padding: 22px; }
    #savol { font-size: 20px; }
  }
</style>
