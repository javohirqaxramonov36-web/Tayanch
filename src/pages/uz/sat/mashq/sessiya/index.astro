---
// Mashq sessiyasi (P08): Savol bankida tanlangan savollarni birma-bir yechish. Fokus qolipi, yon panelsiz.
// Manzil: /uz/sat/mashq/sessiya/?id=<session_id> (javoblar URL da emas). Server: get_session, submit_answer,
// finish_session, finish_course_mini_test, add_to_review va review_queue (RLS).
// Taymersiz rejim: "Check" → natija va tushuntirish darhol. Taymerli rejim: javoblar oxirigacha o'zgaradi, "Finish"
// yoki vaqt tugaganda yuboriladi. Kurs mini-testida taymer yo'q, javoblar faqat Finish'da birga yuboriladi.
// Sof mantiq: src/lib/sat/sessiya.ts. Dev mock: src/lib/sat/sessiyaMock.ts (?mock=..., faqat DEV).
import SatFokus from '../../../../../layouts/SatFokus.astro';
import SavolUslub from '../../../../../components/sat/SavolUslub.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import DesmosHavola from '../../../../../components/sat/DesmosHavola.astro';
import XabarDialog from '../../../../../components/sat/XabarDialog.astro';
import { ichkiSahifa } from '../../../../../data/satSahifalar';
import { yol } from '../../../../../lib/yol';
import { kursNatijaHavolalari, kursPreview } from '../../../../../lib/sat/kursKatalog';

const sahifa = ichkiSahifa('mashq/sessiya/');
const bankUrl = yol('/uz/sat/mashq/bank/');
const kursYollar = kursPreview ? JSON.stringify(kursNatijaHavolalari()) : undefined;
const IK = {
  xarita: ['M4 4h6v6H4z', 'M14 4h6v6h-6z', 'M4 14h6v6H4z', 'M14 14h6v6h-6z'],
  soat: ['M12 7v5l3 2', 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z'],
  saqla: ['M6 3h12v18l-6-4-6 4z'],
};
---
<SatFokus
  title={`${sahifa.nomi} · SAT`}
  description={sahifa.tavsif}
  ustki="Practice"
  nomi={sahifa.nomi}
  progressNomi="Questions answered"
  yol={['Practice', 'Question bank']}
  yopish={{ href: bankUrl, yorliq: 'Leave the session and go to the question bank. Your progress is saved.' }}
  liftPastki={false}
>
  <div slot="amal" class="amallar">
    <div class="taymer" id="taymer" hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{IK.soat.map((d) => <path d={d} />)}</svg>
      <span class="sr-only">Time left:</span>
      <span class="taymer-vaqt" id="taymer-vaqt" role="timer">--:--</span>
    </div>
    <button type="button" class="kichik-tugma kulrang" id="taymer-yashir" aria-pressed="false" aria-controls="taymer" hidden>Hide timer</button>
    <button type="button" class="kichik-tugma kulrang" id="saqla-tugma" aria-pressed="false" hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">{IK.saqla.map((d) => <path d={d} />)}</svg>
      Save question
    </button>
    <DesmosHavola id="desmos" hidden />
    <button type="button" class="kichik-tugma kulrang" id="xarita-och" aria-haspopup="dialog" hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">{IK.xarita.map((d) => <path d={d} />)}</svg>
      Questions
    </button>
  </div>

  <SavolUslub />
  <div class="sessiya" id="sessiya" data-bank-url={bankUrl} data-kirish-url={yol('/uz/hisob/kirish/')} data-rejalar-url={yol('/uz/hisob/profil/')} data-kurs-yollar={kursYollar}
    data-redo-url={yol('/uz/sat/vosita/takrorlash/')} data-natijalar-url={yol('/uz/sat/vosita/natijalar/')}>
    {import.meta.env.DEV && <p class="pill-namuna" id="namuna-pill" hidden>Sample · dev mock</p>}

    <section class="holat-karta" id="yuklash" role="status">
      <p class="holat-sarlavha">Loading your session…</p>
    </section>

    <section class="holat-karta" id="xabar" hidden aria-labelledby="xabar-h">
      <h1 id="xabar-h" class="holat-sarlavha" tabindex="-1"></h1>
      <p id="xabar-matn" class="holat-matn"></p>
      <div class="holat-amal">
        <button type="button" class="asosiy-tugma" id="xabar-qayta" hidden>Try again</button>
        <a class="asosiy-tugma" id="xabar-havola" hidden></a>
      </div>
    </section>

    <section id="savol-ekran" hidden aria-label="Question">
      <h1 class="sr-only" id="savol-h" tabindex="-1">Question</h1>
      <div class="saqlash" id="saqlash" hidden>
        <p id="saqlash-matn"></p>
        <button type="button" class="matn-tugma" id="saqlash-qayta" hidden>Retry now</button>
        <a class="matn-tugma" id="saqlash-havola" hidden>See plans</a>
      </div>
      <div id="savol-joy"></div>
      <div class="sessiya-pastki" id="pastki">
        <button type="button" class="ikkinchi-tugma" id="oldingi">Back</button>
        <button type="button" class="ikkinchi-tugma" id="otkaz">Skip</button>
        <button type="button" class="asosiy-tugma" id="tekshir" disabled aria-describedby="tekshir-izoh">Check</button>
        <button type="button" class="asosiy-tugma" id="keyingi">Next</button>
      </div>
      <p class="sr-only" id="tekshir-izoh">Choose an answer first.</p>
    </section>

    <section class="holat-karta" id="yuborish" hidden aria-labelledby="yuborish-h">
      <h1 id="yuborish-h" class="holat-sarlavha" tabindex="-1">Submitting your answers…</h1>
      <p id="yuborish-matn" class="holat-matn" role="status"></p>
      <div class="holat-amal">
        <button type="button" class="asosiy-tugma" id="yuborish-qayta" hidden>Try again</button>
        <a class="ikkinchi-tugma" id="yuborish-rejalar" hidden>See plans</a>
      </div>
    </section>

    <section id="natija" hidden aria-labelledby="natija-h"></section>

    <ManbaBlok
      manbalar={sahifa.manbalar}
      tekshirilgan="2026-11-05"
      keyingiTekshiruv="2026-12-05"
      tekshirilmagan={sahifa.tekshirilmagan}
    />
  </div>

  <dialog class="xarita" id="xarita" aria-labelledby="xarita-h">
    <div class="xarita-ichi">
      <div class="xarita-bosh">
        <h2 id="xarita-h">Questions</h2>
        <button type="button" class="yopish-tugma" id="xarita-yop" aria-label="Close">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <p class="xarita-izoh" id="xarita-izoh"></p>
      <p class="xarita-ogoh" id="xarita-ogoh" hidden></p>
      <ol class="xarita-panjara" id="xarita-panjara"></ol>
      <ul class="xarita-belgi" aria-label="Legend">
        <li><span class="namuna-katak answered" aria-hidden="true"></span> Answered</li>
        <li><span class="namuna-katak" aria-hidden="true"></span> Not answered</li>
        <li><span class="namuna-katak skipped" aria-hidden="true"></span> Skipped</li>
        <li><span class="namuna-katak flag" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><path d="M4 22V4" /><path d="M4 4h13l-2 4 2 4H4" /></svg></span> Marked for review</li>
      </ul>
      <div class="xarita-amal">
        <button type="button" class="ikkinchi-tugma" id="xarita-qayt">Back to questions</button>
        <button type="button" class="asosiy-tugma" id="yakunla">Finish session</button>
      </div>
    </div>
  </dialog>

  <XabarDialog />

  <div class="sr-only" id="taymer-elon" aria-live="assertive" aria-atomic="true"></div>
  <div class="sr-only" id="elon" aria-live="polite" aria-atomic="true"></div>
</SatFokus>

<script>
  import { hisobMijoz } from '../../../../../lib/hisob';
  import { SESSIYA_KALITI } from '../../../../../lib/savolBanki';
  import { savolChiz, type SavolKorsatkich } from '../../../../../lib/sat/savolKorsatkich';
  import { BOSH_HOLAT, type SavolHolati } from '../../../../../lib/sat/savolTuri';
  import { sprTekshir } from '../../../../../lib/sat/sprFormat';
  import { miniTestOtdimi } from '../../../../../lib/sat/kursNatija';
  import { xavfsizMatn } from '../../../../../lib/sat/xavfsizMatn';
  import type { XabarApi } from '../../../../../lib/sat/xabar';
  import { xabarDialogUlash, supabaseXabarApi } from '../../../../../lib/sat/xabarDialog';
  import {
    MAHALLIY_KALIT, mahalliyniTekshir, komponentSavoli, togriMatn, qolganMs, chegaraOtildi, vaqtMatni, davomiylikMatni,
    xarita, xaritaYorliq, navbatgaQosh, keyingiUrinishMs, sessiyaXatosi, idTogrimi, hisobot, SABABLAR, sababTogrimi,
    type Mahalliy, type SessiyaApi, type SessiyaJavob, type ServerSavol, type YuborJavob, type NatijaBand,
  } from '../../../../../lib/sat/sessiya';

  const $ = <T extends HTMLElement = HTMLElement>(i: string) => document.getElementById(i) as T;
  const ildiz = $('sessiya');
  const BANK = ildiz.dataset.bankUrl!;
  const kursYollar: Record<string, { mavzu: string; keyingi?: string }> = JSON.parse(ildiz.dataset.kursYollar ?? '{}');
  const SINF = { flag: ['M4 22V4', 'M4 4h13l-2 4 2 4H4'], togri: ['M5 12l5 5L20 7'], xato: ['M6 6l12 12M18 6L6 18'] };

  // ---------- Holat ----------
  let api: SessiyaApi | null = null;
  // P24 Report: ochiq xabari bor savollar (serverdan, RLS: faqat o'ziniki). Dialog boshla() da ulanadi.
  let xabarApi: XabarApi | null = null;
  let xabarDialog: ReturnType<typeof xabarDialogUlash> | null = null;
  const xabarlar = new Set<string>();
  let id = '';
  let S: SessiyaJavob | null = null;
  let m: Mahalliy = mahalliyniTekshir(null);
  let soatOlingan = 0;
  const javoblar = new Map<string, YuborJavob & { answer: string }>();
  const review = new Map<string, string | null>();
  // Saqlangan savollar (public.bookmarks): Xato daftaridagi "Saved" ro'yxati bilan bir manba.
  const saqlangan = new Set<string>();
  let saqlashBand = false;
  const ui = new Map<string, SavolHolati>();
  const rasmlar = new Map<string, string | null>();
  let korsatkich: SavolKorsatkich | null = null;
  let korsatilgan = -1;
  let ekran: 'yuklash' | 'xabar' | 'savol' | 'yuborish' | 'natija' = 'yuklash';
  let kirgan = performance.now();
  let oldingiQolgan: number | null = null;
  let yuborilmoqda = false;
  let qaytaTaymer: ReturnType<typeof setTimeout> | undefined;
  let yakunVadasi: Promise<void> | null = null;
  let sinxronTaymer: ReturnType<typeof setTimeout> | undefined;

  const taymerli = () => S?.mode === 'timed';
  const miniTest = () => S?.mode === 'mini_test';
  const yakundaYuboriladi = () => taymerli() || miniTest();
  const savollar = (): ServerSavol[] => S?.questions ?? [];
  const joriySavol = () => savollar()[m.joriy];
  const kursSavoli = (q: ServerSavol) => !!S?.course || ('course_question' in q && q.course_question === true);
  const navbatda = (qid: string) => m.navbat.some((b) => b.qid === qid);
  const javobBor = (qid: string) => javoblar.has(qid);
  const yakunlangan = () => !!S?.finished_at;

  // ---------- Xotira ----------
  function saqla() {
    try { localStorage.setItem(MAHALLIY_KALIT(id), JSON.stringify(m)); } catch { /* xotira yopiq: sahifa ochiq turguncha ishlaydi */ }
  }
  function oqiMahalliy(): Mahalliy {
    try { return mahalliyniTekshir(localStorage.getItem(MAHALLIY_KALIT(id))); } catch { return mahalliyniTekshir(null); }
  }
  /** Boshqa tab yozgan holatni qo'shadi; joriy savol shu tabniki bo'lib qoladi. */
  function birlashtir(boshqa: Mahalliy) {
    const vaqt = { ...boshqa.vaqt };
    for (const [k, v] of Object.entries(m.vaqt)) vaqt[k] = Math.max(v, vaqt[k] ?? 0);
    m = { ...boshqa, joriy: m.joriy, vaqt };
    qoralamaniTozala();
  }

  function qoralamaniTozala() {
    if (!miniTest()) return;
    const toza: Mahalliy['qoralama'] = {};
    for (const q of savollar()) {
      const qiymat = m.qoralama[q.id];
      if (typeof qiymat !== 'string') continue;
      if (q.format === 'spr') {
        const natija = sprTekshir(qiymat, true);
        if (natija.ok) toza[q.id] = natija.qiymat;
      } else if (q.options?.some(({ key }) => key === qiymat)) {
        toza[q.id] = qiymat;
      }
    }
    m.qoralama = toza;
  }

  // ---------- Vaqt ----------
  /** Joriy savolda sarflangan vaqtni yig'adi (tab ko'rinib turganda; taymersiz rejimda javobgacha). */
  function vaqtYig() {
    const q = joriySavol();
    const hozir = performance.now();
    if (q && ekran === 'savol' && !document.hidden && (yakundaYuboriladi() || !(javobBor(q.id) || navbatda(q.id)))) {
      m.vaqt[q.id] = Math.round((m.vaqt[q.id] ?? 0) + (hozir - kirgan));
    }
    kirgan = hozir;
  }

  // ---------- Ekranlar ----------
  function korsat(e: typeof ekran) {
    ekran = e;
    $('yuklash').hidden = e !== 'yuklash';
    $('xabar').hidden = e !== 'xabar';
    $('savol-ekran').hidden = e !== 'savol';
    $('yuborish').hidden = e !== 'yuborish';
    $('natija').hidden = e !== 'natija';
    const ishda = e === 'savol';
    $('xarita-och').hidden = !ishda;
    $('saqla-tugma').hidden = !ishda;
    desmosYangila();
    $('taymer').hidden = !(ishda && taymerli()) || $('taymer-yashir').getAttribute('aria-pressed') === 'true';
    $('taymer-yashir').hidden = !(ishda && taymerli());
    // .jarayon da display: flex bor, shuning uchun hidden emas, style
    $('fokus-progress').parentElement!.style.display = ishda || e === 'yuborish' ? '' : 'none';
  }

  function xabarKorsat(sarlavha: string, matn: string, amal?: { qayta?: boolean; havola?: { href: string; matn: string } }) {
    $('xabar-h').textContent = sarlavha;
    $('xabar-matn').textContent = matn;
    $('xabar-qayta').hidden = !amal?.qayta;
    const h = $<HTMLAnchorElement>('xabar-havola');
    h.hidden = !amal?.havola;
    if (amal?.havola) { h.href = amal.havola.href; h.textContent = amal.havola.matn; }
    korsat('xabar');
    $('xabar-h').focus();
  }

  function elon(matn: string) {
    const e = $('elon');
    e.textContent = '';
    setTimeout(() => (e.textContent = matn), 50);
  }

  function saqlaChiz() {
    const q = joriySavol();
    $('saqla-tugma').setAttribute('aria-pressed', String(!!q && saqlangan.has(q.id)));
  }

  $('saqla-tugma').addEventListener('click', async () => {
    const q = joriySavol();
    if (!q || !api || saqlashBand) return;
    const t = $('saqla-tugma');
    const on = !saqlangan.has(q.id);
    saqlashBand = true;
    t.setAttribute('aria-busy', 'true');
    if (on) saqlangan.add(q.id); else saqlangan.delete(q.id);
    saqlaChiz();
    try {
      await api.saqla(q.id, on);
      elon(on ? 'Question saved. Find it under Saved in your mistake log.' : 'Removed from saved questions.');
    } catch {
      if (on) saqlangan.delete(q.id); else saqlangan.add(q.id);
      saqlaChiz();
      elon("Couldn't update saved questions. Try again.");
    } finally {
      saqlashBand = false;
      t.removeAttribute('aria-busy');
    }
  });

  function kirishHavolasi() {
    return `${ildiz.dataset.kirishUrl}?keyin=${encodeURIComponent(location.pathname + location.search)}`;
  }

  function xatoEkrani(e: unknown) {
    const tur = sessiyaXatosi(e);
    if (tur === 'kirish') return xabarKorsat('Sign in to continue', 'Practice sessions are saved to your Tayanch account.', { havola: { href: kirishHavolasi(), matn: 'Sign in' } });
    if (tur === 'topilmadi') return xabarKorsat('Session not found', 'This session does not exist or belongs to another account. Start a new one from the question bank.', { havola: { href: BANK, matn: 'Go to the question bank' } });
    if (tur === 'savol' && (e as { message?: string })?.message === 'question_unavailable') {
      return xabarKorsat('A question is unavailable', 'A question in this session is no longer available.');
    }
    if (tur === 'tarmoq') return xabarKorsat("Couldn't reach the server", 'Check your connection and try again. Your answers on this device are kept.', { qayta: true });
    return xabarKorsat('Something went wrong', 'The session did not load. Try again in a moment.', { qayta: true });
  }

  // ---------- Progress ----------
  function progressChiz() {
    const n = savollar().length;
    const javob = xarita(savollar(), m, new Set(javoblar.keys()), yakundaYuboriladi()).filter((b) => b.holat === 'answered' || b.holat === 'pending').length;
    const p = $('fokus-progress');
    p.setAttribute('aria-valuemax', String(n));
    p.setAttribute('aria-valuenow', String(javob));
    p.setAttribute('aria-valuetext', `${javob} of ${n} answered`);
    $('fokus-progress-toldirish').style.width = n ? `${(javob / n) * 100}%` : '0';
    $('fokus-progress-matn').textContent = ekran === 'savol' ? `${m.joriy + 1} / ${n}` : `${javob} / ${n}`;
  }

  // ---------- Report (P24) ----------
  function xabarOch(qid: string, nomi: string, ochuvchi: HTMLElement, keyin?: () => void) {
    xabarDialog?.och({
      qid, nomi, ochuvchi, sessiya: idTogrimi(id) ? id : null, yuborilgan: xabarlar.has(qid),
      onYuborildi: (q) => {
        xabarlar.add(q);
        if (ekran === 'savol' && joriySavol()?.id === q) yangila();
        keyin?.();
      },
    });
  }

  // ---------- Savol ----------
  function holatOl(q: ServerSavol): SavolHolati {
    const h = ui.get(q.id) ?? { ...BOSH_HOLAT, ochirilgan: [] };
    const j = javoblar.get(q.id);
    const band = m.navbat.find((b) => b.qid === q.id);
    const javob = j?.answer ?? band?.javob ?? (yakundaYuboriladi() ? m.qoralama[q.id] : undefined);
    const qulf = !yakundaYuboriladi() && (!!j || !!band);
    return {
      ...h,
      javobBerilgan: qulf,
      tanlangan: q.format === 'mcq' ? (javob ?? (miniTest() ? null : h.tanlangan)) : null,
      sprQiymat: q.format === 'spr' ? (javob ?? (miniTest() ? '' : h.sprQiymat ?? '')) : undefined,
      belgilangan: m.belgilar.includes(q.id),
      xabarlangan: xabarlar.has(q.id),
      natija: j && !yakundaYuboriladi() ? { togrimi: j.is_correct, togriJavob: togriMatn(j.correct), izoh: j.explanation } : null,
    };
  }

  function uiYangila(q: ServerSavol, ozgar: Partial<SavolHolati>) {
    ui.set(q.id, { ...holatOl(q), ...ozgar });
  }

  const sprMaydon = () => $('savol-joy').querySelector<HTMLInputElement>('.sk-spr-maydon');
  const sprXatosiBormi = () => miniTest() && korsatilgan === m.joriy && korsatkich?.sprXatosiBormi();

  /** Yakunda yuboriladigan rejimda: SPR maydonida yozilgan, lekin "Save answer" bosilmagan qiymat ham qoralamaga tushadi. */
  function sprQoralamaOl() {
    const q = joriySavol();
    if (!q || q.format !== 'spr' || !yakundaYuboriladi() || korsatilgan !== m.joriy) return;
    const inp = sprMaydon();
    if (!inp) return;
    const t = sprTekshir(inp.value, kursSavoli(q));
    if (t.ok) {
      m.qoralama[q.id] = t.qiymat;
      if (miniTest()) m.otkazilgan = m.otkazilgan.filter((x) => x !== q.id);
    } else if (miniTest() || !inp.value.trim()) {
      delete m.qoralama[q.id];
    }
  }

  // Desmos havolasi faqat savol ekranida va Math savolida (P29). Tashqi skript yo'q, holat saqlanmaydi.
  function desmosYangila() {
    $('desmos').hidden = !(ekran === 'savol' && joriySavol()?.section === 'math');
  }

  async function savolChizish(fokus: boolean) {
    const q = joriySavol();
    if (!q) return;
    desmosYangila();
    let rasm: string | null = null;
    if (q.figure) {
      if (!rasmlar.has(q.figure.path)) rasmlar.set(q.figure.path, await api!.rasm(q.figure.path).catch(() => null));
      rasm = rasmlar.get(q.figure.path) ?? null;
    }
    korsatkich?.yoq();
    const joy = $('savol-joy');
    korsatkich = savolChiz(joy, {
      savol: komponentSavoli(q, rasm),
      kurs: kursSavoli(q),
      holat: holatOl(q),
      rejim: yakundaYuboriladi() ? 'taymerli' : 'taymersiz',
      raqam: m.joriy + 1,
      onSelect: (k) => {
        uiYangila(q, { tanlangan: k });
        if (yakundaYuboriladi()) {
          if (k) m.qoralama[q.id] = k; else delete m.qoralama[q.id];
          m.otkazilgan = m.otkazilgan.filter((x) => x !== q.id);
          saqla();
        }
        yangila();
      },
      onSubmitSpr: (v) => {
        uiYangila(q, { sprQiymat: v });
        if (yakundaYuboriladi()) {
          m.qoralama[q.id] = v;
          m.otkazilgan = m.otkazilgan.filter((x) => x !== q.id);
          saqla();
          elon('Answer saved. You can change it until you finish.');
          yangila();
        } else {
          tekshir(v);
        }
      },
      onFlag: (b) => {
        m.belgilar = b ? [...new Set([...m.belgilar, q.id])] : m.belgilar.filter((x) => x !== q.id);
        saqla();
        yangila();
      },
      onEliminate: (k, on) => {
        const h = holatOl(q);
        uiYangila(q, { ochirilgan: on ? [...new Set([...h.ochirilgan, k])] : h.ochirilgan.filter((x) => x !== k) });
        yangila();
      },
      onReport: xabarDialog ? (t) => xabarOch(q.id, `Question ${m.joriy + 1}`, t) : undefined,
    });
    korsatilgan = m.joriy;
    saqlaChiz();
    $('savol-h').textContent = `Question ${m.joriy + 1} of ${savollar().length}`;
    tugmalarChiz();
    progressChiz();
    if (fokus) {
      await korsatkich.tayyor;
      $('savol-h').focus();
    }
  }

  /** Mavjud komponentni yangilaydi (qayta chizmasdan). */
  function yangila() {
    const q = joriySavol();
    if (!q || !korsatkich) return;
    korsatkich.yangila(holatOl(q));
    tugmalarChiz();
    progressChiz();
  }

  function tugmalarChiz() {
    const q = joriySavol();
    if (!q) return;
    const n = savollar().length;
    const oxirgi = m.joriy === n - 1;
    const h = holatOl(q);
    const tayyor = javobBor(q.id) || navbatda(q.id);
    const oldingi = $<HTMLButtonElement>('oldingi');
    const otkaz = $<HTMLButtonElement>('otkaz');
    const tekshirT = $<HTMLButtonElement>('tekshir');
    const keyingi = $<HTMLButtonElement>('keyingi');
    oldingi.disabled = m.joriy === 0;
    if (yakundaYuboriladi()) {
      otkaz.hidden = !(miniTest() && q.format === 'spr');
      tekshirT.hidden = true;
      keyingi.hidden = false;
      keyingi.textContent = oxirgi ? 'Review and finish' : 'Next';
    } else {
      otkaz.hidden = tayyor;
      tekshirT.hidden = tayyor || q.format === 'spr';
      tekshirT.disabled = !h.tanlangan;
      $('tekshir-izoh').textContent = h.tanlangan ? '' : 'Choose an answer first.';
      keyingi.hidden = !tayyor;
      keyingi.textContent = oxirgi ? 'See results' : 'Next';
    }
  }

  function otish(i: number, fokus = true) {
    if (!S || i < 0 || i >= savollar().length || sprXatosiBormi()) return;
    sprQoralamaOl();
    vaqtYig();
    m.joriy = i;
    saqla();
    savolChizish(fokus);
  }

  // ---------- Javob yuborish (navbat) ----------
  function tekshir(javob: string) {
    const q = joriySavol();
    if (!q || yakundaYuboriladi() || javobBor(q.id) || navbatda(q.id) || yakunlangan()) return;
    vaqtYig();
    m.navbat = navbatgaQosh(m.navbat, { qid: q.id, javob, timeMs: m.vaqt[q.id] ?? 0 });
    m.otkazilgan = m.otkazilgan.filter((x) => x !== q.id);
    saqla();
    yangila();
    $<HTMLButtonElement>('keyingi').focus();
    navbatniYubor();
  }

  function saqlashHolati(matn: string | null, o: { qayta?: boolean; rejalar?: boolean } = {}) {
    const quti = $('saqlash');
    // Ko'rinadigan quti yashirin holatdan chiqadi (live region emas): muhim xabar umumiy polite hududda e'lon qilinadi
    // (qayta urinish soniyasi o'zgarganda takror aytilmaydi)
    const raqamsiz = (x: string) => x.replace(/\d+/g, '');
    if (matn && raqamsiz(matn) !== raqamsiz($('saqlash-matn').textContent ?? '') && (o.qayta || o.rejalar || !/…$/.test(matn))) elon(matn);
    quti.hidden = !matn;
    $('saqlash-matn').textContent = matn ?? '';
    $('saqlash-qayta').hidden = !o.qayta;
    const h = $<HTMLAnchorElement>('saqlash-havola');
    h.hidden = !o.rejalar;
    h.href = ildiz.dataset.rejalarUrl!;
    $<HTMLAnchorElement>('yuborish-rejalar').href = h.href;
    if (ekran === 'yuborish') {
      $('yuborish-matn').textContent = matn ?? '';
      $('yuborish-qayta').hidden = !o.qayta;
      $('yuborish-rejalar').hidden = !o.rejalar;
    }
  }

  /** Navbatdagi javoblarni ketma-ket yuboradi. Tarmoq xatosida keyinroq qayta urinadi. */
  async function navbatniYubor(): Promise<void> {
    if (yuborilmoqda || !api) return;
    clearTimeout(qaytaTaymer);
    yuborilmoqda = true;
    try {
      while (m.navbat.length) {
        const b = m.navbat[0];
        if (ekran === 'savol') saqlashHolati(m.navbat.length > 1 ? `Saving ${m.navbat.length} answers…` : 'Checking your answer…');
        try {
          const javob = await api.yubor(id, b.qid, b.javob, b.timeMs);
          const oldin = javoblar.get(b.qid);
          javoblar.set(b.qid, { ...javob, answer: javob.already_answered ? (oldin?.answer ?? b.javob) : b.javob });
          if (!javob.is_correct && !review.has(b.qid)) review.set(b.qid, null);
          if (javob.already_answered) {
            if (oldin?.answer !== b.javob) elon('This question was already answered, maybe in another tab. The saved answer is shown.');
            sinxronla();
          }
          m.navbat = m.navbat.filter((x) => x.qid !== b.qid);
          saqla();
        } catch (e) {
          const tur = sessiyaXatosi(e);
          if (tur === 'tarmoq' || tur === 'boshqa') {
            b.urinish++;
            saqla();
            const kut = keyingiUrinishMs(b.urinish - 1);
            saqlashHolati(tur === 'tarmoq'
              ? (m.yakunlanmoqda
                ? `No connection. Your answers are saved on this device and will be sent when you're back online. Retrying in ${Math.round(kut / 1000)} s.`
                : `Not saved: no connection. Retrying in ${Math.round(kut / 1000)} s.`)
              : `Not saved: the server didn't respond. Retrying in ${Math.round(kut / 1000)} s.`, { qayta: true });
            qaytaTaymer = setTimeout(() => navbatniYubor(), kut);
            return;
          }
          m.navbat = m.navbat.filter((x) => x.qid !== b.qid);
          saqla();
          if (tur === 'kirish') { xatoEkrani(e); return; }
          if (tur === 'kvota') {
            saqlashHolati("You've reached today's answer limit, so this answer wasn't checked.", { rejalar: true });
            m.navbat = [];
            saqla();
            yangila();
            return;
          }
          if (tur === 'yakunlangan') {
            saqlashHolati('This session has already finished.');
            await qaytaYukla();
            return;
          }
          saqlashHolati("This answer couldn't be saved. Try again.");
        }
        if (ekran === 'savol') {
          yangila();
          // Natija pastki panel ostida qolmasin
          if (joriySavol()?.id === b.qid) $('savol-joy').querySelector('.sk-natija:not([hidden])')?.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }
      }
      saqlashHolati(null);
    } finally {
      yuborilmoqda = false;
    }
  }

  // ---------- Yakunlash ----------
  function yakunla(sabab: 'tugma' | 'vaqt' | 'davom'): Promise<void> {
    if (sabab === 'tugma' && ekran === 'savol' && miniTest()) {
      if (xaritaDialog.open) xaritaYop();
      if (sprXatosiBormi()) return Promise.resolve();
    }
    yakunVadasi ??= (async () => {
      if (ekran === 'savol') { sprQoralamaOl(); vaqtYig(); }
      if (xaritaDialog.open) xaritaYop();
      if (taymerli()) {
        for (const q of savollar()) {
          const j = m.qoralama[q.id];
          if (j && !javobBor(q.id) && !navbatda(q.id)) m.navbat = navbatgaQosh(m.navbat, { qid: q.id, javob: j, timeMs: m.vaqt[q.id] ?? 0 });
        }
      }
      m.yakunlanmoqda = true;
      saqla();
      korsat('yuborish');
      $('yuborish-h').textContent = sabab === 'vaqt' ? "Time's up. Submitting your answers…" : 'Submitting your answers…';
      $('yuborish-h').focus();
      saqlashHolati(null);
      progressChiz();
      if (miniTest()) {
        const javoblar = savollar().flatMap(({ id: qid }) => {
          const answer = m.qoralama[qid];
          return answer ? [{ question_id: qid, answer, time_ms: Math.min(m.vaqt[qid] ?? 0, 2147483647) }] : [];
        });
        try {
          serverdanOl(await api!.miniTestniYakunla(id, javoblar));
          holatgaOt(false);
        } catch (e) {
          const tur = sessiyaXatosi(e);
          if (tur === 'tarmoq' || tur === 'boshqa') {
            saqlashHolati("Your answers are saved on this device. Try again when you're connected.", { qayta: true });
          } else if (tur === 'kvota') {
            saqlashHolati("This submission exceeds your answer limit. Your answers are saved on this device.", { qayta: true, rejalar: true });
          } else {
            xatoEkrani(e);
          }
        }
        return;
      }
      // Navbat bo'shaguncha (tarmoq qaytishini kutadi)
      while (m.navbat.length) {
        await navbatniYubor();
        if (ekran === 'xabar') return;
        if (m.navbat.length) await new Promise<void>((r) => { const t = () => { removeEventListener('online', t); r(); }; addEventListener('online', t); setTimeout(t, keyingiUrinishMs(m.navbat[0]?.urinish ?? 0)); });
      }
      for (let urinish = 0; ; urinish++) {
        try {
          await api!.yakunla(id);
          break;
        } catch (e) {
          const tur = sessiyaXatosi(e);
          if (tur !== 'tarmoq' && tur !== 'boshqa') { xatoEkrani(e); return; }
          const kut = keyingiUrinishMs(urinish);
          saqlashHolati(`No connection. Your answers are saved on this device. Retrying in ${Math.round(kut / 1000)} s.`, { qayta: true });
          await new Promise((r) => setTimeout(r, kut));
        }
      }
      await qaytaYukla();
    })().finally(() => { yakunVadasi = null; });
    return yakunVadasi;
  }

  function yakunlashniSora() {
    if (miniTest()) {
      if (sprXatosiBormi()) return;
      sprQoralamaOl();
    }
    const xb = xarita(savollar(), m, new Set(javoblar.keys()), yakundaYuboriladi());
    const qolgan = xb.filter((b) => b.holat === 'unanswered' || b.holat === 'skipped').length;
    if (!qolgan) return yakunla('tugma');
    xaritaOch(qolgan === 1 ? '1 question has no answer. Finish anyway?' : `${qolgan} questions have no answer. Finish anyway?`);
  }

  // ---------- Xarita (dialog) ----------
  const xaritaDialog = $<HTMLDialogElement>('xarita');
  let xaritaOchuvchi: HTMLElement | null = null;

  function xaritaChiz(ogoh?: string) {
    const xb = xarita(savollar(), m, new Set(javoblar.keys()), yakundaYuboriladi());
    const javob = xb.filter((b) => b.holat === 'answered').length;
    const belgi = xb.filter((b) => b.belgilangan).length;
    $('xarita-izoh').textContent = `${javob} of ${xb.length} answered${belgi ? ` · ${belgi} marked for review` : ''}`;
    $('xarita-ogoh').hidden = !ogoh;
    $('xarita-ogoh').textContent = ogoh ?? '';
    const ol = $('xarita-panjara');
    ol.replaceChildren(...xb.map((b) => {
      const li = document.createElement('li');
      const t = document.createElement('button');
      t.type = 'button';
      t.className = `katak ${b.holat}`;
      t.textContent = String(b.raqam);
      t.setAttribute('aria-label', xaritaYorliq(b));
      if (b.joriy) t.setAttribute('aria-current', 'step');
      if (b.belgilangan) t.append(ikonka(SINF.flag, 'katak-bayroq', true));
      t.addEventListener('click', () => { xaritaYop(); otish(b.raqam - 1); });
      li.append(t);
      return li;
    }));
  }
  function xaritaOch(ogoh?: string) {
    if (sprXatosiBormi()) return;
    xaritaOchuvchi = document.activeElement as HTMLElement | null;
    sprQoralamaOl();
    xaritaChiz(ogoh);
    xaritaDialog.showModal();
    // Ogohlantirishda xavfsiz tugma fokusda (Enter tasodifan yakunlab yubormasin)
    (ogoh ? $('xarita-qayt') : xaritaDialog.querySelector<HTMLElement>('[aria-current]') ?? $('xarita-yop')).focus();
  }
  // Mantiq yopuvchi funksiyada: ilova brauzerida skriptli close() "close" hodisasini bermasligi mumkin.
  function xaritaYop() {
    if (xaritaDialog.open) xaritaDialog.close();
    // Ochuvchi tugma fokus olmagan bo'lsa (Safari bosishda tugmaga fokus bermaydi) xarita tugmasiga qaytadi
    const qayt = xaritaOchuvchi && xaritaOchuvchi !== document.body && xaritaOchuvchi.isConnected ? xaritaOchuvchi : $('xarita-och');
    if (ekran === 'savol') qayt.focus();
    xaritaOchuvchi = null;
  }
  xaritaDialog.addEventListener('cancel', (e) => { e.preventDefault(); xaritaYop(); });
  xaritaDialog.addEventListener('click', (e) => { if (e.target === xaritaDialog) xaritaYop(); });
  $('xarita-yop').addEventListener('click', xaritaYop);
  $('xarita-qayt').addEventListener('click', xaritaYop);
  $('xarita-och').addEventListener('click', () => xaritaOch());
  $('yakunla').addEventListener('click', () => yakunla('tugma'));

  function ikonka(yollar: string[], sinf: string, toldir = false): SVGSVGElement {
    const NS = 'http://www.w3.org/2000/svg';
    const s = document.createElementNS(NS, 'svg');
    s.setAttribute('aria-hidden', 'true');
    s.setAttribute('viewBox', '0 0 24 24');
    s.setAttribute('width', '14');
    s.setAttribute('height', '14');
    s.setAttribute('fill', toldir ? 'currentColor' : 'none');
    s.setAttribute('stroke', 'currentColor');
    s.setAttribute('stroke-width', '2.5');
    s.setAttribute('stroke-linecap', 'round');
    s.setAttribute('stroke-linejoin', 'round');
    s.setAttribute('class', sinf);
    for (const d of yollar) { const p = document.createElementNS(NS, 'path'); p.setAttribute('d', d); s.append(p); }
    return s;
  }

  // ---------- Taymer ----------
  function taymerTik() {
    if (!S || !taymerli() || !S.time_limit_ms || ekran === 'natija' || yakunlangan()) return;
    const qolgan = qolganMs({ startedAt: S.started_at, limitMs: S.time_limit_ms, serverNow: S.server_now, soatOlingan }, Date.now());
    $('taymer-vaqt').textContent = vaqtMatni(qolgan);
    $('taymer').classList.toggle('kam', qolgan <= 300_000);
    const ch = chegaraOtildi(oldingiQolgan, qolgan);
    oldingiQolgan = qolgan;
    if (ch === 'besh') $('taymer-elon').textContent = '5 minutes left.';
    if (ch === 'bir') $('taymer-elon').textContent = '1 minute left.';
    if (ch === 'tugadi' || qolgan <= 0) {
      $('taymer-elon').textContent = "Time's up. Your answers are being submitted.";
      if (ekran === 'savol' || ekran === 'yuklash') yakunla('vaqt');
    }
  }
  $('taymer-yashir').addEventListener('click', () => {
    const t = $('taymer-yashir');
    const yashir = t.getAttribute('aria-pressed') !== 'true';
    t.setAttribute('aria-pressed', String(yashir));
    t.textContent = yashir ? 'Show timer' : 'Hide timer';
    $('taymer').hidden = yashir;
  });

  setInterval(() => {
    if (ekran !== 'savol') return;
    vaqtYig();
    taymerTik();
  }, 1000);
  setInterval(() => { if (ekran === 'savol') saqla(); }, 5000);

  // ---------- Natija ----------
  function el<K extends keyof HTMLElementTagNameMap>(teg: K, sinf?: string, matn?: string): HTMLElementTagNameMap[K] {
    const e = document.createElement(teg);
    if (sinf) e.className = sinf;
    if (matn !== undefined) e.textContent = matn;
    return e;
  }

  function redoBoshqaruv(b: NatijaBand, xatomi: boolean): HTMLElement {
    const qid = b.savol.id;
    const quti = el('div', 'redo');
    const holat = el('p', 'redo-holat');
    holat.setAttribute('role', 'status');
    const tugma = el('button', 'kichik-tugma kulrang');
    tugma.type = 'button';
    const sabab = xatomi ? sababGuruh(b) : null;
    const chiz = () => {
      const bor = review.has(qid);
      holat.replaceChildren();
      if (bor) holat.append(ikonka(SINF.togri, 'redo-ikonka'), document.createTextNode(xatomi ? 'In your redo list (added automatically)' : 'In your redo list'));
      tugma.textContent = bor ? 'Remove from redo list' : 'Add to redo list';
      holat.hidden = !bor;
      if (sabab) sabab.hidden = !bor;
    };
    tugma.addEventListener('click', async () => {
      if (tugma.getAttribute('aria-busy') === 'true') return;
      tugma.setAttribute('aria-busy', 'true');
      const bor = review.has(qid);
      try {
        if (bor) { await api!.navbatdanOl(qid); review.delete(qid); }
        else { await api!.navbatgaQosh(qid); review.set(qid, null); }
        chiz();
        elon(bor ? 'Removed from your redo list.' : 'Added to your redo list.');
      } catch {
        holat.hidden = false;
        holat.textContent = "Couldn't save. Check your connection and try again.";
      }
      tugma.removeAttribute('aria-busy');
    });
    chiz();
    quti.append(holat, tugma);
    if (sabab) quti.append(sabab);
    return quti;
  }

  function sababGuruh(b: NatijaBand): HTMLElement {
    const qid = b.savol.id;
    const f = el('div', 'sabab');
    f.setAttribute('role', 'group');
    const yorliq = el('p', 'sabab-yorliq', 'Why did you miss it?');
    yorliq.id = `sabab-${b.raqam}`;
    f.setAttribute('aria-labelledby', yorliq.id);
    const chiplar = el('div', 'sabab-chiplar');
    const izoh = el('p', 'sabab-izoh');
    izoh.setAttribute('role', 'status');
    const tugmalar = SABABLAR.map((s) => {
      const t = el('button', 'chip', s.nomi);
      t.type = 'button';
      t.dataset.sabab = s.kalit;
      t.addEventListener('click', async () => {
        const oldin = review.get(qid) ?? null;
        const yangi = oldin === s.kalit ? null : s.kalit;
        review.set(qid, yangi);
        chiz();
        try {
          await api!.sabab(qid, yangi);
          izoh.textContent = yangi ? `Saved: ${s.nomi.toLowerCase()}.` : 'Tag removed.';
        } catch {
          review.set(qid, oldin);
          chiz();
          izoh.textContent = "Couldn't save the tag. Try again.";
        }
      });
      return t;
    });
    const chiz = () => tugmalar.forEach((t) => t.setAttribute('aria-pressed', String(review.get(qid) === t.dataset.sabab)));
    chiz();
    chiplar.append(...tugmalar);
    f.append(yorliq, chiplar, izoh);
    return f;
  }

  function natijaKarta(b: NatijaBand, tur: 'xato' | 'otkaz' | 'togri'): HTMLElement {
    const a = el('article', 'natija-karta');
    const h = el('h3', 'natija-karta-h');
    h.append(
      ikonka(tur === 'togri' ? SINF.togri : SINF.xato, 'natija-ikonka'),
      document.createTextNode(`Question ${b.raqam}`),
    );
    const meta = el('p', 'natija-meta', `${b.savol.section === 'rw' ? 'Reading and Writing' : 'Math'} · ${b.savol.skill}`);
    const stem = el('div', 'natija-stem sk-matn');
    xavfsizMatn(b.savol.stem, stem);
    a.append(h, meta, stem);
    const yechim = b.natija ?? S?.skipped_solutions?.find((r) => r.question_id === b.savol.id);
    if (yechim) {
      const j = el('p', 'natija-javob');
      const siz = el('span', '', b.natija ? `Your answer: ${b.natija.answer}` : 'Not answered.');
      const togri = el('span', '', `Correct answer: ${togriMatn(yechim.correct)}`);
      j.append(siz, togri);
      a.append(j);
      if (yechim.explanation) {
        const d = el('details', 'izoh-ochiq');
        const s = el('summary', '', 'Explanation');
        const ich = el('div', 'izoh-matn sk-matn');
        xavfsizMatn(yechim.explanation, ich);
        d.append(s, ich);
        a.append(d);
      }
    } else {
      a.append(el('p', 'natija-javob', 'Not answered. The correct answer is shown only after you answer.'));
    }
    a.append(redoBoshqaruv(b, tur === 'xato'));
    if (xabarDialog) {
      const t = el('button', 'kichik-tugma kulrang natija-xabar');
      t.type = 'button';
      const yoz = () => {
        const bor = xabarlar.has(b.savol.id);
        t.textContent = bor ? 'Reported' : 'Report a problem';
        t.setAttribute('aria-label', bor ? `Reported: question ${b.raqam}` : `Report a problem with question ${b.raqam}`);
      };
      yoz();
      t.addEventListener('click', () => xabarOch(b.savol.id, `Question ${b.raqam}`, t, yoz));
      a.append(t);
    }
    return a;
  }

  function natijaChiz() {
    if (!S) return;
    const h = hisobot(S);
    const quti = $('natija');
    const sarlavha = el('h1', 'natija-h', 'Session results');
    sarlavha.id = 'natija-h';
    sarlavha.tabIndex = -1;
    const nom = miniTest() ? 'Topic mini-test' : S.course ? 'Course practice' : taymerli() ? 'Timed practice' : 'Untimed practice';
    const rejim = el('p', 'lead', `${nom} · ${h.jami} ${h.jami === 1 ? 'question' : 'questions'}`);

    const statlar = el('dl', 'statlar');
    const stat = (dt: string, dd: string, izoh?: string) => {
      const d = el('div', 'stat');
      d.append(el('dt', '', dt), el('dd', 'stat-son', dd));
      if (izoh) d.append(el('dd', 'stat-izoh', izoh));
      statlar.append(d);
    };
    stat('Score', `${h.foiz}%`, `${h.togri} of ${h.jami} correct`);
    stat('Time', davomiylikMatni(S.elapsed_ms ?? h.vaqtMs), S.course ? 'From start to submission' : 'Spent on answered questions');
    stat('Answered', `${h.javobBerilgan} / ${h.jami}`, h.jami - h.javobBerilgan ? `${h.jami - h.javobBerilgan} skipped` : 'None skipped');
    const miniHolat = miniTest() ? (miniTestOtdimi(h.togri, h.jami) ? 'Passed' : 'Not yet passed') : null;
    if (miniHolat) {
      stat('Mini-test result', miniHolat, 'The passing score is 70%.');
      if (S.topic_passed && miniHolat !== 'Passed') stat('Topic status', 'Passed on an earlier attempt');
    }

    const skill = el('section', 'natija-bolim');
    skill.setAttribute('aria-labelledby', 'skill-h');
    const sh = el('h2', '', 'By skill');
    sh.id = 'skill-h';
    const jadval = el('table', 'skill-jadval');
    const thead = el('thead');
    const tr0 = el('tr');
    for (const t of ['Skill', 'Correct']) { const th = el('th', '', t); th.scope = 'col'; tr0.append(th); }
    thead.append(tr0);
    const tbody = el('tbody');
    for (const s of h.skilllar) {
      const tr = el('tr');
      const th = el('th');
      th.scope = 'row';
      th.append(el('span', 'skill-nomi', s.skill), el('span', 'skill-bolim', s.section === 'rw' ? 'Reading and Writing' : 'Math'));
      const td = el('td');
      const bar = el('span', 'skill-bar');
      bar.setAttribute('aria-hidden', 'true');
      const ich = el('span', 'skill-bar-ich');
      ich.style.width = `${s.jami ? (s.togri / s.jami) * 100 : 0}%`;
      bar.append(ich);
      td.append(el('span', 'skill-son', `${s.togri} / ${s.jami}`), bar);
      tr.append(th, td);
      tbody.append(tr);
    }
    jadval.append(thead, tbody);
    skill.append(sh, jadval);

    const bolim = (idh: string, nom: string, izoh: string | null, bandlar: NatijaBand[], tur: 'xato' | 'otkaz' | 'togri', yopiq = false) => {
      const s = el('section', 'natija-bolim');
      s.setAttribute('aria-labelledby', idh);
      const hh = el('h2', '', `${nom} (${bandlar.length})`);
      hh.id = idh;
      if (yopiq) {
        const d = el('details', 'yigma');
        const sm = el('summary');
        sm.append(hh);
        d.append(sm);
        if (izoh) d.append(el('p', 'bolim-izoh', izoh));
        d.append(...bandlar.map((b) => natijaKarta(b, tur)));
        s.append(d);
      } else {
        s.append(hh);
        if (izoh) s.append(el('p', 'bolim-izoh', izoh));
        s.append(...bandlar.map((b) => natijaKarta(b, tur)));
      }
      return s;
    };

    const amal = el('div', 'natija-amal');
    const kursYoli = S.course && Object.hasOwn(kursYollar, S.course.topic_id) ? kursYollar[S.course.topic_id] : undefined;
    const orqaga = el('a', 'asosiy-tugma', kursYoli ? 'Back to the topic' : 'Back to the question bank');
    orqaga.href = kursYoli?.mavzu ?? BANK;
    amal.append(orqaga);
    if (kursYoli?.keyingi) {
      const keyingi = el('a', 'ikkinchi-tugma', 'Next topic');
      keyingi.href = kursYoli.keyingi;
      amal.append(keyingi);
    }
    if (S.course) {
      const redo = el('a', 'ikkinchi-tugma', 'Go to your redo list');
      redo.href = ildiz.dataset.redoUrl!;
      const natijalar = el('a', 'ikkinchi-tugma', 'View your analytics');
      natijalar.href = ildiz.dataset.natijalarUrl!;
      amal.append(redo, natijalar);
    }

    quti.replaceChildren(sarlavha, rejim, statlar, skill);
    if (h.xatolar.length) quti.append(bolim('xato-h', 'Mistakes', 'Wrong answers go to your redo list automatically. Tag why you missed each one to see patterns later.', h.xatolar, 'xato'));
    else quti.append(el('p', 'bolim-izoh', h.javobBerilgan ? 'No mistakes in this session.' : 'You did not answer any questions in this session.'));
    if (h.otkazilgan.length) quti.append(bolim('otkaz-h', 'Skipped', null, h.otkazilgan, 'otkaz'));
    if (h.togrilar.length) quti.append(bolim('togri-h', 'Correct answers', 'Add a question to your redo list if you guessed or want to practice it again.', h.togrilar, 'togri', true));
    quti.append(amal);
    return S.course ? `${h.togri} of ${h.jami} correct. ${h.otkazilgan.length} skipped.${miniHolat ? ` ${miniHolat}.` : ''}` : undefined;
  }

  // ---------- Yuklash va sinxronlash ----------
  function serverdanOl(j: SessiyaJavob) {
    S = j;
    qoralamaniTozala();
    if (j.course) {
      $('fokus-ustki').textContent = miniTest() ? 'Topic mini-test' : 'Course practice';
      if ((import.meta.env.DEV || import.meta.env.MODE === 'kurs-preview') && ildiz.dataset.kursYollar) {
        void import('../../../../../styles/kurs.css');
        document.body.classList.add('kurs-sessiya');
        const yopish = document.querySelector<HTMLAnchorElement>('.fokus-bosh .yopish');
        const mavzuYoli = Object.hasOwn(kursYollar, j.course.topic_id) ? kursYollar[j.course.topic_id].mavzu : undefined;
        if (yopish && mavzuYoli) {
          yopish.href = mavzuYoli;
          yopish.setAttribute('aria-label', 'Leave the session and go to the topic');
        }
      }
    }
    soatOlingan = Date.now();
    javoblar.clear();
    for (const r of j.results ?? []) {
      javoblar.set(r.question_id, { is_correct: r.is_correct, correct: r.correct, explanation: r.explanation, already_answered: true, answer: r.answer });
    }
    saqlangan.clear();
    for (const q of j.questions) if (q.bookmarked) saqlangan.add(q.id);
    review.clear();
    for (const r of j.review ?? []) review.set(r.question_id, sababTogrimi(r.reason_tag) ? r.reason_tag : null);
    // Serverda javobi borlari navbatdan chiqadi
    m.navbat = m.navbat.filter((b) => !javoblar.has(b.qid));
    if (m.joriy >= j.questions.length) m.joriy = 0;
  }

  async function qaytaYukla() {
    try {
      serverdanOl(await api!.ol(id));
    } catch (e) {
      return xatoEkrani(e);
    }
    holatgaOt(false);
  }

  /** Boshqa tab yoki qurilmadagi o'zgarishni oladi (javoblar, yakun). Kvota sarflamaydi. */
  function sinxronla() {
    clearTimeout(sinxronTaymer);
    sinxronTaymer = setTimeout(async () => {
      if (!api || !S || ekran === 'yuklash' || ekran === 'xabar' || yakunVadasi) return;
      try {
        const j = await api.ol(id);
        const edi = yakunlangan();
        serverdanOl(j);
        if (!edi && yakunlangan()) return holatgaOt(true);
        if (ekran === 'savol') yangila();
      } catch { /* keyingi safar */ }
    }, 400);
  }

  function holatgaOt(fokus: boolean) {
    if (!S) return;
    if (!S.questions.length) {
      return xabarKorsat('This session has no questions', 'Start a new session from the question bank.', { havola: { href: BANK, matn: 'Go to the question bank' } });
    }
    if (yakunlangan() && !m.navbat.length) {
      korsatkich?.yoq();
      korsatkich = null;
      korsat('natija');
      const natijaEloni = natijaChiz();
      progressChiz();
      try { localStorage.removeItem(MAHALLIY_KALIT(id)); } catch { /* */ }
      $('natija-h').focus();
      if (natijaEloni) elon(natijaEloni);
      return;
    }
    if (m.yakunlanmoqda || yakunlangan()) { yakunla('davom'); return; }
    if (taymerli() && S.time_limit_ms) {
      const qolgan = qolganMs({ startedAt: S.started_at, limitMs: S.time_limit_ms, serverNow: S.server_now, soatOlingan }, Date.now());
      if (qolgan <= 0) { korsat('savol'); yakunla('vaqt'); return; }
    }
    const edi = ekran;
    korsat('savol');
    kirgan = performance.now();
    if (edi !== 'savol' || korsatilgan !== m.joriy) savolChizish(fokus);
    else yangila();
    taymerTik();
    if (m.navbat.length) navbatniYubor();
  }

  // ---------- Hodisalar ----------
  $('tekshir').addEventListener('click', () => {
    const q = joriySavol();
    const t = q && holatOl(q).tanlangan;
    if (t) tekshir(t);
  });
  $('keyingi').addEventListener('click', () => {
    if (m.joriy >= savollar().length - 1) return yakunlashniSora();
    otish(m.joriy + 1);
  });
  $('oldingi').addEventListener('click', () => otish(m.joriy - 1));
  $('otkaz').addEventListener('click', () => {
    const q = joriySavol();
    if (!q) return;
    if (miniTest()) {
      const inp = sprMaydon();
      if (inp) {
        inp.value = '';
        inp.dispatchEvent(new Event('input'));
      }
      delete m.qoralama[q.id];
    }
    if (!m.otkazilgan.includes(q.id)) m.otkazilgan.push(q.id);
    saqla();
    if (m.joriy >= savollar().length - 1) { progressChiz(); return yakunlashniSora(); }
    otish(m.joriy + 1);
  });
  $('saqlash-qayta').addEventListener('click', () => { m.navbat.forEach((b) => (b.urinish = 0)); navbatniYubor(); });
  $('yuborish-qayta').addEventListener('click', () => {
    if (miniTest()) { yakunla('davom'); return; }
    m.navbat.forEach((b) => (b.urinish = 0));
    dispatchEvent(new Event('online'));
  });
  $('xabar-qayta').addEventListener('click', () => { korsat('yuklash'); boshla(); });

  addEventListener('online', () => {
    if (miniTest() && m.yakunlanmoqda && !yakunlangan()) { yakunla('davom'); return; }
    if (m.navbat.length) navbatniYubor();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { vaqtYig(); saqla(); return; }
    kirgan = performance.now();
    taymerTik();
    sinxronla();
  });
  addEventListener('pagehide', () => { if (ekran === 'savol') { sprQoralamaOl(); vaqtYig(); saqla(); } });
  addEventListener('storage', (e) => {
    if (!id || e.key !== MAHALLIY_KALIT(id) || !e.newValue) return;
    birlashtir(mahalliyniTekshir(e.newValue));
    if (ekran === 'savol') yangila();
    sinxronla();
  });

  // ---------- Boshlash ----------
  async function boshla() {
    const p = new URLSearchParams(location.search);
    // Faqat dev: ?mock=oddiy|taymerli|qisqa|uzilish|kvota|xato (&tozala=1). Prod build'da bu shox va mock moduli yo'q.
    if (import.meta.env.DEV && p.get('mock')) {
      const { mockApi, MOCK_ID, mockTozala } = await import('../../../../../lib/sat/sessiyaMock');
      const tur = p.get('mock') as keyof typeof MOCK_ID;
      if (p.get('tozala')) { mockTozala(); p.delete('tozala'); }
      if (!p.get('id')) p.set('id', MOCK_ID[tur] ?? MOCK_ID.oddiy);
      history.replaceState(null, '', `${location.pathname}?${p}`);
      api = mockApi(tur);
      const { mockXabarApi } = await import('../../../../../lib/sat/xabarMock');
      xabarApi = mockXabarApi();
      const pill = document.getElementById('namuna-pill');
      if (pill) pill.hidden = false;
    }
    id = new URLSearchParams(location.search).get('id') ?? '';
    if (!idTogrimi(id)) {
      return xabarKorsat('No session selected', 'Choose skills in the question bank and start a session there.', { havola: { href: BANK, matn: 'Go to the question bank' } });
    }
    if (!api) {
      const c = hisobMijoz();
      if (!c) return xabarKorsat('Accounts are not available yet', 'Practice sessions need a Tayanch account, and sign-in is not set up on this copy of the site.', { havola: { href: BANK, matn: 'Go to the question bank' } });
      const { data } = await c.auth.getSession();
      if (!data.session) return xabarKorsat('Sign in to continue', 'Practice sessions are saved to your Tayanch account.', { havola: { href: kirishHavolasi(), matn: 'Sign in' } });
      api = haqiqiyApi(c);
      xabarApi = supabaseXabarApi(c);
    }
    if (xabarApi) xabarDialog = xabarDialogUlash(xabarApi);
    // Savol bankidagi start javobi kerak emas: sessiya doim serverdan (get_session) olinadi.
    try { sessionStorage.removeItem(SESSIYA_KALITI); } catch { /* */ }
    m = oqiMahalliy();
    try {
      serverdanOl(await api.ol(id));
    } catch (e) {
      return xatoEkrani(e);
    }
    // Ochiq xabarlar: olinmasa ham sessiya ishlaydi (tugma "Report" bo'lib qoladi, takror server tomonda rad etiladi).
    if (xabarApi && S) {
      try {
        for (const q of await xabarApi.ochiqlar(S.questions.map((x) => x.id))) xabarlar.add(q);
      } catch { /* */ }
    }
    saqla();
    holatgaOt(false);
  }

  function haqiqiyApi(c: NonNullable<ReturnType<typeof hisobMijoz>>): SessiyaApi {
    const rpc = async <T,>(nom: string, args: Record<string, unknown>): Promise<T> => {
      const { data, error } = await c.rpc(nom, args);
      if (error) throw error;
      return data as T;
    };
    return {
      ol: (sid) => rpc<SessiyaJavob>('get_session', { p_session: sid }),
      yubor: (sid, qid, javob, t) => rpc<YuborJavob>('submit_answer', { p_session: sid, p_question: qid, p_answer: javob, p_time_ms: Math.round(t) }),
      yakunla: (sid) => rpc<{ finished_at: string }>('finish_session', { p_session: sid }),
      miniTestniYakunla: (sid, javoblar) => rpc<SessiyaJavob>('finish_course_mini_test', { p_session: sid, p_answers: javoblar }),
      navbatgaQosh: async (qid) => { await rpc('add_to_review', { p_question: qid }); },
      navbatdanOl: async (qid) => {
        const { error } = await c.from('review_queue').delete().eq('question_id', qid);
        if (error) throw error;
      },
      sabab: async (qid, tag) => {
        const { error } = await c.from('review_queue').update({ reason_tag: tag }).eq('question_id', qid);
        if (error) throw error;
      },
      saqla: async (qid, on) => {
        const { error } = on
          ? await c.from('bookmarks').insert({ question_id: qid })
          : await c.from('bookmarks').delete().eq('question_id', qid);
        // 23505: allaqachon saqlangan (boshqa tabda) — natija bir xil
        if (error && error.code !== '23505') throw error;
      },
      rasm: async (path) => {
        const { data, error } = await c.storage.from('question-figures').createSignedUrl(path, 3600);
        return error ? null : data.signedUrl;
      },
    };
  }

  boshla();
</script>

