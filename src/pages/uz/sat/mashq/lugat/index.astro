---
// Lug'at kartochkalari. Dizayn: Tayanch-SAT-dizayn.md, "Lug'at" ekrani.
// Holat ("bilaman" / "o'rganyapman") faqat shu brauzerda saqlanadi (tayanch:sat-lugat).
import SatFokus from '../../../../../layouts/SatFokus.astro';
import { kartalar } from '../../../../../data/satNamuna';
---
<SatFokus
  title="Vocabulary cards · SAT"
  description="Cards for words that appear in Reading & Writing texts."
  ustki="Vocabulary · Sample set"
  nomi="Reading & Writing words"
  progressNomi="Set progress"
  yol={['Reading']}
>
  <script type="application/json" id="kartalar-data" set:html={JSON.stringify(kartalar)} />

  <h1 class="ekranda-yoq">Vocabulary cards</h1>
  <div class="lugat">
    <div class="markaz">
      <button type="button" class="karta" id="karta" aria-live="polite">
        <span class="yuz-yorliq" id="yuz-yorliq">English</span>
        <span class="oldi" id="oldi">
          <span class="soz" id="soz">{kartalar[0].soz}</span>
          <span class="turkum" id="turkum">{kartalar[0].turkum}</span>
        </span>
        <span class="orqasi" id="orqasi" hidden>
          <span class="tarjima" lang="uz" id="tarjima"></span>
          <span class="misol" id="misol"></span>
        </span>
        <span class="maslahat">Tap to flip</span>
      </button>

      <div class="boshqaruv">
        <button type="button" class="dumaloq" id="oldingi" aria-label="Previous card">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="tugma-l chiziqli" id="bilmayman">Still learning</button>
        <button type="button" class="tugma-l kok" id="bilaman">I know it</button>
        <button type="button" class="dumaloq" id="keyingi" aria-label="Next card">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>

    <aside class="holat" aria-label="Set status">
      <div class="oq-blok">
        <p class="ustki-yorliq">In this set</p>
        <div class="sonlar">
          <div class="son kok-son"><span class="raqam" id="bilgan-soni">0</span><span>I know it</span></div>
          <div class="son chiziq-son"><span class="raqam" id="organ-soni">0</span><span>Still learning</span></div>
        </div>
      </div>
      <div class="oq-blok royxat-blok">
        <p class="ustki-yorliq">Words</p>
        <ul id="sozlar">
          {kartalar.map((k, idx) => (
            <li>
              <button type="button" data-idx={idx}>
                <span>{k.soz}</span>
                <span class="s-holat">—</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class="tugma-l ikkinchi" id="bilmaganga">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5" /><path d="M4 20L21 3" /><path d="M21 16v5h-5" /><path d="M15 15l6 6" /><path d="M4 4l5 5" /></svg>
        Go to a word I don't know
      </button>
    </aside>
  </div>
</SatFokus>

<script>
  import { KALIT_LUGAT, type Karta } from '../../../../../data/satNamuna';

  const kartalar: Karta[] = JSON.parse(document.getElementById('kartalar-data')!.textContent || '[]');
  const n = kartalar.length;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  type Holat = 'bilaman' | 'organ';
  let holat: Record<string, Holat> = {};
  try { holat = JSON.parse(localStorage.getItem(KALIT_LUGAT) || '{}') || {}; } catch { holat = {}; }
  let i = 0;
  let orqa = false;

  const saqla = () => { try { localStorage.setItem(KALIT_LUGAT, JSON.stringify(holat)); } catch { /* saqlanmadi */ } };

  const chiz = () => {
    const k = kartalar[i];
    const karta = $('karta');
    karta.classList.toggle('orqa', orqa);
    $('yuz-yorliq').textContent = orqa ? 'Uzbek:' : 'English';
    $('oldi').hidden = orqa;
    $('orqasi').hidden = !orqa;
    $('soz').textContent = k.soz;
    $('turkum').textContent = k.turkum;
    $('tarjima').textContent = k.tarjima;
    $('misol').textContent = `“${k.misol}”`;
    // Nom karta matnidan olinadi (so'z yoki tarjima eshitiladi); aria-label uni yashirib qo'yardi
    karta.setAttribute('aria-pressed', String(orqa));
    $('fokus-progress-toldirish').style.width = Math.round(((i + 1) / n) * 100) + '%';
    const p = $('fokus-progress');
    p.setAttribute('aria-valuemax', String(n));
    p.setAttribute('aria-valuenow', String(i + 1));
    $('fokus-progress-matn').textContent = `${i + 1} / ${n}`;
    $('bilgan-soni').textContent = String(kartalar.filter((x) => holat[x.soz] === 'bilaman').length);
    $('organ-soni').textContent = String(kartalar.filter((x) => holat[x.soz] === 'organ').length);
    document.querySelectorAll<HTMLButtonElement>('#sozlar button').forEach((b, idx) => {
      const h = holat[kartalar[idx].soz];
      const s = b.querySelector('.s-holat') as HTMLElement;
      s.textContent = h === 'bilaman' ? 'I know it' : h === 'organ' ? 'still learning' : '—';
      s.dataset.holat = h ?? '';
      if (idx === i) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
    });
  };

  const bor = (yangiI: number) => { i = (yangiI + n) % n; orqa = false; chiz(); };
  const belgila = (h: Holat) => { holat[kartalar[i].soz] = h; saqla(); bor(i + 1); };

  $('karta').addEventListener('click', () => { orqa = !orqa; chiz(); });
  $('oldingi').addEventListener('click', () => bor(i - 1));
  $('keyingi').addEventListener('click', () => bor(i + 1));
  $('bilaman').addEventListener('click', () => belgila('bilaman'));
  $('bilmayman').addEventListener('click', () => belgila('organ'));
  $('bilmaganga').addEventListener('click', () => {
    const k = kartalar.findIndex((x) => holat[x.soz] !== 'bilaman');
    if (k >= 0) bor(k);
  });
  document.querySelectorAll<HTMLButtonElement>('#sozlar button').forEach((b) =>
    b.addEventListener('click', () => bor(Number(b.dataset.idx))));
  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    if (e.key === 'ArrowLeft') bor(i - 1);
    if (e.key === 'ArrowRight') bor(i + 1);
  });
  chiz();
</script>

<style>
  .lugat { display: flex; gap: var(--b-8); max-width: 1184px; margin: 0 auto; }
  .markaz { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: var(--b-6); }
  .karta {
    position: relative; width: 100%; max-width: 760px; min-height: 440px;
    padding: 64px 40px; border-radius: var(--r-katta);
    font: inherit; text-align: center;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    cursor: pointer;
    background: var(--fon); color: var(--matn);
    border: 1.5px solid var(--matn); box-shadow: var(--soya);
  }
  .karta.orqa { background: var(--qora); color: var(--rang-asosiy-matn); border-color: var(--qora-chiziq); box-shadow: none; }
  .yuz-yorliq {
    position: absolute; top: 20px; left: 24px;
    padding: 4px 12px; border-radius: var(--r-toliq);
    font-size: var(--matn-mayda); font-weight: 700;
    background: var(--sirt-ikkinchi); color: var(--matn);
  }
  .karta.orqa .yuz-yorliq { background: var(--qora-chiziq); color: var(--rang-asosiy-matn); }
  .oldi, .orqasi { display: flex; flex-direction: column; align-items: center; gap: var(--b-3); }
  .oldi[hidden], .orqasi[hidden] { display: none; }
  .orqasi { gap: 18px; max-width: 520px; }
  .soz { font-size: 56px; font-weight: 900; letter-spacing: -1px; overflow-wrap: anywhere; }
  .turkum { font-size: 16px; font-weight: 600; color: var(--matn-sust); }
  .tarjima { font-size: 36px; font-weight: 800; line-height: 1.2; }
  .misol { font-size: 18px; line-height: 1.6; color: var(--qora-matn-ikkinchi); font-style: italic; }
  .maslahat { position: absolute; bottom: 20px; left: 0; right: 0; font-size: var(--matn-kichik); font-weight: 600; color: var(--matn-sust); }
  .karta.orqa .maslahat { color: var(--qora-matn-ikkinchi); }

  .boshqaruv { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--b-3); }
  .dumaloq {
    width: 52px; height: 52px; border: 0; border-radius: var(--r-toliq);
    background: var(--fon); color: var(--matn);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  :global([data-mavzu='qorongi']) .dumaloq { background: var(--fon-ikkinchi); }
  .dumaloq:hover { background: var(--sirt-ikkinchi); }
  .tugma-l {
    min-height: 52px; padding: 0 26px; border-radius: var(--r-toliq);
    font: inherit; font-weight: 800; font-size: 16px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: var(--b-2);
  }
  .tugma-l.chiziqli { border: 1.5px solid var(--matn); background: var(--fon); color: var(--matn); }
  .tugma-l.chiziqli:hover { background: var(--fon-ikkinchi); }
  .tugma-l.kok { border: 0; background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  .tugma-l.kok:hover { background: var(--rang-asosiy-toq); }
  .tugma-l.ikkinchi { min-height: 48px; border: 0; background: var(--sirt-ikkinchi); color: var(--matn); font-weight: 700; font-size: 15px; }
  .tugma-l.ikkinchi:hover { background: var(--chiziq); }

  .holat { width: 300px; flex: none; display: flex; flex-direction: column; gap: var(--b-4); }
  .oq-blok { background: var(--fon); border-radius: var(--r-katta); padding: var(--b-6); display: flex; flex-direction: column; gap: var(--b-4); }
  :global([data-mavzu='qorongi']) .oq-blok { background: var(--fon-ikkinchi); }
  .royxat-blok { padding: var(--b-2); gap: 0; }
  .royxat-blok .ustki-yorliq { margin: var(--b-3) var(--b-4) var(--b-2); }
  .ustki-yorliq { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-sust); }
  .sonlar { display: flex; gap: var(--b-3); }
  .son { flex: 1; border-radius: var(--r-orta); padding: var(--b-4); display: flex; flex-direction: column; gap: 2px; font-size: var(--matn-kichik); font-weight: 600; }
  .raqam { font-size: 32px; font-weight: 900; line-height: 1.2; }
  .kok-son { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  .chiziq-son { border: 1.5px solid var(--matn); }
  #sozlar { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  #sozlar button {
    width: 100%; min-height: 44px; padding: 0 16px;
    border: 0; border-radius: 14px; background: transparent; color: var(--matn);
    font: inherit; font-size: 15px; font-weight: 700;
    display: flex; align-items: center; justify-content: space-between; cursor: pointer;
  }
  #sozlar button:hover, #sozlar button[aria-current='true'] { background: var(--fon-ikkinchi); }
  :global([data-mavzu='qorongi']) #sozlar button:hover, :global([data-mavzu='qorongi']) #sozlar button[aria-current='true'] { background: var(--sirt-ikkinchi); }
  .s-holat { font-size: 12px; font-weight: 700; color: var(--matn-sust); }
  .s-holat[data-holat='bilaman'] { color: var(--rang-havola); }
  .s-holat[data-holat='organ'] { color: var(--matn); }

  @media (max-width: 1023.98px) {
    .lugat { flex-direction: column; }
    .holat { width: 100%; }
  }
  @media (max-width: 640px) {
    .karta { min-height: 340px; padding: 56px 20px; }
    .soz { font-size: 40px; }
    .tarjima { font-size: 26px; }
    .boshqaruv .tugma-l { flex: 1 1 140px; padding: 0 16px; }
  }
</style>
