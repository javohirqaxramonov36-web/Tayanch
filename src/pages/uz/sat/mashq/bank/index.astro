---
// Savol banki (P07). Dizayn: Tayanch-SAT-dizayn.md, "SavolBanki" ekrani; spetsifikatsiya muallif tasdiqlagan (2026-11-10).
// Domen va skill ro'yxati taksonomiyadan (statik). Sonlar FAQAT Supabase question_counts RPC'dan (hisob bilan):
// statik build'da hech qanday raqam yo'q. Sof mantiq: src/lib/savolBanki.ts.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import TarifDialog from '../../../../../components/sat/TarifDialog.astro';
import { savolTaksonomiya, type SavolBolim } from '../../../../../data/satTaksonomiya';
import { HAJMLAR } from '../../../../../lib/savolBanki';
import { yol } from '../../../../../lib/yol';

const BOLIMLAR: { kalit: SavolBolim; nomi: string }[] = [
  { kalit: 'rw', nomi: 'Reading and Writing' },
  { kalit: 'math', nomi: 'Math' },
];
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<BolimQobiq
  title="Question bank · SAT"
  description="Pick SAT skills, set the difficulty and start a practice session with questions checked by the author."
  turi="mashq"
  yol={['Practice']}
  bolim="sat"
  holat="qoralama"
>
  <div class="ichki bank" data-holat="loading"
    data-sessiya-url={yol('/uz/sat/mashq/sessiya/')}
    data-bank-url={yol('/uz/sat/mashq/bank/')}>
    <section class="bosh" aria-labelledby="bank-h">
      <p class="pill-qator"><span class="pill">Practice</span></p>
      <h1 id="bank-h">Question bank</h1>
      <p class="lead">Pick the skills you want to work on, set the difficulty and start a session. Only questions the author has checked are included.</p>
      <p class="kvota" id="kvota" hidden></p>
      <div class="ogoh" id="kvota-tugadi" tabindex="-1" hidden>
        <p id="kvota-tugadi-matn"></p>
        <!-- P20 da tariflar sahifasiga (/uz/sat/hisob/tariflar/) o'tkaziladi; hozircha profil. -->
        <a id="rejalar" href="#">See plans</a>
      </div>
    </section>

    <div class="izoh-karta" id="izoh" role="status" hidden>
      <p class="izoh-sarlavha" id="izoh-sarlavha"></p>
      <p class="izoh-matn" id="izoh-matn"></p>
      <button type="button" class="kichik-tugma" id="qayta" hidden>Retry</button>
    </div>

    <section class="filtrlar" aria-label="Filters">
      <div class="segment" role="tablist" aria-label="Section">
        {BOLIMLAR.map((b, i) => (
          <button type="button" role="tab" id={`tab-${b.kalit}`} aria-controls={`panel-${b.kalit}`}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-bolim={b.kalit}>{b.nomi}</button>
        ))}
      </div>

      <div class="filtr-qatorlar">
        <fieldset class="qator">
          <legend class="qator-nom">Difficulty</legend>
          <button type="button" class="chip" aria-pressed="true" data-qiyinlik="">All</button>
          <button type="button" class="chip" aria-pressed="false" data-qiyinlik="easy">Easy</button>
          <button type="button" class="chip" aria-pressed="false" data-qiyinlik="medium">Medium</button>
          <button type="button" class="chip" aria-pressed="false" data-qiyinlik="hard">Hard</button>
        </fieldset>
        <fieldset class="qator">
          <legend class="qator-nom">Questions</legend>
          <button type="button" class="chip" aria-pressed="true" data-yechilgan="all">All</button>
          <button type="button" class="chip" aria-pressed="false" data-yechilgan="unsolved">Unsolved</button>
          <label class="belgi-qutisi"><input type="checkbox" id="belgilangan" /> Marked for review</label>
          <label class="belgi-qutisi"><input type="checkbox" id="qayta-yechish" /> Redo list</label>
        </fieldset>
      </div>
    </section>

    {BOLIMLAR.map((b, i) => (
      <section class="skilllar" role="tabpanel" id={`panel-${b.kalit}`} aria-labelledby={`tab-${b.kalit}`} hidden={i !== 0} data-panel={b.kalit}>
        <div class="skill-bosh">
          <h2 class="kichik-sarlavha">{b.nomi} skills</h2>
          <p class="skill-izoh" data-son-izoh>Questions per skill</p>
        </div>
        <p class="bolim-bosh" data-bolim-bosh hidden>No verified {b.nomi} questions yet.</p>
        <div class="domenlar" aria-busy="true">
          {Object.entries(savolTaksonomiya[b.kalit]).map(([domen, skills]) => {
            const d = `${b.kalit}-${id(domen)}`;
            return (
              <div class="domen" data-domen={domen}>
                <label class="domen-bosh" for={`d-${d}`}>
                  <input type="checkbox" id={`d-${d}`} data-domen-quti />
                  <span class="d-nom">{domen}</span>
                  <span class="son" data-domen-son aria-hidden="true"></span>
                </label>
                <ul class="skill-royxat" aria-label={domen}>
                  {skills.map((s) => (
                    <li>
                      <label class="skill" for={`s-${d}-${id(s)}`}>
                        <input type="checkbox" id={`s-${d}-${id(s)}`} data-skill={s} />
                        <span class="s-nom">{s}</span>
                        <span class="son" data-son><span class="skelet" aria-hidden="true"></span></span>
                      </label>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <section class="sozlama" aria-label="Session settings">
      <fieldset class="qator">
        <legend class="qator-nom">Questions per session</legend>
        {HAJMLAR.map((h, i) => (
          <button type="button" class="chip" aria-pressed={i === 1 ? 'true' : 'false'} data-hajm={String(h)}>{h === 'all' ? 'All' : h}</button>
        ))}
      </fieldset>
      <fieldset class="qator">
        <legend class="qator-nom">Mode</legend>
        <button type="button" class="chip" aria-pressed="true" data-rejim="practice">Untimed</button>
        <button type="button" class="chip" aria-pressed="false" data-rejim="timed">Timed</button>
      </fieldset>
    </section>

    <section class="tanlov qora-kontekst" aria-label="Start a session">
      <div class="tanlov-holat" aria-live="polite">
        <p class="tanlov-matn" id="tanlov-matn">Loading question counts…</p>
        <p class="tanlov-izoh" id="tanlov-izoh"></p>
      </div>
      <button type="button" class="katta-tugma oq" id="boshlash" disabled aria-describedby="tanlov-izoh">Start practice session</button>
      <a class="katta-tugma oq" id="kirish-havola" href={yol('/uz/hisob/kirish/')} hidden>Sign in to practice</a>
    </section>

    <div class="eslatma">
      <p>Questions are written for Tayanch and checked by the author before they appear here; they are not copied from other sites.</p>
      <p><a href={yol('/uz/sat/mashq/test/')}>Sample test · saved in this browser only</a></p>
    </div>
  </div>
  <TarifDialog />
</BolimQobiq>

<script>
  import { hisobMijoz, hisobYoli, yuklanish } from '../../../../../lib/hisob';
  import {
    filtrJson, skillSonlari, bolimJami, faolSkilllar, mosSon, domenHolati, sessiyaHajmi, hajmIzohi,
    kvotaHolati, kvotaTugadiMatni, xatoTuri, boshlashSababi, sonMatni, SESSIYA_KALITI, urlTanlov,
    type BankFiltr, type BankHolat, type Hajm, type Kvota, type Qiyinlik, type Rejim, type SonJavob, type UsageJavob,
  } from '../../../../../lib/savolBanki';
  import { savolTaksonomiya, type SavolBolim } from '../../../../../data/satTaksonomiya';
  import { holatOqi } from '../../../../../lib/holat';
  import { AFZALLIK_KALITI, afzallikTozala } from '../../../../../lib/sat/afzallik';
  import { satTarif } from '../../../../../data/satTarif';
  import { tarifDialogOch, tavsiyaRoyxati } from '../../../../../lib/sat/tarifDialog';
  import type { TarifManba } from '../../../../../lib/sat/tarifJadval';

  interface Api {
    sonlar(f: Record<string, unknown>): Promise<SonJavob>;
    boshlash(f: Record<string, unknown>, hajm: number, rejim: Rejim): Promise<{ session_id: string | null }>;
    kvota(): Promise<UsageJavob>;
    tariflar(): Promise<(TarifManba & { name?: string })[]>;
  }

  const $ = <T extends HTMLElement = HTMLElement>(i: string) => document.getElementById(i) as T;
  const bank = document.querySelector<HTMLElement>('.bank')!;
  const BOLIMLAR: SavolBolim[] = ['rw', 'math'];

  const s = {
    holat: 'loading' as BankHolat,
    filtr: { section: 'rw', qiyinlik: [], yechilgan: 'all', belgilangan: false, qaytaYechish: false } as BankFiltr,
    tanlangan: { rw: new Set<string>(), math: new Set<string>() } as Record<SavolBolim, Set<string>>,
    sonlar: { rw: null, math: null } as Record<SavolBolim, Map<string, number> | null>,
    jami: { rw: 0, math: 0 } as Record<SavolBolim, number>,
    hajm: 20 as Hajm,
    rejim: afzallikTozala(holatOqi(AFZALLIK_KALITI, null)).rejim as Rejim, // My SAT profile: standart rejim
    kvota: null as Kvota | null,
    band: false,
    xato: null as string | null,
  };
  let api: Api | null = null;

  // ---- Chizish ----
  const sonlarOchiq = () => s.holat === 'ready';

  function chizTablar() {
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
      const faol = b.dataset.bolim === s.filtr.section;
      b.setAttribute('aria-selected', String(faol));
      b.tabIndex = faol ? 0 : -1;
    });
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== s.filtr.section));
  }

  function chizChiplar() {
    document.querySelectorAll<HTMLButtonElement>('[data-qiyinlik]').forEach((b) => {
      const q = b.dataset.qiyinlik as Qiyinlik | '';
      b.setAttribute('aria-pressed', String(q ? s.filtr.qiyinlik.includes(q) : s.filtr.qiyinlik.length === 0));
    });
    document.querySelectorAll<HTMLButtonElement>('[data-yechilgan]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.yechilgan === s.filtr.yechilgan)));
    document.querySelectorAll<HTMLButtonElement>('[data-hajm]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.hajm === String(s.hajm))));
    document.querySelectorAll<HTMLButtonElement>('[data-rejim]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.rejim === s.rejim)));
  }

  function chizSkilllar(bolim: SavolBolim) {
    const panel = document.querySelector<HTMLElement>(`[data-panel="${bolim}"]`)!;
    const sonlar = s.sonlar[bolim];
    const ochiq = sonlarOchiq();
    const kutish = ochiq && !sonlar;
    const tanlangan = s.tanlangan[bolim];
    const bolimBosh = ochiq && s.jami[bolim] === 0;
    panel.querySelector<HTMLElement>('[data-bolim-bosh]')!.hidden = !bolimBosh;
    panel.querySelector<HTMLElement>('[data-son-izoh]')!.hidden = !ochiq;
    const royxat = panel.querySelector<HTMLElement>('.domenlar')!;
    royxat.setAttribute('aria-busy', String(s.holat === 'loading' || kutish));

    panel.querySelectorAll<HTMLElement>('[data-domen]').forEach((d) => {
      const skills: string[] = [];
      let domenSon = 0;
      d.querySelectorAll<HTMLInputElement>('[data-skill]').forEach((inp) => {
        const nom = inp.dataset.skill!;
        skills.push(nom);
        const son = sonlar?.get(nom) ?? 0;
        domenSon += son;
        const yopiq = ochiq && (kutish || son === 0);
        inp.disabled = yopiq;
        inp.checked = tanlangan.has(nom) && !(ochiq && !kutish && son === 0);
        inp.closest('.skill')!.classList.toggle('sust', ochiq && !kutish && son === 0);
        const el = inp.parentElement!.querySelector<HTMLElement>('[data-son]')!;
        if (s.holat === 'loading' || kutish) el.innerHTML = '<span class="skelet" aria-hidden="true"></span>';
        else if (ochiq) el.innerHTML = `${son}<span class="korinmas"> ${son === 1 ? 'question' : 'questions'}</span>`;
        else el.textContent = '';
      });
      const quti = d.querySelector<HTMLInputElement>('[data-domen-quti]')!;
      const holat = domenHolati(skills, tanlangan, ochiq ? (sonlar ?? new Map()) : null);
      quti.checked = holat === 'all';
      quti.indeterminate = holat === 'some';
      // Native checkbox: qisman holat indeterminate orqali "mixed" deb o'qiladi (aria-checked native input'da tavsiya etilmaydi).
      quti.disabled = ochiq && (kutish || domenSon === 0);
      d.querySelector<HTMLElement>('[data-domen-son]')!.textContent = ochiq && !kutish ? String(domenSon) : '';
    });
  }

  function chizIzoh() {
    const izoh = $('izoh');
    const qayta = $('qayta');
    const yoz = (sarlavha: string, matn: string, tugma = false) => {
      $('izoh-sarlavha').textContent = sarlavha;
      $('izoh-matn').textContent = matn;
      qayta.hidden = !tugma;
      izoh.hidden = false;
    };
    izoh.hidden = true;
    if (s.holat === 'empty') yoz('No verified questions yet', 'The author is still checking the first questions. Counts will appear here once they are published.');
    else if (s.holat === 'error') yoz("Question counts didn't load", s.xato ?? 'Check your connection and try again.', true);
    else if (s.holat === 'anon') yoz('Sign in to see question counts', 'You can browse the skills below. Practice sessions and counts need a Tayanch account.');
    else if (s.holat === 'no-supabase') yoz('Practice sessions are not available here', "Sign-in isn't set up on this copy of the site, so question counts can't load. The skill list is below.");
  }

  function chizKvota() {
    const k = s.kvota;
    $('kvota').hidden = !k || s.holat !== 'ready';
    if (k) $('kvota').textContent = k.matn;
    const tugadi = !!k?.tugadi && s.holat === 'ready';
    $('kvota-tugadi').hidden = !tugadi;
    if (k && tugadi) $('kvota-tugadi-matn').textContent = kvotaTugadiMatni(k);
  }

  function chizPanel() {
    const bolim = s.filtr.section;
    const tanlangan = s.tanlangan[bolim];
    const sonlar = s.sonlar[bolim];
    const tugma = $<HTMLButtonElement>('boshlash');
    const kirish = $<HTMLAnchorElement>('kirish-havola');
    const anon = s.holat === 'anon';
    tugma.hidden = anon;
    kirish.hidden = !anon;

    let matn: string;
    let izoh: string;
    if (anon) {
      matn = tanlangan.size ? `${tanlangan.size} ${tanlangan.size === 1 ? 'skill' : 'skills'} selected` : 'No skills selected';
      izoh = 'Sign in to see how many questions match and to start a session.';
    } else if (s.holat === 'no-supabase') {
      matn = 'Sessions are not available here';
      izoh = 'Sign-in is not set up on this copy of the site.';
    } else {
      const ochiq = sonlarOchiq() && sonlar;
      const mos = ochiq ? mosSon(tanlangan, sonlar) : 0;
      const tanlanganSoni = ochiq ? faolSkilllar(tanlangan, sonlar).length : tanlangan.size;
      const sabab = s.holat === 'ready' && !sonlar
        ? 'Updating counts…'
        : boshlashSababi({ holat: s.holat, tanlanganSoni, mos, kvotaTugadi: !!s.kvota?.tugadi, bolimBosh: s.holat === 'ready' && s.jami[bolim] === 0 });
      matn = ochiq ? sonMatni(mos) : s.holat === 'ready' ? 'Updating counts…' : s.holat === 'loading' ? 'Loading question counts…' : s.holat === 'empty' ? 'No questions yet' : 'Counts unavailable';
      if (s.holat === 'ready' && !sonlar) izoh = '';
      else if (s.xato && s.holat === 'ready') izoh = s.xato;
      else if (sabab) izoh = sabab;
      else izoh = hajmIzohi(s.hajm, sessiyaHajmi(s.hajm, mos, s.kvota?.savolQolgan ?? null));
      if (!s.band) tugma.disabled = !!sabab;
    }
    $('tanlov-matn').textContent = matn;
    $('tanlov-izoh').textContent = izoh;
  }

  function chiz() {
    bank.dataset.holat = s.holat;
    chizTablar();
    chizChiplar();
    BOLIMLAR.forEach(chizSkilllar);
    chizIzoh();
    chizKvota();
    chizPanel();
  }

  // ---- Ma'lumot ----
  const kesh = new Map<string, Map<string, number>>();
  let sorovRaqami = 0;
  let kechikish: number | undefined;

  async function sonlarniOl() {
    if (!api || s.holat !== 'ready') return;
    const bolim = s.filtr.section;
    const f = filtrJson(s.filtr);
    const kalit = JSON.stringify(f);
    const bor = kesh.get(kalit);
    if (bor) { s.sonlar[bolim] = bor; chiz(); return; }
    const raqam = ++sorovRaqami;
    s.sonlar[bolim] = null;
    chiz();
    try {
      const javob = await api.sonlar(f);
      if (raqam !== sorovRaqami) return;
      const m = skillSonlari(javob, bolim);
      kesh.set(kalit, m);
      s.sonlar[bolim] = m;
      s.xato = null;
    } catch (e) {
      if (raqam !== sorovRaqami) return;
      xatoniKorsat(e);
    }
    chiz();
  }

  /** Filtr o'zgarganda: boshqa bo'lim sonlari eskirdi, joriysi debounce bilan qayta so'raladi. */
  function filtrOzgardi() {
    BOLIMLAR.forEach((b) => (s.sonlar[b] = null));
    chiz();
    clearTimeout(kechikish);
    kechikish = window.setTimeout(sonlarniOl, 300);
  }

  function xatoniKorsat(e: unknown) {
    const tur = xatoTuri(e);
    if (tur === 'kirish') { s.holat = 'anon'; return; }
    s.holat = 'error';
    s.xato = tur === 'tarmoq' ? "Couldn't reach the server. Check your connection and try again." : 'Something went wrong on the server. Try again.';
  }

  async function yukla() {
    s.holat = 'loading';
    s.xato = null;
    kesh.clear();
    BOLIMLAR.forEach((b) => (s.sonlar[b] = null));
    chiz();
    try {
      const [asos, usage] = await Promise.all([api!.sonlar({}), api!.kvota().catch(() => null)]);
      s.jami = bolimJami(asos);
      s.kvota = usage ? kvotaHolati(usage) : null;
      s.holat = Number(asos.total) > 0 ? 'ready' : 'empty';
    } catch (e) {
      xatoniKorsat(e);
    }
    chiz();
    if (s.holat === 'ready') await sonlarniOl();
  }

  function haqiqiyApi(c: NonNullable<ReturnType<typeof hisobMijoz>>): Api {
    const rpc = async <T,>(nom: string, args?: Record<string, unknown>): Promise<T> => {
      const { data, error } = await c.rpc(nom, args);
      if (error) throw error;
      return data as T;
    };
    return {
      sonlar: (f) => rpc<SonJavob>('question_counts', { p_filters: f }),
      boshlash: (f, hajm, rejim) => rpc('start_session', { p_filters: f, p_volume: hajm, p_mode: rejim }),
      kvota: () => rpc<UsageJavob>('usage_status'),
      tariflar: async () => {
        const { data, error } = await c.from('plans').select('code, name, limits, features').eq('bolim', 'sat');
        if (error) throw error;
        return (data ?? []) as (TarifManba & { name?: string })[];
      },
    };
  }

  async function boshla() {
    const tugma = $<HTMLButtonElement>('boshlash');
    if (!api || s.band || tugma.disabled) return;
    const bolim = s.filtr.section;
    const sonlar = s.sonlar[bolim];
    if (!sonlar) return;
    const skills = faolSkilllar(s.tanlangan[bolim], sonlar);
    const { soni } = sessiyaHajmi(s.hajm, mosSon(skills, sonlar), s.kvota?.savolQolgan ?? null);
    if (soni < 1) return;
    s.band = true;
    s.xato = null;
    yuklanish(tugma, true, 'Starting…');
    $('tanlov-izoh').textContent = 'Starting your session…';
    try {
      const javob = await api.boshlash(filtrJson(s.filtr, skills), soni, s.rejim);
      if (!javob.session_id) {
        s.xato = 'No questions match these filters';
        kesh.clear();
        filtrOzgardi();
      } else {
        try { sessionStorage.setItem(SESSIYA_KALITI, JSON.stringify(javob)); } catch { /* xotira yopiq: sessiya sahifasi id bilan qayta so'raydi */ }
        location.assign(`${bank.dataset.sessiyaUrl}?id=${encodeURIComponent(javob.session_id)}`);
        return;
      }
    } catch (e) {
      const tur = xatoTuri(e);
      if (tur === 'kvota') {
        const k = s.kvota;
        s.kvota = { ...(k ?? kvotaHolati(null)), tugadi: true, qolgan: 0, savolQolgan: k?.kalit === 'questions' ? 0 : (k?.savolQolgan ?? null) };
        s.xato = 'Daily limit reached';
        void tarifTaklifi(tugma);
      } else if (tur === 'kirish') {
        s.holat = 'anon';
      } else {
        s.xato = tur === 'tarmoq'
          ? "Couldn't reach the server. Check your connection and try again."
          : "The session didn't start. Try again.";
      }
    }
    s.band = false;
    yuklanish(tugma, false);
    chiz();
  }

  // ---- Hodisalar ----
  const tablar = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const bolimTanla = (b: SavolBolim, fokus = false) => {
    if (s.filtr.section === b) return;
    s.filtr.section = b;
    s.xato = null;
    chiz();
    if (fokus) tablar.find((t) => t.dataset.bolim === b)?.focus();
    if (s.holat === 'ready' && !s.sonlar[b]) { clearTimeout(kechikish); sonlarniOl(); }
  };
  tablar.forEach((t, i) => {
    t.addEventListener('click', () => bolimTanla(t.dataset.bolim as SavolBolim));
    t.addEventListener('keydown', (e) => {
      const k = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tablar.length - 1 }[e.key];
      if (k === undefined) return;
      e.preventDefault();
      bolimTanla(tablar[(k + tablar.length) % tablar.length].dataset.bolim as SavolBolim, true);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-qiyinlik]').forEach((b) => b.addEventListener('click', () => {
    const q = b.dataset.qiyinlik as Qiyinlik | '';
    if (!q) s.filtr.qiyinlik = [];
    else {
      const j = new Set(s.filtr.qiyinlik);
      if (j.has(q)) j.delete(q); else j.add(q);
      s.filtr.qiyinlik = j.size === 3 ? [] : [...j];
    }
    filtrOzgardi();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-yechilgan]').forEach((b) => b.addEventListener('click', () => {
    if (s.filtr.yechilgan === b.dataset.yechilgan) return;
    s.filtr.yechilgan = b.dataset.yechilgan as BankFiltr['yechilgan'];
    filtrOzgardi();
  }));
  $<HTMLInputElement>('belgilangan').addEventListener('change', (e) => {
    s.filtr.belgilangan = (e.target as HTMLInputElement).checked; filtrOzgardi();
  });
  $<HTMLInputElement>('qayta-yechish').addEventListener('change', (e) => {
    s.filtr.qaytaYechish = (e.target as HTMLInputElement).checked; filtrOzgardi();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-hajm]').forEach((b) => b.addEventListener('click', () => {
    s.hajm = (b.dataset.hajm === 'all' ? 'all' : Number(b.dataset.hajm)) as Hajm; s.xato = null; chiz();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-rejim]').forEach((b) => b.addEventListener('click', () => {
    s.rejim = b.dataset.rejim as Rejim; chiz();
  }));

  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
    const bolim = panel.dataset.panel as SavolBolim;
    panel.addEventListener('change', (e) => {
      const inp = e.target as HTMLInputElement;
      const j = s.tanlangan[bolim];
      const sonlar = sonlarOchiq() ? s.sonlar[bolim] : null;
      if (inp.dataset.skill) {
        if (inp.checked) j.add(inp.dataset.skill); else j.delete(inp.dataset.skill);
      } else if (inp.hasAttribute('data-domen-quti')) {
        const skills = [...inp.closest('[data-domen]')!.querySelectorAll<HTMLInputElement>('[data-skill]')].map((x) => x.dataset.skill!);
        const holat = domenHolati(skills, j, sonlar);
        const ochiq = sonlar ? skills.filter((x) => (sonlar.get(x) ?? 0) > 0) : skills;
        if (holat === 'all') skills.forEach((x) => j.delete(x)); else ochiq.forEach((x) => j.add(x));
      }
      s.xato = null;
      chiz();
    });
  });

  $('boshlash').addEventListener('click', boshla);
  /**
   * Server limit tugadi desa (Start bosilgandan keyin): TarifDialog. Faqat tavsiya tarifda bo'lmaganlarga.
   * Limit oldindan ma'lum bo'lsa Start o'chiq turadi va sababi yoziladi: bu oyna faqat kutilmagan holat uchun.
   */
  async function tarifTaklifi(tugma: HTMLElement) {
    if (!api) return;
    const [usage, tariflar] = await Promise.all([api.kvota().catch(() => null), api.tariflar().catch(() => [])]);
    const yangi = usage ? kvotaHolati(usage) : null;
    if (yangi?.kalit) s.kvota = { ...yangi, tugadi: true, qolgan: 0, savolQolgan: yangi.kalit === 'questions' ? 0 : yangi.savolQolgan };
    if (usage?.plan?.code === satTarif.tavsiya) return;
    const t = tavsiyaRoyxati(tariflar);
    // Sarlavha allaqachon "You've reached today's limit": limit noma'lum bo'lsa faqat tiklanish vaqti.
    const asos = s.kvota?.kalit ? kvotaTugadiMatni(s.kvota) : 'It resets at midnight (Tashkent time).';
    chiz();
    tarifDialogOch({
      matn: `${asos} Everything you've saved stays.`,
      tarifNomi: t?.nomi,
      royxat: t?.royxat,
    }, $('kvota-tugadi').hidden ? tugma : $('kvota-tugadi')); // Start o'chiq bo'lib qoladi: fokus limit xabariga qaytadi
  }
  $('qayta').addEventListener('click', () => { if (api) yukla(); });
  $<HTMLAnchorElement>('rejalar').href = hisobYoli('profil');
  $<HTMLAnchorElement>('kirish-havola').href = `${hisobYoli('kirish')}?keyin=${encodeURIComponent(bank.dataset.bankUrl!)}`;

  // ---- Boshlash ----
  async function ishgaTushir() {
    // Faqat dev: ?mock=bosh|kam|kop|kvota|kvota2|xato. Prod build'da bu shox va mock moduli yo'q.
    if (import.meta.env.DEV) {
      const mock = new URLSearchParams(location.search).get('mock');
      if (mock) {
        const { mockApi } = await import('../../../../../lib/savolBankiMock');
        api = mockApi(mock as Parameters<typeof mockApi>[0]);
        return yukla();
      }
    }
    const c = hisobMijoz();
    if (!c) { s.holat = 'no-supabase'; return chiz(); }
    const { data } = await c.auth.getSession();
    if (!data.session) { s.holat = 'anon'; return chiz(); }
    api = haqiqiyApi(c);
    return yukla();
  }
  // Reja havolasidan oldindan tanlov (P13): filtr URL'dan, sessiyani foydalanuvchi o'zi boshlaydi.
  // Bo'lim berilib skill berilmasa, shu bo'limning hamma skill'i tanlanadi.
  {
    const t = urlTanlov(location.search);
    if (t) {
      if (t.section) {
        s.filtr.section = t.section;
        const hammasi = Object.values(savolTaksonomiya[t.section]).flat();
        s.tanlangan[t.section] = new Set(t.skills.length ? t.skills : hammasi);
      }
      s.filtr.qiyinlik = t.qiyinlik;
      s.filtr.qaytaYechish = t.qaytaYechish;
      $<HTMLInputElement>('qayta-yechish').checked = t.qaytaYechish;
      if (t.rejim) s.rejim = t.rejim;
      if (t.hajm) s.hajm = t.hajm;
    }
  }
  chiz();
  ishgaTushir();
</script>

