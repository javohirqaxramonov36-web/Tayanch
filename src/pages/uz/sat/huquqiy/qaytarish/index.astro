---
// SAT · Refund Policy (inglizcha nusxa, P23 davomi, 2026-11-11). Asosiy matn: /uz/qaytarish/. QORALAMA.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import HuquqiyMatn from '../../../../../components/huquqiy/HuquqiyMatn.astro';
import { huquqiyOchiq } from '../../../../../data/huquqiySahifalar';
import { yol } from '../../../../../lib/yol';

const { qaytarishKun } = huquqiyOchiq;
---
<BolimQobiq
  title="Refund Policy · SAT"
  description="How refunds work for Tayanch SAT paid plans (draft)."
  turi="qollanma"
  bolim="sat"
  yol={['Legal']}
  holat="qoralama"
>
  <HuquqiyMatn
    til="en"
    kalit="qaytarish"
    sana="2026-11-11"
    kirish="This policy covers paid plans in the SAT section."
    tekshirish={[
      'Refund period and conditions: author and lawyer decision.',
      'What the Consumer Protection Law requires for refunds of digital services.',
      'How refunds are made through inPAY and how long they take to reach the card.',
    ]}
  >
    <h2>When you can get a refund</h2>
    {qaytarishKun === null ? (
      <p>The refund period and conditions are not set yet: <span class="tekshir">to be checked</span> (author and lawyer decision). Until then, each request is reviewed on its own.</p>
    ) : (
      <p>If you write to us within {qaytarishKun} days of payment, you may get a refund. Full conditions will be listed here.</p>
    )}
    <p>A double charge or a charge made in error (for example, the payment went through but the plan was not switched on) is always checked and refunded if confirmed.</p>

    <h2>How to ask</h2>
    <ol>
      <li>Write to the address on the <a href={yol('/uz/sat/huquqiy/aloqa/')}>Contact</a> page.</li>
      <li>Give your account email, the payment date and the amount. Do not send your card number.</li>
      <li>The answer and refund steps are sent to that address.</li>
    </ol>

    <h2>How the money is returned</h2>
    <p>The money goes back to the method you paid with (to your card through Click or Payme) via inPAY. How long it takes: <span class="tekshir">to be checked</span>.</p>

    <h2>Deleting your account and refunds</h2>
    <p>If you delete your account, an active subscription ends too. If you want a refund, write to us <strong>before</strong> deleting the account: after deletion the payment can no longer be linked to you.</p>
  </HuquqiyMatn>
</BolimQobiq>
