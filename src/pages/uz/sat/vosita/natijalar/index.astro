---
// Mening natijalarim. Dizayn: Tayanch-SAT-dizayn.md, "Natijalar" ekrani.
// Haqiqiy javoblar localStorage'dan (tayanch:sat-javoblar). Javob yo'q bo'lsa, namuna ko'rsatiladi va belgilanadi.
// Ball hisoblanmaydi.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import { namunaJavoblar } from '../../../../../data/satNamuna';
import { yol } from '../../../../../lib/yol';
---
<BolimQobiq
  title="My results · SAT"
  description="Your answers and mistakes in practice. The data is saved only in this browser. No score is calculated."
  turi="vosita"
  yol={['Practice']}
  bolim="sat"
  holat="qoralama"
>
  <script type="application/json" id="namuna-data" set:html={JSON.stringify(namunaJavoblar)} />
  <div class="ichki natija">
    <section class="bosh" aria-labelledby="nat-h">
      <p class="pill-qator"><span class="pill">Tool</span><span class="pill pill-chiziq" id="namuna-pill">Sample data</span></p>
      <h1 id="nat-h">My results</h1>
      <p class="lead">Your answers and mistakes in practice. The data is saved only in this browser and is not sent anywhere. No score is calculated: this is not an SAT score.</p>
      <p class="namuna-izoh" id="namuna-izoh">You have not solved any practice questions yet, so a sample is shown below. <a href={yol('/uz/sat/mashq/test/')}>Start the practice test</a>, and your answers will appear here.</p>
    </section>

    <section class="korsatkich" aria-label="Summary">
      <div class="qora-blok">
        <p class="ustki-yorliq kok-yorliq">By section</p>
        <div class="bolim-qator" data-bolim="Reading & Writing">
          <div class="bq-bosh"><span>Reading &amp; Writing</span><span class="bq-son"></span></div>
          <div class="bq-iz" aria-hidden="true"><div class="bq-toldirish"></div></div>
        </div>
        <div class="bolim-qator" data-bolim="Math">
          <div class="bq-bosh"><span>Math</span><span class="bq-son"></span></div>
          <div class="bq-iz" aria-hidden="true"><div class="bq-toldirish"></div></div>
        </div>
      </div>
      <div class="chiziq-blok">
        <p class="kb-nom">Needs review</p>
        <p class="kb-son" id="xato-soni">0</p>
        <p class="kb-izoh">wrong answers</p>
        <a href={yol('/uz/sat/mashq/test/')}>Work on mistakes</a>
      </div>
    </section>

    <section class="tarix" aria-labelledby="royxat-h">
      <div class="tarix-bosh">
        <h2 id="royxat-h">Answer history</h2>
        <div class="segment" role="group" aria-label="Filter">
          <button type="button" aria-pressed="true" data-filtr="hammasi">All <span class="soni"></span></button>
          <button type="button" aria-pressed="false" data-filtr="xato">Mistakes <span class="soni"></span></button>
          <button type="button" aria-pressed="false" data-filtr="togri">Correct <span class="soni"></span></button>
        </div>
      </div>
      <ul class="qatorlar" id="qatorlar"></ul>
      <p class="bosh-holat" id="bosh-holat" hidden>No answers for this filter.</p>
    </section>

    <section class="malumot" aria-label="Data">
      <div>
        <p class="m-sarlavha">Data stays in this browser</p>
        <p class="m-matn">This list is not visible on another device or browser. If you delete it, it cannot be restored.</p>
        <p class="m-matn" id="ochirish-xabar" role="status"></p>
      </div>
      <button type="button" class="chiziq-tugma" id="ochirish">Delete results</button>
    </section>
  </div>

  <dialog class="tasdiq" id="ochirish-oyna" aria-labelledby="ochirish-sarlavha">
    <form method="dialog">
      <h2 id="ochirish-sarlavha">Delete your results?</h2>
      <p>Your practice answers in this browser will be deleted. This cannot be undone.</p>
      <div class="tasdiq-tugmalar">
        <button type="submit" value="bekor" class="chiziq-tugma" autofocus>Cancel</button>
        <button type="submit" value="ochir" class="asosiy-tugma">Yes, delete</button>
      </div>
    </form>
  </dialog>
</BolimQobiq>

<script>
  import { KALIT_JAVOBLAR, type Javob } from '../../../../../data/satNamuna';

  const namuna: Javob[] = JSON.parse(document.getElementById('namuna-data')!.textContent || '[]');
  const testUrl = (document.querySelector('.chiziq-blok a') as HTMLAnchorElement).href;
  const oqi = (): Javob[] => {
    try {
      const x = JSON.parse(localStorage.getItem(KALIT_JAVOBLAR) || '[]');
      return Array.isArray(x) ? x : [];
    } catch { return []; }
  };
  let filtr = 'hammasi';

  const chiz = () => {
    const haqiqiy = oqi();
    const namunami = haqiqiy.length === 0;
    const hammasi = namunami ? namuna : haqiqiy;
    (document.getElementById('namuna-pill') as HTMLElement).hidden = !namunami;
    (document.getElementById('namuna-izoh') as HTMLElement).hidden = !namunami;
    (document.getElementById('ochirish') as HTMLButtonElement).disabled = namunami;

    const xatolar = hammasi.filter((q) => !q.togri);
    const togrilar = hammasi.filter((q) => q.togri);
    document.getElementById('xato-soni')!.textContent = String(xatolar.length);

    document.querySelectorAll<HTMLElement>('.bolim-qator').forEach((q) => {
      const b = hammasi.filter((x) => x.bolim === q.dataset.bolim);
      const t = b.filter((x) => x.togri).length;
      q.querySelector('.bq-son')!.textContent = `${t} / ${b.length} correct`;
      (q.querySelector('.bq-toldirish') as HTMLElement).style.width = b.length ? `${Math.round((t / b.length) * 100)}%` : '0';
    });

    const sonlar: Record<string, number> = { hammasi: hammasi.length, xato: xatolar.length, togri: togrilar.length };
    document.querySelectorAll<HTMLButtonElement>('[data-filtr]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.filtr === filtr));
      b.querySelector('.soni')!.textContent = String(sonlar[b.dataset.filtr!]);
    });

    const tanlangan = filtr === 'xato' ? xatolar : filtr === 'togri' ? togrilar : hammasi;
    const ul = document.getElementById('qatorlar')!;
    ul.replaceChildren();
    tanlangan.forEach((q) => {
      const li = document.createElement('li');
      li.innerHTML = `
        <span class="q-belgi ${q.togri ? 'togri' : 'xato'}" role="img" aria-label="${q.togri ? 'Correct' : 'Wrong'}">
          ${q.togri
            ? '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>'
            : '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>'}
        </span>
        <div class="q-matn"><span class="q-mavzu"></span><span class="q-izoh"></span></div>`;
      li.querySelector('.q-mavzu')!.textContent = q.mavzu;
      li.querySelector('.q-izoh')!.textContent = `${q.bolim} · ${q.sana} · your answer ${q.javob}, correct ${q.togriJavob}`;
      if (!q.togri) {
        const a = document.createElement('a');
        a.className = 'qayta';
        a.href = `${testUrl}?mavzular=${encodeURIComponent(q.mavzu)}`;
        a.textContent = 'Solve again';
        li.append(a);
      }
      ul.append(li);
    });
    ul.hidden = tanlangan.length === 0;
    (document.getElementById('bosh-holat') as HTMLElement).hidden = tanlangan.length !== 0;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-filtr]').forEach((b) =>
    b.addEventListener('click', () => { filtr = b.dataset.filtr!; chiz(); }));

  const oyna = document.getElementById('ochirish-oyna') as HTMLDialogElement;
  const ochirish = document.getElementById('ochirish') as HTMLButtonElement;
  ochirish.addEventListener('click', () => { oyna.returnValue = ''; oyna.showModal(); });
  oyna.addEventListener('close', () => {
    if (oyna.returnValue === 'ochir') {
      try { localStorage.removeItem(KALIT_JAVOBLAR); } catch { /* ruxsat yo'q */ }
      document.getElementById('ochirish-xabar')!.textContent = 'Results deleted.';
      chiz();
      (document.getElementById('nat-h') as HTMLElement).focus();
    } else {
      ochirish.focus();
    }
  });
  (document.getElementById('nat-h') as HTMLElement).setAttribute('tabindex', '-1');
  chiz();
</script>

<style>
  .natija { padding-top: var(--b-14); display: flex; flex-direction: column; gap: var(--b-10); }
  .bosh { display: flex; flex-direction: column; gap: var(--b-4); }
  .pill-qator { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3); }
  .pill { padding: 4px 12px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); font-size: var(--matn-mayda); font-weight: 700; }
  .pill[hidden] { display: none; }
  .pill-chiziq { background: transparent; border: 1.5px dashed var(--matn-sust); color: var(--matn-ikkinchi); padding: 2.5px 10.5px; }
  h1 { font-size: 46px; line-height: 1.1; font-weight: 900; letter-spacing: -0.5px; }
  h1:focus { outline: none; }
  .lead { font-size: 18px; line-height: 1.6; color: var(--matn-ikkinchi); max-width: 60ch; }
  .namuna-izoh { font-size: 15px; color: var(--matn-ikkinchi); background: var(--fon-ikkinchi); border-radius: var(--r-orta); padding: var(--b-3) var(--b-4); max-width: 70ch; }
  .namuna-izoh[hidden] { display: none; }
  .namuna-izoh a, .chiziq-blok a { color: var(--rang-havola); font-weight: 700; }
  .ustki-yorliq { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--matn-sust); }
  .kok-yorliq { color: var(--rang-asosiy-qorada); }

  .korsatkich { display: grid; grid-template-columns: 2fr 1fr; gap: var(--b-4); }
  .qora-blok {
    background: var(--qora); color: var(--qora-matn);
    border: 1px solid var(--qora-chiziq);
    border-radius: var(--r-katta); padding: var(--b-6);
    display: flex; flex-direction: column; gap: 14px;
  }
  .bolim-qator { display: flex; flex-direction: column; gap: var(--b-2); }
  .bq-bosh { display: flex; justify-content: space-between; gap: var(--b-3); font-weight: 700; }
  .bq-iz { height: 8px; border-radius: var(--r-toliq); background: var(--qora-chiziq); overflow: hidden; }
  .bq-toldirish { height: 100%; width: 0; background: var(--rang-asosiy-qorada); border-radius: var(--r-toliq); }
  .chiziq-blok { border: 1.5px solid var(--matn); border-radius: var(--r-katta); padding: var(--b-6); display: flex; flex-direction: column; gap: 6px; }
  .kb-nom { font-size: var(--matn-kichik); font-weight: 600; color: var(--matn-ikkinchi); }
  .kb-son { font-size: 40px; font-weight: 900; line-height: 1.1; }
  .kb-izoh { font-size: var(--matn-kichik); color: var(--matn-sust); }
  .chiziq-blok a { margin-top: auto; padding-top: var(--b-2); font-size: 15px; }

  .tarix { display: flex; flex-direction: column; gap: var(--b-4); }
  .tarix-bosh { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--b-3); }
  .tarix h2 { font-size: 28px; font-weight: 800; }
  .segment { display: flex; flex-wrap: wrap; gap: 6px; padding: var(--b-1); background: var(--fon-ikkinchi); border-radius: var(--r-toliq); }
  .segment button {
    min-height: 44px; padding: 0 16px; border: 0; border-radius: var(--r-toliq);
    background: transparent; color: var(--matn-ikkinchi);
    font: inherit; font-weight: 700; font-size: var(--matn-kichik); cursor: pointer;
  }
  .segment button[aria-pressed='true'] { background: var(--matn); color: var(--fon); }
  .soni { opacity: 0.7; }
  .qatorlar { list-style: none; margin: 0; padding: 0; border: 1.5px solid var(--matn); border-radius: var(--r-katta); overflow: hidden; }
  .qatorlar[hidden] { display: none; }
  .qatorlar :global(li) { display: flex; align-items: center; gap: var(--b-4); padding: 16px 20px; }
  .qatorlar :global(li + li) { border-top: 1px solid var(--chiziq); }
  .qatorlar :global(.q-belgi) { width: 36px; height: 36px; flex: none; border-radius: var(--r-yon); display: flex; align-items: center; justify-content: center; color: var(--rang-asosiy-matn); }
  .qatorlar :global(.q-belgi.togri) { background: var(--rang-asosiy); }
  .qatorlar :global(.q-belgi.xato) { background: var(--matn); color: var(--fon); }
  .qatorlar :global(.q-matn) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--b-1); }
  .qatorlar :global(.q-mavzu) { font-weight: 700; font-size: 16px; }
  .qatorlar :global(.q-izoh) { font-size: var(--matn-kichik); color: var(--matn-sust); }
  .qatorlar :global(.qayta) {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); color: var(--matn);
    text-decoration: none; font-weight: 700; font-size: var(--matn-kichik); white-space: nowrap;
  }
  .qatorlar :global(.qayta:hover) { background: var(--chiziq); }
  .bosh-holat { padding: var(--b-8); text-align: center; background: var(--fon-ikkinchi); border-radius: var(--r-katta); color: var(--matn-ikkinchi); }
  .bosh-holat[hidden] { display: none; }

  .malumot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--b-4); background: var(--fon-ikkinchi); border-radius: var(--r-katta); padding: var(--b-6); }
  .malumot > div { display: flex; flex-direction: column; gap: var(--b-1); max-width: 56ch; }
  .m-sarlavha { font-weight: 800; }
  .m-matn { font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }
  .m-matn:empty { display: none; }
  .chiziq-tugma {
    min-height: 48px; padding: 0 22px; border: 1.5px solid var(--matn); border-radius: var(--r-toliq);
    background: var(--fon); color: var(--matn);
    font: inherit; font-weight: 700; font-size: 15px; cursor: pointer;
  }
  .chiziq-tugma:disabled { opacity: 0.5; cursor: not-allowed; }
  .asosiy-tugma {
    min-height: 48px; padding: 0 22px; border: 0; border-radius: var(--r-toliq);
    background: var(--rang-asosiy); color: var(--rang-asosiy-matn);
    font: inherit; font-weight: 700; font-size: 15px; cursor: pointer;
  }

  .tasdiq {
    border: 1px solid var(--chiziq); border-radius: var(--r-katta); padding: var(--b-6);
    width: min(440px, calc(100vw - 32px));
    background: var(--fon); color: var(--matn); box-shadow: var(--soya);
  }
  .tasdiq::backdrop { background: var(--parda); }
  .tasdiq form { display: flex; flex-direction: column; gap: var(--b-4); }
  .tasdiq h2 { font-size: var(--matn-h3); }
  .tasdiq p { color: var(--matn-ikkinchi); }
  .tasdiq-tugmalar { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--b-2); }

  @media (max-width: 760px) {
    .korsatkich { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .natija { padding-top: 28px; gap: var(--b-8); }
    h1 { font-size: 34px; }
    .qatorlar :global(li) { flex-wrap: wrap; padding: 14px 16px; }
    .qatorlar :global(.qayta) { margin-left: 52px; }
  }
</style>
