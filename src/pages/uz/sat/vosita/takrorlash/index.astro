---
// SAT Xato daftari: takrorlash (interaktiv darslar 2-bosqich, P09).
// Darslardagi xatolar (tayanch:sat-xato-daftari, faqat o'qiladi) Leitner qutilariga tushadi: tayanch:sat-takrorlash.
// Javob darsSaqlash.javobniYoz orqali yoziladi: dars progressi va daftar o'z shaklida yangilanadi.
// P09: hisob bilan savol banki xatolari va saqlangan savollar ham shu ro'yxatda (review_overview, review_preview,
// start_review_session → P08 sessiya sahifasi). Dars xatolari sababi: tayanch:sat-xato-sabab (src/lib/xatoSabab.ts).
// Oraliqlar (1, 3, 7, 14 kun) Tayanch tanlovi. Ball hisoblanmaydi. Mantiq: src/lib/takrorlash.ts, src/lib/sat/xatoDaftari.ts.
// Qoidalar: docs/xato-daftari.md. Dev mock: ?mock=toliq|bosh|xato|kvota (faqat DEV, src/lib/sat/xatoDaftariMock.ts).
// Telefon: bitta ustun, tugmalar to'liq kenglikda. Klaviatura: tablar strelka/Home/End, variantlar radio guruhi, Enter tekshiradi.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import SavolUslub from '../../../../../components/sat/SavolUslub.astro';
import { yol } from '../../../../../lib/yol';
import { hammaSavollar, modulNomi, type DarsModul } from '../../../../../data/satDarslar';
import { matn as umumiyMatn } from '../../../../../data/umumiyMatn';
import { TABLAR, TEG_FILTRLARI, IZOH_MAX } from '../../../../../lib/sat/xatoDaftari';
import { SABABLAR } from '../../../../../lib/sat/sessiya';

const T = umumiyMatn.en.dars;

const darsQism: Record<DarsModul, string> = {
  hajm: 'qollanma/math/hajm/',
  grafik: 'qollanma/math/grafik/',
  aylana: 'qollanma/math/birlik-aylana/',
  statistika: 'qollanma/math/statistika/',
  'rw-xato': 'qollanma/reading-writing/xatoni-toping/',
  'rw-dalil': 'qollanma/reading-writing/dalil/',
  'rw-otish': 'qollanma/reading-writing/otish-sozlari/',
  'rw-lugat': 'qollanma/reading-writing/lugat-kontekstda/',
};
// Dars sahifalaridagi savolKorsatma bilan bir xil; "Xatoni toping" da joy belgilash bosqichi bu yerda yo'q.
const korsatma: Partial<Record<DarsModul, string>> = {
  'rw-xato': 'Choose the option that correctly fixes the error in the sentence.',
  'rw-otish': 'Choose the most logical transition word for the blank.',
  'rw-lugat': 'Read the sentence and choose the most logical and precise word or meaning.',
};
const darslar = (Object.keys(darsQism) as DarsModul[]).map((m) => ({ modul: m, nomi: modulNomi[m], href: yol(`/uz/sat/${darsQism[m]}`) }));

const malumot = {
  savollar: hammaSavollar.map((s) => {
    return {
      id: s.id, modul: s.modul, mavzu: s.mavzu, qiyinlik: T.qiyinlik[s.qiyinlik], verified: s.verified,
      matn: s.matn, yechim: s.yechim, togri: s.togri,
      variantlar: s.variantlar.map((v) => v.matn), xatolar: s.variantlar.map((v) => v.xato ?? ''),
      korsatma: korsatma[s.modul] ?? '',
    };
  }),
  darslar: Object.fromEntries(darslar.map((d) => [d.modul, { nomi: d.nomi, href: d.href }])),
};
const sahifaUrl = yol('/uz/sat/vosita/takrorlash/');
---
<BolimQobiq
  title="Mistake log: review · SAT"
  description="Spaced review of the questions you got wrong in the SAT lessons and the question bank: after 1, 3, 7 and 14 days. Lesson mistakes stay in this browser; question bank mistakes and saved questions are in your account. No score is calculated."
  turi="vosita"
  yol={['Practice']}
  bolim="sat"
  holat="qoralama"
>
  <SavolUslub />
  <div class="ichki takror" id="takror" data-sessiya-url={yol('/uz/sat/mashq/sessiya/')} data-kirish-url={yol('/uz/hisob/kirish/')} data-sahifa-url={sahifaUrl}>
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Tool</span><span class="pill pill-chiziq">Draft</span></p>
      <h1>Mistake log: review</h1>
      <p class="lead">Questions you got wrong in the lessons and the question bank land here and come back at intervals: tomorrow, then after 3, 7 and 14 days. Solve one correctly and it moves to the next box; get it wrong and it goes back to the start. Note why you missed it, so you fix the cause, not just the answer.</p>
    </header>

    <p class="kichik ikkinchi">Sample questions written for Tayanch, not official SAT questions. No score is calculated. The intervals are Tayanch's choice.</p>

    <div class="hisob-holat" id="hisob-holat" hidden>
      <p id="hisob-matn" aria-live="polite"></p>
      <a class="matn-tugma kok-tugma" id="kirish-havola" href="#" hidden>Sign in</a>
      <button type="button" class="matn-tugma kok-tugma" id="hisob-qayta" hidden>Try again</button>
    </div>

    <section class="royxat" id="royxat" aria-labelledby="royxat-h">
      <h2 id="royxat-h" tabindex="-1">Today's review</h2>
      <p class="holat-matn" id="holat-matn"></p>
      <div class="tugmalar">
        <button type="button" class="katta asosiy" id="boshla" hidden>Start review</button>
        <button type="button" class="katta asosiy" id="bank-boshla" hidden>Review practice questions</button>
        <button type="button" class="katta ikkinchi" id="oldin" hidden>Review upcoming ones now</button>
      </div>
      <p class="bank-xato" id="bank-xato" role="status"></p>

      <div class="darslar" id="darslar" hidden>
        <h3>Lessons</h3>
        <ul>
          {darslar.map((d) => <li><a href={d.href}>{d.nomi}</a></li>)}
        </ul>
      </div>

      <div class="tablar" role="tablist" aria-label="Mistake log lists" id="tablar">
        {TABLAR.map((t, i) => (
          <button type="button" role="tab" class="tab" id={`tab-${t.kalit}`} data-tab={t.kalit}
            aria-selected={i === 0 ? 'true' : 'false'} aria-controls="tab-panel" tabindex={i === 0 ? '0' : '-1'}>
            <span>{t.nomi}</span> <span class="tab-son" id={`son-${t.kalit}`}>0</span>
          </button>
        ))}
      </div>

      <div class="filtr" role="group" aria-labelledby="filtr-h" id="filtr">
        <p class="filtr-h" id="filtr-h">Reason</p>
        <div class="filtr-chiplar">
          {TEG_FILTRLARI.map((t, i) => (
            <button type="button" class="chip" data-teg={t.kalit} aria-pressed={i === 0 ? 'true' : 'false'}>
              {t.nomi} <span class="chip-son" data-teg-son={t.kalit}>0</span>
            </button>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="tab-panel" role="tabpanel" aria-labelledby="tab-due" tabindex="0">
        <p class="bosh-matn" id="bosh-matn" hidden></p>
        <ul class="bandlar" id="bandlar"></ul>
      </div>
    </section>

    <section class="sessiya" id="sessiya" aria-labelledby="sessiya-h" hidden>
      <div class="s-bosh">
        <h2 id="sessiya-h">Review</h2>
        <p class="kichik ikkinchi" id="s-hisob" aria-live="polite"></p>
      </div>
      <form class="savol-karta" id="karta" novalidate>
        <fieldset class="savol" id="savol">
          <legend class="sr" id="s-legend"></legend>
          <p class="s-meta" id="s-meta"></p>
          <p class="s-korsatma" id="s-korsatma"></p>
          <p class="s-matn" id="s-matn" tabindex="-1"></p>
          <div class="variantlar" id="variantlar"></div>
          <div class="izoh" id="izoh" aria-live="polite" hidden>
            <p class="izoh-sarlavha" id="izoh-sarlavha"></p>
            <p class="izoh-xato" id="izoh-xato"></p>
            <p class="izoh-keyingi" id="izoh-keyingi"></p>
            <p><b>Solution.</b> <span id="izoh-yechim"></span></p>
          </div>
          <div class="s-tugmalar">
            <a class="matn-tugma kok-tugma" id="s-dars" href="#">Go to the lesson</a>
            <button type="submit" class="katta asosiy" id="tekshir" disabled>Check</button>
            <button type="button" class="katta qora" id="keyingi" hidden>Next</button>
          </div>
        </fieldset>
      </form>
      <div class="yakun" id="yakun" hidden>
        <p class="yakun-matn" id="yakun-matn" tabindex="-1"></p>
        <button type="button" class="katta asosiy" id="qaytish">Back to the list</button>
      </div>
      <button type="button" class="matn-tugma" id="toxtat">Stop review</button>
    </section>

    <div class="tozalash">
      <button type="button" class="matn-tugma" id="tozala">Delete review history</button>
      <span class="tasdiq" id="tasdiq" hidden>Delete the boxes and dates? The mistake log in the lessons stays.
        <button type="button" class="matn-tugma" id="tasdiq-ha">Yes, delete</button>
        <button type="button" class="matn-tugma" id="tasdiq-yoq">Cancel</button>
      </span>
      <p class="kichik ikkinchi" id="saqlash-holat" aria-live="polite">Review progress is saved only in this browser.</p>
    </div>

    <ManbaBlok
      manbalar={[]}
      tekshirilgan="2026-11-06"
      keyingiTekshiruv="2026-12-06"
      tekshirilmagan={[
        "The review intervals (1, 3, 7, 14 days) are Tayanch's choice, not an official recommendation.",
        'The questions are samples written for Tayanch; those not yet reviewed by the author are labeled "not verified".',
        "On this page, \"Find the error\" questions have no step for marking the error's location: only the revision is chosen.",
      ]}
    />
  </div>
  <template id="sabab-shablon">
    <fieldset class="sabab">
      <legend class="sabab-h">Why I missed it</legend>
      <div class="sabab-chiplar">
        {SABABLAR.map((s) => <button type="button" class="chip" data-sabab={s.kalit} aria-pressed="false">{s.nomi}</button>)}
      </div>
      <label class="izoh-yorliq">Your note (optional)
        <textarea class="izoh-maydon" rows="2" maxlength={IZOH_MAX}></textarea>
      </label>
      <p class="sabab-holat" aria-live="polite"></p>
    </fieldset>
  </template>
  <script type="application/json" id="takror-malumot" set:html={JSON.stringify(malumot)} />
</BolimQobiq>

<script>
  import { javobniYoz, bugun } from '../../../../../lib/darsSaqlash';
  import { holatOchir } from '../../../../../lib/holat';
  import { sinxronla, guruhla, javobdanKeyin, holatniYoz, takrorKalit, type TakrorHolat } from '../../../../../lib/takrorlash';
  import { sababOqi, sababYoz } from '../../../../../lib/xatoSabab';
  import { hisobMijoz } from '../../../../../lib/hisob';
  import { SESSIYA_KALITI, xatoTuri } from '../../../../../lib/savolBanki';
  import { xavfsizMatn } from '../../../../../lib/sat/xavfsizMatn';
  import { SABABLAR, type Sabab } from '../../../../../lib/sat/sessiya';
  import {
    TABLAR, TEG_FILTRLARI, bankdanBand, tabBandlari, tabSonlari, tegSonlari, tegMos, tabTogrimi, holatMatni, dueSoni,
    qisqaMatn, navbatda, sanaMatn,
    type Band, type Tab, type TegFiltr, type DaftarApi, type BankSavol,
  } from '../../../../../lib/sat/xatoDaftari';

  interface S {
    id: string; modul: string; mavzu: string; qiyinlik: string; verified: boolean;
    matn: string; yechim: string; togri: number; variantlar: string[]; xatolar: string[];
    korsatma: string;
  }
  type HisobHolat = 'yoq' | 'anon' | 'yuklash' | 'xato' | 'tayyor';
  const BOLIM = 'sat';
  const HARF = 'ABCD';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const ildiz = $('takror');
  const M = JSON.parse($('takror-malumot').textContent || '{}') as { savollar: S[]; darslar: Record<string, { nomi: string; href: string }> };
  const savol = new Map(M.savollar.map((s) => [s.id, s]));
  const qisqa = (t: string) => (t.length > 80 ? `${t.slice(0, 77)}…` : t);
  const SABAB_NOMI = Object.fromEntries(SABABLAR.map((s) => [s.kalit, s.nomi])) as Record<Sabab, string>;

  let holat: TakrorHolat = sinxronla(BOLIM, new Set(savol.keys()));
  let navbat: string[] = [];
  let joriy = 0;
  let togriSoni = 0;

  // ---------- Hisob (savol banki) ----------
  let api: DaftarApi | null = null;
  let mockTur: string | null = null;
  let hisob: HisobHolat = 'yoq';
  let bankBandlar: Band[] = [];
  let serverKun: string | null = null;
  let bankBand = false;
  const ochishKesh = new Map<string, Promise<BankSavol>>();

  // ---------- Ro'yxat holati ----------
  const boshTab = new URLSearchParams(location.search).get('tab');
  let tab: Tab = tabTogrimi(boshTab) ? boshTab : 'due';
  let filtr: TegFiltr = 'all';
  const ochiq = new Set<string>();

  const kun = () => serverKun ?? bugun();

  const saqlashHolati = (ok: boolean) => {
    $('saqlash-holat').textContent = ok
      ? 'Review progress is saved only in this browser.'
      : 'The browser did not allow saving: review progress will be lost when the page is closed.';
  };

  function darsBandlari(): Band[] {
    const sabab = sababOqi(BOLIM).savollar;
    return Object.entries(holat.savollar).filter(([id]) => savol.has(id)).map(([id, y]) => {
      const s = savol.get(id)!;
      const sb = sabab[id];
      return {
        kalit: `dars:${id}`, manba: 'dars' as const, id,
        mavzu: `${M.darslar[s.modul]?.nomi ?? s.modul} · ${s.mavzu}`,
        qiyinlik: s.qiyinlik, qisqa: qisqaMatn(s.matn),
        quti: y.quti, keyingi: y.keyingi,
        teg: (sb?.teg ?? null) as Sabab | null, izoh: sb?.izoh ?? '', saqlangan: false,
      };
    });
  }
  const hammaBandlar = () => [...darsBandlari(), ...bankBandlar];

  // ---------- Hisob holati ----------
  function hisobChiz() {
    const b = $('hisob-holat');
    const k = $<HTMLAnchorElement>('kirish-havola');
    const q = $<HTMLButtonElement>('hisob-qayta');
    b.hidden = hisob === 'yoq';
    k.hidden = hisob !== 'anon';
    q.hidden = hisob !== 'xato';
    $('hisob-matn').textContent = {
      yoq: '',
      anon: 'Question bank mistakes and saved questions need a Tayanch account. Lesson mistakes stay in this browser.',
      yuklash: 'Loading your question bank mistakes…',
      xato: "Couldn't load your question bank mistakes. Lesson mistakes are below.",
      tayyor: 'Question bank mistakes and saved questions are in your account. Lesson mistakes stay in this browser.',
    }[hisob];
  }

  // ---------- Ro'yxat ----------
  function royxatniChiz() {
    const g = guruhla(holat, bugun());
    const hamma = hammaBandlar();
    const sonlar = tabSonlari(hamma, kun());
    const due = dueSoni(hamma, kun());
    const keyin = hamma.filter((b) => navbatda(b) && b.quti! < 5 && b.keyingi! > kun()).sort((a, b) => a.keyingi!.localeCompare(b.keyingi!));
    const jami = hamma.filter(navbatda).length;
    const dueJami = due.dars + due.bank;

    $('holat-matn').textContent = jami === 0
      ? 'The mistake log is empty. Exercises you get wrong in the lessons land here and are reviewed the next day.'
      : dueJami > 0
        ? `Today you have ${dueJami} ${dueJami === 1 ? 'exercise' : 'exercises'} to review.`
        : keyin.length > 0
          ? `Nothing to review today. Next: ${sanaMatn(keyin[0].keyingi!)}.`
          : 'All mistakes are mastered. New mistakes will come from the lessons.';

    const bankBor = hisob === 'tayyor';
    const boshla = $<HTMLButtonElement>('boshla');
    boshla.hidden = g.bugun.length === 0;
    boshla.textContent = bankBor ? `Review lessons (${g.bugun.length})` : `Start review (${g.bugun.length})`;
    const bb = $<HTMLButtonElement>('bank-boshla');
    bb.hidden = !bankBor || due.bank === 0;
    bb.textContent = `Review practice questions (${due.bank})`;
    $<HTMLButtonElement>('oldin').hidden = !(g.bugun.length === 0 && g.keyinroq.length > 0);
    $<HTMLButtonElement>('oldin').textContent = bankBor ? 'Review upcoming lessons now' : 'Review upcoming ones now';
    $('darslar').hidden = !(g.bugun.length + g.keyinroq.length + g.ozlashtirildi.length === 0 || (g.bugun.length === 0 && g.keyinroq.length === 0));

    for (const t of TABLAR) $(`son-${t.kalit}`).textContent = String(sonlar[t.kalit]);
    tablarChiz();
    panelChiz(hamma);
    return g;
  }

  function tablarChiz() {
    for (const t of TABLAR) {
      const el = $(`tab-${t.kalit}`);
      const tanlangan = t.kalit === tab;
      el.setAttribute('aria-selected', String(tanlangan));
      el.tabIndex = tanlangan ? 0 : -1;
    }
    $('tab-panel').setAttribute('aria-labelledby', `tab-${tab}`);
  }

  function filtrChiz(tabda: Band[]) {
    const s = tegSonlari(tabda);
    $('filtr').hidden = tabda.length === 0;
    document.querySelectorAll<HTMLButtonElement>('#filtr [data-teg]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.teg === filtr));
    });
    document.querySelectorAll<HTMLElement>('#filtr [data-teg-son]').forEach((e) => {
      e.textContent = String(s[e.dataset.tegSon as TegFiltr] ?? 0);
    });
  }

  function boshMatni(tabda: number): string {
    if (tabda > 0) return 'No questions with this reason in this list.';
    if (tab === 'due') return 'Nothing is due today.';
    if (tab === 'all') return 'No open mistakes. Questions you get wrong will appear here.';
    if (tab === 'saved') {
      return hisob === 'tayyor'
        ? 'No saved questions yet. Use "Save question" in a practice session.'
        : 'Saved questions come from the question bank and need a Tayanch account.';
    }
    return 'Nothing mastered yet. A question is mastered after 4 correct reviews in a row: tomorrow, then after 3, 7 and 14 days.';
  }

  function panelChiz(hamma = hammaBandlar()) {
    const tabda = tabBandlari(hamma, tab, kun());
    filtrChiz(tabda);
    const korinadi = tabda.filter((b) => tegMos(b, filtr));
    const bosh = $('bosh-matn');
    bosh.hidden = korinadi.length > 0;
    bosh.textContent = korinadi.length ? '' : boshMatni(tabda.length);
    $('bandlar').replaceChildren(...korinadi.map((b, i) => bandQator(b, i)));
  }

  function pill(t: string, cls = 'pill') { const p = document.createElement('span'); p.className = cls; p.textContent = t; return p; }
  function el<K extends keyof HTMLElementTagNameMap>(teg: K, cls?: string, matn?: string) {
    const e = document.createElement(teg);
    if (cls) e.className = cls;
    if (matn !== undefined) e.textContent = matn;
    return e;
  }

  function bandQator(b: Band, i: number): HTMLLIElement {
    const li = el('li', 'band');
    const meta = el('p', 'b-meta');
    const mavzuEl = el('span', 'b-mavzu', b.mavzu);
    mavzuEl.id = `band-${i}-mavzu`;
    meta.append(pill(b.manba === 'dars' ? 'Lesson' : 'Question bank'), pill(b.qiyinlik), mavzuEl);
    const holatEl = el('span', 'b-holat', holatMatni(b, kun()));
    meta.append(holatEl);
    const tegEl = el('span', 'pill pill-teg');
    const tegYoz = () => { tegEl.hidden = !b.teg; tegEl.textContent = b.teg ? SABAB_NOMI[b.teg] : ''; };
    tegYoz();
    meta.append(tegEl);
    li.append(meta, el('p', 'b-qisqa', b.qisqa));

    const amal = el('div', 'b-amal');
    const och = el('button', 'matn-tugma kok-tugma', 'Show question');
    och.type = 'button';
    const tanaId = `band-${i}`;
    och.setAttribute('aria-controls', tanaId);
    och.setAttribute('aria-describedby', mavzuEl.id);
    amal.append(och);
    li.append(amal);

    const tana = el('div', 'b-tana');
    tana.id = tanaId;
    tana.hidden = true;
    li.append(tana);

    const ochGa = (on: boolean) => {
      och.setAttribute('aria-expanded', String(on));
      och.textContent = on ? 'Hide question' : 'Show question';
      tana.hidden = !on;
      if (on) ochiq.add(b.kalit); else ochiq.delete(b.kalit);
      if (on && !tana.childElementCount) tanaQur(b, tana, tegYoz, mavzuEl.id);
    };
    och.addEventListener('click', () => ochGa(tana.hidden));
    ochGa(ochiq.has(b.kalit));
    return li;
  }

  function tanaQur(b: Band, tana: HTMLElement, tegYoz: () => void, mavzuId: string) {
    const savolJoy = el('div', 'b-savol');
    tana.append(savolJoy);
    if (b.manba === 'dars') {
      const s = savol.get(b.id)!;
      if (s.korsatma) savolJoy.append(el('p', 's-korsatma', s.korsatma));
      savolJoy.append(el('p', 'b-matn', s.matn));
      const ol = el('ol', 'b-variantlar');
      s.variantlar.forEach((t, j) => { const li = el('li'); li.append(el('span', 'harf', HARF[j]), el('span', 'v-matn', t)); ol.append(li); });
      savolJoy.append(ol);
    } else {
      bankSavolChiz(b.id, savolJoy);
    }
    tana.append(el('p', 'kichik ikkinchi', 'The answer is hidden here. Check yourself in a review session.'));

    if (navbatda(b)) tana.append(sababQur(b, tegYoz, mavzuId));
    if (b.manba === 'bank') tana.append(saqlaQur(b, mavzuId));
  }

  async function bankSavolChiz(qid: string, joy: HTMLElement) {
    if (!api) return;
    const yukla = el('p', 'kichik ikkinchi', 'Loading the question…');
    joy.replaceChildren(yukla);
    try {
      let p = ochishKesh.get(qid);
      if (!p) { p = api.ochish(qid); ochishKesh.set(qid, p); }
      const q = await p;
      const parcha = q.passage ? el('div', 'b-parcha sk-parcha') : null;
      const matn = el('div', 'b-matn');
      const ol = el('ol', 'b-variantlar');
      joy.replaceChildren(...[parcha, matn, ol].filter(Boolean) as HTMLElement[]);
      if (q.figure) {
        const src = await api.rasm(q.figure.path).catch(() => null);
        const f = el('figure', 'b-rasm');
        if (src) { const img = el('img'); img.src = src; img.alt = q.figure.alt ?? ''; f.append(img); }
        else f.append(el('p', 'kichik ikkinchi', q.figure.alt ? `Figure: ${q.figure.alt}` : 'Figure not available.'));
        if (q.figure.caption) f.append(el('figcaption', 'kichik ikkinchi', q.figure.caption));
        joy.insertBefore(f, matn);
      }
      const ishlar: Promise<void>[] = [];
      if (parcha) ishlar.push(xavfsizMatn(q.passage!, parcha));
      ishlar.push(xavfsizMatn(q.stem, matn));
      for (const o of q.options ?? []) {
        const li = el('li');
        const t = el('span', 'v-matn');
        li.append(el('span', 'harf', o.key), t);
        ol.append(li);
        ishlar.push(xavfsizMatn(o.text, t));
      }
      if (!q.options?.length) ol.remove();
      if (q.format === 'spr') joy.append(el('p', 'kichik ikkinchi', 'Student-produced response: you type the answer.'));
      await Promise.all(ishlar);
    } catch {
      ochishKesh.delete(qid);
      const p = el('p', 'b-xato', "Couldn't open this question. ");
      const q = el('button', 'matn-tugma kok-tugma', 'Try again');
      q.type = 'button';
      q.addEventListener('click', () => bankSavolChiz(qid, joy));
      p.append(q);
      joy.replaceChildren(p);
    }
  }

  function sababQur(b: Band, tegYoz: () => void, mavzuId: string): HTMLElement {
    const f = ($<HTMLTemplateElement>('sabab-shablon').content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    f.setAttribute('aria-describedby', mavzuId);
    const holatEl = f.querySelector<HTMLElement>('.sabab-holat')!;
    const tugmalar = [...f.querySelectorAll<HTMLButtonElement>('[data-sabab]')];
    const chiz = () => tugmalar.forEach((t) => t.setAttribute('aria-pressed', String(b.teg === t.dataset.sabab)));
    chiz();
    const maydon = f.querySelector<HTMLTextAreaElement>('textarea')!;
    maydon.value = b.izoh;
    const yangilash = () => { tegYoz(); filtrChiz(tabBandlari(hammaBandlar(), tab, kun())); };

    tugmalar.forEach((t) => t.addEventListener('click', async () => {
      const eski = b.teg;
      const yangi = b.teg === t.dataset.sabab ? null : (t.dataset.sabab as Sabab);
      b.teg = yangi;
      chiz();
      t.setAttribute('aria-busy', 'true');
      const ok = await sababSaqla(b, { teg: yangi });
      t.removeAttribute('aria-busy');
      if (!ok) { b.teg = eski; chiz(); }
      holatEl.textContent = ok ? (yangi ? `Reason saved: ${SABAB_NOMI[yangi]}.` : 'Reason cleared.') : "Couldn't save the reason. Try again.";
      yangilash();
    }));
    maydon.addEventListener('change', async () => {
      const eski = b.izoh;
      const yangi = maydon.value.slice(0, 1000);
      if (yangi === eski) return;
      b.izoh = yangi;
      const ok = await sababSaqla(b, { izoh: yangi });
      if (!ok) b.izoh = eski;
      holatEl.textContent = ok ? 'Note saved.' : "Couldn't save the note. It is still in the box: try again.";
    });
    return f;
  }

  async function sababSaqla(b: Band, o: { teg?: Sabab | null; izoh?: string }): Promise<boolean> {
    if (b.manba === 'dars') return sababYoz(BOLIM, b.id, o);
    if (!api) return false;
    try {
      if ('teg' in o) await api.teg(b.id, o.teg ?? null);
      if ('izoh' in o) await api.izoh(b.id, o.izoh ?? '');
      return true;
    } catch {
      return false;
    }
  }

  function saqlaQur(b: Band, mavzuId: string): HTMLElement {
    const qator = el('div', 'b-saqla');
    const t = el('button', 'kichik-tugma', 'Save question');
    t.type = 'button';
    t.setAttribute('aria-describedby', mavzuId);
    const xabar = el('p', 'sabab-holat');
    xabar.setAttribute('aria-live', 'polite');
    const chiz = () => t.setAttribute('aria-pressed', String(b.saqlangan));
    chiz();
    t.addEventListener('click', async () => {
      if (!api || t.getAttribute('aria-busy')) return;
      const on = !b.saqlangan;
      b.saqlangan = on;
      chiz();
      t.setAttribute('aria-busy', 'true');
      try {
        await api.saqla(b.id, on);
        xabar.textContent = on ? 'Saved.' : 'Removed from saved questions.';
      } catch {
        b.saqlangan = !on;
        chiz();
        xabar.textContent = "Couldn't update saved questions. Try again.";
      }
      t.removeAttribute('aria-busy');
      $('son-saved').textContent = String(tabSonlari(hammaBandlar(), kun()).saved);
    });
    qator.append(t, xabar);
    return qator;
  }

  // ---------- Tablar va filtr ----------
  function tabTanla(t: Tab, fokus: boolean) {
    tab = t;
    filtr = 'all';
    try {
      const u = new URL(location.href);
      if (t === 'due') u.searchParams.delete('tab'); else u.searchParams.set('tab', t);
      history.replaceState(null, '', u.pathname + u.search + u.hash);
    } catch { /* */ }
    tablarChiz();
    panelChiz();
    if (fokus) $(`tab-${t}`).focus();
  }
  $('tablar').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (b && tabTogrimi(b.dataset.tab)) tabTanla(b.dataset.tab, false);
  });
  $('tablar').addEventListener('keydown', (e) => {
    const i = TABLAR.findIndex((t) => t.kalit === tab);
    const n = TABLAR.length;
    const k = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
    if (k < 0) return;
    e.preventDefault();
    tabTanla(TABLAR[k].kalit, true);
  });
  $('filtr').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-teg]');
    if (!b) return;
    const f = b.dataset.teg as TegFiltr;
    filtr = filtr === f && f !== 'all' ? 'all' : f;
    panelChiz();
  });

  // ---------- Savol banki: review sessiya (P08) ----------
  $('bank-boshla').addEventListener('click', async () => {
    const t = $<HTMLButtonElement>('bank-boshla');
    if (!api || bankBand) return;
    bankBand = true;
    t.setAttribute('aria-busy', 'true');
    $('bank-xato').textContent = 'Starting the review session…';
    try {
      const r = await api.takrorla();
      if (!r.session_id) {
        $('bank-xato').textContent = 'Nothing is due today in the question bank.';
        await bankYukla();
      } else {
        try { sessionStorage.setItem(SESSIYA_KALITI, JSON.stringify(r)); } catch { /* sessiya sahifasi id bilan so'raydi */ }
        const mock = mockTur ? '&mock=oddiy' : '';
        location.assign(`${ildiz.dataset.sessiyaUrl}?id=${encodeURIComponent(r.session_id)}${mock}`);
        return;
      }
    } catch (e) {
      const tur = xatoTuri(e);
      $('bank-xato').textContent = tur === 'kvota'
        ? "You've reached today's limit for review sessions. Lesson review still works."
        : tur === 'kirish' ? 'Sign in again to start a review session.'
          : tur === 'tarmoq' ? "Couldn't reach the server. Check your connection and try again." : "The review session didn't start. Try again.";
    }
    bankBand = false;
    t.removeAttribute('aria-busy');
  });

  async function bankYukla() {
    if (!api) return;
    hisob = 'yuklash';
    hisobChiz();
    try {
      const r = await api.royxat();
      serverKun = /^\d{4}-\d{2}-\d{2}$/.test(String(r.today)) ? r.today : null;
      bankBandlar = (r.items ?? []).map(bankdanBand).filter((b): b is Band => !!b);
      hisob = 'tayyor';
    } catch (e) {
      hisob = xatoTuri(e) === 'kirish' ? 'anon' : 'xato';
      bankBandlar = [];
    }
    hisobChiz();
    if ($('sessiya').hidden) royxatniChiz();
  }
  $('hisob-qayta').addEventListener('click', () => bankYukla());
  $<HTMLAnchorElement>('kirish-havola').href = `${ildiz.dataset.kirishUrl}?keyin=${encodeURIComponent(ildiz.dataset.sahifaUrl!)}`;

  async function hisobniUla() {
    if (import.meta.env.DEV) {
      const mock = new URLSearchParams(location.search).get('mock');
      if (mock) {
        const m = await import('../../../../../lib/sat/xatoDaftariMock');
        if (new URLSearchParams(location.search).get('tozala') === '1') m.mockTozala();
        api = m.mockApi(mock as Parameters<typeof m.mockApi>[0]);
        mockTur = mock;
        return bankYukla();
      }
    }
    const c = hisobMijoz();
    if (!c) { hisob = 'yoq'; return hisobChiz(); }
    const { data } = await c.auth.getSession();
    if (!data.session) { hisob = 'anon'; hisobChiz(); return royxatniChiz(); }
    api = haqiqiyApi(c);
    return bankYukla();
  }

  function haqiqiyApi(c: NonNullable<ReturnType<typeof hisobMijoz>>): DaftarApi {
    const rpc = async <T,>(nom: string, args?: Record<string, unknown>): Promise<T> => {
      const { data, error } = await c.rpc(nom, args);
      if (error) throw error;
      return data as T;
    };
    const tekshir = (error: unknown) => { if (error) throw error; };
    return {
      royxat: () => rpc('review_overview'),
      ochish: (qid) => rpc('review_preview', { p_question: qid }),
      teg: async (qid, teg) => tekshir((await c.from('review_queue').update({ reason_tag: teg }).eq('question_id', qid)).error),
      izoh: async (qid, izoh) => tekshir((await c.from('review_queue').update({ note: izoh.trim() ? izoh : null }).eq('question_id', qid)).error),
      saqla: async (qid, on) => {
        const { error } = on
          ? await c.from('bookmarks').insert({ question_id: qid })
          : await c.from('bookmarks').delete().eq('question_id', qid);
        if (error && error.code !== '23505') throw error;
      },
      takrorla: () => rpc('start_review_session', { p_limit: null }),
      rasm: async (path) => {
        const { data, error } = await c.storage.from('question-figures').createSignedUrl(path, 3600);
        return error ? null : data.signedUrl;
      },
    };
  }

  // ---------- Sessiya (darslar, o'zgarmagan) ----------
  function boshla(ids: string[]) {
    navbat = ids; joriy = 0; togriSoni = 0;
    $('royxat').hidden = true;
    $('sessiya').hidden = false;
    $('karta').hidden = false;
    $('yakun').hidden = true;
    $('toxtat').hidden = false;
    korsat();
  }

  function korsat() {
    const s = savol.get(navbat[joriy])!;
    $('s-hisob').textContent = `${joriy + 1} / ${navbat.length}`;
    $('s-legend').textContent = `Question ${joriy + 1} of ${navbat.length}`;
    const meta = $('s-meta');
    const mavzu = document.createElement('span'); mavzu.className = 'kichik ikkinchi';
    mavzu.textContent = `${M.darslar[s.modul]?.nomi ?? s.modul} · ${s.mavzu}`;
    meta.replaceChildren(pill('Sample'), pill(s.qiyinlik), mavzu, ...(s.verified ? [] : [pill('not verified', 'pill pill-ogoh')]));
    $('s-korsatma').textContent = s.korsatma;
    $('s-korsatma').hidden = !s.korsatma;
    const matn = $('s-matn');
    matn.textContent = s.matn;

    const v = $('variantlar');
    v.replaceChildren(...s.variantlar.map((t, j) => {
      const l = document.createElement('label'); l.className = 'variant';
      const inp = document.createElement('input'); inp.type = 'radio'; inp.name = 'takror-v'; inp.value = String(j);
      inp.addEventListener('change', () => { $<HTMLButtonElement>('tekshir').disabled = false; });
      const h = document.createElement('span'); h.className = 'harf'; h.setAttribute('aria-hidden', 'true'); h.textContent = HARF[j];
      const m = document.createElement('span'); m.className = 'v-matn'; m.textContent = t;
      l.append(inp, h, m);
      return l;
    }));
    $('izoh').hidden = true;
    $<HTMLButtonElement>('tekshir').hidden = false;
    $<HTMLButtonElement>('tekshir').disabled = true;
    $<HTMLButtonElement>('keyingi').hidden = true;
    $<HTMLButtonElement>('keyingi').textContent = joriy < navbat.length - 1 ? 'Next' : 'Finish';
    $<HTMLAnchorElement>('s-dars').href = M.darslar[s.modul]?.href ?? '#';
    matn.focus({ preventScroll: true });
    $('sessiya').scrollIntoView({ block: 'start', behavior: 'auto' });
  }

  $('karta').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!$('izoh').hidden) return;
    const s = savol.get(navbat[joriy])!;
    const tanlangan = document.querySelector<HTMLInputElement>('#variantlar input:checked');
    if (!tanlangan) return;
    const j = Number(tanlangan.value);
    const togrimi = j === s.togri;
    if (togrimi) togriSoni++;

    document.querySelectorAll<HTMLInputElement>('#variantlar input').forEach((x) => { x.disabled = true; });
    const labellar = document.querySelectorAll('#variantlar .variant');
    labellar[s.togri].classList.add('togri');
    if (!togrimi) labellar[j].classList.add('xato');

    const kunBugun = bugun();
    const yangi = javobdanKeyin(holat.savollar[s.id], togrimi, kunBugun);
    holat.savollar[s.id] = yangi;
    const ok1 = javobniYoz(BOLIM, s.modul, s.id, togrimi, qisqa(s.variantlar[j]));
    const ok2 = holatniYoz(BOLIM, holat);
    saqlashHolati(ok1 && ok2);

    const izoh = $('izoh');
    izoh.classList.toggle('izoh-togri', togrimi);
    $('izoh-sarlavha').textContent = togrimi ? 'Correct.' : `Wrong. The correct answer: ${HARF[s.togri]}) ${s.variantlar[s.togri]}`;
    $('izoh-xato').textContent = !togrimi && s.xatolar[j] ? `Typical mistake: ${s.xatolar[j]}.` : '';
    $('izoh-keyingi').textContent = yangi.quti === 5
      ? 'Mastered: this exercise will not be reviewed again.'
      : togrimi
        ? `Box ${yangi.quti}. Next review: ${sanaMatn(yangi.keyingi)}.`
        : `Back to box 1. Next review: ${sanaMatn(yangi.keyingi)}.`;
    $('izoh-yechim').textContent = s.yechim;
    izoh.hidden = false;
    $<HTMLButtonElement>('tekshir').hidden = true;
    $<HTMLButtonElement>('keyingi').hidden = false;
    // Tekshirish tugmasi yashirindi: fokus yo'qolmasin (WCAG 2.4.3), natija aria-live orqali o'qiladi
    $('keyingi').focus({ preventScroll: true });
  });

  $('keyingi').addEventListener('click', () => {
    if (joriy < navbat.length - 1) { joriy++; korsat(); return; }
    $('karta').hidden = true;
    $('toxtat').hidden = true;
    $('yakun').hidden = false;
    $('s-hisob').textContent = '';
    const g = guruhla(holat, bugun());
    $('yakun-matn').textContent = `${togriSoni} of ${navbat.length} correct. ${g.bugun.length > 0 ? `${g.bugun.length} more left for today.` : "Today's review is done."}`;
    $('yakun-matn').focus();
  });

  const royxatgaQayt = () => {
    $('sessiya').hidden = true;
    $('royxat').hidden = false;
    royxatniChiz();
    $('royxat-h').focus();
  };
  $('qaytish').addEventListener('click', royxatgaQayt);
  $('toxtat').addEventListener('click', royxatgaQayt);
  $('boshla').addEventListener('click', () => boshla(guruhla(holat, bugun()).bugun));
  $('oldin').addEventListener('click', () => boshla(guruhla(holat, bugun()).keyinroq));

  // ---------- O'chirish: sahifa ichidagi tasdiq ----------
  const tozala = $<HTMLButtonElement>('tozala');
  tozala.addEventListener('click', () => { $('tasdiq').hidden = false; tozala.hidden = true; $('tasdiq-yoq').focus(); });
  $('tasdiq-yoq').addEventListener('click', () => { $('tasdiq').hidden = true; tozala.hidden = false; tozala.focus(); });
  $('tasdiq-ha').addEventListener('click', () => {
    holatOchir(takrorKalit(BOLIM));
    holat = sinxronla(BOLIM, new Set(savol.keys()));
    $('tasdiq').hidden = true; tozala.hidden = false;
    if (!$('sessiya').hidden) royxatgaQayt(); else royxatniChiz();
    $('saqlash-holat').textContent = 'Review history deleted. The mistakes in the log start again from box 1.';
    tozala.focus();
  });

  royxatniChiz();
  hisobniUla();
</script>

