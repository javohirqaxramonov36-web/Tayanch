---
// SAT Xato daftari: takrorlash (interaktiv darslar, 2-bosqich).
// Darslardagi xatolar (tayanch:sat-xato-daftari, faqat o'qiladi) Leitner qutilariga tushadi: tayanch:sat-takrorlash.
// Javob darsSaqlash.javobniYoz orqali yoziladi: dars progressi va daftar o'z shaklida yangilanadi.
// Oraliqlar (1, 3, 7, 14 kun) Tayanch tanlovi. Ball hisoblanmaydi. Mantiq: src/lib/takrorlash.ts
// Telefon: bitta ustun, tugmalar to'liq kenglikda. Klaviatura: variantlar radio guruhi (strelkalar), Enter tekshiradi.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import ManbaBlok from '../../../../../components/ManbaBlok.astro';
import { yol } from '../../../../../lib/yol';
import { hammaSavollar, modulNomi, type DarsModul } from '../../../../../data/satDarslar';
import { matn as umumiyMatn } from '../../../../../data/umumiyMatn';

const T = umumiyMatn.en.dars;

const darsQism: Record<DarsModul, string> = {
  hajm: 'qollanma/math/hajm/',
  grafik: 'qollanma/math/grafik/',
  aylana: 'qollanma/math/birlik-aylana/',
  statistika: 'qollanma/math/statistika/',
  'rw-xato': 'qollanma/reading-writing/xatoni-toping/',
  'rw-dalil': 'qollanma/reading-writing/dalil/',
  'rw-otish': 'qollanma/reading-writing/otish-sozlari/',
  'rw-lugat': 'qollanma/reading-writing/lugat-kontekstda/',
};
// Dars sahifalaridagi savolKorsatma bilan bir xil; "Xatoni toping" da joy belgilash bosqichi bu yerda yo'q.
const korsatma: Partial<Record<DarsModul, string>> = {
  'rw-xato': 'Choose the option that correctly fixes the error in the sentence.',
  'rw-otish': 'Choose the most logical transition word for the blank.',
  'rw-lugat': 'Read the sentence and choose the most logical and precise word or meaning.',
};
const darslar = (Object.keys(darsQism) as DarsModul[]).map((m) => ({ modul: m, nomi: modulNomi[m], href: yol(`/uz/sat/${darsQism[m]}`) }));

const malumot = {
  savollar: hammaSavollar.map((s) => {
    return {
      id: s.id, modul: s.modul, mavzu: s.mavzu, qiyinlik: T.qiyinlik[s.qiyinlik], verified: s.verified,
      matn: s.matn, yechim: s.yechim, togri: s.togri,
      variantlar: s.variantlar.map((v) => v.matn), xatolar: s.variantlar.map((v) => v.xato ?? ''),
      korsatma: korsatma[s.modul] ?? '',
    };
  }),
  darslar: Object.fromEntries(darslar.map((d) => [d.modul, { nomi: d.nomi, href: d.href }])),
};
---
<BolimQobiq
  title="Mistake log: review · SAT"
  description="Spaced review of the exercises you got wrong in the SAT lessons: after 1, 3, 7 and 14 days. The data stays only in this browser. No score is calculated."
  turi="vosita"
  yol={['Practice']}
  bolim="sat"
  holat="qoralama"
>
  <div class="ichki takror">
    <header class="bosh">
      <p class="pill-qator"><span class="ustki-kok">Tool</span><span class="pill pill-chiziq">Draft</span></p>
      <h1>Mistake log: review</h1>
      <p class="lead">Exercises you got wrong in the lessons land here and come back at intervals: tomorrow, then after 3, 7 and 14 days. Solve one correctly and it moves to the next box; get it wrong and it goes back to the start.</p>
    </header>

    <p class="kichik ikkinchi">Sample questions written for Tayanch, not official SAT questions. No score is calculated. The intervals are Tayanch's choice.</p>

    <section class="royxat" id="royxat" aria-labelledby="royxat-h">
      <h2 id="royxat-h" tabindex="-1">Today's review</h2>
      <dl class="qiymatlar">
        <div><dt>Today</dt><dd id="son-bugun">0</dd></div>
        <div><dt>Later</dt><dd id="son-keyin">0</dd></div>
        <div><dt>Mastered</dt><dd id="son-ozl">0</dd></div>
      </dl>
      <p class="holat-matn" id="holat-matn"></p>
      <div class="tugmalar">
        <button type="button" class="katta asosiy" id="boshla" hidden>Start review</button>
        <button type="button" class="katta ikkinchi" id="oldin" hidden>Review upcoming ones now</button>
      </div>

      <div class="darslar" id="darslar" hidden>
        <h3>Lessons</h3>
        <ul>
          {darslar.map((d) => <li><a href={d.href}>{d.nomi}</a></li>)}
        </ul>
      </div>

      <details class="guruh" id="g-keyin" hidden>
        <summary>Review later (<span id="g-keyin-son">0</span>)</summary>
        <ul class="g-royxat" id="g-keyin-royxat"></ul>
      </details>
      <details class="guruh" id="g-ozl" hidden>
        <summary>Mastered (<span id="g-ozl-son">0</span>)</summary>
        <ul class="g-royxat" id="g-ozl-royxat"></ul>
      </details>
    </section>

    <section class="sessiya" id="sessiya" aria-labelledby="sessiya-h" hidden>
      <div class="s-bosh">
        <h2 id="sessiya-h">Review</h2>
        <p class="kichik ikkinchi" id="s-hisob" aria-live="polite"></p>
      </div>
      <form class="savol-karta" id="karta" novalidate>
        <fieldset class="savol" id="savol">
          <legend class="sr" id="s-legend"></legend>
          <p class="s-meta" id="s-meta"></p>
          <p class="s-korsatma" id="s-korsatma"></p>
          <p class="s-matn" id="s-matn" tabindex="-1"></p>
          <div class="variantlar" id="variantlar"></div>
          <div class="izoh" id="izoh" aria-live="polite" hidden>
            <p class="izoh-sarlavha" id="izoh-sarlavha"></p>
            <p class="izoh-xato" id="izoh-xato"></p>
            <p class="izoh-keyingi" id="izoh-keyingi"></p>
            <p><b>Solution.</b> <span id="izoh-yechim"></span></p>
          </div>
          <div class="s-tugmalar">
            <a class="matn-tugma kok-tugma" id="s-dars" href="#">Go to the lesson</a>
            <button type="submit" class="katta asosiy" id="tekshir" disabled>Check</button>
            <button type="button" class="katta qora" id="keyingi" hidden>Next</button>
          </div>
        </fieldset>
      </form>
      <div class="yakun" id="yakun" hidden>
        <p class="yakun-matn" id="yakun-matn" tabindex="-1"></p>
        <button type="button" class="katta asosiy" id="qaytish">Back to the list</button>
      </div>
      <button type="button" class="matn-tugma" id="toxtat">Stop review</button>
    </section>

    <div class="tozalash">
      <button type="button" class="matn-tugma" id="tozala">Delete review history</button>
      <span class="tasdiq" id="tasdiq" hidden>Delete the boxes and dates? The mistake log in the lessons stays.
        <button type="button" class="matn-tugma" id="tasdiq-ha">Yes, delete</button>
        <button type="button" class="matn-tugma" id="tasdiq-yoq">Cancel</button>
      </span>
      <p class="kichik ikkinchi" id="saqlash-holat" aria-live="polite">Review progress is saved only in this browser.</p>
    </div>

    <ManbaBlok
      manbalar={[]}
      tekshirilgan="2026-11-06"
      keyingiTekshiruv="2026-12-06"
      tekshirilmagan={[
        "The review intervals (1, 3, 7, 14 days) are Tayanch's choice, not an official recommendation.",
        'The questions are samples written for Tayanch; those not yet reviewed by the author are labeled "not verified".',
        "On this page, \"Find the error\" questions have no step for marking the error's location: only the revision is chosen.",
      ]}
    />
  </div>
  <script type="application/json" id="takror-malumot" set:html={JSON.stringify(malumot)} />
</BolimQobiq>

<script>
  import { javobniYoz, bugun } from '../../../../../lib/darsSaqlash';
  import { sinxronla, guruhla, javobdanKeyin, holatniYoz, takrorKalit, type TakrorHolat } from '../../../../../lib/takrorlash';

  interface S {
    id: string; modul: string; mavzu: string; qiyinlik: string; verified: boolean;
    matn: string; yechim: string; togri: number; variantlar: string[]; xatolar: string[];
    korsatma: string;
  }
  const BOLIM = 'sat';
  const HARF = 'ABCD';
  const OYLAR = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const M = JSON.parse($('takror-malumot').textContent || '{}') as { savollar: S[]; darslar: Record<string, { nomi: string; href: string }> };
  const savol = new Map(M.savollar.map((s) => [s.id, s]));
  const sanaMatn = (s: string) => { const [, m, d] = s.split('-').map(Number); return `${OYLAR[m - 1]} ${d}`; };
  const qisqa = (t: string) => (t.length > 80 ? `${t.slice(0, 77)}…` : t);

  let holat: TakrorHolat = sinxronla(BOLIM, new Set(savol.keys()));
  let navbat: string[] = [];
  let joriy = 0;
  let togriSoni = 0;

  const saqlashHolati = (ok: boolean) => {
    $('saqlash-holat').textContent = ok
      ? 'Review progress is saved only in this browser.'
      : 'The browser did not allow saving: review progress will be lost when the page is closed.';
  };

  // ---------- Ro'yxat ----------
  function qator(id: string, sana?: string): HTMLLIElement {
    const s = savol.get(id)!;
    const li = document.createElement('li');
    const nom = document.createElement('span');
    nom.className = 'g-nom';
    nom.textContent = `${M.darslar[s.modul]?.nomi ?? s.modul} · ${s.mavzu}`;
    li.append(nom);
    if (sana) { const t = document.createElement('span'); t.className = 'kichik ikkinchi'; t.textContent = sanaMatn(sana); li.append(t); }
    return li;
  }

  function royxatniChiz() {
    const g = guruhla(holat, bugun());
    $('son-bugun').textContent = String(g.bugun.length);
    $('son-keyin').textContent = String(g.keyinroq.length);
    $('son-ozl').textContent = String(g.ozlashtirildi.length);
    const bosh = g.bugun.length + g.keyinroq.length + g.ozlashtirildi.length === 0;
    $('holat-matn').textContent = bosh
      ? 'The mistake log is empty. Exercises you get wrong in the lessons land here and are reviewed the next day.'
      : g.bugun.length > 0
        ? `Today you have ${g.bugun.length} ${g.bugun.length === 1 ? 'exercise' : 'exercises'} to review.`
        : g.keyinroq.length > 0
          ? `Nothing to review today. Next: ${sanaMatn(holat.savollar[g.keyinroq[0]].keyingi)}.`
          : 'All mistakes are mastered. New mistakes will come from the lessons.';
    $<HTMLButtonElement>('boshla').hidden = g.bugun.length === 0;
    $<HTMLButtonElement>('boshla').textContent = `Start review (${g.bugun.length})`;
    $<HTMLButtonElement>('oldin').hidden = !(g.bugun.length === 0 && g.keyinroq.length > 0);
    $('darslar').hidden = !(bosh || (g.bugun.length === 0 && g.keyinroq.length === 0));

    $('g-keyin').hidden = g.keyinroq.length === 0;
    $('g-keyin-son').textContent = String(g.keyinroq.length);
    $('g-keyin-royxat').replaceChildren(...g.keyinroq.map((id) => qator(id, holat.savollar[id].keyingi)));
    $('g-ozl').hidden = g.ozlashtirildi.length === 0;
    $('g-ozl-son').textContent = String(g.ozlashtirildi.length);
    $('g-ozl-royxat').replaceChildren(...g.ozlashtirildi.map((id) => qator(id)));
    return g;
  }

  // ---------- Sessiya ----------
  function boshla(ids: string[]) {
    navbat = ids; joriy = 0; togriSoni = 0;
    $('royxat').hidden = true;
    $('sessiya').hidden = false;
    $('karta').hidden = false;
    $('yakun').hidden = true;
    $('toxtat').hidden = false;
    korsat();
  }

  function korsat() {
    const s = savol.get(navbat[joriy])!;
    $('s-hisob').textContent = `${joriy + 1} / ${navbat.length}`;
    $('s-legend').textContent = `Question ${joriy + 1} of ${navbat.length}`;
    const meta = $('s-meta');
    const pill = (t: string, cls = 'pill') => { const p = document.createElement('span'); p.className = cls; p.textContent = t; return p; };
    const mavzu = document.createElement('span'); mavzu.className = 'kichik ikkinchi';
    mavzu.textContent = `${M.darslar[s.modul]?.nomi ?? s.modul} · ${s.mavzu}`;
    meta.replaceChildren(pill('Sample'), pill(s.qiyinlik), mavzu, ...(s.verified ? [] : [pill('not verified', 'pill pill-ogoh')]));
    $('s-korsatma').textContent = s.korsatma;
    $('s-korsatma').hidden = !s.korsatma;
    const matn = $('s-matn');
    matn.textContent = s.matn;

    const v = $('variantlar');
    v.replaceChildren(...s.variantlar.map((t, j) => {
      const l = document.createElement('label'); l.className = 'variant';
      const inp = document.createElement('input'); inp.type = 'radio'; inp.name = 'takror-v'; inp.value = String(j);
      inp.addEventListener('change', () => { $<HTMLButtonElement>('tekshir').disabled = false; });
      const h = document.createElement('span'); h.className = 'harf'; h.setAttribute('aria-hidden', 'true'); h.textContent = HARF[j];
      const m = document.createElement('span'); m.className = 'v-matn'; m.textContent = t;
      l.append(inp, h, m);
      return l;
    }));
    $('izoh').hidden = true;
    $<HTMLButtonElement>('tekshir').hidden = false;
    $<HTMLButtonElement>('tekshir').disabled = true;
    $<HTMLButtonElement>('keyingi').hidden = true;
    $<HTMLButtonElement>('keyingi').textContent = joriy < navbat.length - 1 ? 'Next' : 'Finish';
    $<HTMLAnchorElement>('s-dars').href = M.darslar[s.modul]?.href ?? '#';
    matn.focus({ preventScroll: true });
    $('sessiya').scrollIntoView({ block: 'start', behavior: 'auto' });
  }

  $('karta').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!$('izoh').hidden) return;
    const s = savol.get(navbat[joriy])!;
    const tanlangan = document.querySelector<HTMLInputElement>('#variantlar input:checked');
    if (!tanlangan) return;
    const j = Number(tanlangan.value);
    const togrimi = j === s.togri;
    if (togrimi) togriSoni++;

    document.querySelectorAll<HTMLInputElement>('#variantlar input').forEach((x) => { x.disabled = true; });
    const labellar = document.querySelectorAll('#variantlar .variant');
    labellar[s.togri].classList.add('togri');
    if (!togrimi) labellar[j].classList.add('xato');

    const kun = bugun();
    const yangi = javobdanKeyin(holat.savollar[s.id], togrimi, kun);
    holat.savollar[s.id] = yangi;
    const ok1 = javobniYoz(BOLIM, s.modul, s.id, togrimi, qisqa(s.variantlar[j]));
    const ok2 = holatniYoz(BOLIM, holat);
    saqlashHolati(ok1 && ok2);

    const izoh = $('izoh');
    izoh.classList.toggle('izoh-togri', togrimi);
    $('izoh-sarlavha').textContent = togrimi ? 'Correct.' : `Wrong. The correct answer: ${HARF[s.togri]}) ${s.variantlar[s.togri]}`;
    $('izoh-xato').textContent = !togrimi && s.xatolar[j] ? `Typical mistake: ${s.xatolar[j]}.` : '';
    $('izoh-keyingi').textContent = yangi.quti === 5
      ? 'Mastered: this exercise will not be reviewed again.'
      : togrimi
        ? `Box ${yangi.quti}. Next review: ${sanaMatn(yangi.keyingi)}.`
        : `Back to box 1. Next review: ${sanaMatn(yangi.keyingi)}.`;
    $('izoh-yechim').textContent = s.yechim;
    izoh.hidden = false;
    $<HTMLButtonElement>('tekshir').hidden = true;
    $<HTMLButtonElement>('keyingi').hidden = false;
    // Tekshirish tugmasi yashirindi: fokus yo'qolmasin (WCAG 2.4.3), natija aria-live orqali o'qiladi
    $('keyingi').focus({ preventScroll: true });
  });

  $('keyingi').addEventListener('click', () => {
    if (joriy < navbat.length - 1) { joriy++; korsat(); return; }
    $('karta').hidden = true;
    $('toxtat').hidden = true;
    $('yakun').hidden = false;
    $('s-hisob').textContent = '';
    const g = guruhla(holat, bugun());
    $('yakun-matn').textContent = `${togriSoni} of ${navbat.length} correct. ${g.bugun.length > 0 ? `${g.bugun.length} more left for today.` : "Today's review is done."}`;
    $('yakun-matn').focus();
  });

  const royxatgaQayt = () => {
    $('sessiya').hidden = true;
    $('royxat').hidden = false;
    royxatniChiz();
    $('royxat-h').focus();
  };
  $('qaytish').addEventListener('click', royxatgaQayt);
  $('toxtat').addEventListener('click', royxatgaQayt);
  $('boshla').addEventListener('click', () => boshla(guruhla(holat, bugun()).bugun));
  $('oldin').addEventListener('click', () => boshla(guruhla(holat, bugun()).keyinroq));

  // ---------- O'chirish: sahifa ichidagi tasdiq ----------
  const tozala = $<HTMLButtonElement>('tozala');
  tozala.addEventListener('click', () => { $('tasdiq').hidden = false; tozala.hidden = true; $('tasdiq-yoq').focus(); });
  $('tasdiq-yoq').addEventListener('click', () => { $('tasdiq').hidden = true; tozala.hidden = false; tozala.focus(); });
  $('tasdiq-ha').addEventListener('click', () => {
    try { localStorage.removeItem(takrorKalit(BOLIM)); } catch { /* ruxsat yo'q */ }
    holat = sinxronla(BOLIM, new Set(savol.keys()));
    $('tasdiq').hidden = true; tozala.hidden = false;
    if (!$('sessiya').hidden) royxatgaQayt(); else royxatniChiz();
    $('saqlash-holat').textContent = 'Review history deleted. The mistakes in the log start again from box 1.';
    tozala.focus();
  });

  royxatniChiz();
</script>

<style>
  .takror { padding-top: var(--b-10); display: flex; flex-direction: column; gap: var(--b-8); }
  .bosh { display: flex; flex-direction: column; gap: var(--b-4); }
  .pill-qator { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3); }
  .ustki-kok { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rang-havola); }
  .takror :global(.pill) { padding: 4px 12px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); color: var(--matn); font-size: var(--matn-mayda); font-weight: 700; white-space: nowrap; }
  .takror :global(.pill-ogoh) { background: var(--rang-ogoh-fon); color: var(--rang-ogoh-matn); }
  .pill-chiziq { background: transparent; border: 1.5px dashed var(--matn-sust); color: var(--matn-ikkinchi); padding: 2.5px 10.5px; }
  h1 { font-size: 46px; line-height: 1.1; font-weight: 800; letter-spacing: var(--oraliq-sarlavha); }
  h2 { font-size: 32px; }
  h2:focus, .yakun-matn:focus { outline: none; }
  h3 { font-size: 20px; }
  .lead { font-size: 18px; line-height: 1.6; color: var(--matn-ikkinchi); max-width: 62ch; }
  [hidden] { display: none !important; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .royxat { display: flex; flex-direction: column; gap: var(--b-5); }
  .qiymatlar { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--b-2); max-width: 560px; }
  .qiymatlar div { background: var(--fon-ikkinchi); border-radius: var(--r-orta); padding: var(--b-3) var(--b-4); }
  .qiymatlar dt { font-size: var(--matn-kichik); color: var(--matn-ikkinchi); }
  .qiymatlar dd { margin: 0; font-size: 28px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .holat-matn { font-size: 18px; font-weight: 700; line-height: 1.5; }
  .darslar { display: flex; flex-direction: column; gap: var(--b-2); }
  .darslar ul { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--b-2); }
  .darslar a { min-height: 48px; display: flex; align-items: center; padding: 0 var(--b-4); border: 1.5px solid var(--chiziq-kuchli); border-radius: var(--r-orta); color: var(--rang-havola); font-weight: 700; text-decoration: none; }
  .darslar a:hover { border-color: var(--rang-asosiy); transform: var(--kotarilish); }
  .darslar a:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }
  .guruh { border: 1.5px solid var(--matn); border-radius: var(--r-orta); }
  .guruh summary { min-height: 56px; padding: var(--b-3) var(--b-4); display: flex; align-items: center; font-weight: 800; cursor: pointer; }
  .guruh summary:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; border-radius: var(--r-orta); }
  .g-royxat { list-style: none; margin: 0; padding: 0 var(--b-4) var(--b-3); }
  .g-royxat :global(li) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--b-2); padding: var(--b-3) 0; border-top: 1px solid var(--chiziq); }
  .g-royxat :global(.g-nom) { flex: 1 1 240px; min-width: 0; }

  .tugmalar, .s-tugmalar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3); }
  .s-tugmalar { justify-content: flex-end; }
  .katta { min-height: var(--control-height-md); padding: 0 28px; border: 0; border-radius: var(--r-toliq); font: inherit; font-weight: 800; font-size: 16px; cursor: pointer; }
  .katta.asosiy { background: var(--btn-primary-bg); color: var(--btn-primary-text); }
  .katta.asosiy:hover { background: var(--btn-primary-bg-hover); }
  .katta.asosiy:disabled { background: var(--sirt-ikkinchi); color: var(--matn-sust); cursor: not-allowed; }
  .katta.ikkinchi { background: var(--sirt-ikkinchi); color: var(--matn); }
