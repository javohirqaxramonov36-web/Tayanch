---
// Hajm laboratoriyasi (3D). Three.js faqat sahna ekranga yaqinlashganda yuklanadi (src/lib/hajmSahna.ts).
// Prototip: docs/prototip/tayanch-3d-laboratoriya.html (SAT bo'limi). Matn inglizcha (CLAUDE.md).
import { darsSavollari } from '../../../../../../data/satDarslar';
import { yol } from '../../../../../../lib/yol';
import DarsQolip from '../../../../../../components/dars/DarsQolip.astro';
---
<DarsQolip
  bolim="sat"
  takrorlashHref={yol('/uz/sat/vosita/takrorlash/')}
  modul="hajm"
  savollar={darsSavollari.hajm}
  yolBandlari={['Math lessons']}
  darsTuri="Math lesson"
  imtihon="SAT"
  manbalar={['CB05']}
  tekshirilgan="2026-11-05"
  keyingiTekshiruv="2026-12-05"
  title="Volume lab · SAT"
  description="SAT Math: the volume of a cylinder, cone, sphere and prism in a 3D scene. A disk animation, the formula, a try-it step and 6 exercises."
  yonalish="Geometry and Trigonometry"
  sarlavha="Volume: base area times height"
  lead="Build a cylinder from thin disks and the formula appears on its own. Then change the dimensions of a cone, a sphere and a prism and watch how the volume grows."
  maqsadlar={[
    "You can explain with disks why the volume of a cylinder is πr²h.",
    "You calculate the volume of a cone, a sphere and a prism with the right formula.",
    "You do not confuse the radius with the diameter, or r² with r³.",
  ]}
  xulosa={[
    "Cylinder and prism: V = base area × height. For a cylinder, the base area is πr².",
    "A cone is one third of the cylinder with the same base and height: V = ⅓πr²h.",
    "A sphere depends only on the radius: V = ⁴⁄₃πr³. If the radius doubles, the volume becomes 8 times as large.",
    "If a question gives the diameter, divide it by 2 first.",
  ]}
  keyingi={{ nomi: 'Function graphs', href: yol('/uz/sat/qollanma/math/grafik/') }}
  tekshirilmagan={[
    'The exercise questions were written for Tayanch; those not yet reviewed by the author are marked "not verified".',
    'This page makes no claim about whether a formula sheet is provided in the test: an official source has not been added to the source log yet.',
  ]}
>
  <div slot="sahna">
    <div class="sahna-quti hajm-quti" id="hajm-quti" tabindex="0" role="application" aria-roledescription="3D scene" aria-label="Volume scene. Rotate with the arrow keys, zoom with plus and minus." aria-describedby="hajm-tavsif">
      <canvas id="hajm-canvas" aria-hidden="true"></canvas>
      <svg class="hajm-poster" id="hajm-poster" viewBox="0 0 200 150" aria-hidden="true">
        <ellipse cx="100" cy="40" rx="45" ry="12" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M55 40v70c0 7 20 12 45 12s45-5 45-12V40" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M100 40h45" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" />
      </svg>
      <p class="hajm-holat" id="hajm-holat">Loading the 3D scene…</p>
    </div>
    <p class="sr" id="hajm-tavsif" aria-live="polite"></p>
    <div class="sahna-tugmalar">
      <button type="button" class="belgi-t" data-amal="chap" aria-label="Rotate left"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg></button>
      <button type="button" class="belgi-t" data-amal="ong" aria-label="Rotate right"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg></button>
      <button type="button" class="belgi-t" data-amal="yaqin" aria-label="Zoom in"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
      <button type="button" class="belgi-t" data-amal="uzoq" aria-label="Zoom out"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg></button>
      <button type="button" class="kichik-tugma" data-amal="tikla">Reset camera</button>
    </div>
    <p class="sahna-izoh">Drag with the mouse. On a phone, swipe sideways with one finger and pinch with two fingers to zoom. One floor square = 1 unit.</p>
  </div>

  <div slot="animatsiya">
    <p>We build the cylinder from identical disks with a thickness of 1. The volume of each disk is base area × thickness = πr² × 1. The volume is πr² times the number of disks.</p>
    <div class="segment">
      <button type="button" class="katta asosiy" id="disk-boshla">Stack the disks</button>
      <button type="button" class="kichik-tugma" id="disk-tikla">Whole cylinder</button>
    </div>
    <div class="formula">
      <span class="f-qiymat" id="disk-matn" aria-live="polite">A cylinder with r = 3, h = 6: press the button.</span>
    </div>
    <p class="kichik ikkinchi">You can change r and h in the "Try it" step.</p>
  </div>

  <div slot="formula">
    <div class="formula">
      <span class="kichik ikkinchi" id="f-nomi">Cylinder</span>
      <span class="f-asosiy" id="f-asosiy">V = πr²h</span>
      <span class="f-qiymat" id="f-qiymat"></span>
      <span class="kichik ikkinchi" id="f-izoh"></span>
    </div>
    <dl class="qiymatlar formula-jadval">
      <div><dt>Cylinder</dt><dd>πr²h</dd></div>
      <div><dt>Cone</dt><dd>⅓πr²h</dd></div>
      <div><dt>Sphere</dt><dd>⁴⁄₃πr³</dd></div>
      <div><dt>Prism</dt><dd>l · w · h</dd></div>
    </dl>
  </div>

  <div slot="sinab">
    <div class="boshqaruv">
      <div class="segment" role="group" aria-label="Shape">
        <button type="button" data-shakl="silindr" aria-pressed="true">Cylinder</button>
        <button type="button" data-shakl="konus" aria-pressed="false">Cone</button>
        <button type="button" data-shakl="shar" aria-pressed="false">Sphere</button>
        <button type="button" data-shakl="prizma" aria-pressed="false">Prism</button>
      </div>
      <div class="slayder" data-uchun="r"><label for="hajm-r">r</label><input type="range" id="hajm-r" min="1" max="5" step="1" value="3" /><output for="hajm-r" id="hajm-r-o">3</output></div>
      <div class="slayder" data-uchun="h"><label for="hajm-h">h</label><input type="range" id="hajm-h" min="1" max="10" step="1" value="6" /><output for="hajm-h" id="hajm-h-o">6</output></div>
      <div class="slayder" data-uchun="l" hidden><label for="hajm-l">l</label><input type="range" id="hajm-l" min="1" max="8" step="1" value="4" /><output for="hajm-l" id="hajm-l-o">4</output></div>
      <div class="slayder" data-uchun="w" hidden><label for="hajm-w">w</label><input type="range" id="hajm-w" min="1" max="8" step="1" value="3" /><output for="hajm-w" id="hajm-w-o">3</output></div>
    </div>
    <div class="formula">
      <span class="f-qiymat" id="sinab-natija" aria-live="polite"></span>
    </div>
    <div class="vazifa">
      <p><b>Task.</b> Find a cylinder with a volume of 48π: choose r and h.</p>
      <p class="vazifa-holat" id="vazifa-holat" aria-live="polite">Not found yet.</p>
    </div>
  </div>
</DarsQolip>

<script>
  import type { HajmHolat, HajmSahna, Shakl } from '../../../../../../lib/hajmSahna';
  import { son } from '../../../../../../lib/sonYozuv';

  const holat: HajmHolat = { shakl: 'silindr', r: 3, h: 6, l: 4, w: 3, disklar: null };
  const kamaytir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (id: string) => document.getElementById(id)!;
  let sahna: HajmSahna | null = null;

  // ---------- Hisob ----------
  const ekub = (a: number, b: number): number => (b ? ekub(b, a % b) : a);
  const piKasr = (surat: number, maxraj: number) => { const g = ekub(surat, maxraj); const s = surat / g, m = maxraj / g; return m === 1 ? `${s}π` : `${s}π/${m}`; };
  function hisob() {
    const { shakl, r, h, l, w } = holat;
    if (shakl === 'silindr') return { nomi: 'Cylinder', asosiy: 'V = πr²h', qiymat: `V = π · ${r}² · ${h} = ${piKasr(r * r * h, 1)} ≈ ${son(Math.PI * r * r * h)}`, izoh: 'Base area (πr²) × height.' };
    if (shakl === 'konus') return { nomi: 'Cone', asosiy: 'V = ⅓πr²h', qiymat: `V = ⅓ · π · ${r}² · ${h} = ${piKasr(r * r * h, 3)} ≈ ${son(Math.PI * r * r * h / 3)}`, izoh: "One third of the cylinder with the same r and h." };
    if (shakl === 'shar') return { nomi: 'Sphere', asosiy: 'V = ⁴⁄₃πr³', qiymat: `V = ⁴⁄₃ · π · ${r}³ = ${piKasr(4 * r * r * r, 3)} ≈ ${son(4 * Math.PI * r ** 3 / 3)}`, izoh: "Depends only on the radius: if r doubles, the volume becomes 8 times as large." };
    return { nomi: 'Rectangular prism', asosiy: 'V = l · w · h', qiymat: `V = ${l} · ${w} · ${h} = ${l * w * h}`, izoh: "Number of floor squares (l · w) × number of layers (h)." };
  }
  function matnlarniYangila() {
    const x = hisob();
    $('f-nomi').textContent = x.nomi; $('f-asosiy').textContent = x.asosiy; $('f-qiymat').textContent = x.qiymat; $('f-izoh').textContent = x.izoh;
    $('sinab-natija').textContent = `${x.nomi}: ${x.qiymat}`;
    $('hajm-tavsif').textContent = `${x.nomi}. ${x.qiymat}.`;
    const topildi = holat.shakl === 'silindr' && holat.r * holat.r * holat.h === 48;
    const v = $('vazifa-holat');
    v.dataset.ok = topildi ? '1' : '0';
    v.textContent = topildi ? `Found: r = ${holat.r}, h = ${holat.h}. Check: ${holat.r}² · ${holat.h} = 48.` : 'Not found yet. Hint: r² · h must equal 48.';
  }
  function yangila() { matnlarniYangila(); sahna?.yangila({ ...holat }); }

  // ---------- Boshqaruv ----------
  const kerak: Record<Shakl, string[]> = { silindr: ['r', 'h'], konus: ['r', 'h'], shar: ['r'], prizma: ['l', 'w', 'h'] };
  document.querySelectorAll<HTMLButtonElement>('[data-shakl]').forEach((b) => b.addEventListener('click', () => {
    holat.shakl = b.dataset.shakl as Shakl; holat.disklar = null; diskniToxtat();
    document.querySelectorAll('[data-shakl]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.slayder[data-uchun]').forEach((s) => { s.hidden = !kerak[holat.shakl].includes(s.dataset.uchun!); });
    yangila();
  }));
  (['r', 'h', 'l', 'w'] as const).forEach((k) => {
    const inp = $(`hajm-${k}`) as HTMLInputElement;
    inp.addEventListener('input', () => { holat[k] = Number(inp.value); $(`hajm-${k}-o`).textContent = inp.value; if (holat.disklar !== null) holat.disklar = holat.h; yangila(); });
  });

  // ---------- Disklar animatsiyasi ----------
  let taymer = 0;
  function diskniToxtat() { if (taymer) { clearInterval(taymer); taymer = 0; } }
  function diskMatn(n: number) {
    const { r, h } = holat;
    $('disk-matn').textContent = n < h
      ? `Disk ${n}: volume = ${n} · π · ${r}² = ${piKasr(n * r * r, 1)}`
      : `${h} disks: V = ${h} · π · ${r}² = ${piKasr(h * r * r, 1)}. This is πr²h.`;
  }
  $('disk-boshla').addEventListener('click', () => {
    diskniToxtat();
    if (holat.shakl !== 'silindr') document.querySelector<HTMLButtonElement>('[data-shakl="silindr"]')!.click();
    if (kamaytir) { holat.disklar = holat.h; diskMatn(holat.h); yangila(); return; }
    holat.disklar = 1; diskMatn(1); yangila();
    taymer = window.setInterval(() => {
      if (holat.disklar === null) return diskniToxtat();
      if (holat.disklar >= holat.h) { diskMatn(holat.h); return diskniToxtat(); }
      holat.disklar++; diskMatn(holat.disklar); yangila();
    }, 600);
  });
  $('disk-tikla').addEventListener('click', () => { diskniToxtat(); holat.disklar = null; $('disk-matn').textContent = 'Showing the whole cylinder.'; yangila(); });
  document.addEventListener('dars:qadam', (e) => {
    if ((e as CustomEvent).detail.qadam !== 'animatsiya' && holat.disklar !== null) { diskniToxtat(); holat.disklar = null; yangila(); }
  });

  // ---------- Kamera tugmalari va klaviatura ----------
  const amal = (a: string) => {
    if (!sahna) return;
    if (a === 'chap') sahna.aylantir(-0.35); else if (a === 'ong') sahna.aylantir(0.35);
    else if (a === 'yaqin') sahna.yaqinlashtir(0.85); else if (a === 'uzoq') sahna.yaqinlashtir(1 / 0.85);
    else if (a === 'tikla') sahna.tikla();
  };
  document.querySelectorAll<HTMLButtonElement>('[data-amal]').forEach((b) => b.addEventListener('click', () => amal(b.dataset.amal!)));
  const quti = $('hajm-quti');
  quti.addEventListener('keydown', (e) => {
    if (!sahna) return;
    const k: Record<string, () => void> = {
      ArrowLeft: () => sahna!.aylantir(-0.15), ArrowRight: () => sahna!.aylantir(0.15),
      ArrowUp: () => sahna!.aylantir(0, -0.1), ArrowDown: () => sahna!.aylantir(0, 0.1),
      '+': () => sahna!.yaqinlashtir(0.9), '=': () => sahna!.yaqinlashtir(0.9), '-': () => sahna!.yaqinlashtir(1 / 0.9),
    };
    if (k[e.key]) { e.preventDefault(); k[e.key](); }
  });

  // ---------- Three.js ni kechiktirib yuklash ----------
  let yuklandi = false;
  const yukla = async () => {
    if (yuklandi) return; yuklandi = true;
    try {
      const { sahnaYarat } = await import('../../../../../../lib/hajmSahna');
      sahna = sahnaYarat(quti, $('hajm-canvas') as HTMLCanvasElement);
      sahna.yangila({ ...holat });
      quti.classList.add('tayyor');
      $('hajm-holat').hidden = true;
    } catch {
      $('hajm-holat').textContent = "The 3D scene could not be opened (the browser does not support WebGL or it is turned off). The formula and exercises still work.";
      document.querySelectorAll('[data-amal]').forEach((b) => b.setAttribute('disabled', ''));
    }
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { io.disconnect(); yukla(); } }, { rootMargin: '200px' });
    io.observe(quti);
  } else yukla();
  addEventListener('pagehide', () => { diskniToxtat(); sahna?.yoq(); sahna = null; yuklandi = false; });

  matnlarniYangila();
</script>

<style is:global>
  .dars .hajm-quti { height: 320px; touch-action: pan-y; }
  @container (min-width: 780px) { .dars .hajm-quti { height: 460px; } }
  .dars .hajm-quti:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 3px; }
  .dars .hajm-quti canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .dars .hajm-quti.ushlangan canvas { cursor: grabbing; }
  .dars .hajm-poster { position: absolute; inset: 15% 20%; width: 60%; height: 60%; color: var(--matn-sust); }
  .dars .hajm-quti.tayyor .hajm-poster { display: none; }
  .dars .hajm-holat { position: absolute; left: var(--b-4); right: var(--b-4); bottom: var(--b-4); text-align: center; font-size: var(--matn-kichik); font-weight: 600; color: var(--matn-ikkinchi); }
  .dars .formula-jadval dd { font-size: 17px; }
</style>
