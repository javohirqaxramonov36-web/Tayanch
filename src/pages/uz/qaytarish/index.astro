---
// 1-qavat · Pulni qaytarish siyosati (P23 davomi, 2026-11-11). QORALAMA.
// Muddat va shartlar muallif/yurist qarori (huquqiyOchiq.qaytarishKun): o'ylab topilgan raqam yozilmaydi.
// Texnik holat: refund yo'li (inPAY orqali) hali sinalmagan (HANDOFF, "Keyingi (to'lov)").
import Asosiy from '../../../layouts/Asosiy.astro';
import HuquqiyMatn from '../../../components/huquqiy/HuquqiyMatn.astro';
import { huquqiyOchiq } from '../../../data/huquqiySahifalar';
import { yol } from '../../../lib/yol';

const { qaytarishKun } = huquqiyOchiq;
---
<Asosiy
  title="Pulni qaytarish siyosati"
  description="Tayanch SAT pullik tarifi uchun pulni qaytarish tartibi (qoralama)."
  turi="umumiy"
  bolim="umumiy"
  holat="qoralama"
  tekshirilgan="2026-11-11"
  keyingiTekshiruv="2026-12-11"
  manbalar={['IP03']}
  tekshirilmagan={[
    "Raqamli xizmat uchun qaytarish boʻyicha qonun talabi (\"Isteʼmolchilarning huquqlarini himoya qilish toʻgʻrisida\"gi Qonun): hali aniqlanmagan",
    "inPAY orqali qaytarish qanday qilinadi va pul kartaga necha kunda tushadi: hali tasdiqlanmagan",
  ]}
>
  <HuquqiyMatn til="uz" kalit="qaytarish" sana="2026-11-11" kirish="Bu siyosat SAT bo'limidagi pullik tariflarga tegishli.">
    <h2>Qachon pul qaytariladi</h2>
    {qaytarishKun === null ? (
      <p>Qaytarish muddati va shartlari hali belgilanmagan. Belgilangunga qadar har murojaat alohida koʻrib chiqiladi.</p>
    ) : (
      <p>Toʻlovdan keyin {qaytarishKun} kun ichida murojaat qilsangiz, pul qaytarilishi mumkin. Batafsil shartlar shu yerda yoziladi.</p>
    )}
    <p>Ikki marta yechilgan yoki xato bilan yechilgan toʻlov (masalan, toʻlov oʻtgan, lekin tarif yoqilmagan) har doim tekshiriladi va tasdiqlansa qaytariladi.</p>

    <h2>Qanday soʻraladi</h2>
    <ol>
      <li><a href={yol('/uz/aloqa/')}>Aloqa</a> sahifasidagi manzilga yozing.</li>
      <li>Hisobingiz emailini, toʻlov sanasini va summasini koʻrsating. Karta raqamini yozmang.</li>
      <li>Javob va qaytarish tartibi shu manzilga yuboriladi.</li>
    </ol>

    <h2>Pul qanday qaytariladi</h2>
    <p>Pul toʻlov qilingan usulga (Click yoki Payme orqali kartaga) inPAY orqali qaytariladi. Qancha vaqtda tushishi: hali aniqlanmagan.</p>

    <h2>Hisobni oʻchirish va qaytarish</h2>
    <p>Hisobni oʻchirsangiz, faol obuna ham tugaydi. Pulni qaytarishni xohlasangiz, hisobni oʻchirishdan <strong>oldin</strong> murojaat qiling: oʻchirilgandan keyin toʻlovni hisobingizga bogʻlab boʻlmaydi.</p>
  </HuquqiyMatn>
</Asosiy>
