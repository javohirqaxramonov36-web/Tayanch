---
// 2-qavat · Top Admission · yo'nalish sahifasi: Türkiye Bursları.
// Dizayn: Claude Design "Tayanch Top Admission maketi", B artboard'lari (Burslar, BurslarTelefon, qorong'i variantlari):
// https://claude.ai/artifact/1zP2rnjMp46RgY9WpD84GF
// 2-qavat mini-DS (ADR 005, PR 7, 2026-11-23): AdmHero, AdmMuddat, AdmTekshirildi (adm.css). v1 viza kartasi, muhr,
// chipta va MRZ olib tashlandi (muallif DS'da rad etgan); faktlar va sanalar o'zgarmagan.
// Faktlar faqat TB01–TB05 (manbalar.ts, rasmiy, 2026-11-09). Muddat: deadline.ts "turkiye-burslari-2027-ariza".
// Maketdan farq: (1) "Keyingi qadam" bloki qora emas (DESIGN.md: qora sahna faqat bosh sahifada),
// (2) "Rasmiy manbalar / Tekshirilgan sana / Tekshirilmagan joylar" umumiy SahifaOxiri blokida.
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import SahifaOxiri from '../../../../components/SahifaOxiri.astro';
import { deadlinelar } from '../../../../data/deadline';
import { rasmiyManbalar } from '../../../../data/manbalar';
import { yol } from '../../../../lib/yol';
import { taChiptalar } from '../../../../data/taChiptalar';
import AdmHero from '../../../../components/topAdmission/AdmHero.astro';
import AdmMuddat from '../../../../components/topAdmission/AdmMuddat.astro';
import AdmTekshirildi from '../../../../components/topAdmission/AdmTekshirildi.astro';
import '../../../../styles/adm.css';

const MANBALAR = ['TB01', 'TB02', 'TB03', 'TB04', 'TB05'];
const rasmiy = rasmiyManbalar(MANBALAR);
// Rasmiy bo'lmagan yoki topilmagan manba bo'lsa build to'xtaydi (fakt manbasiz chiqmasin).
if (rasmiy.length !== MANBALAR.length) throw new Error('Türkiye Bursları: TB01–TB05 rasmiy manbalari topilmadi');
const m = (id: string) => rasmiy.find((x) => x.id === id)!;

const tb = deadlinelar.find((x) => x.id === 'turkiye-burslari-2027-ariza');
if (!tb) throw new Error("deadline.ts: 'turkiye-burslari-2027-ariza' topilmadi");
// Muddat kartasi: kirish sahifasi bilan bitta manba (taChiptalar.ts: deadline.ts + TB01, ochilish 10-yanvar).
const chipta = taChiptalar.find((c) => c.id === tb.id)!;

const vosita = yol('/uz/top-admission/vosita/topshirish-yoli/');
const zinapoya = yol('/uz/top-admission/qollanma/ariza-zinapoyasi/');
const sana = '2026-11-09';
const keyingi = '2026-12-09';

const mundarija = [
  { id: 'kimga', nomi: 'Kimga mos' },
  { id: 'qabul', nomi: 'Qabul tizimi' },
  { id: 'moliya', nomi: 'Moliyaviy yordam' },
  { id: 'hujjat', nomi: 'Hujjatlar' },
  { id: 'muddat', nomi: 'Deadline' },
  { id: 'imtihon', nomi: 'Imtihon va til' },
  { id: 'oxiri-sarlavha', nomi: 'Manbalar va tekshiruv' },
];

const shartlar = [
  { daraja: "Bakalavriat (associate, bachelor's)", ball: '70%', yosh: '21 dan kichik' },
  { daraja: 'Magistratura', ball: '75%', yosh: '30 dan kichik' },
  { daraja: 'Doktorantura (PhD)', ball: '75%', yosh: '35 dan kichik' },
];
const bosqichlar = [
  { nomi: 'Ariza', vaqt: '10-yanvar – 20-fevral' },
  { nomi: 'Baholash', vaqt: 'mart – aprel' },
  { nomi: 'Intervyu', vaqt: 'aprel – iyun' },
  { nomi: 'Natija', vaqt: 'avgust boshi' },
];
const qoplanadi = [
  "Oʻqish toʻlovi",
  'Yotoqxona (bakalavriat talabalari uchun)',
  "Tibbiy sugʻurta",
  'Bir martalik aviachipta',
  "1 yillik bepul turk tili kursi",
];
const stipendiya = [
  { daraja: 'Bakalavriat', summa: '6.500 TL' },
  { daraja: 'Magistratura', summa: '9.500 TL' },
  { daraja: 'Doktorantura', summa: '13.000 TL' },
];
const hujjatlar = [
  'Shaxsni tasdiqlovchi hujjat (ID karta yoki pasport)',
  "Oxirgi 1 yil ichida tushgan foto",
  "Milliy imtihon natijasi (boʻlsa)",
  'Diplom yoki vaqtinchalik bitiruv guvohnomasi',
  'Transkript',
  "Xalqaro imtihon natijasi (GRE, GMAT, SAT va boshqalar): tanlangan universitet yoki dastur talab qilsa",
  "Xalqaro til testi natijasi (TOEFL, DELF va boshqalar): tanlangan universitet yoki dastur talab qilsa",
];
const tekshirilmagan = [
  "2027-yil eʼloni (rasmiy taqvimda yil yozilmagan)",
  "Yosh chegarasi qaysi sanaga qarab hisoblanishi (TB02 da yozilmagan)",
  "Ariza 5 qadami: rasmiy sahifada faqat rasm sifatida berilgan",
  "Turk tili kursidan ozod qilish shartlari (TB04 va TB05 matni bir-biridan farq qiladi)",
  "Magistratura va doktorantura uchun yotoqxona va uy-joy puli",
];

---
<BolimQobiq
  title="Türkiye Bursları · Top Admission"
  description="Türkiye Bursları: kimga mos, qabul taqvimi, stipendiya, hujjatlar va muddat. Faqat rasmiy manbadan, natija kafolatlanmaydi."
  turi="qollanma"
  bolim="top-admission"
  holat="chop-etilgan"
  tekshirilgan={sana}
  keyingiTekshiruv={keyingi}
  manbalar={MANBALAR}
  tekshirilmagan={tekshirilmagan}
  yol={["Yo'nalishlar"]}
>
  <div class="ichki tb-sahifa">

    <AdmHero id="tb-sarlavha" yorliq="Yo'nalish sahifasi · UZ → TR" sarlavha="Türkiye" urgu="Bursları" katta={false}>
      <dl class="adm-qatorlar tb-maydon">
        <div><dt>Dastur</dt><dd>Türkiye Bursları (YTB)</dd></div>
        <div><dt>Daraja</dt><dd>Bakalavriat, magistratura, doktorantura</dd></div>
        <div><dt>Ariza oynasi</dt><dd>10-yanvar – 20-fevral</dd></div>
        <div><dt>Manba</dt><dd><a href="https://www.turkiyeburslari.gov.tr/" rel="noopener">turkiyeburslari.gov.tr</a></dd></div>
      </dl>
      <p><AdmTekshirildi sana={m('TB01').tekshirilganSana} /></p>
    </AdmHero>

    <details class="mund-telefon">
      <summary>
        Mundarija
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <nav aria-label="Sahifa mundarijasi">
        {mundarija.map((b, i) => <a href={`#${b.id}`} data-bolim={b.id} aria-current={i === 0 ? 'location' : undefined}>{b.nomi}</a>)}
      </nav>
    </details>

    <div class="ikki-ustun">
      <div class="asosiy-ustun adm-karta">

        <section id="kimga" class="bolim bolim-birinchi" aria-labelledby="kimga-h">
          <div class="bolim-bosh">
            <h2 id="kimga-h">Kimga mos</h2>
            <AdmTekshirildi sana={m('TB02').tekshirilganSana} />
          </div>
          <div class="jadval-quti" tabindex="0" role="region" aria-label="Rasmiy minimal shartlar jadvali">
            <table>
              <caption class="sust kichik">Rasmiy minimal shartlar (TB02)</caption>
              <thead><tr><th scope="col">Daraja</th><th scope="col">Minimal oʻzlashtirish</th><th scope="col">Yosh</th></tr></thead>
              <tbody>
                {shartlar.map((s) => <tr><th scope="row">{s.daraja}</th><td>{s.ball}</td><td>{s.yosh}</td></tr>)}
              </tbody>
            </table>
          </div>
          <ul class="royxat">
            <li>Tibbiyot, stomatologiya va farmatsiya uchun minimal oʻzlashtirish 90%.</li>
            <li>Barcha davlat fuqarolari ariza bera oladi. Türkiye fuqarolari va Türkiye universitetida shu darajada oʻqiyotganlar bera olmaydi.</li>
            <li>Bitirganlar va joriy oʻquv yili oxirida (avgustgacha) bitiradiganlar ariza bera oladi.</li>
          </ul>
          <p class="izoh">Yosh qaysi sanaga qarab hisoblanishi rasmiy sahifada yozilmagan.</p>
        </section>

        <section id="qabul" class="bolim" aria-labelledby="qabul-h">
          <h2 id="qabul-h">Qabul tizimi</h2>
          <p class="matn">
            Ariza onlayn, Türkiye Bursları tizimida (TBBS) topshiriladi:{' '}
            <a class="havola-matn" href="https://tbbs.turkiyeburslari.gov.tr/" rel="noopener">tbbs.turkiyeburslari.gov.tr</a>.
            Onlayn arizada 12 tagacha tanlov qilish mumkin.
          </p>
          <div class="taqvim">
            <div class="taqvim-bosh">
              <p class="adm-eyebrow">Ariza bosqichlari · har yilgi taqvim</p>
              <AdmTekshirildi sana={m('TB01').tekshirilganSana} />
            </div>
            <ol class="bosqichlar">
              {bosqichlar.map((b, i) => (
                <li class:list={[i === 0 && 'birinchi', i === bosqichlar.length - 1 && 'oxirgi']}>
                  <span class="chiziq-qator" aria-hidden="true"><span class="nuqta"></span><span class="chiziq"></span></span>
                  <b>{b.nomi}</b>
                  <span class="ikkinchi">{b.vaqt}</span>
                </li>
              ))}
            </ol>
            <p class="ikkinchi kichik">Natijadan keyin: avgustda dastlabki rasmiylashtirish, sentabrda Türkiyeʼga kelish.</p>
          </div>
        </section>

        <section id="moliya" class="bolim" aria-labelledby="moliya-h">
          <div class="bolim-bosh">
            <h2 id="moliya-h">Moliyaviy yordam</h2>
            <AdmTekshirildi sana={m('TB03').tekshirilganSana} />
          </div>
          <ul class="royxat">{qoplanadi.map((q) => <li>{q}</li>)}</ul>
          <dl class="stipendiya">
            {stipendiya.map((s) => <div><dt class="ustki">{s.daraja}</dt><dd>{s.summa}<span class="sust kichik"> / oy</span></dd></div>)}
          </dl>
          <p class="ikkinchi kichik">Oylik stipendiya summasi {m('TB03').tekshirilganSana} dagi rasmiy sahifadan. Summa oʻzgarishi mumkin: ariza oldidan rasmiy saytda qarang.</p>
        </section>

        <section id="hujjat" class="bolim" aria-labelledby="hujjat-h">
          <div class="bolim-bosh">
            <h2 id="hujjat-h">Hujjatlar</h2>
            <AdmTekshirildi sana={m('TB04').tekshirilganSana} />
          </div>
          <p class="matn">TBBS tizimiga yuklanadi:</p>
          <ul class="royxat">{hujjatlar.map((h) => <li>{h}</li>)}</ul>
          <p class="ikkinchi kichik">Faqat doktorantura uchun: tadqiqot mavzusi taklifi va bajargan tadqiqotingizdan yozma namuna.</p>
        </section>

        <section id="muddat" class="bolim" aria-labelledby="muddat-h">
          <h2 id="muddat-h">Deadline</h2>
          <AdmMuddat
            id="tb-muddat"
            nomi="Umumiy ariza"
            qatorlar={[{ dt: 'Ariza oynasi', dd: '10-yanvar – 20-fevral' }, { dt: 'Oxirgi kun', dd: chipta.korishokKatta }]}
            ochilish={chipta.ochilish}
            kun={chipta.chegara.kun}
            oxir={chipta.chegara.oxir}
            zaxiraMatn={`${chipta.korishokKatta} ${chipta.korishokMatn}`}
            manba={m('TB01')}
          >
            <p class="adm-manba">Har yilgi taqvim, 2027 eʼloni kutilmoqda</p>
          </AdmMuddat>
          <p><a class="havola" href={yol('/uz/deadline/')}>Barcha muddatlar</a></p>
        </section>

        <section id="imtihon" class="bolim" aria-labelledby="imtihon-h">
          <div class="bolim-bosh">
            <h2 id="imtihon-h">Imtihon va til</h2>
            <AdmTekshirildi sana={m('TB04').tekshirilganSana} />
          </div>
          <ul class="royxat">
            <li>GRE, GMAT, SAT kabi xalqaro imtihon va TOEFL, DELF kabi til testi faqat tanlangan universitet yoki dastur talab qilsa kerak.</li>
            <li>Turkcha C1 sertifikati boʻlmagan grant oluvchilar (ingliz tilidagi dasturga joylashganlar ham) 1 yillik turk tili kursida oʻqiydi va yil oxirigacha C1 sertifikatini olishi kerak (TB04).</li>
            <li>Turk tili kursi dastur tilidan qatʼi nazar hamma grant oluvchilarga bepul (TB05).</li>
          </ul>
          <p class="izoh">Kursdan ozod qilish shartlari rasmiy sahifalarda aniq yozilmagan.</p>
        </section>

        <section class="keyingi" aria-labelledby="keyingi-h">
          <div class="keyingi-matn">
            <p class="adm-eyebrow">Keyingi qadam</p>
            <p id="keyingi-h" class="keyingi-sarlavha">Bu yoʻl sizga mosmi? 3 savolda tekshiring.</p>
            <a class="havola" href={zinapoya}>Ariza zinapoyasi: Türkiye Bursları bosqichma-bosqich</a>
          </div>
          <a class="t-tugma adm-tugma--urgu adm-keng-tugma" href={vosita}>Topshirish yoʻli</a>
        </section>
      </div>

      <nav class="mund" aria-label="Sahifa mundarijasi" data-mundarija>
        <p class="adm-eyebrow">Mundarija</p>
        {mundarija.map((b, i) => <a href={`#${b.id}`} data-bolim={b.id} aria-current={i === 0 ? 'location' : undefined}>{b.nomi}</a>)}
      </nav>
    </div>

    <div class="tb-oxir">
      <p class="ikkinchi kichik"><strong class="qalin">Natija kafolatlanmaydi.</strong> Tayanch Türkiye Bursları (YTB) bilan bogʻliq emas. Qabul yoki grant ehtimoli hisoblanmaydi.</p>
    </div>
  </div>
  <SahifaOxiri manbalar={MANBALAR} tekshirilgan={sana} keyingiTekshiruv={keyingi} tekshirilmagan={tekshirilmagan} />
</BolimQobiq>

<script>
  // Joriy bo'lim ikkala mundarijada belgilanadi.
  if ('IntersectionObserver' in window) {
    const havolalar = [...document.querySelectorAll<HTMLAnchorElement>('[data-mundarija] a, .mund-telefon a[data-bolim]')];
    const belgila = (id: string) => havolalar.forEach((a) => {
      if (a.dataset.bolim === id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
    const kuzatuvchi = new IntersectionObserver((yozuvlar) => {
      const korinadi = yozuvlar.filter((y) => y.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (korinadi) belgila(korinadi.target.id);
    }, { rootMargin: '0px 0px -65% 0px' });
    new Set(havolalar.map((a) => a.dataset.bolim)).forEach((id) => {
      const el = document.getElementById(id || '');
      if (el) kuzatuvchi.observe(el);
    });
  }
</script>

<style>
  /* 2-qavat mini-DS: ranglar .adm doirasidan (adm.css), bu yerda tuzilma. Uzun matn zich sirtda (.adm-karta). */
  .tb-sahifa { display: grid; gap: var(--space-10); padding-top: var(--space-4); padding-bottom: var(--space-6); }
  h2 { font-size: var(--text-h2-size); line-height: var(--text-h2-lh); font-weight: var(--font-weight-bold); letter-spacing: var(--text-adm-h2-ls); }
  .ustki { font-size: var(--text-adm-eyebrow-size); line-height: var(--text-adm-eyebrow-lh); font-weight: var(--font-weight-semibold); letter-spacing: var(--text-adm-eyebrow-ls); text-transform: uppercase; color: var(--color-adm-text-muted); }
  .havola { color: var(--color-adm-accent-text); font-weight: var(--font-weight-bold); min-height: var(--size-touch-min); display: inline-flex; align-items: center; text-decoration: underline; text-decoration-thickness: var(--border-width-1); text-underline-offset: 0.2em; }
  .havola-matn { color: var(--color-adm-accent-text); font-weight: var(--font-weight-bold); }
  summary:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }
  .qalin { color: var(--color-adm-text); }
  .matn { max-width: 62ch; }
  .tb-maydon dd a { color: var(--color-adm-accent-text); }

  /* Ikki ustun: matn (zich karta) + yopishqoq mundarija (desktop) */
  .ikki-ustun { display: flex; gap: var(--space-10); align-items: flex-start; }
  .asosiy-ustun { flex: 1; min-width: 0; display: grid; gap: var(--space-8); padding: var(--space-8); }
  .mund { width: 220px; flex: none; position: sticky; top: var(--space-16); display: flex; flex-direction: column; gap: var(--space-1); border-left: var(--border-width-1) solid var(--color-adm-line); padding-left: var(--space-3); }
  .mund .adm-eyebrow { margin: 0 0 var(--space-2) var(--space-3); }
  .mund a { display: flex; align-items: center; min-height: var(--size-touch-min); padding: 0 var(--space-3); border-radius: var(--radius-md); text-decoration: none; color: var(--color-adm-text-muted); font-weight: var(--font-weight-semibold); font-size: var(--text-small-size); }
  @media (hover: hover) and (pointer: fine) { .mund a:hover { background: var(--color-adm-sunken); color: var(--color-adm-text); } }
  .mund a[aria-current], .mund-telefon a[aria-current] { background: var(--color-adm-accent-subtle); color: var(--color-adm-text); box-shadow: inset var(--border-width-2) 0 0 var(--color-adm-orange); }
  .mund-telefon { display: none; }

  .bolim { display: grid; gap: var(--space-3); padding-top: var(--space-8); border-top: var(--border-width-1) solid var(--color-adm-line); scroll-margin-top: var(--space-6); }
  .bolim-birinchi { border-top: 0; padding-top: 0; }
  .bolim-bosh { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); }
  .royxat { margin: 0; padding-left: 1.2em; display: grid; gap: var(--space-2); max-width: 62ch; }
  .royxat li::marker { color: var(--color-adm-accent-text); }
  .izoh { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--text-small-size); color: var(--color-adm-text-muted); }

  .jadval-quti:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }
  .jadval-quti { overflow-x: auto; border: var(--border-width-1) solid var(--color-adm-line-strong); border-radius: var(--radius-md); background: var(--color-adm-surface); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-body-size); }
  caption { text-align: left; padding: var(--space-3) var(--space-4) 0; }
  th, td { text-align: left; padding: var(--space-3) var(--space-4); border-bottom: var(--border-width-1) solid var(--color-adm-line); }
  thead th { font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: var(--text-adm-eyebrow-ls); text-transform: uppercase; color: var(--color-adm-text-muted); }
  tbody th { font-weight: var(--font-weight-bold); }
  tbody td { font-weight: var(--font-weight-extrabold); font-variant-numeric: tabular-nums; }
  tbody tr:last-child > * { border-bottom: 0; }

  /* Taqvim: 4 bosqich, birinchisi to'q sariq */
  .taqvim { background: var(--color-adm-sunken); border: var(--border-width-1) solid var(--color-adm-line); border-radius: var(--radius-lg); padding: var(--space-6); display: grid; gap: var(--space-5); }
  .taqvim-bosh { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .bosqichlar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .bosqichlar li { display: grid; gap: var(--space-2); align-content: start; padding-right: var(--space-3); }
  .bosqichlar li.oxirgi { padding-right: 0; }
  .chiziq-qator { display: flex; align-items: center; }
  .nuqta { width: var(--space-4); height: var(--space-4); flex: none; border-radius: var(--radius-full); background: var(--color-adm-surface); border: var(--border-width-2) solid var(--color-adm-line-strong); }
  .birinchi .nuqta { background: var(--color-adm-accent); border-color: var(--color-adm-accent); }
  .oxirgi .nuqta { background: var(--color-adm-text); border-color: var(--color-adm-text); }
  .chiziq { flex: 1; height: var(--border-width-2); background: var(--color-adm-line-strong); }
  .oxirgi .chiziq { display: none; }

  .stipendiya { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .stipendiya > div { flex: 1 1 160px; border: var(--border-width-1) solid var(--color-adm-line); background: var(--color-adm-sunken); border-radius: var(--radius-md); padding: var(--space-4); display: grid; gap: var(--space-1); }
  .stipendiya dd { margin: 0; font-size: var(--text-h3-size); line-height: var(--text-h3-lh); font-weight: var(--font-weight-extrabold); font-variant-numeric: tabular-nums; }

  /* Keyingi qadam: zich karta, to'q sariq kapsula */
  .keyingi { border: var(--border-width-1) solid var(--color-adm-line); background: var(--color-adm-sunken); border-radius: var(--radius-lg); padding: var(--space-6); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .keyingi-matn { display: grid; gap: var(--space-2); justify-items: start; }
  .keyingi-sarlavha { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); font-weight: var(--font-weight-extrabold); }

  .tb-oxir { border-top: var(--border-width-1) solid var(--color-adm-line-strong); padding-top: var(--space-6); display: grid; gap: var(--space-4); }

