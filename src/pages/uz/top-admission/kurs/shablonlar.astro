---
// 2-qavat mini-DS (ADR 005, PR 7): adm.css (.adm doira, eyebrow, Onest 800 sarlavha; uzun matn zich sirtda).
// 2-qavat · Top Admission · kurs: 12 ish shabloni (Admission J; spetsifikatsiya 6-band, muallif tasdig'i 2026-11-21).
// Ma'lumot: src/data/topAdmission/shablonlar.json (Codex to'plami templates/01-working-templates.md dan bir martalik o'girilgan).
// Har shablon <details> ichida; o'zbekcha va inglizcha bloklar, har biriga "Nusxa olish" (clipboard).
// Clipboard ishlamasa matn belgilanadi va qo'lda nusxa olish aytiladi. URL hash (#s05) shu shablonni ochadi.
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import { DARSLAR, KURS_NOMI } from '../../../../data/topAdmission/kurs';
import data from '../../../../data/topAdmission/shablonlar.json';
import { yol } from '../../../../lib/yol';
import '../../../../styles/adm.css';

const darsHref = (raqam: number) => {
  const d = DARSLAR.find((x) => x.raqam === raqam)!;
  return { href: yol(`/uz/top-admission/kurs/${d.slug}/`), nom: `${d.raqam}-dars` };
};
const TIL = { uz: "O'zbekcha", en: 'English' } as const;
---
<BolimQobiq
  title={`Ish shablonlari · ${KURS_NOMI}`}
  description="12 ish shabloni: dastur kartasi, dalillar inventari, esse rejasi, activities, Academic CV, SOP, research proposal, professorga xat va boshqalar. O'zbekcha va inglizcha."
  turi="qollanma"
  bolim="top-admission"
  holat="chop-etilgan"
  yol={["Qo'llanmalar", KURS_NOMI]}
>
  <div class="ichki sh-sahifa" data-shablonlar>
    <header class="sh-bosh">
      <p class="adm-eyebrow">Kurs</p>
      <h1 class="adm-h1">Ish shablonlari</h1>
      <p class="matn">{data.izoh}</p>
      <p class="sust">Har shablonni oching va nusxa oling. Inglizcha variant arizaning oʻzi uchun, oʻzbekchasi tushunish va qoralama uchun. <a class="havola-matn" href={yol('/uz/top-admission/kurs/namunalar/')}>Yozuv namunalari</a> · <a class="havola-matn" href={yol('/uz/top-admission/kurs/')}>Barcha darslar</a></p>
    </header>

    <ul class="sh-royxat">
      {data.shablonlar.map((s) => (
        <li>
          <details class="sh-shablon" id={s.id}>
            <summary>
              <span class="sh-raqam" aria-hidden="true">{s.raqam}</span>
              <span class="sh-nom">{s.nom}</span>
            </summary>
            <div class="sh-ichi">
              <p class="sust">Darslar: {s.darslar.map((r, i) => { const d = darsHref(r); return <>{i > 0 && ', '}<a class="havola-matn" href={d.href}>{d.nom}</a></>; })}</p>
              {s.izoh.map((z) => <p class="matn">{z}</p>)}
              {s.bloklar.map((b) => (
                <div class="sh-blok">
                  <div class="sh-blok-bosh">
                    <span class="yorliq">{TIL[b.til as 'uz' | 'en']}</span>
                    <button type="button" class="t-tugma t-tugma--ikkinchi sh-nusxa" data-nusxa hidden>
                      Nusxa olish<span class="sr"> ({s.nom}, {TIL[b.til as 'uz' | 'en']})</span>
                    </button>
                  </div>
                  <pre class="sh-matn" lang={b.til} tabindex="0">{b.matn}</pre>
                  <p class="sh-xabar" aria-live="polite" data-xabar></p>
                </div>
              ))}
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</BolimQobiq>

<script>
  const ildiz = document.querySelector<HTMLElement>('[data-shablonlar]');
  if (ildiz) {
    const och = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const el = id ? ildiz.querySelector<HTMLDetailsElement>(`details#${CSS.escape(id)}`) : null;
      if (el) { el.open = true; el.scrollIntoView({ block: 'start' }); el.querySelector('summary')?.focus(); }
    };
    och();
    addEventListener('hashchange', och);

    ildiz.querySelectorAll<HTMLButtonElement>('[data-nusxa]').forEach((tugma) => {
      tugma.hidden = false;
      const blok = tugma.closest('.sh-blok')!;
      const pre = blok.querySelector<HTMLElement>('pre')!;
      const xabar = blok.querySelector<HTMLElement>('[data-xabar]')!;
      let taymer = 0;
      tugma.addEventListener('click', async () => {
        clearTimeout(taymer);
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          xabar.textContent = 'Nusxa olindi';
        } catch {
          const r = document.createRange();
          r.selectNodeContents(pre);
          const sel = getSelection();
          sel?.removeAllRanges();
          sel?.addRange(r);
          xabar.textContent = "Avtomatik nusxa olib bo'lmadi: matn belgilandi, Cmd+C yoki Ctrl+C bosing.";
        }
        taymer = window.setTimeout(() => { xabar.textContent = ''; }, 4000);
      });
    });
  }
</script>

<style>
  .sh-sahifa { display: grid; gap: var(--space-6); padding-bottom: var(--space-6); }
  .sh-bosh { display: grid; gap: var(--space-3); }
  .ustki { margin: 0; font-size: var(--text-adm-eyebrow-size); line-height: var(--text-adm-eyebrow-lh); font-weight: var(--font-weight-semibold); letter-spacing: var(--text-adm-eyebrow-ls); text-transform: uppercase; color: var(--color-adm-text-muted); }
  .matn { max-width: 62ch; margin: 0; }
  .sust { max-width: 62ch; margin: 0; color: var(--color-adm-text-muted); }
  .havola-matn { color: var(--color-link); font-weight: var(--font-weight-bold); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sh-royxat { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .sh-shablon { border: var(--border-width-1) solid var(--color-adm-glass-border); border-radius: var(--radius-xl); background: var(--color-adm-glass-strong); box-shadow: var(--shadow-glass); scroll-margin-top: var(--space-8); }
  .sh-shablon > summary {
    display: flex; align-items: center; gap: var(--space-3); min-height: 56px; padding: var(--space-2) var(--space-4);
    cursor: pointer; font-weight: var(--font-weight-bold); list-style: none;
  }
  .sh-shablon > summary::-webkit-details-marker { display: none; }
  .sh-shablon > summary::after { content: '+'; margin-left: auto; font-size: 1.4em; line-height: 1; color: var(--color-adm-text-muted); }
  .sh-shablon[open] > summary::after { content: '−'; }
  .sh-shablon > summary:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; border-radius: var(--radius-lg); }
  .sh-raqam {
    flex: none; width: 32px; height: 32px; display: inline-grid; place-items: center; border-radius: var(--radius-full);
    border: 1.5px solid var(--color-adm-line-strong); font-size: var(--text-small-size);
  }
  .sh-ichi { display: grid; gap: var(--space-4); padding: 0 var(--space-4) var(--space-4); }
  .sh-blok { display: grid; gap: var(--space-2); min-width: 0; }
  .sh-blok-bosh { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .sh-matn {
    margin: 0; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-adm-bg); border: 1px solid var(--color-adm-line);
    font-family: inherit; font-size: var(--text-small-size); line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .sh-matn:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }
  .sh-xabar { margin: 0; min-height: 1.4em; font-size: var(--text-small-size); color: var(--color-adm-text-muted); }
</style>
