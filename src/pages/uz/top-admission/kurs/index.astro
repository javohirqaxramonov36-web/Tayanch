---
// 2-qavat · Top Admission · kurs bosh sahifasi (Admission H; spetsifikatsiya muallif tasdig'i bilan, 2026-11-21).
// 4 modul, 16 dars; mazmuni tayyor darslar havola, qolgani "tez orada". Tavsiya etilgan yo'llar (bakalavr, magistratura).
// Progress `tayanch:top-admission-kurs-progress` dan (kursProgress.ts): "n / jami dars bajarildi", har dars yonida belgi.
// "Belgilarni tozalash": sahifa ichidagi tasdiq ("Ha, tozalash" / "Bekor qilish"), confirm() yo'q.
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import { DARSLAR, KURS_NOMI, KURS_TAVSIF, MODULLAR, YOLLAR } from '../../../../data/topAdmission/kurs';
import { KURS_KALIT } from '../../../../lib/topAdmission/kursProgress';
import { yol } from '../../../../lib/yol';

const tayyor = DARSLAR.filter((d) => d.tushuntirish);
const darslarJson = JSON.stringify(tayyor.map((d) => ({ slug: d.slug, mezonlar: d.mezonlar!.map((m) => m.id) })));
---
<BolimQobiq
  title={`${KURS_NOMI} · Top Admission`}
  description="Top Admission kursi: kuchli STEM profilini dalillangan arizaga aylantirish. 16 dars, namunalar, mashqlar va tekshiruv mezonlari."
  turi="qollanma"
  bolim="top-admission"
  holat="chop-etilgan"
  yol={["Qo'llanmalar"]}
>
  <div class="ichki kk-sahifa" data-kurs data-kalit={KURS_KALIT} data-darslar={darslarJson} data-jami={DARSLAR.length}>
    <header class="kk-bosh">
      <p class="ustki">Kurs</p>
      <h1>{KURS_NOMI}</h1>
      <p class="matn">{KURS_TAVSIF}</p>
      <p class="sust">Mashqlar, namunalar va tekshiruv mezonlari Tayanch uchun yozilgan original o'quv materiallari. Belgilar faqat shu brauzerda saqlanadi.</p>
      <p class="kk-qoshimcha"><a class="tugma tugma-ikkinchi" href={yol('/uz/top-admission/kurs/shablonlar/')}>Ish shablonlari</a> <a class="tugma tugma-ikkinchi" href={yol('/uz/top-admission/kurs/namunalar/')}>Yozuv namunalari</a></p>
      <div class="kk-progress" data-progress hidden>
        <p class="kk-soni" aria-live="polite" tabindex="-1" data-soni></p>
        <div class="kk-tozala">
          <button type="button" class="tugma tugma-ikkinchi" data-tozala>Belgilarni tozalash</button>
          <div class="kk-tasdiq" data-tasdiq hidden role="group" aria-label="Tozalashni tasdiqlash">
            <span>Hamma darslardagi belgilar o'chadi.</span>
            <button type="button" class="tugma tugma-asosiy" data-ha>Ha, tozalash</button>
            <button type="button" class="tugma tugma-ikkinchi" data-bekor>Bekor qilish</button>
          </div>
        </div>
      </div>
    </header>

    <section class="kk-yollar" aria-labelledby="kk-yol">
      <h2 id="kk-yol">Qaysi darslar sizga</h2>
      <ul class="kk-yol-royxat">
        {YOLLAR.map((y) => <li><strong>{y.nom}:</strong> {y.darslar.join(', ')}-darslar</li>)}
      </ul>
    </section>

    {MODULLAR.map((m) => (
      <section class="kk-modul" aria-labelledby={`kk-m${m.raqam}`}>
        <h2 id={`kk-m${m.raqam}`}>{m.raqam}-modul. {m.nom}</h2>
        <ol class="kk-darslar">
          {DARSLAR.filter((d) => d.modul === m.raqam).map((d) => (
            <li class="kk-dars" data-slug={d.slug}>
              <span class="kk-raqam" aria-hidden="true">{d.raqam}</span>
              {d.tushuntirish
                ? <a class="kk-nom" href={yol(`/uz/top-admission/kurs/${d.slug}/`)}>{d.nom}</a>
                : <span class="kk-nom kk-sust">{d.nom}</span>}
              {d.tushuntirish
                ? <span class="yorliq kk-belgi" data-bajarildi hidden>Bajarildi</span>
                : <span class="yorliq">Tez orada</span>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BolimQobiq>

<script>
  import { holatOqi, holatYoz } from '../../../../lib/holat';
  import { bajarilganSoni, darsBajarildimi, progressniTozala } from '../../../../lib/topAdmission/kursProgress';

  const ildiz = document.querySelector<HTMLElement>('[data-kurs]');
  if (ildiz) {
    const kalit = ildiz.dataset.kalit!;
    const darslar = JSON.parse(ildiz.dataset.darslar ?? '[]') as { slug: string; mezonlar: string[] }[];
    const soni = ildiz.querySelector<HTMLElement>('[data-soni]')!;
    const tozala = ildiz.querySelector<HTMLButtonElement>('[data-tozala]')!;
    const tasdiq = ildiz.querySelector<HTMLElement>('[data-tasdiq]')!;
    const ha = ildiz.querySelector<HTMLButtonElement>('[data-ha]')!;
    const bekor = ildiz.querySelector<HTMLButtonElement>('[data-bekor]')!;

    const chiz = () => {
      const p = progressniTozala(holatOqi<unknown>(kalit, {}));
      const n = bajarilganSoni(p, darslar);
      soni.textContent = `${ildiz.dataset.jami} tadan ${n} ta dars bajarildi`;
      for (const d of darslar) {
        const belgi = ildiz.querySelector<HTMLElement>(`[data-slug="${d.slug}"] [data-bajarildi]`);
        if (belgi) belgi.hidden = !darsBajarildimi(p, d.slug, d.mezonlar);
      }
      tozala.hidden = Object.keys(p).length === 0;
    };
    const yop = () => { tasdiq.hidden = true; tozala.hidden = false; tozala.focus(); chiz(); };
    tozala.addEventListener('click', () => { tasdiq.hidden = false; tozala.hidden = true; bekor.focus(); });
    bekor.addEventListener('click', yop);
    ha.addEventListener('click', () => {
      if (!holatYoz(kalit, {})) soni.textContent = "Tozalab bo'lmadi: brauzer saqlashga ruxsat bermadi.";
      tasdiq.hidden = true;
      chiz();
      soni.focus();
    });
    tasdiq.addEventListener('keydown', (e) => { if (e.key === 'Escape') yop(); });
    ildiz.querySelector<HTMLElement>('[data-progress]')!.hidden = false;
    chiz();
  }
</script>

<style>
  .kk-sahifa { display: grid; gap: var(--b-8); padding-bottom: var(--b-6); }
  .kk-bosh { display: grid; gap: var(--b-3); }
  .ustki { margin: 0; font-size: var(--matn-mayda); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--matn-sust); }
  .matn { max-width: 62ch; margin: 0; }
  .sust { max-width: 62ch; margin: 0; color: var(--matn-ikkinchi); }
  .kk-qoshimcha { margin: 0; display: flex; flex-wrap: wrap; gap: var(--b-2) var(--b-3); }
  .kk-progress { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-3) var(--b-5); }
  .kk-soni { margin: 0; font-weight: 700; }
  .kk-tasdiq { display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-2) var(--b-3); }
  .kk-tasdiq[hidden], .kk-tozala [hidden] { display: none; }
  .kk-yollar, .kk-modul { display: grid; gap: var(--b-3); }
  .kk-yollar h2, .kk-modul h2 { margin: 0; }
  .kk-yol-royxat { margin: 0; padding-left: 1.2em; display: grid; gap: var(--b-1); }
  .kk-darslar { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--b-2); }
  .kk-dars {
    display: flex; align-items: center; gap: var(--b-3); min-height: 56px; padding: var(--b-2) var(--b-4);
    border: 1.5px solid var(--chiziq-kuchli); border-radius: var(--r-katta); background: var(--sirt);
  }
  .kk-raqam {
    flex: none; width: 32px; height: 32px; display: inline-grid; place-items: center; border-radius: var(--r-toliq);
    border: 1.5px solid var(--chiziq-kuchli); font-weight: 700; font-size: var(--matn-kichik);
  }
  .kk-nom { flex: 1; min-width: 0; font-weight: 700; }
  a.kk-nom { color: var(--rang-havola); min-height: 44px; display: inline-flex; align-items: center; }
  .kk-sust { color: var(--matn-sust); }
  .kk-belgi[hidden] { display: none; }
</style>
