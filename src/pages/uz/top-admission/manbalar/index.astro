---
// 2-qavat mini-DS (ADR 005, PR 7): adm.css (.adm doira, eyebrow, Onest 800 sarlavha; uzun matn zich sirtda).
// 2-qavat · Top Admission · qo'llanma: Ochiq manbalar kutubxonasi (Admission G).
// Ma'lumot: src/data/topAdmission/ochiqManbalar.json (Codex tadqiqot to'plami, `npm run malumot:tadqiqot`).
// Statik sahifa, JS yo'q. Faqat havola va qisqa izoh: manba matni ko'chirilmaydi.
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import { sanaMatni } from '../../../../lib/topAdmission/fakt';
import { DARAJA_MATNI, type Daraja } from '../../../../lib/topAdmission/grantKatalog';
import manbalarJson from '../../../../data/topAdmission/ochiqManbalar.json';
import { yol } from '../../../../lib/yol';
import '../../../../styles/adm.css';

interface Resurs { id: string; guruh: string; daraja: Daraja; nom: string; url: string; nima_uchun: string; bepul: boolean; tekshirilgan_sana: string }
const resurslar = manbalarJson as Resurs[];
const guruhlar = [
  { id: 'ariza', nomi: 'Ariza va esse', izoh: "Universitetlar va platformalarning o'z yo'riqnomalari." },
  { id: 'magistr', nomi: 'Magistratura, CV va tavsiyanoma', izoh: 'Statement of purpose, CV va moliyalashtirish.' },
  { id: 'qidiruv', nomi: 'Dastur va grant qidirish', izoh: "Rasmiy bazalar va maslahat xizmatlari." },
  { id: 'stem', nomi: 'STEM tayyorgarlik', izoh: "Profilni kuchaytirish uchun bepul kurslar." },
  { id: 'xavfsizlik', nomi: 'Xavfsizlik va viza', izoh: 'Davlat tanlashda ishlatilgan rasmiy ko\'rsatkichlar.' },
] as const;
const sana = resurslar[0]?.tekshirilgan_sana ?? '';
const arzon = yol('/uz/top-admission/arzon-yollar/');
---
<BolimQobiq
  title="Ochiq manbalar · Top Admission"
  description="Ariza, esse, CV, magistratura va STEM tayyorgarlik uchun bepul rasmiy manbalar: Common App, UCAS, MIT, EducationUSA, DAAD va boshqalar."
  turi="qollanma"
  bolim="top-admission"
  holat="chop-etilgan"
  tekshirilgan={sana}
  yol={["Qo'llanmalar"]}
>
  <div class="ichki om-sahifa">
    <header class="om-bosh">
      <p class="adm-eyebrow">Qo'llanma</p>
      <h1 class="adm-h1">Ochiq manbalar</h1>
      <p class="matn">{resurslar.length} ta bepul rasmiy manba: universitetlar, ariza platformalari va davlat tashkilotlarining o'z sahifalari. Har biri nima uchun kerakligi bilan.</p>
      <p class="matn sust">Hammasi {sanaMatni(sana)} da bepul o'qish uchun ochiq edi. Manbani o'qing va havola bering: to'liq matnni ko'chirmang.</p>
    </header>

    {guruhlar.map((g) => {
      const ichida = resurslar.filter((r) => r.guruh === g.id);
      return ichida.length > 0 && (
        <section class="guruh" aria-labelledby={`om-${g.id}`}>
          <div class="guruh-bosh">
            <h2 id={`om-${g.id}`}>{g.nomi}</h2>
            <p class="sust">{g.izoh}</p>
          </div>
          <ul class="royxat">
            {ichida.map((r) => (
              <li class="band">
                <a class="havola" href={r.url} rel="noopener" lang="en">{r.nom}</a>
                <p class="izoh">{r.nima_uchun}</p>
                <p class="yorliqlar"><span class="yorliq">{DARAJA_MATNI[r.daraja]}</span></p>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <p class="matn">Xarajatni kamaytirish yo'llari: <a class="havola-matn" href={arzon}>Arzonroq o'qish yo'llari</a>.</p>
  </div>
</BolimQobiq>

<style>
  .om-sahifa { display: grid; gap: var(--b-8); padding-bottom: var(--b-6); }
  .om-bosh { display: grid; gap: var(--b-3); }
  .ustki { margin: 0; font-size: var(--text-adm-eyebrow-size); line-height: var(--text-adm-eyebrow-lh); font-weight: var(--font-weight-semibold); letter-spacing: var(--text-adm-eyebrow-ls); text-transform: uppercase; color: var(--color-adm-text-muted); }
  .matn { max-width: 62ch; margin: 0; }
  .sust { margin: 0; color: var(--matn-ikkinchi); }
  .guruh { display: grid; gap: var(--b-4); }
  .guruh-bosh { display: grid; gap: var(--b-1); }
  .guruh-bosh h2 { margin: 0; }
  .royxat { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--b-3); }
  .band {
    display: grid; gap: var(--b-1); align-content: start; min-width: 0;
    padding: var(--b-4) var(--b-5); border: var(--border-width-1) solid var(--color-adm-glass-border); border-radius: var(--radius-xl); background: var(--color-adm-glass-strong); box-shadow: var(--shadow-glass);
  }
  .havola { color: var(--rang-havola); font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; overflow-wrap: anywhere; }
  .izoh { margin: 0; }
  .yorliqlar { margin: 0; }
  .havola-matn { color: var(--rang-havola); font-weight: 700; }
  @media (max-width: 760px) { .royxat { grid-template-columns: 1fr; } }
</style>
