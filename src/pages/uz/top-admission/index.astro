---
// 2-qavat · Top Admission · bo'lim kirishi.
// Dizayn: Claude Design "Tayanch Top Admission maketi", A artboard (Main, KirishTelefon):
// https://claude.ai/artifact/1zP2rnjMp46RgY9WpD84GF
// 2-qavat mini-DS (ADR 005, PR 7, 2026-11-23): AdmHero, AdmPlitka, AdmMuddat, AdmTekshirildi (src/styles/adm.css).
// v1 pasport detallari (muhr, chipta, MRZ, yo'l xaritasi) olib tashlandi: muallif DS'da rad etgan.
// Muddatlar: deadline.ts (EY01, TB01). Stipendium Hungaricum: SH01. Muallif: muallif.ts (tasdiqlangan).
// Qolip: BolimQobiq (Top Admission yon paneli, maket "LiftSidebar"). Manbalar bloki sahifaning o'zida.
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import SahifaOxiri from '../../../components/SahifaOxiri.astro';
import QavatFoto from '../../../components/QavatFoto.astro';
import AdmHero from '../../../components/topAdmission/AdmHero.astro';
import AdmPlitka from '../../../components/topAdmission/AdmPlitka.astro';
import AdmMuddat from '../../../components/topAdmission/AdmMuddat.astro';
import AdmTekshirildi from '../../../components/topAdmission/AdmTekshirildi.astro';
import '../../../styles/adm.css';
import { taChiptalar } from '../../../data/taChiptalar';
import { manbalar } from '../../../data/manbalar';
import { qabulXatlari } from '../../../data/muallif';
import { SAVOLLAR, KALIT } from '../../../data/topshirishYoli';
import { getCollection } from 'astro:content';
import { grantKorinadimi, type GrantKirish } from '../../../lib/topAdmission/grantKatalog';
import { yol } from '../../../lib/yol';

const m = (id: string) => manbalar.find((x) => x.id === id)!;
const vosita = yol('/uz/top-admission/vosita/topshirish-yoli/');
const zinapoya = yol('/uz/top-admission/qollanma/ariza-zinapoyasi/');
const platformalar = yol('/uz/top-admission/platformalar/');

// Muddat chiptalari va ularning .ics fayllari bitta manbadan (taChiptalar.ts).
const chiptalar = taChiptalar;

// Boshqa davlatlar: Grantlar katalogidagi ko'rinadigan grantlar soni (yangi fakt yo'q), har biri katalog filtriga olib boradi.
const korinadiganGrantlar = (await getCollection('grantlar')).filter((e) => grantKorinadimi(e.data as unknown as GrantKirish));
const grantSoni = (davlat: string) => korinadiganGrantlar.filter((e) => (e.data.davlat as { id?: string })?.id === davlat).length;
const boshqaDavlatlar = [
  { kod: 'UZ → US', nomi: 'AQSH', slug: 'aqsh' },
  { kod: 'UZ → GB', nomi: 'Buyuk Britaniya', slug: 'buyuk-britaniya' },
  { kod: 'UZ → DE', nomi: 'Germaniya', slug: 'germaniya' },
  { kod: 'UZ → KR', nomi: 'Janubiy Koreya', slug: 'janubiy-koreya' },
  { kod: 'UZ → JP', nomi: 'Yaponiya', slug: 'yaponiya' },
  { kod: 'UZ → AU', nomi: 'Avstraliya', slug: 'avstraliya' },
  { kod: 'UZ → CN', nomi: 'Xitoy', slug: 'xitoy' },
]
  .map((d) => ({ ...d, soni: grantSoni(d.slug), href: yol(`/uz/top-admission/grantlar/?d=${d.slug}`) }))
  .filter((d) => d.soni > 0);
const shGrant = korinadiganGrantlar.find((e) => e.id === 'stipendium-hungaricum');
// "Mening yo'lim": Topshirish yo'li javoblari (faqat o'qiladi). Variant nomlari skriptga JSON bilan beriladi.
const yolMalumot = {
  KALIT,
  nomlar: Object.fromEntries(
    Object.entries(SAVOLLAR).map(([k, s]) => [k, Object.fromEntries(s.variantlar.map((v) => [v.id, v.nomi]))]),
  ),
};
// Vosita savollari: variantlar vositaning o'zidan (SAVOLLAR), tanlov o'sha kalitga yoziladi (KALIT).
const savollar = (
  [
    { n: 1, k: 'davlat', nomi: 'Davlat' },
    { n: 2, k: 'daraja', nomi: 'Daraja' },
    { n: 3, k: 'grant', nomi: 'Grant' },
  ] as const
).map((s) => ({ ...s, variantlar: SAVOLLAR[s.k].variantlar }));
// Bo'lim plitkalari: faqat mavjud sahifalar (topAdmissionSahifalar.ts bilan bir xil manzillar)
const plitkalar = [
  { href: yol('/uz/top-admission/grantlar/'), nomi: 'Grantlar', ikonka: 'grant' },
  { href: yol('/uz/top-admission/davlatlar/'), nomi: 'Davlatlar', ikonka: 'davlat' },
  { href: yol('/uz/top-admission/universitetlar/'), nomi: 'Universitetlar', ikonka: 'universitet' },
  { href: yol('/uz/top-admission/kurs/'), nomi: 'Kurs', ikonka: 'kurs' },
  { href: yol('/uz/deadline/'), nomi: 'Muddatlar', ikonka: 'muddat' },
  { href: yol('/uz/top-admission/manbalar/'), nomi: 'Manbalar', ikonka: 'manba' },
] as const;
const tekshirilmagan = [
  "Türkiye Bursları 2027-yil e'loni (taqvimda yil yozilmagan)",
  "Stipendium Hungaricum 2027/28 e'loni va muddati (hali chiqmagan)",
];
---
<BolimQobiq
  title="Top Admission"
  description="Chet el universitetiga ariza yo'lini rasmiy manbalar bilan ko'rsatadi. Natija kafolatlanmaydi."
  turi="bolim-kirishi"
  bolim="top-admission"
  holat="chop-etilgan"
  tekshirilgan="2026-11-05"
  keyingiTekshiruv="2026-12-05"
  manbalar={['EY01', 'TB01', 'SH01']}
  tekshirilmagan={tekshirilmagan}
>
  <div class="ichki ta-sahifa">
    <QavatFoto bolim="top-admission" />

    <AdmHero id="ta-sarlavha" yorliq="Bo'lim kirishi" sarlavha="Top" urgu="Admission">
      <p class="adm-hero-matn">Chet el universitetiga ariza yo'lini rasmiy manbalar bilan ko'rsatamiz. Natija kafolatlanmaydi.</p>
      <p class="adm-hero-matn qisman">Bo'limda: <a href={yol('/uz/top-admission/grantlar/')}>grantlar katalogi</a>, <a href={yol('/uz/top-admission/davlatlar/')}>davlatlarni taqqoslash</a>, <a href={yol('/uz/top-admission/universitetlar/')}>universitet tanlash</a>, <a href={yol('/uz/top-admission/kurs/')}>16 darslik kurs</a> va <a href={yol('/uz/top-admission/manbalar/')}>ochiq manbalar</a>.</p>
      <Fragment slot="tugmalar">
        <a class="t-tugma adm-tugma--urgu" href={vosita}>
          Yo'limni topish
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="t-tugma t-tugma--ikkinchi" href={yol('/uz/deadline/')}>Barcha muddatlar</a>
      </Fragment>
    </AdmHero>

    <AdmPlitka yorliq="Top Admission bo'limlari" bandlar={[...plitkalar]} />

    <section class="vosita-karta adm-karta" aria-labelledby="vosita-sarlavha">
      <div class="vosita-matn">
        <p class="adm-eyebrow">Vosita · 3 savol</p>
        <h2 id="vosita-sarlavha" class="adm-h2">Topshirish <span class="adm-urgu">yo'li</span></h2>
        <p class="ikkinchi">Qaysi davlat, qaysi daraja, grant kerakmi. Javoblaringizga mos ariza yo'llari va ularning rasmiy manbalari chiqadi.</p>
        <ol class="savollar" data-kalit={KALIT}>
          {savollar.map((s) => (
            <li data-savol={s.k}>
              <span class="raqam" aria-hidden="true">{s.n}</span>
              <span class="savol-nom" id={`ta-savol-${s.k}`}>{s.nomi}</span>
              <span class="variantlar">{s.variantlar.map((v) => <span class="variant" data-v={v.id}>{v.nomi}</span>)}</span>
            </li>
          ))}
        </ol>
        <div class="vosita-past">
          <a class="t-tugma katta-tugma" href={vosita}>
            Yo'limni topish
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </a>
          <span class="sust kichik">Qabul ehtimoli hisoblanmaydi</span>
          <a class="havola" href={zinapoya}>Ariza zinapoyasi: interaktiv dars</a>
          <a class="havola" href={platformalar}>Platformalar xaritasi</a>
        </div>
      </div>
      <div class="sahna" aria-hidden="true">
        <div class="savol-zinasi">
          <div class="pog p1" data-q="davlat"><div class="old"></div><div class="yon"></div><div class="ust"><span>Davlat</span></div></div>
          <div class="pog p2" data-q="daraja"><div class="old"></div><div class="yon"></div><div class="ust"><span>Daraja</span></div></div>
          <div class="pog p3" data-q="grant"><div class="old"></div><div class="yon"></div><div class="ust"><span>Grant</span></div></div>
        </div>
        <p class="sahna-izoh">Savol progressi</p>
      </div>
    </section>
    <script is:inline>
      // Vosita kartasidagi chiplar: JS bo'lsa tugmaga aylanadi (aria-pressed). Tanlov Topshirish yo'li kalitiga yoziladi
      // (vosita bilan bir format: {davlat, daraja, grant} variant id'lari), "Mening yo'lim" va 3D zinapoya yangilanadi.
      // JS bo'lmasa: statik yozuvlar. localStorage ishlamasa: tanlov ko'rinadi, saqlanmaydi.
      (() => {
        const karta = document.currentScript && document.currentScript.previousElementSibling;
        const ol = karta && karta.querySelector('.savollar');
        if (!ol) return;
        const kalit = ol.dataset.kalit;
        let javob = {};
        try { const s = JSON.parse(localStorage.getItem(kalit) || 'null'); if (s && typeof s === 'object') javob = s; } catch (e) { /* o'qib bo'lmadi */ }
        const belgi = '<svg class="variant-belgi" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>';
        const chiz = () => {
          ol.querySelectorAll('button.variant').forEach((b) => b.setAttribute('aria-pressed', String(javob[b.dataset.k] === b.dataset.v)));
          karta.querySelectorAll('.pog[data-q]').forEach((p) => p.classList.toggle('bajarildi', !!ol.querySelector(`button.variant[data-k="${p.dataset.q}"][aria-pressed="true"]`)));
        };
        ol.querySelectorAll('li[data-savol]').forEach((li) => {
          const k = li.dataset.savol;
          const guruh = li.querySelector('.variantlar');
          guruh.setAttribute('role', 'group');
          guruh.setAttribute('aria-labelledby', `ta-savol-${k}`);
          guruh.querySelectorAll('span.variant').forEach((sp) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'variant';
            b.dataset.k = k;
            b.dataset.v = sp.dataset.v;
            b.innerHTML = belgi;
            b.append(sp.textContent);
            b.addEventListener('click', () => {
              javob = { ...javob, [k]: b.dataset.v };
              try { localStorage.setItem(kalit, JSON.stringify(javob)); } catch (e) { /* saqlanmadi */ }
              chiz();
              document.dispatchEvent(new CustomEvent('ta-yol-yangilandi'));
            });
            sp.replaceWith(b);
          });
        });
        chiz();
      })();
    </script>

    <section class="blok" aria-labelledby="yonalish-sarlavha">
      <h2 id="yonalish-sarlavha" class="adm-h2">Yo'nalishlar</h2>
      <div class="yonalishlar">
        <article class="yonalish yonalish-katta adm-karta">
          <div class="yonalish-matn">
            <p class="yorliqlar"><span class="adm-chip">Rasmiy taqvim bor</span> <span class="adm-chip adm-chip--sust">UZ → TR</span></p>
            <h3>Türkiye Bursları</h3>
            <p class="ikkinchi">Turkiya hukumatining xalqaro talabalar uchun stipendiya dasturi. Umumiy ariza har yili 10-yanvar – 20-fevral.</p>
            <p class="yonalish-past"><a class="havola" href={yol('/uz/top-admission/turkiye-burslari/')}>Yo'nalish sahifasi</a> <a class="havola" href={vosita}>Topshirish yo'lida ko'rish</a></p>
          </div>
          <AdmTekshirildi sana={m('TB01').tekshirilganSana} />
        </article>
        <article class="yonalish adm-karta">
          <p class="yorliqlar"><span class="adm-chip adm-chip--sust">UZ → HU</span></p>
          <h3>Stipendium Hungaricum</h3>
          <p class="fakt">
            <AdmTekshirildi sana={m('SH01').tekshirilganSana} />
            <span>O'zbekiston hamkor davlatlar ro'yxatida</span>
          </p>
          {shGrant && <p class="yonalish-past"><a class="havola" href={yol('/uz/top-admission/grantlar/stipendium-hungaricum/')}>Grant sahifasi</a></p>}
          <span class="yorliq yorliq-ogoh">2027/28 e'loni hali chiqmagan</span>
        </article>
      </div>
      {boshqaDavlatlar.length > 0 && (
        <nav class="tez-orada" aria-label="Boshqa davlatlar grantlari">
          <ul class="tez-royxat">
            {boshqaDavlatlar.map((t) => (
              <li><a class="tez-havola" href={t.href}><span class="tez-kod">{t.kod}</span> <span class="tez-nom">{t.nomi}</span> <span class="tez-soni">{t.soni} ta grant</span></a></li>
            ))}
          </ul>
          <a class="havola" href={yol('/uz/top-admission/davlatlar/')}>Barcha davlatlar</a>
        </nav>
      )}
    </section>

    <div class="yol-qator">
    <section class="blok" aria-labelledby="muddat-sarlavha">
      <div class="blok-bosh">
        <h2 id="muddat-sarlavha" class="adm-h2">Yaqin <span class="adm-urgu">muddatlar</span></h2>
        <a class="havola" href={yol('/uz/deadline/')}>Barcha muddatlar</a>
      </div>
      <div class="muddatlar" data-adm-tartib>
        {chiptalar.map((c) => (
          <AdmMuddat
            id={`ta-${c.id}`}
            nomi={c.ustki}
            qatorlar={[{ dt: 'Muddat', dd: c.katta }, { dt: 'Bosqich', dd: c.matn }]}
            ochilish={c.ochilish}
            kun={c.chegara.kun}
            oxir={c.chegara.oxir}
            zaxiraMatn={`${c.korishokKatta} ${c.korishokMatn}`}
            manba={c.manba}
          >
            {c.izoh && <p class="adm-manba">{c.izoh}</p>}
            <a slot="havolalar" class="havola kalendar" href={yol(`/uz/top-admission/kalendar/${c.id}.ics`)} download={`${c.id}.ics`} aria-label={`Kalendarga qo'shish: ${c.ustki}, oxirgi kun ${c.korishokKatta}`}>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18M12 14v4M10 16h4" /></svg>
              Kalendarga qo'shish
            </a>
          </AdmMuddat>
        ))}
      </div>
      <p class="adm-manba" data-adm-bosh hidden>Hozircha yaqin muddat yo'q. Keyingi e'lonlar <a class="havola" href={yol('/uz/deadline/')}>Muddatlar</a> sahifasida.</p>
    </section>

    <section class="mening-yolim adm-karta" id="mening-yolim" aria-labelledby="mening-sarlavha" data-mening-yolim>
      <h2 id="mening-sarlavha" class="adm-eyebrow">Mening yo'lim</h2>
      <div data-holat="bosh">
        <p class="mening-asosiy">Hali yo'l tanlanmagan</p>
        <p class="ikkinchi kichik">Topshirish yo'lida javob bersangiz, tanlovingiz shu yerda turadi. Faqat shu brauzerda.</p>
        <a class="havola" href={vosita}>3 savolga javob berish</a>
      </div>
      <div data-holat="bor" hidden>
        <p class="mening-asosiy" data-tanlov></p>
        <p class="ikkinchi kichik">Faqat shu brauzerda saqlangan. Qabul ehtimoli hisoblanmaydi.</p>
        <a class="havola" href={vosita}>Yo'limni ochish</a>
      </div>
    </section>
    <script type="application/json" id="ta-yol-malumot" set:html={JSON.stringify(yolMalumot)} />

    <section class="ishonch adm-karta" aria-labelledby="ishonch-sarlavha">
      <div class="ishonch-bosh">
        <h2 id="ishonch-sarlavha" class="adm-eyebrow">Muallif yo'li</h2>
        <a class="havola" href={yol('/uz/') + '#muallif-sarlavha'}>To'liq hikoya</a>
      </div>
      <p class="ishonch-son">{qabulXatlari.soni} ta qabul xati</p>
      <p class="ikkinchi kichik">Hujjat bilan tasdiqlangan. Previewlarda shaxsiy ma'lumotlar yopilgan, original hujjat emas.</p>
      <ul class="previewlar">
        {qabulXatlari.previewlar.map((p) => (
          <li>
            <img src={yol(`/proof/${p.fayl}`)}
              srcset={`${yol(`/proof/${p.fayl.replace('.webp', '-320.webp')}`)} 320w, ${yol(`/proof/${p.fayl}`)} 960w`}
              sizes="(max-width: 760px) calc((100vw - 98px) / 3), 152px"
              width="960" height="540" loading="lazy" decoding="async"
              alt={`${p.nomi}: ${p.izoh}. Shaxsiy ma'lumotlar yopilgan preview.`} />
          </li>
        ))}
      </ul>
    </section>
    </div>


  </div>
  <SahifaOxiri
    manbalar={['EY01', 'TB01', 'SH01']}
    tekshirilgan="2026-11-05"
    keyingiTekshiruv="2026-12-05"
    tekshirilmagan={tekshirilmagan}
  />
</BolimQobiq>

<script>
  // Mening yo'lim: Topshirish yo'li javoblari, faqat o'qiladi (spetsifikatsiya 3-band).
  const blok = document.querySelector<HTMLElement>('[data-mening-yolim]');
  const malumotEl = document.getElementById('ta-yol-malumot');
  const meningYolim = () => {
    if (!blok || !malumotEl) return;
    try {
      const M = JSON.parse(malumotEl.textContent || '{}') as { KALIT: string; nomlar: Record<string, Record<string, string>> };
      const s = JSON.parse(localStorage.getItem(M.KALIT) || 'null');
      const tanlov = s && typeof s === 'object'
        ? ['davlat', 'daraja', 'grant'].map((k) => M.nomlar[k]?.[s[k]]).filter(Boolean)
        : [];
      if (tanlov.length) {
        blok.querySelector('[data-tanlov]')!.textContent = tanlov.join(' · ');
        blok.querySelector<HTMLElement>('[data-holat="bosh"]')!.hidden = true;
        blok.querySelector<HTMLElement>('[data-holat="bor"]')!.hidden = false;
      }
    } catch { /* o'qib bo'lmadi: bo'sh holat qoladi */ }
  };
  meningYolim();
  // Vosita kartasidagi chiplar tanlovni o'zgartirsa (inline skript hodisasi)
  document.addEventListener('ta-yol-yangilandi', meningYolim);
</script>

<style>
  /* 2-qavat mini-DS: ranglar .adm doirasidan (adm.css), bu yerda faqat tuzilma. Uzun matn zich sirtda (.adm-karta). */
  .ta-sahifa { display: grid; gap: var(--space-12); padding-top: var(--space-4); padding-bottom: var(--space-10); }
  .qisman { max-width: 62ch; }
  .havola { color: var(--color-adm-accent-text); font-weight: var(--font-weight-bold); min-height: var(--size-touch-min); display: inline-flex; align-items: center; text-decoration: underline; text-decoration-thickness: var(--border-width-1); text-underline-offset: 0.2em; }

  /* Eng katta blok: Topshirish yo'li */
  .vosita-karta { padding: var(--space-8); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8); }
  .vosita-matn { flex: 1 1 380px; display: grid; gap: var(--space-4); }
  .savollar { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .savollar li { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .raqam {
    width: var(--size-icon-lg); height: var(--size-icon-lg); flex: none; border-radius: var(--radius-full);
    border: var(--border-width-1) solid var(--color-adm-line-strong); display: grid; place-items: center;
    font-size: var(--text-caption-size); font-weight: var(--font-weight-semibold); font-variant-numeric: tabular-nums;
  }
  .savol-nom { font-weight: var(--font-weight-bold); width: 64px; }
  .variantlar { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .variant { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); border: var(--border-width-1) solid var(--color-adm-line-strong); font-size: var(--text-small-size); font-weight: var(--font-weight-semibold); }
  /* JS bilan chiplar tugma (aria-pressed); tanlangani to'q sariq fill, qora matn. Skriptda yaratiladi: :global */
  .variantlar :global(button.variant) {
    display: inline-flex; align-items: center; gap: var(--space-1);
    min-height: var(--size-touch-min); padding: 0 var(--space-4);
    border-radius: var(--radius-full); border: var(--border-width-1) solid var(--color-adm-line-strong);
    background: transparent; color: var(--color-adm-text); font: inherit; font-size: var(--text-small-size); font-weight: var(--font-weight-semibold);
    cursor: pointer; transition: transform var(--duration-fast) var(--ease-state);
  }
  .variantlar :global(button.variant:active) { transform: var(--bosilish); }
  @media (hover: hover) and (pointer: fine) { .variantlar :global(button.variant:hover) { background: var(--color-adm-sunken); } }
  .variantlar :global(button.variant[aria-pressed='true']) { background: var(--color-adm-accent); border-color: var(--color-adm-accent); color: var(--color-adm-on-accent); }
  .variantlar :global(.variant-belgi) { display: none; }
  .variantlar :global(button.variant[aria-pressed='true'] .variant-belgi) { display: block; }
  .vosita-past { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding-top: var(--space-1); }

  /* Savol progressi (3D, bezak): pog'onalar krem/qora, javob berilgani to'q sariq */
  .sahna { flex: 1 1 300px; perspective: 900px; display: grid; place-items: center; gap: var(--space-2); min-height: 260px; }
