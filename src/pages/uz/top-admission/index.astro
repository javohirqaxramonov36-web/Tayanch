---
// 2-qavat · Top Admission · bo'lim kirishi.
// Dizayn: Claude Design "Tayanch Top Admission maketi", A artboard (Main, KirishTelefon):
// https://claude.ai/artifact/1zP2rnjMp46RgY9WpD84GF
// Pasport/viza detallari (muhr, chipta, MRZ): DESIGN.md.
// Muddatlar: deadline.ts (EY01, TB01). Stipendium Hungaricum: SH01. Muallif: muallif.ts (tasdiqlangan).
// Qolip: BolimQobiq (Top Admission yon paneli, maket "LiftSidebar"). Manbalar bloki sahifaning o'zida.
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import SahifaOxiri from '../../../components/SahifaOxiri.astro';
import Zina from '../../../components/Zina.astro';
import QavatFoto from '../../../components/QavatFoto.astro';
import { taChiptalar } from '../../../data/taChiptalar';
import { manbalar } from '../../../data/manbalar';
import { qabulXatlari } from '../../../data/muallif';
import { SAVOLLAR, KALIT } from '../../../data/topshirishYoli';
import { yol } from '../../../lib/yol';

const m = (id: string) => manbalar.find((x) => x.id === id)!;
const vosita = yol('/uz/top-admission/vosita/topshirish-yoli/');
const zinapoya = yol('/uz/top-admission/qollanma/ariza-zinapoyasi/');

// Muddat chiptalari va ularning .ics fayllari bitta manbadan (taChiptalar.ts).
const chiptalar = taChiptalar;

const tezOrada = [
  { kod: 'UZ → US', nomi: 'AQSH' },
  { kod: 'UZ → GB', nomi: 'Buyuk Britaniya' },
  { kod: 'UZ → AU', nomi: 'Avstraliya' },
  { kod: 'UZ → KR', nomi: 'Janubiy Koreya' },
];
// "Mening yo'lim": Topshirish yo'li javoblari (faqat o'qiladi). Variant nomlari skriptga JSON bilan beriladi.
const yolMalumot = {
  KALIT,
  nomlar: Object.fromEntries(
    Object.entries(SAVOLLAR).map(([k, s]) => [k, Object.fromEntries(s.variantlar.map((v) => [v.id, v.nomi]))]),
  ),
};
// Vosita savollari: variantlar vositaning o'zidan (SAVOLLAR), tanlov o'sha kalitga yoziladi (KALIT).
const savollar = (
  [
    { n: 1, k: 'davlat', nomi: 'Davlat' },
    { n: 2, k: 'daraja', nomi: 'Daraja' },
    { n: 3, k: 'grant', nomi: 'Grant' },
  ] as const
).map((s) => ({ ...s, variantlar: SAVOLLAR[s.k].variantlar }));
// Hero yo'l xaritasi: sahifadagi yo'nalish kodlari. "sahifa" = yo'nalish sahifasi bor (yaxlit chiziq), qolgani tez orada (uzuq).
const xaritaKodlar = [
  { kod: 'TR', sahifa: true },
  { kod: 'HU', sahifa: false },
  ...tezOrada.map((t) => ({ kod: t.kod.replace('UZ → ', ''), sahifa: false })),
].map((x, i, hammasi) => ({ ...x, y: 30 + i * (180 / (hammasi.length - 1)) }));
const tekshirilmagan = [
  "Türkiye Bursları 2027-yil e'loni (taqvimda yil yozilmagan)",
  "Stipendium Hungaricum 2027/28 e'loni va muddati (hali chiqmagan)",
  "El-yurt umidi muddatining vaqt mintaqasi (Toshkent deb olindi)",
  "Stipendium Hungaricum va boshqa yo'nalishlar sahifalari hali yozilmagan",
];
---
<BolimQobiq
  title="Top Admission"
  description="Chet el universitetiga ariza yo'lini rasmiy manbalar bilan ko'rsatadi. Natija kafolatlanmaydi."
  turi="bolim-kirishi"
  bolim="top-admission"
  holat="qoralama"
  tekshirilgan="2026-11-05"
  keyingiTekshiruv="2026-12-05"
  manbalar={['EY01', 'TB01', 'SH01']}
  tekshirilmagan={tekshirilmagan}
>
  <div class="ichki ta-sahifa">
    <QavatFoto bolim="top-admission" />

    <section class="kirish" aria-labelledby="ta-sarlavha">
      <div class="kirish-matn-blok">
      <p class="ustki-qator"><span class="yorliq">Qoralama</span> <span class="sust kichik">Bo'lim kirishi</span></p>
      <h1 id="ta-sarlavha">Top Admission</h1>
      <p class="kirish-matn">Chet el universitetiga ariza yo'lini rasmiy manbalar bilan ko'rsatamiz. Natija kafolatlanmaydi.</p>
      <p class="qisman sust kichik">Qavat qisman tayyor: Topshirish yo'li vositasi va Ariza zinapoyasi darsi ishlaydi, Türkiye Bursları yo'nalish sahifasi bor, qolgan yo'nalishlar tez orada.</p>
      </div>
      <svg class="yol-xarita" aria-hidden="true" viewBox="0 0 360 240" width="360" height="240" focusable="false">
        <defs>
          <pattern id="ta-xarita-tor" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M24 0H0V24" class="yx-tor" />
          </pattern>
        </defs>
        <rect class="yx-fon" x="1" y="1" width="358" height="238" rx="20" />
        <rect x="1" y="1" width="358" height="238" rx="20" fill="url(#ta-xarita-tor)" />
        {xaritaKodlar.map((x) => (
          <path class:list={['yx-yol', { 'yx-yol-tez': !x.sahifa }]} d={`M92 120 C 170 120, 190 ${x.y}, 262 ${x.y}`} />
        ))}
        <circle class="yx-uz" cx="66" cy="120" r="28" />
        <text class="yx-uz-matn" x="66" y="125" text-anchor="middle">UZ</text>
        {xaritaKodlar.map((x) => (
          <g>
            <rect class:list={['yx-kod', { 'yx-kod-tez': !x.sahifa }]} x="264" y={x.y - 14} width="56" height="28" rx="14" />
            <text class="yx-kod-matn" x="292" y={x.y + 5} text-anchor="middle">{x.kod}</text>
          </g>
        ))}
      </svg>
    </section>

    <section class="vosita-karta" aria-labelledby="vosita-sarlavha">
      <div class="vosita-matn">
        <p class="ustki">Vosita · 3 savol</p>
        <h2 id="vosita-sarlavha">Topshirish yo'li</h2>
        <p class="ikkinchi">Qaysi davlat, qaysi daraja, grant kerakmi. Javoblaringizga mos ariza yo'llari va ularning rasmiy manbalari chiqadi.</p>
        <ol class="savollar" data-kalit={KALIT}>
          {savollar.map((s) => (
            <li data-savol={s.k}>
              <span class="raqam" aria-hidden="true">{s.n}</span>
              <span class="savol-nom" id={`ta-savol-${s.k}`}>{s.nomi}</span>
              <span class="variantlar">{s.variantlar.map((v) => <span class="variant" data-v={v.id}>{v.nomi}</span>)}</span>
            </li>
          ))}
        </ol>
        <div class="vosita-past">
          <a class="tugma tugma-asosiy katta-tugma" href={vosita}>
            Yo'limni topish
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </a>
          <span class="sust kichik">Qabul ehtimoli hisoblanmaydi</span>
          <a class="havola" href={zinapoya}>Ariza zinapoyasi: interaktiv dars</a>
        </div>
      </div>
      <div class="sahna" aria-hidden="true">
        <div class="savol-zinasi">
          <div class="pog p1" data-q="davlat"><div class="old"></div><div class="yon"></div><div class="ust"><span>Davlat</span></div></div>
          <div class="pog p2" data-q="daraja"><div class="old"></div><div class="yon"></div><div class="ust"><span>Daraja</span></div></div>
          <div class="pog p3" data-q="grant"><div class="old"></div><div class="yon"></div><div class="ust"><span>Grant</span></div></div>
        </div>
        <p class="sahna-izoh">Savol progressi</p>
      </div>
    </section>
    <script is:inline>
      // Vosita kartasidagi chiplar: JS bo'lsa tugmaga aylanadi (aria-pressed). Tanlov Topshirish yo'li kalitiga yoziladi
      // (vosita bilan bir format: {davlat, daraja, grant} variant id'lari), "Mening yo'lim" va 3D zinapoya yangilanadi.
      // JS bo'lmasa: statik yozuvlar. localStorage ishlamasa: tanlov ko'rinadi, saqlanmaydi.
      (() => {
        const karta = document.currentScript && document.currentScript.previousElementSibling;
        const ol = karta && karta.querySelector('.savollar');
        if (!ol) return;
        const kalit = ol.dataset.kalit;
        let javob = {};
        try { const s = JSON.parse(localStorage.getItem(kalit) || 'null'); if (s && typeof s === 'object') javob = s; } catch (e) { /* o'qib bo'lmadi */ }
        const belgi = '<svg class="variant-belgi" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>';
        const chiz = () => {
          ol.querySelectorAll('button.variant').forEach((b) => b.setAttribute('aria-pressed', String(javob[b.dataset.k] === b.dataset.v)));
          karta.querySelectorAll('.pog[data-q]').forEach((p) => p.classList.toggle('bajarildi', !!ol.querySelector(`button.variant[data-k="${p.dataset.q}"][aria-pressed="true"]`)));
        };
        ol.querySelectorAll('li[data-savol]').forEach((li) => {
          const k = li.dataset.savol;
          const guruh = li.querySelector('.variantlar');
          guruh.setAttribute('role', 'group');
          guruh.setAttribute('aria-labelledby', `ta-savol-${k}`);
          guruh.querySelectorAll('span.variant').forEach((sp) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'variant';
            b.dataset.k = k;
            b.dataset.v = sp.dataset.v;
            b.innerHTML = belgi;
            b.append(sp.textContent);
            b.addEventListener('click', () => {
              javob = { ...javob, [k]: b.dataset.v };
              try { localStorage.setItem(kalit, JSON.stringify(javob)); } catch (e) { /* saqlanmadi */ }
              chiz();
              document.dispatchEvent(new CustomEvent('ta-yol-yangilandi'));
            });
            sp.replaceWith(b);
          });
        });
        chiz();
      })();
    </script>

    <section class="blok" aria-labelledby="muddat-sarlavha">
      <div class="blok-bosh">
        <h2 id="muddat-sarlavha">Yaqin muddatlar</h2>
        <a class="havola" href={yol('/uz/deadline/')}>Barcha muddatlar</a>
      </div>
      <div class="chiptalar">
        {chiptalar.map((c) => (
          <article class="chipta" data-yopilish={c.yopilish} data-ochilish={c.ochilish}>
            <span class="teshik teshik-tepa" aria-hidden="true"></span>
            <span class="teshik teshik-past" aria-hidden="true"></span>
            <div class="chipta-asosiy">
              <div class="chipta-matn">
                <p class="ustki">{c.ustki}</p>
                <p class="chipta-sana">{c.katta}</p>
                <p class="chipta-qator">{c.matn}</p>
                {c.izoh && <p class="ikkinchi kichik">{c.izoh}</p>}
                <p class="sust kichik chipta-manba">Manba: <a href={c.manba.havola} rel="noopener">{c.manba.tashkilot}</a></p>
                <a class="havola kalendar" href={yol(`/uz/top-admission/kalendar/${c.id}.ics`)} download={`${c.id}.ics`} aria-label={`Kalendarga qo'shish: ${c.ustki}, oxirgi kun ${c.korishokKatta}`}>
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18M12 14v4M10 16h4" /></svg>
                  Kalendarga qo'shish
                </a>
              </div>
              <span class="muhr" role="img" aria-label={`Rasmiy manbada tekshirilgan, ${c.manba.tekshirilganSana}`}>
                <b>TEKSHIRILGAN</b><span>{c.manba.tekshirilganSana}</span>
              </span>
            </div>
            <div class="korishok">
              <span class="korishok-katta">{c.korishokKatta}</span>
              <span class="korishok-matn">{c.korishokMatn}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="blok" aria-labelledby="yonalish-sarlavha">
      <h2 id="yonalish-sarlavha">Yo'nalishlar</h2>
      <div class="yonalishlar">
        <article class="yonalish yonalish-katta">
          <div class="yonalish-matn">
            <p class="yorliqlar"><span class="yorliq yorliq-kok">Rasmiy taqvim bor</span> <span class="yorliq">UZ → TR</span></p>
            <h3>Türkiye Bursları</h3>
            <p class="ikkinchi">Turkiya hukumatining xalqaro talabalar uchun stipendiya dasturi. Umumiy ariza har yili 10-yanvar – 20-fevral.</p>
            <p class="yonalish-past"><a class="havola" href={yol('/uz/top-admission/turkiye-burslari/')}>Yo'nalish sahifasi</a> <a class="havola" href={vosita}>Topshirish yo'lida ko'rish</a></p>
          </div>
          <span class="muhr" role="img" aria-label={`Rasmiy manbada tekshirilgan, ${m('TB01').tekshirilganSana}`}>
            <b>TEKSHIRILGAN</b><span>{m('TB01').tekshirilganSana}</span>
          </span>
        </article>
        <article class="yonalish">
          <p class="yorliqlar"><span class="yorliq">tez orada</span> <span class="yorliq">UZ → HU</span></p>
          <h3>Stipendium Hungaricum</h3>
          <p class="fakt">
            <span class="muhr muhr-kichik" role="img" aria-label={`Rasmiy manbada tekshirilgan, ${m('SH01').tekshirilganSana}`}>
              <b>TEKSHIRILGAN</b><span>{m('SH01').tekshirilganSana}</span>
            </span>
            <span>O'zbekiston hamkor davlatlar ro'yxatida</span>
          </p>
          <span class="yorliq yorliq-ogoh">2027/28 e'loni hali chiqmagan</span>
        </article>
      </div>
      <div class="tez-orada">
        <ul class="tez-royxat">
          {tezOrada.map((t) => (
            <li><span class="tez-kod">{t.kod}</span> <span class="tez-nom">{t.nomi}</span></li>
          ))}
        </ul>
        <span class="yorliq">tez orada</span>
      </div>
    </section>

    <div class="yol-qator">
    <section class="mening-yolim" id="mening-yolim" aria-labelledby="mening-sarlavha" data-mening-yolim>
      <h2 id="mening-sarlavha" class="ustki">Mening yo'lim</h2>
      <div data-holat="bosh">
        <p class="mening-asosiy">Hali yo'l tanlanmagan</p>
        <p class="ikkinchi kichik">Topshirish yo'lida javob bersangiz, tanlovingiz shu yerda turadi. Faqat shu brauzerda.</p>
        <a class="havola" href={vosita}>3 savolga javob berish</a>
      </div>
      <div data-holat="bor" hidden>
        <p class="mening-asosiy" data-tanlov></p>
        <p class="ikkinchi kichik">Faqat shu brauzerda saqlangan. Qabul ehtimoli hisoblanmaydi.</p>
        <a class="havola" href={vosita}>Yo'limni ochish</a>
      </div>
    </section>
    <script type="application/json" id="ta-yol-malumot" set:html={JSON.stringify(yolMalumot)} />

    <section class="ishonch" aria-labelledby="ishonch-sarlavha">
      <div class="ishonch-bosh">
        <h2 id="ishonch-sarlavha" class="ustki">Muallif yo'li</h2>
        <a class="havola" href={yol('/uz/') + '#muallif-sarlavha'}>To'liq hikoya</a>
      </div>
      <p class="ishonch-son">{qabulXatlari.soni} ta qabul xati</p>
      <p class="ikkinchi kichik">Hujjat bilan tasdiqlangan. Previewlarda shaxsiy ma'lumotlar yopilgan, original hujjat emas.</p>
      <ul class="previewlar">
        {qabulXatlari.previewlar.map((p) => (
          <li>
            <img src={yol(`/proof/${p.fayl}`)} width="960" height="540" loading="lazy" decoding="async"
              alt={`${p.nomi}: ${p.izoh}. Shaxsiy ma'lumotlar yopilgan preview.`} />
          </li>
        ))}
      </ul>
    </section>
    </div>

    <Zina />

    <div class="mrz" aria-hidden="true">
      <p>TAYANCH&lt;&lt;TOP&lt;ADMISSION&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</p>
      <p>TAYANCH&lt;&lt;TOP&lt;ADMISSION&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</p>
    </div>
  </div>
  <SahifaOxiri
    manbalar={['EY01', 'TB01', 'SH01']}
    tekshirilgan="2026-11-05"
    keyingiTekshiruv="2026-12-05"
    tekshirilmagan={tekshirilmagan}
  />
</BolimQobiq>

<script>
  import { toshkentBugun, kunFarqi } from '../../../lib/muddat';
  // 1) Chiptadagi qolgan kun: bugungi sana Toshkent bo'yicha. JS bo'lmasa sana va "oxirgi kun" qoladi.
  const bugun = toshkentBugun();
  document.querySelectorAll<HTMLElement>('.chipta[data-yopilish]').forEach((ch) => {
    const katta = ch.querySelector('.korishok-katta');
    const matn = ch.querySelector('.korishok-matn');
    const korishok = ch.querySelector('.korishok');
    if (!katta || !matn || !korishok) return;
    const { yopilish = '', ochilish } = ch.dataset;
    if (ochilish && bugun < ochilish) {
      katta.textContent = String(kunFarqi(bugun, ochilish));
      matn.textContent = 'kun ochilishiga';
    } else if (bugun <= yopilish) {
      const n = kunFarqi(bugun, yopilish);
      katta.textContent = n === 0 ? 'Bugun' : String(n);
      matn.textContent = n === 0 ? 'oxirgi kun' : 'kun qoldi';
    } else {
      katta.textContent = "O'tgan";
      matn.textContent = 'muddat tugagan';
      korishok.classList.add('otgan');
    }
    korishok.classList.add('son');
  });

  // 2) Mening yo'lim: Topshirish yo'li javoblari, faqat o'qiladi (spetsifikatsiya 3-band).
  const blok = document.querySelector<HTMLElement>('[data-mening-yolim]');
  const malumotEl = document.getElementById('ta-yol-malumot');
  const meningYolim = () => {
    if (!blok || !malumotEl) return;
    try {
      const M = JSON.parse(malumotEl.textContent || '{}') as { KALIT: string; nomlar: Record<string, Record<string, string>> };
      const s = JSON.parse(localStorage.getItem(M.KALIT) || 'null');
      const tanlov = s && typeof s === 'object'
        ? ['davlat', 'daraja', 'grant'].map((k) => M.nomlar[k]?.[s[k]]).filter(Boolean)
        : [];
      if (tanlov.length) {
        blok.querySelector('[data-tanlov]')!.textContent = tanlov.join(' · ');
        blok.querySelector<HTMLElement>('[data-holat="bosh"]')!.hidden = true;
        blok.querySelector<HTMLElement>('[data-holat="bor"]')!.hidden = false;
      }
    } catch { /* o'qib bo'lmadi: bo'sh holat qoladi */ }
  };
  meningYolim();
  // Vosita kartasidagi chiplar tanlovni o'zgartirsa (inline skript hodisasi)
  document.addEventListener('ta-yol-yangilandi', meningYolim);
</script>

<style>
  .ta-sahifa { display: grid; gap: var(--b-14); padding-bottom: var(--b-10); }
  h1 { font-size: var(--matn-h1); font-weight: 800; line-height: 1.12; letter-spacing: var(--oraliq-sarlavha); }
  h2 { font-size: var(--matn-h2); font-weight: 800; line-height: 1.2; }
  .ustki { font-size: var(--matn-mayda); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--matn-sust); }
  .havola { color: var(--rang-havola); font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; }
  a:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: 2px; }

  .kirish { display: flex; align-items: center; justify-content: space-between; gap: var(--b-8); }
  .kirish-matn-blok { flex: 1 1 0; min-width: 0; display: grid; gap: var(--b-4); }
  /* Hero yo'l xaritasi (bezak, aria-hidden): UZ dan sahifadagi yo'nalish kodlariga; yaxlit = sahifasi bor, uzuq = tez orada */
  .yol-xarita { flex: 0 1 360px; width: 100%; max-width: 360px; height: auto; }
  .yx-fon { fill: var(--color-surface-sunken); stroke: var(--color-border); stroke-width: 1; }
  .yx-tor { fill: none; stroke: var(--color-border); stroke-width: 1; }
  .yx-yol { fill: none; stroke: var(--floor-ui); stroke-width: 2; stroke-linecap: round; }
  .yx-yol-tez { stroke-dasharray: 2 6; }
  .yx-uz { fill: var(--floor-ui); }
  .yx-uz-matn { fill: var(--floor-ui-text); font-size: var(--text-small-size); font-weight: 800; letter-spacing: .04em; }
  .yx-kod { fill: var(--color-surface); stroke: var(--floor-ui); stroke-width: 2; }
  .yx-kod-tez { stroke: var(--color-border-strong); stroke-dasharray: 3 3; }
  .yx-kod-matn { fill: var(--color-text-primary); font-size: var(--text-caption-size); font-weight: 800; letter-spacing: .06em; }
  .ustki-qator { display: flex; align-items: center; gap: var(--b-3); }
  .kirish-matn { font-size: var(--matn-katta); color: var(--matn-ikkinchi); max-width: 62ch; }
  .qisman { max-width: 62ch; }

  /* Eng katta blok: Topshirish yo'li. Sahifadagi yagona soya. */
  .vosita-karta {
    border: 1.5px solid var(--matn); border-radius: var(--r-katta); box-shadow: var(--soya);
    padding: var(--b-8); display: flex; flex-wrap: wrap; align-items: center; gap: var(--b-8);
  }
  .vosita-matn { flex: 1 1 380px; display: grid; gap: var(--b-4); }
  .savollar { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--b-3); }
