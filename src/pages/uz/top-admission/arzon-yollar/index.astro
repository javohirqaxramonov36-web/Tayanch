---
// 2-qavat mini-DS (ADR 005, PR 7): adm.css (.adm doira, eyebrow, Onest 800 sarlavha; uzun matn zich sirtda).
// 2-qavat · Top Admission · qo'llanma: Arzonroq o'qish yo'llari (Admission G).
// Ma'lumot: src/data/topAdmission/arzonYollar.json (Codex tadqiqot to'plami, `npm run malumot:tadqiqot`), faktlar "muallif" holatida.
// Statik sahifa, JS yo'q. Har yo'l: davlat, qisqacha, shartlar, rasmiy manba va tekshirilgan sana (Fakt.astro).
import { getCollection } from 'astro:content';
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import Fakt from '../../../../components/topAdmission/Fakt.astro';
import type { Fakt as FaktT } from '../../../../lib/topAdmission/fakt';
import yollarJson from '../../../../data/topAdmission/arzonYollar.json';
import { yol } from '../../../../lib/yol';
import '../../../../styles/adm.css';

interface Yol { id: string; davlat: string; nom: string; qisqacha: FaktT; shartlar: FaktT }
const yollar = yollarJson as unknown as Yol[];
const davlatNomlari = new Map((await getCollection('davlatlar')).map((e) => [e.id, e.data.nom_uz]));
const sana = yollar[0]?.qisqacha.tekshirilgan_sana ?? '';
const grantlar = yol('/uz/top-admission/grantlar/');
const davlatlar = yol('/uz/top-admission/davlatlar/');
---
<BolimQobiq
  title="Arzonroq o'qish yo'llari · Top Admission"
  description="Kontrakt siyosatini solishtirish: Germaniya, Avstriya, Fransiya, Italiya, Chexiya va Norvegiyada davlat OTMlari xarajati. Rasmiy manba va sana bilan."
  turi="qollanma"
  bolim="top-admission"
  holat="chop-etilgan"
  tekshirilgan={sana}
  yol={["Qo'llanmalar"]}
>
  <div class="ichki ay-sahifa">
    <header class="ay-bosh">
      <p class="adm-eyebrow">Qo'llanma</p>
      <h1 class="adm-h1">Arzonroq o'qish yo'llari</h1>
      <p class="matn">Grant olmasangiz ham, ba'zi davlatlarda davlat universitetlari kontrakti past yoki umuman yo'q. Bu yo'llar grant emas: yashash xarajati, yig'imlar va dastur tili alohida tekshiriladi.</p>
      <p class="matn sust">Har yo'l yonida rasmiy manba va tekshirilgan sana. Topshirishdan oldin universitetning aynan shu yildagi kontrakt qarorini tekshiring.</p>
    </header>

    <ul class="kartalar" aria-label="Arzonroq yo'llar">
      {yollar.map((y) => (
        <li class="karta">
          <p class="ustki">{davlatNomlari.get(y.davlat) ?? y.davlat}</p>
          <h2 class="nom">{y.nom}</h2>
          <dl class="maydonlar">
            <div>
              <dt>Qisqacha</dt>
              <dd><Fakt fakt={y.qisqacha} /></dd>
            </div>
            <div>
              <dt>Nimani tekshirish kerak</dt>
              <dd><Fakt fakt={y.shartlar} /></dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>

    <p class="matn">To'liq qoplaydigan yordamni <a class="havola-matn" href={grantlar}>Grantlar katalogida</a>, xavfsizlik va narxni <a class="havola-matn" href={davlatlar}>Davlatlarni taqqoslash</a> sahifasida ko'ring.</p>
  </div>
</BolimQobiq>

<style>
  .ay-sahifa { display: grid; gap: var(--b-8); padding-bottom: var(--b-6); }
  .ay-bosh { display: grid; gap: var(--b-3); }
  .ustki { margin: 0; font-size: var(--text-adm-eyebrow-size); line-height: var(--text-adm-eyebrow-lh); font-weight: var(--font-weight-semibold); letter-spacing: var(--text-adm-eyebrow-ls); text-transform: uppercase; color: var(--color-adm-text-muted); }
  .matn { max-width: 62ch; margin: 0; }
  .sust { color: var(--matn-ikkinchi); }
  .kartalar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--b-4); }
  .karta {
    display: flex; flex-direction: column; gap: var(--b-2); min-width: 0;
    padding: var(--b-5); border: var(--border-width-1) solid var(--color-adm-glass-border); border-radius: var(--radius-xl); background: var(--color-adm-glass-strong); box-shadow: var(--shadow-glass);
  }
  .nom { margin: 0; }
  .maydonlar { margin: 0; display: grid; gap: var(--b-3); }
  .maydonlar > div { display: grid; gap: var(--b-1); padding-top: var(--b-3); border-top: 1px solid var(--chiziq); }
  .maydonlar dt { font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); }
  .maydonlar dd { margin: 0; min-width: 0; }
  .havola-matn { color: var(--rang-havola); font-weight: 700; }
  @media (max-width: 760px) { .kartalar { grid-template-columns: 1fr; } }
</style>
