---
// 1-qavat · Hisob · Hisobim (profil). Himoyalangan sahifa: HisobQorovul.
// Ma'lumot public.profiles jadvalida (P12; migratsiya supabase/migrations/20261108000002_profiles.sql, RLS: faqat o'z qatori).
// Qatorni auth.users triggeri ochadi, sahifa faqat o'qiydi va yangilaydi (INSERT huquqi yo'q).
// SAT maqsad ball oralig'i 400–1600: CB04 (College Board, SAT Suite Score Structure); bazada ham shu check.
import HisobKarta from '../../../../components/hisob/HisobKarta.astro';
import HisobQorovul from '../../../../components/hisob/HisobQorovul.astro';
import Maydon from '../../../../components/hisob/Maydon.astro';
import ParolMaydon from '../../../../components/hisob/ParolMaydon.astro';
import { hisobSahifalar } from '../../../../data/hisobSahifalar';
import { satBall } from '../../../../data/hisobSozlama';
import { yol } from '../../../../lib/yol';
---
<HisobKarta sahifa={hisobSahifalar.profil}>
  <HisobQorovul>
    <div class="profil">
      <section class="hisob-karta" aria-labelledby="hisob-malumot">
        <h2 id="hisob-malumot">Hisob</h2>
        <p>Siz <strong id="profil-email"></strong> bilan kirgansiz.</p>
        <p class="hisob-sust">SAT savol banki va mashq sessiyalaridagi javoblaringiz hisobingizda saqlanadi. Dars natijalari hozircha faqat shu brauzerda.</p>
      </section>

      <section class="hisob-karta" aria-labelledby="profil-sarlavha">
        <h2 id="profil-sarlavha">Ma'lumotlaringiz</h2>
        <form class="hisob-forma" id="profil-forma" novalidate aria-labelledby="profil-sarlavha">
          <p class="hisob-alert" id="profil-xato" role="alert" hidden></p>
          <p class="hisob-holat" id="profil-holat" role="status" hidden></p>
          <Maydon id="profil-ism" nomi="Ism" autocomplete="name" maxlength={60} izoh="Saytda sizga shu ism bilan murojaat qilamiz." />
          <Maydon id="profil-taxallus" nomi="Taxallus" autocomplete="nickname" maxlength={20} ixtiyoriy izoh="Reytinglarda ko'rinadi. 3 dan 20 tagacha lotin harfi, raqam yoki pastki chiziq (_)." />
          <Maydon id="profil-ball" nomi="SAT maqsad ball" turi="number" autocomplete="off" min={satBall.min} max={satBall.max} step={10} ixtiyoriy izoh={`${satBall.min} dan ${satBall.max} gacha, 10 lik qadam bilan (SAT umumiy ball oralig'i).`} />
          <Maydon id="profil-joriy" nomi="SAT: hozirgi eng yaxshi ball" turi="number" autocomplete="off" min={satBall.min} max={satBall.max} step={10} ixtiyoriy izoh="Rasmiy SAT yoki to'liq mashq testidan. Hali bo'lmasa, bo'sh qoldiring." />
          <Maydon id="profil-sana" nomi="Imtihon sanasi" turi="date" autocomplete="off" ixtiyoriy izoh="Qaysi kuni imtihon topshirmoqchisiz." />
          <p class="hisob-ogoh" id="profil-sana-otgan" hidden></p>
          <button type="submit" class="tugma tugma-asosiy" id="profil-tugma">Saqlash</button>
        </form>
      </section>

      <section class="hisob-karta" aria-labelledby="chiqish-sarlavha">
        <h2 id="chiqish-sarlavha">Hisobdan chiqish</h2>
        <p class="hisob-sust">Shu qurilmada hisobdan chiqasiz. Brauzerda saqlangan natijalar shu yerda qoladi.</p>
        <button type="button" class="tugma tugma-ikkinchi" id="chiqish-tugma">Chiqish</button>
      </section>

      <section class="hisob-karta" aria-labelledby="eksport-sarlavha">
        <h2 id="eksport-sarlavha">Ma'lumotlaringiz nusxasi</h2>
        <p class="hisob-sust">Serverdagi hamma ma'lumotingiz (hisob, profil, savol-javob tarixi, obuna va to'lovlar) va shu brauzerdagi Tayanch yozuvlari bitta JSON faylga yuklanadi. Sessiya kaliti faylga kirmaydi.</p>
        <p class="hisob-alert" id="eksport-xato" role="alert" hidden></p>
        <p class="hisob-holat" id="eksport-holat" role="status" hidden></p>
        <button type="button" class="tugma tugma-ikkinchi" id="eksport-tugma">Ma'lumotlarimni yuklab olish (JSON)</button>
      </section>

      <section class="hisob-karta" aria-labelledby="ochirish-sarlavha">
        <h2 id="ochirish-sarlavha">Hisobni o'chirish</h2>
        <p class="hisob-sust">Hisobingiz, profil, savol-javob tarixi va obunangiz serverdan butunlay o'chiriladi. Faol obuna ham tugaydi: pulni qaytarishni xohlasangiz, avval <a href={yol('/uz/qaytarish/')}>Qaytarish siyosati</a>ni o'qing. To'lov yozuvlari hisobdan uzilgan holda saqlanadi (<a href={yol('/uz/maxfiylik/#ochirish')}>Maxfiylik siyosati</a>). Shu brauzerdagi natijalar qoladi.</p>
        <button type="button" class="tugma tugma-ikkinchi" id="ochirish-tugma" aria-expanded="false" aria-controls="ochirish-tasdiq">Hisobni o'chirish</button>
        <form class="ochirish-tasdiq hisob-forma" id="ochirish-tasdiq" novalidate aria-labelledby="ochirish-savol" hidden>
          <p id="ochirish-savol" tabindex="-1"><strong>Rostdan ham o'chirasizmi?</strong> Buni qaytarib bo'lmaydi.</p>
          <p class="hisob-alert" id="ochirish-xato" role="alert" hidden></p>
          <div id="ochirish-parol-qadam" hidden>
            <ParolMaydon id="ochirish-parol" nomi="Parolingiz" autocomplete="current-password" izoh="Shaxsingizni tasdiqlash uchun." />
          </div>
          <div class="ochirish-google" id="ochirish-google-qadam" hidden>
            <p class="hisob-sust">Shaxsingizni tasdiqlash uchun Google orqali qayta kiring. Keyin shu sahifaga qaytasiz.</p>
            <button type="button" class="tugma tugma-ikkinchi" id="ochirish-google">Google orqali qayta kirish</button>
          </div>
          <Maydon id="ochirish-email" nomi="Tasdiqlash uchun emailingizni yozing" turi="email" autocomplete="off" izoh="Hisobingiz emaili, yuqorida ko'rsatilgandek." />
          <div class="ochirish-tugmalar">
            <button type="submit" class="tugma tugma-asosiy" id="ochirish-ha" disabled>Ha, hisobni o'chirish</button>
            <button type="button" class="tugma tugma-ikkinchi" id="ochirish-yoq">Bekor qilish</button>
          </div>
        </form>
      </section>
    </div>
  </HisobQorovul>
</HisobKarta>

<style>
  .profil { display: flex; flex-direction: column; gap: var(--b-5); }
  .profil strong { overflow-wrap: anywhere; }
  .ochirish-tasdiq { display: flex; flex-direction: column; gap: var(--b-3); }
  .ochirish-tasdiq[hidden] { display: none; }
  .ochirish-tasdiq p:focus { outline: none; }
  .ochirish-google { display: flex; flex-direction: column; gap: var(--b-3); }
  .ochirish-google[hidden] { display: none; }
  .ochirish-tugmalar { display: flex; flex-wrap: wrap; gap: var(--b-3); }
</style>

<script>
  import { hisobMijoz, hisobQorovul, hisobYoli, xatoMatni, maydonXatosi, yuklanish, xabar, googleBilanKirish, googleXatoMatni, googleXatoTuri } from '../../../../lib/hisob';
  import { funksiya, tokenKirishVaqti } from '../../../../lib/funksiya';
  import { eksportdanTashqari } from '../../../../data/brauzerKalitlari';
  import { hisobSozlama, satBall } from '../../../../data/hisobSozlama';
  import { ballXatosi as satBallXatosi, sanaXatosi, SANA_MAX_YIL, type BallXato } from '../../../../lib/satMaqsad';
  import { toshkentBugun, yilQosh } from '../../../../lib/muddat';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const ism = $<HTMLInputElement>('profil-ism');
  const taxallus = $<HTMLInputElement>('profil-taxallus');
  const ball = $<HTMLInputElement>('profil-ball');
  const joriy = $<HTMLInputElement>('profil-joriy');
  const sana = $<HTMLInputElement>('profil-sana');
  const otganEl = $('profil-sana-otgan');
  const bugun = toshkentBugun();
  let saqlanganSana = '';
  const tugma = $<HTMLButtonElement>('profil-tugma');
  const naqsh = new RegExp(`^${hisobSozlama.taxallusNaqsh}$`);
  const maydonlar = [ism, taxallus, ball, joriy, sana];
  let foydalanuvchiId = '';

  function formaYoq(yoq: boolean) {
    maydonlar.forEach((el) => (el.disabled = yoq));
    tugma.disabled = yoq;
  }

  formaYoq(true);
  hisobQorovul().then(async (sessiya) => {
    if (!sessiya) return;
    const u = sessiya.user;
    foydalanuvchiId = u.id;
    $('profil-email').textContent = u.email ?? '';
    const c = hisobMijoz();
    if (!c) return;
    const { data, error } = await c
      .from('profiles')
      .select('display_name, nickname, target_score, current_score, exam_date')
      .eq('id', u.id)
      .maybeSingle();
    if (error || !data) {
      return xabar($('profil-xato'), "Profil ma'lumotlarini yuklab bo'lmadi. Sahifani yangilab ko'ring.");
    }
    // display_name bo'sh bo'lsa, P12 dan oldingi user_metadata qiymati taklif qilinadi (saqlanganda jadvalga yoziladi).
    ism.value = String(data.display_name ?? u.user_metadata?.display_name ?? '');
    taxallus.value = String(data.nickname ?? u.user_metadata?.nickname ?? '');
    ball.value = data.target_score == null ? '' : String(data.target_score);
    joriy.value = data.current_score == null ? '' : String(data.current_score);
    sana.value = data.exam_date ?? '';
    saqlanganSana = sana.value;
    sanaEslatma();
    formaYoq(false);
  }).catch(() => undefined); // xatoni HisobQorovul ko'rsatadi

  // SAT ball: 400–1600, qadam 10 (src/lib/satMaqsad.ts, SAT sozlash sahifasi bilan bir xil qoida).
  const ballMatn: Record<BallXato, string> = {
    bosh: 'Ballni kiriting.',
    raqam: 'Faqat raqam kiriting, masalan 1400.',
    oraliq: `${satBall.min} dan ${satBall.max} gacha son kiriting.`,
    qadam: "SAT ball 10 lik qadam bilan boradi: eng yaqin 10 ga yaxlitlang, masalan 1450.",
  };
  function ballXatosi(el: HTMLInputElement): string | null {
    const x = el.validity.badInput ? 'raqam' : satBallXatosi(el.value);
    return x ? ballMatn[x] : null;
  }

  // Imtihon sanasi: yangi kiritilgan sana bugundan oldin yoki 2 yildan uzoq bo'lmaydi; saqlangan o'tgan sana haqida eslatma.
  sana.max = yilQosh(bugun, SANA_MAX_YIL);
  function sanaEslatma() {
    const otgan = !!sana.value && sana.value < bugun && sana.value === saqlanganSana;
    otganEl.textContent = otgan ? "Bu imtihon sanasi o'tib ketgan. Yangi sanani kiriting yoki maydonni bo'shating." : '';
    otganEl.hidden = !otgan;
    const tasvir = ['profil-sana-izoh', 'profil-sana-xato', otgan ? 'profil-sana-otgan' : ''].filter(Boolean).join(' ');
    sana.setAttribute('aria-describedby', tasvir);
  }
  function sanaXatoMatni(): string | null {
    if (sana.validity.badInput) return "Sanani to'liq kiriting.";
    if (!sana.value || sana.value === saqlanganSana) return null;
    const x = sanaXatosi(sana.value, bugun);
    if (x === 'otgan') return "Bu sana o'tib ketgan. Bugungi yoki keyingi sanani tanlang.";
    if (x === 'uzoq') return 'Keyingi ikki yil ichidagi sanani tanlang.';
    if (x) return "Sanani to'liq kiriting.";
    return null;
  }

  $<HTMLFormElement>('profil-forma').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    xabar($('profil-xato'), null);
    xabar($('profil-holat'), null);
    const i = ism.value.trim();
    const t = taxallus.value.trim();
    const b = ball.value.trim();
    const j = joriy.value.trim();
    const xatolar: [HTMLInputElement, string | null][] = [
      [ism, i ? null : 'Ismingizni kiriting.'],
      [taxallus, !t || naqsh.test(t) ? null : '3 dan 20 tagacha lotin harfi, raqam yoki pastki chiziq (_) ishlating.'],
      [ball, ballXatosi(ball)],
      [joriy, ballXatosi(joriy)],
      [sana, sanaXatoMatni()],
    ];
    xatolar.forEach(([el, m]) => maydonXatosi(el, m));
    const birinchi = xatolar.find(([, m]) => m)?.[0];
    if (birinchi) return birinchi.focus();
    const c = hisobMijoz();
    if (!c || !foydalanuvchiId) return;
    yuklanish(tugma, true, 'Saqlanmoqda…');
    const { data, error } = await c
      .from('profiles')
      .update({ display_name: i, nickname: t || null, target_score: b ? Number(b) : null, current_score: j ? Number(j) : null, exam_date: sana.value || null })
      .eq('id', foydalanuvchiId)
      .select('id');
    yuklanish(tugma, false);
    if (error?.code === '23505') {
      maydonXatosi(taxallus, "Bu taxallus band. Boshqasini tanlang.");
      return taxallus.focus();
    }
    // P32: server laqabni moderatsiya qiladi (private.nickname_allowed, profiles triggeri).
    if (error?.message === 'nickname_not_allowed') {
      maydonXatosi(taxallus, "Bu taxallusni ishlatib bo'lmaydi. Boshqasini tanlang.");
      return taxallus.focus();
    }
    if (error || !data?.length) return xabar($('profil-xato'), xatoMatni((error ?? new Error('profil')) as Error, 'profil'));
    saqlanganSana = sana.value;
    sanaEslatma();
    xabar($('profil-holat'), 'Saqlandi.');
  });
  sana.addEventListener('change', sanaEslatma);
  maydonlar.forEach((el) => el.addEventListener('input', () => maydonXatosi(el, null)));

  const chiqish = $<HTMLButtonElement>('chiqish-tugma');
  chiqish.addEventListener('click', async () => {
    const c = hisobMijoz();
    if (!c) return;
    yuklanish(chiqish, true, 'Chiqilmoqda…');
    // scope 'local': faqat shu qurilmadagi sessiya tugaydi. Server javob bermasa ham (tarmoq yo'q)
    // supabase-js mahalliy sessiyani o'chiradi (sinaldi), shuning uchun natijadan qat'i nazar chiqiladi.
    await c.auth.signOut({ scope: 'local' }).catch(() => undefined);
    try { localStorage.removeItem(hisobSozlama.sessiyaKaliti); } catch { /* xotira yopiq bo'lsa ham davom */ }
    location.assign(`${hisobYoli('kirish')}?chiqdi=1`);
  });

  // ---- Ma'lumot eksporti (P23): server (Edge Function hisob-malumot) + shu brauzerdagi Tayanch kalitlari ----
  // Sessiya kalitlari (tayanch:auth…) faylga yozilmaydi.
  function brauzerYozuvlari(xotira: Storage): Record<string, unknown> {
    const natija: Record<string, unknown> = {};
    try {
      for (let i = 0; i < xotira.length; i++) {
        const k = xotira.key(i);
        if (!k || !(k.startsWith('tayanch:') || k.startsWith('tayanch-')) || eksportdanTashqari(k)) continue;
        const v = xotira.getItem(k);
        try { natija[k] = v === null ? null : JSON.parse(v); } catch { natija[k] = v; }
      }
    } catch { /* xotira yopiq: bo'sh qoladi */ }
    return natija;
  }
  const eksport = $<HTMLButtonElement>('eksport-tugma');
  eksport.addEventListener('click', async () => {
    xabar($('eksport-xato'), null);
    xabar($('eksport-holat'), null);
    yuklanish(eksport, true, 'Tayyorlanmoqda…');
    const r = await funksiya<{ malumot: Record<string, unknown> }>('hisob-malumot', { amal: 'eksport' });
    yuklanish(eksport, false);
    if (!r.ok) {
      return xabar($('eksport-xato'), r.kod === 'network_error'
        ? "Serverga ulanib bo'lmadi. Internetni tekshirib, qayta urinib ko'ring."
        : "Ma'lumotni tayyorlab bo'lmadi. Birozdan keyin qayta urinib ko'ring.");
    }
    const fayl = { ...r.data.malumot, brauzer: { localStorage: brauzerYozuvlari(localStorage), sessionStorage: brauzerYozuvlari(sessionStorage) } };
    const nomi = `tayanch-malumotlarim-${toshkentBugun()}.json`;
    const url = URL.createObjectURL(new Blob([JSON.stringify(fayl, null, 2)], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = nomi;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    xabar($('eksport-holat'), `Fayl yuklandi: ${nomi}`);
  });

  // ---- Hisobni o'chirish (P23): tugma → tasdiq formasi → qayta autentifikatsiya → email bilan tasdiq → Edge Function ----
  // Email foydalanuvchi har safar parolini kiritadi. Faqat Google bilan kirgan foydalanuvchi oxirgi 9 daqiqada
  // kirmagan bo'lsa, Google orqali qayta kiradi (?ochirish=1 bilan shu sahifaga qaytadi). Server chegarasi 10 daqiqa.
  // Escape yoki "Bekor qilish" formani yopadi va fokusni tugmaga qaytaradi.
  const YANGI_KIRISH_SONIYA = 9 * 60;
  const ochirish = $<HTMLButtonElement>('ochirish-tugma');
  const tasdiq = $<HTMLFormElement>('ochirish-tasdiq');
  const ha = $<HTMLButtonElement>('ochirish-ha');
  const parol = $<HTMLInputElement>('ochirish-parol');
  const tasdiqEmail = $<HTMLInputElement>('ochirish-email');
  const parolQadam = $('ochirish-parol-qadam');
  const googleQadam = $('ochirish-google-qadam');
  const googleTugma = $<HTMLButtonElement>('ochirish-google');
  let joriyEmail = '';
  let emailBilan = false;
  let yangiKirish = false;

  const emailNorm = (x: string) => x.trim().toLowerCase();
  function haHolati() {
    const emailMos = !!joriyEmail && emailNorm(tasdiqEmail.value) === emailNorm(joriyEmail);
    ha.disabled = !(emailMos && (emailBilan ? parol.value.length > 0 : yangiKirish));
  }

  async function kirishHolati() {
    const c = hisobMijoz();
    const { data } = c ? await c.auth.getSession() : { data: { session: null } };
    const s = data.session;
    joriyEmail = s?.user.email ?? '';
    const usullar: string[] = (s?.user.identities ?? []).map((i) => i.provider);
    emailBilan = usullar.includes('email');
    const vaqt = tokenKirishVaqti(s?.access_token);
    yangiKirish = vaqt !== null && Date.now() / 1000 - vaqt <= YANGI_KIRISH_SONIYA;
    parolQadam.hidden = !emailBilan;
    googleQadam.hidden = emailBilan || yangiKirish;
    haHolati();
  }

  async function tasdiqni(ochiq: boolean) {
    if (ochiq) await kirishHolati();
    tasdiq.hidden = !ochiq;
    ochirish.setAttribute('aria-expanded', String(ochiq));
    xabar($('ochirish-xato'), null);
    if (!ochiq) {
      parol.value = '';
      tasdiqEmail.value = '';
      maydonXatosi(parol, null);
      maydonXatosi(tasdiqEmail, null);
    }
    if (ochiq) $('ochirish-savol').focus();
    else ochirish.focus();
  }
  ochirish.addEventListener('click', () => tasdiqni(ochirish.getAttribute('aria-expanded') !== 'true'));
  $<HTMLButtonElement>('ochirish-yoq').addEventListener('click', () => tasdiqni(false));
  tasdiq.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && ha.getAttribute('aria-busy') !== 'true') tasdiqni(false); });
  [parol, tasdiqEmail].forEach((el) => el.addEventListener('input', () => { maydonXatosi(el, null); haHolati(); }));

  googleTugma.addEventListener('click', async () => {
    yuklanish(googleTugma, true, 'Google ochilmoqda…');
    const e = await googleBilanKirish(`${hisobYoli('profil')}?ochirish=1`);
    if (e) {
      yuklanish(googleTugma, false);
      xabar($('ochirish-xato'), googleXatoMatni[googleXatoTuri(e)]);
    }
  });

  const ochirishXatoMatni: Record<string, string> = {
    reauth_required: "Shaxsingizni qayta tasdiqlang: parolingizni kiriting yoki Google orqali qayta kiring.",
    payment_in_progress: "Sizda tugallanmagan to'lov bor. Bir necha daqiqadan keyin qayta urinib ko'ring yoki Aloqa sahifasi orqali yozing.",
    network_error: "Serverga ulanib bo'lmadi. Internetni tekshirib, qayta urinib ko'ring.",
  };

  tasdiq.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    haHolati();
    if (ha.disabled) return;
    const c = hisobMijoz();
    if (!c) return;
    xabar($('ochirish-xato'), null);
    yuklanish(ha, true, "O'chirilmoqda…");
    if (emailBilan) {
      // Qayta autentifikatsiya: yangi sessiya JWT dagi amr vaqtini yangilaydi (server shuni tekshiradi).
      const { error } = await c.auth.signInWithPassword({ email: joriyEmail, password: parol.value });
      if (error) {
        yuklanish(ha, false);
        const m = xatoMatni(error, 'kirish');
        maydonXatosi(parol, m === "Email yoki parol noto'g'ri." ? "Parol noto'g'ri." : m);
        return parol.focus();
      }
    }
    const r = await funksiya<{ ok: true }>('hisob-malumot', { amal: 'ochirish', tasdiq: tasdiqEmail.value });
    if (!r.ok) {
      yuklanish(ha, false);
      if (r.kod === 'confirmation_mismatch') {
        maydonXatosi(tasdiqEmail, 'Email hisobingiz emailiga mos kelmadi.');
        return tasdiqEmail.focus();
      }
      if (r.kod === 'reauth_required') await kirishHolati();
      return xabar($('ochirish-xato'), ochirishXatoMatni[r.kod] ?? "Hisob o'chirilmadi. Qayta urinib ko'ring.");
    }
    await c.auth.signOut({ scope: 'local' }).catch(() => undefined);
    try { localStorage.removeItem(hisobSozlama.sessiyaKaliti); } catch { /* xotira yopiq bo'lsa ham davom */ }
    location.assign(`${hisobYoli('kirish')}?ochirildi=1`);
  });

  // Google'dan qaytganda (?ochirish=1) forma o'zi ochiladi; parametr manzildan olib tashlanadi.
  if (new URLSearchParams(location.search).get('ochirish') === '1') {
    history.replaceState(null, '', location.pathname + location.hash);
    hisobQorovul().then((s) => { if (s) tasdiqni(true); }).catch(() => undefined);
  }
</script>
