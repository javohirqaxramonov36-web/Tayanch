---
// 1-qavat · Hisob · Kirish. Bitta hisob butun sayt uchun. Email + parol; Google (P03B, GoogleTugma).
// Holatlar: hisob o'chirilgan (env yo'q) · kirmagan (forma) · kirgan (davom etish) ·
// xatdagi havoladan kelgan (email tasdiqlandi yoki havola eskirgan) · chiqqandan keyin (?chiqdi=1) · hisob o'chirilgandan keyin (?ochirildi=1).
// ?keyin=<sayt ichidagi yo'l>: kirgandan keyin qaysi qavatdan kelgan bo'lsa o'sha sahifaga qaytaradi.
import HisobKarta from '../../../../components/hisob/HisobKarta.astro';
import Maydon from '../../../../components/hisob/Maydon.astro';
import ParolMaydon from '../../../../components/hisob/ParolMaydon.astro';
import GoogleTugma from '../../../../components/hisob/GoogleTugma.astro';
import { hisobSahifalar } from '../../../../data/hisobSahifalar';
import { yol } from '../../../../lib/yol';
---
<HisobKarta sahifa={hisobSahifalar.kirish} lead="Hisob ixtiyoriy. Darslar va mashqlar hisobsiz ham ishlaydi.">
  <p class="hisob-holat" id="kirish-holat" role="status" hidden></p>
  <p class="hisob-alert" id="kirish-havola-xato" role="alert" hidden></p>

  <section class="hisob-karta" id="kirgan" aria-labelledby="kirgan-sarlavha" hidden>
    <h2 id="kirgan-sarlavha">Siz hisobingizdasiz</h2>
    <p class="hisob-sust" id="kirgan-email"></p>
    <div class="hisob-tugmalar">
      <a class="tugma tugma-asosiy" id="kirgan-davom" href={yol('/uz/hisob/profil/')}>Davom etish</a>
    </div>
  </section>

  <div class="hisob-karta" id="kirish-karta" data-hisob-bor>
    <form class="hisob-forma" id="kirish-forma" novalidate aria-labelledby="hisob-sarlavha">
      <p class="hisob-alert" id="kirish-xato" role="alert" hidden></p>
      <Maydon id="kirish-email" nomi="Email" turi="email" autocomplete="email" />
      <ParolMaydon id="kirish-parol" nomi="Parol" autocomplete="current-password" />
      <div class="hisob-qator">
        <a class="hisob-havola" href={yol('/uz/hisob/parol-tiklash/')}>Parolni unutdingizmi?</a>
      </div>
      <button type="submit" class="tugma tugma-asosiy" id="kirish-tugma">Kirish</button>
    </form>
    <p class="hisob-yoki" aria-hidden="true">yoki</p>
    <GoogleTugma />
  </div>

  <p class="hisob-past" data-hisob-bor>
    Hisobingiz yo'qmi? <a class="hisob-havola" id="royxat-havola" href={yol('/uz/hisob/royxat/')}>Ro'yxatdan o'ting</a>
  </p>
</HisobKarta>

<script>
  import type { Session, SupabaseClient } from '@supabase/supabase-js';
  import {
    hisobMijoz, hisobYoqBolsa, havolaHolati, havolaXatoMatni, keyingiManzil, rozilikHolati, rozilikYoli,
    xatoMatni, maydonXatosi, yuklanish, xabar, emailTogrimi,
  } from '../../../../lib/hisob';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const forma = $<HTMLFormElement>('kirish-forma');
  const email = $<HTMLInputElement>('kirish-email');
  const parol = $<HTMLInputElement>('kirish-parol');
  const tugma = $<HTMLButtonElement>('kirish-tugma');
  const xato = $('kirish-xato');
  const holat = $('kirish-holat');
  const keyin = keyingiManzil();

  // ?keyin= ro'yxat havolasiga ham uzatiladi: tasdiqlash xatidan keyin foydalanuvchi o'sha sahifaga qaytadi.
  const qidiruv = new URLSearchParams(location.search);
  if (qidiruv.get('keyin')) $<HTMLAnchorElement>('royxat-havola').search = `?keyin=${encodeURIComponent(keyin)}`;
  if (qidiruv.get('chiqdi') === '1') xabar(holat, 'Hisobdan chiqdingiz.');
  if (qidiruv.get('ochirildi') === '1') xabar(holat, "Hisobingiz o'chirildi.");

  // Kirgandan keyin: rozilik yozilgan bo'lsa keyin'ga, bo'lmasa rozilik sahifasiga.
  // O'qib bo'lmasa keyin'ga (himoyalangan sahifa qorovuli baribir tekshiradi).
  async function davomManzili(c: SupabaseClient, s: Session): Promise<string> {
    try {
      return (await rozilikHolati(c, s)) === 'bor' ? keyin : rozilikYoli(keyin);
    } catch {
      return keyin;
    }
  }

  function kirganniKorsat(emailMatn: string) {
    $('kirish-karta').hidden = true;
    document.querySelectorAll<HTMLElement>('[data-hisob-bor]').forEach((el) => (el.hidden = true));
    $('kirgan-email').textContent = `Siz ${emailMatn} hisobi bilan kirgansiz.`;
    $<HTMLAnchorElement>('kirgan-davom').href = keyin;
    $('kirgan').hidden = false;
  }

  async function boshla() {
    if (hisobYoqBolsa()) return;
    const c = hisobMijoz()!;
    const { data } = await c.auth.getSession();
    if (havolaHolati.xato) {
      xabar($('kirish-havola-xato'), havolaXatoMatni);
    } else if (data.session && havolaHolati.tur === 'signup') {
      xabar(holat, "Emailingiz tasdiqlandi. Tayanch'ga xush kelibsiz.");
    }
    if (data.session) {
      kirganniKorsat(data.session.user.email ?? '');
      $<HTMLAnchorElement>('kirgan-davom').href = await davomManzili(c, data.session);
    }
  }

  function tekshir(): boolean {
    let birinchi: HTMLInputElement | null = null;
    const e = email.value.trim();
    const eXato = !e ? 'Emailingizni kiriting.' : !emailTogrimi(e) ? "Email shu ko'rinishda bo'lsin: ism@example.com." : null;
    maydonXatosi(email, eXato);
    if (eXato) birinchi = email;
    const pXato = parol.value ? null : 'Parolingizni kiriting.';
    maydonXatosi(parol, pXato);
    if (pXato && !birinchi) birinchi = parol;
    birinchi?.focus();
    return !birinchi;
  }

  forma.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    xabar(xato, null);
    xabar(holat, null);
    if (!tekshir()) return;
    const c = hisobMijoz();
    if (!c) return;
    yuklanish(tugma, true, 'Kirilmoqda…');
    try {
      const { data, error } = await c.auth.signInWithPassword({ email: email.value.trim(), password: parol.value });
      if (error) throw error;
      parol.value = '';
      xabar(holat, 'Kirdingiz. Oldingi sahifaga qaytilmoqda…');
      location.assign(await davomManzili(c, data.session));
      return;
    } catch (e) {
      xabar(xato, xatoMatni(e as Error, 'kirish'));
      parol.value = '';
      parol.focus();
    }
    yuklanish(tugma, false);
  });

  // Har maydon tahrir qilinganda o'sha maydon xatosi tozalanadi.
  [email, parol].forEach((i) => i.addEventListener('input', () => maydonXatosi(i, null)));
  boshla();
</script>
