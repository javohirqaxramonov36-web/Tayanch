---
// 1-qavat · Brauzerda saqlash va cookie (P23 davomi, 2026-11-11). QORALAMA.
// Kalitlar ro'yxati: src/data/brauzerKalitlari.ts (inglizcha nusxa bilan umumiy). Yangi kalit qo'shilsa shu yerga ham yoziladi.
// Tekshiruv (2026-11-11): src ichida document.cookie yo'q; sessiya Supabase tomonidan localStorage'ga yoziladi (tayanch:auth).
import Asosiy from '../../../layouts/Asosiy.astro';
import HuquqiyMatn from '../../../components/huquqiy/HuquqiyMatn.astro';
import { brauzerKalitlari } from '../../../data/brauzerKalitlari';
import { yol } from '../../../lib/yol';
---
<Asosiy
  title="Brauzerda saqlash va cookie"
  description="Tayanch brauzeringizda nimani saqlaydi va uni qanday tozalash mumkin."
  turi="umumiy"
  bolim="umumiy"
  holat="qoralama"
  tekshirilgan="2026-11-11"
  keyingiTekshiruv="2026-12-11"
  tekshirilmagan={[
    "GitHub Pages yoki Supabase o'zi cookie qo'yadimi: ularning hujjatida tekshirish kerak",
  ]}
>
  <HuquqiyMatn til="uz" kalit="saqlash" sana="2026-11-11">
    <h2>Qisqasi</h2>
    <ul>
      <li>Tayanch reklama, kuzatuv yoki tashqi analitika cookie'larini ishlatmaydi.</li>
      <li>Sayt brauzerning <code>localStorage</code> va <code>sessionStorage</code> xotirasidan foydalanadi. Kalitlar <code>tayanch</code> bilan boshlanadi.</li>
      <li>Bu ma'lumot brauzeringizda qoladi. Faqat hisob sessiyasi Supabase serveriga kirish uchun ishlatiladi.</li>
    </ul>

    <h2>Nima saqlanadi</h2>
    <div class="jadval-orami">
      <table>
        <thead><tr><th scope="col">Kalit</th><th scope="col">Nima uchun</th><th scope="col">Qancha</th></tr></thead>
        <tbody>
          {brauzerKalitlari.map((k) => (
            <tr><td><code>{k.kalit}</code></td><td>{k.uz}</td><td>{k.sessiya ? 'Oyna yopilguncha' : "O'zingiz tozalaguncha"}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Qanday tozalanadi</h2>
    <ul>
      <li>Brauzer sozlamalarida shu sayt ma'lumotlarini (sayt ma'lumotlari yoki "site data") o'chiring.</li>
      <li>Hisobdan chiqsangiz, sessiya kaliti o'chadi. Javob va natijalar brauzerda qoladi.</li>
      <li>Serverdagi ma'lumotni o'chirish: <a href={yol('/uz/maxfiylik/#ochirish')}>Maxfiylik siyosati</a>.</li>
    </ul>
  </HuquqiyMatn>
</Asosiy>
