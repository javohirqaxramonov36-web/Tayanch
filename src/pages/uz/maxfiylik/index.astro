---
// 1-qavat · Maxfiylik siyosati (P23, 2026-11-09). Hisob (Supabase Auth) qo'shilgani uchun qayta yozildi.
// Qonun talablari: LX02 ("Shaxsga doir ma'lumotlar to'g'risida"gi Qonun), LX03 (voyaga yetish 18 yosh), LX04 (teng himoya ro'yxati).
import Asosiy from '../../../layouts/Asosiy.astro';
import { hisobSozlama } from '../../../data/hisobSozlama';
import { yol } from '../../../lib/yol';

const { minYosh, voyagaYetmaganQoida: vq } = hisobSozlama;
const brauzerKalitlari: [string, string][] = [
  ['tayanch:auth', "hisobga kirganingizda sessiya (Supabase o'zi yozadi). Chiqqaningizda o'chadi."],
  ['tayanch:mavzu, tayanch:sidebar', "yorug' yoki qorong'i mavzu va yon panel holati."],
  ['tayanch:sat-…, tayanch:ielts-…, tayanch:top-admission-…', "javoblar, dars progressi, xato daftari, takrorlash, lug'at va reja."],
  ['tayanch:navigator-yol:v1', "bosh sahifadagi yo'l xaritasi javoblaringiz."],
  ['tayanch:hisob-keyin', "Google bilan kirishda qaysi sahifaga qaytish (faqat shu oyna yopilguncha, sessionStorage)."],
  ['tayanch-topshirish-yoli', "Topshirish yo'li vositasidagi belgilaringiz."],
  ['tayanch:qavat', "qaysi qavatda ekaningiz (faqat shu oyna yopilguncha, sessionStorage)."],
];
---
<Asosiy
  title="Maxfiylik siyosati"
  description="Tayanch qanday ma'lumot to'playdi, qayerda saqlaydi va uni qanday o'chirish mumkin."
  turi="umumiy"
  bolim="umumiy"
  holat="chop-etilgan"
  tekshirilgan="2026-11-10"
  keyingiTekshiruv="2026-12-10"
  manbalar={['LX02', 'LX03', 'LX04']}
  tekshirilmagan={[
    "GitHub Pages xostingi tashrif buyuruvchilar haqida qanday texnik ma'lumot (masalan, IP manzil) yozishi: GitHub'ning rasmiy hujjatida tekshirish kerak",
    "Xat yuborish uchun email Google'ning Gmail xizmatiga beriladi: Google LLC EU-US Data Privacy Framework ro'yxatida ekani (VM 415-son qarori, 2-band sharti) tekshirish kerak",
    "Supabase o'z jurnallarida (masalan, kirish jurnali) qanday texnik ma'lumot va qancha muddat saqlashi: Supabase hujjatida tekshirish kerak",
    "Ota-ona roziligi formadagi belgi va ism bilan olinishi Qonun 21-moddasidagi \"elektron hujjat tarzida\" talabiga yetarlimi: huquqshunos fikri kerak",
    "AI Tutor: Anthropic API so'rov va javoblarni qancha muddat saqlashi va ularni model o'qitishda ishlatmasligi Anthropic tijorat shartlarida tekshirish kerak (AI yoqilishidan oldin)",
    "AI Tutor: xabarni AQShdagi Anthropic xizmatiga uzatish Qonun 15 va 27¹-moddalari (LX02) va VM 415-son qarori (LX04) bo'yicha ruxsat etilganmi: huquqshunos fikri kerak (AI yoqilishidan oldin)",
  ]}
>
  <section class="ichki sahifa">
    <h1>Maxfiylik siyosati</h1>
    <p class="ikkinchi">Kuchga kirgan sana: 2026-yil 10-noyabr. Hisob ixtiyoriy: saytning hamma bepul qismi hisobsiz ham ishlaydi.</p>

    <h2>Hisob ochsangiz nima saqlanadi</h2>
    <ul>
      <li><strong>Email</strong>: kirish, tasdiqlash va parolni tiklash xatlari uchun.</li>
      <li><strong>Parol</strong>: uni Supabase Auth tekshiradi. Tayanch o'z jadvallarida parol saqlamaydi.</li>
      <li><strong>Ism va taxallus</strong> (ixtiyoriy): profil sahifasida o'zingiz yozasiz. Taxallus keyinchalik reytinglarda ko'rinishi mumkin.</li>
      <li><strong>Rozilik belgilari</strong>: shu siyosat va Foydalanish shartlariga rozi bo'lgan vaqt (<code>terms_accepted_at</code>), yoshingiz {minYosh} da yoki undan kattaligi (<code>min_age_confirmed</code>) va yosh guruhi.</li>
      {vq && <li><strong>{vq.yoshgacha} yoshgacha bo'lsangiz</strong>: ota-ona yoki vasiyning ismi va u rozilik bergan vaqt.</li>}
      <li><strong>Google bilan kirsangiz</strong>: Google beradigan ism, email va profil rasmi havolasi (boshqa ruxsat so'ralmaydi).</li>
      <li><strong>Bosh sahifadagi yo'l xaritasi javoblari</strong> (tanlangan maqsadlar, muddat yoki sana, kunlik vaqt): hisobga kirgan bo'lsangiz, boshqa qurilmada ham ko'rinishi uchun.</li>
      <li><strong>Texnik sanalar</strong>: hisob ochilgan, email tasdiqlangan va oxirgi kirgan vaqt (Supabase Auth o'zi yozadi).</li>
    </ul>
    <p>Dars va mashq natijalari hozircha faqat brauzeringizda. Ular hisobga ko'chirilganda shu sahifa yangilanadi.</p>

    <h2>Nima uchun ishlatiladi</h2>
    <p>Faqat hisobingiz ishlashi uchun: kirish, profilingizni ko'rsatish va kerakli xatlarni yuborish. Ma'lumotingiz sotilmaydi, reklama uchun ishlatilmaydi va qonunda nazarda tutilgan holatlardan tashqari uchinchi shaxsga berilmaydi.</p>

    <h2>Qayerda saqlanadi</h2>
    <p>Hisob ma'lumotlari <strong>Supabase</strong> xizmatida, <strong>Frankfurt (Germaniya)</strong> serverida saqlanadi. Tasdiqlash va parol tiklash xatlari Google'ning Gmail pochta xizmati orqali yuboriladi: buning uchun emailingiz Google'ga beriladi. Germaniya Vazirlar Mahkamasi tasdiqlagan, shaxsga doir ma'lumotlar bir xil himoya qilinadigan davlatlar ro'yxatida bor (LX04). Shuning uchun Qonun ma'lumotni u yerda saqlashga ruxsat beradi (15 va 27¹-moddalar, LX02). Tayanch biometrik yoki genetik ma'lumot yig'maydi.</p>

    <h2>{vq ? `${vq.yoshgacha} yoshgacha bo'lganlar` : 'Yosh'}</h2>
    <p>Hisobni {minYosh} yoshdan ochish mumkin.{vq && <> Qonun bo'yicha voyaga yetmaganlar ({vq.yoshgacha} yoshgacha, LX03) ma'lumotiga ishlov berish uchun ota-ona yoki vasiy yozma, shu jumladan elektron shaklda rozilik beradi (21-modda, LX02). Shuning uchun ro'yxatdan o'tish formasida ota-ona yoki vasiy o'z ismini yozib, rozilik belgisini qo'yadi.</>}</p>

    <h2 id="ai-tutor">AI Tutor (SAT bo'limi)</h2>
    <p>SAT bo'limidagi AI Tutor hozircha o'chiq. Yoqilganda u shunday ishlaydi (2026-yil 12-noyabrda qo'shildi):</p>
    <ul>
      <li><strong>Nima yuboriladi</strong>: siz yozgan xabar, shu suhbatdagi oxirgi 6 ta xabar va, xatoingiz haqida so'rasangiz, Tayanch'ning o'sha original savoli va sizning javobingiz. Ismingiz, emailingiz va hisob raqamingiz AI xizmatiga yuborilmaydi.</li>
      <li><strong>Kim javob yozadi</strong>: Anthropic kompaniyasining (AQSh) Claude modeli. So'rov Tayanch serveri (Supabase Edge Function) orqali boradi: brauzeringiz AI xizmatiga to'g'ridan-to'g'ri ulanmaydi.</li>
      <li><strong>Tozalash</strong>: yuborishdan oldin xabardagi email, telefon, karta va pasport raqami, havola va "@" taxallus avtomatik olib tashlanadi. Filtr hammasini ushlay olmaydi, shuning uchun shaxsiy ma'lumot yozmang.</li>
      <li><strong>Rasmiy test materiali</strong>: College Board savoli yoki sizdirilgan material deb aniqlangan xabar AI'ga yuborilmaydi va saqlanmaydi.</li>
      <li><strong>Saqlash</strong>: tozalangan xabaringiz va AI javobi hisobingizda (Supabase, Frankfurt) suhbat tarixi sifatida saqlanadi. Xarajatni hisoblash uchun matnsiz yozuv ham saqlanadi: vaqt, token soni va narx. Bir xil xabar takror yuborilganini aniqlash uchun xabarning qaytarib bo'lmaydigan izi (xesh) ko'pi bilan 1 soat saqlanadi.</li>
      <li><strong>O'chirish</strong>: AI Tutor sahifasida har bir suhbatni yoki butun tarixni o'chirish mumkin. Hisobni o'chirsangiz, suhbatlar ham o'chadi; xarajat yozuvi hisobga bog'lanmagan holda qoladi.</li>
      <li>AI xato qilishi mumkin. U ball yoki natijani bashorat qilmaydi va kafolatlamaydi.</li>
    </ul>

    <h2>Brauzeringizda saqlanadigan narsa</h2>
    <p>Hisob bilan ham, hisobsiz ham ba'zi narsalar faqat brauzeringizda, <code>tayanch</code> bilan boshlanadigan kalitlarda saqlanadi. Ular serverga yuborilmaydi (sessiya kaliti faqat Supabase'ga kirish uchun ishlatiladi):</p>
    <ul>
      {brauzerKalitlari.map(([kalit, nima]) => <li><code>{kalit}</code>: {nima}</li>)}
    </ul>
    <p>Ularni o'chirish uchun brauzer sozlamalarida shu sayt ma'lumotlarini tozalang.</p>

    <h2>Huquqlaringiz</h2>
    <ul>
      <li>Qanday ma'lumotingiz borligini bilish: email va ismingiz <a href={yol('/uz/hisob/profil/')}>profil sahifasida</a> ko'rinadi.</li>
      <li>Ma'lumotni o'zgartirish: ism va taxallusni profil sahifasida, parolni "Parolni tiklash" orqali.</li>
      <li>Rozilikni chaqirib olish va ma'lumotni o'chirish: pastdagi "Hisobni qanday o'chirish mumkin" bo'limi.</li>
      <li>Huquqingiz buzilgan deb hisoblasangiz, vakolatli davlat organiga yoki sudga murojaat qilish (30-modda, LX02).</li>
    </ul>

    <h2 id="ochirish">Hisobni qanday o'chirish mumkin</h2>
    <ol>
      <li>Hisobingizga kiring va <a href={yol('/uz/hisob/profil/')}>profil sahifasini</a> oching.</li>
      <li>"Hisobni o'chirish" tugmasini bosing va tasdiqlang.</li>
    </ol>
    <p>Hisob, ism, taxallus va rozilik belgilari serverdan darhol o'chiriladi. Brauzerdagi natijalar o'zingizda qoladi: ularni yuqoridagi usul bilan tozalang.</p>

    <h2>Nima to'planmaydi</h2>
    <ul>
      <li>Hujjat (pasport, sertifikat) yoki insho yuklash imkoniyati yo'q.</li>
      <li>Karta ma'lumoti saytda so'ralmaydi.</li>
      <li>Tayanch o'z analitika yoki reklama kodini ishlatmaydi. Shrift ham saytning o'zidan yuklanadi.</li>
    </ul>

    <h2>Xosting</h2>
    <p>Sayt GitHub Pages'da joylashgan. Sahifa ochilganda so'rov GitHub serverlariga boradi.</p>

    <h2>O'zgarishlar va murojaat</h2>
    <p>Siyosat o'zgarsa, yangi sana shu sahifa boshida yoziladi. Murojaat uchun aloqa manzili tez orada shu yerda bo'ladi.</p>
    <p>Yana qarang: <a href={yol('/uz/shartlar/')}>Foydalanish shartlari</a>.</p>
  </section>
</Asosiy>

