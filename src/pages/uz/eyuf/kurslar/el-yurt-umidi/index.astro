---
// 5-qavat · EYUF · Kurs: "El-Yurt Umidiʼni yutaylik" (SKELET, 2026-11-19).
// Muallif qarori: hozircha faqat sarlavha, tavsif va bo'lim sarlavhalari. Matnni muallif keyin alohida yuklaydi.
// Bu yerga to'liq matn yoki fakt yozilmasin. Bo'lim sarlavhalari: src/data/eyufKurslar.ts.
import BolimQobiq from '../../../../../layouts/BolimQobiq.astro';
import SahifaOxiri from '../../../../../components/SahifaOxiri.astro';
import { eyufKurs, KURS_HOLATI_YORLIQ } from '../../../../../data/eyufKurslar';
import { yol } from '../../../../../lib/yol';
import EyufHero from '../../../../../components/eyuf/EyufHero.astro';
import '../../../../../styles/eyuf.css';

const kurs = eyufKurs('el-yurt-umidi');
const sana = '2026-11-19';
const keyingi = '2026-12-19';
const tekshirilmagan = ["Kurs toʻldirilmagan: material muallifdan kutilmoqda."];
const idlar = ['suhbat', 'bridge', 'savollar', 'caselar'];
---
<BolimQobiq
  title="El-Yurt Umidi'ni yutaylik · EYUF"
  description={kurs.tavsif}
  turi="qollanma"
  bolim="eyuf"
  holat="qoralama"
  tekshirilgan={sana}
  keyingiTekshiruv={keyingi}
  tekshirilmagan={tekshirilmagan}
  yol={['Kurslar']}
>
  <article class="ichki kurs">
    <EyufHero id="kurs-h" yorliq={`Bepul kurs · ${KURS_HOLATI_YORLIQ[kurs.holat]}`} sarlavha={kurs.nomi} matn={kurs.tavsif} ixcham>
      <p class="holat" role="status">TOʻLDIRILMAGAN — material keyinroq qoʻshiladi</p>
    </EyufHero>

    <ol class="bolimlar" role="list">
      {kurs.bolimlar.map((nom, i) => (
        <li>
          <section id={idlar[i]} class="bolim" aria-labelledby={`${idlar[i]}-h`}>
            <p class="ustki">{i + 1}-boʻlim</p>
            <h2 id={`${idlar[i]}-h`}>{nom}</h2>
            <p class="bosh-joy">Material keyinroq qoʻshiladi.</p>
          </section>
        </li>
      ))}
    </ol>

    <p><a class="orqaga" href={yol('/uz/eyuf/kurslar/')}>Barcha kurslar</a></p>
  </article>
  <SahifaOxiri tekshirilgan={sana} keyingiTekshiruv={keyingi} tekshirilmagan={tekshirilmagan} />
<p class="ichki">Tayanch El-yurt umidi jamgʻarmasining rasmiy platformasi emas.</p>
</BolimQobiq>

<style>
  .kurs { display: grid; gap: var(--space-8); padding-block: var(--space-6); max-width: 72ch; }
  .bosh { display: grid; gap: var(--space-3); }
  .yorliqlar { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .yorliq { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); background: var(--color-eyuf-tile); color: var(--color-eyuf-text-muted); font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); }
    .tavsif { font-size: var(--font-size-body-d); color: var(--color-eyuf-text-muted); }
  .holat { justify-self: start; color: var(--color-eyuf-text); padding: var(--space-2) var(--space-4); border: var(--border-width-1) dashed var(--color-eyuf-line-strong); border-radius: var(--radius-lg); font-weight: var(--font-weight-extrabold); font-size: var(--text-caption-size); letter-spacing: var(--text-caption-ls); }
  .ustki { font-size: var(--text-caption-size); font-weight: var(--font-weight-bold); letter-spacing: var(--text-eyuf-yorliq-ls); text-transform: uppercase; color: var(--color-eyuf-text-muted); }
  .bolimlar { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .bolim { border: var(--border-width-1) dashed var(--color-eyuf-line-strong); border-radius: var(--radius-lg); padding: var(--space-5) var(--space-6); display: grid; gap: var(--space-2); }
  .bosh-joy { color: var(--color-eyuf-text-muted); }
  .orqaga { display: inline-flex; align-items: center; min-height: var(--size-touch-min); color: var(--color-link); font-weight: var(--font-weight-bold); }
  a:focus-visible { outline: var(--focus-ring-width) solid var(--color-focus-ring); outline-offset: var(--focus-ring-gap); }
</style>
