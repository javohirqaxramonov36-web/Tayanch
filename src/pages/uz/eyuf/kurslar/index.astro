---
// 5-qavat · EYUF · Kurslar ro'yxati. Mini-DS (PR 9): EyufHero (ixcham), EyufBosqich (to'rt kurs), EyufRoyxat (kirish kurslari).
// Ma'lumot: src/data/eyufKurslar.ts.
import BolimQobiq from '../../../../layouts/BolimQobiq.astro';
import SahifaOxiri from '../../../../components/SahifaOxiri.astro';
import { eyufKurslar, KURS_HOLATI_YORLIQ } from '../../../../data/eyufKurslar';
import { yol } from '../../../../lib/yol';
import EyufHero from '../../../../components/eyuf/EyufHero.astro';
import EyufBosqich from '../../../../components/eyuf/EyufBosqich.astro';
import EyufRoyxat from '../../../../components/eyuf/EyufRoyxat.astro';
import '../../../../styles/eyuf.css';

const sana = '2026-11-19';
const keyingi = '2026-12-19';
const tekshirilmagan: string[] = [];
const tayyorgarlik = [
  { nomi: 'Hujjatlar va esse', izoh: 'Universitet, hujjatlar, esse.', href: yol('/uz/eyuf/tayyorgarlik/') },
  { nomi: 'Test bosqichi', izoh: 'IQ mashq va simulyatsiya.', href: yol('/uz/eyuf/trenajyor/') },
  { nomi: 'Suhbat bosqichi', izoh: 'Savol kartalari va soha.', href: yol('/uz/eyuf/suhbat/') },
  { nomi: 'Natija', izoh: 'Keyingi qadamlar va B reja.', href: yol('/uz/eyuf/natija/') },
];
const kirish = eyufKurslar.map((k) => ({
  href: yol(`/uz/eyuf/kurslar/${k.slug}/`),
  nomi: k.nomi,
  meta: [k.bepul ? 'Bepul' : null, `${k.bolimlar.length} bo'lim`].filter(Boolean).join(' · '),
  holat: KURS_HOLATI_YORLIQ[k.holat],
  tayyor: k.holat === 'tayyor',
  ikonka: 'kurs' as const,
}));
---
<BolimQobiq
  title="Kurslar · EYUF"
  description="El-Yurt Umidi qavati kurslari: chet elda o'qish nima beradi va El-Yurt Umidi suhbatiga tayyorgarlik."
  turi="qollanma"
  bolim="eyuf"
  holat="qoralama"
  tekshirilgan={sana}
  keyingiTekshiruv={keyingi}
  tekshirilmagan={tekshirilmagan}
>
  <div class="ichki kurslar">
    <EyufHero id="kurslar-h" yorliq="5-qavat · El-Yurt Umidi" sarlavha="Kurslar" matn="Bepul kurslar. Qoida va muddatlar faqat rasmiy manbadan, natija kafolatlanmaydi." ixcham />
    <section class="kurslar-yol" aria-labelledby="kurslar-yol-h">
      <h2 id="kurslar-yol-h">Tayyorgarlik kurslari</h2>
      <EyufBosqich bosqichlar={tayyorgarlik} yorliq="To‘rt kursli EYUF tayyorgarligi" zich />
    </section>
    <EyufRoyxat id="kirish-kurslar-h" sarlavha="Kirish kurslari" qatorlar={kirish} />
  </div>
  <SahifaOxiri tekshirilgan={sana} keyingiTekshiruv={keyingi} tekshirilmagan={tekshirilmagan} />
<p class="ichki">Tayanch El-yurt umidi jamgʻarmasining rasmiy platformasi emas.</p>
</BolimQobiq>

<style>
  .kurslar { display: grid; gap: var(--space-6); padding-block: var(--space-6); }
  .kurslar-yol { display: grid; gap: var(--space-4); }
</style>
