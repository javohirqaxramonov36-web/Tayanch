---
import BolimQobiq from '../../../layouts/BolimQobiq.astro';
import QavatFoto from '../../../components/QavatFoto.astro';
import { yol } from '../../../lib/yol';
import { eyufGuruhlar } from '../../../data/eyufSahifalar';
// Kirish sahifasida bo'limning hamma sahifasi ko'rinadi (yon panel bilan bir manba). IQ test alohida karta.
const boshqaGuruhlar = eyufGuruhlar
  .map((g) => ({ ...g, bandlar: g.bandlar.filter((b) => b.href && b.href !== 'eyuf/iq/') }))
  .filter((g) => g.bandlar.length > 0);
---
<BolimQobiq title="El-Yurt Umidi" description="El-Yurt Umidi tayyorgarligi. IQ test mashqlari va kurslar." turi="bolim-kirishi" bolim="eyuf" holat="chop-etilgan">
  <section class="ichki eyuf-kirish" aria-labelledby="eyuf-h">
    <p class="eyuf-yorliq">Mustaqil tayyorgarlik</p>
    <h1 id="eyuf-h">El-Yurt Umidi</h1>
    <p>Test bosqichiga mashq qiling va tayyorgarlik kurslarini ko‘rib chiqing.</p>
    <a class="eyuf-iq-karta" href={yol('/uz/eyuf/iq/')}>
      <span class="eyuf-yorliq">Test bosqichi</span>
      <h2>IQ test</h2>
      <span>Besh test to‘plami va aralash 20 savol. Taymer, natija va xatolarni qayta yechish.</span>
      <span class="eyuf-havola">Mashqni boshlash →</span>
    </a>
    <div class="eyuf-guruhlar">
      {boshqaGuruhlar.map((g, i) => (
        <section class="eyuf-guruh" aria-labelledby={`eyuf-g-${i}`}>
          <h2 class="eyuf-guruh-nom" id={`eyuf-g-${i}`}>{g.nomi}</h2>
          <ul>
            {g.bandlar.map((b) => <li><a href={yol(`/uz/${b.href}`)}>{b.nomi}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
    <p class="eyuf-yorliq">Tayanch El-yurt umidi jamg‘armasining rasmiy platformasi emas.</p>
  </section>
  <QavatFoto bolim="eyuf" />
</BolimQobiq>

<style>
  .eyuf-kirish { display: grid; gap: var(--space-5); padding-top: var(--space-6); }
  .eyuf-kirish > p { max-width: 60ch; }
  .eyuf-yorliq { color: var(--color-text-secondary); font-size: var(--text-small-size); }
  .eyuf-iq-karta { display: grid; gap: var(--space-3); padding: var(--space-6); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); text-decoration: none; }
  .eyuf-havola { color: var(--floor-text); font-weight: var(--font-weight-semibold); }
  .eyuf-guruhlar { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .eyuf-guruh { padding: var(--space-5); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .eyuf-guruh-nom { margin: 0 0 var(--space-3); font-size: var(--text-small-size); color: var(--color-text-secondary); font-weight: var(--font-weight-semibold); }
  .eyuf-guruh ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .eyuf-guruh a { display: block; padding-block: var(--space-2); min-height: var(--size-touch-min); box-sizing: border-box; color: var(--color-text-primary); font-weight: var(--font-weight-medium); }
</style>
