---
// Bosh sahifa. Tartib (N2, 2026-11-13): hero (bitta "Boshlash") → qavat kartalari → bitta yo'l → muallif yo'li → yaqin muddatlar.
// "Qayerdan boshlayman?" savoliga bitta kirish yo'li: hero va menyudagi "Boshlash" (Navigator onboarding, boshqaruv.ts).
import Asosiy from '../../layouts/Asosiy.astro';
import MuallifYoli from '../../components/MuallifYoli.astro';
import DeadlineRoyxati from '../../components/DeadlineRoyxati.astro';
import { bolimlar } from '../../data/bolimlar';
import { qavatlar } from '../../data/qavatlar';
import { yol } from '../../lib/yol';
import Bino from '../../components/Bino.astro';
import YolBelgisi from '../../components/navigator/YolBelgisi.astro';
import YolXaritasi from '../../components/navigator/YolXaritasi.astro';

const sochilgan = [
  { t: 'IELTS', x: 6, y: 8, r: -6 },
  { t: 'Common App', x: 66, y: 2, r: 4 },
  { t: 'Motivatsion esse', x: 0, y: 32, r: 3 },
  { t: 'SAT', x: 78, y: 30, r: -8 },
  { t: 'Tavsiyanoma', x: 2, y: 56, r: 5 },
  { t: 'Stipendiya', x: 72, y: 54, r: -3 },
  { t: 'Muddat?', x: 74, y: 80, r: 7, qora: true },
  { t: 'Hujjatlar', x: 8, y: 82, r: -4 },
];
const bosqichlar = ['Maqsad', 'Imtihon', 'Hujjat va esse', 'Ariza', 'Natija'];
---
<Asosiy
  title="Tayanch"
  description="Chet elda o'qishni xohlovchi o'zbek yoshlari uchun ochiq yo'riqnoma: universitetga topshirish, IELTS, SAT va El-Yurt Umidi."
  turi="bosh-sahifa"
  bolim="umumiy"
  holat="chop-etilgan"
  tekshirilgan="2026-11-04"
  keyingiTekshiruv="2026-12-04"
  tekshirilmagan={[
    "Timeline bosqichlarining tartibi va yillari muallif tomonidan to'liq tasdiqlanishi kerak",
  ]}
>
  <YolBelgisi slot="bosh" />

  <!-- 0. Shaxsiy yo'l xaritasi (Navigator onboarding): faqat saqlangan profil bo'lsa ko'rinadi -->
  <YolXaritasi />

  <!-- 1. Muammo -->
  <section class="ichki muammo" aria-labelledby="s1">
    <div class="muammo-matn">
      <h1 id="s1">Imtihon, hujjat, esse, muddat.<br /><span class="xira">Qayerdan boshlash kerak?</span></h1>
      <p class="lead">Chet elda o'qishni xohlagan har bir o'quvchi shu savoldan boshlaydi. Javob bor, va u bitta joyda.</p>
      <p class="hero-amal">
        <button type="button" class="tugma tugma-asosiy hero-tugma" data-boshlash="hero" aria-haspopup="dialog">Boshlash</button>
      </p>
    </div>
    <div class="sochilgan" aria-hidden="true">
      <Bino aktiv={1} class="sochilgan-bino" />
      {sochilgan.map((s) => (
        <span class={s.qora ? 'yorliq-katta qora' : 'yorliq-katta'} style={`left:${s.x}%;top:${s.y}%;transform:rotate(${s.r}deg)`}>{s.t}</span>
      ))}
    </div>
  </section>

  <!-- 2. Qavatlar: har qavat kartasi. Ochiq qavatda bitta fokus nuqtasi (tugma), tez-oradagida nom havolasi;
       havola ::after bilan butun kartani bosiladigan qiladi. -->
  <section id="qavatlar" class="ichki blok qavatlar" aria-labelledby="qavatlar-h">
    <h2 id="qavatlar-h">Qaysi bo'limdan boshlaysiz?</h2>
    <ul class="kartalar">
      {bolimlar.map((b) => {
        // Tez-oradagi qavatga ham kirsa bo'ladi (Lift kabi: "qavat qurilmoqda" sahifasi)
        const ochiq = b.holat === 'ochiq';
        const raqam = qavatlar.find((q) => q.slug === b.slug)?.raqam;
        const manzil = yol(`/uz/${b.slug}/`);
        return (
          <li>
            <article class:list={['ds-karta', 'karta', { tez: !ochiq }]} data-floor={raqam} aria-labelledby={`karta-${b.slug}`}>
              <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ikonka ds-karta-belgi">
                {b.ikonka === 'qalpoq' && <><path d="M3 10l9-5 9 5-9 5z" /><path d="M7 12v5c3 2 7 2 10 0v-5" /></>}
                {b.ikonka === 'suhbat' && <><path d="M4 5h16v11H8l-4 4z" /><path d="M8 9h8M8 12h5" /></>}
                {b.ikonka === 'varaq' && <><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h4" /></>}
                {b.ikonka === 'medal' && <><circle cx="12" cy="9" r="5" /><path d="M9 13l-2 8 5-3 5 3-2-8" /></>}
              </svg>
              <h3 class="karta-nom" id={`karta-${b.slug}`}>
                {ochiq ? b.nomi : <a class="karta-havola" href={manzil} data-bino-yoq={raqam} aria-describedby={`tez-${b.slug}`}>{b.nomi}</a>}
              </h3>
              <p class="karta-tavsif">{b.tavsif}</p>
              {b.xususiyatlar.length > 0 && (
                <ul class="xususiyatlar">
                  {b.xususiyatlar.map((x) => (
                    <li>
                      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                      {x}
                    </li>
                  ))}
                </ul>
              )}
              {ochiq
                ? <a class="tugma tugma-asosiy karta-tugma karta-havola" href={manzil} data-bino-yoq={raqam}>{b.nomi}'ni boshlash</a>
                : <span class="yorliq karta-yorliq" id={`tez-${b.slug}`}>Tez orada</span>}
            </article>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- 3. Burilish -->
  <section class="kulrang" aria-labelledby="s2">
    <div class="ichki blok">
      <h2 id="s2">Tayanch hammasini <span class="kok">bitta yo'lga</span> tizadi.</h2>
      <ol class="zanjir" aria-label="Yo'l bosqichlari">
        {bosqichlar.map((b, i) => (
          <>
            {i > 0 && <li class="ulagich" aria-hidden="true"></li>}
            <li class={i === bosqichlar.length - 1 ? 'bosqich oxirgi' : 'bosqich'}>{i + 1} · {b}</li>
          </>
        ))}
      </ol>
      <figure class="yol-rasm">
        <img
          src={yol('/rasmlar/bosh/yol-1344.webp')}
          srcset={`${yol('/rasmlar/bosh/yol-720.webp')} 720w, ${yol('/rasmlar/bosh/yol-1344.webp')} 1344w`}
          sizes="(min-width: 1200px) 1100px, 100vw"
          width="1344" height="752" loading="lazy" decoding="async"
          alt="Deraza yonidagi stolda ochiq daftar: qalam bilan chizilgan besh doirali yo'l, yonida Rishton piyolada choy va atlas mato."
        />
      </figure>
      <div class="vadalar">
        <p><strong>Rasmiy manba bilan.</strong> Har qoida va muddat yonida manba havolasi va tekshirilgan sana.</p>
        <p><strong>Ro'yxatsiz va to'lovsiz.</strong> Kiritgan narsangiz brauzeringizda qoladi. Ixtiyoriy hisobga kirsangiz, yo'l xaritangiz hisobingizda ham saqlanadi.</p>
        <p><strong>Halol.</strong> Natija kafolatlanmaydi. Uydirma raqam va sharh yo'q.</p>
      </div>
    </div>
  </section>

  <!-- 4. Cho'qqi -->
  <MuallifYoli />

  <!-- 5. Yaqin muddatlar: eng yaqin 3 tasi -->
  <section class="ichki blok muddatlar" aria-labelledby="s6">
    <h2 id="s6" class="kichik-h2">Yaqin muddatlar</h2>
    <DeadlineRoyxati faqatKelajak limit={3} />
    <p><a href={yol('/uz/deadline/')}>Hamma muddatlar</a></p>
  </section>

</Asosiy>

<style>
  .lead { font-size: var(--matn-katta); color: var(--matn-ikkinchi); max-width: 520px; }
  .kok { color: var(--rang-havola); }
  .blok { padding-block: var(--b-24); display: flex; flex-direction: column; gap: var(--b-10); }
  .kulrang { background: var(--fon-ikkinchi); }

  /* 1. Muammo */
  .muammo { padding-block: var(--b-24) 88px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .muammo-matn { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .muammo h1 { font-size: var(--matn-hero); line-height: 1.04; letter-spacing: var(--oraliq-hero); font-weight: 900; }
  .xira { color: var(--color-text-secondary); }
  .sochilgan { flex: 1 1 420px; min-width: 0; position: relative; height: 340px; }
  /* DS shisha bino: yorliqlar uning atrofida, bino ularning ostida */
  .sochilgan :global(.sochilgan-bino) { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: auto; height: 100%; }
  .yorliq-katta { z-index: var(--z-raised); }
  .yorliq-katta {
    position: absolute; white-space: nowrap;
    background: var(--fon-ikkinchi); color: var(--matn-sust);
    border-radius: var(--r-toliq); padding: 10px 18px;
    font-weight: 700; font-size: 17px;
  }
  .yorliq-katta.qora { background: var(--qora); color: #ffffff; }
  @media (max-width: 640px) { .sochilgan { height: 260px; } .yorliq-katta { font-size: 15px; padding: 8px 14px; } }

  .hero-amal { margin: 0; }
  .hero-tugma { min-width: 200px; }
  @media (max-width: 640px) { .hero-tugma { width: 100%; } }

  /* 2. Qavat kartalari: 2x2, telefonda 1 ustun */
  .qavatlar { padding-top: 0; }
  .kartalar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--b-4); }
  @media (max-width: 760px) { .kartalar { grid-template-columns: 1fr; } }
  /* DS karta (global .ds-karta), urg'u qavat rangida (data-floor) */
  .karta {
    position: relative; height: 100%; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3);
    padding: var(--card-pad);
  }
  .karta:has(.karta-havola:hover) { box-shadow: var(--card-shadow-hover), var(--glass-highlight); transform: translateY(var(--card-lift)); }
  .karta .ikonka { width: var(--control-height-md); height: var(--control-height-md); padding: var(--space-3); }
  .karta-nom { font-weight: 900; font-size: var(--matn-h3); margin: 0; }
  .karta-nom a { color: inherit; text-decoration: none; }
  /* Havola butun kartani qoplaydi: bitta Tab to'xtashi, karta istalgan joyidan bosiladi */
  .karta-havola::after { content: ''; position: absolute; inset: 0; border-radius: var(--card-radius); }
  .karta-tavsif { font-size: 15px; line-height: 1.5; color: var(--matn-ikkinchi); margin: 0; }
  .xususiyatlar { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .xususiyatlar li { display: flex; align-items: flex-start; gap: var(--space-2); font-size: 15px; line-height: 1.5; }
  .xususiyatlar svg { flex: none; margin-top: 2px; color: var(--floor-text); }
  .karta-tugma { margin-top: auto; align-self: stretch; }
  .karta-yorliq { margin-top: auto; }

  /* 3. Burilish */
  .blok h2 { max-width: 760px; font-weight: 900; }
  .zanjir { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .zanjir .bosqich { background: var(--sirt); border-radius: var(--r-toliq); padding: 10px 18px; font-weight: 700; font-size: 17px; }
  .zanjir .ulagich { width: 28px; height: 3px; border-radius: 2px; background: var(--rang-asosiy); }
  .zanjir .oxirgi { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  @media (max-width: 640px) {
    .zanjir { flex-direction: column; align-items: flex-start; gap: 0; }
    .zanjir .ulagich { width: 3px; height: 14px; margin-left: 28px; }
  }
  .vadalar { display: flex; flex-wrap: wrap; gap: 28px 48px; }
  .vadalar p { flex: 1 1 280px; font-size: 17px; color: var(--matn-ikkinchi); }
  .vadalar strong { color: var(--matn); }

  /* 3. Burilish: 5 bosqich ostidagi foto */
  .yol-rasm { margin: 0; }
  .yol-rasm img {
    display: block; width: 100%; height: auto;
    aspect-ratio: 21 / 9; object-fit: cover; object-position: 50% 68%;
    border-radius: var(--radius-xl);
    background: var(--color-surface-sunken);
  }
  @media (max-width: 640px) { .yol-rasm img { aspect-ratio: 4 / 3; object-position: 55% 72%; border-radius: var(--radius-lg); } }
  .muddatlar { padding-top: 0; gap: var(--b-5); }
  .kichik-h2 { font-size: 1.75rem; }
</style>
