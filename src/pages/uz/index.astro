---
// Bosh sahifa. Tuzilma: BRIEF-bosh-sahifa.md (muammo → burilish → cho'qqi → shaxsiy yo'l → harakat).
import Asosiy from '../../layouts/Asosiy.astro';
import MaqsadTesti from '../../components/MaqsadTesti.astro';
import MuallifYoli from '../../components/MuallifYoli.astro';
import DeadlineRoyxati from '../../components/DeadlineRoyxati.astro';
import { bolimlar } from '../../data/bolimlar';
import { qavatlar } from '../../data/qavatlar';
import { yol } from '../../lib/yol';
import Zina from '../../components/Zina.astro';
import YolBelgisi from '../../components/navigator/YolBelgisi.astro';
import YolXaritasi from '../../components/navigator/YolXaritasi.astro';

const sochilgan = [
  { t: 'IELTS', x: 4, y: 6, r: -6 },
  { t: 'Common App', x: 46, y: 0, r: 4 },
  { t: 'Motivatsion esse', x: 20, y: 30, r: 3 },
  { t: 'SAT', x: 68, y: 34, r: -8 },
  { t: 'Tavsiyanoma', x: 2, y: 58, r: 5 },
  { t: 'Stipendiya', x: 40, y: 62, r: -3 },
  { t: 'Muddat?', x: 70, y: 76, r: 7, qora: true },
  { t: 'Hujjatlar', x: 14, y: 84, r: -4 },
];
const bosqichlar = ['Maqsad', 'Imtihon', 'Hujjat va esse', 'Ariza', 'Natija'];
---
<Asosiy
  title="Tayanch"
  description="Chet elda o'qishni xohlovchi o'zbek yoshlari uchun ochiq yo'riqnoma: universitetga topshirish, IELTS, SAT va El-Yurt Umidi."
  turi="bosh-sahifa"
  bolim="umumiy"
  holat="chop-etilgan"
  tekshirilgan="2026-11-04"
  keyingiTekshiruv="2026-12-04"
  tekshirilmagan={[
    "Stipendiya takliflari summasi ($1.1M+): tasdiqlovchi jadval hali tayyor emas",
    "Timeline bosqichlarining tartibi va yillari muallif tomonidan to'liq tasdiqlanishi kerak",
  ]}
>
  <YolBelgisi slot="bosh" />

  <!-- 0. Shaxsiy yo'l xaritasi (Navigator onboarding): faqat saqlangan profil bo'lsa ko'rinadi -->
  <YolXaritasi />

  <!-- 1. Muammo -->
  <section class="ichki muammo" aria-labelledby="s1">
    <div class="muammo-matn">
      <h1 id="s1">Imtihon, hujjat, esse, muddat.<br /><span class="xira">Qayerdan boshlash kerak?</span></h1>
      <p class="lead">Chet elda o'qishni xohlagan har bir o'quvchi shu savoldan boshlaydi. Javob bor, va u bitta joyda.</p>
      <nav id="qavatlar" class="qavat-qator" aria-labelledby="qavatlar-h">
        <p id="qavatlar-h" class="qq-sarlavha">Qavatni tanlang</p>
        <ul>
          {qavatlar.slice(1).map((q) => (
            <li>
              <a class:list={['qq-tugma', { tez: q.holat === 'tez-orada' }]} href={yol(q.manzil)}>
                <span class="qq-raqam" aria-hidden="true">{q.raqam}</span>
                <span class="qq-nom"><span class="sr">{q.raqam}-qavat: </span>{q.nomi}</span>
                {q.holat === 'tez-orada' && <span class="qq-pill">qurilmoqda</span>}
              </a>
            </li>
          ))}
        </ul>
        <a class="qq-test" href="#maqsad">Bilmayapman: 3 savolga javob bering</a>
      </nav>
    </div>
    <div class="sochilgan" aria-hidden="true">
      {sochilgan.map((s) => (
        <span class={s.qora ? 'yorliq-katta qora' : 'yorliq-katta'} style={`left:${s.x}%;top:${s.y}%;transform:rotate(${s.r}deg)`}>{s.t}</span>
      ))}
    </div>
  </section>

  <!-- 2. Burilish -->
  <section class="kulrang" aria-labelledby="s2">
    <div class="ichki blok">
      <h2 id="s2">Tayanch hammasini <span class="kok">bitta yo'lga</span> tizadi.</h2>
      <ol class="zanjir" aria-label="Yo'l bosqichlari">
        {bosqichlar.map((b, i) => (
          <>
            {i > 0 && <li class="ulagich" aria-hidden="true"></li>}
            <li class={i === bosqichlar.length - 1 ? 'bosqich oxirgi' : 'bosqich'}>{i + 1} · {b}</li>
          </>
        ))}
      </ol>
      <div class="vadalar">
        <p><strong>Rasmiy manba bilan.</strong> Har qoida va muddat yonida manba havolasi va tekshirilgan sana.</p>
        <p><strong>Ro'yxatsiz va to'lovsiz.</strong> Kiritgan narsangiz faqat brauzeringizda qoladi.</p>
        <p><strong>Halol.</strong> Natija kafolatlanmaydi. Uydirma raqam va sharh yo'q.</p>
      </div>
    </div>
  </section>

  <!-- 3. Cho'qqi -->
  <MuallifYoli />

  <!-- 4. Shaxsiy yo'l -->
  <section id="maqsad" class="ichki shaxsiy" aria-labelledby="s4">
    <div class="shaxsiy-bosh">
      <h2 id="s4">Endi sizning yo'lingiz</h2>
      <p class="ikkinchi">3 ta savol, va qaysi bo'limdan boshlashni ko'rasiz.</p>
    </div>
    <MaqsadTesti />
  </section>

  <!-- 5. Harakat -->
  <section id="yonalish" class="ichki blok harakat" aria-labelledby="s5">
    <h2 id="s5">Qaysi bo'limdan boshlaysiz?</h2>
    <ul class="kartalar">
      {bolimlar.map((b) => {
        // Tez-oradagi qavatga ham kirsa bo'ladi (Lift kabi: "qavat qurilmoqda" sahifasi)
        const ochiq = b.holat === 'ochiq';
        const qora = b.slug === 'sat';
        return (
          <li>
            <a class:list={['karta', { 'qora-karta': qora, tez: !ochiq }]} href={yol(`/uz/${b.slug}/`)}>
              <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ikonka">
                {b.ikonka === 'qalpoq' && <><path d="M3 10l9-5 9 5-9 5z" /><path d="M7 12v5c3 2 7 2 10 0v-5" /></>}
                {b.ikonka === 'suhbat' && <><path d="M4 5h16v11H8l-4 4z" /><path d="M8 9h8M8 12h5" /></>}
                {b.ikonka === 'varaq' && <><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h4" /></>}
                {b.ikonka === 'medal' && <><circle cx="12" cy="9" r="5" /><path d="M9 13l-2 8 5-3 5 3-2-8" /></>}
              </svg>
              <span class="karta-nom">{b.nomi}</span>
              <span class="karta-tavsif">{b.tavsif}</span>
              <span class="karta-holat">{ochiq ? 'Boshlash' : 'Tez orada'}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="ichki blok muddatlar" aria-labelledby="s6">
    <h2 id="s6" class="kichik-h2">Yaqin muddatlar</h2>
    <DeadlineRoyxati faqatKelajak />
    <p><a href={yol('/uz/deadline/')}>Hamma muddatlar</a></p>
  </section>

  <div class="ichki zina-orami"><Zina /></div>
</Asosiy>

<style>
  .zina-orami { padding-top: var(--b-14); }
  .lead { font-size: var(--matn-katta); color: var(--matn-ikkinchi); max-width: 520px; }
  .ikkinchi { color: var(--matn-ikkinchi); font-size: var(--matn-katta); }
  .kok { color: var(--rang-havola); }
  .blok { padding-block: var(--b-24); display: flex; flex-direction: column; gap: var(--b-10); }
  .kulrang { background: var(--fon-ikkinchi); }

  /* 1. Muammo */
  .muammo { padding-block: var(--b-24) 88px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .muammo-matn { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .muammo h1 { font-size: var(--matn-hero); line-height: 1.04; letter-spacing: -1px; font-weight: 900; }
  .xira { color: #7b8194; }
  .sochilgan { flex: 1 1 420px; min-width: 0; position: relative; height: 340px; }
  .yorliq-katta {
    position: absolute; white-space: nowrap;
    background: var(--fon-ikkinchi); color: var(--matn-sust);
    border-radius: var(--r-toliq); padding: 10px 18px;
    font-weight: 700; font-size: 17px;
  }
  .yorliq-katta.qora { background: var(--qora); color: #ffffff; }
  @media (max-width: 640px) { .sochilgan { height: 260px; } .yorliq-katta { font-size: 15px; padding: 8px 14px; } }

  /* Qavat qatori: bosh sahifadan qavatga bir bosishda */
  .qavat-qator { display: flex; flex-direction: column; gap: var(--b-3); }
  .qq-sarlavha { font-size: var(--matn-kichik); font-weight: 700; color: var(--matn-ikkinchi); }
  .qavat-qator ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--b-2); }
  .qq-tugma {
    display: inline-flex; align-items: center; gap: var(--b-2);
    min-height: 48px; box-sizing: border-box; padding: var(--b-1) var(--b-4) var(--b-1) var(--b-1);
    border: 1.5px solid var(--matn); border-radius: var(--r-toliq);
    color: var(--matn); text-decoration: none; font-weight: 700;
  }
  .qq-tugma:hover { background: var(--fon-ikkinchi); }
  .qq-raqam {
    width: 36px; height: 36px; flex: none; border-radius: var(--r-toliq);
    display: flex; align-items: center; justify-content: center; font-weight: 800;
    background: var(--rang-asosiy); color: var(--rang-asosiy-matn);
  }
  .qq-tugma.tez .qq-raqam { background: var(--sirt-ikkinchi); color: var(--matn-ikkinchi); }
  .qq-pill { padding: 3px 10px; border-radius: var(--r-toliq); background: var(--sirt-ikkinchi); color: var(--matn-ikkinchi); font-size: 12px; font-weight: 700; }
  .qq-test { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; color: var(--rang-havola); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* 2. Burilish */
  .blok h2 { max-width: 760px; font-weight: 900; }
  .zanjir { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .zanjir .bosqich { background: var(--sirt); border-radius: var(--r-toliq); padding: 10px 18px; font-weight: 700; font-size: 17px; }
  .zanjir .ulagich { width: 28px; height: 3px; border-radius: 2px; background: var(--rang-asosiy); }
  .zanjir .oxirgi { background: var(--rang-asosiy); color: var(--rang-asosiy-matn); }
  @media (max-width: 640px) {
    .zanjir { flex-direction: column; align-items: flex-start; gap: 0; }
    .zanjir .ulagich { width: 3px; height: 14px; margin-left: 28px; }
  }
  .vadalar { display: flex; flex-wrap: wrap; gap: 28px 48px; }
  .vadalar p { flex: 1 1 280px; font-size: 17px; color: var(--matn-ikkinchi); }
  .vadalar strong { color: var(--matn); }

  /* 4. Shaxsiy yo'l */
  .shaxsiy { max-width: 760px; padding-block: var(--b-24) 72px; display: flex; flex-direction: column; gap: 28px; }
  .shaxsiy-bosh { display: flex; flex-direction: column; gap: 10px; text-align: center; align-items: center; }
  .shaxsiy h2 { font-weight: 900; }

  /* 5. Harakat */
  .harakat { padding-top: var(--b-6); }
  .kartalar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--b-4); }
  .karta {
    height: 100%; box-sizing: border-box;
    display: flex; flex-direction: column; gap: 14px;
    background: var(--sirt); color: var(--matn);
    border: 1.5px solid var(--qora); border-radius: var(--r-katta); padding: 22px;
    text-decoration: none;
  }
  .karta .ikonka { color: var(--rang-asosiy); }
  .karta-nom { font-weight: 900; font-size: var(--matn-h3); }
  .karta-tavsif { font-size: 15px; line-height: 1.5; color: var(--matn-ikkinchi); }
  .karta-holat { margin-top: auto; font-weight: 700; color: var(--rang-havola); }
  .karta.tez .karta-holat { color: var(--matn-sust); }
  a.karta:hover { box-shadow: 4px 4px 0 var(--qora); transform: translate(-2px, -2px); }
  .qora-karta { background: var(--qora); color: #ffffff; }
  .qora-karta .ikonka, .qora-karta .karta-holat { color: #ffffff; }
  .qora-karta .karta-tavsif, .qora-karta.tez .karta-holat { color: var(--qora-matn-ikkinchi); }

  .muddatlar { padding-top: 0; gap: var(--b-5); }
  .kichik-h2 { font-size: 1.75rem; }
</style>
