---
import Asosiy from '../../layouts/Asosiy.astro';
import DeadlineRoyxati from '../../components/DeadlineRoyxati.astro';
import BoshTariflar from '../../components/BoshTariflar.astro';
import { boshKartalar } from '../../data/boshSahifa';
import { qavatlar } from '../../data/qavatlar';
import { yol } from '../../lib/yol';
---
<Asosiy title="Tayanch" description="Chet elda o'qish yo'lingiz — bitta joyda." turi="bosh-sahifa" bolim="umumiy" holat="chop-etilgan" sahifaOxiri={false}>
  <div class="home">
    <section class="home-hero" aria-labelledby="home-h1">
      <h1 id="home-h1">Chet elda o'qish yo'lingiz — <span>bitta joyda.</span></h1>
      <p>Imtihon, hujjat, grant va muddatlar — o'zbek tilida. Bo'limni tanlang va bepul boshlang.</p>
    </section>
    <section id="qavatlar" class="home-sections" aria-label="Bo'limlar">
      <ul class="home-cards" role="list">
        {boshKartalar.map((k) => <li>
          <a class="home-card" href={yol(k.href)} style={`--section-color:${k.color}`}>
            <span class="home-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={qavatlar.find((q) => q.slug === k.slug)?.ikonka} /></span>
            {k.free && <span class="home-free">Bepul</span>}
            <h2>{k.title}</h2>
            <p class="home-long">{k.line}</p><p class="home-short">{k.short}</p>
            <span class="home-cta">{k.cta}</span>
            <svg class="home-chevron" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7" /></svg>
          </a>
        </li>)}
      </ul>
    </section>
    <a class="home-help" href={yol('/uz/yol-tanlash/')}><span>Qaysi biri kerakligini bilmayapsizmi?</span> <strong>3 savolga javob bering →</strong></a>
    <section class="home-deadlines" aria-labelledby="home-muddat">
      <h2 id="home-muddat">Yaqin muddatlar</h2>
      <DeadlineRoyxati faqatKelajak limit={3} />
      <a href={yol('/uz/deadline/')}>Hamma muddatlar →</a>
    </section>
    <BoshTariflar />
  </div>
</Asosiy>
<style>
  .home { max-width: var(--header-max); padding: var(--space-8); margin-inline: auto; }
  .home-hero { padding-block: var(--space-8); max-width: var(--home-hero-width); }
  .home-hero h1 { font-size: var(--home-title); font-weight: 800; line-height: var(--home-title-lh); letter-spacing: var(--oraliq-hero); }
  .home-hero h1 span { color: var(--color-text-secondary); }
  .home-hero p { color: var(--color-text-secondary); font-size: var(--text-body-size); max-width: var(--home-copy-width); margin-block: var(--space-4) 0; }
  .home-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--home-card-min), 1fr)); gap: var(--space-4); list-style: none; padding: 0; margin: var(--space-5) 0; }
  .home-card { height: 100%; min-height: var(--home-card-height); position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5); border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); color: var(--color-text-primary); text-decoration: none; transition: transform var(--duration-fast) var(--ease-state); }
  @media (hover: hover) { .home-card:hover { transform: translateY(calc(-1 * var(--space-1))); border-color: var(--color-link); } }
  .home-icon { width: var(--space-12); height: var(--space-12); display: grid; place-items: center; border-radius: var(--radius-full); background: var(--section-color); color: var(--home-icon-ink); }
  .home-free { position: absolute; top: var(--space-5); right: var(--space-4); background: var(--home-free-bg); color: var(--home-free-ink); border-radius: var(--radius-full); font-size: var(--text-caption-size); font-weight: 600; padding: var(--space-1) var(--space-2); }
  .home-card h2 { font-size: var(--text-h3-size); line-height: var(--text-h3-lh); margin-top: var(--space-2); white-space: nowrap; }
  .home-long { color: var(--color-text-secondary); font-size: var(--text-small-size); line-height: var(--text-small-lh); margin: 0; }
  .home-cta { color: var(--color-link); font-size: var(--text-small-size); font-weight: 700; margin-top: auto; padding-top: var(--space-3); }
  .home-short, .home-chevron { display: none; }
  .home-help { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); width: fit-content; margin: var(--space-6) auto var(--space-12); padding: var(--space-3) var(--space-5); border: var(--border-width-1) dashed var(--color-border-strong); border-radius: var(--radius-full); color: var(--color-text-secondary); font-size: var(--text-small-size); text-decoration: none; }
  .home-help strong { color: var(--color-link); }
  .home-deadlines { display: grid; gap: var(--space-4); padding-block: var(--space-6) var(--space-12); }
  .home-deadlines :global(.royxat li) { border: var(--border-width-1) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  @media (width < 768px) {
    .home { padding: var(--space-4); }
    .home-hero { padding-block: var(--space-3) var(--space-2); }
    .home-hero h1 { font-size: var(--home-title-mobile); line-height: var(--home-title-lh); }
    .home-hero p { font-size: var(--text-small-size); line-height: var(--text-small-lh); margin-top: var(--space-3); }
    .home-cards { grid-template-columns: 1fr; gap: var(--space-2); margin-block: var(--space-4); }
    .home-card { min-height: var(--home-row-height); display: grid; grid-template-columns: auto minmax(0, 1fr) auto; column-gap: var(--space-3); row-gap: 0; align-content: center; padding: var(--space-3); }
    .home-icon { grid-row: 1 / 3; width: var(--space-10); height: var(--space-10); align-self: center; }
    .home-card h2 { grid-column: 2; font-size: var(--text-body-size); line-height: var(--text-body-lh); margin: 0; }
    .home-short { display: block; grid-column: 2; margin: 0; color: var(--color-text-secondary); font-size: var(--text-caption-size); line-height: var(--text-small-lh); }
    .home-chevron { display: block; grid-column: 3; grid-row: 1 / 3; align-self: center; color: var(--color-link); }
    .home-free { top: var(--space-3); right: var(--space-9); font-size: var(--home-badge-mobile); padding: 0 var(--space-1); }
    .home-long, .home-cta { display: none; }
    .home-help { margin-block: var(--space-4) var(--space-6); padding: var(--space-3); border-radius: var(--radius-lg); }
  }
</style>
