---
// Ildiz sahifasi: o'zbekcha bosh sahifaga yo'naltiradi (T1 qarori).
// og teglari shu yerda ham bor: havola ko'pincha ildiz manzil bilan ulashiladi, botlar yo'naltirishga ergashmaydi.
import { yol } from '../lib/yol';
import { ogRasmlar, OG_KENGLIK, OG_BALANDLIK } from '../data/ogRasmlar';
const manzil = yol('/uz/');
const tavsif = "Chet elda o'qishni xohlovchi o'zbek yoshlari uchun ochiq yo'riqnoma: universitetga topshirish, IELTS, SAT va El-Yurt Umidi.";
const og = ogRasmlar.navigator;
---
<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tayanch</title>
    <meta http-equiv="refresh" content={`0; url=${manzil}`} />
    <link rel="canonical" href={new URL(manzil, Astro.site)} />
    <meta name="description" content={tavsif} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tayanch" />
    <meta property="og:locale" content="uz_UZ" />
    <meta property="og:title" content="Tayanch" />
    <meta property="og:description" content={tavsif} />
    <meta property="og:url" content={new URL(manzil, Astro.site)} />
    <meta property="og:image" content={new URL(yol(og.fayl), Astro.site)} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(OG_KENGLIK)} />
    <meta property="og:image:height" content={String(OG_BALANDLIK)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={og.alt} />
  </head>
  <body>
    <p>Sahifa ochilmasa, <a href={manzil}>bu yerni bosing</a>.</p>
  </body>
</html>
