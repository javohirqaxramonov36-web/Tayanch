{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "as_of",
    "source",
    "url",
    "bachelor_max_age",
    "master_min_age",
    "master_max_age",
    "master_min_work_years",
    "ielts",
    "sat",
    "percentile",
    "top100",
    "top300",
    "top20",
    "partial_grant_percent",
    "test_questions",
    "test_minutes",
    "test_pass_score"
  ],
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "bachelor_max_age": {
      "type": "integer",
      "minimum": 1
    },
    "master_min_age": {
      "type": "integer",
      "minimum": 1
    },
    "master_max_age": {
      "type": "integer",
      "minimum": 1
    },
    "master_min_work_years": {
      "type": "integer",
      "minimum": 1
    },
    "ielts": {
      "type": "object",
      "required": [
        "bachelor",
        "master"
      ],
      "additionalProperties": false,
      "properties": {
        "bachelor": {
          "type": "number",
          "minimum": 0,
          "maximum": 9
        },
        "master": {
          "type": "number",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "sat": {
      "type": "integer",
      "minimum": 1
    },
    "percentile": {
      "type": "integer",
      "minimum": 1
    },
    "top100": {
      "type": "integer",
      "minimum": 1
    },
    "top300": {
      "type": "integer",
      "minimum": 1
    },
    "top20": {
      "type": "integer",
      "minimum": 1
    },
    "partial_grant_percent": {
      "type": "integer",
      "minimum": 1
    },
    "test_questions": {
      "type": "integer",
      "minimum": 1
    },
    "test_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "test_pass_score": {
      "type": "integer",
      "minimum": 1
    }
  }
}
