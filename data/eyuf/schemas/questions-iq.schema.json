{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "son-ketma-ketligi",
              "ortiqcha-son",
              "sonli-jadval-matritsa",
              "figuradagi-son",
              "raqamli-kod",
              "tarozi-muvozanat",
              "yetishmayotgan-qism",
              "ortiqcha-figura",
              "analogiya",
              "keyingi-shakl",
              "qalqon-naqsh-munosabati",
              "kub-yoyilmasi",
              "bolaklardan-kvadrat",
              "figura-sanash",
              "harf-ketma-ketligi",
              "harf-kodi",
              "matematik-masala",
              "soz-mantiqi",
              "ilmiy-tadqiqot"
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "difficulty_verified": {
            "type": "boolean"
          },
          "level": {
            "type": "array",
            "items": {
              "enum": [
                "bachelor",
                "master"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "stem": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/eyuf/iq/[a-z0-9-]+\\.webp$"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "width",
                "height",
                "page",
                "alt"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E",
                    "F",
                    "G"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "image_only": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "text",
                "image_only"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "uniqueItems": false,
            "maxItems": 7
          },
          "answer": {
            "anyOf": [
              {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F",
                  "G"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "book_answer": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G"
            ]
          },
          "explanation": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": false
              },
              "trap": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "rule",
              "steps",
              "trap"
            ],
            "additionalProperties": false
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source": {
            "type": "object",
            "properties": {
              "book": {
                "enum": [
                  "S09",
                  "S10",
                  "S11",
                  "S12",
                  "T01"
                ]
              },
              "test": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "number": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "book",
              "test",
              "page",
              "number"
            ],
            "additionalProperties": false
          },
          "contentSource": {
            "enum": [
              "book",
              "original"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "review": {
            "type": "object",
            "properties": {
              "answer_evidence": {
                "type": "string",
                "minLength": 1
              },
              "transcription_verified": {
                "type": "boolean"
              },
              "type_verified": {
                "type": "boolean"
              }
            },
            "required": [
              "answer_evidence",
              "transcription_verified",
              "type_verified"
            ],
            "additionalProperties": false
          },
          "source_copies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "book": {
                  "enum": [
                    "S09",
                    "S10",
                    "S11",
                    "S12",
                    "T01"
                  ]
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "book",
                "test",
                "page",
                "number"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "type",
          "difficulty",
          "difficulty_verified",
          "level",
          "stem",
          "image",
          "options",
          "answer",
          "book_answer",
          "explanation",
          "tags",
          "source",
          "contentSource",
          "verified",
          "as_of",
          "review"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verified": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E",
                    "F",
                    "G"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "answer": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "items",
    "snapshot"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
