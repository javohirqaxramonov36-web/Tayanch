{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "official": {
            "type": "boolean"
          },
          "applicability_verified": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "official",
          "applicability_verified",
          "note",
          "as_of"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
