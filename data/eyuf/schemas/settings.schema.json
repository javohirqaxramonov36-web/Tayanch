{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "book_content_enabled": {
      "type": "boolean"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "book_content_enabled",
    "notice",
    "publication"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
